# DeployBar 배포 설정. 참고: DeployBar/README.md 의 "앱 쪽 규칙" 표

# 필수: archive 할 scheme
SCHEME=HigGym

PLATFORM=ios

# 버전·빌드번호의 단일 소스
VERSION_XCCONFIG=Version.xcconfig

# 배포 전 게이트. 실패하면 아카이브를 만들지 않는다.
PREDEPLOY_SCRIPT=scripts/predeploy.sh

# App Store 에 등록한 언어. 릴리즈노트를 만들 언어이기도 하다.
# 앱은 한국어 · 영어 · 영국 영어 · 일본어 · 중국어(간체) · 중국어(번체) · 러시아어 · 스페인어 · 독일어 · 프랑스어 · 이탈리아어 · 포르투갈어(브라질) · 태국어 · 베트남어 · 체코어 · 덴마크어 · 그리스어로 번역돼 있다(Localizable · Content · InfoPlist .xcstrings).
LOCALES=ko,en,en-GB,ja,zh-Hans,zh-Hant,ru,es,de,fr,it,pt-BR,th,vi,cs,da,el

# 릴리즈노트가 비어 있으면 배포 중단
RELEASE_NOTES_GATE=strict
