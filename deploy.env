# DeployBar 배포 설정. 참고: DeployBar/README.md 의 "앱 쪽 규칙" 표

# 필수: archive 할 scheme
SCHEME=HigGym

PLATFORM=ios

# 버전·빌드번호의 단일 소스
VERSION_XCCONFIG=Version.xcconfig

# 배포 전 게이트. 실패하면 아카이브를 만들지 않는다.
PREDEPLOY_SCRIPT=scripts/predeploy.sh

# App Store 에 등록한 언어. 릴리즈노트를 만들 언어이기도 하다.
# 앱은 한국어 전용이다. 스토어 페이지에 영어를 추가하면 en 을 넣는다.
LOCALES=ko

# 릴리즈노트가 비어 있으면 배포 중단
RELEASE_NOTES_GATE=strict
