          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faner, søgekapslen, tilbehøret og minimering er alle gode funktioner, så du bruger dem alle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καρτέλες, η κάψουλα αναζήτησης, το accessory και η ελαχιστοποίηση είναι όλα καλές λειτουργίες, οπότε τις χρησιμοποιείς όλες."
          }
        }
      }
    },
    "탭과 길게 누르기가 충돌": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and press-and-hold collide"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and press-and-hold collide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップと長押しがぶつかる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按和长按冲突"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點和長按衝突"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие и долгое нажатие конфликтуют"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El toque y la pulsación larga chocan"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen und Gedrückthalten kollidieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher et appui long entrent en collision"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocco e pressione prolungata entrano in collisione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e pressão prolongada colidem"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแตะกับการกดค้างชนกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm và nhấn giữ va chạm nhau"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutí a dlouhý stisk se střetnou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og tryk-og-hold støder sammen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πάτημα και το παρατεταμένο πάτημα συγκρούονται"
          }
        }
      }
    },
    "탭과 길게 누르기가 충돌한다. 옮겨 적을 값에만 선별해 건다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and long press collide. Apply it selectively, only to values people will copy."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and long press collide. Apply it selectively, only to values people will copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップと長押しが衝突する。書き写す値にだけ選んでかける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按和长按冲突。只选择性地加在需要抄写的值上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點和長按衝突。只選擇性地加在需要抄寫的值上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие и долгое нажатие конфликтуют. Применяйте выборочно, только к значениям, которые люди будут копировать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El toque y la pulsación larga chocan. Aplícalo de forma selectiva, solo a los valores que la gente copiará."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen und langes Drücken kollidieren. Wende es selektiv an, nur auf Werte, die Menschen kopieren werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher et appui long entrent en collision. Appliquez-le de façon sélective, seulement aux valeurs que les gens copieront."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocco e pressione prolungata entrano in collisione. Applicalo in modo selettivo, solo ai valori che le persone copieranno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e pressão prolongada colidem. Aplique de forma seletiva, só aos valores que as pessoas vão copiar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแตะและการกดค้างชนกัน ใช้อย่างเลือกสรร เฉพาะค่าที่คนจะคัดลอก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm và nhấn giữ va chạm nhau. Áp có chọn lọc, chỉ cho các giá trị người ta sẽ sao chép."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutí a dlouhý stisk se střetnou. Aplikujte selektivně, jen na hodnoty, které lidé zkopírují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og langt tryk støder sammen. Anvend det selektivt, kun på værdier, folk vil kopiere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πάτημα και το παρατεταμένο πάτημα συγκρούονται. Εφάρμοσέ το επιλεκτικά, μόνο σε τιμές που οι άνθρωποι θα αντιγράψουν."
          }
        }
      }
    },
    "탭바 **위 층**에 전역 상태(미니 플레이어 등)가 상주": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global state (a mini player and so on) living on **the layer above** the tab bar"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Global state (a mini player and so on) living on **the layer above** the tab bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーの**上の層**に、グローバルな状態（ミニプレーヤーなど）が常駐"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**标签栏上方一层**常驻全局状态（迷你播放器等）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**標籤列上方一層**常駐全域性狀態（迷你播放器等）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глобальное состояние (мини-плеер и тому подобное) живёт на **слое выше** панели вкладок"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado global (un minirreproductor y similares) que vive en **la capa de encima** de la barra de pestañas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Globaler Zustand (ein Miniplayer und so weiter), der auf **der Ebene über** der Tab-Leiste lebt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un état global (un mini-lecteur, etc.) qui vit sur **la couche au-dessus** de la barre d'onglets"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stato globale (un mini player e così via) che vive sullo **strato sopra** la barra delle schede"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado global (um mini player e afins) vivendo **na camada acima** da barra de abas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะส่วนกลาง (มินิเพลเยอร์และอื่น ๆ) อยู่บน**ชั้นเหนือ**แถบแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái toàn cục (trình phát mini và tương tự) sống ở **lớp phía trên** thanh tab"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Globální stav (mini přehrávač a podobně) žijící ve **vrstvě nad** panelem karet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Global tilstand (en miniafspiller og så videre), der lever på **laget over** fanelinjen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθολική κατάσταση (μίνι player κ.ά.) που ζει στο **στρώμα πάνω** από τη γραμμή καρτελών"
          }
        }
      }
    },
    "탭바 바로 위, 하단 액세서리 자리에 이벤트 배너 한 줄이 떠 있다. 스크롤하다가 엄지가 지나가는 바로 그 층이다. 같은 하단에 조작 버튼과 광고가 섞여 있으니, 이 층에 있는 것이 내가 지금 하는 일에 관한 것인지 광고인지 매번 읽어야 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right above the tab bar, in the bottom accessory slot, floats a one-line event banner. It's the very layer your thumb passes through while scrolling. With controls and ads mixed in the same bottom area, you have to read each time whether something in this layer relates to what you're doing or is just an ad."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Right above the tab bar, in the bottom accessory slot, floats a one-line event banner. It's the very layer your thumb passes through while scrolling. With controls and ads mixed in the same bottom area, you have to read each time whether something in this layer relates to what you're doing or is just an ad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーのすぐ上、ボトムアクセサリの場所に、イベントのバナーが1行浮かんでいる。スクロールしながら親指が通る、まさにその層だ。同じ下部に操作ボタンと広告が混ざっているので、この層にあるものがいま自分がしていることに関するものなのか広告なのか、毎回読まなければならない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏正上方、底部附件的位置，浮着一行活动横幅。正是滚动时拇指经过的那一层。同一个底部既有操作按钮又有广告，每次都要读，这一层的东西是跟我现在在做的事有关，还是广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列正上方、底部附件的位置，浮著一行活動橫幅。正是滾動時拇指經過的那一層。同一個底部既有操作按鈕又有廣告，每次都要讀，這一層的東西是跟我現在在做的事有關，還是廣告。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямо над панелью вкладок, в нижнем слоте accessory, парит однострочный баннер события. Это тот самый слой, через который проходит большой палец при прокрутке. Когда в одной нижней области смешаны элементы управления и реклама, каждый раз приходится выяснять, связано ли что-то на этом слое с тем, что вы делаете, или это просто реклама."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Justo sobre la barra de pestañas, en el sitio del accesorio inferior, flota un banner de evento de una línea. Es justo la capa por la que pasa tu pulgar al desplazar. Con controles y anuncios mezclados en la misma zona inferior, tienes que leer cada vez si algo de esta capa se relaciona con lo que estás haciendo o es solo un anuncio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt über der Tab-Leiste, im unteren Accessory-Platz, schwebt ein einzeiliges Event-Banner. Es ist genau die Ebene, die dein Daumen beim Scrollen durchläuft. Sind Steuerelemente und Werbung im selben unteren Bereich gemischt, muss man jedes Mal lesen, ob etwas in dieser Ebene mit dem zu tun hat, was man gerade tut, oder nur Werbung ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste au-dessus de la barre d'onglets, dans l'emplacement d'accessoire du bas, flotte une bannière d'événement d'une ligne. C'est précisément la couche que traverse votre pouce en faisant défiler. Avec des contrôles et des publicités mêlés dans la même zone du bas, il faut lire à chaque fois si quelque chose dans cette couche se rapporte à ce que vous faites ou n'est qu'une publicité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proprio sopra la barra delle schede, nello slot dell'accessorio in basso, fluttua un banner di evento di una riga. È lo strato esatto in cui passa il pollice mentre scorri. Con controlli e pubblicità mescolati nella stessa area in basso, devi leggere ogni volta se qualcosa in questo strato riguarda ciò che stai facendo o è solo pubblicità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo acima da barra de abas, no lugar do acessório inferior, flutua um banner de evento de uma linha. É a camada exata por onde seu polegar passa ao rolar. Com controles e anúncios misturados na mesma área inferior, você precisa ler cada vez se algo nesta camada tem a ver com o que você está fazendo ou é só um anúncio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหนือแถบแท็บพอดี ในช่องอุปกรณ์เสริมด้านล่าง มีแบนเนอร์อีเวนต์บรรทัดเดียวลอยอยู่ มันคือชั้นที่นิ้วโป้งผ่านขณะเลื่อน เมื่อตัวควบคุมและโฆษณาปนในพื้นที่ด้านล่างเดียวกัน คุณต้องอ่านทุกครั้งว่าสิ่งใดในชั้นนี้เกี่ยวกับสิ่งที่คุณทำหรือเป็นแค่โฆษณา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay phía trên thanh tab, trong ô phụ kiện dưới cùng, nổi một banner sự kiện một dòng. Đó chính là lớp mà ngón cái bạn lướt qua khi cuộn. Với điều khiển và quảng cáo trộn trong cùng vùng dưới, mỗi lần bạn phải đọc xem thứ gì ở lớp này liên quan đến việc mình đang làm hay chỉ là quảng cáo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přímo nad panelem karet, ve slotu spodního příslušenství, plave jednořádkový banner události. Je to právě ta vrstva, kterou váš palec prochází při posouvání. S ovladači a reklamami smíchanými ve stejné spodní oblasti musíte pokaždé číst, zda věc v této vrstvě souvisí s tím, co děláte, nebo je jen reklama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lige over fanelinjen, i tilbehørspladsen i bunden, svæver et enlinjes begivenhedsbanner. Det er netop det lag, din tommelfinger passerer, mens du scroller. Med kontroller og reklamer blandet i det samme nederste område må du læse hver gang, om noget i dette lag hænger sammen med det, du laver, eller bare er en reklame."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακριβώς πάνω από τη γραμμή καρτελών, στη θέση του κάτω accessory, επιπλέει ένα banner εκδήλωσης μίας γραμμής. Είναι το ίδιο στρώμα από όπου περνά ο αντίχειράς σου καθώς κυλάς. Με ελέγχους και διαφημίσεις ανακατεμένους στην ίδια κάτω περιοχή, πρέπει να διαβάζεις κάθε φορά αν κάτι σε αυτό το στρώμα σχετίζεται με αυτό που κάνεις ή είναι απλώς διαφήμιση."
          }
        }
      }
    },
    "탭바 오른쪽 분리 캡슐 자리에 연필 아이콘이 있다. 누르면 새 글 작성 시트가 뜬다. 다른 앱에서 그 자리를 검색으로 익힌 사용자는 검색하려다 작성 화면을 만나고, 닫고 나서 검색이 어디 있는지 다시 찾는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a pencil icon in the separate capsule spot on the right of the tab bar. Tapping it brings up a new-post sheet. Users who learned that spot as search in other apps try to search, land on a compose screen, and after closing it, go looking for where search went."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a pencil icon in the separate capsule spot on the right of the tab bar. Tapping it brings up a new-post sheet. Users who learned that spot as search in other apps try to search, land on a compose screen, and after closing it, go looking for where search went."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーの右側、分離されたカプセルの場所に鉛筆のアイコンがある。タップすると新規投稿のシートが表示される。ほかのアプリでその場所を検索として覚えたユーザーは、検索しようとして作成画面に出くわし、閉じたあとで検索がどこにあるのか探し直す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏右侧的分离胶囊位置有一个铅笔图标。点按后弹出写新帖的弹层。在别的应用里习惯那个位置是搜索的用户，想搜索却遇到撰写界面，关掉后还得重新找搜索在哪里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列右側的分離膠囊位置有一個鉛筆圖示。輕點後彈出寫新帖的工作表。在別的應用程式裡習慣那個位置是搜尋的使用者，想搜尋卻遇到撰寫介面，關掉後還得重新找搜尋在哪裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На месте отдельной капсулы справа от панели вкладок стоит значок карандаша. Нажатие вызывает шторку нового поста. Пользователи, выучившие это место как поиск в других приложениях, пытаются искать, попадают на экран создания, а закрыв его, ищут, куда делся поиск."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un icono de lápiz en el sitio de la cápsula separada a la derecha de la barra de pestañas. Al tocarlo aparece una hoja de nueva publicación. Los usuarios que aprendieron ese sitio como búsqueda en otras apps intentan buscar, acaban en una pantalla de redactar y, tras cerrarla, buscan adónde fue la búsqueda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Platz der separaten Kapsel rechts der Tab-Leiste steht ein Stift-Symbol. Antippen öffnet ein Sheet für einen neuen Beitrag. Nutzer, die diesen Platz in anderen Apps als Suche gelernt haben, versuchen zu suchen, landen auf einem Verfassen-Bildschirm und suchen nach dem Schließen, wo die Suche geblieben ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a une icône de crayon à l'emplacement de la capsule séparée à droite de la barre d'onglets. La toucher fait apparaître une feuille de nouvelle publication. Les utilisateurs qui ont appris cet emplacement comme recherche dans d'autres apps essaient de chercher, atterrissent sur un écran de rédaction, et après l'avoir fermé, cherchent où est passée la recherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è un'icona a forma di matita nel posto della capsula separata a destra della barra delle schede. Toccandola compare un foglio di nuovo post. Gli utenti che hanno imparato quel posto come ricerca in altre app provano a cercare, finiscono su una schermata di scrittura e, dopo averla chiusa, vanno a cercare dove sia finita la ricerca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um ícone de lápis no lugar da cápsula separada à direita da barra de abas. Tocar nele traz uma folha de nova publicação. Usuários que aprenderam esse lugar como busca em outros apps tentam buscar, caem numa tela de escrita e, depois de fechá-la, vão procurar onde foi parar a busca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีไอคอนดินสออยู่ในตำแหน่งแคปซูลแยกทางขวาของแถบแท็บ แตะแล้วชีตโพสต์ใหม่ขึ้นมา ผู้ใช้ที่เรียนรู้ตำแหน่งนั้นเป็นการค้นหาในแอปอื่นพยายามค้นหา ลงเอยที่หน้าจอเขียน และหลังปิดก็ไปหาว่าการค้นหาหายไปไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có biểu tượng bút chì ở chỗ capsule riêng bên phải thanh tab. Chạm vào hiện sheet bài đăng mới. Người dùng đã học chỗ đó là tìm kiếm ở app khác sẽ thử tìm kiếm, rơi vào màn hình soạn, và sau khi đóng, đi tìm xem tìm kiếm đâu rồi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V místě samostatné kapsle vpravo od panelu karet je ikona tužky. Klepnutí vyvolá sheet nového příspěvku. Uživatelé, kteří se naučili toto místo jako hledání v jiných aplikacích, zkusí hledat, přistanou na obrazovce psaní a po jejím zavření hledají, kam hledání zmizelo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er et blyantikon på den separate kapselplads til højre på fanelinjen. Et tryk på det får et nyt-opslag-ark frem. Brugere, der har lært den plads som søgning i andre apps, prøver at søge, lander på en skriveskærm og går efter at have lukket den på jagt efter, hvor søgningen blev af."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει ένα εικονίδιο μολυβιού στη θέση της ξεχωριστής κάψουλας δεξιά της γραμμής καρτελών. Το πάτημά του φέρνει ένα φύλλο νέας ανάρτησης. Χρήστες που έμαθαν εκείνη τη θέση ως αναζήτηση σε άλλες εφαρμογές προσπαθούν να αναζητήσουν, καταλήγουν σε οθόνη σύνταξης, και αφού την κλείσουν, ψάχνουν πού πήγε η αναζήτηση."
          }
        }
      }
    },
    "탭바 오른쪽에 떨어져 있는 검색 캡슐이 있다. 그런데 시스템 캡슐보다 조금 크고, 브랜드 색으로 채워져 있고, 탭바와의 간격도 다르다. 누르면 캡슐이 검색 필드로 변하지 않고 새 화면이 밀려 들어온다. 다른 앱에서 익힌 대로 손을 뻗은 사용자는 비슷하지만 다르게 움직이는 캡슐을 만난다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a search capsule sitting apart on the right of the tab bar. But it's a bit bigger than the system capsule, filled with the brand color, and spaced differently from the tab bar. When tapped, the capsule doesn't turn into a search field; instead, a new screen slides in. Users who reach for it the way they learned in other apps meet a capsule that looks similar but behaves differently."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a search capsule sitting apart on the right of the tab bar. But it's a bit bigger than the system capsule, filled with the brand colour, and spaced differently from the tab bar. When tapped, the capsule doesn't turn into a search field; instead, a new screen slides in. Users who reach for it the way they learned in other apps meet a capsule that looks similar but behaves differently."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーの右側に離れて置かれた検索カプセルがある。ところがシステムのカプセルより少し大きく、ブランドカラーで塗られ、タブバーとの間隔も違う。タップしてもカプセルは検索フィールドに変わらず、新しい画面がスライドして入ってくる。ほかのアプリで覚えたとおりに手を伸ばしたユーザーは、似ているのに違う動きをするカプセルに出会う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏右侧有一个分开的搜索胶囊。可是它比系统胶囊稍大，填着品牌色，与标签栏的间距也不同。点按后，胶囊不是变成搜索框，而是推进来一个新界面。按在别的应用里学到的习惯伸手的用户，遇到一个看似相同、行为却不同的胶囊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列右側有一個分開的搜尋膠囊。可是它比系統膠囊稍大，填著品牌色，與標籤列的間距也不同。輕點後，膠囊不是變成搜尋框，而是推進來一個新介面。按在別的應用程式裡學到的習慣伸手的使用者，遇到一個看似相同、行為卻不同的膠囊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справа от панели вкладок отдельно стоит капсула поиска. Но она чуть больше системной, залита фирменным цветом, и интервалы у неё не такие, как у панели вкладок. При нажатии капсула не превращается в поле поиска: вместо этого въезжает новый экран. Пользователи, тянущиеся к ней так, как привыкли в других приложениях, встречают капсулу, которая выглядит похоже, но ведёт себя иначе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una cápsula de búsqueda separada a la derecha de la barra de pestañas. Pero es algo más grande que la cápsula del sistema, está rellena con el color de la marca y tiene un espaciado distinto del de la barra de pestañas. Al tocarla, la cápsula no se convierte en un campo de búsqueda; en su lugar entra una pantalla nueva deslizándose. Los usuarios que la buscan como aprendieron en otras apps se topan con una cápsula de aspecto parecido que se comporta distinto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts der Tab-Leiste sitzt abgesetzt eine Suchkapsel. Aber sie ist etwas größer als die Systemkapsel, mit der Markenfarbe gefüllt und anders beabstandet als die Tab-Leiste. Beim Antippen wird die Kapsel nicht zu einem Suchfeld; stattdessen gleitet ein neuer Bildschirm herein. Nutzer, die danach greifen, wie sie es in anderen Apps gelernt haben, treffen auf eine Kapsel, die ähnlich aussieht, sich aber anders verhält."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une capsule de recherche se tient à l'écart à droite de la barre d'onglets. Mais elle est un peu plus grande que la capsule système, remplie de la couleur de marque, et espacée différemment de la barre d'onglets. Au toucher, la capsule ne se transforme pas en champ de recherche ; à la place, un nouvel écran glisse. Les utilisateurs qui tendent la main vers elle comme ils l'ont appris dans d'autres apps rencontrent une capsule d'aspect semblable mais au comportement différent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è una capsula di ricerca staccata a destra della barra delle schede. Ma è un po' più grande della capsula di sistema, riempita con il colore del marchio e spaziata diversamente dalla barra delle schede. Quando la tocchi, la capsula non si trasforma in un campo di ricerca; invece scorre dentro una nuova schermata. Gli utenti che la cercano come hanno imparato in altre app incontrano una capsula che sembra simile ma si comporta diversamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma cápsula de busca afastada à direita da barra de abas. Mas é um pouco maior que a cápsula do sistema, preenchida com a cor da marca e espaçada diferente da barra de abas. Ao tocar, a cápsula não se transforma num campo de busca; em vez disso, desliza uma nova tela. Usuários que a procuram como aprenderam em outros apps encontram uma cápsula de aparência parecida mas comportamento diferente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแคปซูลค้นหาอยู่ห่างทางขวาของแถบแท็บ แต่ใหญ่กว่าแคปซูลของระบบเล็กน้อย เติมด้วยสีแบรนด์ และระยะห่างต่างจากแถบแท็บ เมื่อแตะ แคปซูลไม่กลายเป็นช่องค้นหา แต่มีหน้าจอใหม่เลื่อนเข้ามา ผู้ใช้ที่เอื้อมไปตามที่เรียนรู้ในแอปอื่นเจอแคปซูลที่ดูคล้ายแต่ทำงานต่างกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có một capsule tìm kiếm đứng tách ở bên phải thanh tab. Nhưng nó to hơn capsule hệ thống một chút, tô màu thương hiệu, và khoảng cách khác thanh tab. Khi chạm, capsule không biến thành ô tìm kiếm; thay vào đó một màn hình mới trượt vào. Người dùng với tay theo cách đã học ở app khác gặp một capsule trông giống mà cư xử khác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vpravo od panelu karet stojí odděleně kapsle hledání. Ale je o něco větší než systémová kapsle, vyplněná barvou značky a rozestupy jiné než panel karet. Po klepnutí se kapsle nezmění na vyhledávací pole; místo toho vyjede nová obrazovka. Uživatelé, kteří po ní sáhnou tak, jak se naučili v jiných aplikacích, narazí na kapsli, která vypadá podobně, ale chová se jinak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der sidder en søgekapsel for sig selv til højre på fanelinjen. Men den er lidt større end systemkapslen, fyldt med brandfarven og med anden afstand end fanelinjen. Når der trykkes, bliver kapslen ikke til et søgefelt; i stedet glider en ny skærm ind. Brugere, der rækker ud efter den, som de har lært i andre apps, møder en kapsel, der ligner men opfører sig anderledes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει μια κάψουλα αναζήτησης χωριστά δεξιά της γραμμής καρτελών. Είναι όμως λίγο μεγαλύτερη από την κάψουλα του συστήματος, γεμάτη με το χρώμα του brand, και με διαφορετικές αποστάσεις από τη γραμμή καρτελών. Όταν πατηθεί, η κάψουλα δεν γίνεται πεδίο αναζήτησης· αντί γι' αυτό μπαίνει μια νέα οθόνη. Οι χρήστες που την πιάνουν όπως έμαθαν σε άλλες εφαρμογές συναντούν μια κάψουλα που μοιάζει αλλά συμπεριφέρεται διαφορετικά."
          }
        }
      }
    },
    "탭바 위 액세서리 자리에 두 줄짜리 패널이 있다. 윗줄에는 곡 제목과 앨범 아트, 아랫줄에는 진행 바와 이전·재생·다음·반복·셔플 버튼이 있다. 어느 탭에 가든 이 패널이 하단을 두툼하게 차지하고, 목록의 마지막 몇 줄은 늘 그 아래에 깔린다. 버튼이 작아 누를 때마다 옆 버튼과 헷갈린다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a two-line panel in the accessory spot above the tab bar. The top line has the song title and album art; the bottom line has a progress bar and Previous, Play, Next, Repeat, and Shuffle buttons. On every tab, this panel takes up a thick chunk of the bottom, and the last few rows of any list are always buried beneath it. The buttons are small, so every tap risks hitting the one next to it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a two-line panel in the accessory spot above the tab bar. The top line has the song title and album art; the bottom line has a progress bar and Previous, Play, Next, Repeat, and Shuffle buttons. On every tab, this panel takes up a thick chunk of the bottom, and the last few rows of any list are always buried beneath it. The buttons are small, so every tap risks hitting the one next to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーの上のアクセサリの場所に、2行のパネルがある。上の行には曲名とアルバムアート、下の行には再生バーと、前へ、再生、次へ、リピート、シャッフルのボタンが並ぶ。どのタブへ行ってもこのパネルが下部を分厚く占め、リストの最後の数行はいつもその下に隠れる。ボタンが小さいので、押すたびに隣のボタンと紛らわしい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏上方的附件位置有一个两行的面板。上一行是歌名和专辑封面，下一行是进度条和上一首 · 播放 · 下一首 · 循环 · 随机按钮。无论去哪个标签，这个面板都厚厚地占着底部，列表的最后几行总是压在它下面。按钮很小，每次点都会和旁边的按钮混淆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列上方的附件位置有一個兩行的面板。上一行是歌名和專輯封面，下一行是進度條和上一首 · 播放 · 下一首 · 迴圈 · 隨機按鈕。無論去哪個標籤，這個面板都厚厚地佔著底部，列表的最後幾行總是壓在它下面。按鈕很小，每次點都會和旁邊的按鈕混淆。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На месте accessory над панелью вкладок стоит двухстрочная панель. В верхней строке название песни и обложка, в нижней индикатор прогресса и кнопки «Предыдущий», «Играть», «Следующий», «Повтор» и «Перемешать». На каждой вкладке эта панель занимает толстый кусок низа, и последние строки любого списка всегда погребены под ней. Кнопки мелкие, поэтому каждое нажатие рискует попасть в соседнюю."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un panel de dos líneas en el sitio del accesorio sobre la barra de pestañas. La línea de arriba tiene el título de la canción y la carátula; la de abajo tiene una barra de progreso y los botones Anterior, Reproducir, Siguiente, Repetir y Aleatorio. En todas las pestañas, este panel ocupa un grueso pedazo de la parte inferior, y las últimas filas de cualquier lista quedan siempre enterradas bajo él. Los botones son pequeños, así que cada toque arriesga dar al de al lado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Accessory-Platz über der Tab-Leiste steht ein zweizeiliges Panel. Die obere Zeile hat Songtitel und Albumcover; die untere Zeile hat einen Fortschrittsbalken und die Buttons Zurück, Wiedergabe, Weiter, Wiederholen und Zufall. Auf jedem Tab nimmt dieses Panel einen dicken Teil des unteren Rands ein, und die letzten Zeilen jeder Liste sind immer darunter begraben. Die Buttons sind klein, sodass jedes Antippen riskiert, den benachbarten zu treffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a un panneau de deux lignes à l'emplacement de l'accessoire au-dessus de la barre d'onglets. La ligne du haut a le titre du morceau et la pochette ; celle du bas a une barre de progression et les boutons Précédent, Lecture, Suivant, Répéter et Aléatoire. Sur chaque onglet, ce panneau prend une épaisse tranche du bas, et les dernières lignes de toute liste sont toujours enfouies dessous. Les boutons sont petits, donc chaque toucher risque de viser celui d'à côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è un pannello su due righe nel posto dell'accessorio sopra la barra delle schede. La riga in alto ha il titolo del brano e la copertina; quella in basso una barra di avanzamento e i pulsanti Precedente, Riproduci, Successivo, Ripeti e Casuale. Su ogni scheda, questo pannello occupa una grossa fetta del fondo, e le ultime righe di qualsiasi elenco sono sempre sepolte sotto di esso. I pulsanti sono piccoli, quindi a ogni tocco si rischia di colpire quello accanto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um painel de duas linhas no lugar do acessório acima da barra de abas. A linha de cima tem o título da música e a capa do álbum; a de baixo tem uma barra de progresso e os botões Anterior, Reproduzir, Próxima, Repetir e Aleatório. Em toda aba, esse painel ocupa um pedaço grosso da parte de baixo, e as últimas linhas de qualquer lista ficam sempre enterradas sob ele. Os botões são pequenos, então a cada toque se corre o risco de atingir o do lado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแผงสองบรรทัดในช่องอุปกรณ์เสริมเหนือแถบแท็บ บรรทัดบนมีชื่อเพลงและปกอัลบั้ม บรรทัดล่างมีแถบความคืบหน้าและปุ่มก่อนหน้า เล่น ถัดไป ซ้ำ และสุ่ม บนทุกแท็บ แผงนี้กินส่วนหนาของด้านล่าง และไม่กี่แถวสุดท้ายของรายการใด ๆ ถูกฝังใต้มันเสมอ ปุ่มเล็ก ทุกการแตะเสี่ยงโดนอันข้าง ๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có một bảng hai dòng ở chỗ phụ kiện phía trên thanh tab. Dòng trên có tên bài hát và ảnh bìa album; dòng dưới có thanh tiến trình và các nút Trước, Phát, Tiếp, Lặp lại và Trộn. Trên mọi tab, bảng này chiếm một mảng dày ở phần dưới, và vài dòng cuối của mọi danh sách luôn bị chôn dưới nó. Các nút nhỏ, nên mỗi lần chạm đều có nguy cơ trúng nút bên cạnh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V místě příslušenství nad panelem karet je dvouřádkový panel. Horní řádek má název písně a obal alba; spodní řádek má ukazatel průběhu a tlačítka Předchozí, Přehrát, Další, Opakovat a Náhodně. Na každé kartě tento panel zabírá tlustý kus spodku a posledních pár řádků každého seznamu je vždy pod ním pohřbeno. Tlačítka jsou malá, takže každé klepnutí riskuje trefení sousedního."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er et panel på to linjer i tilbehørspladsen over fanelinjen. Den øverste linje har sangtitlen og albumcoveret; den nederste linje har en statuslinje og knapperne Forrige, Afspil, Næste, Gentag og Bland. På hver fane optager dette panel en tyk del af bunden, og de sidste par rækker af enhver liste er altid begravet under det. Knapperne er små, så hvert tryk risikerer at ramme den ved siden af."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει ένα πάνελ δύο γραμμών στη θέση του accessory πάνω από τη γραμμή καρτελών. Η πάνω γραμμή έχει τον τίτλο τραγουδιού και το εξώφυλλο· η κάτω έχει γραμμή προόδου και κουμπιά Προηγούμενο, Αναπαραγωγή, Επόμενο, Επανάληψη και Τυχαία σειρά. Σε κάθε καρτέλα, αυτό το πάνελ πιάνει ένα χοντρό κομμάτι του κάτω μέρους, και οι τελευταίες γραμμές κάθε λίστας θάβονται πάντα από κάτω του. Τα κουμπιά είναι μικρά, οπότε κάθε πάτημα ρισκάρει να πέσει στο διπλανό."
          }
        }
      }
    },
    "탭바·툴바가 아닌 **커스텀 하단 UI**, 재생 컨트롤 바, CTA 버튼 띠, 입력 액세서리처럼 화면 고유의 하단 장치.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Custom bottom UI** that's neither a tab bar nor a toolbar, bottom controls specific to the screen: a playback control bar, a strip of CTA buttons, an input accessory."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Custom bottom UI** that's neither a tab bar nor a toolbar, bottom controls specific to the screen: a playback control bar, a strip of CTA buttons, an input accessory."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーでもツールバーでもない**カスタムの下部UI**。再生コントロールのバー、CTAボタンの帯、入力アクセサリなど、その画面固有の下部の装置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是标签栏、工具栏的**自定义底部 UI**：播放控制栏、CTA 按钮条、输入附件这类界面独有的底部装置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是標籤列、工具列的**自定義底部 UI**：播放控制列、CTA 按鈕條、輸入附件這類介面獨有的底部裝置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Пользовательский нижний интерфейс**, который не панель вкладок и не панель инструментов, нижние элементы управления, свойственные экрану: панель управления воспроизведением, полоса кнопок призыва к действию, input accessory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Interfaz inferior personalizada** que no es una barra de pestañas ni una barra de herramientas, controles inferiores propios de la pantalla: una barra de control de reproducción, una tira de botones de llamada a la acción, un accesorio de entrada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Eigene untere UI**, die weder Tab-Leiste noch Symbolleiste ist, bildschirmspezifische untere Steuerelemente: eine Wiedergabe-Steuerleiste, ein Streifen mit CTA-Buttons, ein Eingabe-Accessory."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Interface du bas personnalisée** qui n'est ni une barre d'onglets ni une barre d'outils, des contrôles du bas propres à l'écran : une barre de commandes de lecture, un bandeau de boutons CTA, un accessoire de saisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**UI personalizzata in basso** che non è né una barra delle schede né una barra degli strumenti, controlli in basso specifici della schermata: una barra di controllo della riproduzione, una fascia di pulsanti CTA, un accessorio di input."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Interface inferior personalizada** que não é nem barra de abas nem barra de ferramentas, controles inferiores específicos da tela: uma barra de controle de reprodução, uma faixa de botões de CTA, um acessório de entrada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**UI ด้านล่างที่กำหนดเอง**ที่ไม่ใช่แถบแท็บหรือแถบเครื่องมือ ตัวควบคุมด้านล่างเฉพาะหน้าจอ: แถบควบคุมการเล่น แถบปุ่ม CTA อุปกรณ์เสริมอินพุต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**UI dưới cùng tùy chỉnh** không phải thanh tab cũng không phải thanh công cụ, điều khiển phía dưới đặc thù của màn hình: thanh điều khiển phát, một dải nút CTA, một phụ kiện nhập liệu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vlastní spodní UI**, které není ani panelem karet, ani panelem nástrojů, spodní ovladače specifické pro obrazovku: panel ovládání přehrávání, pás CTA tlačítek, vstupní příslušenství."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Brugerdefineret nederste brugerflade**, der hverken er en fanelinje eller en værktøjslinje, nederste kontroller specifikke for skærmen: en afspilningskontrolbjælke, en stribe CTA-knapper, et inputtilbehør."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Προσαρμοσμένο κάτω UI** που δεν είναι ούτε γραμμή καρτελών ούτε γραμμή εργαλείων, κάτω έλεγχοι ειδικοί για την οθόνη: μια γραμμή ελέγχου αναπαραγωγής, μια λωρίδα κουμπιών CTA, ένα input accessory."
          }
        }
      }
    },
    "탭바가 있는 화면이라면 하단 공간을 공유하므로 신중히, 탭바(이동)와 툴바(액션)의 역할 구분을 흐리면 안 됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a screen with a tab bar, the bottom space is shared, so be careful: don't blur the line between the tab bar (navigation) and the toolbar (actions)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On a screen with a tab bar, the bottom space is shared, so be careful: don't blur the line between the tab bar (navigation) and the toolbar (actions)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーのある画面では下部のスペースを共有するので慎重に。タブバー（移動）とツールバー（アクション）の役割の区別を曖昧にしてはいけません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有标签栏的界面要共享底部空间，所以要谨慎：不要模糊标签栏（导航）与工具栏（操作）的角色区分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有標籤列的介面要共享底部空間，所以要謹慎：不要模糊標籤列（導覽）與工具列（操作）的角色區分。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране с панелью вкладок нижнее место общее, так что будьте осторожны: не размывайте границу между панелью вкладок (навигацией) и панелью инструментов (действиями)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una pantalla con barra de pestañas, el espacio inferior se comparte, así que ten cuidado: no difumines la línea entre la barra de pestañas (navegación) y la barra de herramientas (acciones)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem Bildschirm mit Tab-Leiste wird der untere Platz geteilt, also sei vorsichtig: Verwische nicht die Grenze zwischen der Tab-Leiste (Navigation) und der Symbolleiste (Aktionen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un écran avec barre d'onglets, l'espace du bas est partagé, donc soyez prudent : ne brouillez pas la frontière entre la barre d'onglets (navigation) et la barre d'outils (actions)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una schermata con una barra delle schede, lo spazio in basso è condiviso, quindi fai attenzione: non sfumare il confine tra la barra delle schede (navigazione) e la barra degli strumenti (azioni)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa tela com barra de abas, o espaço inferior é compartilhado, então tome cuidado: não borre a linha entre a barra de abas (navegação) e a barra de ferramentas (ações)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้าจอที่มีแถบแท็บ พื้นที่ด้านล่างถูกแบ่งร่วมกัน จึงต้องระวัง: อย่าทำให้เส้นแบ่งระหว่างแถบแท็บ (การนำทาง) กับแถบเครื่องมือ (การกระทำ) พร่ามัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình có thanh tab, chỗ phía dưới được dùng chung, nên hãy cẩn thận: đừng làm mờ ranh giới giữa thanh tab (điều hướng) và thanh công cụ (hành động)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na obrazovce s panelem karet je spodní místo sdílené, takže buďte opatrní: nerozmazávejte hranici mezi panelem karet (navigace) a panelem nástrojů (akce)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På en skærm med en fanelinje deles bundens plads, så vær forsigtig: udvisk ikke grænsen mellem fanelinjen (navigation) og værktøjslinjen (handlinger)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε οθόνη με γραμμή καρτελών, ο κάτω χώρος μοιράζεται, οπότε πρόσεχε: μην θολώνεις τη διαχωριστική γραμμή ανάμεσα στη γραμμή καρτελών (πλοήγηση) και τη γραμμή εργαλείων (ενέργειες)."
          }
        }
      }
    },
    "탭바가 접히면 액세서리가 **그 자리로 내려앉음**(inline)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the tab bar collapses, the accessory **drops down into its place** (inline)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the tab bar collapses, the accessory **drops down into its place** (inline)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーが折りたたまれると、アクセサリが**その場所に降りてくる**（inline）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏折叠时，附件**落到它的位置**（inline）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列摺疊時，附件**落到它的位置**（inline）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда панель вкладок сворачивается, accessory **опускается на её место** (inline)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la barra de pestañas se colapsa, el accesorio **baja a su sitio** (inline)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klappt die Tab-Leiste zusammen, **rückt das Accessory auf ihren Platz herab** (inline)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la barre d'onglets se replie, l'accessoire **descend à sa place** (inline)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la barra delle schede si comprime, l'accessorio **scende al suo posto** (inline)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a barra de abas recolhe, o acessório **desce para o seu lugar** (inline)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อแถบแท็บยุบ อุปกรณ์เสริม**ลงมาอยู่ในที่ของมัน** (inline)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thanh tab thu lại, phụ kiện **hạ xuống vào chỗ của nó** (inline)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se panel karet sbalí, příslušenství **sklouzne na jeho místo** (inline)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når fanelinjen folder sammen, **falder tilbehøret ned på dens plads** (inline)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν η γραμμή καρτελών συμπτύσσεται, το accessory **κατεβαίνει στη θέση της** (inline)"
          }
        }
      }
    },
    "탭바가 항상 보이는 이유는 **상시 지도**라서다. 목록과 얕은 상세를 오가는 화면에서는 그 지도가 방향 상실을 막아 준다. 하지만 사진 전체 화면에서 사용자의 과업은 이동이 아니라 **보는 것**이다. 그 순간에 지도는 과업에 보탬이 되지 않고 콘텐츠만 가린다.\n\n게다가 전체 화면 뷰어에는 뒤로가기라는 분명한 출구가 있다. 탭바가 없어도 길을 잃지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is always visible because it is **an always-on map**. On screens that move between a list and shallow details, that map keeps people from getting lost. But in a full-screen photo, the user's task isn't navigating, it's **looking**. At that moment the map does nothing for the task and only covers the content.\n\nOn top of that, a full-screen viewer has a clear exit: Back. People won't get lost even without the tab bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is always visible because it is **an always-on map**. On screens that move between a list and shallow details, that map keeps people from getting lost. But in a full-screen photo, the user's task isn't navigating, it's **looking**. At that moment the map does nothing for the task and only covers the content.\n\nOn top of that, a full-screen viewer has a clear exit: Back. People won't get lost even without the tab bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーが常に表示されるのは、それが**常設の地図**だからだ。リストと浅い詳細を行き来する画面では、その地図が迷子を防いでくれる。しかし写真のフルスクリーン表示では、ユーザーのタスクは移動ではなく**見ること**だ。その瞬間、地図はタスクの役に立たず、コンテンツを隠すだけになる。\n\nしかもフルスクリーンのビューアには「戻る」というはっきりした出口がある。タブバーがなくても迷うことはない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏之所以始终可见，是因为它是**常驻地图**。在列表与浅层详情之间往返的界面里，那张地图能防止迷失方向。但在照片全屏时，用户的任务不是移动而是**观看**。那一刻地图对任务没有帮助，只是遮住内容。\n\n而且全屏查看器有返回这个明确的出口。没有标签栏也不会迷路。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列之所以始終可見，是因為它是**常駐地圖**。在列表與淺層詳情之間往返的介面裡，那張地圖能防止迷失方向。但在照片全螢幕時，使用者的任務不是移動而是**觀看**。那一刻地圖對任務沒有幫助，只是遮住內容。\n\n而且全螢幕檢視器有返回這個明確的出口。沒有標籤列也不會迷路。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок всегда видна, потому что это **всегда включённая карта**. На экранах, где переходят между списком и неглубокими подробностями, эта карта не даёт людям потеряться. Но в полноэкранном фото задача пользователя - не навигация, а **просмотр**. В этот момент карта ничего не даёт задаче и лишь закрывает содержимое.\n\nК тому же у полноэкранного просмотрщика есть ясный выход: «Назад». Люди не потеряются и без панели вкладок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas está siempre visible porque es **un mapa siempre activo**. En pantallas que se mueven entre una lista y detalles poco profundos, ese mapa evita que la gente se pierda. Pero en una foto a pantalla completa, la tarea del usuario no es navegar, es **mirar**. En ese momento el mapa no hace nada por la tarea y solo tapa el contenido.\n\nAdemás, un visor a pantalla completa tiene una salida clara: Atrás. La gente no se perderá aunque no haya barra de pestañas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste ist immer sichtbar, weil sie **eine ständig aktive Karte** ist. Auf Bildschirmen, die zwischen einer Liste und flachen Details wechseln, bewahrt diese Karte Menschen vor dem Verirren. Aber in einem Vollbildfoto ist die Aufgabe des Nutzers nicht Navigieren, sondern **Ansehen**. In diesem Moment tut die Karte nichts für die Aufgabe und verdeckt nur den Inhalt.\n\nZudem hat ein Vollbild-Betrachter einen klaren Ausgang: Zurück. Menschen verirren sich auch ohne Tab-Leiste nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets est toujours visible parce qu'elle est **une carte toujours active**. Sur les écrans qui alternent entre une liste et des détails peu profonds, cette carte évite aux gens de se perdre. Mais dans une photo plein écran, la tâche de l'utilisateur n'est pas de naviguer, c'est de **regarder**. À ce moment-là, la carte ne sert à rien pour la tâche et ne fait que recouvrir le contenu.\n\nDe plus, un visualiseur plein écran a une sortie claire : Retour. Les gens ne se perdront pas même sans barre d'onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede è sempre visibile perché è **una mappa sempre attiva**. Nelle schermate che si muovono tra un elenco e dettagli poco profondi, quella mappa impedisce alle persone di perdersi. Ma in una foto a schermo intero, il compito dell'utente non è navigare, è **guardare**. In quel momento la mappa non fa nulla per il compito e copre soltanto il contenuto.\n\nIn più, un visualizzatore a schermo intero ha una chiara via d'uscita: Indietro. Le persone non si perdono nemmeno senza la barra delle schede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas fica sempre visível porque é **um mapa sempre ligado**. Em telas que circulam entre uma lista e detalhes rasos, esse mapa impede as pessoas de se perderem. Mas numa foto em tela cheia, a tarefa do usuário não é navegar, é **olhar**. Naquele momento o mapa não faz nada pela tarefa e só cobre o conteúdo.\n\nAlém disso, um visualizador em tela cheia tem uma saída clara: Voltar. As pessoas não se perdem nem sem a barra de abas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บมองเห็นตลอดเพราะเป็น**แผนที่ที่เปิดตลอด** บนหน้าจอที่เคลื่อนระหว่างรายการกับรายละเอียดที่ตื้น แผนที่นั้นทำให้คนไม่หลงทาง แต่ในรูปถ่ายเต็มหน้าจอ งานของผู้ใช้ไม่ใช่การนำทาง แต่คือ**การดู** ตอนนั้นแผนที่ไม่ทำอะไรเพื่องาน และแค่บังเนื้อหา\n\nยิ่งกว่านั้น ตัวดูเต็มหน้าจอมีทางออกชัด: ย้อนกลับ คนจะไม่หลงแม้ไม่มีแถบแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab luôn hiển thị vì nó là **bản đồ luôn bật**. Trên màn hình chuyển giữa danh sách và chi tiết nông, bản đồ đó giúp người ta không lạc. Nhưng trong ảnh toàn màn hình, tác vụ của người dùng không phải điều hướng, mà là **nhìn**. Lúc đó bản đồ không giúp gì cho tác vụ mà chỉ che nội dung.\n\nHơn nữa, trình xem toàn màn hình có lối thoát rõ ràng: Quay lại. Người ta sẽ không lạc ngay cả khi không có thanh tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet je vždy viditelný, protože je to **vždy zapnutá mapa**. Na obrazovkách, které se pohybují mezi seznamem a mělkými detaily, ta mapa brání lidem v ztrátě orientace. Ale na fotce na celou obrazovku není úkolem uživatele navigovat, ale **dívat se**. V tu chvíli mapa pro úkol nedělá nic a jen zakrývá obsah.\n\nNavíc prohlížeč na celou obrazovku má jasný východ: Zpět. Lidé se neztratí ani bez panelu karet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen er altid synlig, fordi den er **et altid tændt kort**. På skærme, der bevæger sig mellem en liste og lave detaljer, forhindrer det kort folk i at fare vild. Men i et fuldskærmsfoto er brugerens opgave ikke at navigere, den er **at se**. I det øjeblik gør kortet intet for opgaven og dækker kun indholdet.\n\nOveni har en fuldskærmsfremviser en tydelig udgang: Tilbage. Folk farer ikke vild, selv uden fanelinjen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών είναι πάντα ορατή επειδή είναι **ένας πάντα ενεργός χάρτης**. Σε οθόνες που κινούνται ανάμεσα σε λίστα και ρηχές λεπτομέρειες, αυτός ο χάρτης κρατά τους ανθρώπους από το να χαθούν. Αλλά σε μια φωτογραφία πλήρους οθόνης, η εργασία του χρήστη δεν είναι η πλοήγηση, είναι **το κοίταγμα**. Εκείνη τη στιγμή ο χάρτης δεν κάνει τίποτα για την εργασία και μόνο καλύπτει το περιεχόμενο.\n\nΕπιπλέον, ένας προβολέας πλήρους οθόνης έχει σαφή έξοδο: Πίσω. Οι άνθρωποι δεν θα χαθούν ακόμα και χωρίς τη γραμμή καρτελών."
          }
        }
      }
    },
    "탭바는 \"이 앱은 어떤 세계들로 이루어져 있는가\"를 말하는 지도다. 탭 하나하나가 **목적지라는 약속**이고, 사용자는 그 약속을 믿고 탭을 눌러 둘러본다. 이동하지 않는 탭은 \"어디로 가는가\"에 답하지 못한다. 선택이 원래 탭으로 되돌아가는 순간, 사용자는 자기가 뭘 잘못 눌렀다고 느낀다.\n\niOS 27의 `.prominent` 역할도 이 약속을 바꾸지 않는다. 겉모습만 강조될 뿐 여전히 탭이고, 액션 버튼의 대용이 아니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is a map that says \"What worlds does this app consist of?\" Each tab is **a promise of a destination**, and users trust that promise and tap tabs to look around. A tab that goes nowhere can't answer \"Where does this take me?\" The moment the selection snaps back to the original tab, users feel they tapped something wrong.\n\nThe `.prominent` role in iOS 27 doesn't change this promise either. Only its appearance is emphasized; it's still a tab, not a substitute for an action button."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is a map that says \"What worlds does this app consist of?\" Each tab is **a promise of a destination**, and users trust that promise and tap tabs to look around. A tab that goes nowhere can't answer \"Where does this take me?\" The moment the selection snaps back to the original tab, users feel they tapped something wrong.\n\nThe `.prominent` role in iOS 27 doesn't change this promise either. Only its appearance is emphasised; it's still a tab, not a substitute for an action button."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーは「このアプリはどんな世界でできているか」を語る地図だ。タブひとつひとつが**目的地という約束**で、ユーザーはその約束を信じてタブをタップし、見て回る。移動しないタブは「どこへ行くのか」に答えられない。選択が元のタブに戻った瞬間、ユーザーは自分が何かを押し間違えたと感じる。\n\niOS 27 の `.prominent` の役割もこの約束を変えない。見た目が強調されるだけで、あくまでタブであり、アクションボタンの代わりではない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏是说明“这个应用由哪些世界组成”的地图。每个标签都是**目的地的约定**，用户相信这个约定，点按标签去逛。不跳转的标签回答不了“要去哪里”。选中状态回到原来标签的那一刻，用户会觉得自己点错了什么。\n\niOS 27 的 `.prominent` role 也不改变这个约定。只是外观被强调，它仍然是标签，不是操作按钮的替身。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列是說明「這個應用程式由哪些世界組成」的地圖。每個標籤都是**目的地的約定**，使用者相信這個約定，輕點標籤去逛。不跳轉的標籤回答不了「要去哪裡」。選中狀態回到原來標籤的那一刻，使用者會覺得自己點錯了什麼。\n\niOS 27 的 `.prominent` role 也不改變這個約定。只是外觀被強調，它仍然是標籤，不是操作按鈕的替身。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок - карта, говорящая «из каких миров состоит это приложение?». Каждая вкладка - **обещание пункта назначения**, и пользователи верят этому обещанию и нажимают вкладки, чтобы осмотреться. Вкладка, никуда не ведущая, не может ответить на «Куда это меня приведёт?». В тот миг, когда выбор возвращается на исходную вкладку, пользователи чувствуют, что нажали не то.\n\nРоль `.prominent` в iOS 27 это обещание тоже не меняет. Усилен лишь внешний вид; это по-прежнему вкладка, а не замена кнопке действия."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas es un mapa que dice «¿de qué mundos se compone esta app?». Cada pestaña es **una promesa de destino**, y los usuarios confían en esa promesa y tocan pestañas para echar un vistazo. Una pestaña que no lleva a ninguna parte no puede responder a «¿Adónde me lleva esto?». En el momento en que la selección vuelve a la pestaña original, los usuarios sienten que tocaron lo que no era.\n\nEl rol `.prominent` de iOS 27 tampoco cambia esta promesa. Solo se enfatiza su aspecto; sigue siendo una pestaña, no un sustituto de un botón de acción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste ist eine Karte, die sagt: „Aus welchen Welten besteht diese App?“ Jeder Tab ist **ein Versprechen eines Ziels**, und Nutzer vertrauen diesem Versprechen und tippen Tabs an, um sich umzusehen. Ein Tab, der nirgendwohin führt, kann „Wohin führt das?“ nicht beantworten. In dem Moment, in dem die Auswahl auf den ursprünglichen Tab zurückschnappt, spüren Nutzer, dass sie etwas Falsches angetippt haben.\n\nAuch die Rolle `.prominent` in iOS 27 ändert dieses Versprechen nicht. Nur ihr Aussehen wird betont; es ist weiterhin ein Tab, kein Ersatz für einen Aktions-Button."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets est une carte qui dit « De quels mondes cette app se compose-t-elle ? » Chaque onglet est **une promesse de destination**, et les utilisateurs font confiance à cette promesse et touchent les onglets pour explorer. Un onglet qui ne mène nulle part ne peut pas répondre à « Où cela m'emmène-t-il ? » Au moment où la sélection revient à l'onglet d'origine, les utilisateurs ont l'impression d'avoir touché quelque chose de faux.\n\nLe rôle `.prominent` d'iOS 27 ne change pas non plus cette promesse. Seul son aspect est mis en avant ; c'est toujours un onglet, pas un substitut à un bouton d'action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede è una mappa che dice «di quali mondi è fatta questa app?». Ogni scheda è **una promessa di destinazione**, e gli utenti si fidano di quella promessa e toccano le schede per esplorare. Una scheda che non porta da nessuna parte non sa rispondere a «Dove mi porta?» Nel momento in cui la selezione torna alla scheda originale, gli utenti sentono di aver toccato qualcosa di sbagliato.\n\nNemmeno il ruolo `.prominent` di iOS 27 cambia questa promessa. Solo il suo aspetto viene enfatizzato; resta una scheda, non un sostituto di un pulsante di azione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas é um mapa que diz «de que mundos este app é feito?». Cada aba é **uma promessa de destino**, e os usuários confiam nessa promessa e tocam nas abas para explorar. Uma aba que não leva a lugar nenhum não sabe responder «Para onde isto me leva?» No instante em que a seleção volta à aba original, os usuários sentem que tocaram em algo errado.\n\nO papel `.prominent` do iOS 27 também não muda essa promessa. Só a aparência é enfatizada; continua sendo uma aba, não um substituto de um botão de ação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บคือแผนที่ที่บอกว่า \"แอปนี้ประกอบด้วยโลกอะไรบ้าง\" แต่ละแท็บคือ**คำมั่นของจุดหมายปลายทาง** และผู้ใช้เชื่อคำมั่นนั้นและแตะแท็บเพื่อสำรวจ แท็บที่ไม่ไปไหนตอบ \"สิ่งนี้พาฉันไปที่ไหน\" ไม่ได้ ทันทีที่การเลือกเด้งกลับไปแท็บเดิม ผู้ใช้รู้สึกว่าแตะผิด\n\nบทบาท `.prominent` ใน iOS 27 ก็ไม่เปลี่ยนคำมั่นนี้ มีแต่รูปลักษณ์ที่ถูกเน้น มันยังเป็นแท็บ ไม่ใช่ตัวแทนปุ่มการกระทำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab là bản đồ nói \"app này gồm những thế giới nào?\" Mỗi tab là **một lời hứa về điểm đến**, và người dùng tin lời hứa đó và chạm các tab để khám phá. Một tab không đến đâu thì không trả lời được \"Chạm vào đây thì đi đâu?\" Khoảnh khắc lựa chọn nhảy về tab ban đầu, người dùng cảm thấy mình chạm nhầm.\n\nVai trò `.prominent` ở iOS 27 cũng không đổi lời hứa này. Chỉ vẻ ngoài được nhấn mạnh; nó vẫn là tab, không thay thế cho nút hành động."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet je mapa, která říká „z jakých světů se tato aplikace skládá?“ Každá karta je **slib cíle** a uživatelé tomu slibu věří a klepou na karty, aby se rozhlédli. Karta, která nikam nevede, nemůže odpovědět na „Kam mě to zavede?“ Ve chvíli, kdy se výběr vrátí na původní kartu, uživatelé cítí, že klepli na něco špatného.\n\nRole `.prominent` v iOS 27 tento slib také nemění. Zdůrazněn je jen vzhled; stále je to karta, ne náhrada za tlačítko akce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen er et kort, der siger »hvilke verdener består denne app af?« Hver fane er **et løfte om en destination**, og brugerne stoler på det løfte og trykker på faner for at se sig omkring. En fane, der ikke går nogen steder, kan ikke svare på »Hvor fører det mig hen?« I det øjeblik markeringen springer tilbage til den oprindelige fane, føler brugerne, at de trykkede på noget forkert.\n\nRollen `.prominent` i iOS 27 ændrer heller ikke dette løfte. Kun dens udseende er fremhævet; den er stadig en fane, ikke en erstatning for en handlingsknap."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών είναι ένας χάρτης που λέει «από ποιους κόσμους αποτελείται αυτή η εφαρμογή;» Κάθε καρτέλα είναι **μια υπόσχεση προορισμού**, και οι χρήστες εμπιστεύονται αυτή την υπόσχεση και πατούν καρτέλες για να εξερευνήσουν. Μια καρτέλα που δεν πάει πουθενά δεν μπορεί να απαντήσει στο «Πού με πηγαίνει αυτό;» Τη στιγμή που η επιλογή επιστρέφει στην αρχική καρτέλα, οι χρήστες νιώθουν ότι πάτησαν κάτι λάθος.\n\nΟ ρόλος `.prominent` στο iOS 27 δεν αλλάζει ούτε αυτός αυτή την υπόσχεση. Μόνο η εμφάνιση τονίζεται· είναι ακόμα καρτέλα, όχι υποκατάστατο κουμπιού ενέργειας."
          }
        }
      }
    },
    "탭바는 “지금 어디에 있고 어디로 갈 수 있는지”를 보여주는 **상시 지도**, 항상 보이는 것 자체가 방향 상실을 막는 안정 장치입니다. 깊이 들어가도 “나는 이 탭 안에 있다”는 컨텍스트가 유지됨.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is a **constant map** showing \"where you are and where you can go,\" and simply being always visible is what keeps people from getting lost. Even deep inside, the context \"I'm in this tab\" holds."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is a **constant map** showing \"where you are and where you can go,\" and simply being always visible is what keeps people from getting lost. Even deep inside, the context \"I'm in this tab\" holds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーは「今どこにいて、どこへ行けるか」を示す**常設の地図**で、常に見えていること自体が迷子を防ぐ安定装置です。深く入っても「自分はこのタブの中にいる」という文脈が保たれる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏是显示“我现在在哪里、能去哪里”的**常驻地图**，始终可见本身就是防止迷失方向的稳定装置。即使深入，“我在这个标签里”的上下文也能保持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列是顯示「我現在在哪裡、能去哪裡」的**常駐地圖**，始終可見本身就是防止迷失方向的穩定裝置。即使深入，「我在這個標籤裡」的上下文也能保持。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок - **постоянная карта**, показывающая «где вы и куда можете пойти», и одной лишь постоянной видимости достаточно, чтобы люди не терялись. Даже глубоко внутри контекст «я в этой вкладке» сохраняется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas es un **mapa constante** que muestra «dónde estás y adónde puedes ir», y el simple hecho de estar siempre visible es lo que evita que la gente se pierda. Incluso en lo hondo, el contexto «estoy en esta pestaña» se mantiene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste ist eine **ständige Karte**, die zeigt, „wo du bist und wohin du gehen kannst“, und allein dass sie immer sichtbar ist, bewahrt Menschen vor dem Verirren. Selbst tief drinnen gilt der Kontext „ich bin in diesem Tab“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets est une **carte permanente** qui montre « où vous êtes et où vous pouvez aller », et le simple fait d'être toujours visible évite aux gens de se perdre. Même en profondeur, le contexte « je suis dans cet onglet » tient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede è una **mappa costante** che mostra «dove sei e dove puoi andare», e il semplice essere sempre visibile è ciò che impedisce alle persone di perdersi. Anche nel profondo, il contesto «sono in questa scheda» regge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas é um **mapa constante** que mostra «onde você está e aonde pode ir», e o simples fato de estar sempre visível é o que impede as pessoas de se perderem. Mesmo no fundo, o contexto «estou nesta aba» se mantém."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บคือ**แผนที่คงที่**ที่แสดง \"คุณอยู่ที่ไหนและไปไหนได้\" และการมองเห็นตลอดเองคือสิ่งที่ทำให้คนไม่หลงทาง แม้ลงลึก บริบท \"ฉันอยู่ในแท็บนี้\" ก็คงอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab là **bản đồ thường trực** cho thấy \"bạn ở đâu và có thể đi đâu\", và chỉ việc luôn hiển thị đã giúp người ta không lạc. Ngay cả ở sâu bên trong, bối cảnh \"tôi đang ở tab này\" vẫn giữ vững."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet je **stálá mapa** ukazující „kde jste a kam můžete jít“ a samotná jeho vždy viditelnost brání lidem ve ztrátě orientace. I hluboko uvnitř kontext „jsem na této kartě“ drží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen er et **konstant kort**, der viser »hvor du er, og hvor du kan gå hen«, og blot at være altid synlig er det, der holder folk fra at fare vild. Selv dybt inde holder konteksten »jeg er i denne fane«."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών είναι ένας **σταθερός χάρτης** που δείχνει «πού είσαι και πού μπορείς να πας», και το ότι είναι απλώς πάντα ορατή είναι αυτό που κρατά τους ανθρώπους από το να χαθούν. Ακόμα και βαθιά μέσα, το πλαίσιο «είμαι σε αυτή την καρτέλα» ισχύει."
          }
        }
      }
    },
    "탭바는 모든 화면에서 항상 보이는 자리다. 캠페인을 여기에 두면 노출이 보장된다. 홈 배너보다 확실하고, 푸시처럼 거슬리지도 않아 보인다. 탭 하나 늘리는 건 구현도 쉽다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is always visible on every screen. Put a campaign there and exposure is guaranteed. It seems more reliable than a home banner and less intrusive than a push notification. Adding one more tab is easy to implement, too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is always visible on every screen. Put a campaign there and exposure is guaranteed. It seems more reliable than a home banner and less intrusive than a push notification. Adding one more tab is easy to implement, too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーはすべての画面で常に見える場所だ。キャンペーンをここに置けば露出が保証される。ホームのバナーより確実で、プッシュ通知のようにうっとうしくもないように見える。タブを1つ増やすのは実装も簡単だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏是所有界面里始终可见的位置。把活动放在这里，曝光有保证。比首页横幅更可靠，看起来也不像推送那么烦人。多加一个标签，实现也容易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列是所有介面裡始終可見的位置。把活動放在這裡，曝光有保證。比首頁橫幅更可靠，看起來也不像推送那麼煩人。多加一個標籤，實作也容易。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок всегда видна на каждом экране. Поместите туда кампанию, и показ гарантирован. Это кажется надёжнее баннера на главной и менее навязчиво, чем пуш-уведомление. Добавить ещё одну вкладку к тому же просто реализовать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas está siempre visible en todas las pantallas. Pon ahí una campaña y la exposición está garantizada. Parece más fiable que un banner de inicio y menos intrusivo que una notificación push. Añadir una pestaña más también es fácil de implementar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste ist auf jedem Bildschirm immer sichtbar. Platziert man dort eine Kampagne, ist die Aufmerksamkeit garantiert. Es scheint verlässlicher als ein Home-Banner und weniger aufdringlich als eine Push-Benachrichtigung. Einen weiteren Tab hinzuzufügen ist auch leicht umzusetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets est toujours visible sur chaque écran. Mettez-y une campagne et l'exposition est garantie. Cela paraît plus fiable qu'une bannière d'accueil et moins intrusif qu'une notification push. Ajouter un onglet de plus est aussi facile à implémenter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede è sempre visibile in ogni schermata. Mettici una campagna e l'esposizione è garantita. Sembra più affidabile di un banner nella home e meno invadente di una notifica push. Aggiungere una scheda in più è anche facile da implementare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas fica sempre visível em toda tela. Ponha uma campanha ali e a exposição é garantida. Parece mais confiável que um banner na tela inicial e menos invasivo que uma notificação push. Acrescentar mais uma aba também é fácil de implementar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บมองเห็นบนทุกหน้าจอ วางแคมเปญตรงนั้น การเปิดเผยรับประกัน ดูน่าเชื่อถือกว่าแบนเนอร์หน้าแรกและรบกวนน้อยกว่าการแจ้งเตือนแบบพุช การเพิ่มอีกหนึ่งแท็บก็ทำง่ายด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab luôn hiển thị trên mọi màn hình. Đặt một chiến dịch ở đó thì bảo đảm được độ hiển thị. Có vẻ đáng tin hơn banner trang chủ và ít xâm phạm hơn thông báo đẩy. Thêm một tab cũng dễ cài đặt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet je vždy viditelný na každé obrazovce. Dejte tam kampaň a expozice je zaručená. Zdá se spolehlivější než banner na domovské obrazovce a méně rušivá než push oznámení. Přidat další kartu je také snadné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen er altid synlig på hver skærm. Læg en kampagne der, og eksponeringen er garanteret. Det virker mere pålideligt end et hjemmebanner og mindre påtrængende end en push-notifikation. At tilføje endnu en fane er også let at implementere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών είναι ορατή σε κάθε οθόνη. Βάλε εκεί μια καμπάνια και η έκθεση είναι εγγυημένη. Φαίνεται πιο αξιόπιστο από ένα banner στην αρχική και λιγότερο ενοχλητικό από μια ειδοποίηση push. Και το να προσθέσεις μία ακόμα καρτέλα υλοποιείται εύκολα."
          }
        }
      }
    },
    "탭바는 어디서든 다른 곳으로 갈 수 있게 해 주는 장치다. 항상 보이는 것이 기본값이고, 기본값을 지키는 것이 안전해 보인다. 사진을 보다가도 바로 다른 탭으로 갈 수 있으면 더 편할 것 같다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is what lets you go anywhere from anywhere. Always visible is the default, and sticking with the default feels safe. Being able to jump to another tab even while viewing a photo seems more convenient."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is what lets you go anywhere from anywhere. Always visible is the default, and sticking with the default feels safe. Being able to jump to another tab even while viewing a photo seems more convenient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーはどこからでも別の場所へ行けるようにする仕組みだ。常に表示されるのがデフォルトで、デフォルトを守るのが安全に見える。写真を見ている最中でもすぐ別のタブへ行けたほうが便利そうに思える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏是让人从任何地方去别处的装置。始终可见是默认值，守住默认值看起来很安全。看照片时也能直接去别的标签，似乎更方便。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列是讓人從任何地方去別處的裝置。始終可見是預設值，守住預設值看起來很安全。看照片時也能直接去別的標籤，似乎更方便。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок позволяет попасть откуда угодно куда угодно. Постоянная видимость - значение по умолчанию, а держаться значения по умолчанию кажется безопасным. Возможность перейти на другую вкладку даже при просмотре фото кажется удобнее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas es lo que te permite ir a cualquier sitio desde cualquier sitio. Siempre visible es el valor por defecto, y quedarse con el valor por defecto se siente seguro. Poder saltar a otra pestaña incluso mientras ves una foto parece más cómodo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit der Tab-Leiste kommt man von überall überallhin. Immer sichtbar ist der Standard, und beim Standard zu bleiben fühlt sich sicher an. Auch beim Ansehen eines Fotos zu einem anderen Tab springen zu können, scheint bequemer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets permet d'aller de partout n'importe où. Toujours visible est le réglage par défaut, et s'en tenir au réglage par défaut paraît sûr. Pouvoir sauter vers un autre onglet même en regardant une photo semble plus commode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede è ciò che ti permette di andare ovunque da ovunque. Sempre visibile è il predefinito, e restare sul predefinito sembra sicuro. Poter saltare a un'altra scheda anche mentre guardi una foto sembra più comodo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas é o que deixa você ir a qualquer lugar a partir de qualquer lugar. Sempre visível é o padrão, e ficar com o padrão parece seguro. Poder saltar para outra aba até enquanto vê uma foto parece mais cômodo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บคือสิ่งที่ให้คุณไปที่ไหนก็ได้จากที่ไหนก็ได้ มองเห็นตลอดคือค่าเริ่มต้น และการยึดค่าเริ่มต้นรู้สึกปลอดภัย การกระโดดไปแท็บอื่นได้แม้ขณะดูรูปถ่ายดูสะดวกกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab là thứ cho phép bạn đi bất cứ đâu từ bất cứ đâu. Luôn hiển thị là mặc định, và bám vào mặc định cảm thấy an toàn. Nhảy sang tab khác ngay cả khi đang xem ảnh có vẻ tiện hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet je to, co vám umožňuje jít odkudkoli kamkoli. Vždy viditelný je výchozí a držet se výchozího působí bezpečně. Mít možnost přeskočit na jinou kartu i při prohlížení fotky se zdá pohodlnější."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen er det, der lader dig gå hvor som helst fra hvor som helst. Altid synlig er standarden, og at holde fast i standarden føles sikkert. At kunne hoppe til en anden fane selv mens du ser på et foto virker mere bekvemt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών είναι αυτό που σου επιτρέπει να πας οπουδήποτε από οπουδήποτε. Το πάντα ορατή είναι η προεπιλογή, και το να μένεις στην προεπιλογή φαίνεται ασφαλές. Το να μπορείς να πηδήξεις σε άλλη καρτέλα ακόμα και ενώ βλέπεις μια φωτογραφία φαίνεται πιο βολικό."
          }
        }
      }
    },
    "탭바는 접혀도 **검색은 한 탭 거리** 유지": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar collapses, but **search stays one tap away**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar collapses, but **search stays one tap away**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーが折りたたまれても、**検索はタップひとつの距離**のまま"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏即使折叠，**搜索依然一次点按可达**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列即使摺疊，**搜尋依然一次輕點可達**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок сворачивается, но **поиск остаётся в одном нажатии**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas se colapsa, pero **la búsqueda sigue a un toque**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste klappt zusammen, aber **die Suche bleibt einen Tipp entfernt**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets se replie, mais **la recherche reste à un toucher**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede si comprime, ma **la ricerca resta a un tocco**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas recolhe, mas **a busca continua a um toque**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บยุบ แต่**การค้นหายังห่างแค่แตะเดียว**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab thu lại, nhưng **tìm kiếm vẫn cách một lần chạm**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet se sbalí, ale **hledání zůstane na jedno klepnutí**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen folder sammen, men **søgning er stadig ét tryk væk**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών συμπτύσσεται, αλλά **η αναζήτηση μένει ένα πάτημα μακριά**"
          }
        }
      }
    },
    "탭바는 항상 하단을 차지하는 **비싼 부동산**, 개수가 적을수록 각 탭의 명확성은 최대. 다만 2개뿐이면 탭 대신 세그먼트 컨트롤로 충분한 구조일 수 있음. 시스템이 개수를 강제하지 않는 건 구조가 앱 도메인의 문제이기 때문.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is **expensive real estate** that permanently occupies the bottom, and the fewer the tabs, the clearer each one is. That said, with only two, a segmented control may be all the structure you need. The system doesn't enforce a count because structure is a question for your app's domain."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is **expensive real estate** that permanently occupies the bottom, and the fewer the tabs, the clearer each one is. That said, with only two, a segmented control may be all the structure you need. The system doesn't enforce a count because structure is a question for your app's domain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーは常に下部を占める**高価な不動産**で、数が少ないほど各タブは明快になる。ただし2つだけなら、タブではなくセグメンテッドコントロールで足りる構造かもしれない。システムが数を強制しないのは、構造がアプリのドメインの問題だから。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏是始终占据底部的**昂贵地产**，数量越少，每个标签的明确性越大。不过只有 2 个时，用分段控件代替标签栏可能就够了。系统不强制数量，是因为结构是应用领域的问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列是始終佔據底部的**昂貴地產**，數量越少，每個標籤的明確性越大。不過只有 2 個時，用分段控制元件代替標籤列可能就夠了。系統不強制數量，是因為結構是應用程式領域的問題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок - **дорогая недвижимость**, постоянно занимающая низ, и чем меньше вкладок, тем яснее каждая. При этом если их всего две, структуре может хватить сегментированного элемента. Система не навязывает число, потому что структура - вопрос предметной области вашего приложения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas es **un terreno caro** que ocupa permanentemente la parte inferior, y cuantas menos pestañas, más clara es cada una. Dicho esto, con solo dos, un control segmentado puede ser toda la estructura que hace falta. El sistema no impone un número porque la estructura es una cuestión del dominio de tu app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste ist **teurer Platz**, der dauerhaft den unteren Rand belegt, und je weniger Tabs, desto klarer ist jeder. Allerdings genügt bei nur zwei vielleicht schon ein Segmented Control als Struktur. Das System erzwingt keine Anzahl, weil Struktur eine Frage der Domäne deiner App ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets est un **bien immobilier coûteux** qui occupe en permanence le bas, et moins il y a d'onglets, plus chacun est clair. Cela dit, avec seulement deux, un contrôle segmenté peut suffire comme structure. Le système n'impose pas de nombre parce que la structure relève du domaine de votre app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede è **uno spazio costoso** che occupa in permanenza il fondo, e meno schede ci sono, più chiara è ciascuna. Detto questo, con solo due, un controllo segmentato può essere tutta la struttura che ti serve. Il sistema non impone un numero perché la struttura è una questione del dominio della tua app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas é **um imóvel caro** que ocupa permanentemente a parte de baixo, e quanto menos abas, mais clara é cada uma. Dito isso, com apenas duas, um controle segmentado pode ser toda a estrutura de que você precisa. O sistema não impõe um número porque a estrutura é uma questão do domínio do seu app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บคือ**อสังหาริมทรัพย์ราคาแพง**ที่ยึดด้านล่างถาวร และยิ่งแท็บน้อย แต่ละอันยิ่งชัด ถึงอย่างนั้น ถ้ามีแค่สอง ตัวควบคุมแบบเซกเมนต์อาจเป็นโครงสร้างทั้งหมดที่คุณต้องการ ระบบไม่บังคับจำนวนเพราะโครงสร้างเป็นคำถามของโดเมนแอปของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab là **đất vàng** chiếm vĩnh viễn phần dưới, và càng ít tab thì mỗi tab càng rõ. Dù vậy, với chỉ hai, một segmented control có thể là đủ cấu trúc. Hệ thống không áp đặt số lượng vì cấu trúc là câu hỏi của miền ứng dụng của bạn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet je **drahá nemovitost**, která trvale zabírá spodek, a čím méně karet, tím jasnější je každá. Přesto se u pouhých dvou může jako celá struktura hodit segmentový ovladač. Systém počet nevynucuje, protože struktura je otázka domény vaší aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen er **dyr ejendom**, der permanent optager bunden, og jo færre faner, jo klarere er hver enkelt. Når det er sagt, med kun to kan en segmenteret kontrol være al den struktur, du har brug for. Systemet håndhæver ikke et antal, fordi struktur er et spørgsmål for din apps domæne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών είναι **ακριβό ακίνητο** που καταλαμβάνει μόνιμα το κάτω μέρος, και όσο λιγότερες οι καρτέλες, τόσο πιο σαφής η καθεμία. Παρ' όλα αυτά, με μόνο δύο, ένα segmented control μπορεί να είναι όλη η δομή που χρειάζεσαι. Το σύστημα δεν επιβάλλει αριθμό επειδή η δομή είναι ερώτημα του πεδίου της εφαρμογής σου."
          }
        }
      }
    },
    "탭바는 항상 하단을 차지하는 **비싼 부동산**이고, 탭 하나하나는 서로 다른 세계라는 선언이다. 같은 목록을 필터만 바꿔 보여 주는 것은 다른 세계가 아니라 **같은 화면의 두 상태**다. 그걸 탭으로 올리면 사용자는 \"완전히 다른 곳으로 이동했다\"고 읽고, 실제로는 거의 같은 화면을 다시 본다.\n\n게다가 시스템이 탭 개수를 강제하지 않는 것은 구조가 앱 도메인의 문제이기 때문이다. 탭 둘은 의무가 아니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is **expensive real estate** that always occupies the bottom of the screen, and each tab declares a separate world. Showing the same list with just a different filter isn't a separate world; it's **two states of the same screen**. Promote that to tabs, and users read it as \"I moved somewhere completely different,\" when in reality they're looking at almost the same screen again.\n\nMoreover, the system doesn't enforce a tab count because structure is a matter of the app's domain. Two tabs are not a requirement."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is **expensive real estate** that always occupies the bottom of the screen, and each tab declares a separate world. Showing the same list with just a different filter isn't a separate world; it's **two states of the same screen**. Promote that to tabs, and users read it as \"I moved somewhere completely different,\" when in reality they're looking at almost the same screen again.\n\nMoreover, the system doesn't enforce a tab count because structure is a matter of the app's domain. Two tabs are not a requirement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーは常に下部を占める**高価な一等地**で、タブの1つひとつは互いに別の世界だという宣言だ。同じリストをフィルタだけ変えて見せるのは別の世界ではなく、**同じ画面の2つの状態**だ。それをタブに格上げすると、ユーザーは「まったく別の場所に移動した」と読み取るが、実際にはほとんど同じ画面をもう一度見ている。\n\nそもそもシステムがタブの数を強制しないのは、構造がアプリのドメインの問題だからだ。タブ2つは義務ではない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏是始终占据底部的**昂贵地产**，每个标签都是“不同世界”的宣告。同一个列表只换筛选来显示，不是不同的世界，而是**同一界面的两种状态**。把它升格成标签，用户会读成“去了一个完全不同的地方”，实际上看的是几乎一样的界面。\n\n而且系统不强制标签数量，是因为结构是应用领域的问题。两个标签不是义务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列是始終佔據底部的**昂貴地產**，每個標籤都是「不同世界」的宣告。同一個列表只換篩選來顯示，不是不同的世界，而是**同一介面的兩種狀態**。把它升格成標籤，使用者會讀成「去了一個完全不同的地方」，實際上看的是幾乎一樣的介面。\n\n而且系統不強制標籤數量，是因為結構是應用程式領域的問題。兩個標籤不是義務。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок - **дорогая недвижимость**, постоянно занимающая низ экрана, и каждая вкладка объявляет отдельный мир. Показ одного и того же списка с другим фильтром - не отдельный мир, а **два состояния одного экрана**. Поднимите это до вкладок, и пользователи прочтут «я перешёл в совсем другое место», хотя на деле смотрят почти тот же экран снова.\n\nКроме того, система не навязывает число вкладок, потому что структура - дело предметной области приложения. Две вкладки - не требование."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas es **un terreno caro** que ocupa siempre la parte inferior de la pantalla, y cada pestaña declara un mundo aparte. Mostrar la misma lista con solo otro filtro no es un mundo aparte; son **dos estados de la misma pantalla**. Ascéndelos a pestañas y los usuarios lo leen como «me he movido a un sitio totalmente distinto», cuando en realidad están mirando casi la misma pantalla otra vez.\n\nAdemás, el sistema no impone un número de pestañas porque la estructura es cosa del dominio de la app. Dos pestañas no son un requisito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste ist **teurer Platz**, der immer den unteren Bildschirmrand belegt, und jeder Tab erklärt eine eigene Welt. Dieselbe Liste mit nur einem anderen Filter zu zeigen, ist keine eigene Welt; es sind **zwei Zustände desselben Bildschirms**. Befördert man das zu Tabs, lesen Nutzer es als „ich bin ganz woanders hingegangen“, obwohl sie in Wirklichkeit fast denselben Bildschirm noch einmal sehen.\n\nZudem erzwingt das System keine Tab-Anzahl, weil Struktur eine Frage der Domäne der App ist. Zwei Tabs sind keine Pflicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets est un **bien immobilier coûteux** qui occupe toujours le bas de l'écran, et chaque onglet déclare un monde distinct. Montrer la même liste avec un simple filtre différent n'est pas un monde distinct ; ce sont **deux états du même écran**. Promouvez cela en onglets, et les utilisateurs le lisent comme « je suis allé ailleurs, complètement », alors qu'en réalité ils regardent à nouveau presque le même écran.\n\nPar ailleurs, le système n'impose pas de nombre d'onglets parce que la structure relève du domaine de l'app. Deux onglets ne sont pas une obligation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede è **uno spazio costoso** che occupa sempre il fondo dello schermo, e ogni scheda dichiara un mondo separato. Mostrare lo stesso elenco con solo un filtro diverso non è un mondo separato; sono **due stati della stessa schermata**. Promuovili a schede e gli utenti lo leggono come «mi sono spostato in un posto completamente diverso», quando in realtà stanno guardando di nuovo quasi la stessa schermata.\n\nInoltre, il sistema non impone un numero di schede perché la struttura è una questione del dominio dell'app. Due schede non sono un requisito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas é **um imóvel caro** que ocupa sempre a parte de baixo da tela, e cada aba declara um mundo separado. Mostrar a mesma lista só com um filtro diferente não é um mundo separado; são **dois estados da mesma tela**. Promova isso a abas e os usuários leem como «me mudei para um lugar completamente diferente», quando na verdade estão olhando quase a mesma tela de novo.\n\nAlém disso, o sistema não impõe um número de abas porque a estrutura é uma questão do domínio do app. Duas abas não são um requisito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บคือ**อสังหาริมทรัพย์ราคาแพง**ที่ยึดด้านล่างของหน้าจอเสมอ และแต่ละแท็บประกาศโลกแยก การแสดงรายการเดียวกันที่แค่ตัวกรองต่างกันไม่ใช่โลกแยก แต่เป็น**สองสถานะของหน้าจอเดียวกัน** ยกขึ้นเป็นแท็บ ผู้ใช้อ่านว่า \"ฉันย้ายไปที่ที่ต่างไปโดยสิ้นเชิง\" ทั้งที่จริงกำลังดูหน้าจอเกือบเดิมอีกครั้ง\n\nยิ่งกว่านั้น ระบบไม่บังคับจำนวนแท็บเพราะโครงสร้างเป็นเรื่องของโดเมนแอป สองแท็บไม่ใช่ข้อบังคับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab là **đất vàng** luôn chiếm đáy màn hình, và mỗi tab tuyên bố một thế giới riêng. Hiện cùng một danh sách chỉ khác bộ lọc không phải một thế giới riêng; đó là **hai trạng thái của cùng một màn hình**. Nâng lên thành tab, người dùng đọc là \"tôi đã chuyển đến nơi hoàn toàn khác\", trong khi thực tế họ lại xem gần như cùng một màn hình.\n\nHơn nữa, hệ thống không áp đặt số tab vì cấu trúc là chuyện của miền ứng dụng. Hai tab không phải là yêu cầu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet je **drahá nemovitost**, která vždy zabírá spodek obrazovky, a každá karta deklaruje samostatný svět. Zobrazit stejný seznam jen s jiným filtrem není samostatný svět; jsou to **dva stavy téže obrazovky**. Povyšte to na karty a uživatelé to čtou jako „přesunul jsem se úplně jinam“, zatímco ve skutečnosti se dívají na téměř tutéž obrazovku znovu.\n\nNavíc systém počet karet nevynucuje, protože struktura je věcí domény aplikace. Dvě karty nejsou požadavek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen er **dyr ejendom**, der altid optager skærmens bund, og hver fane erklærer en separat verden. At vise den samme liste med blot et andet filter er ikke en separat verden; det er **to tilstande af den samme skærm**. Løft det til faner, og brugerne læser det som »jeg flyttede til et helt andet sted«, mens de i virkeligheden ser på næsten den samme skærm igen.\n\nSystemet håndhæver desuden ikke et antal faner, fordi struktur er et spørgsmål om appens domæne. To faner er ikke et krav."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών είναι **ακριβό ακίνητο** που καταλαμβάνει πάντα το κάτω μέρος της οθόνης, και κάθε καρτέλα δηλώνει έναν ξεχωριστό κόσμο. Το να δείχνεις την ίδια λίστα με απλώς διαφορετικό φίλτρο δεν είναι ξεχωριστός κόσμος· είναι **δύο καταστάσεις της ίδιας οθόνης**. Προώθησέ το σε καρτέλες και οι χρήστες το διαβάζουν ως «μετακινήθηκα κάπου εντελώς διαφορετικά», ενώ στην πραγματικότητα κοιτούν σχεδόν την ίδια οθόνη ξανά.\n\nΕπιπλέον, το σύστημα δεν επιβάλλει αριθμό καρτελών επειδή η δομή είναι θέμα του πεδίου της εφαρμογής. Δύο καρτέλες δεν είναι απαίτηση."
          }
        }
      }
    },
    "탭바를 숨기고 하단에 유사 탭바를 커스텀으로 다시 만든다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding the tab bar and rebuilding a custom fake tab bar at the bottom"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding the tab bar and rebuilding a custom fake tab bar at the bottom"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーを隠して、下部に偽のタブバーを自作する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏标签栏，并在底部用自定义方式重新做一个类似的标签栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏標籤列，並在底部用自定義方式重新做一個類似的標籤列"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытие панели вкладок и пересборка внизу собственной поддельной панели вкладок"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar la barra de pestañas y reconstruir abajo una falsa barra de pestañas personalizada"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste ausblenden und unten eine eigene gefälschte Tab-Leiste nachbauen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer la barre d'onglets et reconstruire en bas une fausse barre d'onglets personnalisée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondere la barra delle schede e ricostruire in basso una falsa barra delle schede personalizzata"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar a barra de abas e reconstruir embaixo uma falsa barra de abas personalizada"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนแถบแท็บและสร้างแถบแท็บปลอมที่กำหนดเองที่ด้านล่างใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn thanh tab và dựng lại một thanh tab giả tùy chỉnh ở dưới"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrytí panelu karet a postavení vlastního falešného panelu karet dole"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At skjule fanelinjen og genopbygge en brugerdefineret falsk fanelinje i bunden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόκρυψη της γραμμής καρτελών και ανακατασκευή μιας ψεύτικης προσαρμοσμένης γραμμής καρτελών κάτω"
          }
        }
      }
    },
    "탭바를 숨기는 것은 예외다. 그 예외가 맞는 곳은 **콘텐츠에 몰입하는 것이 과업인 화면**이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding the tab bar is the exception. Where that exception fits is **screens where immersing in content is the task**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding the tab bar is the exception. Where that exception fits is **screens where immersing in content is the task**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーを隠すのは例外だ。その例外が当てはまるのは、**コンテンツに没入することがタスクである画面**だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏标签栏是例外。这个例外适用的地方，是**沉浸于内容就是任务的界面**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏標籤列是例外。這個例外適用的地方，是**沉浸於內容就是任務的介面**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытие панели вкладок - исключение. Это исключение подходит **экранам, где задача - погружение в содержимое**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar la barra de pestañas es la excepción. Esa excepción encaja en **pantallas donde sumergirse en el contenido es la tarea**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste auszublenden ist die Ausnahme. Wo diese Ausnahme passt, sind **Bildschirme, auf denen das Eintauchen in den Inhalt die Aufgabe ist**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer la barre d'onglets est l'exception. Là où cette exception convient, ce sont **les écrans où s'immerger dans le contenu est la tâche**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondere la barra delle schede è l'eccezione. Il posto in cui questa eccezione si adatta sono le **schermate in cui immergersi nel contenuto è il compito**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar a barra de abas é a exceção. O lugar em que essa exceção se encaixa são **telas em que imergir no conteúdo é a tarefa**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซ่อนแถบแท็บคือข้อยกเว้น ที่ที่ข้อยกเว้นนั้นเหมาะคือ**หน้าจอที่การดื่มด่ำในเนื้อหาคืองาน**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn thanh tab là ngoại lệ. Nơi ngoại lệ đó hợp là **màn hình mà đắm chìm vào nội dung là tác vụ**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrytí panelu karet je výjimka. Kde ta výjimka sedí, jsou **obrazovky, kde pohlcení obsahem je úkol**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At skjule fanelinjen er undtagelsen. Hvor den undtagelse passer, er **skærme, hvor fordybelse i indhold er opgaven**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απόκρυψη της γραμμής καρτελών είναι η εξαίρεση. Εκεί που ταιριάζει αυτή η εξαίρεση είναι **οθόνες όπου η εμβύθιση στο περιεχόμενο είναι η εργασία**."
          }
        }
      }
    },
    "탭바를 숨기는 이유는 **주 작업이 바뀌었기 때문**이다. 목록에서는 이동이 주 작업이지만, 사진 전체 화면이나 영상 재생에서는 소비가 주 작업이라 크롬이 물러난다. 설정의 알림 화면은 몰입할 콘텐츠가 없다. 스위치 몇 개를 바꾸고 떠나는 화면이라 주 작업은 여전히 이동에 가깝다. 여기서 탭바를 숨기면 돌려받을 콘텐츠도 없이 **이동성만 잃는다.**\n\n숨겼다 나타날 때의 레이아웃 점프도 비용이다. 얕은 화면을 자주 오갈수록 그 흔들림이 자주 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hide the tab bar **because the primary task has changed**. In a list, navigating is the primary task, but in a full-screen photo or video playback, consuming is the primary task, so the chrome steps back. The Notifications settings screen has no content to immerse in. It's a screen where you change a few switches and leave, so the primary task is still closer to navigating. Hiding the tab bar here gives back no content and **only costs mobility.**\n\nThe layout jump when it hides and reappears is a cost too. The more often people move between shallow screens, the more often they see that shake."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You hide the tab bar **because the primary task has changed**. In a list, navigating is the primary task, but in a full-screen photo or video playback, consuming is the primary task, so the chrome steps back. The Notifications settings screen has no content to immerse in. It's a screen where you change a few switches and leave, so the primary task is still closer to navigating. Hiding the tab bar here gives back no content and **only costs mobility.**\n\nThe layout jump when it hides and reappears is a cost too. The more often people move between shallow screens, the more often they see that shake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーを隠すのは、**主なタスクが変わったから**だ。リストでは移動が主なタスクだが、写真のフルスクリーン表示や動画再生では消費が主なタスクになるので、クロームが退く。設定の通知画面には没入するコンテンツがない。スイッチを少し変えて離れる画面なので、主なタスクは依然として移動に近い。ここでタブバーを隠すと、取り戻すコンテンツもないまま**移動のしやすさだけを失う。**\n\n隠れたり現れたりするときのレイアウトのジャンプもコストだ。浅い画面を頻繁に行き来するほど、そのがたつきを頻繁に目にする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏标签栏的理由是**主要任务变了**。列表里的主要任务是移动，而在照片全屏或视频播放里，主要任务是观看，所以界面框架退后。设置里的通知界面没有可沉浸的内容。那是改几个开关就离开的界面，主要任务仍然接近移动。在这里隐藏标签栏，连可以还给的内容都没有，只会**失去可移动性**。\n\n隐藏又出现时的布局跳动也是成本。越是在浅层界面之间频繁往返，这种晃动就越常被看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏標籤列的理由是**主要任務變了**。列表裡的主要任務是移動，而在照片全螢幕或影片播放裡，主要任務是觀看，所以介面框架退後。設定裡的通知介面沒有可沉浸的內容。那是改幾個開關就離開的介面，主要任務仍然接近移動。在這裡隱藏標籤列，連可以還給的內容都沒有，只會**失去可移動性**。\n\n隱藏又出現時的佈局跳動也是成本。越是在淺層介面之間頻繁往返，這種晃動就越常被看到。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы скрываете панель вкладок, **потому что основная задача изменилась**. В списке основная задача - навигация, а в полноэкранном фото или воспроизведении видео основная задача - потребление, поэтому хром отступает. На экране настроек уведомлений погружаться не в что. Это экран, где меняют пару переключателей и уходят, так что основная задача по-прежнему ближе к навигации. Скрытие панели вкладок здесь не возвращает содержимого и **лишь стоит мобильности.**\n\nПрыжок макета при скрытии и появлении - тоже цена. Чем чаще люди переходят между неглубокими экранами, тем чаще видят это дрожание."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultas la barra de pestañas **porque la tarea principal ha cambiado**. En una lista, navegar es la tarea principal, pero en una foto a pantalla completa o en la reproducción de vídeo, la tarea principal es consumir, así que el cromo retrocede. La pantalla de ajustes de Notificaciones no tiene contenido en el que sumergirse. Es una pantalla donde cambias unos interruptores y te vas, así que la tarea principal sigue estando más cerca de navegar. Ocultar aquí la barra de pestañas no devuelve contenido y **solo cuesta movilidad.**\n\nEl salto de diseño al ocultarse y reaparecer también es un coste. Cuanto más a menudo se mueve la gente entre pantallas poco profundas, más a menudo ve ese temblor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du blendest die Tab-Leiste aus, **weil sich die Hauptaufgabe geändert hat**. In einer Liste ist Navigieren die Hauptaufgabe, aber bei einem Vollbildfoto oder Videowiedergabe ist es Konsumieren, also tritt das Chrome zurück. Der Einstellungsbildschirm Mitteilungen hat keinen Inhalt zum Eintauchen. Es ist ein Bildschirm, auf dem man ein paar Schalter ändert und geht, also liegt die Hauptaufgabe noch näher beim Navigieren. Hier die Tab-Leiste auszublenden gibt keinen Inhalt zurück und **kostet nur Mobilität.**\n\nDer Layoutsprung beim Ausblenden und Wiedererscheinen ist ebenfalls ein Preis. Je öfter Menschen zwischen flachen Bildschirmen wechseln, desto öfter sehen sie dieses Wackeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous masquez la barre d'onglets **parce que la tâche principale a changé**. Dans une liste, naviguer est la tâche principale, mais dans une photo plein écran ou une lecture vidéo, consommer est la tâche principale, donc le chrome s'efface. L'écran de réglages Notifications n'a pas de contenu dans lequel s'immerger. C'est un écran où l'on change quelques interrupteurs et où l'on part, donc la tâche principale est encore plus proche de la navigation. Y masquer la barre d'onglets ne rend aucun contenu et **ne coûte que de la mobilité.**\n\nLe saut de mise en page au masquage et à la réapparition est aussi un coût. Plus les gens passent souvent entre des écrans peu profonds, plus ils voient souvent ce tremblement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi la barra delle schede **perché il compito principale è cambiato**. In un elenco, navigare è il compito principale, ma in una foto a schermo intero o nella riproduzione di un video, consumare è il compito principale, quindi il chrome si fa da parte. La schermata delle impostazioni delle Notifiche non ha contenuto in cui immergersi. È una schermata in cui cambi qualche interruttore e te ne vai, quindi il compito principale è ancora più vicino alla navigazione. Nascondere qui la barra delle schede non restituisce alcun contenuto e **costa soltanto mobilità.**\n\nAnche il salto di layout quando si nasconde e ricompare è un costo. Più spesso le persone si muovono tra schermate poco profonde, più spesso vedono quel tremolio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você oculta a barra de abas **porque a tarefa principal mudou**. Numa lista, navegar é a tarefa principal, mas numa foto em tela cheia ou na reprodução de vídeo, consumir é a tarefa principal, então o chrome recua. A tela de ajustes de Notificações não tem conteúdo em que imergir. É uma tela em que você muda alguns interruptores e sai, então a tarefa principal ainda está mais perto da navegação. Ocultar a barra de abas aqui não devolve conteúdo e **só custa mobilidade.**\n\nO salto de layout quando ela se oculta e reaparece também é um custo. Quanto mais as pessoas circulam entre telas rasas, mais vezes veem esse tremor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณซ่อนแถบแท็บ**เพราะงานหลักเปลี่ยน** ในรายการ งานหลักคือการนำทาง แต่ในรูปถ่ายเต็มหน้าจอหรือการเล่นวิดีโอ งานหลักคือการอ่านเสพ ส่วนห่อหุ้มจึงถอย หน้าจอการตั้งค่าการแจ้งเตือนไม่มีเนื้อหาให้ดื่มด่ำ เป็นหน้าจอที่คุณเปลี่ยนสวิตช์ไม่กี่อันแล้วออก งานหลักจึงยังใกล้การนำทาง การซ่อนแถบแท็บที่นี่ไม่ได้เนื้อหาคืนและ**เสียแต่ความคล่องตัว**\n\nการกระโดดของเลย์เอาต์เมื่อซ่อนและปรากฏก็เป็นต้นทุนเช่นกัน ยิ่งคนสลับระหว่างหน้าจอตื้นบ่อย ก็ยิ่งเห็นการสั่นนั้นบ่อย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn ẩn thanh tab **vì tác vụ chính đã đổi**. Trong danh sách, điều hướng là tác vụ chính, nhưng trong ảnh toàn màn hình hay phát video, tiêu thụ là tác vụ chính, nên khung giao diện lùi lại. Màn hình cài đặt Thông báo không có nội dung để đắm chìm. Đó là màn hình bạn đổi vài công tắc rồi rời đi, nên tác vụ chính vẫn gần với điều hướng hơn. Ẩn thanh tab ở đây không trả lại nội dung nào và **chỉ tốn tính cơ động.**\n\nBố cục nhảy khi ẩn và hiện lại cũng là một cái giá. Người ta chuyển giữa các màn hình nông càng thường xuyên, họ càng hay thấy cú rung đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet skrýváte **protože se změnil hlavní úkol**. V seznamu je hlavním úkolem navigace, ale u fotky na celou obrazovku nebo přehrávání videa je hlavním úkolem konzumace, takže rámec ustupuje. Obrazovka nastavení Oznámení nemá obsah, do něhož se pohltit. Je to obrazovka, kde změníte pár přepínačů a odejdete, takže hlavní úkol je stále bližší navigaci. Skrytí panelu karet zde nevrací žádný obsah a **stojí jen pohyblivost.**\n\nSkok rozvržení při skrytí a opětovném zobrazení je také cena. Čím častěji lidé přecházejí mezi mělkými obrazovkami, tím častěji to chvění vidí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skjuler fanelinjen **fordi hovedopgaven har ændret sig**. I en liste er navigation hovedopgaven, men i et fuldskærmsfoto eller ved videoafspilning er forbrug hovedopgaven, så chrome træder tilbage. Indstillingsskærmen Notifikationer har intet indhold at fordybe sig i. Det er en skærm, hvor du ændrer nogle få kontakter og går, så hovedopgaven er stadig tættere på navigation. At skjule fanelinjen her giver intet indhold tilbage og **koster kun mobilitet.**\n\nLayoutspringet ved skjul og genvisning er også en omkostning. Jo oftere folk bevæger sig mellem lave skærme, jo oftere ser de den rystelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρύβεις τη γραμμή καρτελών **επειδή άλλαξε η κύρια εργασία**. Σε μια λίστα, η πλοήγηση είναι η κύρια εργασία, αλλά σε φωτογραφία πλήρους οθόνης ή αναπαραγωγή βίντεο, η κατανάλωση είναι η κύρια εργασία, οπότε το chrome υποχωρεί. Η οθόνη ρυθμίσεων Ειδοποιήσεων δεν έχει περιεχόμενο για εμβύθιση. Είναι οθόνη όπου αλλάζεις μερικούς διακόπτες και φεύγεις, οπότε η κύρια εργασία είναι ακόμα πιο κοντά στην πλοήγηση. Η απόκρυψη της γραμμής καρτελών εδώ δεν επιστρέφει κανένα περιεχόμενο και **κοστίζει μόνο κινητικότητα.**\n\nΤο πήδημα της διάταξης όταν κρύβεται και ξαναεμφανίζεται είναι κι αυτό κόστος. Όσο πιο συχνά μετακινούνται οι άνθρωποι ανάμεσα σε ρηχές οθόνες, τόσο πιο συχνά βλέπουν αυτό το τρέμουλο."
          }
        }
      }
    },
    "탭바에 \"새 글\" 탭이 있다. 누르면 탭 선택 표시가 잠깐 그쪽으로 가는 듯하다가, 화면은 그대로이고 작성 시트만 올라온다. 시트를 닫으면 원래 탭으로 돌아와 있다. \"그 탭에는 무엇이 있지?\" 하고 다시 눌러 봐도 같은 시트만 뜬다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a \"New Post\" tab in the tab bar. When tapped, the selection indicator seems to move there for a moment, but the screen stays the same and only a compose sheet slides up. When you close the sheet, you're back on the original tab. Wondering \"What's in that tab?\", you tap it again and get the same sheet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a \"New Post\" tab in the tab bar. When tapped, the selection indicator seems to move there for a moment, but the screen stays the same and only a compose sheet slides up. When you close the sheet, you're back on the original tab. Wondering \"What's in that tab?\", you tap it again and get the same sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーに「新規投稿」タブがある。タップすると、選択表示が一瞬そちらへ移ったように見えるが、画面はそのままで作成シートだけが上がってくる。シートを閉じると元のタブに戻っている。「あのタブには何があるんだろう？」ともう一度タップしても、同じシートが出るだけだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏里有一个“新帖”标签。点按后，标签的选中标记似乎往那边去了一下，然后界面不变，只升起撰写弹层。关闭弹层，已经回到原来的标签。想着“这个标签里有什么？”再点一次，弹出的还是同一个弹层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列裡有一個「新帖」標籤。輕點後，標籤的選中標記似乎往那邊去了一下，然後介面不變，只升起撰寫工作表。關閉工作表，已經回到原來的標籤。想著「這個標籤裡有什麼？」再點一次，彈出的還是同一個工作表。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В панели вкладок есть вкладка «Новая запись». При нажатии индикатор выбора как будто на миг переезжает на неё, но экран остаётся прежним, и лишь выезжает шторка создания. Закроете шторку, и вы снова на исходной вкладке. Гадая «что в этой вкладке?», нажимаете ещё раз и получаете ту же шторку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una pestaña «Nueva publicación» en la barra de pestañas. Al tocarla, el indicador de selección parece moverse ahí un momento, pero la pantalla sigue igual y solo sube una hoja de redactar. Cuando cierras la hoja, estás de vuelta en la pestaña original. Preguntándote «¿qué hay en esa pestaña?», la tocas otra vez y obtienes la misma hoja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Tab-Leiste gibt es einen Tab „Neuer Beitrag“. Beim Antippen scheint der Auswahlindikator kurz dorthin zu wandern, aber der Bildschirm bleibt gleich, und nur ein Verfassen-Sheet gleitet hoch. Schließt man das Sheet, ist man wieder auf dem ursprünglichen Tab. Mit der Frage „Was ist in diesem Tab?“ tippt man ihn erneut an und bekommt dasselbe Sheet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a un onglet « Nouvelle publication » dans la barre d'onglets. Au toucher, l'indicateur de sélection semble s'y déplacer un instant, mais l'écran reste le même et seule une feuille de rédaction glisse vers le haut. Quand vous fermez la feuille, vous êtes de retour sur l'onglet d'origine. Vous demandant « Qu'y a-t-il dans cet onglet ? », vous le touchez à nouveau et obtenez la même feuille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è una scheda «Nuovo post» nella barra delle schede. Quando la tocchi, l'indicatore di selezione sembra spostarsi lì per un attimo, ma la schermata resta la stessa e sale solo un foglio di scrittura. Quando chiudi il foglio, sei di nuovo sulla scheda originale. Chiedendoti «Cosa c'è in quella scheda?», la tocchi di nuovo e ottieni lo stesso foglio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma aba «Nova publicação» na barra de abas. Ao tocar, o indicador de seleção parece se mover para lá por um instante, mas a tela continua a mesma e só uma folha de escrita sobe. Ao fechar a folha, você volta para a aba original. Perguntando-se «O que há naquela aba?», você toca de novo e recebe a mesma folha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแท็บ \"โพสต์ใหม่\" ในแถบแท็บ เมื่อแตะ ตัวบ่งชี้การเลือกดูเหมือนย้ายไปที่นั่นชั่วครู่ แต่หน้าจอยังเหมือนเดิมและมีแค่ชีตเขียนเลื่อนขึ้น เมื่อปิดชีต คุณกลับมาแท็บเดิม สงสัยว่า \"ในแท็บนั้นมีอะไร\" คุณแตะอีกครั้งและได้ชีตเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có tab \"Bài đăng mới\" trong thanh tab. Khi chạm, chỉ báo lựa chọn dường như chuyển đến đó một lát, nhưng màn hình vẫn như cũ và chỉ có một sheet soạn trượt lên. Khi đóng sheet, bạn quay về tab ban đầu. Tự hỏi \"Trong tab đó có gì?\", bạn chạm lại và nhận cùng sheet đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V panelu karet je karta „Nový příspěvek“. Po klepnutí se indikátor výběru na chvíli zdá přesunout tam, ale obrazovka zůstane stejná a vyjede jen sheet psaní. Když sheet zavřete, jste zpět na původní kartě. Říkáte si „Co je v té kartě?“, klepnete znovu a dostanete stejný sheet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er en fane »Nyt opslag« i fanelinjen. Når der trykkes, ser det ud til, at markeringsindikatoren et øjeblik flytter derhen, men skærmen forbliver den samme, og kun et skriveark glider op. Når du lukker arket, er du tilbage på den oprindelige fane. Du undrer dig over »Hvad er der i den fane?« og trykker på den igen og får det samme ark."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει μια καρτέλα «Νέα ανάρτηση» στη γραμμή καρτελών. Όταν πατηθεί, ο δείκτης επιλογής φαίνεται να μετακινείται εκεί για λίγο, αλλά η οθόνη μένει ίδια και μόνο ένα φύλλο σύνταξης ανεβαίνει. Όταν κλείσεις το φύλλο, είσαι πάλι στην αρχική καρτέλα. Αναρωτώμενος «Τι έχει εκείνη η καρτέλα;», την πατάς ξανά και παίρνεις το ίδιο φύλλο."
          }
        }
      }
    },
    "탭바에 \"피드\"와 \"리포트\" 두 탭이 있다. 앱을 여는 거의 모든 순간 사용자는 피드에 있고, 리포트는 가끔 들른다. 그런데 리포트 탭은 늘 피드와 같은 무게로 하단 절반을 차지한다. 탭바가 둘로 나뉘어 있어서 이 앱이 두 가지 일을 똑같이 하는 앱처럼 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar has two tabs: \"Feed\" and \"Reports.\" Almost every time users open the app, they're in Feed, and they drop by Reports only occasionally. Yet the Reports tab always takes up half of the bottom bar, with the same weight as Feed. Because the tab bar is split in two, the app looks as if it does two jobs equally."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar has two tabs: \"Feed\" and \"Reports.\" Almost every time users open the app, they're in Feed, and they drop by Reports only occasionally. Yet the Reports tab always takes up half of the bottom bar, with the same weight as Feed. Because the tab bar is split in two, the app looks as if it does two jobs equally."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーに「フィード」と「レポート」の2つのタブがある。アプリを開くほぼすべての瞬間、ユーザーはフィードにいて、レポートにはたまに立ち寄るだけだ。それなのにレポートのタブは、常にフィードと同じ重みで下部の半分を占めている。タブバーが2つに分かれているせいで、このアプリが2つの仕事を同じだけこなすアプリのように見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏里有“动态”和“报告”两个标签。打开应用的几乎每一刻，用户都在动态里，报告只是偶尔去看看。可是报告标签始终以和动态相同的分量占着底部一半。标签栏被分成两半，这个应用看起来像是平等地做两件事的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列裡有「動態」和「報告」兩個標籤。開啟應用程式的幾乎每一刻，使用者都在動態裡，報告只是偶爾去看看。可是報告標籤始終以和動態相同的分量佔著底部一半。標籤列被分成兩半，這個應用程式看起來像是平等地做兩件事的應用程式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В панели вкладок две вкладки: «Лента» и «Отчёты». Почти каждый раз, открывая приложение, пользователи оказываются в «Ленте», а в «Отчёты» заглядывают лишь изредка. Но вкладка «Отчёты» всегда занимает половину нижней панели, с тем же весом, что «Лента». Поскольку панель вкладок поделена надвое, приложение выглядит так, будто выполняет две работы поровну."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas tiene dos pestañas: «Feed» e «Informes». Casi cada vez que los usuarios abren la app, están en Feed, y solo de vez en cuando pasan por Informes. Pero la pestaña Informes ocupa siempre la mitad de la barra inferior, con el mismo peso que Feed. Como la barra de pestañas está dividida en dos, la app parece hacer dos trabajos por igual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste hat zwei Tabs: „Feed“ und „Berichte“. Fast jedes Mal, wenn Nutzer die App öffnen, sind sie im Feed, und bei Berichten schauen sie nur gelegentlich vorbei. Doch der Tab Berichte nimmt immer die Hälfte der unteren Leiste ein, mit demselben Gewicht wie Feed. Weil die Tab-Leiste in zwei geteilt ist, sieht es aus, als erledige die App zwei Aufgaben gleichrangig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets compte deux onglets : « Fil » et « Rapports ». Presque chaque fois que les utilisateurs ouvrent l'app, ils sont dans Fil, et ils ne passent par Rapports qu'occasionnellement. Pourtant l'onglet Rapports occupe toujours la moitié de la barre du bas, avec le même poids que Fil. Parce que la barre d'onglets est scindée en deux, l'app semble remplir deux tâches de façon égale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede ha due schede: «Feed» e «Rapporti». Quasi ogni volta che gli utenti aprono l'app sono in Feed, e passano da Rapporti solo di rado. Eppure la scheda Rapporti occupa sempre metà della barra in basso, con lo stesso peso di Feed. Poiché la barra delle schede è divisa in due, l'app sembra fare due lavori in egual misura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas tem duas abas: «Feed» e «Relatórios». Quase toda vez que os usuários abrem o app, estão no Feed, e só passam por Relatórios de vez em quando. Mesmo assim, a aba Relatórios ocupa sempre metade da barra inferior, com o mesmo peso do Feed. Como a barra de abas é dividida em duas, o app parece fazer dois trabalhos em igual medida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บมีสองแท็บ: \"ฟีด\" และ \"รายงาน\" เกือบทุกครั้งที่ผู้ใช้เปิดแอป พวกเขาอยู่ในฟีด และแวะรายงานนาน ๆ ครั้ง แต่แท็บรายงานยังกินครึ่งหนึ่งของแถบล่างตลอด ด้วยน้ำหนักเท่าฟีด เพราะแถบแท็บแบ่งเป็นสอง แอปจึงดูเหมือนทำสองงานเท่ากัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab có hai tab: \"Bảng tin\" và \"Báo cáo.\" Gần như mỗi lần người dùng mở app, họ ở Bảng tin, và chỉ thỉnh thoảng ghé Báo cáo. Vậy mà tab Báo cáo luôn chiếm nửa thanh dưới, cùng sức nặng với Bảng tin. Vì thanh tab chia làm hai, app trông như làm hai việc ngang nhau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet má dvě karty: „Kanál“ a „Zprávy“. Téměř pokaždé, když uživatelé otevřou aplikaci, jsou v Kanálu a do Zpráv se jen občas stavují. Přesto karta Zprávy vždy zabírá polovinu spodního panelu se stejnou váhou jako Kanál. Protože je panel karet rozdělen na dvě, aplikace vypadá, jako by dělala dvě práce stejně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen har to faner: »Feed« og »Rapporter.« Næsten hver gang brugerne åbner appen, er de i Feed, og de kigger kun forbi Rapporter en gang imellem. Alligevel optager fanen Rapporter altid halvdelen af den nederste bjælke, med samme vægt som Feed. Fordi fanelinjen er delt i to, ser appen ud, som om den udfører to opgaver lige meget."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών έχει δύο καρτέλες: «Ροή» και «Αναφορές». Σχεδόν κάθε φορά που οι χρήστες ανοίγουν την εφαρμογή, είναι στη Ροή, και περνούν από τις Αναφορές μόνο περιστασιακά. Κι όμως η καρτέλα Αναφορές πιάνει πάντα το μισό της κάτω γραμμής, με το ίδιο βάρος με τη Ροή. Επειδή η γραμμή καρτελών χωρίζεται στα δύο, η εφαρμογή φαίνεται να κάνει δύο δουλειές εξίσου."
          }
        }
      }
    },
    "탭바에 \"홈\", \"검색\", \"내가 찜한 목록\", \"프로필\"이 나란히 있다. 셋째 라벨만 길어서 잘리거나 옆 탭과 겹친다. 좁은 기기나 큰 글씨에서는 \"내가 찜…\"만 남는다. 나머지 셋이 한 단어라 이 칸 하나에서 탭바의 리듬이 깨진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar shows \"Home,\" \"Search,\" \"My Saved Items,\" and \"Profile\" side by side. Only the third label is long, so it gets truncated or overlaps the neighboring tab. On narrow devices or with larger text, only \"My Sav…\" remains. The other three are single words, so this one slot breaks the tab bar's rhythm."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar shows \"Home,\" \"Search,\" \"My Saved Items,\" and \"Profile\" side by side. Only the third label is long, so it gets truncated or overlaps the neighbouring tab. On narrow devices or with larger text, only \"My Sav…\" remains. The other three are single words, so this one slot breaks the tab bar's rhythm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーに「ホーム」「検索」「お気に入りリスト」「プロフィール」が並んでいる。3つ目のラベルだけが長く、切り詰められるか隣のタブと重なる。幅の狭いデバイスや大きな文字では「お気に入…」しか残らない。残りの3つが1語なので、この1枠だけでタブバーのリズムが崩れる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏里并排着“首页”“搜索”“我收藏的列表”“个人资料”。只有第三个标签文字很长，被截断或与旁边的标签重叠。在窄设备或大字号下，只剩“我收藏…”。其余三个是一个词，所以这一格就打乱了标签栏的节奏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列裡並排著「首頁」「搜尋」「我收藏的列表」「個人資料」。只有第三個標籤文字很長，被截斷或與旁邊的標籤重疊。在窄裝置或大字號下，只剩「我收藏…」。其餘三個是一個詞，所以這一格就打亂了標籤列的節奏。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В панели вкладок рядом стоят «Главная», «Поиск», «Мои сохранённые» и «Профиль». Только третья подпись длинная, поэтому она усекается или налезает на соседнюю вкладку. На узких устройствах или при более крупном тексте остаётся лишь «Мои сохр…». Остальные три - отдельные слова, поэтому один этот слот ломает ритм панели вкладок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas muestra juntos «Inicio», «Buscar», «Mis guardados» y «Perfil». Solo la tercera etiqueta es larga, así que se trunca o se solapa con la pestaña vecina. En dispositivos estrechos o con texto más grande, solo queda «Mis gua…». Las otras tres son palabras sueltas, así que este solo hueco rompe el ritmo de la barra de pestañas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tab-Leiste zeigt „Start“, „Suche“, „Meine gespeicherten Elemente“ und „Profil“ nebeneinander. Nur die dritte Beschriftung ist lang, sodass sie abgeschnitten wird oder den benachbarten Tab überlappt. Auf schmalen Geräten oder bei größerem Text bleibt nur „Meine gesp…“ übrig. Die anderen drei sind einzelne Wörter, sodass dieser eine Platz den Rhythmus der Tab-Leiste bricht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets affiche côte à côte « Accueil », « Recherche », « Mes éléments enregistrés » et « Profil ». Seul le troisième libellé est long, donc il est tronqué ou chevauche l'onglet voisin. Sur les appareils étroits ou avec un texte plus grand, il ne reste que « Mes élém… ». Les trois autres sont des mots seuls, si bien que ce seul emplacement brise le rythme de la barre d'onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede mostra affiancate «Home», «Cerca», «I miei elementi salvati» e «Profilo». Solo la terza etichetta è lunga, quindi viene troncata o si sovrappone alla scheda vicina. Sui dispositivi stretti o con testo più grande, resta solo «I miei el…». Le altre tre sono parole singole, quindi questo solo slot rompe il ritmo della barra delle schede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas mostra lado a lado «Início», «Buscar», «Meus itens salvos» e «Perfil». Só o terceiro rótulo é longo, então é truncado ou se sobrepõe à aba vizinha. Em dispositivos estreitos ou com texto maior, resta só «Meus it…». As outras três são palavras únicas, então este lugar sozinho quebra o ritmo da barra de abas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บแสดง \"หน้าแรก\" \"ค้นหา\" \"รายการที่บันทึกของฉัน\" และ \"โปรไฟล์\" เคียงกัน มีแค่ป้ายที่สามที่ยาว จึงถูกตัดหรือทับแท็บข้าง ๆ บนอุปกรณ์แคบหรือตัวอักษรใหญ่ เหลือแค่ \"รายการที่บั…\" อีกสามเป็นคำเดียว ช่องเดียวนี้จึงทำลายจังหวะของแถบแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab hiện \"Trang chủ\", \"Tìm kiếm\", \"Mục đã lưu của tôi\" và \"Hồ sơ\" cạnh nhau. Chỉ nhãn thứ ba dài, nên bị cắt hoặc đè lên tab bên cạnh. Trên thiết bị hẹp hoặc chữ lớn hơn, chỉ còn \"Mục đã…\". Ba nhãn kia là từ đơn, nên riêng ô này phá nhịp của thanh tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet ukazuje vedle sebe „Domů“, „Hledat“, „Moje uložené položky“ a „Profil“. Jen třetí popisek je dlouhý, takže se ořízne nebo překrývá sousední kartu. Na úzkých zařízeních nebo s větším textem zbyde jen „Moje ulo…“. Další tři jsou jednoslovné, takže tento jediný slot narušuje rytmus panelu karet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen viser »Hjem«, »Søg«, »Mine gemte ting« og »Profil« side om side. Kun den tredje etiket er lang, så den bliver afkortet eller overlapper nabofanen. På smalle enheder eller med større tekst er der kun »Mine gem…« tilbage. De tre andre er enkelte ord, så denne ene plads bryder fanelinjens rytme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών δείχνει δίπλα-δίπλα «Αρχική», «Αναζήτηση», «Τα Αποθηκευμένα Μου» και «Προφίλ». Μόνο η τρίτη ετικέτα είναι μακριά, οπότε περικόπτεται ή επικαλύπτει τη γειτονική καρτέλα. Σε στενές συσκευές ή με μεγαλύτερο κείμενο, μένει μόνο «Τα Αποθ…». Οι άλλες τρεις είναι μονολεκτικές, οπότε αυτή η θέση σπάει τον ρυθμό της γραμμής καρτελών."
          }
        }
      }
    },
    "탭바에 무엇을 넣기 전에 **\"누르면 어디로 가는가\"**를 한 단어로 말해 본다. 장소가 아니라 동사가 나오면 툴바로 보낸다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before putting anything in the tab bar, try saying in one word **\"Where does tapping it take you?\"** If you come up with a verb instead of a place, send it to the toolbar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before putting anything in the tab bar, try saying in one word **\"Where does tapping it take you?\"** If you come up with a verb instead of a place, send it to the toolbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーに何かを入れる前に、**「タップするとどこへ行くか**」を一語で言ってみる。場所ではなく動詞が出てきたら、ツールバーへ送る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "往标签栏里放东西之前，先用一个词说出**“点了去哪里”**。说出的不是地点而是动词，就送去工具栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往標籤列裡放東西之前，先用一個詞說出**「點了去哪裡」**。說出的不是地點而是動詞，就送去工具列。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем что-то поставить в панель вкладок, попробуйте сказать одним словом **«Куда ведёт нажатие?»** Если вам пришёл на ум глагол, а не место, отправьте это на панель инструментов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de poner nada en la barra de pestañas, prueba a decir en una palabra **«¿Adónde lleva tocarlo?»** Si te sale un verbo en lugar de un lugar, mándalo a la barra de herramientas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du etwas in die Tab-Leiste setzt, versuche in einem Wort zu sagen: **„Wohin führt das Antippen?“** Fällt dir ein Verb statt eines Ortes ein, schicke es in die Symbolleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de mettre quoi que ce soit dans la barre d'onglets, essayez de dire en un mot **« Où mène le toucher ? »** Si vous trouvez un verbe au lieu d'un lieu, envoyez-le dans la barre d'outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di mettere qualcosa nella barra delle schede, prova a dire in una parola **«Dove ti porta toccarla?»** Se ti viene in mente un verbo invece di un luogo, mandala nella barra degli strumenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de pôr qualquer coisa na barra de abas, tente dizer em uma palavra **«Aonde leva tocar nisto?»** Se você pensa num verbo e não num lugar, mande para a barra de ferramentas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนใส่อะไรในแถบแท็บ ลองบอกในหนึ่งคำ **\"แตะแล้วพาคุณไปที่ไหน\"** ถ้าคุณได้คำกริยาแทนที่ ให้ส่งไปแถบเครื่องมือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi đặt gì vào thanh tab, hãy thử nói trong một từ **\"Chạm vào nó thì đi đến đâu?\"** Nếu bạn nghĩ ra một động từ thay vì một nơi chốn, hãy đưa nó vào thanh công cụ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než cokoli dáte do panelu karet, zkuste říct jedním slovem **„Kam vás klepnutí zavede?“** Pokud vás napadne sloveso místo místa, pošlete to na panel nástrojů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du lægger noget i fanelinjen, så prøv at sige i ét ord **»Hvor fører et tryk på den dig hen?«** Hvis du kommer på et udsagnsord frem for et sted, så send den til værktøjslinjen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν βάλεις οτιδήποτε στη γραμμή καρτελών, δοκίμασε να πεις με μία λέξη **«Πού σε πηγαίνει το πάτημά του;»** Αν σου βγει ρήμα αντί για τόπο, στείλ' το στη γραμμή εργαλείων."
          }
        }
      }
    },
    "탭바에 아이콘 넷이 글자 없이 나란히 있다. 말풍선, 하트, 종, 별. 모두 가는 윤곽선이고 크기와 무게가 같다. 처음 연 사람은 어느 탭이 무엇인지 모른 채 하나씩 눌러 본 뒤에야 구조를 외운다. 사진이 깔린 화면 위에서는 네 윤곽이 더 비슷해진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four icons sit side by side in the tab bar with no text: a speech bubble, a heart, a bell, and a star. All are thin outlines of the same size and weight. Someone opening the app for the first time doesn't know which tab is which, and only memorizes the structure after tapping each one. Over a screen with photos behind it, the four outlines look even more alike."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Four icons sit side by side in the tab bar with no text: a speech bubble, a heart, a bell, and a star. All are thin outlines of the same size and weight. Someone opening the app for the first time doesn't know which tab is which, and only memorises the structure after tapping each one. Over a screen with photos behind it, the four outlines look even more alike."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーに4つのアイコンが文字なしで並んでいる。吹き出し、ハート、ベル、星。どれも細いアウトラインで、サイズも太さも同じだ。初めて開いた人はどのタブが何なのかわからないまま、1つずつ押してみてようやく構造を覚える。写真が敷かれた画面の上では、4つのアウトラインがさらに似て見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏里并排着四个没有文字的图标：对话气泡、爱心、铃铛、星星。全是细轮廓线，大小和粗细一样。第一次打开的人不知道哪个标签是什么，一个个点了之后才记住结构。在铺着照片的界面上，四个轮廓更像了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列裡並排著四個沒有文字的圖示：對話氣泡、愛心、鈴鐺、星星。全是細輪廓線，大小和粗細一樣。第一次開啟的人不知道哪個標籤是什麼，一個個點了之後才記住結構。在鋪著照片的介面上，四個輪廓更像了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В панели вкладок рядом стоят четыре значка без текста: речевой пузырь, сердце, колокольчик и звезда. Все они тонкие контуры одинакового размера и толщины. Тот, кто открывает приложение впервые, не знает, какая вкладка какая, и запоминает структуру лишь нажав на каждую. На экране с фото позади четыре контура выглядят ещё более одинаковыми."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro iconos están juntos en la barra de pestañas sin texto: un globo de diálogo, un corazón, una campana y una estrella. Todos son contornos finos del mismo tamaño y grosor. Quien abre la app por primera vez no sabe qué pestaña es cuál, y solo memoriza la estructura tras tocar cada una. Sobre una pantalla con fotos detrás, los cuatro contornos se parecen aún más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Symbole stehen ohne Text nebeneinander in der Tab-Leiste: eine Sprechblase, ein Herz, eine Glocke und ein Stern. Alle sind dünne Umrisse gleicher Größe und Stärke. Wer die App zum ersten Mal öffnet, weiß nicht, welcher Tab welcher ist, und prägt sich die Struktur erst nach dem Antippen jedes einzelnen ein. Über einem Bildschirm mit Fotos dahinter sehen die vier Umrisse noch ähnlicher aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre icônes sont côte à côte dans la barre d'onglets sans texte : une bulle, un cœur, une cloche et une étoile. Toutes sont de fins contours de même taille et de même épaisseur. Quelqu'un qui ouvre l'app pour la première fois ne sait pas quel onglet est lequel, et ne mémorise la structure qu'après avoir touché chacun. Sur un écran avec des photos derrière, les quatre contours se ressemblent encore plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quattro icone stanno affiancate nella barra delle schede senza testo: un fumetto, un cuore, una campana e una stella. Tutte sono sottili contorni della stessa dimensione e dello stesso spessore. Chi apre l'app per la prima volta non sa quale scheda sia quale, e memorizza la struttura solo dopo aver toccato ciascuna. Sopra una schermata con foto dietro, i quattro contorni si somigliano ancora di più."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro ícones ficam lado a lado na barra de abas sem texto: um balão de fala, um coração, um sino e uma estrela. Todos são contornos finos do mesmo tamanho e espessura. Quem abre o app pela primeira vez não sabe qual aba é qual, e só memoriza a estrutura depois de tocar em cada uma. Sobre uma tela com fotos atrás, os quatro contornos se parecem ainda mais."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนสี่อันเรียงข้างกันในแถบแท็บโดยไม่มีข้อความ: ฟองคำพูด หัวใจ กระดิ่ง และดาว ทั้งหมดเป็นเส้นบางขนาดและน้ำหนักเท่ากัน คนที่เปิดแอปครั้งแรกไม่รู้ว่าแท็บไหนเป็นอะไร และจำโครงสร้างได้หลังแตะแต่ละอันเท่านั้น เหนือหน้าจอที่มีรูปถ่ายอยู่ด้านหลัง เส้นขอบทั้งสี่ยิ่งดูคล้ายกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn biểu tượng nằm cạnh nhau trong thanh tab mà không có chữ: bong bóng thoại, trái tim, cái chuông và ngôi sao. Tất cả đều là nét viền mảnh cùng cỡ và độ đậm. Người mở app lần đầu không biết tab nào là tab nào, và chỉ ghi nhớ cấu trúc sau khi chạm từng cái. Trên màn hình có ảnh phía sau, bốn nét viền càng trông giống nhau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtyři ikony sedí vedle sebe v panelu karet bez textu: bublina řeči, srdce, zvonek a hvězda. Všechny jsou tenké obrysy stejné velikosti a tloušťky. Kdo otevírá aplikaci poprvé, neví, která karta je která, a strukturu si zapamatuje až po klepnutí na každou. Nad obrazovkou s fotkami vzadu vypadají čtyři obrysy ještě podobněji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire ikoner sidder side om side i fanelinjen uden tekst: en taleboble, et hjerte, en klokke og en stjerne. Alle er tynde omrids af samme størrelse og vægt. Den, der åbner appen for første gang, ved ikke, hvilken fane der er hvilken, og husker først strukturen efter at have trykket på hver enkelt. Over en skærm med fotos bagved ligner de fire omrids hinanden endnu mere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τέσσερα εικονίδια κάθονται δίπλα-δίπλα στη γραμμή καρτελών χωρίς κείμενο: ένα συννεφάκι ομιλίας, μια καρδιά, ένα κουδούνι και ένα αστέρι. Όλα είναι λεπτά περιγράμματα ίδιου μεγέθους και βάρους. Κάποιος που ανοίγει την εφαρμογή για πρώτη φορά δεν ξέρει ποια καρτέλα είναι ποια, και απομνημονεύει τη δομή μόνο αφού πατήσει την καθεμία. Πάνω από οθόνη με φωτογραφίες πίσω, τα τέσσερα περιγράμματα μοιάζουν ακόμα περισσότερο."
          }
        }
      }
    },
    "탭바의 3~5칸은 **대등한 정보 구조의 목적지**가 서는 자리다. \"더보기\"는 목적지가 아니라 목적지를 정하지 못한 기능들의 대기실이다. 이름이 내용을 말하지 않으니 사용자는 찾는 것이 거기 있는지 들어가 봐야 알고, 한 번 들어간 뒤에도 성격이 다른 항목들 사이를 뒤져야 한다.\n\n근거 항목의 표현대로, 4~5번째 탭이 \"기타\"가 되고 있다면 **정보 구조를 다시 그리라는 신호**다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The three to five slots in a tab bar are where **destinations of equal standing in the information architecture** belong. \"More\" isn't a destination; it's a waiting room for features that never got one. Its name doesn't say what's inside, so users have to go in to learn whether what they're looking for is there, and once inside they still have to dig through items of different kinds.\n\nAs the source topic puts it, if your fourth or fifth tab is turning into \"Other,\" that's **a signal to redraw your information architecture.**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The three to five slots in a tab bar are where **destinations of equal standing in the information architecture** belong. \"More\" isn't a destination; it's a waiting room for features that never got one. Its name doesn't say what's inside, so users have to go in to learn whether what they're looking for is there, and once inside they still have to dig through items of different kinds.\n\nAs the source topic puts it, if your fourth or fifth tab is turning into \"Other,\" that's **a signal to redraw your information architecture.**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーの3〜5枠は、**情報設計上対等な目的地**が立つ場所だ。「その他」は目的地ではなく、目的地を決められなかった機能の待合室だ。名前が中身を語らないので、ユーザーは探しているものがそこにあるかどうか入ってみないとわからず、一度入ったあとも性格の違う項目の間を探し回らなければならない。\n\n根拠のトピックの言葉どおり、4〜5番目のタブが「その他」になりつつあるなら、それは**情報設計を描き直せというシグナル**だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏的 3 到 5 格是**平级的信息结构目的地**站的位置。“更多”不是目的地，而是没定好目的地的功能的候车室。名字没说内容，用户得进去才知道要找的东西在不在，进去之后还得在性质各异的项目里翻找。\n\n如依据条目所说，第 4、5 个标签变成“其他”，就是**该重画信息结构的信号**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列的 3 到 5 格是**平級的資訊結構目的地**站的位置。「更多」不是目的地，而是沒定好目的地的功能的候車室。名字沒說內容，使用者得進去才知道要找的東西在不在，進去之後還得在性質各異的項目裡翻找。\n\n如依據條目所說，第 4、5 個標籤變成「其他」，就是**該重畫資訊結構的訊號**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три-пять слотов панели вкладок - место для **пунктов назначения равного статуса в информационной архитектуре**. «Ещё» - не пункт назначения, а комната ожидания для функций, которым места не нашлось. Её название не говорит, что внутри, поэтому пользователям приходится заходить, чтобы узнать, есть ли там искомое, а зайдя, всё равно копаться в пунктах разного рода.\n\nКак сказано в исходной теме, если ваша четвёртая или пятая вкладка превращается в «Прочее», это **сигнал перерисовать информационную архитектуру.**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tres a cinco huecos de una barra de pestañas son el sitio de **los destinos de igual rango en la arquitectura de la información**. «Más» no es un destino; es una sala de espera para funciones que nunca tuvieron uno. Su nombre no dice qué hay dentro, así que los usuarios tienen que entrar para saber si lo que buscan está ahí, y una vez dentro todavía tienen que rebuscar entre elementos de distinto tipo.\n\nComo dice el tema fuente, si tu cuarta o quinta pestaña se está convirtiendo en «Otros», eso es **una señal para redibujar tu arquitectura de la información.**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die drei bis fünf Plätze einer Tab-Leiste sind der Ort für **Ziele gleichen Ranges in der Informationsarchitektur**. „Mehr“ ist kein Ziel; es ist ein Wartezimmer für Funktionen, die nie eines bekamen. Sein Name sagt nicht, was darin ist, sodass Nutzer hineingehen müssen, um zu erfahren, ob das Gesuchte dort ist, und drinnen müssen sie sich weiter durch Elemente verschiedener Art wühlen.\n\nWie das Quellthema sagt: Wird dein vierter oder fünfter Tab zu „Sonstiges“, ist das **ein Signal, deine Informationsarchitektur neu zu zeichnen.**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trois à cinq emplacements d'une barre d'onglets sont l'endroit des **destinations de même rang dans l'architecture de l'information**. « Plus » n'est pas une destination ; c'est une salle d'attente pour les fonctions qui n'en ont jamais obtenu une. Son nom ne dit pas ce qu'il y a dedans, donc les utilisateurs doivent y entrer pour savoir si ce qu'ils cherchent y est, et une fois dedans ils doivent encore fouiller parmi des éléments de natures différentes.\n\nComme le dit le sujet source, si votre quatrième ou cinquième onglet devient « Autre », c'est **le signe qu'il faut redessiner votre architecture de l'information.**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tre-cinque slot di una barra delle schede sono il posto per **destinazioni di pari rango nell'architettura dell'informazione**. «Altro» non è una destinazione; è una sala d'attesa per le funzioni che non ne hanno mai avuta una. Il suo nome non dice cosa c'è dentro, quindi gli utenti devono entrare per sapere se ciò che cercano è lì, e una volta dentro devono comunque scavare tra voci di tipi diversi.\n\nCome dice l'argomento di origine, se la tua quarta o quinta scheda sta diventando «Altro», è **un segnale che devi ridisegnare l'architettura dell'informazione.**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os três a cinco lugares de uma barra de abas são onde pertencem **destinos de mesma categoria na arquitetura da informação**. «Mais» não é um destino; é uma sala de espera de funcionalidades que nunca ganharam um. O nome não diz o que há dentro, então os usuários precisam entrar para saber se o que procuram está lá, e uma vez dentro ainda precisam fuçar em itens de tipos diferentes.\n\nComo diz o tópico de origem, se sua quarta ou quinta aba está virando «Outros», isso é **um sinal para redesenhar a sua arquitetura da informação.**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามถึงห้าช่องในแถบแท็บคือที่ของ**จุดหมายปลายทางที่มีฐานะเท่ากันในสถาปัตยกรรมข้อมูล** \"เพิ่มเติม\" ไม่ใช่จุดหมายปลายทาง แต่เป็นห้องรอสำหรับฟีเจอร์ที่ไม่เคยได้บ้าน ชื่อไม่บอกว่าข้างในมีอะไร ผู้ใช้จึงต้องเข้าไปเพื่อรู้ว่าสิ่งที่หาอยู่ที่นั่นไหม และเมื่อเข้าไปแล้วยังต้องขุดผ่านรายการต่างชนิด\n\nตามที่หัวข้อต้นทางว่า ถ้าแท็บที่สี่หรือห้าของคุณกลายเป็น \"อื่น ๆ\" นั่นคือ**สัญญาณให้วาดสถาปัตยกรรมข้อมูลใหม่**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba đến năm ô của thanh tab là nơi dành cho **các điểm đến ngang hàng trong kiến trúc thông tin**. \"Thêm\" không phải điểm đến; nó là phòng chờ cho các tính năng chưa có chỗ. Tên của nó không nói bên trong có gì, nên người dùng phải vào mới biết thứ mình tìm có ở đó không, và khi vào rồi vẫn phải lục qua các mục khác loại.\n\nNhư chủ đề nguồn nói, nếu tab thứ tư hay thứ năm của bạn đang thành \"Khác\", đó là **tín hiệu để vẽ lại kiến trúc thông tin.**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tři až pět slotů panelu karet je místo, kam patří **cíle rovnocenného postavení v informační architektuře**. „Více“ není cíl; je to čekárna pro funkce, které žádný nezískaly. Jeho název neříká, co je uvnitř, takže uživatelé musejí vstoupit, aby zjistili, zda tam je to, co hledají, a uvnitř se stejně musejí probírat položkami různých druhů.\n\nJak říká zdrojové téma, pokud se vaše čtvrtá nebo pátá karta mění na „Ostatní“, je to **signál, že máte překreslit informační architekturu.**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De tre til fem pladser i en fanelinje er der, hvor **destinationer af lige rang i informationsarkitekturen** hører hjemme. »Mere« er ikke en destination; det er et venteværelse for funktioner, der aldrig fik en. Dens navn siger ikke, hvad der er indeni, så brugerne må gå ind for at få at vide, om det, de leder efter, er der, og når de er inde, må de stadig grave gennem elementer af forskellig art.\n\nSom kildeemnet siger det: hvis din fjerde eller femte fane er ved at blive til »Andet«, er det **et signal om at tegne din informationsarkitektur om.**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τρεις έως πέντε θέσεις σε μια γραμμή καρτελών είναι εκεί που ανήκουν **προορισμοί ισότιμοι στην αρχιτεκτονική πληροφορίας**. Το «Περισσότερα» δεν είναι προορισμός· είναι αίθουσα αναμονής για λειτουργίες που δεν βρήκαν ποτέ δικό τους. Το όνομά του δεν λέει τι έχει μέσα, οπότε οι χρήστες πρέπει να μπουν για να μάθουν αν είναι εκεί αυτό που ψάχνουν, και μόλις μπουν πρέπει ακόμα να σκαλίσουν στοιχεία διαφορετικού είδους.\n\nΌπως λέει το αρχικό θέμα, αν η τέταρτη ή πέμπτη καρτέλα σου γίνεται «Άλλα», αυτό είναι **σήμα ότι πρέπει να ξανασχεδιάσεις την αρχιτεκτονική πληροφορίας σου.**"
          }
        }
      }
    },
    "탭바의 마지막 칸이 \"더보기\"다. 누르면 공지, 이벤트, 쿠폰, 고객센터, 설정, 앱 정보가 한 목록에 섞여 있다. 사용자는 쿠폰을 찾을 때마다 여기 있을지 확신하지 못하고 들어가서 목록을 훑는다. 다른 탭 이름은 목적지를 말하는데, 이 탭 이름만 아무것도 말하지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last slot in the tab bar is \"More.\" Tap it and you'll find announcements, events, coupons, customer support, settings, and app info mixed together in one list. Every time users look for coupons, they aren't sure whether they'll be here, so they go in and scan the list. The other tab names say where they lead; only this one says nothing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The last slot in the tab bar is \"More.\" Tap it and you'll find announcements, events, coupons, customer support, settings, and app info mixed together in one list. Every time users look for coupons, they aren't sure whether they'll be here, so they go in and scan the list. The other tab names say where they lead; only this one says nothing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーの最後の枠が「その他」だ。押すと、お知らせ、イベント、クーポン、カスタマーサポート、設定、アプリ情報が1つのリストに混ざっている。ユーザーはクーポンを探すたびにここにあるのか確信が持てず、入ってリストに目を通す。ほかのタブ名は行き先を語っているのに、このタブ名だけは何も語らない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏的最后一格是“更多”。点开，公告、活动、优惠券、客服、设置、应用信息混在一个列表里。每次找优惠券，用户都不确定是不是在这里，进去翻一遍列表。其他标签名都在说目的地，只有这个标签名什么也没说。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列的最後一格是「更多」。點開，公告、活動、優惠券、客服、設定、應用程式資訊混在一個列表裡。每次找優惠券，使用者都不確定是不是在這裡，進去翻一遍列表。其他標籤名都在說目的地，只有這個標籤名什麼也沒說。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний слот панели вкладок - «Ещё». Нажмите, и в одном списке перемешаны объявления, события, купоны, поддержка, настройки и сведения о приложении. Каждый раз, когда пользователи ищут купоны, они не уверены, что те здесь, поэтому заходят и просматривают список. Остальные названия вкладок говорят, куда они ведут; только это не говорит ничего."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último hueco de la barra de pestañas es «Más». Tócalo y encontrarás anuncios, eventos, cupones, atención al cliente, ajustes e información de la app mezclados en una sola lista. Cada vez que los usuarios buscan cupones, no están seguros de si estarán aquí, así que entran y recorren la lista. Los demás nombres de pestañas dicen adónde llevan; solo este no dice nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Platz der Tab-Leiste ist „Mehr“. Tippt man darauf, findet man Ankündigungen, Veranstaltungen, Gutscheine, Kundendienst, Einstellungen und App-Infos in einer Liste durcheinander. Jedes Mal, wenn Nutzer Gutscheine suchen, sind sie nicht sicher, ob sie hier sind, und gehen hinein, um die Liste zu überfliegen. Die anderen Tab-Namen sagen, wohin sie führen; nur dieser sagt nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier emplacement de la barre d'onglets est « Plus ». Touchez-le et vous trouverez annonces, événements, coupons, service client, réglages et infos de l'app mêlés dans une même liste. Chaque fois que les utilisateurs cherchent des coupons, ils ne sont pas sûrs qu'ils seront ici, donc ils entrent et parcourent la liste. Les autres noms d'onglets disent où ils mènent ; seul celui-ci ne dit rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultimo slot della barra delle schede è «Altro». Toccalo e trovi annunci, eventi, coupon, assistenza clienti, impostazioni e info sull'app mescolati in un unico elenco. Ogni volta che gli utenti cercano i coupon, non sono sicuri che siano qui, quindi entrano e scorrono l'elenco. Gli altri nomi di scheda dicono dove portano; solo questo non dice nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O último lugar da barra de abas é «Mais». Toque e você encontra avisos, eventos, cupons, atendimento ao cliente, ajustes e informações do app misturados numa só lista. Toda vez que os usuários procuram cupons, não têm certeza de que estarão aqui, então entram e percorrem a lista. Os outros nomes de aba dizem aonde levam; só este não diz nada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่องสุดท้ายในแถบแท็บคือ \"เพิ่มเติม\" แตะแล้วคุณพบประกาศ กิจกรรม คูปอง ฝ่ายบริการลูกค้า การตั้งค่า และข้อมูลแอปปนกันในรายการเดียว ทุกครั้งที่ผู้ใช้หาคูปอง พวกเขาไม่แน่ใจว่ามันอยู่ที่นี่ไหม จึงเข้าไปไล่ดูรายการ ชื่อแท็บอื่นบอกว่าพาไปที่ไหน มีแต่อันนี้ที่ไม่บอกอะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ô cuối của thanh tab là \"Thêm.\" Chạm vào và bạn thấy thông báo, sự kiện, mã giảm giá, hỗ trợ khách hàng, cài đặt và thông tin app trộn trong một danh sách. Mỗi lần người dùng tìm mã giảm giá, họ không chắc nó có ở đây không, nên vào rồi lướt danh sách. Các tab khác có tên nói chúng dẫn đến đâu; riêng cái này không nói gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední slot panelu karet je „Více“. Klepněte a najdete oznámení, události, kupóny, zákaznickou podporu, nastavení a informace o aplikaci smíchané v jednom seznamu. Pokaždé, když uživatelé hledají kupóny, nejsou si jisti, zda tu budou, takže vstoupí a prohlížejí seznam. Ostatní názvy karet říkají, kam vedou; jen tento neříká nic."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sidste plads i fanelinjen er »Mere.« Tryk på den, og du finder meddelelser, begivenheder, kuponer, kundesupport, indstillinger og appinformation blandet sammen i én liste. Hver gang brugerne leder efter kuponer, er de ikke sikre på, om de er her, så de går ind og skimmer listen. De andre fanenavne siger, hvor de fører hen; kun dette siger ingenting."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τελευταία θέση της γραμμής καρτελών είναι το «Περισσότερα». Πάτα το και θα βρεις ανακοινώσεις, εκδηλώσεις, κουπόνια, υποστήριξη πελατών, ρυθμίσεις και πληροφορίες εφαρμογής ανακατεμένα σε μία λίστα. Κάθε φορά που οι χρήστες ψάχνουν κουπόνια, δεν είναι σίγουροι ότι θα είναι εδώ, οπότε μπαίνουν και σαρώνουν τη λίστα. Τα ονόματα των άλλων καρτελών λένε πού οδηγούν· μόνο αυτό δεν λέει τίποτα."
          }
        }
      }
    },
    "탭바의 한 칸에 추상적인 물결 모양 아이콘이 있고, 아래에 \"무드\"라는 라벨이 붙어 있다. 아이콘도 처음 보고 단어도 처음 본다. 눌러 보기 전에는 무엇이 나올지 알 수 없다. 옆 탭들은 홈과 검색이라 이 칸만 수수께끼로 남는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One slot in the tab bar has an abstract wavy icon with the label \"Mood\" underneath. The icon is unfamiliar, and so is the word. You can't tell what will appear until you tap it. The neighboring tabs are Home and Search, so this slot alone remains a riddle."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "One slot in the tab bar has an abstract wavy icon with the label \"Mood\" underneath. The icon is unfamiliar, and so is the word. You can't tell what will appear until you tap it. The neighbouring tabs are Home and Search, so this slot alone remains a riddle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーの1枠に抽象的な波形のアイコンがあり、その下に「ムード」というラベルが付いている。アイコンも初めて見るし、言葉も初めて見る。押してみるまで何が出てくるかわからない。隣のタブはホームと検索なので、この枠だけが謎のまま残る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签栏的一格里有一个抽象的波浪形图标，下面附着“心情”这个标签。图标是第一次见，词也是第一次见。不点开，不知道会出现什么。旁边的标签是首页和搜索，只有这一格成了谜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤列的一格里有一個抽象的波浪形圖示，下面附著「心情」這個標籤。圖示是第一次見，詞也是第一次見。不點開，不知道會出現什麼。旁邊的標籤是首頁和搜尋，只有這一格成了謎。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В одном слоте панели вкладок абстрактный волнистый значок с подписью «Настроение» под ним. Значок незнаком, и слово тоже. Пока не нажмёшь, не поймёшь, что появится. Соседние вкладки - «Главная» и «Поиск», поэтому только этот слот остаётся загадкой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hueco de la barra de pestañas tiene un icono abstracto ondulado con la etiqueta «Ánimo» debajo. El icono no es familiar, y la palabra tampoco. No puedes saber qué aparecerá hasta tocarlo. Las pestañas vecinas son Inicio y Buscar, así que solo este hueco sigue siendo un acertijo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Platz in der Tab-Leiste hat ein abstraktes Wellensymbol mit der Beschriftung „Stimmung“ darunter. Das Symbol ist unvertraut, und das Wort auch. Man kann nicht erkennen, was erscheint, bevor man tippt. Die Nachbar-Tabs sind Start und Suche, sodass dieser eine Platz allein ein Rätsel bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un emplacement de la barre d'onglets a une icône ondulée abstraite avec le libellé « Humeur » dessous. L'icône n'est pas familière, ni le mot. On ne peut pas savoir ce qui va apparaître avant de toucher. Les onglets voisins sont Accueil et Recherche, donc cet emplacement reste seul une énigme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno slot della barra delle schede ha un'icona astratta a onda con l'etichetta «Umore» sotto. L'icona non è familiare, e nemmeno la parola. Non puoi capire cosa comparirà finché non la tocchi. Le schede vicine sono Home e Cerca, quindi solo questo slot resta un indovinello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lugar da barra de abas tem um ícone abstrato ondulado com o rótulo «Humor» embaixo. O ícone é desconhecido, e a palavra também. Não dá para saber o que vai aparecer até tocar. As abas vizinhas são Início e Buscar, então só este lugar continua sendo um enigma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่องหนึ่งในแถบแท็บมีไอคอนคลื่นนามธรรมพร้อมป้าย \"อารมณ์\" ด้านล่าง ไอคอนไม่คุ้น คำก็ไม่คุ้น คุณบอกไม่ได้ว่าอะไรจะปรากฏจนกว่าจะแตะ แท็บข้างเคียงคือหน้าแรกและค้นหา ช่องนี้ช่องเดียวจึงยังเป็นปริศนา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ô trong thanh tab có biểu tượng lượn sóng trừu tượng với nhãn \"Tâm trạng\" bên dưới. Biểu tượng lạ, và từ cũng lạ. Bạn không biết sẽ hiện gì cho đến khi chạm. Các tab bên cạnh là Trang chủ và Tìm kiếm, nên riêng ô này vẫn là một câu đố."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden slot panelu karet má abstraktní vlnitou ikonu s popiskem „Nálada“ pod ní. Ikona je nezvyklá a slovo také. Nepoznáte, co se objeví, dokud neklepnete. Sousední karty jsou Domů a Hledat, takže tento slot zůstává hádankou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En plads i fanelinjen har et abstrakt bølget ikon med etiketten »Humør« under. Ikonet er uvant, og det samme er ordet. Du kan ikke se, hvad der dukker op, før du trykker. Nabofanerne er Hjem og Søg, så kun denne plads forbliver en gåde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια θέση της γραμμής καρτελών έχει ένα αφηρημένο κυματιστό εικονίδιο με ετικέτα «Διάθεση» από κάτω. Το εικονίδιο είναι ανοίκειο, και η λέξη επίσης. Δεν μπορείς να καταλάβεις τι θα εμφανιστεί μέχρι να το πατήσεις. Οι γειτονικές καρτέλες είναι Αρχική και Αναζήτηση, οπότε μόνο αυτή η θέση μένει αίνιγμα."
          }
        }
      }
    },
    "탭은 **목적지**다. 탭바는 \"이 앱은 이런 세계들로 이루어져 있다\"는 지도라서, 사용자는 탭 이름을 앱의 구조로 읽는다. 목적지가 아닌 광고를 그 칸에 넣으면 지도에 없는 곳을 그려 넣은 셈이다. 사용자가 그걸 알아채는 순간, 나머지 탭도 진짜 구조인지 한 번 더 의심하게 된다. 잃는 것은 탭 하나가 아니라 **탭바 전체에 대한 신뢰**다.\n\n칸도 줄어든다. 3~5칸 안에서 하나를 광고에 쓰면 진짜 목적지가 쓸 자리가 좁아진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab is **a destination**. The tab bar is a map that says \"this app is made up of these worlds,\" so users read tab names as the app's structure. Putting an ad, which isn't a destination, into one of those slots is like drawing a place on the map that doesn't exist. The moment users notice, they start to wonder whether the other tabs are real structure too. What you lose is not one tab but **trust in the entire tab bar**.\n\nYou also lose a slot. Spend one of the three to five slots on an ad, and the real destinations have less room."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab is **a destination**. The tab bar is a map that says \"this app is made up of these worlds,\" so users read tab names as the app's structure. Putting an ad, which isn't a destination, into one of those slots is like drawing a place on the map that doesn't exist. The moment users notice, they start to wonder whether the other tabs are real structure too. What you lose is not one tab but **trust in the entire tab bar**.\n\nYou also lose a slot. Spend one of the three to five slots on an ad, and the real destinations have less room."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブは**目的地**だ。タブバーは「このアプリはこういう世界でできている」という地図なので、ユーザーはタブの名前をアプリの構造として読む。目的地ではない広告をその枠に入れるのは、地図にない場所を書き込んだのと同じだ。ユーザーがそれに気づいた瞬間、ほかのタブも本当の構造なのかともう一度疑うようになる。失うのはタブ1つではなく、**タブバー全体への信頼**だ。\n\n枠も減る。3〜5枠のうち1つを広告に使えば、本当の目的地が使える場所が狭くなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是**目的地**。标签栏是“这个应用由这些世界组成”的地图，所以用户把标签名读作应用的结构。把不是目的地的广告放进那一格，等于在地图上画了不存在的地方。用户一旦发觉，对其余标签是不是真结构也会再起疑。失去的不是一个标签，而是**对整个标签栏的信任**。\n\n格子也在减少。3 到 5 格里拿一个做广告，真正的目的地可用的位置就窄了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤是**目的地**。標籤列是「這個應用程式由這些世界組成」的地圖，所以使用者把標籤名讀作應用程式的結構。把不是目的地的廣告放進那一格，等於在地圖上畫了不存在的地方。使用者一旦發覺，對其餘標籤是不是真結構也會再起疑。失去的不是一個標籤，而是**對整個標籤列的信任**。\n\n格子也在減少。3 到 5 格里拿一個做廣告，真正的目的地可用的位置就窄了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка - **пункт назначения**. Панель вкладок - карта, говорящая «это приложение состоит из этих миров», поэтому пользователи читают названия вкладок как структуру приложения. Поместить в один из слотов рекламу, не являющуюся пунктом назначения, всё равно что нарисовать на карте несуществующее место. Как только пользователи замечают, они начинают гадать, не нереальна ли и остальная структура вкладок. Вы теряете не одну вкладку, а **доверие ко всей панели вкладок**.\n\nВы также теряете слот. Потратьте один из трёх-пяти слотов на рекламу, и у настоящих пунктов назначения остаётся меньше места."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña es **un destino**. La barra de pestañas es un mapa que dice «esta app se compone de estos mundos», así que los usuarios leen los nombres de las pestañas como la estructura de la app. Poner un anuncio, que no es un destino, en uno de esos huecos es como dibujar en el mapa un lugar que no existe. En el momento en que los usuarios lo notan, empiezan a preguntarse si las demás pestañas son también estructura real. Lo que pierdes no es una pestaña sino **la confianza en toda la barra de pestañas**.\n\nTambién pierdes un hueco. Gasta uno de los tres a cinco huecos en un anuncio y los destinos reales tienen menos sitio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab ist **ein Ziel**. Die Tab-Leiste ist eine Karte, die sagt: „Diese App besteht aus diesen Welten“, sodass Nutzer Tab-Namen als Struktur der App lesen. Eine Anzeige, die kein Ziel ist, in einen dieser Plätze zu setzen, ist, als zeichne man einen Ort auf die Karte, den es nicht gibt. In dem Moment, in dem Nutzer es bemerken, fragen sie sich, ob auch die anderen Tabs echte Struktur sind. Was du verlierst, ist nicht ein Tab, sondern **das Vertrauen in die gesamte Tab-Leiste**.\n\nDu verlierst auch einen Platz. Gibst du einen der drei bis fünf Plätze für eine Anzeige her, haben die echten Ziele weniger Raum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet est **une destination**. La barre d'onglets est une carte qui dit « cette app est faite de ces mondes », donc les utilisateurs lisent les noms d'onglets comme la structure de l'app. Mettre dans l'un de ces emplacements une publicité, qui n'est pas une destination, revient à dessiner sur la carte un lieu qui n'existe pas. Dès que les utilisateurs s'en aperçoivent, ils se demandent si les autres onglets sont aussi de la vraie structure. Ce que vous perdez, ce n'est pas un onglet mais **la confiance dans toute la barre d'onglets**.\n\nVous perdez aussi un emplacement. Dépensez un des trois à cinq emplacements pour une publicité, et les vraies destinations ont moins de place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda è **una destinazione**. La barra delle schede è una mappa che dice «questa app è fatta di questi mondi», quindi gli utenti leggono i nomi delle schede come la struttura dell'app. Mettere in uno di quegli slot una pubblicità, che non è una destinazione, è come disegnare sulla mappa un luogo che non esiste. Nel momento in cui gli utenti se ne accorgono, cominciano a chiedersi se anche le altre schede siano struttura vera. Quello che perdi non è una scheda ma **la fiducia nell'intera barra delle schede**.\n\nPerdi anche uno slot. Spendi uno dei tre-cinque slot per una pubblicità e le vere destinazioni hanno meno spazio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma aba é **um destino**. A barra de abas é um mapa que diz «este app é feito destes mundos», então os usuários leem os nomes das abas como a estrutura do app. Pôr num desses lugares um anúncio, que não é um destino, é como desenhar no mapa um lugar que não existe. No instante em que os usuários percebem, começam a se perguntar se as outras abas também são estrutura de verdade. O que você perde não é uma aba, mas **a confiança em toda a barra de abas**.\n\nVocê perde também um lugar. Gaste um dos três a cinco lugares com um anúncio e os destinos reais ficam com menos espaço."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บคือ**จุดหมายปลายทาง** แถบแท็บคือแผนที่ที่บอกว่า \"แอปนี้ประกอบด้วยโลกเหล่านี้\" ผู้ใช้จึงอ่านชื่อแท็บเป็นโครงสร้างของแอป การใส่โฆษณา ซึ่งไม่ใช่จุดหมายปลายทาง ลงในช่องเหล่านั้นเหมือนวาดสถานที่ที่ไม่มีอยู่ลงบนแผนที่ ทันทีที่ผู้ใช้สังเกต พวกเขาเริ่มสงสัยว่าแท็บอื่นเป็นโครงสร้างจริงด้วยไหม สิ่งที่คุณเสียไม่ใช่หนึ่งแท็บ แต่คือ**ความไว้วางใจในแถบแท็บทั้งหมด**\n\nคุณยังเสียหนึ่งช่อง ใช้หนึ่งในสามถึงห้าช่องกับโฆษณา จุดหมายปลายทางจริงก็มีที่น้อยลง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tab là **một điểm đến**. Thanh tab là bản đồ nói \"app này gồm những thế giới này\", nên người dùng đọc tên tab như cấu trúc của app. Đặt một quảng cáo, thứ không phải điểm đến, vào một trong các ô đó cũng như vẽ lên bản đồ một nơi không tồn tại. Khoảnh khắc người dùng nhận ra, họ bắt đầu tự hỏi các tab khác có phải cấu trúc thật không. Thứ bạn mất không phải một tab mà là **niềm tin vào cả thanh tab**.\n\nBạn cũng mất một ô. Tiêu một trong ba đến năm ô cho quảng cáo thì các điểm đến thật còn ít chỗ hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta je **cíl**. Panel karet je mapa, která říká „tato aplikace se skládá z těchto světů“, takže uživatelé čtou názvy karet jako strukturu aplikace. Dát reklamu, která není cílem, do jednoho z těch slotů je jako nakreslit na mapu místo, které neexistuje. Ve chvíli, kdy si toho uživatelé všimnou, začnou se ptát, zda i ostatní karty jsou skutečná struktura. Co ztratíte, není jedna karta, ale **důvěra v celý panel karet**.\n\nZtratíte také slot. Utraťte jeden ze tří až pěti slotů za reklamu a skutečné cíle mají méně místa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En fane er **en destination**. Fanelinjen er et kort, der siger »denne app består af disse verdener«, så brugerne læser fanenavne som appens struktur. At lægge en reklame, der ikke er en destination, ind i en af de pladser er som at tegne et sted på kortet, der ikke findes. I det øjeblik brugerne bemærker det, begynder de at undre sig over, om de andre faner også er rigtig struktur. Det, du mister, er ikke én fane men **tilliden til hele fanelinjen**.\n\nDu mister også en plads. Brug en af de tre til fem pladser på en reklame, og de rigtige destinationer har mindre plads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια καρτέλα είναι **ένας προορισμός**. Η γραμμή καρτελών είναι ένας χάρτης που λέει «αυτή η εφαρμογή αποτελείται από αυτούς τους κόσμους», οπότε οι χρήστες διαβάζουν τα ονόματα των καρτελών ως δομή της εφαρμογής. Το να βάλεις μια διαφήμιση, που δεν είναι προορισμός, σε μία από αυτές τις θέσεις είναι σαν να σχεδιάζεις στον χάρτη ένα μέρος που δεν υπάρχει. Τη στιγμή που οι χρήστες το προσέξουν, αρχίζουν να αναρωτιούνται αν είναι πραγματική δομή και οι άλλες καρτέλες. Αυτό που χάνεις δεν είναι μία καρτέλα αλλά **η εμπιστοσύνη σε ολόκληρη τη γραμμή καρτελών**.\n\nΧάνεις και μια θέση. Ξόδεψε μία από τις τρεις έως πέντε θέσεις σε διαφήμιση και οι πραγματικοί προορισμοί έχουν λιγότερο χώρο."
          }
        }
      }
    },
    "탭은 **상시 점유**다. 탭바의 한 칸은 사용자가 어느 화면에 있든 \"여기가 이 앱의 주요 목적지\"라고 말한다. 쓰는 빈도가 크게 기운 기능을 그 자리에 두면 탭바가 말하는 구조와 실제 쓰임이 어긋난다. 주 기능의 칸은 좁아지고, 부기능은 필요 없는 순간에도 계속 자리를 차지한다.\n\n검색도 같은 함정이 있다. 목록을 좁히는 필터형 검색은 탭이 아니라 화면 안의 `.searchable` 이 맞는 구조다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab **occupies space permanently.** No matter which screen the user is on, a slot in the tab bar says \"this is one of this app's main destinations.\" Put a feature with heavily skewed usage there, and the structure the tab bar communicates no longer matches how the app is actually used. The main feature's slot gets narrower, and the secondary feature keeps occupying space even when it isn't needed.\n\nSearch falls into the same trap. Filter-style search that narrows a list belongs in `.searchable` inside the screen, not in a tab."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab **occupies space permanently.** No matter which screen the user is on, a slot in the tab bar says \"this is one of this app's main destinations.\" Put a feature with heavily skewed usage there, and the structure the tab bar communicates no longer matches how the app is actually used. The main feature's slot gets narrower, and the secondary feature keeps occupying space even when it isn't needed.\n\nSearch falls into the same trap. Filter-style search that narrows a list belongs in `.searchable` inside the screen, not in a tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブは**常に場所を占める。** タブバーの1枠は、ユーザーがどの画面にいても「ここがこのアプリの主な目的地だ」と語る。使用頻度が大きく偏った機能をその場所に置くと、タブバーが語る構造と実際の使われ方が食い違う。主な機能の枠は狭くなり、副次的な機能は必要ない瞬間にも場所を占め続ける。\n\n検索にも同じ落とし穴がある。リストを絞り込むフィルタ型の検索は、タブではなく画面内の `.searchable` が合う構造だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是**常驻占用**。标签栏的一格，无论用户在哪个界面，都在说“这里是这个应用的主要目的地”。把使用频率严重偏斜的功能放在那里，标签栏所说的结构与实际用法就错位了。主要功能的格子变窄，副功能在不需要的时候也持续占位。\n\n搜索也有同样的陷阱。缩小列表的筛选型搜索不是标签，而应该是界面内的 `.searchable`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤是**常駐佔用**。標籤列的一格，無論使用者在哪個介面，都在說「這裡是這個應用程式的主要目的地」。把使用頻率嚴重偏斜的功能放在那裡，標籤列所說的結構與實際用法就錯位了。主要功能的格子變窄，副功能在不需要的時候也持續佔位。\n\n搜尋也有同樣的陷阱。縮小列表的篩選型搜尋不是標籤，而應該是介面內的 `.searchable`。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка **занимает место постоянно.** На каком бы экране ни был пользователь, слот в панели вкладок говорит «это один из главных пунктов назначения приложения». Поместите туда функцию с сильно скошенным использованием, и структура, которую передаёт панель вкладок, перестанет соответствовать реальному использованию приложения. Слот основной функции сужается, а второстепенная продолжает занимать место, даже когда не нужна.\n\nПоиск попадает в ту же ловушку. Поиск-фильтр, сужающий список, принадлежит `.searchable` внутри экрана, а не вкладке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña **ocupa espacio de forma permanente.** Sea cual sea la pantalla en que esté el usuario, un hueco de la barra de pestañas dice «este es uno de los destinos principales de esta app». Pon ahí una función con un uso muy sesgado y la estructura que comunica la barra de pestañas deja de coincidir con cómo se usa realmente la app. El hueco de la función principal se estrecha, y la función secundaria sigue ocupando espacio aunque no haga falta.\n\nLa búsqueda cae en la misma trampa. La búsqueda tipo filtro que reduce una lista pertenece a `.searchable` dentro de la pantalla, no a una pestaña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab **belegt dauerhaft Platz.** Auf welchem Bildschirm der Nutzer auch ist, ein Platz in der Tab-Leiste sagt: „Dies ist eines der Hauptziele dieser App.“ Setzt man dort eine Funktion mit stark schiefer Nutzung hin, passt die von der Tab-Leiste vermittelte Struktur nicht mehr dazu, wie die App tatsächlich genutzt wird. Der Platz der Hauptfunktion wird schmaler, und die Nebenfunktion belegt weiter Platz, auch wenn sie nicht gebraucht wird.\n\nDie Suche tappt in dieselbe Falle. Eine Filtersuche, die eine Liste eingrenzt, gehört in `.searchable` innerhalb des Bildschirms, nicht in einen Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet **occupe l'espace en permanence.** Quel que soit l'écran où se trouve l'utilisateur, un emplacement de la barre d'onglets dit « c'est l'une des destinations principales de cette app ». Mettez-y une fonction à l'usage fortement déséquilibré, et la structure que communique la barre d'onglets ne correspond plus à la façon dont l'app est réellement utilisée. L'emplacement de la fonction principale se rétrécit, et la fonction secondaire continue d'occuper de la place même quand elle n'est pas nécessaire.\n\nLa recherche tombe dans le même piège. Une recherche de type filtre qui réduit une liste a sa place dans `.searchable` à l'intérieur de l'écran, pas dans un onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda **occupa spazio in permanenza.** Qualunque schermata stia usando l'utente, uno slot della barra delle schede dice «questa è una delle destinazioni principali di questa app». Mettici una funzione con un uso molto sbilanciato e la struttura che la barra delle schede comunica non corrisponde più a come l'app è realmente usata. Lo slot della funzione principale si restringe, e la funzione secondaria continua a occupare spazio anche quando non serve.\n\nLa ricerca cade nella stessa trappola. La ricerca a filtro che restringe un elenco appartiene a `.searchable` dentro la schermata, non a una scheda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma aba **ocupa espaço permanentemente.** Qualquer que seja a tela em que o usuário esteja, um lugar da barra de abas diz «este é um dos principais destinos deste app». Ponha ali uma funcionalidade de uso muito inclinado e a estrutura que a barra de abas comunica deixa de corresponder a como o app é realmente usado. O lugar da funcionalidade principal se estreita, e a funcionalidade secundária continua ocupando espaço mesmo quando não é necessária.\n\nA busca cai na mesma armadilha. A busca em estilo de filtro que estreita uma lista pertence a `.searchable` dentro da tela, não a uma aba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บ**กินพื้นที่ถาวร** ไม่ว่าผู้ใช้อยู่หน้าจอไหน ช่องในแถบแท็บบอกว่า \"นี่คือจุดหมายหลักหนึ่งของแอปนี้\" วางฟีเจอร์ที่การใช้เอนเอียงมากตรงนั้น โครงสร้างที่แถบแท็บสื่อก็ไม่ตรงกับวิธีที่ใช้แอปจริง ช่องของฟีเจอร์หลักแคบลง และฟีเจอร์รองยังกินพื้นที่แม้ไม่ต้องการ\n\nการค้นหาตกกับดักเดียวกัน การค้นหาแบบตัวกรองที่ทำให้รายการแคบลงเป็นของ `.searchable` ภายในหน้าจอ ไม่ใช่แท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tab **chiếm chỗ vĩnh viễn.** Dù người dùng ở màn hình nào, một ô trong thanh tab nói \"đây là một trong các điểm đến chính của app này.\" Đặt vào đó một tính năng có mức dùng lệch nặng thì cấu trúc thanh tab truyền đạt không còn khớp với cách app thực sự được dùng. Ô của tính năng chính hẹp lại, còn tính năng phụ cứ chiếm chỗ ngay cả khi không cần.\n\nTìm kiếm rơi vào cùng cái bẫy. Tìm kiếm kiểu lọc thu hẹp danh sách thuộc về `.searchable` bên trong màn hình, không phải một tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta **trvale zabírá místo.** Bez ohledu na to, na které obrazovce uživatel je, slot v panelu karet říká „toto je jeden z hlavních cílů této aplikace“. Dejte tam funkci s silně nakloněným využitím a struktura, kterou panel karet sděluje, už neodpovídá tomu, jak se aplikace skutečně používá. Slot hlavní funkce se zužuje a vedlejší funkce dál zabírá místo i tehdy, když není potřeba.\n\nHledání spadá do stejné pasti. Hledání typu filtr, které zužuje seznam, patří do `.searchable` uvnitř obrazovky, ne do karty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En fane **optager plads permanent.** Uanset hvilken skærm brugeren er på, siger en plads i fanelinjen »dette er en af denne apps hoveddestinationer.« Læg en funktion med kraftigt skæv brug der, og den struktur, fanelinjen kommunikerer, passer ikke længere til, hvordan appen faktisk bruges. Hovedfunktionens plads bliver smallere, og den sekundære funktion bliver ved med at optage plads, selv når der ikke er brug for den.\n\nSøgning falder i den samme fælde. Filtersøgning, der indsnævrer en liste, hører hjemme i `.searchable` inde i skærmen, ikke i en fane."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια καρτέλα **καταλαμβάνει χώρο μόνιμα.** Όποια οθόνη κι αν βλέπει ο χρήστης, μια θέση στη γραμμή καρτελών λέει «αυτός είναι ένας από τους κύριους προορισμούς της εφαρμογής». Βάλε εκεί μια λειτουργία με έντονα ανισομερή χρήση και η δομή που μεταδίδει η γραμμή καρτελών δεν ταιριάζει πια με το πώς χρησιμοποιείται πραγματικά η εφαρμογή. Η θέση της κύριας λειτουργίας στενεύει, και η δευτερεύουσα λειτουργία συνεχίζει να πιάνει χώρο ακόμα κι όταν δεν χρειάζεται.\n\nΗ αναζήτηση πέφτει στην ίδια παγίδα. Η αναζήτηση τύπου φίλτρου που περιορίζει μια λίστα ανήκει στο `.searchable` μέσα στην οθόνη, όχι σε καρτέλα."
          }
        }
      }
    },
    "탭은 “장소 이동”이지만 검색은 **“모드 진입”**, 성격이 다른 것을 시각적으로도 분리(별도 캡슐)해 OS 전체에서 일관되게 표현한 것. 탭하면 캡슐이 그 자리에서 검색 필드로 변형되어, 화면 이동 없이 모드가 전환됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab means \"going to a place,\" but search means **\"entering a mode.\"** Something different in nature is also separated visually (its own capsule), expressed consistently across the OS. Tap it and the capsule morphs in place into a search field, switching modes without leaving the screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab means \"going to a place,\" but search means **\"entering a mode.\"** Something different in nature is also separated visually (its own capsule), expressed consistently across the OS. Tap it and the capsule morphs in place into a search field, switching modes without leaving the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブは「場所の移動」だが、検索は「**モードに入ること」**。性格の違うものを見た目でも切り離し（別のカプセル）、OS全体で一貫して表現したもの。タップするとカプセルがその場で検索フィールドに変形し、画面を移動せずにモードが切り替わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是“切换地点”，搜索是**“进入模式”**。把性质不同的东西在视觉上也分开（单独的胶囊），在整个 OS 里一致地表现。点按后，胶囊就地变形为搜索框，不换界面就切换了模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤是「切換地點」，搜尋是**「進入模式」**。把性質不同的東西在視覺上也分開（單獨的膠囊），在整個 OS 裡一致地表現。輕點後，膠囊就地變形為搜尋框，不換介面就切換了模式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка значит «перейти в место», а поиск - это **«войти в режим»**. То, что иное по природе, ещё и разделено визуально (своя капсула) и выражено одинаково по всей ОС. Нажмите, и капсула прямо на месте превращается в поле поиска, переключая режим без ухода с экрана."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña significa «ir a un lugar», pero la búsqueda significa **«entrar en un modo».** Algo de naturaleza distinta también se separa visualmente (su propia cápsula), expresado de forma coherente en todo el sistema operativo. Tócala y la cápsula se transforma en su sitio en un campo de búsqueda, cambiando de modo sin salir de la pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab bedeutet „an einen Ort gehen“, aber Suche bedeutet **„einen Modus betreten“.** Auch etwas, das von Natur aus anders ist, wird optisch abgesetzt (eigene Kapsel), im ganzen OS einheitlich ausgedrückt. Beim Antippen verwandelt sich die Kapsel an Ort und Stelle in ein Suchfeld und wechselt den Modus, ohne den Bildschirm zu verlassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet signifie « aller à un lieu », mais la recherche signifie **« entrer dans un mode ».** Ce qui est de nature différente est aussi séparé visuellement (sa propre capsule), exprimé de façon cohérente dans tout le système. Touchez-la et la capsule se transforme sur place en champ de recherche, changeant de mode sans quitter l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda significa «andare in un posto», ma la ricerca significa **«entrare in una modalità».** Anche ciò che è di natura diversa viene separato visivamente (la sua capsula), espresso in modo coerente in tutto il sistema operativo. Toccala e la capsula si trasforma sul posto in un campo di ricerca, cambiando modalità senza lasciare la schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma aba significa «ir a um lugar», mas a busca significa **«entrar num modo».** O que é de natureza diferente também é separado visualmente (a própria cápsula), expresso de forma consistente em todo o sistema operacional. Toque e a cápsula se transforma no lugar num campo de busca, mudando de modo sem sair da tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บหมายถึง \"ไปยังสถานที่\" แต่การค้นหาหมายถึง**\"เข้าสู่โหมด\"** สิ่งที่ต่างลักษณะก็แยกด้วยภาพ (แคปซูลของตัวเอง) แสดงสม่ำเสมอทั้ง OS แตะแล้วแคปซูลแปรสภาพตรงที่เดิมเป็นช่องค้นหา เปลี่ยนโหมดโดยไม่ออกจากหน้าจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tab nghĩa là \"đi đến một nơi\", nhưng tìm kiếm nghĩa là **\"vào một chế độ.\"** Thứ khác bản chất cũng được tách về mặt thị giác (capsule riêng), biểu đạt nhất quán trên toàn hệ điều hành. Chạm vào và capsule biến hình tại chỗ thành ô tìm kiếm, đổi chế độ mà không rời màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta znamená „jít na místo“, ale hledání znamená **„vstoupit do režimu.“** Něco jiné povahy je také vizuálně odděleno (vlastní kapsle), vyjádřeno konzistentně v celém OS. Klepněte a kapsle se přímo na místě změní na vyhledávací pole, přepne režim, aniž byste opustili obrazovku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En fane betyder »at gå til et sted«, men søgning betyder **»at gå ind i en tilstand.«** Noget forskelligt af natur adskilles også visuelt (sin egen kapsel) og udtrykkes ensartet i hele OS. Tryk på den, og kapslen morpher på stedet til et søgefelt og skifter tilstand uden at forlade skærmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια καρτέλα σημαίνει «πηγαίνω σε ένα μέρος», αλλά η αναζήτηση σημαίνει **«μπαίνω σε μια λειτουργία».** Κάτι διαφορετικό στη φύση διαχωρίζεται και οπτικά (δική του κάψουλα), εκφραζόμενο με συνέπεια σε όλο το λειτουργικό. Πάτα την και η κάψουλα μεταμορφώνεται επιτόπου σε πεδίο αναζήτησης, αλλάζοντας λειτουργία χωρίς να φύγεις από την οθόνη."
          }
        }
      }
    },
    "탭은 목적지다. 목적지가 아닌 것을 탭으로 만들면 구조 전체를 못 믿게 된다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs are destinations. Turn something that isn't a destination into a tab, and the whole structure loses people's trust."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs are destinations. Turn something that isn't a destination into a tab, and the whole structure loses people's trust."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブは目的地だ。目的地でないものをタブにすると、構造全体が信頼されなくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是目的地。把不是目的地的东西做成标签，整个结构就不再被信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤是目的地。把不是目的地的東西做成標籤，整個結構就不再被信任。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки - пункты назначения. Сделайте вкладкой то, что не пункт назначения, и вся структура потеряет доверие людей."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas son destinos. Convierte en pestaña algo que no es un destino y toda la estructura pierde la confianza de la gente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs sind Ziele. Macht man aus etwas, das kein Ziel ist, einen Tab, verliert die ganze Struktur das Vertrauen der Menschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets sont des destinations. Faites un onglet de quelque chose qui n'est pas une destination, et toute la structure perd la confiance des gens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede sono destinazioni. Trasforma in scheda qualcosa che non è una destinazione e l'intera struttura perde la fiducia delle persone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abas são destinos. Transforme em aba algo que não é um destino e a estrutura inteira perde a confiança das pessoas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บคือจุดหมายปลายทาง เปลี่ยนสิ่งที่ไม่ใช่จุดหมายปลายทางเป็นแท็บ ทั้งโครงสร้างก็เสียความไว้วางใจ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab là điểm đến. Biến thứ không phải điểm đến thành tab, cả cấu trúc mất niềm tin của người ta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty jsou cíle. Udělejte z něčeho, co není cílem, kartu, a celá struktura ztratí důvěru lidí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faner er destinationer. Gør noget, der ikke er en destination, til en fane, og hele strukturen mister folks tillid."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καρτέλες είναι προορισμοί. Κάνε καρτέλα κάτι που δεν είναι προορισμός και ολόκληρη η δομή χάνει την εμπιστοσύνη των ανθρώπων."
          }
        }
      }
    },
    "탭은 목적지의 약속이다. 지키지 못할 약속이면 탭이 아닌 것으로 만든다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab is a promise of a destination. If you can't keep the promise, make it something other than a tab."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab is a promise of a destination. If you can't keep the promise, make it something other than a tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブは目的地の約束だ。守れない約束なら、タブ以外のものにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是目的地的约定。守不住的约定，就做成不是标签的东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤是目的地的約定。守不住的約定，就做成不是標籤的東西。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка - обещание пункта назначения. Если обещание не сдержать, сделайте это чем-то иным, чем вкладка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña es una promesa de destino. Si no puedes cumplir la promesa, haz de ello algo que no sea una pestaña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab ist ein Versprechen eines Ziels. Kannst du das Versprechen nicht halten, mache es zu etwas anderem als einem Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet est une promesse de destination. Si vous ne pouvez pas tenir la promesse, faites-en autre chose qu'un onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda è una promessa di destinazione. Se non puoi mantenere la promessa, fanne qualcosa di diverso da una scheda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma aba é uma promessa de destino. Se você não consegue cumprir a promessa, faça disso algo diferente de uma aba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บคือคำมั่นของจุดหมายปลายทาง ถ้ารักษาคำมั่นไม่ได้ ให้ทำเป็นอย่างอื่นที่ไม่ใช่แท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab là lời hứa về điểm đến. Nếu không giữ được lời hứa, hãy làm nó thành thứ khác tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta je slib cíle. Pokud slib nelze dodržet, udělejte z toho něco jiného než kartu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En fane er et løfte om en destination. Hvis du ikke kan holde løftet, så gør det til noget andet end en fane."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια καρτέλα είναι υπόσχεση προορισμού. Αν δεν μπορείς να κρατήσεις την υπόσχεση, κάν' το κάτι άλλο εκτός από καρτέλα."
          }
        }
      }
    },
    "탭은 상시 점유다. 가끔 쓰는 기능은 설정·시트·화면 안 진입점으로 충분하다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab occupies space permanently. Occasional features are fine in Settings, a sheet, or an entry point within a screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab occupies space permanently. Occasional features are fine in Settings, a sheet, or an entry point within a screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブは常に場所を占める。たまに使う機能は、設定・シート・画面内の入り口で十分だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是常驻占用。偶尔使用的功能，放设置、弹层、界面内入口就够了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤是常駐佔用。偶爾使用的功能，放設定、工作表、介面內入口就夠了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка занимает место постоянно. Редкие функции вполне уместны в настройках, шторке или точке входа внутри экрана."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña ocupa espacio de forma permanente. Las funciones ocasionales van bien en Ajustes, en una hoja o en un punto de entrada dentro de una pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab belegt dauerhaft Platz. Gelegentliche Funktionen sind in den Einstellungen, einem Sheet oder einem Einstiegspunkt im Bildschirm gut aufgehoben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet occupe l'espace en permanence. Les fonctions occasionnelles ont leur place dans Réglages, une feuille ou un point d'entrée dans un écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda occupa spazio in permanenza. Le funzioni occasionali stanno bene nelle Impostazioni, in un foglio o in un punto d'ingresso dentro una schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma aba ocupa espaço permanentemente. Funcionalidades ocasionais ficam bem em Ajustes, numa folha ou num ponto de entrada dentro de uma tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บกินพื้นที่ถาวร ฟีเจอร์นาน ๆ ครั้งอยู่ในการตั้งค่า ชีต หรือจุดเข้าภายในหน้าจอก็ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab chiếm chỗ vĩnh viễn. Tính năng thỉnh thoảng dùng thì để ở Cài đặt, một sheet, hoặc một điểm vào trong màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta trvale zabírá místo. Občasné funkce jsou v pořádku v Nastavení, sheetu nebo vstupním bodě uvnitř obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En fane optager plads permanent. Lejlighedsvise funktioner er fine i Indstillinger, et ark eller et indgangspunkt inde i en skærm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια καρτέλα καταλαμβάνει χώρο μόνιμα. Οι περιστασιακές λειτουργίες είναι εντάξει στις Ρυθμίσεις, σε φύλλο ή σε σημείο εισόδου μέσα σε οθόνη."
          }
        }
      }
    },
    "탭은 서로 다른 세계다. 같은 화면의 두 상태라면 세그먼트가 맞다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs are separate worlds. If it's two states of the same screen, a segmented control is the right fit."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs are separate worlds. If it's two states of the same screen, a segmented control is the right fit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブは互いに別の世界だ。同じ画面の2つの状態なら、セグメントが正しい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是不同的世界。如果是同一界面的两种状态，分段才对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤是不同的世界。如果是同一介面的兩種狀態，分段才對。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки - отдельные миры. Если это два состояния одного экрана, подходит сегментированный элемент."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas son mundos aparte. Si son dos estados de la misma pantalla, un control segmentado es lo adecuado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs sind getrennte Welten. Handelt es sich um zwei Zustände desselben Bildschirms, passt ein Segmented Control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets sont des mondes séparés. S'il s'agit de deux états du même écran, un contrôle segmenté convient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede sono mondi separati. Se sono due stati della stessa schermata, un controllo segmentato è la scelta giusta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abas são mundos separados. Se são dois estados da mesma tela, um controle segmentado é a escolha certa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บคือโลกแยก ถ้าเป็นสองสถานะของหน้าจอเดียว ตัวควบคุมแบบเซกเมนต์คือสิ่งที่เหมาะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab là các thế giới riêng. Nếu là hai trạng thái của cùng một màn hình, segmented control mới hợp."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty jsou samostatné světy. Pokud jde o dva stavy téže obrazovky, správně sedí segmentový ovladač."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faner er separate verdener. Hvis det er to tilstande af den samme skærm, passer en segmenteret kontrol bedst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καρτέλες είναι ξεχωριστοί κόσμοι. Αν είναι δύο καταστάσεις της ίδιας οθόνης, ένα segmented control είναι η σωστή επιλογή."
          }
        }
      }
    },
    "탭은 최상위 구조이므로, 검색을 탭으로 두는 것은 **“검색은 우리 앱의 한 세계”라는 선언**. 목록을 좁히는 필터형 검색이라면 과합니다, 그건 화면 안의 .searchable이 맞음.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs are top-level structure, so making search a tab is **a declaration that \"search is one of our app's worlds.\"** For filter-style search that narrows a list, that's overkill: .searchable inside the screen is the right fit."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs are top-level structure, so making search a tab is **a declaration that \"search is one of our app's worlds.\"** For filter-style search that narrows a list, that's overkill: .searchable inside the screen is the right fit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブは最上位の構造なので、検索をタブにするのは「**検索はこのアプリのひとつの世界だ」という宣言**。一覧を絞り込むフィルタ型の検索なら過剰で、それは画面内の.searchableが正解。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签是顶层结构，所以把搜索做成标签，是**“搜索是我们应用的一个世界”的宣告**。如果是缩小列表的筛选型搜索，就过头了，那应该是界面内的 .searchable。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤是頂層結構，所以把搜尋做成標籤，是**「搜尋是我們應用程式的一個世界」的宣告**。如果是縮小列表的篩選型搜尋，就過頭了，那應該是介面內的 .searchable。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки - структура верхнего уровня, поэтому сделать поиск вкладкой - **заявление «поиск - один из миров нашего приложения»**. Для поиска-фильтра, сужающего список, это чересчур: .searchable внутри экрана подходит."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas son estructura de nivel superior, así que convertir la búsqueda en una pestaña es **una declaración de que «la búsqueda es uno de los mundos de nuestra app»**. Para una búsqueda tipo filtro que reduce una lista, eso es excesivo: .searchable dentro de la pantalla es lo adecuado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs sind Struktur auf oberster Ebene, also ist die Suche zum Tab zu machen **eine Erklärung, dass „die Suche eine der Welten unserer App ist“**. Bei einer Filtersuche, die eine Liste eingrenzt, ist das übertrieben: .searchable innerhalb des Bildschirms passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets sont la structure de premier niveau, donc faire de la recherche un onglet est **une déclaration que « la recherche est l'un des mondes de notre app »**. Pour une recherche de type filtre qui réduit une liste, c'est excessif : .searchable à l'intérieur de l'écran convient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede sono la struttura di primo livello, quindi fare della ricerca una scheda è **una dichiarazione che «la ricerca è uno dei mondi della nostra app».** Per la ricerca a filtro che restringe un elenco, è esagerato: .searchable dentro la schermata è la scelta giusta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abas são a estrutura de nível superior, então fazer da busca uma aba é **uma declaração de que «a busca é um dos mundos do nosso app».** Para a busca em estilo de filtro que estreita uma lista, é exagero: .searchable dentro da tela é a escolha certa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บคือโครงสร้างระดับบนสุด การทำให้การค้นหาเป็นแท็บจึงเป็น**การประกาศว่า \"การค้นหาเป็นหนึ่งในโลกของแอปเรา\"** สำหรับการค้นหาแบบตัวกรองที่ทำให้รายการแคบลง นั่นเกินจำเป็น: .searchable ภายในหน้าจอคือสิ่งที่เหมาะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab là cấu trúc cấp cao nhất, nên biến tìm kiếm thành tab là **tuyên bố rằng \"tìm kiếm là một thế giới của app chúng tôi.\"** Với tìm kiếm kiểu lọc thu hẹp danh sách, thế là quá tay: .searchable bên trong màn hình mới hợp."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty jsou struktura nejvyšší úrovně, takže udělat z hledání kartu je **prohlášení, že „hledání je jeden ze světů naší aplikace.“** U hledání typu filtr, které zužuje seznam, je to přehnané: správně sedí .searchable uvnitř obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faner er struktur på øverste niveau, så at gøre søgning til en fane er **en erklæring om, at »søgning er en af vores apps verdener.«** Til filtersøgning, der indsnævrer en liste, er det overkill: .searchable inde i skærmen passer bedst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καρτέλες είναι δομή ανώτατου επιπέδου, οπότε το να κάνεις την αναζήτηση καρτέλα είναι **δήλωση ότι «η αναζήτηση είναι ένας από τους κόσμους της εφαρμογής μας»**. Για αναζήτηση τύπου φίλτρου που περιορίζει μια λίστα, αυτό είναι υπερβολή: το .searchable μέσα στην οθόνη είναι η σωστή επιλογή."
          }
        }
      }
    },
    "탭을 나누기 전에 두 화면을 나란히 놓고 **달라지는 게 필터뿐인지** 본다. 그렇다면 탭이 아니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before splitting into tabs, put the two screens side by side and check **whether the filter is the only thing that changes.** If so, it isn't a tab."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before splitting into tabs, put the two screens side by side and check **whether the filter is the only thing that changes.** If so, it isn't a tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを分ける前に、2つの画面を並べて**変わるのがフィルタだけか**を見る。そうなら、それはタブではない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拆分标签之前，把两个界面并排放着，看**不同的是不是只有筛选**。如果是，就不是标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拆分標籤之前，把兩個介面並排放著，看**不同的是不是隻有篩選**。如果是，就不是標籤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем делить на вкладки, поставьте два экрана рядом и проверьте, **меняется ли только фильтр.** Если да, это не вкладка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de dividir en pestañas, pon las dos pantallas lado a lado y comprueba **si el filtro es lo único que cambia.** Si es así, no es una pestaña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du in Tabs aufteilst, lege die zwei Bildschirme nebeneinander und prüfe, **ob sich nur der Filter ändert.** Wenn ja, ist es kein Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de scinder en onglets, mettez les deux écrans côte à côte et vérifiez **si le filtre est la seule chose qui change.** Si oui, ce n'est pas un onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di dividere in schede, metti affiancate le due schermate e controlla **se il filtro è l'unica cosa che cambia.** Se sì, non è una scheda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de dividir em abas, ponha as duas telas lado a lado e confira **se o filtro é a única coisa que muda.** Se sim, não é uma aba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนแยกเป็นแท็บ ให้วางสองหน้าจอเคียงกันและตรวจ**ว่าตัวกรองเป็นสิ่งเดียวที่เปลี่ยนหรือไม่** ถ้าใช่ มันไม่ใช่แท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi tách thành tab, hãy đặt hai màn hình cạnh nhau và kiểm tra **bộ lọc có phải thứ duy nhất thay đổi không.** Nếu có, nó không phải tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než rozdělíte na karty, položte obě obrazovky vedle sebe a ověřte, **zda je filtr jediná věc, která se mění.** Pokud ano, není to karta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du deler i faner, så læg de to skærme side om side og tjek **om filteret er det eneste, der ændrer sig.** Hvis ja, er det ikke en fane."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν χωρίσεις σε καρτέλες, βάλε τις δύο οθόνες δίπλα-δίπλα και έλεγξε **αν το φίλτρο είναι το μόνο που αλλάζει.** Αν ναι, δεν είναι καρτέλα."
          }
        }
      }
    },
    "탭을 넘나드는 상태는 특정 화면이 아니라 **앱 전역의 소유**, 그래서 탭 콘텐츠가 아닌 탭바 계층에 붙입니다. 모두가 각자 구현하던 뮤직 앱 미니 플레이어 패턴을 시스템 API로 표준화한 것.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State that spans tabs is **owned by the app as a whole**, not by any one screen, so it attaches to the tab bar layer rather than to tab content. It turns the Music mini-player pattern, which everyone used to build on their own, into a standard system API."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "State that spans tabs is **owned by the app as a whole**, not by any one screen, so it attaches to the tab bar layer rather than to tab content. It turns the Music mini-player pattern, which everyone used to build on their own, into a standard system API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブをまたぐ状態は特定の画面ではなく**アプリ全体のもの**。だからタブのコンテンツではなく、タブバーの層に付けます。誰もが自前で実装していたミュージックのミニプレーヤーのパターンを、システムのAPIとして標準化したもの。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨标签的状态不属于某个具体界面，而是**整个应用的所有物**，所以挂在标签栏层级，而不是标签内容上。把大家各自实现的“音乐”应用迷你播放器模式，标准化成了系统 API。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跨標籤的狀態不屬於某個具體介面，而是**整個應用程式的所有物**，所以掛在標籤列層級，而不是標籤內容上。把大家各自實作的「音樂」應用程式迷你播放器模式，標準化成了系統 API。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние, охватывающее вкладки, **принадлежит приложению в целом**, а не одному экрану, поэтому оно крепится к слою панели вкладок, а не к содержимому вкладки. Это превращает паттерн мини-плеера Музыки, который все строили сами, в стандартный системный API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado que abarca varias pestañas **pertenece a la app en su conjunto**, no a una pantalla concreta, así que se une a la capa de la barra de pestañas y no al contenido de la pestaña. Convierte el patrón del minirreproductor de Música, que todos construían por su cuenta, en una API estándar del sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zustand, der Tabs überspannt, **gehört der App als Ganzes**, nicht einem einzelnen Bildschirm, sodass er an der Ebene der Tab-Leiste hängt statt am Tab-Inhalt. Es macht das Miniplayer-Muster von Musik, das früher jeder selbst baute, zu einer standardmäßigen System-API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état qui traverse les onglets est **détenu par l'app tout entière**, pas par un écran particulier, donc il se rattache à la couche de la barre d'onglets plutôt qu'au contenu de l'onglet. Il fait du motif du mini-lecteur de Musique, que tout le monde construisait jadis à sa façon, une API système standard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato che attraversa le schede è **posseduto dall'app nel suo insieme**, non da una singola schermata, quindi si aggancia allo strato della barra delle schede anziché al contenuto della scheda. Trasforma il modello del mini player di Musica, che tutti costruivano da soli, in un'API di sistema standard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado que atravessa as abas é **de propriedade do app como um todo**, não de uma tela qualquer, então se prende à camada da barra de abas e não ao conteúdo da aba. Transforma o padrão de mini player do Música, que todo mundo costumava construir por conta própria, numa API de sistema padrão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะที่ข้ามแท็บ**เป็นของทั้งแอป** ไม่ใช่หน้าจอใดหน้าจอหนึ่ง จึงผูกกับชั้นแถบแท็บ ไม่ใช่เนื้อหาแท็บ มันเปลี่ยนรูปแบบมินิเพลเยอร์ของแอปเพลงที่ทุกคนเคยสร้างเองให้เป็น API มาตรฐานของระบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái trải qua nhiều tab **thuộc về toàn bộ app**, không thuộc màn hình nào, nên nó gắn vào lớp thanh tab chứ không phải nội dung tab. Nó biến mẫu trình phát mini của Nhạc, thứ mọi người từng tự dựng, thành một API hệ thống chuẩn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav, který zasahuje více karet, je **vlastněn celou aplikací**, ne žádnou jednotlivou obrazovkou, takže se připojuje k vrstvě panelu karet, ne k obsahu karty. Mění vzor mini přehrávače Hudby, který si dřív všichni stavěli sami, na standardní systémové API."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilstand, der spænder over faner, er **ejet af appen som helhed**, ikke af en enkelt skærm, så den knyttes til fanelinjeniveau frem for fanens indhold. Det gør Musik-miniafspillerens mønster, som alle plejede at bygge på egen hånd, til et standard system-API."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κατάσταση που εκτείνεται σε καρτέλες **ανήκει στην εφαρμογή συνολικά**, όχι σε μία οθόνη, οπότε προσαρτάται στο στρώμα της γραμμής καρτελών και όχι στο περιεχόμενο των καρτελών. Μετατρέπει το μοτίβο μίνι player της Μουσικής, που όλοι έφτιαχναν μόνοι τους, σε τυπικό API του συστήματος."
          }
        }
      }
    },
    "탭을 눌렀는데 이동 없이 시트만 뜬다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping a tab just opens a sheet without going anywhere"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping a tab just opens a sheet without going anywhere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブをタップしても移動せず、シートが出るだけ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点了标签没有跳转，只弹出弹层"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點了標籤沒有跳轉，只彈出工作表"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие на вкладку просто открывает шторку, никуда не переходя"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar una pestaña solo abre una hoja sin ir a ninguna parte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tab antippen öffnet nur ein Sheet, ohne irgendwohin zu gehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher un onglet ouvre seulement une feuille sans aller nulle part"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccare una scheda apre solo un foglio senza andare da nessuna parte"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar numa aba só abre uma folha sem ir a lugar nenhum"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแตะแท็บแค่เปิดชีตโดยไม่ไปไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm một tab chỉ mở một sheet mà không đi đâu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutí na kartu jen otevře sheet, aniž by někam vedlo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tryk på en fane åbner bare et ark uden at gå nogen steder hen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πάτημα μιας καρτέλας απλώς ανοίγει ένα φύλλο χωρίς να πηγαίνει πουθενά"
          }
        }
      }
    },
    "탭을 만들 때마다 **\"들어가자마자 무엇이 보이는가\"**를 먼저 그린다. 그릴 것이 없으면 그건 탭이 아니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every time you create a tab, first sketch **\"What do people see the moment they enter?\"** If there's nothing to sketch, it isn't a tab."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Every time you create a tab, first sketch **\"What do people see the moment they enter?\"** If there's nothing to sketch, it isn't a tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを作るたびに、まず「**入った瞬間に何が見えるか**」を描いてみる。描くものがなければ、それはタブではない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每做一个标签，先画出**“一进去看到什么”**。画不出东西，就不是标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每做一個標籤，先畫出**「一進去看到什麼」**。畫不出東西，就不是標籤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раз, создавая вкладку, сначала набросайте **«Что люди видят в момент входа?»** Если рисовать нечего, это не вкладка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que crees una pestaña, esboza primero **«¿Qué ve la gente en el momento de entrar?»** Si no hay nada que esbozar, no es una pestaña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skizziere jedes Mal, wenn du einen Tab anlegst, zuerst **„Was sehen Menschen in dem Moment, in dem sie hineingehen?“** Gibt es nichts zu skizzieren, ist es kein Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fois que vous créez un onglet, esquissez d'abord **« Que voient les gens à l'instant où ils y entrent ? »** S'il n'y a rien à esquisser, ce n'est pas un onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni volta che crei una scheda, abbozza prima **«Cosa vedono le persone nel momento in cui entrano?»** Se non c'è nulla da abbozzare, non è una scheda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda vez que você cria uma aba, esboce primeiro **«O que as pessoas veem no instante em que entram?»** Se não há nada para esboçar, não é uma aba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกครั้งที่สร้างแท็บ ให้ร่าง**\"คนเห็นอะไรทันทีที่เข้าไป\"**ก่อน ถ้าไม่มีอะไรให้ร่าง มันไม่ใช่แท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lần tạo một tab, trước hết hãy phác **\"Người ta thấy gì ngay khi bước vào?\"** Nếu không có gì để phác, nó không phải tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaždé, když vytvoříte kartu, nejdřív načrtněte **„Co lidé uvidí ve chvíli, kdy vstoupí?“** Pokud není co načrtnout, není to karta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gang du opretter en fane, så skitsér først **»Hvad ser folk i det øjeblik, de går ind?«** Hvis der ikke er noget at skitsere, er det ikke en fane."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε φορά που δημιουργείς μια καρτέλα, σκιτσάρισε πρώτα **«Τι βλέπουν οι άνθρωποι τη στιγμή που μπαίνουν;»** Αν δεν έχεις τίποτα να σκιτσάρεις, δεν είναι καρτέλα."
          }
        }
      }
    },
    "탭을 사용자의 목적으로 다시 나눈다. 예를 들어 \"내 돈\"(모든 계좌·카드의 흐름), \"보내기\", \"상품\", \"내 정보\". 부서별 화면은 그 안에서 필요한 자리로 흩어진다. 한 가지 궁금증은 한 탭 안에서 풀린다. 앱의 3.2.4 6 Tabs 예제는 칸이 늘어날 때 어떤 일이 생기는지를 보여 주니, 조직 수만큼 탭을 늘리기 전에 열어 볼 만하다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-divide the tabs by user goals. For example: \"My Money\" (activity across all accounts and cards), \"Send\", \"Products\", and \"Me\". Each department's screens get distributed to wherever they're needed inside those tabs. A single question gets answered within a single tab. The app's 3.2.4 6 Tabs example shows what happens as the number of tabs grows, so it's worth opening before you add a tab for every team."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-divide the tabs by user goals. For example: \"My Money\" (activity across all accounts and cards), \"Send\", \"Products\", and \"Me\". Each department's screens get distributed to wherever they're needed inside those tabs. A single question gets answered within a single tab. The app's 3.2.4 6 Tabs example shows what happens as the number of tabs grows, so it's worth opening before you add a tab for every team."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブをユーザーの目的で分け直す。たとえば「わたしのお金」（すべての口座とカードの動き）、「送る」、「商品」、「わたしの情報」。部署ごとの画面は、その中の必要な場所に散らばる。ひとつの疑問はひとつのタブの中で解決する。アプリの 3.2.4 6 Tabs の例はタブが増えると何が起きるかを見せてくれるので、組織の数だけタブを増やす前に開いてみる価値がある。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把标签按用户的目的重新划分。例如“我的钱”（所有账户 · 卡片的流向）、“转账”、“产品”、“我的信息”。按部门划分的界面，会散到其中需要的位置去。一个疑问在一个标签内解决。应用的 3.2.4 6 Tabs 示例展示了格子增加时会发生什么，在按组织数量增加标签之前值得打开看看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把標籤按使用者的目的重新劃分。例如「我的錢」（所有帳號 · 卡片的流向）、「轉賬」、「產品」、「我的資訊」。按部門劃分的介面，會散到其中需要的位置去。一個疑問在一個標籤內解決。應用程式的 3.2.4 6 Tabs 示例展示了格子增加時會發生什麼，在按組織數量增加標籤之前值得開啟看看。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделите вкладки заново по целям пользователей. Например: «Мои деньги» (операции по всем счетам и картам), «Отправить», «Продукты» и «Я». Экраны каждого отдела распределяются туда, где они нужны внутри этих вкладок. На один вопрос отвечают в одной вкладке. Пример приложения 3.2.4 6 Tabs показывает, что происходит по мере роста числа вкладок, так что стоит открыть его, прежде чем заводить вкладку для каждой команды."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a dividir las pestañas según los objetivos del usuario. Por ejemplo: «Mi dinero» (la actividad de todas las cuentas y tarjetas), «Enviar», «Productos» y «Yo». Las pantallas de cada departamento se distribuyen donde hagan falta dentro de esas pestañas. Una sola pregunta se responde dentro de una sola pestaña. El ejemplo 3.2.4 6 Tabs de la app muestra lo que pasa a medida que crece el número de pestañas, así que merece abrirlo antes de añadir una pestaña para cada equipo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile die Tabs neu nach Nutzerzielen auf. Zum Beispiel: „Mein Geld“ (Aktivität über alle Konten und Karten), „Senden“, „Produkte“ und „Ich“. Die Bildschirme jeder Abteilung werden dorthin verteilt, wo sie innerhalb dieser Tabs gebraucht werden. Eine einzige Frage wird innerhalb eines einzigen Tabs beantwortet. Das Beispiel 3.2.4 6 Tabs der App zeigt, was passiert, wenn die Zahl der Tabs wächst, also lohnt es sich, es zu öffnen, bevor du für jedes Team einen Tab hinzufügst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redivisez les onglets selon les objectifs des utilisateurs. Par exemple : « Mon argent » (activité sur tous les comptes et cartes), « Envoyer », « Produits » et « Moi ». Les écrans de chaque service sont répartis là où ils sont nécessaires dans ces onglets. Une seule question reçoit sa réponse dans un seul onglet. L'exemple 3.2.4 6 Tabs de l'app montre ce qui se passe quand le nombre d'onglets augmente, donc il vaut la peine de l'ouvrir avant d'ajouter un onglet pour chaque équipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridividi le schede per obiettivi degli utenti. Per esempio: «I miei soldi» (attività su tutti i conti e le carte), «Invia», «Prodotti» e «Io». Le schermate di ogni reparto vengono distribuite dove servono all'interno di quelle schede. Una singola domanda trova risposta dentro una sola scheda. L'esempio 3.2.4 6 schede dell'app mostra cosa succede man mano che il numero di schede cresce, quindi vale la pena aprirlo prima di aggiungere una scheda per ogni team."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redivida as abas por objetivos do usuário. Por exemplo: «Meu dinheiro» (movimentação de todas as contas e cartões), «Enviar», «Produtos» e «Eu». As telas de cada departamento são distribuídas onde forem necessárias dentro dessas abas. Uma única pergunta é respondida dentro de uma só aba. O exemplo 3.2.4 6 abas do app mostra o que acontece conforme o número de abas cresce, então vale abri-lo antes de acrescentar uma aba para cada time."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบ่งแท็บใหม่ตามเป้าหมายของผู้ใช้ เช่น: \"เงินของฉัน\" (กิจกรรมข้ามทุกบัญชีและบัตร) \"ส่งเงิน\" \"ผลิตภัณฑ์\" และ \"ฉัน\" หน้าจอของแต่ละแผนกถูกกระจายไปยังที่ที่ต้องการภายในแท็บเหล่านั้น คำถามเดียวได้คำตอบภายในแท็บเดียว ตัวอย่าง 3.2.4 6 Tabs ของแอปแสดงว่าเกิดอะไรขึ้นเมื่อจำนวนแท็บโตขึ้น จึงควรเปิดก่อนจะเพิ่มแท็บให้ทุกทีม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia lại các tab theo mục tiêu của người dùng. Ví dụ: \"Tiền của tôi\" (hoạt động trên mọi tài khoản và thẻ), \"Chuyển tiền\", \"Sản phẩm\" và \"Tôi\". Màn hình của từng phòng ban được phân bổ vào bất cứ đâu cần bên trong các tab đó. Một câu hỏi được trả lời trong một tab. Ví dụ 3.2.4 6 Tabs của app cho thấy chuyện gì xảy ra khi số tab tăng, nên đáng mở trước khi bạn thêm một tab cho mỗi nhóm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdělte karty znovu podle cílů uživatele. Například: „Moje peníze“ (aktivita napříč všemi účty a kartami), „Poslat“, „Produkty“ a „Já“. Obrazovky každého oddělení se rozdělí tam, kde jsou uvnitř těch karet potřeba. Jedna otázka se zodpoví v jedné kartě. Příklad 3.2.4 6 Tabs aplikace ukazuje, co se stane, když počet karet roste, takže stojí za to ho otevřít dřív, než přidáte kartu pro každý tým."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del fanerne om efter brugermål. For eksempel: »Mine penge« (aktivitet på tværs af alle konti og kort), »Send«, »Produkter« og »Mig«. Hver afdelings skærme fordeles derhen, hvor der er brug for dem inde i de faner. Et enkelt spørgsmål besvares inden for en enkelt fane. Appens eksempel 3.2.4 6 faner viser, hvad der sker, når antallet af faner vokser, så det er værd at åbne, før du tilføjer en fane for hvert team."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξαναχώρισε τις καρτέλες ανά στόχους χρήστη. Για παράδειγμα: «Τα Λεφτά μου» (δραστηριότητα σε όλους τους λογαριασμούς και τις κάρτες), «Αποστολή», «Προϊόντα» και «Εγώ». Οι οθόνες κάθε τμήματος διανέμονται όπου χρειάζονται μέσα σε αυτές τις καρτέλες. Ένα ερώτημα απαντιέται μέσα σε μία καρτέλα. Το παράδειγμα 3.2.4 6 Καρτέλες της εφαρμογής δείχνει τι γίνεται καθώς μεγαλώνει ο αριθμός των καρτελών, οπότε αξίζει να το ανοίξεις πριν προσθέσεις καρτέλα για κάθε ομάδα."
          }
        }
      }
    },
    "탭이 **둘뿐인 최소 구조**, 하단 바 전체를 두 목적지가 나눠 씀.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **minimal structure of just two tabs**, with two destinations sharing the whole bottom bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **minimal structure of just two tabs**, with two destinations sharing the whole bottom bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブが**2つだけの最小構成**。下部のバー全体を2つの行き先で分け合う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**只有两个标签的最小结构**，整个底部栏由两个目的地分着用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**只有兩個標籤的最小結構**，整個底部列由兩個目的地分著用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Минимальная структура всего из двух вкладок**, два пункта назначения делят всю нижнюю панель."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una **estructura mínima de solo dos pestañas**, con dos destinos compartiendo toda la barra inferior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine **minimale Struktur aus nur zwei Tabs**, bei der zwei Ziele die ganze untere Leiste teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une **structure minimale de seulement deux onglets**, deux destinations se partageant toute la barre du bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una **struttura minima di sole due schede**, con due destinazioni che condividono l'intera barra in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma **estrutura mínima de apenas duas abas**, com dois destinos dividindo toda a barra inferior."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**โครงสร้างขั้นต่ำเพียงสองแท็บ** โดยสองจุดหมายปลายทางใช้แถบล่างทั้งแถบร่วมกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một **cấu trúc tối thiểu chỉ có hai tab**, với hai điểm đến chia nhau cả thanh dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Minimální struktura jen ze dvou karet**, kde dva cíle sdílejí celý spodní panel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En **minimal struktur med kun to faner**, hvor to destinationer deler hele den nederste bjælke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια **ελάχιστη δομή με μόνο δύο καρτέλες**, με δύο προορισμούς να μοιράζονται ολόκληρη την κάτω γραμμή."
          }
        }
      }
    },
    "탭이 넘칠 때 먼저 의심할 것은 화면 폭이 아니라 **구조**다. 통합을 먼저, 추가는 마지막에.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When tabs overflow, the first thing to suspect is not the screen width but **the structure.** Consolidate first; add last."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When tabs overflow, the first thing to suspect is not the screen width but **the structure.** Consolidate first; add last."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブがあふれたとき、まず疑うべきは画面の幅ではなく**構造**だ。統合が先、追加は最後に。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签溢出时，先怀疑的不是屏幕宽度，而是**结构**。先合并，最后才新增。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤溢位時，先懷疑的不是螢幕寬度，而是**結構**。先合併，最後才新增。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вкладки переполняются, первым делом подозревайте не ширину экрана, а **структуру.** Сначала объединяйте; добавляйте в последнюю очередь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando las pestañas desbordan, lo primero que hay que sospechar no es el ancho de la pantalla sino **la estructura.** Consolida primero; añade en último lugar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufen Tabs über, ist der erste Verdacht nicht die Bildschirmbreite, sondern **die Struktur.** Erst zusammenführen, zuletzt hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand les onglets débordent, le premier soupçon n'est pas la largeur de l'écran mais **la structure.** Consolidez d'abord ; ajoutez en dernier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando le schede traboccano, la prima cosa da sospettare non è la larghezza dello schermo ma **la struttura.** Prima consolida, aggiungi per ultimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando as abas transbordam, a primeira coisa a suspeitar não é a largura da tela, mas **a estrutura.** Consolide primeiro; acrescente por último."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อแท็บล้น สิ่งแรกที่ควรสงสัยไม่ใช่ความกว้างหน้าจอแต่คือ**โครงสร้าง** รวมก่อน เพิ่มทีหลังสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tab bị tràn, điều đầu tiên đáng nghi không phải chiều rộng màn hình mà là **cấu trúc.** Hợp nhất trước; thêm sau cùng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když karty přetékají, první, co podezírat, není šířka obrazovky, ale **struktura.** Nejdřív sloučit; přidat až naposled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når faner løber over, er det første at mistænke ikke skærmbredden men **strukturen.** Konsolidér først; tilføj til sidst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν οι καρτέλες ξεχειλίζουν, το πρώτο που πρέπει να υποψιαστείς δεν είναι το πλάτος της οθόνης αλλά **η δομή.** Συγχώνευσε πρώτα· πρόσθεσε τελευταία."
          }
        }
      }
    },
    "탭이 둘 이상이어야 앱 구조가 있어 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems an app needs at least two tabs to look like it has structure."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It seems an app needs at least two tabs to look like it has structure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブが2つ以上ないと、アプリに構造があるように見えない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签得有两个以上，应用才显得有结构。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤得有兩個以上，應用程式才顯得有結構。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кажется, что приложению нужно минимум две вкладки, чтобы выглядеть структурированным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que una app necesita al menos dos pestañas para parecer que tiene estructura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App scheint mindestens zwei Tabs zu brauchen, um Struktur zu haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il semble qu'une app ait besoin d'au moins deux onglets pour paraître structurée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che un'app abbia bisogno di almeno due schede per sembrare strutturata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que um app precisa de pelo menos duas abas para parecer ter estrutura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือนแอปต้องมีอย่างน้อยสองแท็บจึงจะดูมีโครงสร้าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có vẻ app cần ít nhất hai tab mới trông có cấu trúc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdá se, že aplikace potřebuje alespoň dvě karty, aby vypadala, že má strukturu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser ud til, at en app skal have mindst to faner for at se ud, som om den har struktur."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φαίνεται ότι μια εφαρμογή χρειάζεται τουλάχιστον δύο καρτέλες για να μοιάζει να έχει δομή."
          }
        }
      }
    },
    "탭이 하나뿐이면 앱이 빈약해 보인다. 탭바가 있어야 앱에 구조가 있는 것 같고, 둘로 나눌 거리를 찾다 보면 한 화면의 두 상태가 눈에 들어온다. 둘 다 자주 보니 둘 다 최상위에 둘 자격이 있어 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With only one tab, the app looks thin. Having a tab bar makes the app seem structured, and while looking for something to split in two, the two states of a single screen catch your eye. Both get viewed often, so both seem to deserve top-level placement."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With only one tab, the app looks thin. Having a tab bar makes the app seem structured, and while looking for something to split in two, the two states of a single screen catch your eye. Both get viewed often, so both seem to deserve top-level placement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブが1つだけだと、アプリが貧弱に見える。タブバーがあってこそアプリに構造があるように思え、2つに分けられるものを探しているうちに、1つの画面の2つの状態が目に留まる。どちらもよく見るので、どちらも最上位に置く資格があるように見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有一个标签，应用就显得单薄。有标签栏，应用才好像有结构；找着能拆成两个的东西，一个界面的两种状态就进入了视线。两个都经常看，似乎都有资格放在顶层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有一個標籤，應用程式就顯得單薄。有標籤列，應用程式才好像有結構；找著能拆成兩個的東西，一個介面的兩種狀態就進入了視線。兩個都經常看，似乎都有資格放在頂層。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С одной вкладкой приложение выглядит скудно. Наличие панели вкладок создаёт впечатление структуры, и в поисках, что бы разделить надвое, в глаза бросаются два состояния одного экрана. Оба просматривают часто, поэтому оба, кажется, заслуживают размещения на верхнем уровне."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una sola pestaña, la app parece escasa. Tener una barra de pestañas hace que la app parezca estructurada, y mientras buscas algo para dividir en dos, los dos estados de una sola pantalla llaman la atención. Ambos se ven a menudo, así que ambos parecen merecer un sitio de nivel superior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit nur einem Tab wirkt die App dünn. Eine Tab-Leiste lässt die App strukturiert wirken, und auf der Suche nach etwas, das sich in zwei teilen lässt, fallen die zwei Zustände eines einzelnen Bildschirms ins Auge. Beide werden oft angesehen, also scheinen beide eine Platzierung auf oberster Ebene zu verdienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un seul onglet, l'app paraît maigre. Avoir une barre d'onglets fait paraître l'app structurée, et en cherchant quelque chose à scinder en deux, les deux états d'un seul écran attirent l'œil. Les deux sont souvent consultés, donc les deux semblent mériter un placement de premier niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una sola scheda, l'app sembra magra. Avere una barra delle schede fa sembrare l'app strutturata, e mentre cerchi qualcosa da dividere in due, ti cadono sotto gli occhi i due stati di una sola schermata. Entrambi vengono guardati spesso, quindi entrambi sembrano meritare una collocazione di primo livello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com só uma aba, o app parece magro. Ter uma barra de abas faz o app parecer estruturado, e enquanto procura algo para dividir em dois, os dois estados de uma única tela chamam a atenção. Ambos são muito vistos, então ambos parecem merecer uma colocação de nível superior."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแท็บเดียว แอปดูบาง การมีแถบแท็บทำให้แอปดูมีโครงสร้าง และขณะมองหาสิ่งที่แบ่งเป็นสองได้ สองสถานะของหน้าจอเดียวก็สะดุดตา ทั้งคู่ถูกดูบ่อย จึงดูเหมือนคู่ควรกับการวางระดับบนสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có một tab thì app trông mỏng. Có thanh tab khiến app trông có cấu trúc, và trong lúc tìm thứ để chia đôi, hai trạng thái của một màn hình lọt vào mắt. Cả hai đều được xem thường xuyên, nên cả hai có vẻ xứng đáng được đặt cấp cao nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S jedinou kartou aplikace vypadá chudě. Panel karet nechává aplikaci působit strukturovaně, a při hledání něčeho, co rozdělit na dvě, padnou do oka dva stavy jediné obrazovky. Oba se často prohlížejí, takže oba jako by si zasloužily umístění nejvyšší úrovně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med kun én fane ser appen tynd ud. En fanelinje får appen til at virke struktureret, og mens man leder efter noget at dele i to, falder øjet på de to tilstande af en enkelt skærm. Begge ses ofte, så begge ser ud til at fortjene en placering på øverste niveau."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με μία μόνο καρτέλα, η εφαρμογή φαίνεται αδύναμη. Το να έχεις γραμμή καρτελών κάνει την εφαρμογή να μοιάζει δομημένη, και ψάχνοντας κάτι να χωρίσεις στα δύο, πέφτουν στο μάτι οι δύο καταστάσεις μιας οθόνης. Και οι δύο βλέπονται συχνά, οπότε και οι δύο φαίνεται να αξίζουν τοποθέτηση ανώτατου επιπέδου."
          }
        }
      }
    },
    "탭이라면 최근 검색·추천처럼 그 자체로 한 세계여야 한다. 아니면 role: .search로 내린다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As a tab, it has to be a world of its own, with things like recent searches and suggestions. Otherwise, demote it with role: .search."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "As a tab, it has to be a world of its own, with things like recent searches and suggestions. Otherwise, demote it with role: .search."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブにするなら、最近の検索やおすすめのように、それ自体でひとつの世界でなければならない。そうでなければ role: .search に格下げする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是标签，就得像最近搜索 · 推荐那样，本身就是一个世界。否则降到 role: .search。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是標籤，就得像最近搜尋 · 推薦那樣，本身就是一個世界。否則降到 role: .search。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как вкладка, он должен быть собственным миром, с недавними запросами и подсказками. Иначе понизьте его до role: .search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como pestaña, tiene que ser un mundo propio, con cosas como búsquedas recientes y sugerencias. Si no, degrádala con role: .search."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Tab muss sie eine eigene Welt sein, mit Dingen wie letzten Suchen und Vorschlägen. Andernfalls stufe sie mit role: .search herab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme onglet, il doit être un monde à part, avec des choses comme des recherches récentes et des suggestions. Sinon, rétrogradez-le avec role: .search."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come scheda, deve essere un mondo a sé, con cose come ricerche recenti e suggerimenti. Altrimenti, declassala con role: .search."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como aba, precisa ser um mundo à parte, com coisas como buscas recentes e sugestões. Caso contrário, rebaixe-a com role: .search."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในรูปแท็บ มันต้องเป็นโลกของตัวเอง ที่มีสิ่งอย่างการค้นหาล่าสุดและคำแนะนำ ไม่เช่นนั้น ให้ลดระดับด้วย role: .search"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Là một tab, nó phải là thế giới riêng, với những thứ như tìm kiếm gần đây và gợi ý. Nếu không, hạ nó xuống bằng role: .search."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako karta musí být světem sama pro sebe, s věcmi jako nedávná hledání a návrhy. Jinak ji degradujte pomocí role: .search."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som fane skal den være en verden for sig med ting som seneste søgninger og forslag. Ellers nedgrader den med role: .search."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ως καρτέλα, πρέπει να είναι δικός της κόσμος, με πράγματα όπως πρόσφατες αναζητήσεις και προτάσεις. Αλλιώς υποβάθμισέ την με role: .search."
          }
        }
      }
    },
    "탭하면 이동 없이 시트만 띄우는 가짜 탭": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fake tab that only opens a sheet without going anywhere"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A fake tab that only opens a sheet without going anywhere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしても移動せずシートを出すだけの偽のタブ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按后不跳转、只弹出弹层的假标签"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點後不跳轉、只彈出工作表的假標籤"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддельная вкладка, лишь открывающая шторку и никуда не ведущая"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña falsa que solo abre una hoja sin ir a ninguna parte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein falscher Tab, der nur ein Sheet öffnet, ohne irgendwohin zu gehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un faux onglet qui ouvre seulement une feuille sans aller nulle part"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una falsa scheda che apre solo un foglio senza andare da nessuna parte"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma falsa aba que só abre uma folha sem ir a lugar nenhum"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บปลอมที่แค่เปิดชีตโดยไม่ไปไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tab giả chỉ mở sheet mà không đi đâu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Falešná karta, která jen otevře sheet, aniž by někam vedla"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En falsk fane, der kun åbner et ark uden at gå nogen steder hen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ψεύτικη καρτέλα που απλώς ανοίγει φύλλο χωρίς να πηγαίνει πουθενά"
          }
        }
      }
    },
    "탭한 카드가 **시트로 확대**(zoom), 공간적 연속성": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tapped card **expands into the sheet** (zoom), keeping spatial continuity"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tapped card **expands into the sheet** (zoom), keeping spatial continuity"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしたカードが**シートへと拡大**（zoom）。空間的な連続性"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被点按的卡片**放大成弹层**（zoom），空间连续性"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被輕點的卡片**放大成工作表**（zoom），空間連續性"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатая карточка **раскрывается в шторку** (zoom), сохраняя пространственную непрерывность"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarjeta tocada **se expande en la hoja** (zoom), conservando la continuidad espacial"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angetippte Karte **erweitert sich zum Sheet** (Zoom) und bewahrt die räumliche Kontinuität"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte touchée **se déploie en la feuille** (zoom), gardant la continuité spatiale"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda toccata **si espande nel foglio** (zoom), mantenendo la continuità spaziale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cartão tocado **se expande na folha** (zoom), mantendo a continuidade espacial"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดที่แตะ**ขยายเป็นชีต** (zoom) คงความต่อเนื่องเชิงพื้นที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ được chạm **mở rộng thành sheet** (zoom), giữ tính liên tục không gian"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutá karta se **rozbalí do sheetu** (zoom), zachová prostorovou návaznost"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det trykkede kort **udvides til arket** (zoom) og bevarer den rumlige kontinuitet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάρτα που πατήθηκε **επεκτείνεται στο φύλλο** (zoom), κρατώντας τη χωρική συνέχεια"
          }
        }
      }
    },
    "터치 타깃 크기와 인지 부하의 교차점, 5개를 넘으면 각 타깃이 엄지 정확도 아래로 좁아지고, 최상위 개념이 많아지면 구조 자체가 안 읽힘. **“모든 걸 탭으로”가 아니라 덜 중요한 건 탭 안의 화면으로** 내리는 게 원칙.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's where touch target size and cognitive load meet. Past five, each target gets narrower than a thumb can reliably hit, and with too many top-level concepts the structure itself stops making sense. The principle is **not \"make everything a tab,\" but move less important things down into screens inside a tab**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's where touch target size and cognitive load meet. Past five, each target gets narrower than a thumb can reliably hit, and with too many top-level concepts the structure itself stops making sense. The principle is **not \"make everything a tab,\" but move less important things down into screens inside a tab**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップ領域の大きさと認知負荷が交わる点。5個を超えると各領域が親指の精度より狭くなり、最上位の概念が多すぎると構造そのものが読み取れなくなる。**「何でもタブに」ではなく、重要度の低いものはタブの中の画面へ**下ろすのが原則。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标大小与认知负担的交点：超过 5 个，每个目标就窄到低于拇指精度，顶层概念一多，整个结构就读不出来。原则不是“全都做成标签”，而是**把次要的下沉到标签内的界面**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標大小與認知負擔的交點：超過 5 個，每個目標就窄到低於拇指精度，頂層概念一多，整個結構就讀不出來。原則不是「全都做成標籤」，而是**把次要的下沉到標籤內的介面**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь встречаются размер области касания и когнитивная нагрузка. Больше пяти, и каждая цель становится уже, чем палец может надёжно попасть, а при слишком многих понятиях верхнего уровня сама структура перестаёт иметь смысл. Принцип - **не «делать вкладкой всё», а переносить менее важное вниз, на экраны внутри вкладки**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es donde se encuentran el tamaño del objetivo táctil y la carga cognitiva. Pasadas las cinco, cada objetivo se estrecha más de lo que un pulgar puede acertar con fiabilidad, y con demasiados conceptos de nivel superior la propia estructura deja de tener sentido. El principio **no es «convertirlo todo en pestañas», sino pasar lo menos importante a pantallas dentro de una pestaña**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier treffen sich die Größe des Touch-Ziels und die kognitive Last. Ab fünf wird jedes Ziel schmaler, als ein Daumen zuverlässig treffen kann, und bei zu vielen Konzepten auf oberster Ebene ergibt die Struktur selbst keinen Sinn mehr. Das Prinzip lautet **nicht „mache alles zum Tab“, sondern verschiebe Unwichtigeres nach unten in Bildschirme innerhalb eines Tabs**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est là que se rejoignent la taille des cibles tactiles et la charge cognitive. Au-delà de cinq, chaque cible devient plus étroite que ce qu'un pouce peut toucher de façon fiable, et avec trop de concepts de premier niveau, la structure elle-même n'a plus de sens. Le principe n'est **pas « faire de tout un onglet », mais descendre le moins important dans des écrans à l'intérieur d'un onglet**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il punto in cui si incontrano dimensione del bersaglio tattile e carico cognitivo. Oltre cinque, ogni bersaglio diventa più stretto di quanto un pollice possa colpire in modo affidabile, e con troppi concetti di primo livello la struttura stessa smette di avere senso. Il principio **non è «fai di tutto una scheda»**, ma spostare le cose meno importanti giù, in schermate dentro una scheda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É onde se encontram o tamanho do alvo de toque e a carga cognitiva. Acima de cinco, cada alvo fica mais estreito do que um polegar consegue acertar com confiança, e com conceitos de nível superior demais a própria estrutura deixa de fazer sentido. O princípio **não é «faça de tudo uma aba»**, mas mover o que é menos importante para telas dentro de uma aba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นที่ที่ขนาดเป้าสัมผัสกับภาระทางความคิดมาบรรจบกัน เกินห้า เป้าแต่ละอันแคบกว่าที่นิ้วโป้งกดได้อย่างเชื่อถือได้ และเมื่อมีแนวคิดระดับบนสุดมากเกินไป โครงสร้างเองก็เลิกสมเหตุสมผล หลักการคือ**ไม่ใช่ \"ทำทุกอย่างให้เป็นแท็บ\" แต่ย้ายสิ่งที่สำคัญน้อยกว่าลงไปในหน้าจอภายในแท็บ**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là nơi kích thước vùng chạm gặp gánh nặng nhận thức. Quá năm, mỗi vùng hẹp hơn mức ngón cái chạm đáng tin, và với quá nhiều khái niệm cấp cao nhất, bản thân cấu trúc không còn nghĩa. Nguyên tắc là **không phải \"biến mọi thứ thành tab\", mà chuyển những thứ ít quan trọng hơn xuống các màn hình bên trong một tab**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to místo, kde se potkává velikost dotykového cíle a kognitivní zátěž. Za pět je každý cíl užší, než palec spolehlivě trefí, a při příliš mnoha konceptech nejvyšší úrovně přestane dávat smysl sama struktura. Zásada zní **ne „udělejte z všeho kartu“, ale přesuňte méně důležité věci dolů na obrazovky uvnitř karty**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er der, hvor berøringsmålets størrelse og kognitiv belastning mødes. Ud over fem bliver hvert mål smallere, end en tommelfinger pålideligt kan ramme, og med for mange koncepter på øverste niveau holder selve strukturen op med at give mening. Princippet er **ikke »gør alt til en fane«, men flyt mindre vigtige ting ned i skærme inde i en fane**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ συναντιούνται το μέγεθος στόχου αφής και το γνωστικό φορτίο. Πέρα από πέντε, κάθε στόχος στενεύει περισσότερο από όσο μπορεί ο αντίχειρας να πετύχει αξιόπιστα, και με πάρα πολλές έννοιες ανώτατου επιπέδου η ίδια η δομή παύει να βγάζει νόημα. Η αρχή είναι **όχι «κάν' τα όλα καρτέλες», αλλά μετάφερε τα λιγότερο σημαντικά κάτω σε οθόνες μέσα σε μια καρτέλα**."
          }
        }
      }
    },
    "텍스트 목록·카드 피드 등 평범한 콘텐츠의 기본값으로": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As the default for ordinary content such as text lists and card feeds"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "As the default for ordinary content such as text lists and card feeds"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストのリストやカードのフィードなど、一般的なコンテンツのデフォルトとして"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为文本列表、卡片信息流等普通内容的默认值"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作為文字列表、卡片資訊流等普通內容的預設值"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как значение по умолчанию для обычного содержимого вроде текстовых списков и лент карточек"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como valor por defecto para contenido normal como listas de texto y feeds de tarjetas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Standard für gewöhnlichen Inhalt wie Textlisten und Karten-Feeds"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme réglage par défaut pour le contenu ordinaire tel que les listes de texte et les flux de cartes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come predefinito per contenuti ordinari come elenchi di testo e feed di schede"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como padrão para conteúdo comum como listas de texto e feeds de cartões"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นค่าเริ่มต้นสำหรับเนื้อหาทั่วไป เช่นรายการข้อความและฟีดการ์ด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm mặc định cho nội dung thông thường như danh sách văn bản và bảng tin thẻ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako výchozí pro běžný obsah, například textové seznamy a kanály karet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som standard for almindeligt indhold som tekstlister og kortfeeds"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ως προεπιλογή για συνηθισμένο περιεχόμενο όπως λίστες κειμένου και ροές καρτών"
          }
        }
      }
    },
    "텍스트 설정을 겹칠 때는 Dynamic Type 최대에서 한 번 열어 본다. 기본 크기는 검증 조건이 아니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you stack text settings, open the screen once at the largest Dynamic Type size. The default size is not a test condition."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you stack text settings, open the screen once at the largest Dynamic Type size. The default size is not a test condition."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの設定を重ねるときは、Dynamic Typeを最大にして一度開いてみる。標準サイズは検証条件ではない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叠加文字设置时，要在 Dynamic Type 最大时打开一次。默认字号不是验证条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "疊加文字設定時，要在 Dynamic Type 最大時開啟一次。預設字號不是驗證條件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда накладываете текстовые настройки, откройте экран один раз при самом крупном размере Dynamic Type. Размер по умолчанию - не условие проверки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando apiles ajustes de texto, abre la pantalla una vez con el mayor tamaño de Dynamic Type. El tamaño por defecto no es una condición de prueba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Texteinstellungen stapelst, öffne den Bildschirm einmal mit der größten Dynamic-Type-Größe. Die Standardgröße ist keine Testbedingung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous empilez des réglages de texte, ouvrez l'écran une fois à la plus grande taille Dynamic Type. La taille par défaut n'est pas une condition de test."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sovrapponi impostazioni di testo, apri la schermata una volta alla massima dimensione di Dynamic Type. La dimensione predefinita non è una condizione di prova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você empilha ajustes de texto, abra a tela uma vez no maior tamanho de Dynamic Type. O tamanho padrão não é uma condição de teste."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อซ้อนการตั้งค่าข้อความ ให้เปิดหน้าจอสักครั้งที่ขนาด Dynamic Type ใหญ่สุด ขนาดเริ่มต้นไม่ใช่เงื่อนไขการทดสอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn chồng nhiều thiết lập chữ, hãy mở màn hình một lần ở cỡ Dynamic Type lớn nhất. Cỡ mặc định không phải điều kiện kiểm tra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když skládáte nastavení textu, otevřete obrazovku jednou při největší velikosti Dynamic Type. Výchozí velikost není zkušební podmínka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du stabler tekstindstillinger, så åbn skærmen én gang ved den største Dynamic Type-størrelse. Standardstørrelsen er ikke en testbetingelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν στοιβάζεις ρυθμίσεις κειμένου, άνοιξε την οθόνη μία φορά στο μεγαλύτερο μέγεθος Dynamic Type. Το προεπιλεγμένο μέγεθος δεν είναι συνθήκη δοκιμής."
          }
        }
      }
    },
    "텍스트가 항상 1줄인데 3줄을 예약": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three lines reserved for text that is always one line"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Three lines reserved for text that is always one line"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストは常に1行なのに3行を確保"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字总是 1 行，却预留 3 行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字總是 1 行，卻預留 3 行"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три строки, зарезервированные для текста, который всегда в одну строку"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres líneas reservadas para un texto que siempre es de una línea"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Zeilen für Text reserviert, der immer einzeilig ist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois lignes réservées pour un texte qui tient toujours sur une ligne"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre righe riservate a un testo che è sempre di una riga"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três linhas reservadas para um texto que é sempre de uma linha"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำรองสามบรรทัดสำหรับข้อความที่เป็นบรรทัดเดียวเสมอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ ba dòng cho văn bản luôn một dòng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tři řádky rezervované pro text, který je vždy jeden řádek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre linjer reserveret til tekst, der altid er én linje"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρεις γραμμές δεσμευμένες για κείμενο που είναι πάντα μία γραμμή"
          }
        }
      }
    },
    "텍스트는 콘텐츠 길이를 예측할 수 없다는 게 본질입니다. 다섯 케이스는 전부 **\"공간은 유한한데 텍스트는 가변\"**이라는 하나의 문제에 대한 서로 다른 답, 자른다(limit·truncation), 줄인다(scale), 예약한다(range), 그리고 선택하게 한다(selection).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The essence of text is that you cannot predict how long the content will be. All five cases are different answers to a single problem, **\"space is finite, but text varies\"**: cut it (limit · truncation), shrink it (scale), reserve room for it (range), or let people select it (selection)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The essence of text is that you cannot predict how long the content will be. All five cases are different answers to a single problem, **\"space is finite, but text varies\"**: cut it (limit · truncation), shrink it (scale), reserve room for it (range), or let people select it (selection)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストの本質は、コンテンツの長さを予測できないことです。5つのケースはすべて、**「スペースは有限なのにテキストは可変**」というひとつの問題に対する異なる答えです。切る（limit · truncation）、縮める（scale）、確保する（range）、そして選択させる（selection）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本的本质是内容长度无法预测。五个案例都是对**“空间有限而文字可变”**这一个问题的不同回答：截断（limit · truncation）、缩小（scale）、预留（range），以及让用户选择（selection）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字的本質是內容長度無法預測。五個案例都是對**「空間有限而文字可變」**這一個問題的不同回答：截斷（limit · truncation）、縮小（scale）、預留（range），以及讓使用者選擇（selection）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Суть текста в том, что длину содержимого предсказать нельзя. Все пять случаев - разные ответы на одну проблему, **«место конечно, а текст разный»**: обрезать (ограничение · усечение), сжать (масштаб), зарезервировать место (диапазон) или позволить выделять (выделение)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La esencia del texto es que no puedes predecir cuánto durará el contenido. Los cinco casos son respuestas distintas a un único problema, **«el espacio es finito, pero el texto varía»**: cortarlo (límite · truncamiento), reducirlo (escala), reservarle sitio (rango) o dejar que la gente lo seleccione (selección)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wesen von Text ist, dass man nicht vorhersagen kann, wie lang der Inhalt ist. Alle fünf Fälle sind verschiedene Antworten auf ein einziges Problem, **„Platz ist endlich, aber Text variiert“**: abschneiden (Limit · Abschneiden), verkleinern (Skalieren), Platz reservieren (Bereich) oder Menschen auswählen lassen (Auswahl)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'essence du texte est qu'on ne peut pas prédire la longueur du contenu. Les cinq cas sont des réponses différentes à un seul problème, **« l'espace est fini, mais le texte varie »** : le couper (limite · troncature), le réduire (échelle), lui réserver de la place (plage), ou laisser les gens le sélectionner (sélection)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'essenza del testo è che non puoi prevedere quanto sarà lungo il contenuto. Tutti e cinque i casi sono risposte diverse a un unico problema, **«lo spazio è finito, ma il testo varia»**: tagliarlo (limite · troncamento), rimpicciolirlo (scala), riservargli posto (intervallo) o lasciare che le persone lo selezionino (selezione)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A essência do texto é que você não consegue prever quanto vai medir o conteúdo. Os cinco casos são respostas diferentes a um único problema, **«o espaço é finito, mas o texto varia»**: cortá-lo (limite · truncamento), encolhê-lo (escala), reservar-lhe lugar (intervalo) ou deixar as pessoas selecioná-lo (seleção)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก่นของข้อความคือคุณคาดเดาไม่ได้ว่าเนื้อหาจะยาวแค่ไหน ทั้งห้ากรณีเป็นคำตอบต่างกันของปัญหาเดียว **\"พื้นที่มีจำกัด แต่ข้อความต่างกันไป\"**: ตัด (จำกัด · ตัด) ย่อ (ปรับขนาด) สำรองที่ (ช่วง) หรือให้คนเลือก (การเลือก)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chất của văn bản là bạn không thể đoán nội dung dài bao nhiêu. Cả năm trường hợp là các đáp án khác nhau cho một vấn đề duy nhất, **\"không gian hữu hạn, nhưng văn bản thì biến thiên\"**: cắt (giới hạn · cắt bớt), co (tỷ lệ), giữ chỗ (phạm vi), hoặc cho người ta chọn (chọn văn bản)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podstata textu je, že nemůžete předpovědět, jak dlouhý obsah bude. Všech pět případů jsou různé odpovědi na jediný problém, **„prostor je konečný, ale text se mění“**: oříznout (limit · ořez), zmenšit (škálování), rezervovat místo (rozsah) nebo nechat lidi vybírat (výběr)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstens essens er, at du ikke kan forudsige, hvor langt indholdet bliver. Alle fem tilfælde er forskellige svar på et enkelt problem, **»pladsen er begrænset, men tekst varierer«**: skær den af (grænse · afkortning), skrump den (skalér), reserver plads til den (interval) eller lad folk markere den (markering)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ουσία του κειμένου είναι ότι δεν μπορείς να προβλέψεις πόσο μακρύ θα είναι το περιεχόμενο. Και οι πέντε περιπτώσεις είναι διαφορετικές απαντήσεις σε ένα πρόβλημα, **«ο χώρος είναι πεπερασμένος, αλλά το κείμενο ποικίλλει»**: κόψ' το (όριο · περικοπή), σμίκρυνέ το (κλίμακα), δέσμευσε χώρο (εύρος), ή άσε τους ανθρώπους να το επιλέξουν (επιλογή)."
          }
        }
      }
    },
    "텍스트만으로 부족한 **브랜드/맥락 표현**이 필요할 때, 앱 홈의 로고, 프로필 화면의 아바타+이름, 날짜 강조가 필요한 저널 등.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you need **brand or context** that text alone can't convey: a logo on the app's home, an avatar + name on a profile screen, a journal that needs to emphasize the date, and so on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you need **brand or context** that text alone can't convey: a logo on the app's home, an avatar + name on a profile screen, a journal that needs to emphasise the date, and so on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストだけでは足りない**ブランドや文脈の表現**が必要なとき。アプリのホームのロゴ、プロフィール画面のアバター + 名前、日付を強調したいジャーナルなど。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只靠文字不够、需要**品牌/语境表达**时：应用首页的标志、个人资料界面的头像 + 名字、需要突出日期的日记等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只靠文字不夠、需要**品牌/語境表達**時：應用程式首頁的標誌、個人資料介面的頭像 + 名字、需要突出日期的日記等。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда нужны **бренд или контекст**, которые одним текстом не передать: логотип на главной приложения, аватар + имя на экране профиля, дневник, где нужно выделить дату, и так далее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando necesitas **marca o contexto** que el texto solo no puede transmitir: un logotipo en el inicio de la app, un avatar + nombre en una pantalla de perfil, un diario que necesita enfatizar la fecha, etc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du **Marke oder Kontext** brauchst, den Text allein nicht vermitteln kann: ein Logo auf dem Start der App, ein Avatar + Name auf einem Profilbildschirm, ein Tagebuch, das das Datum betonen muss, und so weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous avez besoin de **marque ou de contexte** que le texte seul ne peut transmettre : un logo sur l'accueil de l'app, un avatar + nom sur un écran de profil, un journal qui doit mettre la date en valeur, et ainsi de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ti serve **marchio o contesto** che il solo testo non può trasmettere: un logo nella home dell'app, un avatar + nome in una schermata di profilo, un diario che deve enfatizzare la data e così via."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você precisa de **marca ou contexto** que só o texto não transmite: um logo na tela inicial do app, um avatar + nome numa tela de perfil, um diário que precisa enfatizar a data e assim por diante."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อต้องการ**แบรนด์หรือบริบท**ที่ข้อความอย่างเดียวสื่อไม่ได้: โลโก้บนหน้าแรกของแอป อวาตาร์ + ชื่อบนหน้าจอโปรไฟล์ บันทึกประจำวันที่ต้องเน้นวันที่ และอื่น ๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn cần **thương hiệu hoặc bối cảnh** mà riêng văn bản không truyền đạt được: logo ở trang chủ app, avatar + tên trên màn hình hồ sơ, nhật ký cần nhấn mạnh ngày, v.v."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když potřebujete **značku nebo kontext**, který samotný text nesdělí: logo na domovské obrazovce aplikace, avatar + jméno na obrazovce profilu, deník, který potřebuje zdůraznit datum, a podobně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har brug for **brand eller kontekst**, som tekst alene ikke kan formidle: et logo på appens hjemmeskærm, en avatar + navn på en profilskærm, en journal, der skal fremhæve datoen, og så videre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν χρειάζεσαι **brand ή πλαίσιο** που το κείμενο μόνο του δεν μεταφέρει: ένα λογότυπο στην αρχική της εφαρμογής, ένα avatar + όνομα σε οθόνη προφίλ, ένα ημερολόγιο που πρέπει να τονίζει την ημερομηνία κ.ο.κ."
          }
        }
      }
    },
    "텍스트에 규칙을 붙이기 전에 그것이 문장인지 값인지 먼저 분류한다. 일관성은 같은 종류끼리의 것이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before attaching a rule to text, first classify it as a sentence or a value. Consistency applies within the same kind."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before attaching a rule to text, first classify it as a sentence or a value. Consistency applies within the same kind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストにルールを付ける前に、それが文か値かをまず分類する。一貫性は同じ種類どうしのものだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给文本加规则之前，先分类它是句子还是数值。一致性是同类之间的一致性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給文字加規則之前，先分類它是句子還是數值。一致性是同類之間的一致性。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем применять к тексту правило, сначала отнесите его к предложению или значению. Единообразие действует внутри одного рода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de aplicar una regla a un texto, clasifícalo primero como frase o como valor. La coherencia se aplica dentro del mismo tipo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du eine Regel an Text hängst, ordne ihn zuerst als Satz oder Wert ein. Konsistenz gilt innerhalb derselben Art."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'attacher une règle à un texte, classez-le d'abord comme phrase ou valeur. La cohérence s'applique au sein d'un même type."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di applicare una regola al testo, classificalo come frase o come valore. La coerenza vale all'interno dello stesso tipo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de aplicar uma regra ao texto, classifique-o primeiro como frase ou valor. A consistência vale dentro do mesmo tipo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนผูกกฎกับข้อความ ให้จัดประเภทมันเป็นประโยคหรือค่าก่อน ความสอดคล้องใช้ภายในชนิดเดียวกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi gắn một quy tắc cho văn bản, trước hết hãy phân loại nó là câu hay giá trị. Nhất quán áp dụng trong cùng một loại."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než k textu připojíte pravidlo, nejdřív ho zařaďte jako větu, nebo hodnotu. Konzistence platí v rámci stejného druhu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du knytter en regel til tekst, så klassificér den først som en sætning eller en værdi. Ensartethed gælder inden for samme slags."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν συνδέσεις έναν κανόνα με κείμενο, κατάταξέ το πρώτα ως πρόταση ή τιμή. Η συνέπεια ισχύει μέσα στο ίδιο είδος."
          }
        }
      }
    },
    "통화 중·녹음 중 상태 바": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An \"on a call\" or \"recording\" status bar"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An \"on a call\" or \"recording\" status bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話中・録音中のステータスバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话中 · 录音中状态栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通話中 · 錄音中狀態列"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка состояния «идёт звонок» или «идёт запись»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra de estado de «en llamada» o «grabando»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Statusleiste „im Gespräch“ oder „Aufnahme“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre d'état « en appel » ou « enregistrement »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra di stato «in chiamata» o «registrazione in corso»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra de status «em chamada» ou «gravando»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบสถานะ \"กำลังโทร\" หรือ \"กำลังบันทึก\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thanh trạng thái \"đang gọi\" hoặc \"đang ghi\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavový panel „probíhá hovor“ nebo „nahrávání“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En statusbjælke »i samtale« eller »optager«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γραμμή κατάστασης «σε κλήση» ή «ηχογράφηση»"
          }
        }
      }
    },
    "투명함과 읽힘이 충돌하면 읽힘이 이긴다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When transparency and readability collide, readability wins"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When transparency and readability collide, readability wins"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "透明感と読みやすさがぶつかったら、読みやすさが勝つ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通透和可读性冲突时，可读性获胜"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通透和可讀性衝突時，可讀性獲勝"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда прозрачность и читаемость сталкиваются, побеждает читаемость"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando chocan transparencia y legibilidad, gana la legibilidad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kollidieren Transparenz und Lesbarkeit, gewinnt die Lesbarkeit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand transparence et lisibilité s'opposent, la lisibilité l'emporte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando trasparenza e leggibilità si scontrano, vince la leggibilità"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando transparência e legibilidade colidem, vence a legibilidade"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อความโปร่งใสชนกับความอ่านออก ความอ่านออกชนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi độ trong suốt và khả năng đọc va nhau, khả năng đọc thắng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se střetnou průhlednost a čitelnost, vítězí čitelnost"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når gennemsigtighed og læselighed støder sammen, vinder læseligheden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν η διαφάνεια και η αναγνωσιμότητα συγκρούονται, κερδίζει η αναγνωσιμότητα"
          }
        }
      }
    },
    "툴바 배열을 적을 때 순서를 한 번 더 본다. 그 순서가 \"좁아지면 무엇을 포기할 것인가\"에 대한 답이기 때문이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you write out a toolbar's items, look at the order once more. That order is your answer to \"what do we give up when space gets tight?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you write out a toolbar's items, look at the order once more. That order is your answer to \"what do we give up when space gets tight?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーの並びを書くとき、順番をもう一度見る。その順番が「狭くなったら何をあきらめるか」への答えだからだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写工具栏排列时，把顺序再看一遍。因为那个顺序就是对“窄了以后放弃什么”的回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫工具列排列時，把順序再看一遍。因為那個順序就是對「窄了以後放棄什麼」的回答。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывая элементы панели инструментов, ещё раз взгляните на порядок. Этот порядок - ваш ответ на вопрос «чем мы жертвуем, когда места не хватает?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando escribas los elementos de una barra de herramientas, mira el orden una vez más. Ese orden es tu respuesta a «¿a qué renunciamos cuando falta espacio?»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Elemente einer Symbolleiste aufschreibst, sieh dir die Reihenfolge noch einmal an. Diese Reihenfolge ist deine Antwort auf „Was geben wir auf, wenn der Platz knapp wird?“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous écrivez les éléments d'une barre d'outils, regardez l'ordre une fois de plus. Cet ordre est votre réponse à « à quoi renonçons-nous quand la place manque ? »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando scrivi gli elementi di una barra degli strumenti, guarda ancora una volta l'ordine. Quell'ordine è la tua risposta a «a che cosa rinunciamo quando lo spazio scarseggia?»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você escreve os itens de uma barra de ferramentas, olhe a ordem mais uma vez. Essa ordem é a sua resposta a «a que renunciamos quando o espaço aperta?»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเขียนรายการของแถบเครื่องมือ ให้ดูลำดับอีกครั้ง ลำดับนั้นคือคำตอบของคุณต่อ \"เราสละอะไรเมื่อพื้นที่ตึง\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn viết các mục thanh công cụ, hãy nhìn lại thứ tự thêm một lần. Thứ tự đó là câu trả lời của bạn cho \"ta bỏ gì khi chỗ chật?\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když vypisujete položky panelu nástrojů, podívejte se ještě jednou na pořadí. To pořadí je vaše odpověď na „čeho se vzdáme, když dojde místo?“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du skriver en værktøjslinjes elementer ud, så se på rækkefølgen en gang til. Den rækkefølge er dit svar på »hvad opgiver vi, når pladsen bliver trang?«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν γράφεις τα στοιχεία μιας γραμμής εργαλείων, κοίτα άλλη μία φορά τη σειρά. Αυτή η σειρά είναι η απάντησή σου στο «τι θυσιάζουμε όταν στενεύει ο χώρος;»"
          }
        }
      }
    },
    "툴바 아이템 + 커스텀 바로 하단이 두 층이 되면 무겁습니다, 한 층으로 합칠 수 있는지 먼저 검토하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolbar items plus a custom bar turn the bottom into two layers, which feels heavy. First see whether you can merge them into one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolbar items plus a custom bar turn the bottom into two layers, which feels heavy. First see whether you can merge them into one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバー項目＋カスタムバーで下部が2層になると重くなります。まず1層にまとめられないか検討してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏项目 + 自定义栏使底部变成两层会很沉重，请先考虑能否合成一层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列項目 + 自定義列使底部變成兩層會很沉重，請先考慮能否合成一層。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы панели инструментов плюс пользовательская панель превращают низ в два слоя, и он кажется тяжёлым. Сначала посмотрите, нельзя ли слить их в один."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de la barra de herramientas más una barra personalizada convierten la parte inferior en dos capas, lo que se siente pesado. Mira primero si puedes fundirlos en una."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbolleistenelemente plus eine eigene Leiste machen den unteren Rand zu zwei Ebenen, was schwer wirkt. Prüfe zuerst, ob du sie zu einer zusammenführen kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des éléments de barre d'outils plus une barre personnalisée font du bas deux couches, ce qui paraît lourd. Voyez d'abord si vous pouvez les fusionner en une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementi della barra degli strumenti più una barra personalizzata trasformano il basso in due strati, il che sembra pesante. Guarda prima se puoi fonderli in uno solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens da barra de ferramentas mais uma barra personalizada transformam a parte de baixo em duas camadas, o que parece pesado. Veja primeiro se dá para fundi-los em uma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการแถบเครื่องมือบวกแถบที่กำหนดเองทำให้ด้านล่างเป็นสองชั้น ซึ่งรู้สึกหนัก ดูก่อนว่ารวมเป็นหนึ่งได้ไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục thanh công cụ cộng thanh tùy chỉnh biến phần dưới thành hai lớp, cảm thấy nặng nề. Hãy xem trước có gộp được thành một không."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky panelu nástrojů plus vlastní panel dělají ze spodku dvě vrstvy, což působí těžce. Nejdřív zkuste, zda je nejde sloučit do jedné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værktøjslinjeelementer plus en brugerdefineret bjælke gør bunden til to lag, hvilket føles tungt. Se først, om du kan slå dem sammen til ét."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στοιχεία γραμμής εργαλείων συν προσαρμοσμένη γραμμή κάνουν το κάτω μέρος δύο στρώματα, κάτι που φαίνεται βαρύ. Δες πρώτα αν μπορείς να τα συγχωνεύσεις σε ένα."
          }
        }
      }
    },
    "툴바 아이템을 코드에 적을 때 만든 순서대로 적는다. 먼저 만든 기능이 앞에, 나중에 붙인 기능이 뒤에 온다. 우선순위를 따로 정한다는 생각은 들지 않는다. 개발하는 기기에서는 다 보이니 문제가 드러나지도 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When writing toolbar items in code, you write them in the order you built them. Features built first go first, features added later go last. It never occurs to you to set priorities separately. And since everything is visible on your development device, the problem never shows up."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When writing toolbar items in code, you write them in the order you built them. Features built first go first, features added later go last. It never occurs to you to set priorities separately. And since everything is visible on your development device, the problem never shows up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーのアイテムをコードに書くとき、作った順に書く。先に作った機能が前に、あとから足した機能が後ろに来る。優先順位を別に決めるという考えは浮かばない。開発しているデバイスでは全部見えるので、問題が表に出ることもない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把工具栏项目写进代码时，按做出来的顺序写。先做的功能在前，后加的功能在后。想不到另外定优先级。在开发用的设备上全都看得见，问题也暴露不出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把工具列項目寫進程式碼時，按做出來的順序寫。先做的功能在前，後加的功能在後。想不到另外定優先順序。在開發用的裝置上全都看得見，問題也暴露不出來。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывая элементы панели инструментов в коде, вы пишете их в том порядке, в каком строили. Функции, построенные первыми, идут первыми, добавленные позже идут последними. Вам и в голову не приходит отдельно задавать приоритеты. А поскольку на вашем устройстве разработки всё видно, проблема никогда не проявляется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al escribir elementos de la barra de herramientas en el código, los escribes en el orden en que los construiste. Las funciones construidas primero van primero, las añadidas más tarde van al final. Nunca se te ocurre fijar prioridades aparte. Y como todo se ve en tu dispositivo de desarrollo, el problema nunca aparece."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Schreiben von Symbolleistenelementen im Code schreibst du sie in der Reihenfolge, in der du sie gebaut hast. Zuerst gebaute Funktionen kommen zuerst, später hinzugefügte zuletzt. Es kommt dir nie in den Sinn, Prioritäten gesondert festzulegen. Und da auf deinem Entwicklungsgerät alles sichtbar ist, zeigt sich das Problem nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En écrivant les éléments d'une barre d'outils dans le code, vous les écrivez dans l'ordre où vous les avez construits. Les fonctions construites d'abord vont en premier, celles ajoutées plus tard en dernier. Il ne vous vient jamais à l'esprit de fixer les priorités séparément. Et comme tout est visible sur votre appareil de développement, le problème n'apparaît jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando scrivi nel codice gli elementi della barra degli strumenti, li scrivi nell'ordine in cui li hai costruiti. Le funzioni costruite per prime vanno per prime, quelle aggiunte dopo per ultime. Non ti viene mai in mente di fissare separatamente le priorità. E poiché tutto è visibile sul tuo dispositivo di sviluppo, il problema non si presenta mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao escrever no código os itens da barra de ferramentas, você os escreve na ordem em que os construiu. As funcionalidades construídas primeiro vão primeiro, as acrescentadas depois vão por último. Nunca lhe ocorre definir as prioridades à parte. E como tudo está visível no seu dispositivo de desenvolvimento, o problema nunca aparece."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเขียนรายการแถบเครื่องมือในโค้ด คุณเขียนตามลำดับที่สร้าง ฟีเจอร์ที่สร้างก่อนไปก่อน ฟีเจอร์ที่เพิ่มทีหลังไปท้าย ไม่เคยนึกถึงการตั้งลำดับความสำคัญแยกต่างหาก และเมื่อทุกอย่างมองเห็นบนอุปกรณ์พัฒนา ปัญหาก็ไม่เคยโผล่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi viết các mục thanh công cụ trong mã, bạn viết theo thứ tự mình dựng. Tính năng dựng trước đi trước, tính năng thêm sau đi sau. Bạn chưa bao giờ nghĩ đặt ưu tiên riêng. Và vì mọi thứ đều thấy trên thiết bị phát triển, vấn đề không bao giờ lộ ra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když píšete položky panelu nástrojů v kódu, píšete je v pořadí, v jakém jste je stavěli. Funkce postavené první jdou první, funkce přidané později poslední. Nikdy vás nenapadne nastavit priority zvlášť. A protože na vývojovém zařízení je vidět všechno, problém se nikdy neukáže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du skriver værktøjslinjeelementer i kode, skriver du dem i den rækkefølge, du byggede dem. Funktioner bygget først kommer først, funktioner tilføjet senere kommer sidst. Det falder dig aldrig ind at sætte prioriteter separat. Og da alt er synligt på din udviklingsenhed, viser problemet sig aldrig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν γράφεις στοιχεία γραμμής εργαλείων σε κώδικα, τα γράφεις με τη σειρά που τα έφτιαξες. Οι λειτουργίες που φτιάχτηκαν πρώτες πάνε πρώτες, οι προστιθέμενες αργότερα πάνε τελευταίες. Δεν περνά ποτέ από το μυαλό σου να ορίσεις προτεραιότητες ξεχωριστά. Και αφού όλα φαίνονται στη συσκευή ανάπτυξης, το πρόβλημα δεν εμφανίζεται ποτέ."
          }
        }
      }
    },
    "툴바 아이템이 셋이다. 셋을 한 그룹으로 묶으면 캡슐 하나로 깔끔하게 떨어지고 좌우 균형도 맞는다. 어차피 같은 화면의 툴바 안이니 한 덩어리로 정리하는 게 정돈된 설계처럼 보인다. 시안으로 보면 실제로 보기에도 좋다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are three toolbar items. Group them and they fall neatly into one capsule, balanced left and right. They're in the same screen's toolbar anyway, so tidying them into one group looks like orderly design. In the mockup, it actually looks good, too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There are three toolbar items. Group them and they fall neatly into one capsule, balanced left and right. They're in the same screen's toolbar anyway, so tidying them into one group looks like orderly design. In the mockup, it actually looks good, too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーのアイテムは3つ。ひとつのグループにまとめればカプセルひとつにきれいに収まり、左右のバランスも取れる。どうせ同じ画面のツールバーの中なのだから、ひとまとめにするのが整った設計に見える。デザイン案で見ると、実際に見た目もいい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏项目有三个。把三个归成一组，一个胶囊干净利落，左右也平衡。反正都在同一个界面的工具栏里，归成一块看起来像是整齐的设计。看设计稿，实际看起来也不错。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列項目有三個。把三個歸成一組，一個膠囊乾淨利落，左右也平衡。反正都在同一個介面的工具列裡，歸成一塊看起來像是整齊的設計。看設計稿，實際看起來也不錯。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На панели инструментов три элемента. Сгруппируйте их, и они аккуратно уложатся в одну капсулу, сбалансированную слева и справа. Они всё равно на панели инструментов одного экрана, так что собрать их в группу выглядит упорядоченным дизайном. В макете это и правда выглядит хорошо."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay tres elementos en la barra de herramientas. Agrúpalos y caben limpiamente en una cápsula, equilibrados a izquierda y derecha. De todos modos están en la barra de herramientas de la misma pantalla, así que ordenarlos en un grupo parece un diseño ordenado. En la maqueta, de hecho, también se ve bien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt drei Symbolleistenelemente. Gruppiert man sie, fallen sie sauber in eine Kapsel, links und rechts ausgewogen. Sie sind ohnehin in der Symbolleiste desselben Bildschirms, also wirkt das Aufräumen in eine Gruppe wie ein geordnetes Design. Im Mockup sieht es tatsächlich auch gut aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a trois éléments de barre d'outils. Regroupez-les et ils tombent proprement dans une capsule, équilibrés à gauche et à droite. Ils sont de toute façon dans la barre d'outils du même écran, donc les ranger en un groupe paraît un design ordonné. Dans la maquette, cela rend aussi bien en effet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono tre elementi nella barra degli strumenti. Raggruppali e finiscono ordinatamente in una capsula, bilanciati a sinistra e a destra. Sono comunque nella barra degli strumenti della stessa schermata, quindi riordinarli in un gruppo sembra un design ordinato. Nel mockup, in effetti, sta bene anche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há três itens na barra de ferramentas. Agrupe-os e eles caem direitinho numa cápsula, equilibrados à esquerda e à direita. Estão de qualquer jeito na barra de ferramentas da mesma tela, então arrumá-los num grupo parece um design ordenado. No mockup, de fato, também fica bonito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีรายการแถบเครื่องมือสามรายการ จัดกลุ่มแล้วลงตัวในแคปซูลเดียว สมดุลซ้ายขวา อยู่ในแถบเครื่องมือของหน้าจอเดียวกันอยู่แล้ว การจัดเป็นกลุ่มเดียวจึงดูเหมือนการออกแบบที่เป็นระเบียบ ในม็อกอัปมันดูดีจริงด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có ba mục thanh công cụ. Gom lại thì chúng gọn vào một capsule, cân trái phải. Dù sao chúng cũng ở cùng thanh công cụ của màn hình, nên dọn vào một nhóm trông như thiết kế ngăn nắp. Trong mockup, thực sự trông cũng đẹp."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsou tři položky panelu nástrojů. Seskupte je a úhledně zapadnou do jedné kapsle, vyvážené vlevo a vpravo. Stejně jsou v panelu nástrojů téže obrazovky, takže jejich uklizení do jedné skupiny vypadá jako uspořádaný design. V mockupu to skutečně vypadá také dobře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er tre værktøjslinjeelementer. Grupper dem, og de falder pænt ind i én kapsel, balanceret til venstre og højre. De er alligevel i samme skærms værktøjslinje, så at rydde dem op i én gruppe ser ud som ordentligt design. I mockuppet ser det faktisk også godt ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχουν τρία στοιχεία γραμμής εργαλείων. Ομαδοποίησέ τα και χωρούν ωραία σε μία κάψουλα, ισορροπημένα αριστερά και δεξιά. Βρίσκονται στη γραμμή εργαλείων της ίδιας οθόνης έτσι κι αλλιώς, οπότε το να τα τακτοποιήσεις σε μία ομάδα μοιάζει με τακτικό σχεδιασμό. Στο mockup, μάλιστα, φαίνεται και καλό."
          }
        }
      }
    },
    "툴바가 휑하면 미완성처럼 보인다. 공유·별표처럼 '있으면 좋은' 것을 넣어 균형을 맞추고 싶어진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sparse toolbar looks unfinished. You're tempted to balance it out with nice-to-haves like Share or Favorite."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sparse toolbar looks unfinished. You're tempted to balance it out with nice-to-haves like Share or Favourite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーがスカスカだと未完成に見える。共有やスターのような「あると便利」なものを入れて、バランスを取りたくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏空荡荡的，看起来像没做完。想放点分享 · 星标这类“有了更好”的东西来求平衡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列空蕩蕩的，看起來像沒做完。想放點分享 · 星標這類「有了更好」的東西來求平衡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разреженная панель инструментов выглядит незаконченной. Хочется уравновесить её чем-то «было бы неплохо» вроде «Поделиться» или «В избранное»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra de herramientas escasa parece inacabada. Te tienta equilibrarla con cosas que estaría bien tener, como Compartir o Favorito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine spärliche Symbolleiste wirkt unfertig. Du bist versucht, sie mit Nice-to-haves wie Teilen oder Favorit auszugleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre d'outils clairsemée paraît inachevée. Vous êtes tenté de l'équilibrer avec des « agréable à avoir » comme Partager ou Favori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra degli strumenti rada sembra non finita. Sei tentato di bilanciarla con cose utili da avere come Condividi o Preferito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra de ferramentas rala parece inacabada. Você é tentado a equilibrá-la com extras agradáveis como Compartilhar ou Favorito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบเครื่องมือที่โล่งดูไม่เสร็จ คุณถูกล่อให้ถ่วงสมดุลด้วยสิ่งที่มีก็ดีอย่างแชร์หรือรายการโปรด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh công cụ thưa trông chưa xong. Bạn bị cám dỗ cân bằng nó bằng những thứ \"có thì tốt\" như Chia sẻ hay Yêu thích."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řídký panel nástrojů vypadá nedokončeně. Lákáte se vyvážit ho příjemnostmi jako Sdílet nebo Oblíbené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tynd værktøjslinje ser uafsluttet ud. Du er fristet til at balancere den med rare-at-have-ting som Del eller Favorit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια αραιή γραμμή εργαλείων φαίνεται ημιτελής. Σε δελεάζει να την ισορροπήσεις με «ωραία να υπάρχουν» όπως η Κοινοποίηση ή το Αγαπημένο."
          }
        }
      }
    },
    "툴바를 hard 경계에 불투명에 가까운 두꺼운 material 배경을 더한 구성으로 바꾼다. 사진이 비치는 느낌은 줄지만, 버튼 글자는 어떤 사진 위에서도 같은 대비를 갖는다. 이 구성은 사진 그리드나 지도처럼 복잡한 배경이 늘 지나가는 화면의 것이다. 단순한 흰 배경 목록까지 두껍게 하면 과잉 방어로 답답해지니, 배경이 복잡한 화면에만 건다. 1.3.3 예제를 열어 투명한 바와 비교해 보면 무엇을 포기하고 무엇을 얻는지 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the toolbar to a hard boundary plus a thick, nearly opaque material background. The feeling of photos showing through is reduced, but the button labels keep the same contrast over any photo. This setup belongs on screens where busy backgrounds are always passing by, like photo grids or maps. Making a simple white-background list just as thick is overdefense and feels heavy, so apply it only to screens with busy backgrounds. Open the 1.3.3 example and compare it with the transparent bar to see what you give up and what you gain."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the toolbar to a hard boundary plus a thick, nearly opaque material background. The feeling of photos showing through is reduced, but the button labels keep the same contrast over any photo. This setup belongs on screens where busy backgrounds are always passing by, like photo grids or maps. Making a simple white-background list just as thick is overdefense and feels heavy, so apply it only to screens with busy backgrounds. Open the 1.3.3 example and compare it with the transparent bar to see what you give up and what you gain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーを、hard の境界に不透明に近い厚い material の背景を加えた構成に変える。写真が透ける感じは減るが、ボタンの文字はどんな写真の上でも同じコントラストを保つ。この構成は、写真のグリッドや地図のように複雑な背景が常に通る画面のためのものだ。シンプルな白背景のリストまで厚くすると守りすぎで重苦しくなるので、背景が複雑な画面にだけ適用する。1.3.3 の例を開いて透明なバーと比べてみると、何を手放して何を得るのかが見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把工具栏改成 hard 边界加接近不透明的厚 material 背景的配置。照片透出的感觉减少了，但按钮文字在任何照片上都有相同的对比度。这个配置属于照片网格、地图这类复杂背景始终经过的界面。连简单的白色背景列表也做厚，防御过度会让人憋闷，所以只用在背景复杂的界面。打开 1.3.3 示例与透明的栏比较，就能看到放弃了什么、得到了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把工具列改成 hard 邊界加接近不透明的厚 material 背景的配置。照片透出的感覺減少了，但按鈕文字在任何照片上都有相同的對比度。這個配置屬於照片網格、地圖這類複雜背景始終經過的介面。連簡單的白色背景列表也做厚，防禦過度會讓人憋悶，所以只用在背景複雜的介面。開啟 1.3.3 示例與透明的列比較，就能看到放棄了什麼、得到了什麼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключите панель инструментов на жёсткую границу плюс толстый почти непрозрачный фон из материала. Ощущение просвечивающих фото уменьшается, но подписи кнопок сохраняют одинаковый контраст на любом фото. Такая конфигурация нужна экранам, где всегда проходит пёстрый фон, вроде сеток фото или карт. Делать простой список на белом фоне такой же толстой - излишняя оборона, она ощущается тяжело, поэтому применяйте её только к экранам с пёстрым фоном. Откройте пример 1.3.3 и сравните с прозрачной панелью, чтобы увидеть, чем жертвуете и что получаете."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la barra de herramientas a un límite hard más un fondo de material grueso y casi opaco. La sensación de fotos que se transparentan se reduce, pero las etiquetas de los botones mantienen el mismo contraste sobre cualquier foto. Esta configuración pertenece a pantallas por las que pasan siempre fondos cargados, como cuadrículas de fotos o mapas. Hacer igual de gruesa una lista sencilla de fondo blanco es sobredefensa y se siente pesado, así que aplícalo solo a pantallas con fondos cargados. Abre el ejemplo 1.3.3 y compáralo con la barra transparente para ver a qué renuncias y qué ganas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle die Symbolleiste auf eine harte Grenze plus einen Hintergrund aus dickem, nahezu undurchsichtigem Material um. Das Gefühl durchscheinender Fotos wird geringer, aber die Button-Beschriftungen behalten über jedem Foto denselben Kontrast. Diese Konfiguration gehört auf Bildschirme, an denen ständig unruhige Hintergründe vorbeiziehen, wie Fotoraster oder Karten. Eine schlichte Liste mit weißem Hintergrund ebenso dick zu machen, ist Überverteidigung und wirkt schwer, also wende es nur auf Bildschirme mit unruhigen Hintergründen an. Öffne das Beispiel 1.3.3 und vergleiche es mit der transparenten Leiste, um zu sehen, worauf du verzichtest und was du gewinnst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez la barre d'outils à une limite hard plus un fond en matériau épais, presque opaque. L'impression de photos qui transparaissent est réduite, mais les libellés des boutons gardent le même contraste sur n'importe quelle photo. Cette configuration convient aux écrans où des arrière-plans chargés passent en permanence, comme les grilles de photos ou les cartes. Rendre une simple liste à fond blanc tout aussi épaisse est une surprotection et paraît lourd, donc ne l'appliquez qu'aux écrans à arrière-plans chargés. Ouvrez l'exemple 1.3.3 et comparez-le avec la barre transparente pour voir à quoi vous renoncez et ce que vous gagnez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la barra degli strumenti in un confine hard più uno sfondo in materiale spesso e quasi opaco. La sensazione delle foto che traspaiono si riduce, ma le etichette dei pulsanti mantengono lo stesso contrasto su qualsiasi foto. Questa configurazione appartiene alle schermate in cui passano sempre sfondi carichi, come le griglie di foto o le mappe. Rendere altrettanto spesso un semplice elenco su sfondo bianco è una difesa eccessiva e sembra pesante, quindi applicala solo alle schermate con sfondi carichi. Apri l'esempio 1.3.3 e confrontalo con la barra trasparente per vedere a che cosa rinunci e che cosa guadagni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude a barra de ferramentas para uma fronteira hard mais um fundo em material grosso e quase opaco. A sensação das fotos transparecendo diminui, mas os rótulos dos botões mantêm o mesmo contraste sobre qualquer foto. Esta configuração pertence a telas por onde passam sempre fundos carregados, como grades de fotos ou mapas. Deixar tão grossa uma simples lista de fundo branco é defesa excessiva e parece pesado, então aplique só a telas com fundos carregados. Abra o exemplo 1.3.3 e compare com a barra transparente para ver o que você cede e o que ganha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนแถบเครื่องมือเป็นขอบเขต hard บวกพื้นหลังวัสดุหนาทึบเกือบสมบูรณ์ ความรู้สึกที่รูปถ่ายมองทะลุลดลง แต่ป้ายปุ่มคงความตัดกันเท่าเดิมเหนือรูปถ่ายใด ๆ การตั้งค่านี้เหมาะกับหน้าจอที่พื้นหลังวุ่นวายผ่านตลอด เช่นกริดรูปถ่ายหรือแผนที่ การทำรายการพื้นขาวธรรมดาให้หนาเท่ากันเป็นการป้องกันเกินและรู้สึกหนัก จึงใช้เฉพาะหน้าจอที่พื้นหลังวุ่นวาย เปิดตัวอย่าง 1.3.3 แล้วเทียบกับแถบโปร่งใส เพื่อดูว่าคุณสละอะไรและได้อะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi thanh công cụ sang ranh giới hard cộng nền vật liệu dày, gần như đặc. Cảm giác ảnh lộ qua giảm đi, nhưng nhãn nút giữ cùng độ tương phản trên mọi ảnh. Thiết lập này thuộc về màn hình luôn có nền rối đi qua, như lưới ảnh hay bản đồ. Làm dày như vậy cho danh sách nền trắng đơn giản là phòng thủ quá mức và nặng nề, nên chỉ áp cho màn hình có nền rối. Mở ví dụ 1.3.3 và so với thanh trong suốt để xem bạn bỏ gì và được gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změňte panel nástrojů na tvrdou hranici plus tlusté, téměř neprůhledné materiálové pozadí. Pocit prosvítajících fotek se sníží, ale popisky tlačítek drží stejný kontrast nad jakoukoli fotkou. Toto nastavení patří na obrazovky, kde pořád procházejí rušná pozadí, jako mřížky fotek nebo mapy. Dělat jednoduchý seznam s bílým pozadím stejně tlustý je přehnaná obrana a působí těžce, takže ho aplikujte jen na obrazovky s rušným pozadím. Otevřete příklad 1.3.3 a porovnejte s průhledným panelem, abyste viděli, čeho se vzdáváte a co získáváte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift værktøjslinjen til en hård grænse plus en tyk, næsten uigennemsigtig materialebaggrund. Fornemmelsen af, at fotos skinner igennem, mindskes, men knapetiketterne bevarer samme kontrast over ethvert foto. Denne opsætning hører til på skærme, hvor urolige baggrunde hele tiden passerer, som fotogitre eller kort. At gøre en simpel liste med hvid baggrund lige så tyk er overforsvar og føles tungt, så anvend den kun på skærme med urolige baggrunde. Åbn eksempel 1.3.3 og sammenlign med den gennemsigtige bjælke for at se, hvad du opgiver, og hvad du vinder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε τη γραμμή εργαλείων σε hard όριο συν παχύ, σχεδόν αδιαφανές υλικό φόντου. Η αίσθηση των φωτογραφιών που διαφαίνονται μειώνεται, αλλά οι ετικέτες των κουμπιών κρατούν την ίδια αντίθεση πάνω από οποιαδήποτε φωτογραφία. Αυτή η διαμόρφωση ανήκει σε οθόνες όπου περνούν πάντα φορτωμένα φόντα, όπως πλέγματα φωτογραφιών ή χάρτες. Το να κάνεις εξίσου παχιά μια απλή λίστα με λευκό φόντο είναι υπερβολική άμυνα και φαίνεται βαρύ, οπότε εφάρμοσέ το μόνο σε οθόνες με φορτωμένο φόντο. Άνοιξε το παράδειγμα 1.3.3 και σύγκρινέ το με τη διάφανη γραμμή για να δεις τι θυσιάζεις και τι κερδίζεις."
          }
        }
      }
    },
    "특가 탭을 내리고 캠페인은 홈 화면 안의 한 구역으로 옮긴다. 콘텐츠 흐름 안에서 만나는 광고는 광고로 읽히고, 탭바에는 늘 같은 네 목적지가 남는다. 앱의 3.2.3 4 Tabs 예제의 표준 구성과 비교해 보면 어느 칸이 이질적인지 바로 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the Deals tab and move the campaign into a section of the Home screen. Ads encountered within the flow of content read as ads, and the tab bar keeps the same four destinations at all times. Compare it with the standard setup in the app's 3.2.3 4 Tabs example and you'll immediately see which slot doesn't belong."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the Deals tab and move the campaign into a section of the Home screen. Ads encountered within the flow of content read as ads, and the tab bar keeps the same four destinations at all times. Compare it with the standard setup in the app's 3.2.3 4 Tabs example and you'll immediately see which slot doesn't belong."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特価タブを外し、キャンペーンはホーム画面の中の1区画に移す。コンテンツの流れの中で出会う広告は広告として読まれ、タブバーにはいつも同じ4つの目的地が残る。アプリの3.2.3 4 Tabsの例の標準構成と比べてみると、どの枠が異質なのかがすぐにわかる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤下特价标签，把活动移到首页界面里的一个区域。在内容流里遇到的广告会被读成广告，标签栏里留下的始终是同样的四个目的地。与应用的 3.2.3 4 Tabs 示例的标准配置比较，哪一格格格不入一眼就能看出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤下特價標籤，把活動移到首頁介面裡的一個區域。在內容流裡遇到的廣告會被讀成廣告，標籤列裡留下的始終是同樣的四個目的地。與應用程式的 3.2.3 4 Tabs 示例的標準配置比較，哪一格格格不入一眼就能看出。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите вкладку «Акции» и перенесите кампанию в секцию экрана «Главная». Реклама, встреченная в потоке содержимого, читается как реклама, а панель вкладок всегда сохраняет те же четыре пункта назначения. Сравните со стандартной конфигурацией в примере приложения 3.2.3 4 Tabs, и сразу увидите, какой слот лишний."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita la pestaña Ofertas y pasa la campaña a una sección de la pantalla de inicio. Los anuncios que se encuentran dentro del flujo del contenido se leen como anuncios, y la barra de pestañas mantiene siempre los mismos cuatro destinos. Compáralo con la configuración estándar del ejemplo 3.2.3 4 Tabs de la app y verás enseguida qué hueco no pinta nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne den Tab Angebote und verschiebe die Kampagne in einen Abschnitt des Startbildschirms. Anzeigen, denen man im Fluss des Inhalts begegnet, lesen sich als Anzeigen, und die Tab-Leiste behält jederzeit dieselben vier Ziele. Vergleiche mit dem Standard-Setup im Beispiel 3.2.3 4 Tabs der App, und du siehst sofort, welcher Platz nicht dazugehört."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez l'onglet Bons plans et déplacez la campagne dans une section de l'écran d'Accueil. Les publicités rencontrées dans le fil du contenu se lisent comme des publicités, et la barre d'onglets garde en permanence les mêmes quatre destinations. Comparez avec la configuration standard de l'exemple 3.2.3 4 Tabs de l'app et vous verrez aussitôt quel emplacement n'a pas sa place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli la scheda Offerte e sposta la campagna in una sezione della schermata Home. Le pubblicità incontrate nel flusso del contenuto si leggono come pubblicità, e la barra delle schede mantiene sempre le stesse quattro destinazioni. Confrontala con la configurazione standard dell'esempio 3.2.3 4 schede dell'app e vedrai subito quale slot non c'entra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova a aba Ofertas e mova a campanha para uma seção da tela Início. Anúncios encontrados no fluxo do conteúdo são lidos como anúncios, e a barra de abas mantém sempre os mesmos quatro destinos. Compare com a configuração padrão do exemplo 3.2.3 4 abas do app e você verá de imediato qual lugar não pertence."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาแท็บดีลออกและย้ายแคมเปญเข้าส่วนหนึ่งของหน้าจอหน้าแรก โฆษณาที่เจอในกระแสเนื้อหาอ่านเป็นโฆษณา และแถบแท็บคงสี่จุดหมายปลายทางเดิมตลอด เทียบกับการตั้งค่ามาตรฐานในตัวอย่าง 3.2.3 4 Tabs ของแอป แล้วคุณจะเห็นทันทีว่าช่องไหนไม่เข้าพวก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ tab Ưu đãi và chuyển chiến dịch vào một phần của màn hình Trang chủ. Quảng cáo gặp trong dòng nội dung đọc ra là quảng cáo, và thanh tab luôn giữ cùng bốn điểm đến. So với thiết lập chuẩn trong ví dụ 3.2.3 4 Tabs của app, bạn sẽ thấy ngay ô nào không thuộc về đây."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeberte kartu Nabídky a přesuňte kampaň do sekce na obrazovce Domů. Reklamy, na které narazíte v toku obsahu, se čtou jako reklamy a panel karet drží vždy stejné čtyři cíle. Porovnejte se standardním nastavením v příkladu 3.2.3 4 Tabs aplikace a hned uvidíte, který slot nepatří."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern fanen Tilbud, og flyt kampagnen ind i en sektion af Hjem-skærmen. Reklamer, man støder på i indholdets flow, læses som reklamer, og fanelinjen beholder de samme fire destinationer hele tiden. Sammenlign med standardopsætningen i appens eksempel 3.2.3 4 faner, og du ser straks, hvilken plads der ikke hører hjemme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεσε την καρτέλα Προσφορές και μετάφερε την καμπάνια σε ενότητα της Αρχικής οθόνης. Οι διαφημίσεις που συναντάς μέσα στη ροή περιεχομένου διαβάζονται ως διαφημίσεις, και η γραμμή καρτελών κρατά πάντα τους ίδιους τέσσερις προορισμούς. Σύγκρινέ το με την τυπική διαμόρφωση στο παράδειγμα 3.2.3 4 Καρτέλες της εφαρμογής και θα δεις αμέσως ποια θέση δεν ανήκει."
          }
        }
      }
    },
    "팀별로 화면을 나눠 만들다 보니 조직 그대로 탭이 생긴다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each team built its own screens, so the tabs ended up mirroring the organization."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Each team built its own screens, so the tabs ended up mirroring the organisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームごとに画面を分けて作っているうちに、組織そのままにタブができる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按团队分头做界面，组织结构就原样变成了标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按團隊分頭做介面，組織結構就原樣變成了標籤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая команда строила свои экраны, поэтому вкладки в итоге отразили организацию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada equipo construyó sus propias pantallas, así que las pestañas acabaron reflejando la organización."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Team baute seine eigenen Bildschirme, sodass die Tabs am Ende die Organisation spiegelten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque équipe a construit ses propres écrans, si bien que les onglets ont fini par refléter l'organisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni team ha costruito le proprie schermate, quindi le schede hanno finito per rispecchiare l'organizzazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada time construiu as próprias telas, então as abas acabaram espelhando a organização."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละทีมสร้างหน้าจอของตัวเอง แท็บจึงลงเอยสะท้อนองค์กร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi nhóm tự dựng màn hình của mình, nên các tab rốt cuộc phản chiếu tổ chức."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý tým postavil vlastní obrazovky, takže karty nakonec zrcadlí organizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert team byggede sine egne skærme, så fanerne endte med at spejle organisationen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε ομάδα έφτιαξε τις δικές της οθόνες, οπότε οι καρτέλες κατέληξαν να αντικατοπτρίζουν τον οργανισμό."
          }
        }
      }
    },
    "파괴적 액션은 구분선 아래·맨 끝에 두고 role: .destructive를 준다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put destructive actions below a divider, at the very end, and give them role: .destructive."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put destructive actions below a divider, at the very end, and give them role: .destructive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "破壊的なアクションは区切り線の下、いちばん最後に置き、role: .destructiveを指定する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "破坏性操作放在分隔线下面、最末尾，并设置 role: .destructive。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "破壞性操作放在分隔線下面、最末尾，並設定 role: .destructive。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещайте разрушительные действия под разделителем, в самом конце, и задавайте им role: .destructive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon las acciones destructivas bajo un divisor, al final del todo, y dales role: .destructive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze zerstörerische Aktionen unter einen Divider, ganz ans Ende, und gib ihnen role: .destructive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez les actions destructives sous un séparateur, tout à la fin, et donnez-leur role: .destructive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti le azioni distruttive sotto un divisore, proprio in fondo, e dai loro role: .destructive."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponha as ações destrutivas abaixo de um divisor, bem no fim, e dê a elas role: .destructive."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางการกระทำที่ทำลายข้อมูลใต้เส้นคั่น ท้ายสุด และให้ role: .destructive"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt hành động phá hủy dưới một đường phân cách, ở tận cuối, và gán role: .destructive."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Destruktivní akce dejte pod dělicí čáru, úplně na konec, a dejte jim role: .destructive."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg destruktive handlinger under en skillelinje, helt til sidst, og giv dem role: .destructive."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε τις καταστροφικές ενέργειες κάτω από μια γραμμή διαχωρισμού, στο τέλος, και δώσ' τους role: .destructive."
          }
        }
      }
    },
    "파일 경로는 .middle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle for file paths"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle for file paths"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルパスは.middle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件路径用 .middle"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案路徑用 .middle"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle для путей к файлам"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle para rutas de archivo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle für Dateipfade"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle pour les chemins de fichiers"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle per i percorsi dei file"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle para caminhos de arquivo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle สำหรับพาธไฟล์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle cho đường dẫn tệp"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle pro cesty k souborům"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle til filstier"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": ".middle για διαδρομές αρχείων"
          }
        }
      }
    },
    "파일 경로에서 `.middle`이 잘 통했다. \"긴 텍스트는 가운데를 접는다\"로 일반화하면 이름에도 그대로 옮겨 적게 된다. 한 번 좋았던 설정은 다른 곳에서도 좋아 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` worked well for file paths. Generalize that into \"fold long text in the middle\" and you end up carrying it over to names as well. A setting that worked once looks good everywhere else too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` worked well for file paths. Generalise that into \"fold long text in the middle\" and you end up carrying it over to names as well. A setting that worked once looks good everywhere else too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルパスでは `.middle` がうまくいった。「長いテキストは真ん中を折りたたむ」と一般化すると、名前にもそのまま持ち込むことになる。一度うまくいった設定は、ほかの場所でもよく見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` 在文件路径上很管用。概括成“长文本折叠中间”，就会原样搬到姓名上。一次好用的设置，到别处看起来也好用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` 在檔案路徑上很管用。概括成「長文字摺疊中間」，就會原樣搬到姓名上。一次好用的設定，到別處看起來也好用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` хорошо работал для путей к файлам. Обобщите это до «длинный текст сворачивайте посередине», и вы перенесёте его и на имена. Настройка, сработавшая однажды, кажется хорошей и везде."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` funcionaba bien con las rutas de archivo. Generalízalo a «pliega el texto largo por el medio» y acabas trasladándolo también a los nombres. Un ajuste que funcionó una vez parece bueno en todas partes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` funktionierte bei Dateipfaden gut. Verallgemeinert man das zu „lange Texte in der Mitte falten“, überträgt man es am Ende auch auf Namen. Eine Einstellung, die einmal funktionierte, sieht auch überall sonst gut aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` fonctionnait bien pour les chemins de fichiers. Généralisez cela en « replier au milieu les longs textes » et vous finissez par le reporter aussi sur les noms. Un réglage qui a fonctionné une fois paraît bon partout ailleurs aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` ha funzionato bene per i percorsi dei file. Generalizzalo in «piega il testo lungo nel mezzo» e finisci per portarlo anche ai nomi. Un'impostazione che ha funzionato una volta sembra buona dappertutto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` funcionou bem para caminhos de arquivo. Generalize isso em «dobre o texto longo no meio» e você acaba levando também para nomes. Um ajuste que funcionou uma vez parece bom em todo o resto também."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` ใช้ได้ดีกับพาธไฟล์ ทำให้เป็นสากลว่า \"พับข้อความยาวตรงกลาง\" แล้วคุณลงเอยด้วยการยกไปใช้กับชื่อด้วย การตั้งค่าที่ใช้ได้ครั้งหนึ่งดูดีทุกที่อื่นด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` chạy tốt cho đường dẫn tệp. Khái quát thành \"gập văn bản dài ở giữa\" và bạn mang nó sang cả tên. Một thiết lập từng chạy một lần trông cũng tốt ở mọi nơi khác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` fungovalo dobře pro cesty k souborům. Zobecněte to na „dlouhý text sbalit uprostřed“ a skončíte u přenesení i na jména. Nastavení, které jednou fungovalo, vypadá dobře i všude jinde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "`.middle` virkede godt til filstier. Generalisér det til »fold lang tekst i midten«, og du ender med at overføre det til navne også. En indstilling, der virkede én gang, ser også god ud alle andre steder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το `.middle` δούλεψε καλά για διαδρομές αρχείων. Γενίκευσέ το σε «δίπλωσε το μακρύ κείμενο στη μέση» και καταλήγεις να το μεταφέρεις και στα ονόματα. Μια ρύθμιση που δούλεψε μία φορά φαίνεται καλή και παντού αλλού."
          }
        }
      }
    },
    "파일 목록 화면의 왼쪽 위 캡슐 하나에 보기 전환, 정렬, 삭제가 나란히 들어 있다. 셋 다 같은 크기의 아이콘이고 같은 유리 위에 있다. 정렬을 누르려고 손을 뻗으면 바로 옆이 삭제다. 라벨도 아이콘도 정확한데, 묶음이 셋을 같은 종류의 버튼으로 보이게 만든다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a file list screen, a single capsule at the top left holds view switching, Sort and Delete side by side. All three are icons of the same size on the same glass. Reach for Sort, and Delete is right next to it. The labels and icons are accurate, but the grouping makes all three look like the same kind of button."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On a file list screen, a single capsule at the top left holds view switching, Sort and Delete side by side. All three are icons of the same size on the same glass. Reach for Sort, and Delete is right next to it. The labels and icons are accurate, but the grouping makes all three look like the same kind of button."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル一覧画面の左上のカプセルひとつに、表示切り替え、並べ替え、削除が並んでいる。3つとも同じ大きさのアイコンで、同じガラスの上にある。並べ替えを押そうと手を伸ばすと、すぐ隣が削除だ。ラベルもアイコンも正確なのに、まとまりが3つを同じ種類のボタンに見せてしまう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件列表界面左上角的一个胶囊里，并排放着切换视图、排序、删除。三个图标一样大，在同一块玻璃上。伸手去点排序，旁边就是删除。标签和图标都准确，分组却让三者看起来像同一种按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案列表介面左上角的一個膠囊裡，並排放著切換檢視、排序、刪除。三個圖示一樣大，在同一塊玻璃上。伸手去點排序，旁邊就是刪除。標籤和圖示都準確，分組卻讓三者看起來像同一種按鈕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране списка файлов в одной капсуле вверху слева рядом лежат переключение вида, «Сортировка» и «Удалить». Все три - значки одного размера на одном стекле. Потянулись к «Сортировке», а «Удалить» рядом. Подписи и значки точны, но из-за группировки все три выглядят кнопками одного рода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una pantalla de lista de archivos, una sola cápsula arriba a la izquierda contiene lado a lado el cambio de vista, Ordenar y Eliminar. Los tres son iconos del mismo tamaño sobre el mismo cristal. Alarga la mano hacia Ordenar y Eliminar está justo al lado. Las etiquetas y los iconos son exactos, pero la agrupación hace que los tres parezcan el mismo tipo de botón."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem Dateilisten-Bildschirm hält eine einzelne Kapsel oben links Ansichtswechsel, Sortieren und Löschen nebeneinander. Alle drei sind Symbole gleicher Größe auf demselben Glas. Greift man nach Sortieren, ist Löschen gleich daneben. Beschriftungen und Symbole sind korrekt, aber die Gruppierung lässt alle drei wie dieselbe Art Button aussehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un écran de liste de fichiers, une seule capsule en haut à gauche contient côte à côte le changement d'affichage, Trier et Supprimer. Les trois sont des icônes de même taille sur le même verre. Tendez la main vers Trier, et Supprimer est juste à côté. Les libellés et les icônes sont exacts, mais le regroupement fait paraître les trois comme le même genre de bouton."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una schermata con l'elenco dei file, una sola capsula in alto a sinistra contiene affiancati cambio di vista, Ordina ed Elimina. Tutte e tre sono icone della stessa dimensione sullo stesso vetro. Allunga la mano per Ordina ed Elimina è lì accanto. Le etichette e le icone sono corrette, ma il raggruppamento fa sembrare tutti e tre lo stesso tipo di pulsante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa tela de lista de arquivos, uma única cápsula no canto superior esquerdo guarda lado a lado troca de visualização, Ordenar e Excluir. Os três são ícones do mesmo tamanho sobre o mesmo vidro. Estenda a mão para Ordenar e Excluir está bem ao lado. Os rótulos e os ícones estão corretos, mas o agrupamento faz os três parecerem o mesmo tipo de botão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้ารายการไฟล์ แคปซูลเดียวที่ซ้ายบนถือการสลับมุมมอง เรียงลำดับ และลบเรียงข้างกัน ทั้งสามเป็นไอคอนขนาดเท่ากันบนกระจกเดียวกัน เอื้อมไปเรียงลำดับ ลบก็อยู่ติดกัน ป้ายชื่อและไอคอนถูกต้อง แต่การจัดกลุ่มทำให้ทั้งสามดูเหมือนปุ่มชนิดเดียวกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình danh sách tệp, một capsule duy nhất ở trên bên trái chứa chuyển chế độ xem, Sắp xếp và Xóa cạnh nhau. Cả ba là biểu tượng cùng cỡ trên cùng một lớp kính. Với tới Sắp xếp thì Xóa ngay bên cạnh. Nhãn và biểu tượng đều chính xác, nhưng việc gom nhóm khiến cả ba trông như cùng loại nút."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na obrazovce seznamu souborů drží jediná kapsle vlevo nahoře přepínání zobrazení, Seřadit a Smazat vedle sebe. Všechny tři jsou ikony stejné velikosti na stejném skle. Sáhněte po Seřadit a Smazat je hned vedle. Popisky a ikony jsou přesné, ale seskupení způsobí, že všechny tři vypadají jako stejný druh tlačítka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På en fillisteskærm rummer en enkelt kapsel øverst til venstre visningsskift, Sortér og Slet side om side. Alle tre er ikoner af samme størrelse på samme glas. Ræk ud efter Sortér, og Slet er lige ved siden af. Etiketterne og ikonerne er nøjagtige, men grupperingen får alle tre til at ligne den samme slags knap."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε μια οθόνη λίστας αρχείων, μία κάψουλα πάνω αριστερά κρατά δίπλα-δίπλα εναλλαγή προβολής, Ταξινόμηση και Διαγραφή. Και τα τρία είναι εικονίδια ίδιου μεγέθους στο ίδιο γυαλί. Άπλωσε το χέρι για Ταξινόμηση και η Διαγραφή είναι ακριβώς δίπλα. Οι ετικέτες και τα εικονίδια είναι σωστά, αλλά η ομαδοποίηση κάνει και τα τρία να μοιάζουν με κουμπιά του ίδιου είδους."
          }
        }
      }
    },
    "파일 앱": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files"
          }
        },
        "en-GB": {
