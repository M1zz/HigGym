          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén **+** (nieuw item) op een lijstscherm"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojedynczy **+** (nowy element) na ekranie listy"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
