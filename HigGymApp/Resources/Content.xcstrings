            "value": "ซ้อนด้วย ZStack แทน safeAreaBar ทำให้บรรทัดแรกของเนื้อหาถูกซ่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chồng nó bằng ZStack thay vì safeAreaBar, giấu mất dòng đầu của nội dung"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrstvení pomocí ZStack místo safeAreaBar, které schová první řádek obsahu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lægge den på med en ZStack i stedet for safeAreaBar og skjule indholdets første linje"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στρώσιμο με ZStack αντί για safeAreaBar, κρύβοντας την πρώτη γραμμή περιεχομένου"
          }
        }
      }
    },
    "safeAreaBar로 얹으면 콘텐츠가 알아서 비켜난다. 그 자동 인셋이 이 API의 전부다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach it with safeAreaBar and the content moves out of the way on its own. That automatic inset is the whole point of this API."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach it with safeAreaBar and the content moves out of the way on its own. That automatic inset is the whole point of this API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "safeAreaBarで載せれば、コンテンツは自動でよけてくれる。その自動インセットこそがこのAPIのすべてだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 safeAreaBar 叠加，内容会自动让开。这个自动内边距就是这个 API 的全部。"
