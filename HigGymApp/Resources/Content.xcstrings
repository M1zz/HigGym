    "제목이 잘리는데 아이템 수를 줄이지 않고 글자만 억지로 축소": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title gets clipped, but instead of reducing the number of items, the text is forcibly shrunk"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The title gets clipped, but instead of reducing the number of items, the text is forcibly shrunk"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルが切れているのに、アイテムの数を減らさず文字だけを無理に縮小"
