        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是預設值，覺得轉場屬於喜好的範疇。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это значение по умолчанию, и вы считаете, что переходы - дело вкуса."
