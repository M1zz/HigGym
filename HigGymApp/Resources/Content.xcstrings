    },
    "대상에 대한 액션은 대상 자체에": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put actions on the object itself"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put actions on the object itself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
