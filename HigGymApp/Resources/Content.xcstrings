            "state": "translated",
            "value": "Als de standaard voor gewone inhoud zoals tekstlijsten en kaartfeeds"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako ustawienie domyślne dla zwykłej treści, takiej jak listy tekstowe i kanały kart"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som standard för vanligt innehåll som textlistor och kortflöden"
          }
        },
        "tr": {
