          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสลับมุมมองและเรียงลำดับจัดกลุ่มทางซ้าย **เลือก**ทางขวา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển chế độ xem và sắp xếp gom ở bên trái, **Chọn** ở bên phải"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínání zobrazení a řazení seskupeno vlevo, **Vybrat** vpravo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Visningsskift og sortering grupperet til venstre, **Vælg** til højre"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εναλλαγή προβολής και ταξινόμηση ομαδοποιημένες αριστερά, **Επιλογή** δεξιά"
          }
        }
      }
    },
    "왼쪽에 실행취소/재실행 묶음, 오른쪽에 **완료**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo/redo grouped on the left, **Done** on the right"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo/redo grouped on the left, **Done** on the right"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左に取り消し/やり直しのまとまり、右に**完了**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
