            "value": "Back/forward (navigation) on the left, share and tab switching on the right"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Back/forward (navigation) on the left, share and tab switching on the right"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左は戻る/進む（移動）、右は共有・タブ切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左侧是后退/前进（导航），右侧是分享 · 标签切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
