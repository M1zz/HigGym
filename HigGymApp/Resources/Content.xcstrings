    "상시 노출되는 자리라 정보를 더 담고 싶다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's always visible, so you want it to hold more information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's always visible, so you want it to hold more information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に表示される場所なので、もっと情報を載せたい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是常驻显示的位置，想多放一些信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是常駐顯示的位置，想多放一些資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она всегда видна, поэтому хочется, чтобы она несла больше информации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre está visible, así que quieres que contenga más información."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ist immer sichtbar, also soll sie mehr Information tragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est toujours visible, donc vous voulez qu'elle porte plus d'informations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È sempre visibile, quindi vuoi che contenga più informazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está sempre visível, então você quer que guarde mais informação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มองเห็นตลอด คุณจึงอยากให้มันถือข้อมูลมากขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó luôn hiển thị, nên bạn muốn nó chứa nhiều thông tin hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vždy viditelný, takže chcete, aby držel víc informací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er altid synlig, så du vil have den til at rumme mere information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι πάντα ορατή, οπότε θέλεις να κρατά περισσότερη πληροφορία."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on aina näkyvissä, joten haluat sen kantavan enemmän tietoa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia selalu terlihat, jadi kamu ingin ia memuat lebih banyak informasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er alltid synlig, så du vil at den skal romme mer informasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij is altijd zichtbaar, dus je wilt dat hij meer informatie bevat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest zawsze widoczny, więc chcesz, by niósł więcej informacji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den är alltid synlig, så du vill att den ska rymma mer information."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman görünür, bu yüzden daha fazla bilgi taşımasını istersin."
          }
        }
      }
    },
    "상시 노출되는 자리라 캠페인을 확실히 보여줄 수 있을 것 같다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a spot that's always visible, so it seems like a sure way to showcase campaigns."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a spot that's always visible, so it seems like a sure way to showcase campaigns."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に表示される場所なので、キャンペーンを確実に見せられそうだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是常驻显示的位置，似乎能确实展示活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是常駐顯示的位置，似乎能確實展示活動。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это место всегда на виду, поэтому кажется надёжным способом показать акции."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un sitio siempre visible, así que parece una forma segura de exhibir campañas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein immer sichtbarer Platz, also scheint er ein sicherer Weg, Kampagnen zu präsentieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un emplacement toujours visible, donc il paraît un moyen sûr de mettre en vitrine des campagnes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un posto sempre visibile, quindi sembra un modo sicuro per mettere in mostra le campagne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um lugar sempre visível, então parece uma forma segura de pôr campanhas em vitrine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นตำแหน่งที่มองเห็นตลอด จึงดูเหมือนวิธีแน่นอนในการโชว์แคมเปญ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là chỗ luôn hiển thị, nên có vẻ là cách chắc chắn để trưng chiến dịch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to místo, které je vždy vidět, takže se zdá jistým způsobem, jak vystavit kampaně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en plads, der altid er synlig, så den virker som en sikker måde at fremvise kampagner på."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι ένα σημείο που είναι πάντα ορατό, οπότε φαίνεται σίγουρος τρόπος να προβάλεις καμπάνιες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on aina näkyvä paikka, joten se vaikuttaa varmalta tavalta esitellä kampanjoita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tempat yang selalu terlihat, jadi tampaknya cara pasti untuk memamerkan kampanye."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er et sted som alltid er synlig, så det virker som en sikker måte å vise frem kampanjer på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is een plek die altijd zichtbaar is, dus het lijkt een zekere manier om campagnes te showen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To miejsce zawsze widoczne, więc wydaje się pewnym sposobem na eksponowanie kampanii."
          }
        },
        "sv": {
