    "내비바 아래 **34pt 대형 제목**, 스크롤하면 작게 접힘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **34pt large title** below the navigation bar that collapses as you scroll"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **34pt large title** below the navigation bar that collapses as you scroll"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションバーの下の**34ptの大きいタイトル**。スクロールすると小さく折りたたまれる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航栏下方的 **34pt 大标题**，滚动时折叠变小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導覽列下方的 **34pt 大標題**，滾動時摺疊變小"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Крупный заголовок 34 pt** под панелью навигации, сворачивающийся при прокрутке"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **título grande de 34 pt** bajo la barra de navegación que se colapsa al desplazar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein **34-pt-Large-Titel** unter der Navigationsleiste, der beim Scrollen zusammenklappt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **grand titre de 34 pt** sous la barre de navigation qui se replie au défilement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **titolo grande da 34 pt** sotto la barra di navigazione che si comprime scorrendo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um **título grande de 34 pt** abaixo da barra de navegação que recolhe ao rolar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ชื่อเรื่องขนาดใหญ่ 34pt** ใต้แถบนำทางที่ยุบเมื่อเลื่อน"
