    "브랜드 로고를 제목 자리에 넣고 제목을 없앤다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the brand logo in the title slot and dropping the title"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the brand logo in the title slot and dropping the title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランドロゴをタイトルの場所に入れ、タイトルをなくす"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
