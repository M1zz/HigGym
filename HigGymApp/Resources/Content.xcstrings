            "state": "translated",
            "value": "よく使うアクションが、宣言の順番のせいでoverflowに折りたたまれる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最常用的操作因声明顺序被折叠进 overflow"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
