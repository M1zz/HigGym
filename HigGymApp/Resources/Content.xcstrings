        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS 26 moveu a busca para baixo, na direção do polegar. Siga a colocação do sistema."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 ย้ายการค้นหาลงไปใกล้นิ้วโป้ง ทำตามการวางของระบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 chuyển tìm kiếm xuống gần ngón cái. Hãy theo vị trí của hệ thống."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 přesunulo hledání dolů směrem k palci. Řiďte se systémovým umístěním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 flyttede søgning ned mod tommelfingeren. Følg systemets placering."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το iOS 26 μετέφερε την αναζήτηση προς τον αντίχειρα. Ακολούθησε την τοποθέτηση του συστήματος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 siirsi haun alas kohti peukaloa. Seuraa järjestelmän sijoitusta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 memindahkan pencarian ke bawah mendekati ibu jari. Ikuti penempatan sistem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 flyttet søk ned mot tommelen. Følg systemets plassering."
