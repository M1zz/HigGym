        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruch to tylko rozproszenie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rörelsen är bara en distraktion"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareket sadece bir dikkat dağıtıcıdır"
          }
        }
      }
    },
    "되돌릴 수 없는 액션은 일부러 한 단계 멀리 둔다. 도달성은 무해한 액션에만 적용한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deliberately keep irreversible actions one step away. Apply reachability only to harmless actions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Deliberately keep irreversible actions one step away. Apply reachability only to harmless actions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せないアクションは、あえて一段階遠くに置く。届きやすさは無害なアクションにだけ当てはめる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法撤销的操作要故意再远一步。可触达性只适用于无害的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法撤銷的操作要故意再遠一步。可觸達性只適用於無害的操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необратимые действия намеренно держите на шаг дальше. Досягаемость применяйте только к безвредным действиям."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén a propósito las acciones irreversibles a un paso de distancia. Aplica el alcance solo a las acciones inofensivas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte unumkehrbare Aktionen bewusst einen Schritt entfernt. Wende Erreichbarkeit nur auf harmlose Aktionen an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez délibérément les actions irréversibles à un cran de distance. N'appliquez l'accessibilité qu'aux actions inoffensives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni di proposito a un passo di distanza le azioni irreversibili. Applica la raggiungibilità solo alle azioni innocue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha de propósito as ações irreversíveis a um passo de distância. Aplique o alcance só a ações inofensivas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งใจเว้นการกระทำที่ย้อนกลับไม่ได้ไว้ห่างหนึ่งขั้น ใช้การเอื้อมถึงกับการกระทำที่ไม่เป็นอันตรายเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cố ý để hành động không thể hoàn tác cách một bước. Chỉ áp dụng khả năng với tới cho hành động vô hại."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevratné akce záměrně držte o krok dál. Dosah aplikujte jen na neškodné akce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold med vilje uigenkaldelige handlinger ét trin væk. Anvend rækkevidde kun på harmløse handlinger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα σκόπιμα τις μη αναστρέψιμες ενέργειες ένα βήμα μακριά. Εφάρμοσε την εμβέλεια μόνο σε αβλαβείς ενέργειες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä peruuttamattomat toiminnot tarkoituksella askeleen päässä. Sovella ulottuvuutta vain vaarattomiin toimintoihin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sengaja jaga aksi yang tak bisa dibatalkan berjarak satu langkah. Terapkan keterjangkauan hanya pada aksi yang tidak berbahaya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold handlinger som ikke kan angres med vilje ett steg unna. Bruk rekkevidde bare på ufarlige handlinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd onomkeerbare acties bewust een stap verder weg. Pas bereikbaarheid alleen toe op onschuldige acties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Celowo trzymaj akcje nieodwracalne o krok dalej. Stosuj łatwość dosięgnięcia tylko do akcji nieszkodliwych."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll medvetet oåterkalleliga åtgärder ett steg bort. Tillämpa räckvidd bara på ofarliga åtgärder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri alınamayan eylemleri bilerek bir adım uzakta tut. Erişimi yalnızca zararsız eylemlere uygula."
          }
        }
      }
    },
    "두 바의 재질·가장자리 효과가 제각각": {
      "extractionState": "manual",
