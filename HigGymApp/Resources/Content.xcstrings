            "state": "translated",
            "value": "Uma lista de nível superior como a biblioteca do Música, em que «onde estou?» importa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการระดับบนสุดอย่างคลังเพลงที่ \"ฉันอยู่ที่ไหน\" สำคัญ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một danh sách cấp cao nhất như thư viện Nhạc, nơi \"tôi đang ở đâu?\" quan trọng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam nejvyšší úrovně jako knihovna v Hudbě, kde záleží na „kde jsem?“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En liste på øverste niveau som Musik-biblioteket, hvor »hvor er jeg?« betyder noget"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια λίστα ανώτερου επιπέδου όπως η βιβλιοθήκη Μουσικής, όπου το «πού είμαι;» μετράει"
          }
        }
      }
    },
