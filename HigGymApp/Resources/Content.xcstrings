          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled) ให้คน**กดค้างเพื่อเลือกและคัดลอก**ข้อความแบบอ่านอย่างเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled) cho phép người ta **nhấn giữ để chọn và sao chép** văn bản chỉ đọc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled) umožňuje lidem **dlouze podržet, vybrat a zkopírovat** text jen pro čtení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled) lader folk **trykke og holde for at markere og kopiere** skrivebeskyttet tekst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το textSelection(.enabled) επιτρέπει στους ανθρώπους να **κρατούν πατημένο για επιλογή και αντιγραφή** κειμένου μόνο για ανάγνωση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled) antaa ihmisten **painaa pitkään valitakseen ja kopioidakseen** vain luettavaa tekstiä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled) memungkinkan orang **menekan dan menahan untuk memilih dan menyalin** teks baca-saja."
          }
