          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ícone + **um título de uma palavra**, a forma padrão de um item de aba"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอน + **ชื่อหนึ่งคำ** รูปแบบมาตรฐานของรายการแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu tượng + **tiêu đề một từ**, dạng chuẩn của một mục tab"
          }
        },
        "cs": {
