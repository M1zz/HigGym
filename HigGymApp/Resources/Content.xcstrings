        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At tro, at fyldning af alle fire pladser gør designet komplet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σκέψη ότι το γέμισμα και των τεσσάρων θέσεων κάνει τον σχεδιασμό πλήρη"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajatus, että kaikkien neljän paikan täyttäminen tekee suunnittelusta valmiin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengira mengisi keempat slot membuat desain lengkap"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å tro at det å fylle alle fire plasser gjør designet komplett"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Denken dat alle vier de plekken vullen het ontwerp compleet maakt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Myślenie, że wypełnienie wszystkich czterech miejsc czyni projekt kompletnym"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att tro att fyllandet av alla fyra platserna gör designen komplett"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dört yeri de doldurmanın tasarımı tamamladığını düşünmek"
          }
        }
      }
    },
