    },
    "minimumScaleFactor(0.5) (+ lineLimit(1)), 자르는 대신 **글자 크기를 줄여서** 공간에 맞춤.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5) (+ lineLimit(1)) fits text into the space by **shrinking the font size** instead of cutting it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5) (+ lineLimit(1)) fits text into the space by **shrinking the font size** instead of cutting it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5)（+ lineLimit(1)）。切る代わりに**文字サイズを縮めて**スペースに収める。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5)（+ lineLimit(1)），不截断，而是**缩小字号**来适应空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5)（+ lineLimit(1)），不截斷，而是**縮小字號**來適應空間。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5) (+ lineLimit(1)) помещает текст в пространство, **уменьшая размер шрифта** вместо обрезки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5) (+ lineLimit(1)) ajusta el texto al espacio **reduciendo el tamaño de fuente** en lugar de cortarlo."
          }
        }
      }
    },
    "overflow를 피하려고 아이콘 7개를 우겨넣어 터치 타깃이 손가락보다 작아짐": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven icons crammed in to avoid overflow, leaving touch targets smaller than a finger"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven icons crammed in to avoid overflow, leaving touch targets smaller than a finger"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "overflowを避けようとアイコンを7つ詰め込み、タッチターゲットが指より小さくなっている"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为避免 overflow 硬塞进 7 个图标，触控目标比手指还小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為避免 overflow 硬塞進 7 個圖示，觸控目標比手指還小"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семь значков втиснуты, чтобы избежать переполнения, и области касания стали меньше пальца"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete iconos apretados para evitar el desbordamiento, dejando los objetivos táctiles más pequeños que un dedo"
          }
        }
      }
    },
    "overflow를 피하려고 아이콘을 우겨넣어 터치 타깃을 줄인다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cramming in icons to avoid the overflow, shrinking the touch targets"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Cramming in icons to avoid the overflow, shrinking the touch targets"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "overflowを避けようとアイコンを詰め込み、タッチターゲットを小さくする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为避免 overflow 硬塞图标，压缩了触控目标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為避免 overflow 硬塞圖示，壓縮了觸控目標"
          }
