    "**오른쪽(trailing) 가장자리, 중앙 정렬**, 엄지 호에 맞는 세로 컨트롤": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trailing (right) edge, center-aligned**, a vertical control that fits the thumb's arc"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trailing (right) edge, centre-aligned**, a vertical control that fits the thumb's arc"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**右（trailing）端、中央揃え**。親指の弧に合った縦のコントロール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**右侧（trailing）边缘，居中对齐**，贴合拇指弧线的竖向控件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**右側（trailing）邊緣，居中對齊**，貼合拇指弧線的豎向控制元件"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Правый (trailing) край, выравнивание по центру**: вертикальный элемент, подходящий дуге большого пальца"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Borde trailing (derecho), centrado**, un control vertical que se ajusta al arco del pulgar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trailing (rechter) Rand, mittig ausgerichtet**, ein vertikales Steuerelement, das zum Bogen des Daumens passt"
