            "state": "translated",
            "value": "Secondary ดูจางเกินไป คุณจึงปรับความสว่างเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary trông quá mờ, nên bạn tự chỉnh độ sáng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary vypadá příliš slabě, tak si jas upravíte sami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary ser for svag ud, så du justerer lysstyrken selv."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το secondary φαίνεται πολύ αχνό, οπότε ρυθμίζεις μόνος σου τη φωτεινότητα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary näyttää liian himmeältä, joten säädät kirkkauden itse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary tampak terlalu pudar, jadi kamu menyetel kecerahan sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary ser for svak ut, så du justerer lysstyrken selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary lijkt te vaag, dus je past de helderheid zelf aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary wygląda na zbyt blady, więc dostrajasz jasność samodzielnie."
          }
