        }
      }
    },
    "제목이 오는 **정중앙 자리**(.principal)에 커스텀 컨트롤을 배치. 제목을 대체.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom control in **the dead-center slot** where the title goes (.principal), replacing the title."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom control in **the dead-centre slot** where the title goes (.principal), replacing the title."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルが来る**真ん中の位置**（.principal）にカスタムコントロールを配置。タイトルの代わりになる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在放标题的**正中间位置**（.principal）放自定义控件。取代标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在放標題的**正中間位置**（.principal）放自定義控制元件。取代標題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательский элемент управления в **слоте строго по центру**, где стоит заголовок (.principal), вместо заголовка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un control personalizado en **el sitio del centro exacto** donde va el título (.principal), sustituyendo al título."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein eigenes Steuerelement im **Platz genau in der Mitte**, wo der Titel steht (.principal), das den Titel ersetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un contrôle personnalisé dans **l'emplacement pile au centre** où va le titre (.principal), remplaçant le titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un controllo personalizzato nello **slot al centro esatto** dove va il titolo (.principal), che sostituisce il titolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um controle personalizado **no lugar do centro exato** onde vai o título (.principal), substituindo o título."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวควบคุมที่กำหนดเองใน**ช่องกึ่งกลางพอดี**ที่ชื่อเรื่องอยู่ (.principal) แทนที่ชื่อเรื่อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một điều khiển tùy chỉnh ở **ô chính giữa** nơi tiêu đề ở (.principal), thay cho tiêu đề."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní ovladač ve **slotu přesně uprostřed**, kde je nadpis (.principal), nahrazující nadpis."
          }
        },
        "da": {
          "stringUnit": {
