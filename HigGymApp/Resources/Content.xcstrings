    "내비바 아래 **34pt 대형 제목**, 스크롤하면 작게 접힘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **34pt large title** below the navigation bar that collapses as you scroll"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **34pt large title** below the navigation bar that collapses as you scroll"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションバーの下の**34ptの大きいタイトル**。スクロールすると小さく折りたたまれる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航栏下方的 **34pt 大标题**，滚动时折叠变小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導覽列下方的 **34pt 大標題**，滾動時摺疊變小"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Крупный заголовок 34 pt** под панелью навигации, сворачивающийся при прокрутке"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **título grande de 34 pt** bajo la barra de navegación que se colapsa al desplazar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein **34-pt-Large-Titel** unter der Navigationsleiste, der beim Scrollen zusammenklappt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **grand titre de 34 pt** sous la barre de navigation qui se replie au défilement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **titolo grande da 34 pt** sotto la barra di navigazione che si comprime scorrendo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um **título grande de 34 pt** abaixo da barra de navegação que recolhe ao rolar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ชื่อเรื่องขนาดใหญ่ 34pt** ใต้แถบนำทางที่ยุบเมื่อเลื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tiêu đề lớn 34pt** dưới thanh điều hướng, thu lại khi cuộn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**34pt velký nadpis** pod navigačním panelem, který se při posouvání sbalí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En **34 pt stor titel** under navigationsbjælken, der folder sammen, mens du scroller"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας **μεγάλος τίτλος 34 pt** κάτω από τη γραμμή πλοήγησης που συμπτύσσεται καθώς κυλάς"
          }
        }
      }
    },
    "내비바 아래 **34pt 대형 제목**. 스크롤하면 작은 inline 제목으로 자동 축소.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **34pt large title** below the navigation bar. It automatically shrinks to a small inline title as you scroll."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **34pt large title** below the navigation bar. It automatically shrinks to a small inline title as you scroll."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションバーの下に**34ptの大きいタイトル**。スクロールすると小さなinlineタイトルに自動で縮む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航栏下方的 **34pt 大标题**。滚动时自动缩成小的 inline 标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導覽列下方的 **34pt 大標題**。滾動時自動縮成小的 inline 標題。"
