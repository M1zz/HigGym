    "뒤 콘텐츠 흐름이 뚝 끊김": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flow of content behind it is abruptly cut off"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The flow of content behind it is abruptly cut off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背後のコンテンツの流れがぷつりと途切れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后面内容的流动戛然而止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後面內容的流動戛然而止"
          }
        },
        "ru": {
