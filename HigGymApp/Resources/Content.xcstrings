        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt tìm kiếm vào ngăn kéo biến mất khi cuộn trong app xoay quanh tìm kiếm"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dát hledání do zásuvky, která mizí při posouvání, v aplikaci postavené kolem hledání"
