        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft και hard ανακατεμένα οθόνη προς οθόνη χωρίς κανόνα, με απώλεια συνέπειας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft ja hard sekaisin näkymä kerrallaan ilman sääntöä, johdonmukaisuus menetetty"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft dan hard dicampur layar demi layar tanpa aturan, kehilangan konsistensi"
