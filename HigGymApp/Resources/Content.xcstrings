    "글자가 묻히는데 투명한 쪽이 예뻐서 그대로 둔다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving text buried because the transparent version looks prettier"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving text buried because the transparent version looks prettier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字が埋もれているのに、透明なほうがきれいだからそのままにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字被盖住了，但透明的一边更好看，所以就保留了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字被蓋住了，但透明的一邊更好看，所以就保留了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить текст похороненным, потому что прозрачный вариант красивее"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar el texto enterrado porque la versión transparente es más bonita"
          }
        }
      }
    },
    "글자가 묻히는데도 “투명이 예뻐서” 유지(가독성>미학 역전)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping it transparent \"because it looks nice\" even though the text is buried (legibility > aesthetics, reversed)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping it transparent \"because it looks nice\" even though the text is buried (legibility > aesthetics, reversed)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字が埋もれているのに「透明のほうがきれいだから」と維持（読みやすさ > 美しさの逆転）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字被盖住了，却以“透明更好看”为由保留（可读性 > 美观 被颠倒）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字被蓋住了，卻以「透明更好看」為由保留（可讀性 > 美觀 被顛倒）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять прозрачность «потому что красиво», хотя текст похоронен (читаемость > эстетика, наоборот)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerlo transparente «porque se ve bien» aunque el texto quede enterrado (legibilidad > estética, al revés)"
          }
        }
      }
    },
    "금액·타이머를 기본 tail로 잘라 틀린 값을 보여준다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Truncating amounts and timers with the default tail, showing the wrong value"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Truncating amounts and timers with the default tail, showing the wrong value"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額・タイマーをデフォルトのtailで切り詰め、間違った値を見せる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把金额、计时器按默认 tail 截断，显示出错误的值"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把金額、計時器按預設 tail 截斷，顯示出錯誤的值"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезка сумм и таймеров стандартным tail, показ неверного значения"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Truncar importes y temporizadores con tail por defecto, mostrando el valor equivocado"
          }
        }
      }
    },
    "금액과 타이머에는 `lineLimit(1)`과 `minimumScaleFactor`를 함께 걸어 자르는 대신 줄인다. 값은 언제나 전체가 보인다. 절반 아래로 줄여야 들어간다면 폭이나 표기를 다시 설계한다. 규칙은 여전히 하나지만 더 정확해졌다. 문장은 자르고, 값은 줄인다. 2.1.3 예제에서 같은 숫자가 잘릴 때와 줄어들 때를 비교할 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For amounts and timers, apply both `lineLimit(1)` and `minimumScaleFactor` so they shrink instead of being truncated. The value is always shown in full. If it has to shrink below half to fit, redesign the width or notation. There's still one rule, just a more precise one: truncate sentences, scale values. In the 2.1.3 example, you can compare the same number being truncated and being scaled."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For amounts and timers, apply both `lineLimit(1)` and `minimumScaleFactor` so they shrink instead of being truncated. The value is always shown in full. If it has to shrink below half to fit, redesign the width or notation. There's still one rule, just a more precise one: truncate sentences, scale values. In the 2.1.3 example, you can compare the same number being truncated and being scaled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額とタイマーには `lineLimit(1)` と `minimumScaleFactor` を一緒にかけ、切り詰める代わりに縮める。値は常に全体が見える。半分より小さく縮めないと収まらないなら、幅や表記を設計し直す。ルールは相変わらず1つだが、より正確になった。文は切り詰め、値は縮める。2.1.3の例で、同じ数字が切り詰められる場合と縮む場合を比べられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额和计时器同时加 `lineLimit(1)` 和 `minimumScaleFactor`，用缩小代替截断。数值始终完整可见。如果必须缩到一半以下才放得下，就重新设计宽度或写法。规则仍然只有一条，但更准确了：句子截断，数值缩小。在 2.1.3 示例里可以比较同一个数字被截断和被缩小的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金額和計時器同時加 `lineLimit(1)` 和 `minimumScaleFactor`，用縮小代替截斷。數值始終完整可見。如果必須縮到一半以下才放得下，就重新設計寬度或寫法。規則仍然只有一條，但更準確了：句子截斷，數值縮小。在 2.1.3 示例裡可以比較同一個數字被截斷和被縮小的樣子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сумм и таймеров применяйте и `lineLimit(1)`, и `minimumScaleFactor`, чтобы они уменьшались, а не обрезались. Значение всегда видно целиком. Если для вместимости нужно уменьшать меньше чем вдвое, перепроектируйте ширину или запись. Правило по-прежнему одно, но точнее: предложения обрезают, значения масштабируют. В примере 2.1.3 можно сравнить одно и то же число при обрезке и при масштабировании."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para importes y temporizadores, aplica `lineLimit(1)` y `minimumScaleFactor` a la vez para que se reduzcan en lugar de truncarse. El valor se muestra siempre completo. Si tiene que reducirse por debajo de la mitad para caber, rediseña el ancho o la notación. Sigue habiendo una regla, solo que más precisa: trunca las frases, escala los valores. En el ejemplo 2.1.3, compara el mismo número truncado y escalado."
          }
        }
      }
    },
    "기기별 검증 없는 고정 px": {
      "extractionState": "manual",
