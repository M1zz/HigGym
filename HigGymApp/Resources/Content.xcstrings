        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned with always, then bottom search added on top (taking up two slots)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "alwaysで固定したうえに下部の検索まで追加（2つの位置を占有）"
          }
        },
        "zh-Hans": {
