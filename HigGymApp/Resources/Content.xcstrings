            "value": "De titel van een gewoon lijstscherm weghalen en het midden aan zoeken geven"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie tytułu ze zwykłego ekranu listy i oddanie środka wyszukiwaniu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ta bort rubriken från en vanlig listskärm och ge mitten till sökning"
