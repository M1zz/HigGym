      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled across every screen because \"it looks more minimal\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled across every screen because \"it looks more minimal\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ミニマルに見える」という理由で全画面一括で無効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以“看起来简约”为由，在所有界面统一关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以「看起來簡約」為由，在所有介面統一關閉"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключено на всех экранах, потому что «так выглядит минималистичнее»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado en todas las pantallas porque «se ve más minimalista»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf allen Bildschirmen deaktiviert, weil es „minimalistischer aussieht“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé sur tous les écrans parce que « ça fait plus minimaliste »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato su ogni schermata perché «sembra più minimale»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado em todas as telas porque «parece mais minimalista»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดทุกหน้าจอเพราะ \"ดูมินิมอลกว่า\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt trên mọi màn hình vì \"trông tối giản hơn\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto na každé obrazovce, protože „vypadá to minimalističtěji“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slået fra på alle skærme, fordi »det ser mere minimalt ud«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιημένο σε κάθε οθόνη επειδή «φαίνεται πιο μινιμαλιστικό»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistettu käytöstä jokaisessa näkymässä, koska ”se näyttää minimalistisemmalta”"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinonaktifkan di setiap layar karena \"terlihat lebih minimal\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slått av på alle skjermer fordi «det ser mer minimalt ut»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op elk scherm uitgeschakeld omdat \"het minimalistischer oogt\""
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone na każdym ekranie, bo „wygląda bardziej minimalistycznie”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avstängd på varje skärm för att ”det ser mer minimalistiskt ut”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Daha minimal görünüyor” diye her ekranda devre dışı bırakıldı"
          }
        }
      }
    },
    "“빈 자리 = 실패”라는 오해로 모든 위치에 버튼을 배분": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons spread across every position out of the misconception that “an empty slot = failure”"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons spread across every position out of the misconception that “an empty slot = failure”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「空いた位置 = 失敗」という誤解から、すべての位置にボタンを配分"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "误以为“空位 = 失败”，把按钮分配到每个位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "誤以為「空位 = 失敗」，把按鈕分配到每個位置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки расставлены на каждое место из-за заблуждения, что «пустое место = провал»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Botones repartidos por todas las posiciones por la idea equivocada de que «un hueco vacío = fracaso»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons auf jede Position verteilt, aus dem Irrglauben, ein „leerer Platz = Fehler“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des boutons répartis à chaque position par erreur de croire qu'« un emplacement vide = un échec »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsanti sparsi in ogni posizione per il malinteso che «uno slot vuoto = fallimento»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Botões espalhados por todas as posições pelo equívoco de que «um lugar vazio = fracasso»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มกระจายทุกตำแหน่งจากความเข้าใจผิดที่ว่า “ช่องว่าง = ความล้มเหลว”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nút rải khắp mọi vị trí do hiểu lầm “ô trống = thất bại”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítka rozházená po každé pozici z mylné představy, že „prázdný slot = selhání“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper spredt over alle positioner ud fra den misforståelse, at »en tom plads = fiasko«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κουμπιά απλωμένα σε κάθε θέση από την παρανόηση ότι «μια άδεια θέση = αποτυχία»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Painikkeet levitettynä joka paikkaan harhakäsityksestä, että ”tyhjä paikka = epäonnistuminen”"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol tersebar di setiap posisi karena salah paham bahwa “slot kosong = kegagalan”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper spredt over alle posisjoner ut fra misforståelsen om at “en tom plass = feil”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoppen verspreid over elke positie uit de misvatting dat \"een lege plek = mislukking\""
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciski rozrzucone po każdej pozycji z błędnego przekonania, że „puste miejsce = porażka”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knappar utspridda över varje position av missuppfattningen att ”en tom plats = misslyckande”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Boş yer = başarısızlık” yanılgısıyla düğmelerin her konuma yayılması"
          }
        }
      }
    },
    "“어디로 가는가”에 답 못 함": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It can't answer \"Where does it go?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It can't answer \"Where does it go?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「どこへ行くのか」に答えられない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答不了“要去哪里”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回答不了「要去哪裡」"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не может ответить «куда это ведёт?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede responder a «¿Adónde va?»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann „Wohin geht es?“ nicht beantworten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne peut pas répondre à « Où cela va-t-il ? »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sa rispondere a «Dove va?»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegue responder «Onde vai?»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันตอบ \"จะไปอยู่ที่ไหน\" ไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó không trả lời được \"Nó đi đâu?\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neodpoví na „Kam to vede?“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan ikke svare på »Hvor hører den hjemme?«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορεί να απαντήσει «Πού πηγαίνει;»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei osaa vastata kysymykseen ”Minne se menee?”"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia tidak bisa menjawab \"Ke mana ini pergi?\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan ikke svare på «Hvor skal den?»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kan \"Waar hoort het?\" niet beantwoorden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie potrafi odpowiedzieć na „Gdzie to trafia?”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan inte svara på ”Var hamnar det?”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Nereye gidiyor?” sorusunu yanıtlayamaz"
          }
        }
      }
    },
    "“지금 얼마나 보고 싶은지”는 시스템이 판단할 수 없는 **사용자의 의도**, 그래서 높이 선택권 자체를 사용자에게 넘긴 것. 끌어올리는 제스처가 곧 의도 표현이고, 그랩바는 “단계가 더 있다”는 어포던스입니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"How much do I want to see right now?\" is **the user's intent**, which the system can't judge, so the choice of height itself is handed to the user. The drag-up gesture is how they express that intent, and the grabber is the affordance that says \"there are more steps.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "\"How much do I want to see right now?\" is **the user's intent**, which the system can't judge, so the choice of height itself is handed to the user. The drag-up gesture is how they express that intent, and the grabber is the affordance that says \"there are more steps.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今どれだけ見たいか」はシステムには判断できない**ユーザーの意図**。だから高さを選ぶこと自体をユーザーに委ねた。引き上げるジェスチャーがそのまま意図の表明で、グラバーは「まだ段階がある」ことを示すアフォーダンスです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“现在想看多少”是系统无法判断的**用户意图**，所以把高度的选择权本身交给了用户。向上拉的手势就是意图的表达，抓取条是“还有更多档位”的提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「現在想看多少」是系統無法判斷的**使用者意圖**，所以把高度的選擇權本身交給了使用者。向上拉的手勢就是意圖的表達，抓取列是「還有更多檔位」的提示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сколько я хочу видеть прямо сейчас» - это **намерение пользователя**, которое система оценить не может, поэтому выбор самой высоты отдан пользователю. Жест вытягивания вверх - способ выразить это намерение, а ручка-индикатор - подсказка «ступеней больше»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«¿Cuánto quiero ver ahora mismo?» es **la intención del usuario**, que el sistema no puede juzgar, así que la elección de altura se entrega al propio usuario. El gesto de arrastrar hacia arriba es cómo expresa esa intención, y el tirador es la pista visual que dice «hay más escalones»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wie viel will ich gerade sehen?“ ist **die Absicht des Nutzers**, die das System nicht beurteilen kann, also wird die Wahl der Höhe selbst dem Nutzer überlassen. Die Ziehgeste nach oben ist seine Art, diese Absicht auszudrücken, und der Griff ist das Affordance, das sagt: „Es gibt weitere Stufen.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Combien est-ce que je veux voir en ce moment ? » est **l'intention de l'utilisateur**, que le système ne peut pas juger, donc le choix de la hauteur elle-même est remis à l'utilisateur. Le geste de tirer vers le haut est sa façon d'exprimer cette intention, et la poignée est l'affordance qui dit « il y a d'autres crans »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Quanto voglio vedere adesso?» è **l'intenzione dell'utente**, che il sistema non può giudicare, quindi la scelta stessa dell'altezza viene affidata all'utente. Il gesto di trascinare su è il modo in cui esprime quell'intenzione, e la maniglia è l'affordance che dice «ci sono altri passi»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Quanto quero ver agora?» é **a intenção do usuário**, que o sistema não consegue julgar, então a escolha da própria altura é entregue ao usuário. O gesto de arrastar para cima é o modo de ele expressar essa intenção, e a alça é a affordance que diz «há mais passos»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ตอนนี้อยากเห็นมากแค่ไหน\" คือ**เจตนาของผู้ใช้** ซึ่งระบบตัดสินแทนไม่ได้ การเลือกความสูงจึงถูกมอบให้ผู้ใช้ ท่าทางลากขึ้นคือวิธีที่พวกเขาแสดงเจตนานั้น และ grabber คือ affordance ที่บอกว่า \"ยังมีขั้นอีก\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Lúc này tôi muốn xem bao nhiêu?\" là **ý định của người dùng**, điều hệ thống không phán đoán được, nên việc chọn chiều cao được trao cho người dùng. Cử chỉ kéo lên là cách họ bày tỏ ý định đó, và grabber là affordance nói rằng \"còn bậc nữa.\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Kolik chci právě teď vidět?“ je **záměr uživatele**, který systém posoudit nemůže, a proto je volba výšky svěřena uživateli. Gesto tažení nahoru je způsob, jak ten záměr vyjádří, a grabber je affordance, která říká „je tu víc kroků“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»Hvor meget vil jeg se lige nu?« er **brugerens hensigt**, som systemet ikke kan bedømme, så selve valget af højde overlades til brugeren. Trækbevægelsen opad er måden, de udtrykker den hensigt på, og grabberen er affordancen, der siger »der er flere trin.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «πόσο θέλω να δω αυτή τη στιγμή» είναι **η πρόθεση του χρήστη**, την οποία το σύστημα δεν μπορεί να κρίνει, οπότε η ίδια η επιλογή ύψους παραδίδεται στον χρήστη. Η χειρονομία σύρσιμου προς τα πάνω είναι ο τρόπος που εκφράζει αυτή την πρόθεση, και το grabber είναι το affordance που λέει «υπάρχουν κι άλλα βήματα»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Kuinka paljon haluan nähdä juuri nyt?” on **käyttäjän aikomus**, jota järjestelmä ei voi arvioida, joten korkeuden valinta itse annetaan käyttäjälle. Ylösvetoele on tapa, jolla he ilmaisevat tuon aikomuksen, ja grabber on affordanssi, joka sanoo ”portaita on lisää”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Seberapa banyak yang ingin kulihat sekarang?\" adalah **niat pengguna**, yang tak bisa dinilai sistem, jadi pilihan tinggi diserahkan kepada pengguna. Gestur tarik ke atas adalah cara mereka mengungkapkan niat itu, dan grabber adalah affordance yang berkata \"masih ada langkah lagi.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«Hvor mye vil jeg se akkurat nå?» er **brukerens intensjon**, som systemet ikke kan bedømme, så selve valget av høyde overlates til brukeren. Dra-opp-bevegelsen er hvordan de uttrykker den intensjonen, og grabberen er affordancen som sier «det er flere trinn»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Hoeveel wil ik nu zien?\" is **de intentie van de gebruiker**, die het systeem niet kan beoordelen, dus de keuze van hoogte zelf wordt aan de gebruiker overgelaten. Het omhoogsleepgebaar is hoe die de intentie uitdrukt, en de grabber is de affordance die zegt \"er zijn meer stappen\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ile chcę teraz zobaczyć?” to **intencja użytkownika**, której system nie potrafi ocenić, więc sam wybór wysokości oddaje się użytkownikowi. Gest przeciągnięcia w górę to sposób, w jaki wyraża tę intencję, a grabber to wskazówka mówiąca „są kolejne stopnie”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”Hur mycket vill jag se just nu?” är **användarens avsikt**, som systemet inte kan bedöma, så valet av höjd överlåts åt användaren. Dragningen uppåt är hur de uttrycker den avsikten, och greppet är affordancen som säger ”det finns fler steg”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Şu anda ne kadarını görmek istiyorum?” **kullanıcının niyetidir**, sistem bunu yargılayamaz, bu yüzden yükseklik seçimi kullanıcıya bırakılır. Yukarı sürükleme hareketi bu niyeti ifade etme yoludur ve tutamak “daha fazla adım var” diyen ipucudur."
          }
        }
      }
    },
