            "state": "translated",
            "value": "You meet the request to show the brand on every screen by using the title slot."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You meet the request to show the brand on every screen by using the title slot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「すべての画面にブランドを出したい」という要望を、タイトルの場所で解決する。"
