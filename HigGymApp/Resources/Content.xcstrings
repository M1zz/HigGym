            "value": "Περικομμένες ετικέτες και σμικρυμένοι στόχοι αφής"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkaistut nimikkeet ja kutistuneet kosketuskohteet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Label terpotong dan target sentuh mengecil"
