          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slået til på referencetekst som vilkår og adresser"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιημένο σε κείμενο αναφοράς όπως όροι και διευθύνσεις"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytössä viitetekstillä, kuten ehdoilla ja osoitteilla"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diaktifkan pada teks rujukan seperti ketentuan dan alamat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivert på referansetekst som vilkår og adresser"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingeschakeld op referentietekst zoals voorwaarden en adressen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączone na tekście referencyjnym, takim jak warunki i adresy"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverat på referenstext som villkor och adresser"
