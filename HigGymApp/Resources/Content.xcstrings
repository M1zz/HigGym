            "value": "Cambio di vista e ordinamento raggruppati a sinistra, **Seleziona** a destra"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca de visualização e ordenação agrupadas à esquerda, **Selecionar** à direita"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสลับมุมมองและเรียงลำดับจัดกลุ่มทางซ้าย **เลือก**ทางขวา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển chế độ xem và sắp xếp gom ở bên trái, **Chọn** ở bên phải"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínání zobrazení a řazení seskupeno vlevo, **Vybrat** vpravo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Visningsskift og sortering grupperet til venstre, **Vælg** til højre"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εναλλαγή προβολής και ταξινόμηση ομαδοποιημένες αριστερά, **Επιλογή** δεξιά"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkymänvaihto ja lajittelu ryhmiteltynä vasemmalle, **Valitse** oikealle"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengalih tampilan dan pengurutan dikelompokkan di kiri, **Pilih** di kanan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Visningsbytte og sortering gruppert til venstre, **Velg** til høyre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weergave wisselen en sorteren links gegroepeerd, **Selecteer** rechts"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełączanie widoku i sortowanie zgrupowane po lewej, **Wybierz** po prawej"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybyte och sortering grupperade till vänster, **Markera** till höger"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sol tarafta görünüm değiştirme ve sıralama gruplanmış, sağda **Seç**"
          }
        }
      }
    },
    "왼쪽에 실행취소/재실행 묶음, 오른쪽에 **완료**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo/redo grouped on the left, **Done** on the right"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo/redo grouped on the left, **Done** on the right"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左に取り消し/やり直しのまとまり、右に**完了**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左侧是撤销/重做一组，右侧是**完成**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "左側是撤銷/重做一組，右側是**完成**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена/повтор собраны слева, **«Готово»** справа"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer/rehacer agrupados a la izquierda, **Listo** a la derecha"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückgängig/Wiederholen links gruppiert, **Fertig** rechts"
          }
        },
        "fr": {
          "stringUnit": {
