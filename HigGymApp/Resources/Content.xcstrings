    "액세서리 + 탭바 최소화, 스크롤하면 탭바가 접히고 **액세서리가 그 자리로 내려앉음**(inline 배치).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory + tab bar minimization: scroll and the tab bar collapses while **the accessory drops down into its place** (inline placement)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory + tab bar minimisation: scroll and the tab bar collapses while **the accessory drops down into its place** (inline placement)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセサリ＋タブバーの最小化。スクロールするとタブバーが折りたたまれ、**アクセサリがその場所に降りてくる**（inline配置）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件 + 标签栏最小化：滚动时标签栏折叠，**附件落到它的位置**（inline 布局）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附件 + 標籤列最小化：滾動時標籤列摺疊，**附件落到它的位置**（inline 佈局）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory + минимизация панели вкладок: при прокрутке панель вкладок сворачивается, а **accessory опускается на её место** (inline-размещение)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesorio + minimización de la barra de pestañas: al desplazar, la barra de pestañas se colapsa mientras **el accesorio baja a su sitio** (colocación inline)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory + Minimieren der Tab-Leiste: Scrolle, und die Tab-Leiste klappt zusammen, während **das Accessory auf ihren Platz herabrückt** (Inline-Platzierung)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessoire + réduction de la barre d'onglets : faites défiler et la barre d'onglets se replie tandis que **l'accessoire descend à sa place** (placement inline)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessorio + riduzione della barra delle schede: scorri e la barra delle schede si comprime mentre **l'accessorio scende al suo posto** (collocazione inline)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acessório + minimização da barra de abas: role e a barra de abas recolhe enquanto **o acessório desce para o seu lugar** (colocação inline)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์เสริม + การย่อแถบแท็บ: เลื่อนแล้วแถบแท็บยุบขณะที่**อุปกรณ์เสริมลงมาอยู่ในที่ของมัน** (วางแบบ inline)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phụ kiện + thu gọn thanh tab: cuộn và thanh tab thu lại trong khi **phụ kiện hạ xuống vào chỗ của nó** (đặt inline)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příslušenství + minimalizace panelu karet: posouvejte a panel karet se sbalí, zatímco **příslušenství se spustí na jeho místo** (umístění inline)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbehør + minimering af fanelinjen: scroll, og fanelinjen folder sammen, mens **tilbehøret falder ned på dens plads** (inline-placering)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξάρτημα + ελαχιστοποίηση γραμμής καρτελών: κύλισε και η γραμμή καρτελών συμπτύσσεται ενώ **το εξάρτημα πέφτει στη θέση της** (inline τοποθέτηση)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory + välilehtipalkin minimointi: vieritä, niin välilehtipalkki tiivistyy samalla kun **accessory laskeutuu sen paikalle** (inline-sijoitus)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory + penciutan bilah tab: gulir dan bilah tab menciut sementara **accessory turun ke tempatnya** (penempatan inline)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory + minimering av fanelinjen: rull, og fanelinjen kollapser mens **accessoryen faller ned på plassen** (inline-plassering)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessoire + minimaliseren van de tabbalk: scroll en de tabbalk klapt in terwijl **het accessoire op zijn plek zakt** (inline-plaatsing)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcesorium + minimalizacja paska kart: przewiń, a pasek kart się zwija, podczas gdy **akcesorium opada na jego miejsce** (umieszczenie inline)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillbehör + flikfältsminimering: scrolla så fälls flikfältet ihop medan **tillbehöret faller ner på dess plats** (inline-placering)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksesuar + sekme çubuğu küçültme: kaydır, sekme çubuğu daralır ve **aksesuar onun yerine iner** (satır içi yerleşim)."
          }
        }
      }
    },
    "액세서리 뷰는 확장/인라인 두 크기에서 모두 읽혀야 합니다tabViewBottomAccessoryPlacement 환경 값으로 분기하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The accessory view must read well at both sizes, expanded and inline. Branch on the tabViewBottomAccessoryPlacement environment value."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The accessory view must read well at both sizes, expanded and inline. Branch on the tabViewBottomAccessoryPlacement environment value."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセサリビューは、展開時とインライン時の両方のサイズで読めなければなりません。tabViewBottomAccessoryPlacementの環境値で分岐してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件视图在展开/内联两种尺寸下都必须读得清：请用 tabViewBottomAccessoryPlacement 环境值来分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附件檢視在展開/內聯兩種尺寸下都必須讀得清：請用 tabViewBottomAccessoryPlacement 環境值來分支。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представление accessory должно хорошо читаться в обоих размерах, развёрнутом и inline. Ветвитесь по значению среды tabViewBottomAccessoryPlacement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista del accesorio debe leerse bien en ambos tamaños, expandido e inline. Ramifica según el valor de entorno tabViewBottomAccessoryPlacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Accessory-Ansicht muss in beiden Größen gut lesbar sein, erweitert und inline. Verzweige über den Umgebungswert tabViewBottomAccessoryPlacement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vue de l'accessoire doit se lire bien aux deux tailles, étendue et inline. Branchez sur la valeur d'environnement tabViewBottomAccessoryPlacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista dell'accessorio deve leggersi bene a entrambe le dimensioni, espansa e inline. Dirama sul valore di ambiente tabViewBottomAccessoryPlacement."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A view do acessório precisa ser legível nos dois tamanhos, expandido e inline. Ramifique pelo valor de ambiente tabViewBottomAccessoryPlacement."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "view ของอุปกรณ์เสริมต้องอ่านดีทั้งสองขนาด ขยายและ inline แตกสาขาตามค่าสภาพแวดล้อม tabViewBottomAccessoryPlacement"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "View phụ kiện phải đọc tốt ở cả hai cỡ, mở rộng và inline. Rẽ nhánh theo giá trị môi trường tabViewBottomAccessoryPlacement."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "View příslušenství se musí dobře číst v obou velikostech, rozbalené i inline. Větvete podle hodnoty prostředí tabViewBottomAccessoryPlacement."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbehørsvisningen skal læses godt i begge størrelser, udvidet og inline. Forgren på miljøværdien tabViewBottomAccessoryPlacement."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προβολή εξαρτήματος πρέπει να διαβάζεται καλά και στα δύο μεγέθη, ανεπτυγμένη και inline. Διακλαδώσου στην τιμή περιβάλλοντος tabViewBottomAccessoryPlacement."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory-näkymän täytyy lukea hyvin molemmissa koissa, laajennettuna ja inline. Haarauta ympäristöarvolla tabViewBottomAccessoryPlacement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan accessory harus terbaca baik pada kedua ukuran, expanded dan inline. Bercabanglah pada nilai environment tabViewBottomAccessoryPlacement."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory-visningen må leses godt i begge størrelser, utvidet og inline. Forgren på miljøverdien tabViewBottomAccessoryPlacement."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De accessoireweergave moet goed lezen op beide groottes, uitgeklapt en inline. Vertak op de omgevingswaarde tabViewBottomAccessoryPlacement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widok akcesorium musi dobrze się czytać w obu rozmiarach, rozwiniętym i inline. Rozgałęź po wartości środowiska tabViewBottomAccessoryPlacement."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillbehörsvyn måste läsas väl i båda storlekarna, utfälld och inline. Förgrena på miljövärdet tabViewBottomAccessoryPlacement."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksesuar görünümü hem genişletilmiş hem satır içi boyutta iyi okunmalı. tabViewBottomAccessoryPlacement ortam değerine göre dallan."
          }
        }
      }
    },
    "액세서리가 접힌 상태(inline)를 대응하지 않는다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not handling the accessory's collapsed (inline) state"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not handling the accessory's collapsed (inline) state"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセサリの折りたたまれた状態（inline）に対応しない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不处理附件折叠状态（inline）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不處理附件摺疊狀態（inline）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не учтено свёрнутое (inline) состояние accessory"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tratar el estado colapsado (inline) del accesorio"
          }
        },
        "de": {
          "stringUnit": {
