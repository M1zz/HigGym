            "state": "translated",
            "value": "Stappen tussen **medium ↔ large**, waarbij de grabber \"er is meer\" signaleert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechodzenie między **medium ↔ large**, z grabberem sygnalizującym „jest więcej”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stegning mellan **medium ↔ large**, där greppet signalerar ”det finns mer”"
          }
        },
        "tr": {
          "stringUnit": {
