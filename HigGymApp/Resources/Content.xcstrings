        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**姓與名的順序**是文化圈的規則，禁止硬編碼"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Порядок фамилии и имени** - правило региона; никогда не зашивайте его"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**El orden de apellido y nombre** es una regla cultural; nunca lo fijes a mano"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Die Reihenfolge von Familien- und Vorname** ist eine kulturelle Regel; programmiere sie nie fest ein"
          }
        },
        "fr": {
          "stringUnit": {
