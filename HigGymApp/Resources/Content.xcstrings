          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละทีมสร้างหน้าจอของตัวเอง แท็บจึงลงเอยสะท้อนองค์กร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi nhóm tự dựng màn hình của mình, nên các tab rốt cuộc phản chiếu tổ chức."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý tým postavil vlastní obrazovky, takže karty nakonec zrcadlí organizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert team byggede sine egne skærme, så fanerne endte med at spejle organisationen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε ομάδα έφτιαξε τις δικές της οθόνες, οπότε οι καρτέλες κατέληξαν να αντικατοπτρίζουν τον οργανισμό."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen tiimi rakensi omat näkymänsä, joten välilehdet päätyivät peilaamaan organisaatiota."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tim membuat layarnya sendiri, sehingga tab akhirnya mencerminkan organisasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert team bygde sine egne skjermer, så fanene endte opp med å speile organisasjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk team bouwde zijn eigen schermen, dus de tabbladen weerspiegelden uiteindelijk de organisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy zespół zbudował własne ekrany, więc karty odzwierciedlają organizację."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje team byggde sina egna skärmar, så flikarna speglade till slut organisationen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ekip kendi ekranlarını kurdu, bu yüzden sekmeler organizasyonu yansıtır hale geldi."
          }
        }
      }
    },
    "파괴적 액션은 구분선 아래·맨 끝에 두고 role: .destructive를 준다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put destructive actions below a divider, at the very end, and give them role: .destructive."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put destructive actions below a divider, at the very end, and give them role: .destructive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "破壊的なアクションは区切り線の下、いちばん最後に置き、role: .destructiveを指定する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "破坏性操作放在分隔线下面、最末尾，并设置 role: .destructive。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "破壞性操作放在分隔線下面、最末尾，並設定 role: .destructive。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещайте разрушительные действия под разделителем, в самом конце, и задавайте им role: .destructive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon las acciones destructivas bajo un divisor, al final del todo, y dales role: .destructive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze zerstörerische Aktionen unter einen Divider, ganz ans Ende, und gib ihnen role: .destructive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez les actions destructives sous un séparateur, tout à la fin, et donnez-leur role: .destructive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti le azioni distruttive sotto un divisore, proprio in fondo, e dai loro role: .destructive."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponha as ações destrutivas abaixo de um divisor, bem no fim, e dê a elas role: .destructive."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางการกระทำที่ทำลายข้อมูลใต้เส้นคั่น ท้ายสุด และให้ role: .destructive"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt hành động phá hủy dưới một đường phân cách, ở tận cuối, và gán role: .destructive."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Destruktivní akce dejte pod dělicí čáru, úplně na konec, a dejte jim role: .destructive."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg destruktive handlinger under en skillelinje, helt til sidst, og giv dem role: .destructive."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε τις καταστροφικές ενέργειες κάτω από μια γραμμή διαχωρισμού, στο τέλος, και δώσ' τους role: .destructive."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita tuhoavat toiminnot jakajan alle, aivan loppuun, ja anna niille role: .destructive."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh aksi destruktif di bawah pembatas, di paling akhir, dan beri role: .destructive."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg destruktive handlinger under en skillelinje, helt til slutt, og gi dem role: .destructive."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet destructieve acties onder een scheidingslijn, helemaal aan het eind, en geef ze role: .destructive."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akcje destrukcyjne umieść pod separatorem, na samym końcu, i nadaj im role: .destructive."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg destruktiva åtgärder under en avskiljare, allra sist, och ge dem role: .destructive."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıkıcı eylemleri bir ayırıcının altına, en sona koy ve onlara role: .destructive ver."
          }
        }
      }
    },
    "파일 경로는 .middle": {
      "extractionState": "manual",
      "localizations": {
