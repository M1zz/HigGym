        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**กึ่งกลางพอดี (principal)**: ช่องชื่อเรื่องถูกยึดโดยตัวควบคุมที่กำหนดหน้าจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Chính giữa (principal)**: ô tiêu đề bị điều khiển xác định màn hình chiếm"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Přesný střed (principal)**: místo nadpisu zabere ovladač, který definuje obrazovku"
          }
        },
        "da": {
