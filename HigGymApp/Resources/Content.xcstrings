          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft et hard mélangés écran par écran sans règle, perdant la cohérence"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft e hard mescolati schermata per schermata senza alcuna regola, perdendo coerenza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft e hard misturados tela por tela sem regra nenhuma, perdendo consistência"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผสม soft และ hard ทีละหน้าจอโดยไม่มีกฎ เสียความสอดคล้อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trộn soft và hard theo từng màn hình mà không có quy tắc, mất tính nhất quán"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft a hard smíchané po obrazovkách bez pravidla, ztráta konzistence"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft og hard blandet skærm for skærm uden nogen regel, så ensartetheden går tabt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft και hard ανακατεμένα οθόνη προς οθόνη χωρίς κανόνα, με απώλεια συνέπειας"
          }
        }
      }
    },
    "화면마다 다르면 들쭉날쭉해 보여서, 하나로 통일하는 게 일관성이라고 생각한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Different sizes on different screens look uneven, so unifying them seems like consistency."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Different sizes on different screens look uneven, so unifying them seems like consistency."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ごとに違うとちぐはぐに見えるので、ひとつに統一するのが一貫性だと考える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个界面不一样，看起来参差不齐，所以认为统一成一个才是一致性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個介面不一樣，看起來參差不齊，所以認為統一成一個才是一致性。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разные размеры на разных экранах выглядят неровно, поэтому унификация кажется единообразием."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaños distintos en pantallas distintas se ven desiguales, así que unificarlos parece coherencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterschiedliche Größen auf verschiedenen Bildschirmen wirken uneinheitlich, also scheint Vereinheitlichen Konsistenz zu sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des tailles différentes sur différents écrans paraissent inégales, donc les uniformiser semble de la cohérence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensioni diverse in schermate diverse sembrano irregolari, quindi unificarle sembra coerenza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanhos diferentes em telas diferentes parecem irregulares, então uniformizá-los parece consistência."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดต่างกันในแต่ละหน้าจอดูไม่เรียบ การทำให้เหมือนกันจึงดูเหมือนความสอดคล้อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cỡ khác nhau trên các màn hình khác nhau trông không đều, nên thống nhất có vẻ là nhất quán."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Různé velikosti na různých obrazovkách vypadají nerovnoměrně, takže jejich sjednocení se zdá konzistentní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forskellige størrelser på forskellige skærme ser ujævne ud, så at forene dem virker som ensartethed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαφορετικά μεγέθη σε διαφορετικές οθόνες φαίνονται ανομοιόμορφα, οπότε η ενοποίησή τους μοιάζει με συνέπεια."
          }
        }
      }
    },
    "화면마다 제목 크기가 다르면 들쭉날쭉해 보인다. 하나로 맞추면 앱 전체가 정돈돼 보이고, 그게 일관성이라고 생각하기 쉽다. 디자인 시스템에 제목 크기를 하나만 적어 두는 편이 관리하기도 쉽다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If title sizes differ from screen to screen, things look uneven. Matching them makes the whole app look tidy, and it's easy to think that's consistency. Listing just one title size in the design system is also easier to maintain."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If title sizes differ from screen to screen, things look uneven. Matching them makes the whole app look tidy, and it's easy to think that's consistency. Listing just one title size in the design system is also easier to maintain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ごとにタイトルの大きさが違うと、ちぐはぐに見える。ひとつにそろえればアプリ全体が整って見え、それが一貫性だと思いやすい。デザインシステムにタイトルサイズをひとつだけ書いておくほうが、管理もしやすい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个界面标题大小不同，看起来参差不齐。统一成一个，整个应用显得整齐，容易认为这就是一致性。设计系统里只写一个标题大小，管理起来也容易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個介面標題大小不同，看起來參差不齊。統一成一個，整個應用程式顯得整齊，容易認為這就是一致性。設計系統裡只寫一個標題大小，管理起來也容易。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если размеры заголовков различаются от экрана к экрану, выглядит неровно. Выровняйте их, и всё приложение выглядит аккуратно, и легко решить, что это и есть единообразие. Указать в дизайн-системе лишь один размер заголовка к тому же проще поддерживать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los tamaños de título difieren de una pantalla a otra, todo se ve desigual. Igualarlos hace que toda la app se vea ordenada, y es fácil pensar que eso es coherencia. Listar un solo tamaño de título en el sistema de diseño también es más fácil de mantener."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterscheiden sich die Titelgrößen von Bildschirm zu Bildschirm, wirkt es uneinheitlich. Gleiche Größen lassen die ganze App ordentlich aussehen, und man hält das leicht für Konsistenz. Auch nur eine Titelgröße im Designsystem aufzuführen, ist leichter zu pflegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les tailles de titre diffèrent d'un écran à l'autre, tout paraît inégal. Les égaliser fait paraître toute l'app bien rangée, et on pense facilement que c'est de la cohérence. Ne lister qu'une seule taille de titre dans le système de design est aussi plus facile à maintenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se le dimensioni dei titoli cambiano da schermata a schermata, le cose sembrano irregolari. Uniformarle fa sembrare ordinata l'intera app, ed è facile pensare che sia coerenza. Elencare una sola dimensione di titolo nel design system è anche più facile da mantenere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os tamanhos dos títulos diferem de tela para tela, as coisas parecem irregulares. Igualá-los faz o app inteiro parecer arrumado, e é fácil achar que isso é consistência. Listar um único tamanho de título no design system também é mais fácil de manter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าขนาดชื่อเรื่องต่างกันไปแต่ละหน้าจอ ดูไม่เรียบ การทำให้ตรงกันทำให้ทั้งแอปดูเป็นระเบียบ และคิดง่าย ๆ ว่านั่นคือความสอดคล้อง การลิสต์ขนาดชื่อเรื่องเดียวในระบบดีไซน์ก็ดูแลง่ายกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu cỡ tiêu đề khác nhau giữa các màn hình thì trông không đều. Cho khớp nhau khiến cả app trông gọn, và dễ nghĩ đó là nhất quán. Chỉ liệt kê một cỡ tiêu đề trong hệ thống thiết kế cũng dễ bảo trì hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se velikosti nadpisů liší od obrazovky k obrazovce, věci vypadají nerovnoměrně. Sjednocení nechá celou aplikaci vypadat úhledně a snadno si myslíte, že to je konzistence. Uvést v designovém systému jen jednu velikost nadpisu se také snáz udržuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis titelstørrelserne er forskellige fra skærm til skærm, ser tingene ujævne ud. At matche dem får hele appen til at se ryddelig ud, og det er let at tro, at det er ensartethed. At opføre kun én titelstørrelse i designsystemet er også lettere at vedligeholde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν τα μεγέθη τίτλου διαφέρουν από οθόνη σε οθόνη, τα πράγματα φαίνονται ανομοιόμορφα. Το να τα ταιριάξεις κάνει ολόκληρη την εφαρμογή να φαίνεται τακτοποιημένη, και είναι εύκολο να νομίσεις ότι αυτή είναι συνέπεια. Το να καταγράψεις ένα μόνο μέγεθος τίτλου στο design system είναι επίσης ευκολότερο στη συντήρηση."
          }
        }
      }
    },
    "화면별로 따로 만들다 보니 그때그때 예뻐 보이는 쪽을 고른다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building each screen separately, you pick whichever looks nicer at the time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Building each screen separately, you pick whichever looks nicer at the time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ごとに別々に作るうちに、その都度きれいに見えるほうを選ぶ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按界面分头做，就挑当时看起来好看的那个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按介面分頭做，就挑當時看起來好看的那個。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строя каждый экран отдельно, вы выбираете то, что в данный момент выглядит красивее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construyendo cada pantalla por separado, eliges lo que en ese momento se ve mejor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baust du jeden Bildschirm einzeln, wählst du, was gerade schöner aussieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En construisant chaque écran séparément, vous choisissez ce qui paraît le plus joli sur le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruendo ogni schermata separatamente, scegli quello che in quel momento sembra più bello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Construindo cada tela separadamente, você escolhe o que na hora parece mais bonito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างทีละหน้าจอ คุณเลือกอันที่ดูดีกว่าในตอนนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xây từng màn hình riêng, bạn chọn cái nào trông đẹp hơn lúc đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stavíte-li každou obrazovku zvlášť, vyberete, co v tu chvíli vypadá lépe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du bygger hver skærm for sig, vælger du det, der ser pænest ud dengang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτιάχνοντας κάθε οθόνη χωριστά, διαλέγεις ό,τι φαίνεται ωραιότερο εκείνη τη στιγμή."
          }
        }
      }
    },
    "화면에 보일 문자열을 그대로 만드는 게 가장 빠르고 확실하다. 보이는 그대로 적었으니 틀릴 곳이 없어 보인다. 만드는 사람의 기기에서는 정확히 원하던 모습으로 나온다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building the exact string to display is the fastest and most reliable approach. You wrote exactly what you see, so it seems nothing can go wrong. On the developer's own device, it looks exactly as intended."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Building the exact string to display is the fastest and most reliable approach. You wrote exactly what you see, so it seems nothing can go wrong. On the developer's own device, it looks exactly as intended."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に表示する文字列をそのまま作るのが、いちばん速くて確実だ。見えるとおりに書いたので、間違えようがないように見える。作る人のデバイスでは、まさに思いどおりの姿で表示される。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把要显示在界面上的字符串直接拼出来，最快最确定。写的就是看到的样子，似乎没有出错的地方。在做的人的设备上，它正好呈现为想要的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把要顯示在介面上的字串直接拼出來，最快最確定。寫的就是看到的樣子，似乎沒有出錯的地方。在做的人的裝置上，它正好呈現為想要的樣子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Составить точную строку для показа - самый быстрый и надёжный способ. Вы написали ровно то, что видите, поэтому кажется, что ничего не может пойти не так. На собственном устройстве разработчика всё выглядит ровно так, как задумано."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Montar la cadena exacta que se muestra es el enfoque más rápido y fiable. Escribiste exactamente lo que ves, así que parece que nada puede salir mal. En el propio dispositivo del desarrollador, se ve exactamente como se pretendía."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den exakten anzuzeigenden String zu bauen ist der schnellste und verlässlichste Weg. Du hast genau geschrieben, was du siehst, also scheint nichts schiefgehen zu können. Auf dem eigenen Gerät des Entwicklers sieht es genau wie beabsichtigt aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construire la chaîne exacte à afficher est l'approche la plus rapide et la plus fiable. Vous avez écrit exactement ce que vous voyez, donc il semble que rien ne puisse mal tourner. Sur l'appareil du développeur, cela a exactement l'aspect voulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruire la stringa esatta da mostrare è l'approccio più rapido e affidabile. Hai scritto esattamente ciò che vedi, quindi sembra che nulla possa andare storto. Sul dispositivo dello sviluppatore, appare esattamente come previsto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Montar a string exata a exibir é a abordagem mais rápida e confiável. Você escreveu exatamente o que vê, então parece que nada pode dar errado. No dispositivo do próprio desenvolvedor, fica exatamente como pretendido."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสร้างสตริงที่จะแสดงตรง ๆ เป็นวิธีที่เร็วและเชื่อถือได้ที่สุด คุณเขียนสิ่งที่เห็นเป๊ะ ๆ จึงดูเหมือนไม่มีอะไรผิดได้ บนอุปกรณ์ของนักพัฒนาเอง มันดูตามที่ตั้งใจเป๊ะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dựng đúng chuỗi cần hiển thị là cách nhanh và đáng tin nhất. Bạn viết đúng thứ mình thấy, nên có vẻ không thể sai. Trên thiết bị của chính nhà phát triển, nó trông đúng như ý."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sestavit přesný řetězec k zobrazení je nejrychlejší a nejspolehlivější přístup. Napsali jste přesně to, co vidíte, takže se zdá, že se nemůže nic pokazit. Na vlastním zařízení vývojáře to vypadá přesně, jak bylo zamýšleno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At bygge den præcise streng, der skal vises, er den hurtigste og mest pålidelige fremgangsmåde. Du skrev præcis det, du ser, så det ser ud til, at intet kan gå galt. På udviklerens egen enhed ser det præcis ud som tilsigtet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το να φτιάξεις την ακριβή συμβολοσειρά που θα εμφανιστεί είναι ο πιο γρήγορος και αξιόπιστος τρόπος. Έγραψες ακριβώς αυτό που βλέπεις, οπότε φαίνεται ότι τίποτα δεν μπορεί να πάει στραβά. Στη δική σου συσκευή ανάπτυξης, φαίνεται ακριβώς όπως σχεδιάστηκε."
          }
        }
      }
    },
    "화면에 보일 문자열을 그대로 만드는 게 가장 빠르고 확실해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
