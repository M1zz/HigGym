            "value": "写真の上のコントロールの背景に.thinMaterial"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片上控件的背景用 .thinMaterial"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片上控制元件的背景用 .thinMaterial"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".thinMaterial под элементами управления над фотографией"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ".thinMaterial detrás de los controles sobre una foto"
          }
        },
        "de": {
