    "깊이와 무관하게 모든 화면의 제목 크기를 똑같이 쓴다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the same title size on every screen regardless of depth"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the same title size on every screen regardless of depth"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "階層の深さに関係なく、すべての画面で同じタイトルサイズを使う"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不管深度，所有界面的标题大小都一样"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不管深度，所有介面的標題大小都一樣"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одинаковый размер заголовка на каждом экране независимо от глубины"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar el mismo tamaño de título en todas las pantallas sin importar la profundidad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Titelgröße auf jedem Bildschirm nutzen, unabhängig von der Tiefe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser la même taille de titre sur chaque écran quelle que soit la profondeur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usare la stessa dimensione del titolo in ogni schermata a prescindere dalla profondità"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
