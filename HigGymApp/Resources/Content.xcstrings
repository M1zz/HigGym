        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kolejność nazwiska i imienia** to reguła kulturowa; nigdy nie wpisuj jej na stałe"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
