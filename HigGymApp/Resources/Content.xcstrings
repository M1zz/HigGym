    "남는 자리를 '더보기' 잡동사니 탭으로 채운다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filling a leftover slot with a catch-all \"More\" tab"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Filling a leftover slot with a catch-all \"More\" tab"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "余った枠を「その他」の寄せ集めタブで埋める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把剩下的位置用“更多”杂物标签填满"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把剩下的位置用「更多」雜物標籤填滿"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполнение оставшегося места вкладкой-всеядкой «Ещё»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenar un hueco sobrante con una pestaña cajón de sastre «Más»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen übrig gebliebenen Platz mit einem Sammel-Tab „Mehr“ füllen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir un emplacement restant avec un onglet fourre-tout « Plus »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempire lo slot rimasto con una scheda «Altro» ripostiglio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencher um lugar que sobrou com uma aba coringa «Mais»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เติมช่องที่เหลือด้วยแท็บ \"เพิ่มเติม\" ที่รวมทุกอย่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấp ô còn thừa bằng tab \"Thêm\" gom đủ thứ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplnění zbylého slotu univerzální kartou „Více“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At fylde en tilbageværende plads med en samlefane »Mere«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γέμισμα μιας υπολειπόμενης θέσης με μια καρτέλα-σάκο «Περισσότερα»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäljelle jääneen paikan täyttäminen kaikenkattavalla ”Lisää”-välilehdellä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengisi slot sisa dengan tab serba ada \"Lainnya\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å fylle en overskuddsplass med en «Mer»-fane som tar alt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een overgebleven plek vullen met een verzamel-tabblad \"Meer\""
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnianie pozostałego miejsca zbiorczą kartą „Więcej”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att fylla en överbliven plats med en allt-i-ett-flik ”Mer”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artan bir yeri her şeyi kapsayan bir “Daha Fazla” sekmesiyle doldurmak"
          }
        }
      }
    },
