        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Крупный заголовок 34 pt** под панелью навигации. При прокрутке автоматически сжимается до маленького inline-заголовка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **título grande de 34 pt** bajo la barra de navegación. Se reduce automáticamente a un título inline pequeño al desplazar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein **34-pt-Large-Titel** unter der Navigationsleiste. Beim Scrollen schrumpft er automatisch zu einem kleinen Inline-Titel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **grand titre de 34 pt** sous la barre de navigation. Il rétrécit automatiquement en petit titre inline au défilement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **titolo grande da 34 pt** sotto la barra di navigazione. Si rimpicciolisce automaticamente in un piccolo titolo inline durante lo scorrimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um **título grande de 34 pt** abaixo da barra de navegação. Encolhe automaticamente para um pequeno título inline ao rolar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ชื่อเรื่องขนาดใหญ่ 34pt** ใต้แถบนำทาง มันหดเป็นชื่อเรื่อง inline เล็กโดยอัตโนมัติเมื่อเลื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tiêu đề lớn 34pt** dưới thanh điều hướng. Nó tự thu nhỏ thành tiêu đề inline nhỏ khi cuộn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**34pt velký nadpis** pod navigačním panelem. Při posouvání se automaticky zmenší na malý inline nadpis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En **34 pt stor titel** under navigationsbjælken. Den skrumper automatisk til en lille inline-titel, mens du scroller."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας **μεγάλος τίτλος 34 pt** κάτω από τη γραμμή πλοήγησης. Μικραίνει αυτόματα σε μικρό inline τίτλο καθώς κυλάς."
          }
        }
      }
    },
    "내비바 제목 **아래 서랍**에 검색바, 전통적(iOS 25 이전) 위치. 기본은 **스크롤하면 접힘**.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A search bar in **the drawer below** the navigation bar title, the traditional position (before iOS 25). By default it **collapses as you scroll**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A search bar in **the drawer below** the navigation bar title, the traditional position (before iOS 25). By default it **collapses as you scroll**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションバーのタイトルの**下の引き出し**に検索バー。従来の（iOS 25以前の）位置。デフォルトでは**スクロールすると折りたたまれる**。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索栏在导航栏标题**下方的抽屉**里，传统（iOS 25 之前）的位置。默认**滚动时折叠**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋列在導覽列標題**下方的抽屜**裡，傳統（iOS 25 之前）的位置。預設**滾動時摺疊**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка поиска в **выдвижной панели под** заголовком панели навигации, традиционное расположение (до iOS 25). По умолчанию **сворачивается при прокрутке**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra de búsqueda en **el cajón bajo** el título de la barra de navegación, la posición tradicional (antes de iOS 25). Por defecto **se colapsa al desplazar**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Suchleiste in **der Schublade unter** dem Titel der Navigationsleiste, die traditionelle Position (vor iOS 25). Standardmäßig **klappt sie beim Scrollen zusammen**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre de recherche dans **le tiroir sous** le titre de la barre de navigation, la position traditionnelle (avant iOS 25). Par défaut, elle **se replie au défilement**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra di ricerca nel **cassetto sotto** il titolo della barra di navigazione, la posizione tradizionale (prima di iOS 25). Per impostazione predefinita **si comprime durante lo scorrimento**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra de busca na **gaveta abaixo** do título da barra de navegação, a posição tradicional (antes do iOS 25). Por padrão **recolhe ao rolar**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบค้นหาใน**ลิ้นชักด้านล่าง**ชื่อเรื่องของแถบนำทาง ตำแหน่งดั้งเดิม (ก่อน iOS 25) โดยค่าเริ่มต้นมัน**ยุบเมื่อเลื่อน**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tìm kiếm trong **ngăn kéo bên dưới** tiêu đề thanh điều hướng, vị trí truyền thống (trước iOS 25). Mặc định nó **thu lại khi cuộn**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávací pole v **zásuvce pod** nadpisem navigačního panelu, tradiční pozice (před iOS 25). Ve výchozím stavu se **sbalí při posouvání**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En søgebjælke i **skuffen under** navigationsbjælkens titel, den traditionelle position (før iOS 25). Som standard **folder den sammen, mens du scroller**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γραμμή αναζήτησης στο **συρτάρι κάτω** από τον τίτλο της γραμμής πλοήγησης, η παραδοσιακή θέση (πριν το iOS 25). Από προεπιλογή **συμπτύσσεται καθώς κυλάς**."
          }
        }
      }
    },
