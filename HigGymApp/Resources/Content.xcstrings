    "**화면 전체**를 덮는 강한 모달, 출구는 명시적 버튼뿐": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A strong modal covering **the entire screen**, whose only exit is an explicit button"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A strong modal covering **the entire screen**, whose only exit is an explicit button"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**画面全体**を覆う強いモーダル。出口は明示的なボタンだけ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖**整个屏幕**的强模态，出口只有明确的按钮"
