    "카드 탭 → 그 카드의 상세 시트로 확대": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a card → it expands into that card's detail sheet"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a card → it expands into that card's detail sheet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードをタップ → そのカードの詳細シートへ拡大"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
