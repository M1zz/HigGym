          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยุบเมื่อเลื่อน ↓"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu lại khi cuộn ↓"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbalí se při posouvání ↓"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder sammen ved scroll ↓"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμπτύσσεται στην κύλιση ↓"
          }
        }
      }
    },
    "스크롤 내리면 탭바가 **작게 접힘**, 콘텐츠에 자리 양보": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll down and the tab bar **collapses**, giving room to the content"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll down and the tab bar **collapses**, giving room to the content"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールするとタブバーが**小さく折りたたまれ**、コンテンツに場所を譲る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向下滚动时标签栏**缩成小条**，把位置让给内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向下滾動時標籤列**縮成小條**，把位置讓給內容"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите вниз, и панель вкладок **сворачивается**, уступая место контенту"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate hacia abajo y la barra de pestañas **se colapsa**, dejando sitio al contenido"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle nach unten, und die Tab-Leiste **klappt zusammen** und gibt dem Inhalt Raum"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler vers le bas et la barre d'onglets **se replie**, laissant de la place au contenu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri in basso e la barra delle schede **si comprime**, dando spazio al contenuto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role para baixo e a barra de abas **recolhe**, dando espaço ao conteúdo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนลง แล้วแถบแท็บ**ยุบ** เว้นที่ให้เนื้อหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộn xuống và thanh tab **thu lại**, nhường chỗ cho nội dung"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte dolů a panel karet se **sbalí** a uvolní místo obsahu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll nedad, og fanelinjen **folder sammen** og giver plads til indholdet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κύλισε προς τα κάτω και η γραμμή καρτελών **συμπτύσσεται**, δίνοντας χώρο στο περιεχόμενο"
          }
        }
      }
    },
    "스크롤 시 접히는 게 기본인 이유, 스크롤 중이라는 건 **탐색이 아니라 읽는 중**이라는 신호이므로, 안 쓰는 검색바에 세로 공간을 주지 않음(minimization). 필요하면 맨 위로 당겨서 다시 꺼내는 관습이 이미 학습돼 있음.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why collapsing on scroll is the default: scrolling signals that the user is **reading, not searching**, so an unused search bar gets no vertical space (minimization). If people need it, the convention of pulling back to the top to bring it out again is already learned."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Why collapsing on scroll is the default: scrolling signals that the user is **reading, not searching**, so an unused search bar gets no vertical space (minimisation). If people need it, the convention of pulling back to the top to bring it out again is already learned."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールで折りたたまれるのがデフォルトである理由：スクロール中だということは、**探しているのではなく読んでいる**というサインなので、使わない検索バーに縦のスペースを与えない（minimization）。必要なら一番上まで引っぱって再び出す、という慣習はすでに身についている。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动时折叠是默认，因为滚动中是**在阅读而不是探索**的信号，不把纵向空间给不用的搜索栏（minimization）。需要时，拉到最上面再唤出的习惯已经被学会了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動時摺疊是預設，因為滾動中是**在閱讀而不是探索**的訊號，不把縱向空間給不用的搜尋列（minimization）。需要時，拉到最上面再喚出的習慣已經被學會了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему сворачивание при прокрутке - значение по умолчанию: прокрутка сигнализирует, что пользователь **читает, а не ищет**, поэтому неиспользуемая строка поиска не получает вертикального места (минимизация). Если оно людям нужно, привычка вернуться наверх, чтобы снова вызвать его, уже усвоена."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué colapsar al desplazar es el valor por defecto: el desplazamiento indica que el usuario está **leyendo, no buscando**, así que una barra de búsqueda sin usar no recibe espacio vertical (minimización). Si la gente la necesita, la convención de volver arriba para sacarla de nuevo ya está aprendida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum das Zusammenklappen beim Scrollen der Standard ist: Scrollen signalisiert, dass der Nutzer **liest und nicht sucht**, sodass eine ungenutzte Suchleiste keinen vertikalen Platz bekommt (Minimierung). Brauchen Menschen sie, ist die Konvention, zum Anfang zurückzuziehen, um sie wieder hervorzuholen, bereits gelernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi le repli au défilement est le réglage par défaut : défiler signale que l'utilisateur **lit et ne cherche pas**, si bien qu'une barre de recherche inutilisée n'obtient pas d'espace vertical (minimisation). Si les gens en ont besoin, la convention de remonter tout en haut pour la faire réapparaître est déjà apprise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché comprimersi allo scorrimento è il predefinito: scorrere segnala che l'utente sta **leggendo, non cercando**, quindi una barra di ricerca inutilizzata non riceve spazio verticale (minimizzazione). Se le persone ne hanno bisogno, la convenzione di tornare in cima per farla riapparire è già appresa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que recolher ao rolar é o padrão: rolar sinaliza que o usuário está **lendo, não buscando**, então uma barra de busca sem uso não recebe espaço vertical (minimização). Se as pessoas precisam dela, a convenção de voltar ao topo para trazê-la de novo já foi aprendida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไมการยุบเมื่อเลื่อนจึงเป็นค่าเริ่มต้น: การเลื่อนส่งสัญญาณว่าผู้ใช้**กำลังอ่าน ไม่ได้ค้นหา** แถบค้นหาที่ไม่ได้ใช้จึงไม่ได้พื้นที่แนวตั้ง (การย่อ) ถ้าคนต้องการ ธรรมเนียมการดึงกลับไปบนสุดเพื่อเรียกมันออกมาอีกครั้งก็เรียนรู้ไว้แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao thu lại khi cuộn là mặc định: cuộn báo hiệu người dùng đang **đọc, không tìm kiếm**, nên thanh tìm kiếm không dùng không được chỗ dọc (tối thiểu hóa). Nếu người ta cần, quy ước kéo ngược lên đầu để gọi nó ra đã được học."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proč je sbalení při posouvání výchozí: posouvání signalizuje, že uživatel **čte, nehledá**, takže nepoužívané vyhledávací pole nedostane svislé místo (minimalizace). Pokud ho lidé potřebují, konvence potáhnout zpět nahoru, aby se znovu vynořilo, je už naučená."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor sammenfoldning ved scroll er standarden: scrolling signalerer, at brugeren **læser, ikke søger**, så en ubrugt søgebjælke får ikke lodret plads (minimering). Hvis folk har brug for den, er konventionen om at trække tilbage til toppen for at få den frem igen allerede lært."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γιατί η σύμπτυξη στην κύλιση είναι η προεπιλογή: η κύλιση σηματοδοτεί ότι ο χρήστης **διαβάζει, δεν ψάχνει**, οπότε μια ανεχρησιμοποίητη γραμμή αναζήτησης δεν παίρνει κάθετο χώρο (ελαχιστοποίηση). Αν οι άνθρωποι τη χρειαστούν, η σύμβαση του τραβήγματος πίσω στην κορυφή για να την ξαναφέρουν έχει ήδη μαθευτεί."
          }
        }
      }
    },
    "스크롤 시 탭바만 접힘": {
