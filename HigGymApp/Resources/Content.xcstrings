        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Top and bottom at once**, both unified with a soft fade"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Top and bottom at once**, both unified with a soft fade"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**上下同時**。どちらもsoftのフェードで統一"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
