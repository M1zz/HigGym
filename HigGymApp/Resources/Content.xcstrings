          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλωτή τοποθέτηση της μόνης ενέργειας σε προσαρμοσμένο κουμπί αντί για τη θέση συστήματος"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainoan toiminnon kelluttaminen mukautetussa painikkeessa järjestelmän paikan sijaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambangkan satu-satunya aksi dalam tombol kustom alih-alih slot sistem"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å la den eneste handlingen flyte i en egendefinert knapp i stedet for systemets plass"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De enige actie laten zweven in een aangepaste knop in plaats van de systeemplek"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawieszenie jedynej akcji we własnym przycisku zamiast w miejscu systemowym"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att låta den enda åtgärden sväva i en egen knapp i stället för systemplatsen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek eylemi sistem yuvası yerine özel bir düğmede yüzdürmek"
          }
        }
      }
    },
