    "아이콘 + **한 단어 제목**, 탭 아이템의 표준형": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon + **a one-word title**, the standard form of a tab item"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon + **a one-word title**, the standard form of a tab item"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコン + **一語のタイトル**。タブアイテムの標準形"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标 + **一个词的标题**，标签项的标准形态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示 + **一個詞的標題**，標籤項的標準形態"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок + **заголовок из одного слова**, стандартная форма элемента вкладки"
