        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rekkefølgen på etternavn og fornavn** er en kulturell regel; hardkod den aldri"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**De volgorde van achternaam en voornaam** is een culturele regel; hardcodeer hem nooit"
