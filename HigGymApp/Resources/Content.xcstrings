    "양쪽 모두 여러 아이템, 왼쪽 캡슐 하나, 오른쪽 캡슐 하나로 **두 개의 독립 그룹**.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple items on both sides, one capsule on the left and one on the right, forming **two independent groups**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple items on both sides, one capsule on the left and one on the right, forming **two independent groups**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両側とも複数のアイテム。左にカプセルがひとつ、右にカプセルがひとつで、**2つの独立したグループ**。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两侧都有多个项目，左侧一个胶囊，右侧一个胶囊，是**两个独立的组**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩側都有多個項目，左側一個膠囊，右側一個膠囊，是**兩個獨立的組**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько элементов с обеих сторон, одна капсула слева и одна справа, образующие **две независимые группы**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varios elementos en ambos lados, una cápsula a la izquierda y otra a la derecha, formando **dos grupos independientes**."
          }
        }
      }
    },
    "양쪽 모두 잠식": {
      "extractionState": "manual",
