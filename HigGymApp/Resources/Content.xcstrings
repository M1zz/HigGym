    ".minimize는 \"검색을 숨기는\" 게 아니라 \"접는\" 것, 검색을 거의 안 쓰는 화면이라면 애초에 searchable을 빼는 게 맞습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize doesn't \"hide\" search, it \"folds\" it. If a screen barely uses search, the right move is to drop searchable altogether."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize doesn't \"hide\" search, it \"folds\" it. If a screen barely uses search, the right move is to drop searchable altogether."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimizeは検索を「隠す」のではなく「折りたたむ」もの。検索をほとんど使わない画面なら、そもそもsearchableを外すのが正解です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize 不是“隐藏”搜索而是“折叠”。如果是几乎不用搜索的界面，从一开始就不该加 searchable。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize 不是「隱藏」搜尋而是「摺疊」。如果是幾乎不用搜尋的介面，從一開始就不該加 searchable。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize не «прячет» поиск, а «сворачивает» его. Если экран почти не использует поиск, правильно вообще убрать searchable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize no «oculta» la búsqueda, la «pliega». Si una pantalla apenas usa la búsqueda, lo correcto es quitar searchable por completo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize „blendet“ die Suche nicht aus, es „faltet“ sie. Wird die Suche auf einem Bildschirm kaum genutzt, ist es richtig, searchable ganz wegzulassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize ne « cache » pas la recherche, il la « replie ». Si un écran n'utilise presque pas la recherche, la bonne décision est de supprimer searchable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize non «nasconde» la ricerca, la «ripiega». Se una schermata usa appena la ricerca, la mossa giusta è eliminare del tutto searchable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize não «esconde» a busca, ela «dobra». Se uma tela mal usa a busca, a atitude certa é abrir mão do searchable por completo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize ไม่ได้ \"ซ่อน\" การค้นหา แต่ \"พับ\" มัน ถ้าหน้าจอแทบไม่ใช้การค้นหา สิ่งที่ถูกคือเลิกใช้ searchable ไปเลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize không \"ẩn\" tìm kiếm, nó \"gập\" tìm kiếm. Nếu một màn hình gần như không dùng tìm kiếm, việc đúng là bỏ hẳn searchable."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize hledání „neschovává“, „sbaluje“ ho. Pokud obrazovka hledání skoro nepoužívá, správným krokem je searchable úplně vynechat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize »skjuler« ikke søgning, den »folder« den. Hvis en skærm næsten ikke bruger søgning, er det rigtige at droppe searchable helt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το .minimize δεν «κρύβει» την αναζήτηση, την «διπλώνει». Αν μια οθόνη σχεδόν δεν χρησιμοποιεί αναζήτηση, το σωστό είναι να αφήσεις εντελώς το searchable."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize ei ”piilota” hakua, se ”taittaa” sen. Jos näkymä käyttää hakua tuskin lainkaan, oikea siirto on jättää searchable kokonaan pois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize tidak \"menyembunyikan\" pencarian, melainkan \"melipatnya\". Jika sebuah layar hampir tidak memakai pencarian, langkah yang tepat adalah membuang searchable sama sekali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize «skjuler» ikke søk, det «folder» det. Hvis en skjerm nesten ikke bruker søk, er det riktige å droppe searchable helt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize \"verbergt\" zoeken niet, het \"vouwt\" het in. Als een scherm zoeken nauwelijks gebruikt, is de juiste zet om searchable helemaal weg te laten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize nie „ukrywa” wyszukiwania, tylko je „zwija”. Jeśli ekran prawie nie używa wyszukiwania, właściwym ruchem jest całkowite porzucenie searchable."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize ”döljer” inte sökningen, den ”viker” den. Om en skärm knappt använder sökning är det rätta draget att släppa searchable helt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".minimize aramayı “gizlemez”, “katlar”. Bir ekran aramayı pek kullanmıyorsa doğru hamle searchable'ı tamamen bırakmaktır."
          }
        }
      }
    },
    ".navigationTransition(.crossFade) 추가, zoom과 달리 **source view 지정 없이** 쓸 수 있는 교차 페이드 전환. \"출처는 의미 없지만 standard의 슬라이드 모션이 과한\" 화면을 위한 중간 선택지입니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) was added: a cross-fade transition you can use **without specifying a source view**, unlike zoom. It's a middle option for screens where \"the origin doesn't matter, but the standard slide feels like too much.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) was added: a cross-fade transition you can use **without specifying a source view**, unlike zoom. It's a middle option for screens where \"the origin doesn't matter, but the standard slide feels like too much.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade)が追加されました。zoomと違い、**source viewを指定せずに**使えるクロスフェードのトランジションです。「出どころに意味はないが、standardのスライドは大げさすぎる」画面のための中間の選択肢です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加上 .navigationTransition(.crossFade)：与 zoom 不同，**无需指定 source view** 就能使用的交叉淡入淡出转场。适合“来源没有意义，但 standard 的滑动动效又太过”的界面，是中间的选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加上 .navigationTransition(.crossFade)：與 zoom 不同，**無需指定 source view** 就能使用的交叉淡入淡出轉場。適合「來源沒有意義，但 standard 的滑動動效又太過」的介面，是中間的選擇。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлен .navigationTransition(.crossFade): переход с перекрёстным затуханием, который можно использовать **без указания source view**, в отличие от zoom. Это промежуточный вариант для экранов, где «источник значения не имеет, но стандартное выезжание слишком»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadió .navigationTransition(.crossFade): una transición de fundido cruzado que puedes usar **sin especificar una vista de origen**, a diferencia de zoom. Es una opción intermedia para pantallas donde «el origen no importa, pero el deslizamiento estándar parece demasiado»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) wurde hinzugefügt: ein Überblendungsübergang, den du **ohne Angabe einer Quellansicht** nutzen kannst, anders als zoom. Es ist eine Zwischenoption für Bildschirme, bei denen „die Herkunft egal ist, das Standard-Gleiten aber zu viel wirkt“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) a été ajouté : une transition en fondu enchaîné utilisable **sans préciser de vue source**, contrairement à zoom. C'est une option intermédiaire pour les écrans où « l'origine n'a pas d'importance, mais le glissement standard paraît excessif »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato aggiunto .navigationTransition(.crossFade): una transizione a dissolvenza incrociata che puoi usare **senza specificare una vista di origine**, a differenza dello zoom. È un'opzione intermedia per le schermate in cui «l'origine non conta, ma lo scorrimento standard sembra troppo»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi adicionado .navigationTransition(.crossFade): uma transição de dissolvência cruzada que você pode usar **sem especificar uma view de origem**, ao contrário do zoom. É uma opção intermediária para telas em que «a origem não importa, mas o deslize padrão parece demais»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม .navigationTransition(.crossFade) แล้ว: ทรานซิชันครอสเฟดที่ใช้ได้**โดยไม่ต้องระบุ view ต้นทาง** ต่างจาก zoom เป็นตัวเลือกกลางสำหรับหน้าจอที่ \"ต้นทางไม่สำคัญ แต่การเลื่อนมาตรฐานรู้สึกมากเกินไป\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) đã được thêm: một chuyển cảnh mờ chéo bạn có thể dùng **mà không cần chỉ định view nguồn**, khác với zoom. Đó là lựa chọn trung gian cho các màn hình mà \"nguồn gốc không quan trọng, nhưng kiểu trượt chuẩn thì có vẻ quá đà.\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přibyl .navigationTransition(.crossFade): přechod prolnutím, který lze použít **bez určení zdrojového view**, na rozdíl od zoomu. Je to střední možnost pro obrazovky, kde „na původu nezáleží, ale standardní vyjetí je moc“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) blev tilføjet: en overtoning, du kan bruge **uden at angive en kildevisning**, i modsætning til zoom. Det er en mellemløsning til skærme, hvor »oprindelsen er ligegyldig, men standardglidningen føles som for meget.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προστέθηκε το .navigationTransition(.crossFade): μια μετάβαση cross-fade που μπορείς να χρησιμοποιήσεις **χωρίς να καθορίσεις προβολή πηγής**, σε αντίθεση με το zoom. Είναι μια ενδιάμεση επιλογή για οθόνες όπου «η προέλευση δεν μετράει, αλλά το τυπικό σύρσιμο φαίνεται υπερβολικό»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) lisättiin: cross-fade-siirtymä, jota voit käyttää **ilman lähdenäkymän määrittämistä**, toisin kuin zoomia. Se on välivaihtoehto näkymille, joissa ”lähtöpaikalla ei ole väliä, mutta tavallinen liuku tuntuu liialliselta”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) ditambahkan: transisi cross-fade yang bisa dipakai **tanpa menentukan tampilan sumber**, tidak seperti zoom. Ini opsi tengah untuk layar yang \"asalnya tidak penting, tetapi geser standar terasa berlebihan.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) ble lagt til: en kryssfade-overgang du kan bruke **uten å angi en kildevisning**, i motsetning til zoom. Det er et mellomalternativ for skjermer der «opprinnelsen ikke betyr noe, men standardglidningen føles som for mye»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) is toegevoegd: een cross-fade-overgang die je kunt gebruiken **zonder bronweergave op te geven**, in tegenstelling tot zoom. Het is een tussenoptie voor schermen waar \"de herkomst er niet toe doet, maar de standaard slide te veel aanvoelt\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodano .navigationTransition(.crossFade): przejście z przenikaniem, którego możesz użyć **bez podawania widoku źródłowego**, w przeciwieństwie do zoom. To opcja pośrednia dla ekranów, gdzie „pochodzenie nie ma znaczenia, ale standardowe wsuwanie wydaje się zbyt mocne”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) lades till: en övertoningsövergång du kan använda **utan att ange en källvy**, till skillnad från zoom. Det är ett mellanalternativ för skärmar där ”ursprunget spelar ingen roll, men standardglidningen känns som för mycket”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.crossFade) eklendi: zoom'un aksine **kaynak görünüm belirtmeden** kullanabileceğin bir çapraz geçiş. “Kaynak önemli değil ama standart kayma fazla geliyor” olan ekranlar için bir ara seçenek."
          }
        }
      }
    },
    ".navigationTransition(.zoom(sourceID:in:))**탭한 요소에서 시트가 확대**되어 나오는 전환.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): a transition where **the sheet zooms out of the element you tapped**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): a transition where **the sheet zooms out of the element you tapped**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:))。**タップした要素からシートが拡大して**現れるトランジション。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:))弹层**从被点按的元素放大**出现的转场。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:))工作表**從被輕點的元素放大**出現的轉場。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): переход, в котором **шторка вырастает из нажатого элемента**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): una transición en la que **la hoja sale ampliándose del elemento que tocaste**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): ein Übergang, bei dem **das Sheet aus dem angetippten Element herauszoomt**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)) : une transition où **la feuille sort en zoomant de l'élément que vous avez touché**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): una transizione in cui **il foglio si ingrandisce dall'elemento che hai toccato**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): uma transição em que **a folha se amplia a partir do elemento em que você tocou**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): ทรานซิชันที่**ชีตซูมออกมาจากองค์ประกอบที่คุณแตะ**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): một chuyển cảnh mà **sheet phóng ra từ phần tử bạn đã chạm**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): přechod, kdy **sheet vyroste z prvku, na který jste klepli**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): en overgang, hvor **arket zoomer ud af det element, du trykkede på**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): μια μετάβαση όπου **το φύλλο κάνει zoom έξω από το στοιχείο που πάτησες**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): siirtymä, jossa **arkki zoomaa ulos napauttamastasi elementistä**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): transisi di mana **lembar membesar keluar dari elemen yang kamu ketuk**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): en overgang der **arket zoomer ut av elementet du trykket på**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): een overgang waarbij **de sheet uit het element zoomt waarop je tikte**."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): przejście, w którym **arkusz wyłania się z elementu, który stuknąłeś**."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): en övergång där **arket zoomar ut ur elementet du tryckte på**."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".navigationTransition(.zoom(sourceID:in:)): **sayfanın dokunduğun öğeden zoom ile açıldığı** bir geçiş."
          }
        }
      }
    },
    ".presentationBackgroundInteraction(.enabled(upThrough: .medium)), 시트가 떠 있는 동안에도 **뒤 콘텐츠를 조작 가능**. 딤이 없음.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **the content behind stays interactive** while the sheet is up. No dimming."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **the content behind stays interactive** while the sheet is up. No dimming."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium))。シートが表示されている間も**背後のコンテンツを操作できる**。ディミングなし。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium))，弹层悬浮期间也能**操作后面的内容**。没有压暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium))，工作表懸浮期間也能**操作後面的內容**。沒有壓暗。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): пока шторка открыта, **контент позади остаётся доступен**. Затемнения нет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **el contenido de detrás sigue siendo interactivo** mientras la hoja está abierta. Sin atenuación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **der Inhalt dahinter bleibt interaktiv**, solange das Sheet offen ist. Keine Abdunklung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)) : **le contenu derrière reste interactif** tant que la feuille est ouverte. Pas d'assombrissement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **il contenuto dietro resta interattivo** finché il foglio è aperto. Nessun oscuramento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **o conteúdo atrás continua interativo** enquanto a folha está aberta. Sem escurecimento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **เนื้อหาด้านหลังยังโต้ตอบได้**ขณะชีตเปิด ไม่มีการหรี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **nội dung phía sau vẫn tương tác được** khi sheet đang hiện. Không làm tối."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **obsah za sheetem zůstává interaktivní**, dokud je sheet nahoře. Žádné ztmavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **indholdet bagved forbliver interaktivt**, mens arket er oppe. Ingen dæmpning."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **το περιεχόμενο πίσω παραμένει διαδραστικό** ενώ το φύλλο είναι ανοιχτό. Χωρίς σκίαση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **taustalla oleva sisältö pysyy interaktiivisena** arkin ollessa esillä. Ei himmennystä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **konten di belakang tetap interaktif** selama lembar tampil. Tanpa peredupan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **innholdet bak forblir interaktivt** mens arket er oppe. Ingen dimming."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **de inhoud erachter blijft interactief** terwijl de sheet open is. Geen dimming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **treść z tyłu pozostaje interaktywna**, gdy arkusz jest wysunięty. Bez przyciemnienia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): **innehållet bakom förblir interaktivt** medan arket är uppe. Ingen nedtoning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationBackgroundInteraction(.enabled(upThrough: .medium)): sayfa açıkken **arkadaki içerik etkileşimli kalır**. Karartma yok."
          }
        }
      }
    },
    ".presentationDetents([.large]), 화면을 거의 다 덮는 **기본 시트**. 뒤 화면이 살짝 물러나 보임.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): the **default sheet**, covering almost the whole screen. The screen behind recedes slightly and stays visible."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): the **default sheet**, covering almost the whole screen. The screen behind recedes slightly and stays visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large])。画面をほぼ覆う**基本のシート**。背後の画面が少し奥に下がって見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large])，几乎盖住整个屏幕的**默认弹层**。后面的界面略微后退。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large])，幾乎蓋住整個螢幕的**預設工作表**。後面的介面略微後退。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): **шторка по умолчанию**, закрывающая почти весь экран. Экран позади слегка отступает и остаётся виден."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): la **hoja por defecto**, que cubre casi toda la pantalla. La pantalla de detrás retrocede un poco y sigue visible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): das **Standard-Sheet**, das fast den ganzen Bildschirm abdeckt. Der Bildschirm dahinter tritt leicht zurück und bleibt sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]) : la **feuille par défaut**, qui recouvre presque tout l'écran. L'écran derrière recule légèrement et reste visible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): il **foglio predefinito**, che copre quasi tutto lo schermo. La schermata dietro si ritrae leggermente e resta visibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): a **folha padrão**, cobrindo quase a tela inteira. A tela de trás recua levemente e continua visível."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): **ชีตเริ่มต้น** คลุมเกือบทั้งหน้าจอ หน้าจอด้านหลังถอยเล็กน้อยและยังมองเห็นอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): **sheet mặc định**, che gần hết màn hình. Màn hình phía sau lùi ra một chút và vẫn nhìn thấy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): **výchozí sheet**, zakrývající téměř celou obrazovku. Obrazovka za ním lehce ustoupí a zůstane vidět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): det **almindelige ark**, der dækker næsten hele skærmen. Skærmen bagved viger lidt tilbage og forbliver synlig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): το **προεπιλεγμένο φύλλο**, που καλύπτει σχεδόν ολόκληρη την οθόνη. Η οθόνη πίσω υποχωρεί ελαφρά και παραμένει ορατή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): **oletusarkki**, joka peittää lähes koko näytön. Takana oleva näkymä väistyy hieman ja pysyy näkyvissä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): **lembar bawaan**, menutupi hampir seluruh layar. Layar di belakang sedikit mundur dan tetap terlihat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): **standardarket**, som dekker nesten hele skjermen. Skjermen bak trer litt tilbake og forblir synlig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): de **standaardsheet**, die bijna het hele scherm bedekt. Het scherm erachter wijkt iets terug en blijft zichtbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): **domyślny arkusz**, zakrywający prawie cały ekran. Ekran za nim lekko się cofa i pozostaje widoczny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): **standardarket**, som täcker nästan hela skärmen. Skärmen bakom viker sig något tillbaka och förblir synlig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".presentationDetents([.large]): ekranın neredeyse tamamını kaplayan **varsayılan sayfa**. Arkadaki ekran hafifçe geri çekilir ve görünür kalır."
          }
        }
      }
    },
