    },
    "화면 전체에 한 번에 걸면 편하다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying it to the whole screen at once is convenient."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying it to the whole screen at once is convenient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面全体に一度にかけると楽だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性加在整个界面上很方便。"
