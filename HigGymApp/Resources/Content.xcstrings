            "value": "Een lang formulier in medium proppen, wat dubbel scrollen in de sheet veroorzaakt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wciskanie długiego formularza w medium, tworzące podwójne przewijanie wewnątrz arkusza"
          }
        },
        "sv": {
