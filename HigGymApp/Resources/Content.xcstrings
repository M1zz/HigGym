            "value": "連絡先の表示"
          }
        }
      }
    },
    "연락처식 스크롤 인덱스(ㄱ~ㅎ) 바": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Contacts-style scroll index bar (A to Z)"
          }
        },
        "en-GB": {
