    "reservesSpace는 빈 공간을 상시 소모합니다. 균일함이 실제로 필요한 그리드·가로 스크롤 카드에만 쓰고, 세로 목록에서는 대개 최대 제한만으로 충분합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace always takes up empty space. Use it only for grids and horizontally scrolling cards that truly need uniformity; in a vertical list, a maximum alone is usually enough."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace always takes up empty space. Use it only for grids and horizontally scrolling cards that truly need uniformity; in a vertical list, a maximum alone is usually enough."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpaceは空のスペースを常に消費します。均一さが実際に必要なグリッドや横スクロールのカードだけに使い、縦のリストでは、たいてい最大の制限だけで十分です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace 会持续消耗空白。只用在真的需要统一的网格、横向滚动卡片上，竖向列表通常只靠最大限制就够了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace 會持續消耗空白。只用在真的需要統一的網格、橫向滾動卡片上，豎向列表通常只靠最大限制就夠了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace всегда занимает пустое место. Используйте только для сеток и горизонтально прокручиваемых карточек, которым единообразие действительно нужно; в вертикальном списке обычно хватает одного максимума."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace siempre ocupa espacio vacío. Úsalo solo para cuadrículas y tarjetas de desplazamiento horizontal que de verdad necesiten uniformidad; en una lista vertical, un máximo suele bastar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace belegt immer leeren Platz. Nutze es nur für Raster und horizontal scrollende Karten, die wirklich Einheitlichkeit brauchen; in einer vertikalen Liste genügt meist allein ein Maximum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace occupe toujours de l'espace vide. N'en usez que pour les grilles et les cartes à défilement horizontal qui ont vraiment besoin d'uniformité ; dans une liste verticale, un maximum seul suffit généralement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace occupa sempre spazio vuoto. Usalo solo per griglie e schede a scorrimento orizzontale che hanno davvero bisogno di uniformità; in un elenco verticale, di solito basta un massimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace sempre ocupa espaço vazio. Use só para grades e cartões de rolagem horizontal que realmente precisam de uniformidade; numa lista vertical, um máximo sozinho costuma bastar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace กินที่ว่างเสมอ ใช้เฉพาะกริดและการ์ดที่เลื่อนแนวนอนที่ต้องการความสม่ำเสมอจริง ๆ ในรายการแนวตั้ง ค่าสูงสุดอย่างเดียวมักพอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace luôn chiếm chỗ trống. Chỉ dùng cho lưới và thẻ cuộn ngang thật sự cần đồng đều; trong danh sách dọc, thường chỉ cần mức tối đa là đủ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace vždy zabírá prázdné místo. Používejte ho jen pro mřížky a vodorovně posouvané karty, které opravdu potřebují jednotnost; ve svislém seznamu obvykle stačí samotné maximum."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace optager altid tom plads. Brug den kun til gitre og vandret scrollende kort, der virkelig har brug for ensartethed; i en lodret liste er et maksimum alene som regel nok."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το reservesSpace καταλαμβάνει πάντα κενό χώρο. Χρησιμοποίησέ το μόνο για πλέγματα και οριζόντια κυλιόμενες κάρτες που πραγματικά χρειάζονται ομοιομορφία· σε κάθετη λίστα, ένα μέγιστο μόνο του συνήθως αρκεί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace vie aina tyhjää tilaa. Käytä sitä vain ruudukoissa ja vaakasuunnassa vieritettävissä korteissa, jotka todella tarvitsevat tasaisuutta; pystyluettelossa pelkkä maksimi riittää yleensä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace selalu memakai ruang kosong. Pakai hanya untuk grid dan kartu gulir horizontal yang benar-benar butuh keseragaman; di daftar vertikal, maksimum saja biasanya cukup."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace tar alltid opp tom plass. Bruk det bare for rutenett og horisontalt rullende kort som virkelig trenger jevnhet; i en vertikal liste er et maksimum alene vanligvis nok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace neemt altijd lege ruimte in. Gebruik het alleen voor rasters en horizontaal scrollende kaarten die echt uniformiteit nodig hebben; in een verticale lijst volstaat meestal alleen een maximum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace zawsze zajmuje puste miejsce. Używaj go tylko dla siatek i poziomo przewijanych kart, które naprawdę potrzebują jednolitości; na pionowej liście zwykle wystarczy sam maksimum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace tar alltid upp tomt utrymme. Använd det bara för rutnät och vågrätt scrollande kort som verkligen behöver enhetlighet; i en lodrät lista räcker oftast bara ett maximum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "reservesSpace her zaman boş alan kaplar. Yalnızca gerçekten tek tip olması gereken ızgaralar ve yatay kayan kartlar için kullan; dikey bir listede genellikle yalnızca bir maksimum yeter."
          }
        }
      }
    },
    "rgba를 지우고 `.thinMaterial` 같은 시스템 material을 쓴다. 색을 얹어 커스텀하지 않고 **두께로만** 고른다. 뒤가 복잡할수록 두껍게. 밝은 사진, 어두운 사진, 다크 모드에서 시스템이 대비를 알아서 보정하니 판은 어디서든 판으로 보인다. 개발자가 배경별 색을 계산하지 않아도 된다. 앱의 6.1.1 Materials in Different Backgrounds 예제에서 같은 material이 배경마다 어떻게 적응하는지 볼 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the rgba and use a system material like `.thinMaterial`. Don't customize it by layering a color; choose **by thickness alone**. The busier the background, the thicker. The system adjusts contrast on its own over bright photos, dark photos, and in Dark Mode, so the panel reads as a panel everywhere. Developers don't have to calculate a color for each background. In the app's 6.1.1 Materials in Different Backgrounds example, you can see how the same material adapts to each background."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the rgba and use a system material like `.thinMaterial`. Don't customise it by layering a colour; choose **by thickness alone**. The busier the background, the thicker. The system adjusts contrast on its own over bright photos, dark photos, and in Dark Mode, so the panel reads as a panel everywhere. Developers don't have to calculate a colour for each background. In the app's 6.1.1 Materials in Different Backgrounds example, you can see how the same material adapts to each background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "rgbaを消して、`.thinMaterial`のようなシステムのmaterialを使う。色を重ねてカスタマイズせず、**厚さだけで**選ぶ。背後が複雑なほど厚く。明るい写真でも暗い写真でもダークモードでも、システムがコントラストを自動で補正するので、板はどこでも板として見える。開発者が背景ごとの色を計算しなくて済む。アプリの6.1.1 Materials in Different Backgroundsの例で、同じmaterialが背景ごとにどう適応するかを見られる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉 rgba，改用 `.thinMaterial` 这样的系统 material。不在上面叠颜色来自定义，而是**只用厚度**来选择。背后越复杂越厚。在明亮照片、深色照片、深色模式下，系统会自动校正对比度，所以底板在哪里看起来都是底板。开发者不必按背景计算颜色。在应用的 6.1.1 Materials in Different Backgrounds 示例里，可以看到同一个 material 在不同背景上如何适应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉 rgba，改用 `.thinMaterial` 這樣的系統 material。不在上面疊顏色來自定義，而是**只用厚度**來選擇。背後越複雜越厚。在明亮照片、深色照片、深色模式下，系統會自動校正對比度，所以底板在哪裡看起來都是底板。開發者不必按背景計算顏色。在應用程式的 6.1.1 Materials in Different Backgrounds 示例裡，可以看到同一個 material 在不同背景上如何適應。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите rgba и возьмите системный материал вроде `.thinMaterial`. Не настраивайте его наложением цвета, выбирайте **только по толщине**. Чем сложнее фон, тем толще. Система сама подстраивает контраст на ярких и тёмных фотографиях и в тёмной теме, так что панель везде читается как панель. Разработчикам не нужно считать цвет для каждого фона. В примере 6.1.1 Materials in Different Backgrounds видно, как один и тот же материал подстраивается под каждый фон."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra el rgba y usa un material del sistema como `.thinMaterial`. No lo personalices superponiéndole un color; elige **solo por grosor**. Cuanto más cargado el fondo, más grueso. El sistema ajusta el contraste por sí solo sobre fotos brillantes, fotos oscuras y en modo oscuro, así que el panel se lee como panel en todas partes. Los desarrolladores no tienen que calcular un color para cada fondo. En el ejemplo 6.1.1 Materials in Different Backgrounds de la app puedes ver cómo se adapta el mismo material a cada fondo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche das rgba und nutze ein System-Material wie `.thinMaterial`. Passe es nicht an, indem du Farbe darüberlegst; wähle **allein nach der Stärke**. Je unruhiger der Hintergrund, desto dicker. Das System stellt den Kontrast über hellen Fotos, dunklen Fotos und im Dunkelmodus selbst ein, sodass das Panel überall als Panel gelesen wird. Entwickler müssen für keinen Hintergrund eine Farbe berechnen. Im Beispiel 6.1.1 Materialien auf verschiedenen Hintergründen der App siehst du, wie sich dasselbe Material jedem Hintergrund anpasst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez le rgba et utilisez un matériau système comme `.thinMaterial`. Ne le personnalisez pas en superposant une couleur ; choisissez **uniquement selon l'épaisseur**. Plus l'arrière-plan est chargé, plus il est épais. Le système ajuste lui-même le contraste sur les photos claires, les photos sombres et en mode sombre, si bien que le panneau se lit comme un panneau partout. Les développeurs n'ont pas à calculer une couleur pour chaque arrière-plan. Dans l'exemple 6.1.1 Matériaux sur différents arrière-plans de l'app, vous voyez comment le même matériau s'adapte à chaque arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina l'rgba e usa un materiale di sistema come `.thinMaterial`. Non personalizzarlo sovrapponendo un colore; scegli **solo in base allo spessore**. Più lo sfondo è carico, più spesso. Il sistema regola da solo il contrasto su foto luminose, foto scure e in Modalità Scura, quindi il pannello si legge come un pannello ovunque. Gli sviluppatori non devono calcolare un colore per ogni sfondo. Nell'esempio 6.1.1 Materiali su sfondi diversi dell'app puoi vedere come lo stesso materiale si adatta a ogni sfondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague o rgba e use um material do sistema como `.thinMaterial`. Não o personalize sobrepondo uma cor; escolha **só pela espessura**. Quanto mais carregado o fundo, mais grosso. O sistema ajusta o contraste sozinho sobre fotos claras, fotos escuras e no Modo Escuro, então o painel é lido como painel em qualquer lugar. Os desenvolvedores não precisam calcular uma cor para cada fundo. No exemplo 6.1.1 Materiais em fundos diferentes do app, você vê como o mesmo material se adapta a cada fundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ rgba แล้วใช้วัสดุของระบบอย่าง `.thinMaterial` อย่าปรับแต่งด้วยการซ้อนสี เลือก**ด้วยความหนาอย่างเดียว** ยิ่งพื้นหลังวุ่นวาย ยิ่งหนา ระบบปรับความตัดกันเองเหนือรูปถ่ายสว่าง รูปถ่ายมืด และในโหมดมืด แผงจึงอ่านเป็นแผงทุกที่ นักพัฒนาไม่ต้องคำนวณสีสำหรับแต่ละพื้นหลัง ในตัวอย่าง 6.1.1 Materials in Different Backgrounds ของแอป คุณเห็นว่าวัสดุเดียวกันปรับตามแต่ละพื้นหลังอย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ rgba và dùng vật liệu hệ thống như `.thinMaterial`. Đừng tùy biến bằng cách chồng màu; chọn **chỉ theo độ dày**. Nền càng rối thì càng dày. Hệ thống tự điều chỉnh độ tương phản trên ảnh sáng, ảnh tối và trong chế độ tối, nên bảng đọc là bảng ở mọi nơi. Nhà phát triển không phải tính màu cho từng nền. Trong ví dụ 6.1.1 Materials in Different Backgrounds của app, bạn thấy cùng một vật liệu thích ứng với từng nền thế nào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smažte rgba a použijte systémový materiál jako `.thinMaterial`. Neupravujte ho vrstvením barvy; vybírejte **jen podle tloušťky**. Čím rušnější pozadí, tím tlustší. Systém sám upravuje kontrast nad světlými fotkami, tmavými fotkami i v tmavém režimu, takže panel se čte jako panel všude. Vývojáři nemusejí počítat barvu pro každé pozadí. V příkladu 6.1.1 Materials in Different Backgrounds aplikace vidíte, jak se stejný materiál přizpůsobuje každému pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet rgba, og brug et systemmateriale som `.thinMaterial`. Tilpas det ikke ved at lægge en farve oven på; vælg **alene efter tykkelse**. Jo mere urolig baggrunden er, jo tykkere. Systemet justerer selv kontrasten over lyse fotos, mørke fotos og i mørk tilstand, så panelet læses som et panel overalt. Udviklere behøver ikke beregne en farve til hver baggrund. I appens eksempel 6.1.1 Materialer på forskellige baggrunde kan du se, hvordan det samme materiale tilpasser sig hver baggrund."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σβήσε το rgba και χρησιμοποίησε ένα υλικό συστήματος όπως το `.thinMaterial`. Μην το προσαρμόζεις στρώνοντας χρώμα· διάλεξε **μόνο με το πάχος**. Όσο πιο φορτωμένο το φόντο, τόσο παχύτερο. Το σύστημα ρυθμίζει μόνο του την αντίθεση πάνω από φωτεινές φωτογραφίες, σκοτεινές φωτογραφίες και στη Σκοτεινή εμφάνιση, οπότε το πάνελ διαβάζεται ως πάνελ παντού. Οι προγραμματιστές δεν χρειάζεται να υπολογίσουν χρώμα για κάθε φόντο. Στο παράδειγμα 6.1.1 Υλικά σε διαφορετικά φόντα της εφαρμογής, μπορείς να δεις πώς το ίδιο υλικό προσαρμόζεται σε κάθε φόντο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista rgba ja käytä järjestelmän materiaalia, kuten `.thinMaterial`. Älä muokkaa sitä kerrostamalla väriä; valitse **pelkästään paksuuden mukaan**. Mitä vilkkaampi tausta, sitä paksumpi. Järjestelmä säätää kontrastin itse kirkkailla valokuvilla, tummilla valokuvilla ja tummassa tilassa, joten paneeli luetaan paneelina kaikkialla. Kehittäjien ei tarvitse laskea väriä jokaiselle taustalle. Sovelluksen esimerkissä 6.1.1 Materiaalit eri taustoilla näet, miten sama materiaali mukautuu kuhunkin taustaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus rgba dan pakai material sistem seperti `.thinMaterial`. Jangan menyesuaikannya dengan menumpuk warna; pilih **hanya berdasarkan ketebalan**. Makin ramai latarnya, makin tebal. Sistem menyesuaikan kontras sendiri di atas foto terang, foto gelap, dan Mode Gelap, sehingga panel terbaca sebagai panel di mana pun. Pengembang tak perlu menghitung warna untuk tiap latar. Di contoh 6.1.1 Materials in Different Backgrounds di aplikasi, kamu bisa melihat bagaimana material yang sama menyesuaikan diri pada tiap latar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett rgba og bruk et systemmaterial som `.thinMaterial`. Ikke tilpass det ved å legge på en farge; velg **bare etter tykkelse**. Jo travlere bakgrunnen er, desto tykkere. Systemet justerer kontrasten selv over lyse bilder, mørke bilder og i mørk modus, så panelet leses som et panel overalt. Utviklere slipper å regne ut en farge for hver bakgrunn. I appens eksempel 6.1.1 Materials in Different Backgrounds kan du se hvordan det samme materialet tilpasser seg hver bakgrunn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder de rgba en gebruik een systeemmateriaal zoals `.thinMaterial`. Pas het niet aan door er kleur op te leggen; kies **alleen op dikte**. Hoe drukker de achtergrond, hoe dikker. Het systeem past het contrast zelf aan boven heldere foto's, donkere foto's en in de donkere modus, zodat het paneel overal als paneel leest. Ontwikkelaars hoeven niet voor elke achtergrond een kleur uit te rekenen. In het voorbeeld 6.1.1 Materialen op verschillende achtergronden van de app zie je hoe hetzelfde materiaal zich aan elke achtergrond aanpast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń rgba i użyj materiału systemowego jak `.thinMaterial`. Nie dostosowuj go, nakładając kolor; wybieraj **wyłącznie po grubości**. Im bardziej ruchliwe tło, tym grubszy. System sam dostosowuje kontrast nad jasnymi zdjęciami, ciemnymi zdjęciami i w trybie ciemnym, więc panel wszędzie czyta się jako panel. Programiści nie muszą obliczać koloru dla każdego tła. W przykładzie 6.1.1 Materiały na różnych tłach w aplikacji zobaczysz, jak ten sam materiał dostosowuje się do każdego tła."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort rgba och använd ett systemmaterial som `.thinMaterial`. Anpassa det inte genom att lägga färg ovanpå; välj **enbart efter tjocklek**. Ju stökigare bakgrund, desto tjockare. Systemet justerar kontrasten på egen hand över ljusa foton, mörka foton och i mörkt läge, så panelen läses som en panel överallt. Utvecklare behöver inte räkna fram en färg för varje bakgrund. I appens exempel 6.1.1 Material på olika bakgrunder ser du hur samma material anpassar sig till varje bakgrund."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "rgba'yı sil ve `.thinMaterial` gibi bir sistem malzemesi kullan. Üzerine renk katmanlayarak özelleştirme; **yalnızca kalınlığa göre** seç. Arka plan ne kadar yoğunsa o kadar kalın. Sistem kontrastı parlak fotoğraflarda, koyu fotoğraflarda ve Koyu Modda kendiliğinden ayarlar, bu yüzden panel her yerde panel olarak okunur. Geliştiricilerin her arka plan için bir renk hesaplaması gerekmez. Uygulamanın 6.1.1 Materials in Different Backgrounds örneğinde aynı malzemenin her arka plana nasıl uyum sağladığını görebilirsin."
          }
        }
      }
    },
    "role만 선언하고 위치·모양 커스텀은 하지 마세요, 시스템 규약에서 벗어나면 사용자의 기대가 깨집니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declare the role only, and don't customize position or shape. Stray from the system convention and you break people's expectations."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Declare the role only, and don't customise position or shape. Stray from the system convention and you break people's expectations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "roleを宣言するだけにして、位置や形はカスタマイズしないでください。システムのお約束から外れると、ユーザーの期待を裏切ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只声明 role，不要自定义位置和外形，偏离系统约定会破坏用户的预期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只宣告 role，不要自定義位置和外形，偏離系統約定會破壞使用者的預期。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объявляйте только роль и не настраивайте положение и форму. Отступите от системного соглашения, и вы нарушите ожидания людей."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Declara solo el rol y no personalices la posición ni la forma. Apártate de la convención del sistema y romperás las expectativas de la gente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklariere nur die Rolle und passe weder Position noch Form an. Weichst du von der Systemkonvention ab, brichst du die Erwartungen der Menschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déclarez seulement le rôle, et ne personnalisez ni la position ni la forme. Écartez-vous de la convention système et vous brisez les attentes des gens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dichiara solo il ruolo e non personalizzare posizione o forma. Esci dalla convenzione del sistema e infrangi le aspettative delle persone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Declare só o papel e não personalize posição nem forma. Fuja da convenção do sistema e você quebra as expectativas das pessoas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประกาศแค่บทบาท และไม่ปรับแต่งตำแหน่งหรือรูปทรง ออกนอกธรรมเนียมของระบบแล้วคุณทำลายความคาดหวังของคน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khai báo vai trò, và đừng tùy biến vị trí hay hình dạng. Lệch khỏi quy ước hệ thống là bạn phá vỡ kỳ vọng của người ta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklarujte jen roli a neupravujte pozici ani tvar. Odchýlíte-li se od systémové konvence, porušíte očekávání lidí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Erklær kun rollen, og tilpas ikke position eller form. Afvig fra systemkonventionen, og du bryder folks forventninger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δήλωσε μόνο τον ρόλο και μην προσαρμόζεις θέση ή σχήμα. Παρέκκλινε από τη σύμβαση του συστήματος και παραβιάζεις τις προσδοκίες των ανθρώπων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julista vain rooli äläkä muokkaa sijaintia tai muotoa. Poikkea järjestelmän konventiosta, ja rikot ihmisten odotukset."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklarasikan role saja, dan jangan sesuaikan posisi atau bentuk. Menyimpang dari konvensi sistem merusak ekspektasi orang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklarer bare rollen, og ikke tilpass posisjon eller form. Avvik fra systemkonvensjonen, og du bryter folks forventninger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Declareer alleen de rol, en pas positie of vorm niet aan. Wijk je af van de systeemconventie, dan breek je de verwachtingen van mensen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadeklaruj tylko rolę i nie dostosowuj pozycji ani kształtu. Zboczysz z konwencji systemu, a złamiesz oczekiwania ludzi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Deklarera bara rollen, och anpassa inte position eller form. Avvik från systemkonventionen och du bryter folks förväntningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca rolü bildir ve konumu ya da biçimi özelleştirme. Sistem geleneğinden sapar, insanların beklentilerini bozarsın."
          }
        }
      }
    },
    "role만 선언하고 위치·모양·전환은 시스템에 위임": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declaring only the role and leaving position, shape and transitions to the system"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Declaring only the role and leaving position, shape and transitions to the system"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "roleだけを宣言し、位置・形・切り替えはシステムに任せる"
