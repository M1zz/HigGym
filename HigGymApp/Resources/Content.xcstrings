            "value": "検索タブの中におすすめやランキングのコンテンツ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索标签里有推荐、排行内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋標籤裡有推薦、排行內容"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендации и чарты внутри вкладки поиска"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendaciones y listas de éxitos dentro de la pestaña de búsqueda"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfehlungen und Diagramme im Such-Tab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommandations et graphiques dans l'onglet de recherche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigli e classifiche dentro la scheda di ricerca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendações e rankings dentro da aba de busca"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแนะนำและชาร์ตภายในแท็บค้นหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gợi ý và biểu đồ bên trong tab tìm kiếm"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doporučení a žebříčky uvnitř karty hledání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anbefalinger og hitlister i søgefanen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προτάσεις και charts μέσα στην καρτέλα αναζήτησης"
          }
        }
      }
    },
    "검색 탭에 빈 검색창만 있으면 자리 낭비, 추천·최근 검색 같은 “검색 전 콘텐츠”를 채우세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A search tab with nothing but an empty search field wastes the slot. Fill it with \"pre-search content\" such as suggestions and recent searches."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A search tab with nothing but an empty search field wastes the slot. Fill it with \"pre-search content\" such as suggestions and recent searches."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索タブに空の検索フィールドしかないのは場所の無駄です。おすすめや最近の検索など「検索する前のコンテンツ」で満たしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索标签里只有空搜索框是浪费位置，请填入推荐、最近搜索这类“搜索前内容”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋標籤裡只有空搜尋框是浪費位置，請填入推薦、最近搜尋這類「搜尋前內容」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка поиска с одним пустым полем поиска - трата места. Заполните её «содержимым до поиска»: рекомендациями и недавними запросами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña de búsqueda con nada más que un campo de búsqueda vacío desperdicia el sitio. Rellénala con «contenido previo a la búsqueda» como sugerencias y búsquedas recientes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Such-Tab mit nichts als einem leeren Suchfeld verschwendet den Platz. Fülle ihn mit „Inhalt vor der Suche“ wie Vorschlägen und letzten Suchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet de recherche avec rien d'autre qu'un champ de recherche vide gaspille l'emplacement. Remplissez-le avec du « contenu d'avant-recherche » comme des suggestions et des recherches récentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scheda di ricerca con nient'altro che un campo di ricerca vuoto spreca lo slot. Riempila con «contenuto pre-ricerca» come suggerimenti e ricerche recenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma aba de busca com nada além de um campo de busca vazio desperdiça o lugar. Preencha-a com «conteúdo pré-busca» como sugestões e buscas recentes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บค้นหาที่มีแต่ช่องค้นหาว่างเปล่าเปลืองช่อง เติมด้วย \"เนื้อหาก่อนค้นหา\" เช่นคำแนะนำและการค้นหาล่าสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tab tìm kiếm chỉ có ô tìm kiếm trống lãng phí ô. Hãy lấp nó bằng \"nội dung trước khi tìm\" như gợi ý và tìm kiếm gần đây."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta hledání s ničím jiným než prázdným vyhledávacím polem plýtvá slotem. Vyplňte ji „obsahem před hledáním“, jako jsou návrhy a nedávná hledání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En søgefane med intet andet end et tomt søgefelt spilder pladsen. Fyld den med »indhold før søgning« som forslag og seneste søgninger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια καρτέλα αναζήτησης με μόνο ένα άδειο πεδίο αναζήτησης σπαταλά τη θέση. Γέμισέ την με «περιεχόμενο πριν την αναζήτηση» όπως προτάσεις και πρόσφατες αναζητήσεις."
          }
        }
      }
    },
    "검색 탭에 트렌딩·최근 검색": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
