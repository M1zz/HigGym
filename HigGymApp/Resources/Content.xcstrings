          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przycisk **Udostępnij**, niezwiązany z tożsamością ekranu, umieszczony dokładnie pośrodku"
          }
        },
        "sv": {
          "stringUnit": {
