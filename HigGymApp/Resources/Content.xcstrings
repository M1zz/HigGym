    },
    "**성·이름 순서**는 문화권 규칙, 하드코딩 금지": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**The order of family and given names** is a cultural rule; never hardcode it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**The order of family and given names** is a cultural rule; never hardcode it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**姓と名の順序**は文化圏のルール。ハードコード禁止"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**姓与名的顺序**是文化圈的规则，禁止硬编码"
