    },
    "닿는 것과 보이는 것은 다르다. 조작 중 가려지는지 손으로 확인한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaching and seeing are different. Check by hand whether it gets covered while in use."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaching and seeing are different. Check by hand whether it gets covered while in use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "届くことと見えることは違う。操作中に隠れないか、手で確かめる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "够得着和看得见是两回事。要用手确认操作时会不会被遮住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夠得著和看得見是兩回事。要用手確認操作時會不會被遮住。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достать и увидеть - разное. Проверьте руками, не закрывается ли оно во время использования."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcanzar y ver son cosas distintas. Comprueba a mano si queda tapado durante el uso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreichen und Sehen sind verschieden. Prüfe von Hand, ob es im Gebrauch verdeckt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteindre et voir sont deux choses différentes. Vérifiez à la main s'il est recouvert pendant l'usage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiungere e vedere sono cose diverse. Controlla a mano se viene coperto durante l'uso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcançar e ver são coisas diferentes. Confira à mão se fica coberto durante o uso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเอื้อมถึงกับการมองเห็นต่างกัน ตรวจด้วยมือว่ามันถูกบังขณะใช้หรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với tới và nhìn thấy là hai chuyện khác nhau. Hãy tự kiểm tra xem nó có bị che khi đang dùng không."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosáhnout a vidět jsou různé věci. Ručně ověřte, zda se při používání nezakrývá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At nå og at se er forskellige ting. Tjek i hånden, om den bliver dækket under brug."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το να φτάνεις και το να βλέπεις είναι διαφορετικά. Έλεγξε με το χέρι αν καλύπτεται κατά τη χρήση."
          }
        }
      }
    },
    "대부분의 브라우징 앱": {
      "extractionState": "manual",
