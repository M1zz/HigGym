          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск занимает **слот заголовка (центр)**, когда «этот экран = поиск»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda ocupa **el sitio del título (centro)**, para cuando «esta pantalla = búsqueda»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche nimmt **die Titelstelle (Mitte)** ein, wenn „dieser Bildschirm = Suche“ gilt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
