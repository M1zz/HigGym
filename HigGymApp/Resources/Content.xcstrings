        }
      }
    },
    "요소가 **화면 전체로 확대**, 사진 뷰어 패턴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The element **expands to fill the screen**, the photo viewer pattern"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The element **expands to fill the screen**, the photo viewer pattern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要素が**画面全体へ拡大**。写真ビューアのパターン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
