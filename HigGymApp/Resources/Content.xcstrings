            "value": "Superponerla con un ZStack en lugar de safeAreaBar, ocultando la primera línea del contenido"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer ZStack statt safeAreaBar darüberlegen und dabei die erste Inhaltszeile verdecken"
          }
        },
        "fr": {
