          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上：取消/儲存，中：編輯模式，底部：細節工具"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отмена/Сохранить» сверху, режим редактирования по центру, подробные инструменты снизу"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar/Guardar arriba, modo de edición en el centro, herramientas detalladas abajo"
          }
        }
      }
    },
    "위: 탐색·공유, 하단: 주소창+탭 전환": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigation and share at the top, address bar + tab switching at the bottom"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigation and share at the top, address bar + tab switching at the bottom"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上：移動・共有、下：アドレスバー + タブ切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上：导航 · 分享，底部：地址栏 + 标签切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
