        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied to body paragraphs, so the text size differs from screen to screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の段落に適用し、画面ごとに文字サイズがばらばら"
          }
        },
        "zh-Hans": {
