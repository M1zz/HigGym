            "state": "translated",
            "value": "Размещение в центре (principal) кнопки, не связанной с идентичностью экрана"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner en el centro (principal) un botón sin relación con la identidad de la pantalla"
