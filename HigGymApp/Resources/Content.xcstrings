        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5) (+ lineLimit(1)) får teksten til at passe ind i pladsen ved at **skrumpe skriftstørrelsen** i stedet for at skære den af."
          }
