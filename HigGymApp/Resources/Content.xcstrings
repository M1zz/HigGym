    },
    "입력은 경계가 생명이다. 하단만 hard로 바꾼다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For input, the boundary is everything. Switch only the bottom to hard."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For input, the boundary is everything. Switch only the bottom to hard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力は境界が命だ。下部だけを hard に変える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
