          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**En brugerdefineret visning, som et logo eller en avatar,** på pladsen til den store titel"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Μια προσαρμοσμένη προβολή, όπως ένα λογότυπο ή avatar,** στη θέση του μεγάλου τίτλου"
