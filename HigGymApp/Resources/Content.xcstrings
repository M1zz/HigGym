          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieobsłużenie stanu zwiniętego (inline) akcesorium"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att inte hantera tillbehörets hopfällda (inline) tillstånd"
          }
