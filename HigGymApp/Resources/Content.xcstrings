        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια οθόνη με αξιόπιστα ομοιόμορφο συμπαγές φόντο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
