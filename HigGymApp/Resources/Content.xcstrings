    "화면 **하단 툴바**(.bottomBar)에 아이템 하나. 떠 있는 유리로 표시.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single item in the **bottom toolbar** (.bottomBar), shown as floating glass."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A single item in the **bottom toolbar** (.bottomBar), shown as floating glass."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の**下部のツールバー**（.bottomBar）にアイテムがひとつ。浮かぶガラスとして表示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面**底部工具栏**（.bottomBar）放一个项目。显示为浮着的玻璃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面**底部工具列**（.bottomBar）放一個項目。顯示為浮著的玻璃。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единственный элемент на **нижней панели инструментов** (.bottomBar), отображаемый парящим стеклом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un único elemento en la **barra de herramientas inferior** (.bottomBar), mostrado como cristal flotante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelnes Element in der **unteren Symbolleiste** (.bottomBar), als schwebendes Glas dargestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul élément dans la **barre d'outils du bas** (.bottomBar), affiché comme du verre flottant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singolo elemento nella **barra degli strumenti in basso** (.bottomBar), mostrato come vetro fluttuante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único item na **barra de ferramentas inferior** (.bottomBar), mostrado como vidro flutuante."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการเดี่ยวใน**แถบเครื่องมือล่าง** (.bottomBar) แสดงเป็นกระจกลอย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mục đơn trong **thanh công cụ dưới** (.bottomBar), hiện như kính nổi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jediná položka ve **spodním panelu nástrojů** (.bottomBar), zobrazená jako plovoucí sklo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et enkelt element i den **nederste værktøjslinje** (.bottomBar), vist som flydende glas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μόνο στοιχείο στην **κάτω γραμμή εργαλείων** (.bottomBar), που εμφανίζεται ως πλωτό γυαλί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi kohde **alatyökalupalkissa** (.bottomBar), näytettynä kelluvana lasina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu item di **bilah alat bawah** (.bottomBar), tampil sebagai kaca mengambang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et enkelt element i **bunnverktøylinjen** (.bottomBar), vist som flytende glass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén item in de **onderste werkbalk** (.bottomBar), getoond als zwevend glas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojedynczy element **dolnego paska narzędzi** (.bottomBar), pokazany jako unoszące się szkło."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett enda objekt i **det nedre verktygsfältet** (.bottomBar), visat som svävande glas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Alt araç çubuğundaki** (.bottomBar) tek bir öğe, yüzen cam olarak gösterilir."
          }
        }
      }
    },
    "화면 끝까지 꽉 채우는 편이 시원해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filling the screen all the way to the edge looks cleaner."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Filling the screen all the way to the edge looks cleaner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の端までぎっしり埋めたほうがすっきり見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铺满到屏幕尽头显得畅快。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鋪滿到螢幕盡頭顯得暢快。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполнение экрана до самого края выглядит чище."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llenar la pantalla hasta el borde se ve más limpio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Bildschirm bis zum Rand zu füllen wirkt sauberer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir l'écran jusqu'au bord paraît plus propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempire lo schermo fino al bordo sembra più pulito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencher a tela até a borda parece mais limpo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเติมหน้าจอจนถึงขอบดูสะอาดกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấp đầy màn hình đến tận mép trông gọn hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplnění obrazovky až k okraji vypadá čistěji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At fylde skærmen helt ud til kanten ser renere ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το να γεμίζεις την οθόνη μέχρι την άκρη φαίνεται πιο καθαρό."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytön täyttäminen aina reunaan asti näyttää siistimmältä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memenuhi layar sampai ke tepi tampak lebih bersih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å fylle skjermen helt ut til kanten ser renere ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het scherm tot aan de rand vullen ziet er schoner uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnienie ekranu aż do krawędzi wygląda czyściej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att fylla skärmen ända ut till kanten ser renare ut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranı kenara kadar doldurmak daha temiz görünür."
          }
        }
      }
    },
    "화면 끝까지 꽉 채운 바는 시원해 보인다. 아래에 빈 띠가 남으면 덜 만든 화면 같다. 하단은 엄지가 닿는 좋은 자리이니 가능한 한 아래로 내리면 더 누르기 쉬울 것 같다. safe area를 무시하고 직접 배치하면 원하는 위치에 정확히 둘 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bar that fills the screen all the way to the edge looks clean. Leave an empty strip at the bottom, and the screen looks unfinished. The bottom is a great spot for the thumb, so pushing things as low as possible seems like it would make them easier to tap. Ignore the safe area and lay things out yourself, and you can place them exactly where you want."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A bar that fills the screen all the way to the edge looks clean. Leave an empty strip at the bottom, and the screen looks unfinished. The bottom is a great spot for the thumb, so pushing things as low as possible seems like it would make them easier to tap. Ignore the safe area and lay things out yourself, and you can place them exactly where you want."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の端までぎっしり埋めたバーはすっきり見える。下に空いた帯が残ると、作りかけの画面のように見える。下部は親指が届くいい場所なので、できるだけ下に置けばもっと押しやすくなりそうだ。safe areaを無視して自分で配置すれば、狙った位置に正確に置ける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铺满到屏幕尽头的栏显得畅快。下面留一条空带，就像没做完的界面。底部是拇指够得着的好位置，尽量往下放似乎更好点。无视 safe area 自己摆放，能精确放在想要的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鋪滿到螢幕盡頭的列顯得暢快。下面留一條空帶，就像沒做完的介面。底部是拇指夠得著的好位置，儘量往下放似乎更好點。無視 safe area 自己擺放，能精確放在想要的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель, заполняющая экран до самого края, выглядит чисто. Оставьте внизу пустую полосу, и экран выглядит незаконченным. Низ - отличное место для большого пальца, поэтому прижать всё как можно ниже кажется способом упростить нажатие. Проигнорируйте safe area и компонуйте сами, и можно разместить всё точно где хочется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra que llena la pantalla hasta el borde se ve limpia. Deja una franja vacía abajo y la pantalla parece inacabada. La parte inferior es un sitio estupendo para el pulgar, así que empujar las cosas lo más abajo posible parece que las haría más fáciles de tocar. Ignora el área segura y coloca las cosas tú mismo, y podrás ponerlas exactamente donde quieras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Leiste, die den Bildschirm bis zum Rand füllt, wirkt sauber. Lässt man unten einen leeren Streifen, wirkt der Bildschirm unfertig. Der untere Rand ist ein großartiger Platz für den Daumen, also scheint es, als machte es Dinge leichter antippbar, sie so tief wie möglich zu schieben. Ignoriert man den sicheren Bereich und ordnet selbst an, kann man alles genau dorthin setzen, wo man es will."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre qui remplit l'écran jusqu'au bord paraît propre. Laissez une bande vide en bas, et l'écran paraît inachevé. Le bas est un excellent emplacement pour le pouce, donc pousser les choses le plus bas possible semble les rendre plus faciles à toucher. Ignorez la zone sûre et disposez les choses vous-même, et vous pouvez les placer exactement où vous voulez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra che riempie lo schermo fino al bordo sembra pulita. Lascia una fascia vuota in basso e la schermata sembra non finita. Il basso è un ottimo posto per il pollice, quindi spingere le cose il più in basso possibile sembra renderle più facili da toccare. Ignora l'area sicura e disponi le cose da solo e puoi collocarle esattamente dove vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra que preenche a tela até a borda parece limpa. Deixe uma faixa vazia embaixo e a tela parece inacabada. A parte de baixo é um ótimo lugar para o polegar, então empurrar as coisas o mais para baixo possível parece torná-las mais fáceis de tocar. Ignore a área segura e disponha as coisas você mesmo, e poderá colocá-las exatamente onde quiser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบที่เติมหน้าจอจนถึงขอบดูสะอาด ทิ้งแถบว่างไว้ด้านล่าง หน้าจอก็ดูไม่เสร็จ ด้านล่างเป็นที่ที่ดีสำหรับนิ้วโป้ง การดันสิ่งต่าง ๆ ให้ต่ำที่สุดจึงดูเหมือนจะแตะง่ายขึ้น ละเลย safe area และจัดวางเอง คุณวางได้ตรงที่ต้องการพอดี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thanh lấp đầy màn hình đến tận mép trông gọn. Để lại một dải trống ở dưới, màn hình trông chưa xong. Phần dưới là chỗ tuyệt vời cho ngón cái, nên đẩy mọi thứ xuống thấp nhất có vẻ khiến dễ chạm hơn. Bỏ qua safe area và tự bố trí, bạn đặt được đúng chỗ muốn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel vyplňující obrazovku až k okraji vypadá čistě. Nechte dole prázdný pás a obrazovka vypadá nedokončeně. Spodek je skvělé místo pro palec, takže tlačit věci co nejníž se zdá, že usnadní klepnutí. Ignorujte safe area a rozvrhněte věci sami a můžete je umístit přesně tam, kam chcete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En bjælke, der fylder skærmen helt ud til kanten, ser ren ud. Lad en tom strimmel stå i bunden, og skærmen ser uafsluttet ud. Bunden er en fantastisk plads til tommelfingeren, så at skubbe ting så langt ned som muligt ser ud til at gøre dem nemmere at trykke på. Ignorer safe area og læg ud selv, og du kan placere ting præcis, hvor du vil."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γραμμή που γεμίζει την οθόνη μέχρι την άκρη φαίνεται καθαρή. Άφησε μια άδεια λωρίδα κάτω και η οθόνη φαίνεται ημιτελής. Το κάτω μέρος είναι εξαιρετικό σημείο για τον αντίχειρα, οπότε το να σπρώξεις τα πράγματα όσο πιο χαμηλά γίνεται φαίνεται ότι θα τα κάνει πιο εύκολα στο πάτημα. Αγνόησε την ασφαλή περιοχή και διάταξέ τα μόνος σου, και μπορείς να τα βάλεις ακριβώς όπου θέλεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palkki, joka täyttää näytön reunaan asti, näyttää siistiltä. Jätä tyhjä kaista alas, ja näkymä näyttää keskeneräiseltä. Alaosa on erinomainen paikka peukalolle, joten asioiden työntäminen mahdollisimman alas näyttää tekevän niistä helpompia napauttaa. Ohita turva-alue ja asettele asiat itse, niin voit sijoittaa ne täsmälleen minne haluat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah yang memenuhi layar sampai ke tepi tampak bersih. Sisakan strip kosong di bawah, dan layar tampak belum selesai. Bagian bawah adalah tempat yang bagus untuk ibu jari, jadi mendorong hal sebawah mungkin tampaknya membuatnya lebih mudah diketuk. Abaikan area aman dan atur sendiri, dan kamu bisa menaruhnya persis di mana kamu mau."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En linje som fyller skjermen helt ut til kanten ser ren ut. La en tom stripe stå nederst, og skjermen ser uferdig ut. Bunnen er et fint sted for tommelen, så å skyve ting så lavt som mulig virker som det ville gjort dem lettere å trykke på. Ignorer det trygge området og legg ut selv, så kan du plassere ting akkurat hvor du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een balk die het scherm tot aan de rand vult ziet er schoon uit. Laat een lege strook onderaan, en het scherm lijkt onaf. De onderkant is een geweldige plek voor de duim, dus dingen zo laag mogelijk duwen lijkt ze makkelijker aan te tikken te maken. Negeer de safe area en leg zelf dingen uit, en je kunt ze precies plaatsen waar je wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasek wypełniający ekran aż do krawędzi wygląda czysto. Zostaw u dołu pusty pasek, a ekran wygląda na niedokończony. Dół to świetne miejsce dla kciuka, więc zepchnięcie rzeczy jak najniżej wydaje się ułatwiać ich stukanie. Zignoruj obszar bezpieczny i układaj rzeczy sam, a umieścisz je dokładnie tam, gdzie chcesz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett fält som fyller skärmen ända ut till kanten ser rent ut. Lämna en tom remsa längst ner, och skärmen ser ofärdig ut. Botten är en fin plats för tummen, så att skjuta saker så lågt som möjligt verkar göra dem lättare att trycka på. Ignorera det säkra området och lägg ut saker själv, så kan du placera dem exakt där du vill."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranı kenara kadar dolduran bir çubuk temiz görünür. Altta boş bir şerit bırakırsan ekran bitmemiş görünür. Alt kısım başparmak için harika bir yer, bu yüzden bir şeyleri mümkün olduğunca alçağa itmek dokunmayı kolaylaştıracak gibi görünür. Güvenli alanı yok sayıp düzeni kendin yaparsan onları tam istediğin yere koyabilirsin."
          }
        }
      }
    },
    "화면 내용과 무관한 브랜드 로고를 principal에 넣고 제목을 없앰": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A brand logo unrelated to the screen's content placed in principal, removing the title"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A brand logo unrelated to the screen's content placed in principal, removing the title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の内容と無関係なブランドロゴをprincipalに入れ、タイトルをなくしている"
