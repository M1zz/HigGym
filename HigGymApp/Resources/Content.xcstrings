        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávací pole vždy zobrazené na obrazovce, kde se hledání skoro nepoužívá"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et søgefelt, der altid vises på en skærm, hvor søgning næsten ikke bruges"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πεδίο αναζήτησης πάντα εμφανές σε οθόνη όπου η αναζήτηση σχεδόν δεν χρησιμοποιείται"
          }
        },
        "fi": {
