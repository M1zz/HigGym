            "value": "よく使うものほど親指の近くに"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频率越高，越靠近拇指"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頻率越高，越靠近拇指"
