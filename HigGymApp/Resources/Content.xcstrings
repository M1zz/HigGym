        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5) (+ lineLimit(1)) memuatkan teks ke dalam ruang dengan **mengecilkan ukuran huruf** alih-alih memotongnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5) (+ lineLimit(1)) får teksten til å passe i plassen ved å **krympe skriftstørrelsen** i stedet for å kutte den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.5) (+ lineLimit(1)) laat tekst in de ruimte passen door **de lettergrootte te verkleinen** in plaats van af te kappen."
