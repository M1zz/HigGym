    "모달 시트의 상단 제목": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title at the top of a modal sheet"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The title at the top of a modal sheet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モーダルシート上部のタイトル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模态弹层顶部的标题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模態工作表頂部的標題"
          }
        },
        "ru": {
          "stringUnit": {
