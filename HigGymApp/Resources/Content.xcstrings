            "value": "O logo só na tela de entrada basta. Toda outra tela deve dizer onde você está."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โลโก้บนหน้าจอแรกที่เข้าอย่างเดียวก็พอ ทุกหน้าจออื่นควรบอกว่าคุณอยู่ที่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo ở màn hình vào là đủ. Mọi màn hình khác nên nói bạn đang ở đâu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo jen na vstupní obrazovce stačí. Každá další obrazovka by měla říkat, kde jste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logoet på indgangsskærmen alene er nok. Alle andre skærme bør sige, hvor du er."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το λογότυπο στην οθόνη εισόδου μόνο του αρκεί. Κάθε άλλη οθόνη πρέπει να λέει πού βρίσκεσαι."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo pelkästään sisääntulonäkymässä riittää. Jokaisen muun näkymän pitäisi kertoa, missä ollaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo di layar masuk saja sudah cukup. Setiap layar lain seharusnya menyebut di mana kamu berada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logoen på inngangsskjermen alene er nok. Alle andre skjermer bør si hvor du er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het logo alleen op het instapscherm is genoeg. Elk ander scherm moet zeggen waar je bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo logo na ekranie wejściowym wystarczy. Każdy inny ekran powinien mówić, gdzie jesteś."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logotypen på ingångsskärmen räcker. Varje annan skärm ska säga var du är."
          }
