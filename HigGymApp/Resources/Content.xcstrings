          "stringUnit": {
            "state": "translated",
            "value": "Не возвращается на исходное место при закрытии"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No volver a la posición original al cerrar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Schließen nicht an die ursprüngliche Position zurückkehren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas revenir à la position d'origine à la fermeture"
          }
        },
        "it": {
