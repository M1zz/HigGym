    "스크롤이 짧거나 전환이 잦은 화면에 탭바 최소화를 건다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning on tab bar minimizing for screens with short scrolls or frequent switching"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning on tab bar minimising for screens with short scrolls or frequent switching"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールが短い画面や切り替えの多い画面でタブバーの最小化をオンにする"
          }
        },
        "zh-Hans": {
