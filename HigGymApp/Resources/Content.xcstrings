          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переходы **medium ↔ large**, ручка-индикатор сигнализирует «есть ещё»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso entre **medium ↔ large**, con el tirador indicando que «hay más»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsel zwischen **medium ↔ large**, wobei der Griff „es gibt mehr“ signalisiert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passage entre **medium ↔ large**, avec la poignée qui signale qu'« il y a plus »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passaggio tra **medium ↔ large**, con la maniglia che segnala «c'è dell'altro»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passagem entre **medium ↔ large**, com a alça sinalizando «há mais»"
          }
