        }
      }
    },
    "되돌릴 수 없는 액션은 일부러 한 단계 멀리 둔다. 도달성은 무해한 액션에만 적용한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deliberately keep irreversible actions one step away. Apply reachability only to harmless actions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Deliberately keep irreversible actions one step away. Apply reachability only to harmless actions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せないアクションは、あえて一段階遠くに置く。届きやすさは無害なアクションにだけ当てはめる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法撤销的操作要故意再远一步。可触达性只适用于无害的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法撤銷的操作要故意再遠一步。可觸達性只適用於無害的操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необратимые действия намеренно держите на шаг дальше. Досягаемость применяйте только к безвредным действиям."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén a propósito las acciones irreversibles a un paso de distancia. Aplica el alcance solo a las acciones inofensivas."
          }
        }
      }
    },
    "두 바의 재질·가장자리 효과가 제각각": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two bars with mismatched materials and edge effects"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The two bars with mismatched materials and edge effects"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのバーのマテリアルとエッジエフェクトがばらばら"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个栏的材质、边缘效果各不相同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個列的材質、邊緣效果各不相同"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две панели с разными материалами и эффектами края"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos barras con materiales y efectos de borde que no coinciden"
          }
        }
      }
    },
    "두 방향 중 하나를 고른다. 탭으로 둔다면 검색창 아래를 최근 검색과 추천으로 채워, 들어가자마자 고를 거리가 보이게 한다. 채울 것이 없다면 `Tab(role: .search)` 로 분리 캡슐에 두어 모드 진입으로 다루거나, 해당 목록 화면에 `.searchable` 을 붙인다. 앱의 3.4.1 As Tab Item 예제가 검색 탭이 한 세계로 성립하는 모습을 보여 준다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one of two directions. If you keep it as a tab, fill the space below the search field with recent searches and suggestions so there's something to choose the moment people arrive. If there's nothing to fill it with, either put it in the separate capsule with `Tab(role: .search)` and treat it as entering a mode, or attach `.searchable` to the relevant list screen. The app's 3.4.1 As Tab Item example shows a Search tab that stands as a world of its own."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one of two directions. If you keep it as a tab, fill the space below the search field with recent searches and suggestions so there's something to choose the moment people arrive. If there's nothing to fill it with, either put it in the separate capsule with `Tab(role: .search)` and treat it as entering a mode, or attach `.searchable` to the relevant list screen. The app's 3.4.1 As Tab Item example shows a Search tab that stands as a world of its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの方向のどちらかを選ぶ。タブとして残すなら、検索フィールドの下を最近の検索とおすすめで埋め、入った瞬間に選べるものが見えるようにする。埋めるものがなければ、`Tab(role: .search)` で分離されたカプセルに置いてモードへの切り替えとして扱うか、該当するリスト画面に `.searchable` を付ける。アプリの 3.4.1 As Tab Item の例が、検索タブがひとつの世界として成り立つ姿を見せてくれる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在两个方向里选一个。做成标签的话，用最近搜索和推荐填满搜索框下方，一进去就看到可选的东西。没东西可填，就用 `Tab(role: .search)` 放进分离胶囊，当作进入模式来处理，或者在对应的列表界面上加 `.searchable`。应用的 3.4.1 As Tab Item 示例展示了搜索标签作为一个世界成立的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在兩個方向裡選一個。做成標籤的話，用最近搜尋和推薦填滿搜尋框下方，一進去就看到可選的東西。沒東西可填，就用 `Tab(role: .search)` 放進分離膠囊，當作進入模式來處理，或者在對應的列表介面上加 `.searchable`。應用程式的 3.4.1 As Tab Item 示例展示了搜尋標籤作為一個世界成立的樣子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите одно из двух направлений. Если оставляете вкладкой, заполните место под полем поиска недавними запросами и рекомендациями, чтобы в момент прихода было из чего выбирать. Если заполнить нечем, либо поместите в отдельную капсулу через `Tab(role: .search)` и рассматривайте как вход в режим, либо добавьте `.searchable` к соответствующему экрану со списком. Пример 3.4.1 As Tab Item показывает вкладку поиска, существующую как самостоятельный мир."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una de dos direcciones. Si la mantienes como pestaña, llena el espacio bajo el campo de búsqueda con búsquedas recientes y sugerencias para que haya algo que elegir en el momento en que llega la gente. Si no hay nada con que llenarlo, o la pones en la cápsula separada con `Tab(role: .search)` y la tratas como la entrada a un modo, o unes `.searchable` a la pantalla de lista correspondiente. El ejemplo 3.4.1 As Tab Item de la app muestra una pestaña de búsqueda que se sostiene como un mundo propio."
          }
        }
      }
    },
    "두 설정 모두 넘침을 막는 장치다. 하나보다 둘이 더 안전해 보인다. 기본 글자 크기에서 확인하면 아무 문제가 없으니 의심할 계기도 없다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both settings are safeguards against overflow, and two seem safer than one. Checked at the default text size, nothing goes wrong, so there is no reason to suspect anything."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Both settings are safeguards against overflow, and two seem safer than one. Checked at the default text size, nothing goes wrong, so there is no reason to suspect anything."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの設定もあふれを防ぐ仕組みだ。1つより2つのほうが安全に見える。標準の文字サイズで確認すると何の問題もないので、疑うきっかけもない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个设置都是防止溢出的装置，两个看起来比一个更安全。在默认字号下确认没有任何问题，所以也没有起疑的契机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個設定都是防止溢位的裝置，兩個看起來比一個更安全。在預設字號下確認沒有任何問題，所以也沒有起疑的契機。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обе настройки - страховка от переполнения, и две кажутся надёжнее одной. При проверке при стандартном размере текста ничего не ломается, так что нет повода что-то подозревать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos ajustes son salvaguardas contra el desbordamiento, y dos parecen más seguros que uno. Comprobado con el tamaño de texto por defecto, no falla nada, así que no hay motivo para sospechar nada."
          }
        }
      }
    },
    "두 요소의 **위계가 다름**을 위치로 표현, 중앙=화면의 정의, trailing=부가 액션. 같은 줄에 있어도 별개의 유리 캡슐로 분리되어 혼동이 없음.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It expresses **the difference in hierarchy** between the two elements through position: center = the definition of the screen, trailing = an extra action. Even on the same line, they are split into separate glass capsules, so there is no confusion."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It expresses **the difference in hierarchy** between the two elements through position: centre = the definition of the screen, trailing = an extra action. Even on the same line, they are split into separate glass capsules, so there is no confusion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの要素の**階層の違い**を位置で表現する。中央 = 画面の定義、trailing = 付加的なアクション。同じ行にあっても別々のガラスのカプセルに分かれているので、混同しない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用位置表达两个元素**层级不同**：中间 = 界面的定义，trailing = 附加操作。即使在同一行，也会分离成各自的玻璃胶囊，不会混淆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用位置表達兩個元素**層級不同**：中間 = 介面的定義，trailing = 附加操作。即使在同一行，也會分離成各自的玻璃膠囊，不會混淆。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она выражает положением **разницу иерархии** двух элементов: центр = определение экрана, trailing = дополнительное действие. Даже в одной строке они разведены по отдельным стеклянным капсулам, так что путаницы нет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expresa **la diferencia de jerarquía** entre los dos elementos mediante la posición: centro = la definición de la pantalla, trailing = una acción extra. Incluso en la misma línea, están divididos en cápsulas de cristal separadas, así que no hay confusión."
          }
        }
      }
    },
    "두 원칙의 타협, 기능은 다 제공하되(완전성), 화면은 어지럽히지 않는다(content-first). 또한 버튼을 무한정 줄여 넣으면 **터치 타깃이 손가락 크기 이하**로 작아지므로, 시스템이 자동으로 접어 최소 타깃 크기를 보장. \"많으면 접는다\"가 기본 동작인 이유.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A compromise between two principles: provide every feature (completeness) without cluttering the screen (content-first). And if you keep shrinking buttons to fit them in, **touch targets get smaller than a fingertip**, so the system folds them automatically to guarantee the minimum target size. That is why \"fold when there are too many\" is the default behavior."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A compromise between two principles: provide every feature (completeness) without cluttering the screen (content-first). And if you keep shrinking buttons to fit them in, **touch targets get smaller than a fingertip**, so the system folds them automatically to guarantee the minimum target size. That is why \"fold when there are too many\" is the default behaviour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの原則の妥協点。機能はすべて提供しつつ（完全性）、画面は散らかさない（content-first）。また、ボタンをどこまでも縮めて詰め込むと**タッチターゲットが指より小さく**なってしまうため、システムが自動で折りたたんで最小ターゲットサイズを保証する。「多ければ折りたたむ」がデフォルトの動作である理由。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个原则的折中：功能全部提供（完整性），界面不弄乱（content-first）。而且按钮无限缩小地塞进去，**触控目标会小于手指**，所以系统自动折叠以保证最小目标尺寸。这就是“多了就折叠”成为默认行为的原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個原則的折中：功能全部提供（完整性），介面不弄亂（content-first）。而且按鈕無限縮小地塞進去，**觸控目標會小於手指**，所以系統自動摺疊以保證最小目標尺寸。這就是「多了就摺疊」成為預設行為的原因。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компромисс двух принципов: предоставить все функции (полнота) и не загромождать экран (content-first). А если продолжать уменьшать кнопки, чтобы их втиснуть, **области касания станут меньше кончика пальца**, поэтому система автоматически сворачивает их, гарантируя минимальный размер области. Вот почему «если много, сворачиваем» - поведение по умолчанию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compromiso entre dos principios: ofrecer todas las funciones (completitud) sin saturar la pantalla (content-first). Y si sigues encogiendo botones para que quepan, **los objetivos táctiles se vuelven más pequeños que la yema de un dedo**, así que el sistema los pliega automáticamente para garantizar el tamaño mínimo del objetivo. Por eso «plegar cuando hay demasiados» es el comportamiento por defecto."
          }
        }
      }
    },
    "두 자리를 넘으면 99+로 접는다. 배지 폭이 일정해지니 라벨을 덮지 않고, 탭바는 어느 숫자에서든 같은 모양을 유지한다. 정확한 개수는 탭 안의 화면에서 보여 주면 된다. 앱의 3.1.3·3.1.4 배지 예제를 나란히 열어 보면 배지가 짧아야 하는 이유가 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse anything over two digits to 99+. The badge width stays constant, so it doesn't cover the label, and the tab bar keeps the same shape no matter the number. Show the exact count on the screen inside the tab. Open the app's 3.1.3 and 3.1.4 badge examples side by side to see why badges need to stay short."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse anything over two digits to 99+. The badge width stays constant, so it doesn't cover the label, and the tab bar keeps the same shape no matter the number. Show the exact count on the screen inside the tab. Open the app's 3.1.3 and 3.1.4 badge examples side by side to see why badges need to stay short."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2桁を超えたら99+にまとめる。バッジの幅が一定になるのでラベルを覆わず、タブバーはどんな数字でも同じ形を保つ。正確な件数はタブの中の画面で見せればよい。アプリの3.1.3と3.1.4のバッジの例を並べて開くと、バッジが短くなければならない理由がわかる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过两位数就折叠成 99+。角标宽度固定，不会盖住标签，标签栏在任何数字下都保持同样的外形。准确数量在标签内的界面里显示即可。并排打开应用的 3.1.3、3.1.4 角标示例，就能看到角标为什么必须简短。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過兩位數就摺疊成 99+。標記寬度固定，不會蓋住標籤，標籤列在任何數字下都保持同樣的外形。準確數量在標籤內的介面裡顯示即可。並排開啟應用程式的 3.1.3、3.1.4 標記示例，就能看到標記為什麼必須簡短。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что больше двух цифр, сворачивайте в 99+. Ширина бейджа остаётся постоянной, так что он не закрывает подпись, а панель вкладок сохраняет одну и ту же форму при любом числе. Точное количество показывайте на экране внутри вкладки. Откройте рядом примеры бейджей 3.1.3 и 3.1.4, чтобы увидеть, почему бейджи должны быть короткими."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colapsa a 99+ todo lo que pase de dos cifras. El ancho de la insignia se mantiene constante, así que no tapa la etiqueta, y la barra de pestañas conserva la misma forma sea cual sea el número. Muestra el recuento exacto en la pantalla dentro de la pestaña. Abre uno junto a otro los ejemplos de insignias 3.1.3 y 3.1.4 de la app para ver por qué las insignias deben ser cortas."
          }
        }
      }
    },
    "두 줄짜리 복잡한 컨트롤 패널": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A complicated two-line control panel"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A complicated two-line control panel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2行もある複雑なコントロールパネル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两行的复杂控制面板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩行的複雜控制面板"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сложная двухстрочная панель управления"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel de control complicado de dos líneas"
          }
        }
      }
    },
    "두 캡슐 사이의 **빈 공간 자체가 정보**입니다\"이 두 묶음은 서로 다른 일\"이라는 신호. 전부 한 캡슐에 붙이면 관계없는 기능이 한 덩어리로 보여 인지 부담이 커짐.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**The empty space between the two capsules is itself information**: a signal that \"these two groups do different jobs.\" Cram everything into one capsule and unrelated features look like a single lump, increasing cognitive load."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**The empty space between the two capsules is itself information**: a signal that \"these two groups do different jobs.\" Cram everything into one capsule and unrelated features look like a single lump, increasing cognitive load."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのカプセルの間の**空白そのものが情報**です。「この2つのまとまりは別々の仕事」というサイン。すべてをひとつのカプセルに詰め込むと、関係のない機能がひと塊に見え、認知負荷が大きくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个胶囊之间的**空白本身就是信息**：这是“这两组是不同的事”的信号。全部贴在一个胶囊里，无关的功能就像一整块，认知负担增大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個膠囊之間的**空白本身就是資訊**：這是「這兩組是不同的事」的訊號。全部貼在一個膠囊裡，無關的功能就像一整塊，認知負擔增大。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Пустое место между двумя капсулами само несёт информацию**: сигнал «эти две группы делают разное». Запихните всё в одну капсулу, и несвязанные функции будут выглядеть единым комом, увеличивая когнитивную нагрузку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**El espacio vacío entre las dos cápsulas es en sí información**: una señal de que «estos dos grupos hacen trabajos distintos». Mete todo en una cápsula y las funciones sin relación parecen un solo bulto, aumentando la carga cognitiva."
          }
        }
      }
    },
    "두 크기 모두 디자인한다. 접히면 무엇을 남길지 먼저 정한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Design both sizes. Decide first what stays when it collapses."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Design both sizes. Decide first what stays when it collapses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のサイズをデザインする。折りたたまれたら何を残すかを先に決める。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种尺寸都要设计。折叠时先定好留下什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種尺寸都要設計。摺疊時先定好留下什麼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продумайте оба размера. Сначала решите, что остаётся при сворачивании."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseña ambos tamaños. Decide primero qué se queda cuando se colapsa."
          }
        }
      }
    },
    "두 탭을 한 화면으로 합치고 상단에 받은 요청·보낸 요청 세그먼트를 둔다. 전환은 화면 위쪽, 보고 있는 목록 바로 옆에서 일어나고 화면은 제자리에 있다. 탭바가 필요 없어지면 그 자리는 콘텐츠에 돌아간다. 앱의 3.2.1 2 Tabs 예제는 반대로 탭 둘이 맞는 경우를 보여 주니 비교해 보면 좋다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge the two tabs into one screen and put a Received/Sent segmented control at the top. Switching happens at the top of the screen, right next to the list you're viewing, and the screen stays in place. Once the tab bar is no longer needed, that space goes back to the content. The app's 3.2.1 2 Tabs example shows the opposite case, where two tabs are right, so it's worth comparing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge the two tabs into one screen and put a Received/Sent segmented control at the top. Switching happens at the top of the screen, right next to the list you're viewing, and the screen stays in place. Once the tab bar is no longer needed, that space goes back to the content. The app's 3.2.1 2 Tabs example shows the opposite case, where two tabs are right, so it's worth comparing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのタブを1つの画面にまとめ、上部に「受け取った/送った」のセグメントを置く。切り替えは画面の上のほう、見ているリストのすぐそばで起き、画面はその場にとどまる。タブバーが不要になれば、その場所はコンテンツに戻る。アプリの3.2.1 2 Tabsの例は逆に2つのタブが正しい場合を示しているので、比べてみるとよい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把两个标签合并成一个界面，顶部放“收到的请求 · 发出的请求”分段。切换发生在界面上方、紧挨着正在看的列表，界面留在原地。不再需要标签栏，位置就还给了内容。应用的 3.2.1 2 Tabs 示例反过来展示了两个标签合适的情形，对比一下很有帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把兩個標籤合併成一個介面，頂部放「收到的請求 · 發出的請求」分段。切換髮生在介面上方、緊挨著正在看的列表，介面留在原地。不再需要標籤列，位置就還給了內容。應用程式的 3.2.1 2 Tabs 示例反過來展示了兩個標籤合適的情形，對比一下很有幫助。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объедините две вкладки в один экран и поставьте вверху сегментированный элемент «Полученные/Отправленные». Переключение происходит вверху экрана, рядом со списком, который вы смотрите, а экран остаётся на месте. Когда панель вкладок больше не нужна, место возвращается контенту. Пример 3.2.1 2 Tabs показывает противоположный случай, где две вкладки уместны, так что стоит сравнить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusiona las dos pestañas en una sola pantalla y pon arriba un control segmentado Recibidas/Enviadas. El cambio ocurre arriba de la pantalla, justo junto a la lista que estás viendo, y la pantalla se queda en su sitio. Una vez que la barra de pestañas ya no hace falta, ese espacio vuelve al contenido. El ejemplo 3.2.1 2 Tabs de la app muestra el caso contrario, donde dos pestañas son lo correcto, así que merece la pena compararlo."
          }
        }
      }
    },
    "두 탭의 사용 빈도가 9:1로 기울면 구조 재검토 신호, 부탭이 아니라 설정 화면이나 시트여야 할 수도 있습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If usage between the two tabs skews 9:1, that's a sign to rethink the structure. The minor one may belong in a settings screen or a sheet rather than a tab."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If usage between the two tabs skews 9:1, that's a sign to rethink the structure. The minor one may belong in a settings screen or a sheet rather than a tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのタブの利用頻度が9:1に偏るなら、構造を見直すサインです。小さいほうはタブではなく、設定画面やシートであるべきかもしれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果两个标签的使用频率倾斜到 9:1，就是重新审视结构的信号，副标签可能应该是设置界面或弹层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果兩個標籤的使用頻率傾斜到 9:1，就是重新審視結構的訊號，副標籤可能應該是設定介面或工作表。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если использование двух вкладок перекошено как 9:1, это повод пересмотреть структуру. Второстепенной, возможно, место на экране настроек или в шторке, а не во вкладке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el uso entre las dos pestañas está sesgado 9:1, es señal de que hay que replantear la estructura. La menor puede pertenecer a una pantalla de ajustes o a una hoja en lugar de a una pestaña."
          }
        }
      }
    },
    "둘 다 하단에 있는 것까지는 맞다. 고빈도 기능이 둘 이상이면 둘 다 하단에 있어야 도달성이 일관된다. 틀린 건 묶음이다. Liquid Glass에서 **같은 캡슐은 한 세트**라는 뜻이다. 검색은 입력이고 새 메모는 액션이다. 성격이 다른 둘을 한 캡슐에 넣으면 \"이 둘은 한 가지 일\"이라는 거짓 정보를 준다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Having both at the bottom is right. When there are two or more high-frequency features, both need to be at the bottom for consistent reachability. What's wrong is the grouping. In Liquid Glass, **sharing a capsule means being a set**. Search is input; New Note is an action. Putting two different kinds of things in one capsule gives the false information that \"these two are one task.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Having both at the bottom is right. When there are two or more high-frequency features, both need to be at the bottom for consistent reachability. What's wrong is the grouping. In Liquid Glass, **sharing a capsule means being a set**. Search is input; New Note is an action. Putting two different kinds of things in one capsule gives the false information that \"these two are one task.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方が下部にあるところまでは正しい。高頻度の機能が2つ以上あるなら、両方が下部にあってこそ届きやすさが一貫する。間違っているのは、まとめ方だ。Liquid Glass で**同じカプセルはひとつのセット**という意味になる。検索は入力で、新規メモはアクションだ。性格の違う2つをひとつのカプセルに入れると、「この2つはひとつの仕事」という嘘の情報を与える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个都在底部这一点是对的。高频功能有两个以上，两个都在底部，可触达性才一致。错的是分组。在 Liquid Glass 里，**同一个胶囊意味着一组**。搜索是输入，新备忘录是操作。把性质不同的两者放进同一个胶囊，传达了“这两个是同一件事”的假信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個都在底部這一點是對的。高頻功能有兩個以上，兩個都在底部，可觸達性才一致。錯的是分組。在 Liquid Glass 裡，**同一個膠囊意味著一組**。搜尋是輸入，新備忘錄是操作。把性質不同的兩者放進同一個膠囊，傳達了「這兩個是同一件事」的假資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что оба внизу, верно. Когда есть две и больше частые функции, обе нужно держать внизу ради последовательной досягаемости. Неверна группировка. В Liquid Glass **общая капсула значит, что это набор**. Поиск - ввод; «Новая заметка» - действие. Положив два разных по роду элемента в одну капсулу, вы сообщаете ложную информацию, что «это одно дело»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tener ambos abajo es lo correcto. Cuando hay dos o más funciones de alta frecuencia, ambas deben estar abajo para un alcance coherente. Lo que está mal es la agrupación. En Liquid Glass, **compartir cápsula significa ser un conjunto**. La búsqueda es entrada; Nueva nota es una acción. Meter dos tipos distintos de cosas en una cápsula da la información falsa de que «estas dos son una misma tarea»."
          }
        }
      }
    },
    "둘 중 하나를 이미 아는 것으로 바꾼다. 라벨을 누구나 아는 일반 명사로 쓰고 브랜드 용어는 화면 안에서 소개하거나, 라벨을 지키는 대신 아이콘을 뜻이 분명한 표준 SF Symbol로 바꾼다. 어느 쪽이든 한 채널이 의미를 붙잡아 주면 다른 채널은 익숙해지는 동안 기댈 곳이 생긴다. 3.1.1 예제와 3.1.2 예제를 나란히 보면 라벨이 무엇을 대신 해 주는지 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change one of the two into something familiar. Either use a common noun everyone knows for the label and introduce the brand term inside the screen, or keep the label and replace the icon with a standard SF Symbol whose meaning is clear. Either way, once one channel anchors the meaning, the other has something to lean on while it becomes familiar. Look at the 3.1.1 and 3.1.2 examples side by side to see what the label does for you."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Change one of the two into something familiar. Either use a common noun everyone knows for the label and introduce the brand term inside the screen, or keep the label and replace the icon with a standard SF Symbol whose meaning is clear. Either way, once one channel anchors the meaning, the other has something to lean on while it becomes familiar. Look at the 3.1.1 and 3.1.2 examples side by side to see what the label does for you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらか一方を、すでに知っているものに変える。ラベルを誰もが知っている一般名詞にしてブランド用語は画面の中で紹介するか、ラベルを守る代わりにアイコンを意味の明確な標準SF Symbolに替える。どちらにしても、一方のチャンネルが意味をつなぎ止めてくれれば、もう一方は慣れるまでの間の拠り所ができる。3.1.1の例と3.1.2の例を並べて見ると、ラベルが何を肩代わりしてくれているかがわかる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把两者之一换成人们已经知道的。标签用人人都懂的普通名词，品牌术语在界面内介绍；或者不动标签，把图标换成含义明确的标准 SF Symbol。无论哪种，只要有一个通道守住含义，另一个通道在熟悉的过程中就有了依靠。把 3.1.1 示例和 3.1.2 示例并排看，就能看到标签替你做了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把兩者之一換成人們已經知道的。標籤用人人都懂的普通名詞，品牌術語在介面內介紹；或者不動標籤，把圖示換成含義明確的標準 SF Symbol。無論哪種，只要有一個通道守住含義，另一個通道在熟悉的過程中就有了依靠。把 3.1.1 示例和 3.1.2 示例並排看，就能看到標籤替你做了什麼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замените одно из двух чем-то знакомым. Либо используйте для подписи известное всем нарицательное слово и представляйте фирменный термин внутри экрана, либо оставьте подпись и замените значок на стандартный SF Symbol с понятным смыслом. В любом случае, когда один канал закрепляет смысл, у другого есть опора, пока он становится привычным. Посмотрите рядом примеры 3.1.1 и 3.1.2, чтобы увидеть, что подпись делает за вас."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia una de las dos por algo familiar. O usa para la etiqueta un sustantivo común que todos conozcan y presenta el término de la marca dentro de la pantalla, o conserva la etiqueta y sustituye el icono por un SF Symbol estándar de significado claro. De cualquier modo, una vez que un canal ancla el significado, el otro tiene algo en lo que apoyarse mientras se vuelve familiar. Mira juntos los ejemplos 3.1.1 y 3.1.2 para ver lo que hace la etiqueta por ti."
          }
        }
      }
    },
    "둘은 서로를 보완하지 않고 **서로의 약점을 겹친다.** 줄 수를 1로 묶으면 큰 글씨가 늘어날 공간이 없고, 축소는 사용자가 키운 글자를 다시 줄인다. Dynamic Type 큰 글씨에서는 같은 문장도 더 많은 줄을 차지한다. 그 늘어남을 받아 줄 자리를 막고, 막힌 만큼 줄인 것이다. 큰 글씨를 켠 사람은 더 잘 읽으려고 켰다. 그 사람에게 가장 안 읽히는 화면이 된다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two don't complement each other; **they compound each other's weaknesses.** Limiting the line count to 1 leaves larger text no room to grow, and scaling shrinks the very text the user enlarged. At large Dynamic Type sizes, the same sentence takes up more lines. This setup blocks the space that growth needs, then shrinks the text by however much was blocked. People who turn on larger text do so to read better, and for them this becomes the hardest screen to read."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The two don't complement each other; **they compound each other's weaknesses.** Limiting the line count to 1 leaves larger text no room to grow, and scaling shrinks the very text the user enlarged. At large Dynamic Type sizes, the same sentence takes up more lines. This setup blocks the space that growth needs, then shrinks the text by however much was blocked. People who turn on larger text do so to read better, and for them this becomes the hardest screen to read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つは互いを補わず、**互いの弱点を重ねてしまう。** 行数を1に縛れば大きな文字が広がる余地がなくなり、縮小はユーザーが大きくした文字をまた小さくする。Dynamic Typeの大きな文字では、同じ文でもより多くの行を使う。その広がりを受け止める場所をふさぎ、ふさいだ分だけ縮めているのだ。大きな文字をオンにした人は、もっと読みやすくするためにオンにした。その人にとって、いちばん読みにくい画面になってしまう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两者不是互补，而是**叠加了彼此的弱点。**行数限制为 1，大字号就没有可扩展的空间；缩小又会把用户放大的字再缩小。在 Dynamic Type 大字号下，同一句话会占更多行。堵住了容纳这种增长的位置，又按被堵的程度缩小。开大字号的人是为了读得更清楚，对他们来说，这成了最难读的界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩者不是互補，而是**疊加了彼此的弱點。**行數限制為 1，大字號就沒有可擴充套件的空間；縮小又會把使用者放大的字再縮小。在 Dynamic Type 大字號下，同一句話會佔更多行。堵住了容納這種增長的位置，又按被堵的程度縮小。開大字號的人是為了讀得更清楚，對他們來說，這成了最難讀的介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они не дополняют друг друга, а **накладывают друг на друга свои слабости.** Ограничение в одну строку не оставляет увеличенному тексту места для роста, а масштабирование уменьшает тот самый текст, который пользователь увеличил. При крупных размерах Dynamic Type то же предложение занимает больше строк. Эта конфигурация закрывает место, нужное росту, а затем уменьшает текст на столько, на сколько закрыла. Люди, включающие крупный текст, делают это, чтобы лучше читать, и для них это становится самым труднопрочитываемым экраном."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dos no se complementan; **se componen las debilidades una a otra.** Limitar el recuento de líneas a 1 no deja espacio para que crezca el texto más grande, y el escalado encoge el mismo texto que el usuario agrandó. Con tamaños grandes de Dynamic Type, la misma frase ocupa más líneas. Esta configuración bloquea el espacio que necesita el crecimiento y luego encoge el texto tanto como se bloqueó. Quienes activan el texto más grande lo hacen para leer mejor, y para ellos esta pasa a ser la pantalla más difícil de leer."
          }
        }
      }
    },
    "뒤 조작이 가능한데 딤을 깔아 모달처럼 보이게(신호 모순)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimming the background even though it's interactive, making it look modal (contradictory signals)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimming the background even though it's interactive, making it look modal (contradictory signals)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背後を操作できるのにディミングを敷き、モーダルのように見せる（サインの矛盾）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明明可以操作后面，却铺上压暗，看起来像模态（信号矛盾）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明明可以操作後面，卻鋪上壓暗，看起來像模態（訊號矛盾）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемнение фона при том, что с ним можно взаимодействовать, из-за чего он выглядит модальным (противоречивые сигналы)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenuar el fondo aunque sea interactivo, haciendo que parezca modal (señales contradictorias)"
          }
        }
      }
    },
    "뒤 지도를 보며 확인": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked against the map behind it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked against the map behind it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背後の地図を見ながら確認"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一边看着后面的地图一边确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一邊看著後面的地圖一邊確認"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверялись с картой позади"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobado contra el mapa de detrás"
          }
        }
      }
    },
    "뒤 콘텐츠 흐름이 뚝 끊김": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flow of content behind it is abruptly cut off"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The flow of content behind it is abruptly cut off"
          }
