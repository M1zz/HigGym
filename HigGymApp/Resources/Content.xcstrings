        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Eliminar** mantenido a propósito dentro del desbordamiento (evita toques accidentales)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Löschen** bewusst im Überlauf gehalten (verhindert versehentliches Antippen)"
