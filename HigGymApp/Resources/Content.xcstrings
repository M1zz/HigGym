          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak kembali ke posisi asal saat ditutup"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Returnerer ikke til opprinnelig posisjon ved lukking"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij sluiten niet terugkeren naar de oorspronkelijke positie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niewracanie do pierwotnej pozycji przy zamknięciu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att inte återvända till ursprungspositionen vid stängning"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapanırken özgün konuma dönmemek"
          }
        }
      }
    },
