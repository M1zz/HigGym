    },
    "아이템 우상단에 **빨간 숫자 배지** (.badge(3)), 미처리 항목 개수.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **red numeric badge** at the item's top right (.badge(3)), showing the number of unhandled items."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **red numeric badge** at the item's top right (.badge(3)), showing the number of unhandled items."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目の右上に**赤い数字のバッジ**（.badge(3)）。未処理の件数。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目右上角的**红色数字角标**（.badge(3)），未处理项目的数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目右上角的**紅色數字標記**（.badge(3)），未處理項目的數量。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Красный числовой бейдж** справа вверху элемента (.badge(3)), показывающий число необработанных элементов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una **insignia numérica roja** arriba a la derecha del elemento (.badge(3)), que muestra el número de elementos sin atender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein **rotes Zahlen-Badge** oben rechts am Element (.badge(3)), das die Zahl der unerledigten Punkte zeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **badge numérique rouge** en haut à droite de l'élément (.badge(3)), montrant le nombre d'éléments non traités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **badge numerico rosso** in alto a destra dell'elemento (.badge(3)), che mostra il numero di elementi non gestiti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um **badge numérico vermelho** no canto superior direito do item (.badge(3)), mostrando o número de itens não tratados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ป้ายตัวเลขสีแดง**ที่มุมขวาบนของรายการ (.badge(3)) แสดงจำนวนรายการที่ยังไม่ได้จัดการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một **huy hiệu số đỏ** ở góc trên bên phải mục (.badge(3)), cho biết số mục chưa xử lý."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Červený číselný odznak** vpravo nahoře u položky (.badge(3)), ukazující počet nevyřízených položek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En **rød talbadge** øverst til højre på elementet (.badge(3)), der viser antallet af uhåndterede ting."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα **κόκκινο σήμα αριθμού** πάνω δεξιά στο στοιχείο (.badge(3)), που δείχνει τον αριθμό των μη χειρισμένων στοιχείων."
          }
        }
      }
    },
