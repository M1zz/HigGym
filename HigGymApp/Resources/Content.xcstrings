        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το minimumScaleFactor(0.5) (+ lineLimit(1)) χωρά το κείμενο στον χώρο **σμικρύνοντας το μέγεθος γραμματοσειράς** αντί να το κόβει."
          }
        },
        "fi": {
          "stringUnit": {
