    },
    "탭 + search role + 액세서리 + 최소화**하단 시스템의 풀 구성**.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs + search role + accessory + minimization: **the full bottom-system setup**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs + search role + accessory + minimisation: **the full bottom-system setup**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブ＋search role＋アクセサリ＋最小化。**下部システムのフル構成**。"
