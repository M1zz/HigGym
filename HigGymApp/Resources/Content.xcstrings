            "state": "translated",
            "value": ".safeAreaBar(edge: .top): coloca una vista personalizada en el **área segura superior**. El contenido desplazable empieza automáticamente por debajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".safeAreaBar(edge: .top): setzt eine eigene Ansicht in den **oberen sicheren Bereich**. Scrollender Inhalt beginnt automatisch darunter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ".safeAreaBar(edge: .top) : place une vue personnalisée dans la **zone sûre du haut**. Le contenu défilant commence automatiquement en dessous."
          }
        },
        "it": {
          "stringUnit": {
