        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínač zobrazení kalendáře (Den/Týden/Měsíc) + tlačítko **Dnes** vpravo"
          }
        },
        "da": {
          "stringUnit": {
