        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Randbalken vullen met een ondoorzichtige effen kleur"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnianie pasków krawędziowych nieprzezroczystym jednolitym kolorem"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att fylla kantfält med en ogenomskinlig enfärgad yta"
