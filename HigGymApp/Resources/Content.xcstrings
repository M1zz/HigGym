          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอที่ต้องใช้การค้นหาตลอดเวลา เช่นพจนานุกรมหรือสมุดที่อยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình luôn cần tìm kiếm, như từ điển hay danh bạ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovky, které potřebují hledání pořád, jako slovník nebo adresář"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærme, der altid har brug for søgning, som en ordbog eller en adressebog"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οθόνες που χρειάζονται αναζήτηση συνεχώς, όπως ένα λεξικό ή ένα βιβλίο διευθύνσεων"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkymät, jotka tarvitsevat hakua koko ajan, kuten sanakirja tai osoitekirja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar yang membutuhkan pencarian setiap saat, seperti kamus atau buku alamat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermer som trenger søk hele tiden, som en ordbok eller en adressebok"
          }
        },
        "nl": {
          "stringUnit": {
