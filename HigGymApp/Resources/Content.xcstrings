        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**การตั้งค่า**ที่ใช้เดือนละครั้งวางไว้ด้านล่าง (ฝ่าฝืนเกณฑ์ความถี่)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Cài đặt**, dùng mỗi tháng một lần, đặt ở dưới (vi phạm tiêu chí tần suất)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nastavení**, používané jednou za měsíc, umístěné dole (porušuje kritérium frekvence)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Indstillinger**, brugt en gang om måneden, placeret i bunden (bryder hyppighedskriteriet)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ρυθμίσεις**, που χρησιμοποιούνται μία φορά τον μήνα, τοποθετημένες κάτω (παραβιάζει το κριτήριο συχνότητας)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Asetukset**, joita käytetään kerran kuussa, sijoitettuna alas (rikkoo käyttötiheyskriteeriä)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pengaturan**, dipakai sebulan sekali, ditaruh di bawah (melanggar kriteria frekuensi)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Innstillinger**, brukt én gang i måneden, plassert nederst (bryter frekvenskriteriet)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Instellingen**, één keer per maand gebruikt, onderaan geplaatst (schendt het frequentiecriterium)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ustawienia**, używane raz w miesiącu, umieszczone na dole (narusza kryterium częstotliwości)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Inställningar**, som används en gång i månaden, placerade längst ner (bryter mot frekvenskriteriet)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayda bir kullanılan **Ayarlar**'ın altta durması (sıklık ölçütünü ihlal eder)"
          }
        }
      }
    },
