            "value": "Hình thu nhỏ → trình xem toàn màn hình"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniatura fotky → prohlížeč na celou obrazovku"
          }
        },
        "da": {
