            "value": "Soft sur les écrans où les sections comptent, comme les tableaux et les grilles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft nelle schermate in cui le sezioni contano, come tabelle e griglie"
          }
        },
        "pt-BR": {
          "stringUnit": {
