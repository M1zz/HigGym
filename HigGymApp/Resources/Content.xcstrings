            "state": "translated",
            "value": "Allowing text selection even on button labels"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンのラベルにまでテキスト選択を許可する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按钮标签也允许文本选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
