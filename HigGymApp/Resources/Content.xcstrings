        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**„Czy ten element interfejsu wnosi coś do zadania osoby teraz?”** Jeśli treść zostaje zepchnięta w dół już od pierwszego ekranu, duży tytuł zabiera więcej, niż daje."
          }
        },
        "sv": {
          "stringUnit": {
