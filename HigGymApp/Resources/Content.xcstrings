    "여는 애니메이션만 신경 쓰고 닫는 쪽은 기본으로 둔다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You fuss over the opening animation and leave the closing side at its default."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You fuss over the opening animation and leave the closing side at its default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開くアニメーションだけ気にして、閉じる側はデフォルトのままにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在意打开时的动画，关闭的一边则保持默认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在意開啟時的動畫，關閉的一邊則保持預設。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы возитесь с анимацией открытия, а закрытие оставляете по умолчанию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te preocupas por la animación de apertura y dejas el lado del cierre en el valor por defecto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du feilst an der Öffnungsanimation und lässt die Schließseite auf dem Standard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous peaufinez l'animation d'ouverture et laissez le côté fermeture à son réglage par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti preoccupi dell'animazione di apertura e lasci quella di chiusura al predefinito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você se esmera na animação de abertura e deixa o lado do fechamento no padrão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณพิถีพิถันกับแอนิเมชันตอนเปิด แล้วปล่อยฝั่งปิดเป็นค่าเริ่มต้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn tỉ mỉ với hoạt ảnh mở mà để phía đóng ở mặc định."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Piplete se s animací otevření a zavírací stranu necháte ve výchozím stavu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du går op i åbningsanimationen og lader lukkesiden stå på standard."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ασχολείσαι με την κίνηση ανοίγματος και αφήνεις την πλευρά κλεισίματος στην προεπιλογή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiot avausanimaatiota ja jätät sulkemispuolen oletukselle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sibuk dengan animasi pembukaan dan membiarkan sisi penutupan pada bawaannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bruker mye tid på åpningsanimasjonen og lar lukkesiden stå på standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zeurt over de openingsanimatie en laat de sluitende kant op de standaard staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejmujesz się animacją otwarcia, a stronę zamykającą zostawiasz w ustawieniu domyślnym."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du pillar med öppningsanimationen och lämnar stängningssidan på standard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılış animasyonuyla uğraşıp kapanış tarafını varsayılanında bırakırsın."
          }
        }
      }
    },
