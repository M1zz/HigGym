        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de abas **fica parada** mesmo nas telas de detalhe, servindo de mapa constante"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บ**อยู่กับที่**แม้ในหน้ารายละเอียด ทำหน้าที่เป็นแผนที่คงที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab **đứng yên** ngay cả trên màn hình chi tiết, làm bản đồ thường trực"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet **zůstává na místě** i na detailních obrazovkách a slouží jako stálá mapa"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen **bliver på plads** selv i detaljeskærme og tjener som et konstant kort"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών **μένει στη θέση της** ακόμα και σε οθόνες λεπτομερειών, λειτουργώντας ως σταθερός χάρτης"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välilehtipalkki **pysyy paikallaan** myös yksityiskohtanäkymissä toimien jatkuvana karttana"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah tab **tetap di tempat** bahkan di layar detail, berfungsi sebagai peta yang konstan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen **blir stående** selv på detaljskjermer, og fungerer som et konstant kart"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tabbalk **blijft staan**, ook in detailschermen, als constante kaart"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasek kart **zostaje na miejscu** nawet na ekranach szczegółów, służąc jako stała mapa"
