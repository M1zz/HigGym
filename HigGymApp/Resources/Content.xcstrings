    },
    "모호한 아이콘에 처음 보는 신조어 라벨을 붙인다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing an ambiguous icon with an unfamiliar coined label"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing an ambiguous icon with an unfamiliar coined label"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あいまいなアイコンに見慣れない造語のラベルを付ける"
