        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นฟีเจอร์ใหม่ คุณจึงอยากให้อยู่ที่ที่เด่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là tính năng mới nên bạn muốn nó ở chỗ nổi bật."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to nová funkce, takže ji chcete na nápadném místě."
          }
        },
        "da": {
