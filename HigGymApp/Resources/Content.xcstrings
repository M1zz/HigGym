    "메뉴 순서를 정하는 기준은 흐름이 아니라 **무게**다. 되돌릴 수 없는 것은 언제나 따로, 그리고 끝에.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule for ordering a menu is **weight**, not flow. Anything irreversible always goes separately, and at the end."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule for ordering a menu is **weight**, not flow. Anything irreversible always goes separately, and at the end."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューの順番を決める基準は、流れではなく**重さ**だ。取り消せないものは、いつも別に、そして最後に。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定菜单顺序的标准不是流程，而是**分量**。无法撤销的永远单独放，并放在最后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定選單順序的標準不是流程，而是**分量**。無法撤銷的永遠單獨放，並放在最後。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило порядка в меню - **вес**, а не поток. Всё необратимое всегда идёт отдельно и в конце."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La regla para ordenar un menú es **el peso**, no el flujo. Todo lo irreversible va siempre aparte, y al final."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regel für die Reihenfolge eines Menüs ist **Gewicht**, nicht Ablauf. Alles Unumkehrbare steht immer getrennt und am Ende."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La règle pour ordonner un menu est **le poids**, pas le déroulement. Tout ce qui est irréversible va toujours à part, et à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La regola per ordinare un menu è il **peso**, non il flusso. Tutto ciò che è irreversibile va sempre a parte, e in fondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A regra para ordenar um menu é o **peso**, não o fluxo. Tudo o que é irreversível vai sempre à parte, e no fim."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กฎการเรียงเมนูคือ**น้ำหนัก** ไม่ใช่การไหล สิ่งที่ย้อนกลับไม่ได้ไปแยกต่างหากเสมอ และอยู่ท้ายสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy tắc sắp xếp menu là **trọng lượng**, không phải dòng chảy. Thứ không thể hoàn tác luôn tách riêng, và ở cuối."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidlem řazení nabídky je **váha**, ne tok. Cokoli nevratného jde vždy zvlášť a na konec."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglen for rækkefølgen i en menu er **vægt**, ikke flow. Alt uigenkaldeligt kommer altid for sig og til sidst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κανόνας για τη σειρά ενός μενού είναι **το βάρος**, όχι η ροή. Ό,τι είναι μη αναστρέψιμο πηγαίνει πάντα χωριστά, και στο τέλος."
          }
        }
      }
    },
    "메뉴 안에 서브메뉴 3단 중첩": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submenus nested three levels deep inside a menu"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Submenus nested three levels deep inside a menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューの中にサブメニューを3階層ネストする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单里嵌套三层子菜单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單裡巢狀三層子選單"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подменю, вложенные в меню на три уровня"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Submenús anidados a tres niveles dentro de un menú"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Ebenen tief verschachtelte Untermenüs in einem Menü"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des sous-menus imbriqués sur trois niveaux dans un menu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sottomenu annidati su tre livelli dentro un menu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Submenus aninhados em três níveis dentro de um menu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมนูย่อยซ้อนลึกสามระดับภายในเมนู"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu con lồng ba cấp bên trong một menu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podnabídky vnořené do tří úrovní uvnitř nabídky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undermenuer indlejret tre niveauer dybt inde i en menu"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπομενού ένθετα τρία επίπεδα βαθιά μέσα σε μενού"
          }
        }
      }
    },
    "메뉴 안에 숨는 순간 아무도 못 찾을 것 같아 전부 노출하려 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You try to show everything, afraid that once something hides in a menu, no one will ever find it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You try to show everything, afraid that once something hides in a menu, no one will ever find it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューの中に隠れた瞬間に誰にも見つけてもらえない気がして、すべてを見せようとする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "觉得一藏进菜单就没人能找到，想全部露出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覺得一藏進選單就沒人能找到，想全部露出來。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы пытаетесь показать всё, боясь, что стоит чему-то спрятаться в меню, и никто это не найдёт."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intentas mostrarlo todo, por miedo a que, una vez que algo se esconde en un menú, nadie lo vuelva a encontrar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du versuchst, alles zu zeigen, aus Angst, dass niemand etwas findet, sobald es sich in einem Menü versteckt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous essayez de tout montrer, de peur qu'une fois caché dans un menu, personne ne le trouve jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Provi a mostrare tutto, per timore che una volta nascosto in un menu, nessuno lo trovi mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tenta mostrar tudo, com medo de que, uma vez escondido num menu, ninguém o ache."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณพยายามแสดงทุกอย่าง เพราะกลัวว่าเมื่ออะไรซ่อนในเมนูแล้วจะไม่มีใครเจอเลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cố hiển thị mọi thứ, sợ rằng một khi thứ gì đó ẩn trong menu thì sẽ không ai tìm thấy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snažíte se ukázat všechno, protože se bojíte, že jakmile se něco schová v nabídce, nikdo to nikdy nenajde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du forsøger at vise alt, bange for at ingen nogensinde finder noget, der gemmer sig i en menu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσπαθείς να δείξεις τα πάντα, φοβούμενος ότι μόλις κάτι κρυφτεί σε ένα μενού, κανείς δεν θα το βρει ποτέ."
          }
        }
      }
    },
    "메뉴 항목을 **작업 흐름 순서**로 정렬한다. 파일을 다룰 때 보통 이름을 바꾸고, 복제하고, 필요 없으면 지우고, 정리해서 옮기고, 마지막에 공유한다. 논리적인 순서이고 기획 문서에 적기에도 좋다. 순서가 이야기처럼 흐르니 정돈된 설계처럼 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sort the menu items in **the order of the workflow**. When handling a file, you usually rename it, duplicate it, delete it if it's not needed, move it to organize, and finally share it. It's a logical order and easy to write up in a spec. The order flows like a story, so it looks like a tidy design."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You sort the menu items in **the order of the workflow**. When handling a file, you usually rename it, duplicate it, delete it if it's not needed, move it to organise, and finally share it. It's a logical order and easy to write up in a spec. The order flows like a story, so it looks like a tidy design."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューの項目を**作業の流れの順**に並べる。ファイルを扱うときは、ふつう名前を変え、複製し、いらなければ消し、整理して移し、最後に共有する。論理的な順番で、企画書にも書きやすい。順番が物語のように流れるので、整った設計に見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把菜单项按**工作流程顺序**排列。处理文件时通常是重命名、复制、不需要就删除、整理后移动，最后分享。顺序合乎逻辑，写进策划文档也好看。顺序像故事一样流畅，看起来像是整齐的设计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把選單項按**工作流程順序**排列。處理檔案時通常是重新命名、複製、不需要就刪除、整理後移動，最後分享。順序合乎邏輯，寫進策劃文件也好看。順序像故事一樣流暢，看起來像是整齊的設計。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы расставляете пункты меню **в порядке рабочего процесса**. Работая с файлом, обычно переименовывают, дублируют, удаляют, если не нужен, переносят для порядка и в конце делятся. Порядок логичный и его удобно записать в спецификацию. Порядок течёт как рассказ, поэтому выглядит аккуратным решением."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenas los elementos del menú **según el orden del flujo de trabajo**. Al tratar un archivo, normalmente lo renombras, lo duplicas, lo eliminas si no hace falta, lo mueves para organizar y por último lo compartes. Es un orden lógico y fácil de plasmar en una especificación. El orden fluye como una historia, así que parece un diseño ordenado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sortierst die Menüpunkte **in der Reihenfolge des Arbeitsablaufs**. Bei einer Datei benennt man sie meist um, dupliziert sie, löscht sie, wenn sie unnötig ist, verschiebt sie zum Ordnen und teilt sie zuletzt. Es ist eine logische Reihenfolge und lässt sich leicht in einer Spezifikation festhalten. Die Reihenfolge fließt wie eine Geschichte, also wirkt es wie ein sauberes Design."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous classez les éléments du menu **dans l'ordre du déroulement**. Pour traiter un fichier, on le renomme généralement, on le duplique, on le supprime s'il est inutile, on le déplace pour ranger, et enfin on le partage. C'est un ordre logique, facile à consigner dans une spécification. L'ordre s'enchaîne comme une histoire, donc cela paraît un design soigné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordini le voci del menu **nell'ordine del flusso di lavoro**. Quando gestisci un file, di solito lo rinomini, lo duplichi, lo elimini se non serve, lo sposti per organizzare e infine lo condividi. È un ordine logico e facile da scrivere in una specifica. L'ordine scorre come una storia, quindi sembra un design ordinato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ordena os itens do menu **na ordem do fluxo de trabalho**. Ao lidar com um arquivo, normalmente você o renomeia, duplica, exclui se não precisa, move para organizar e por fim compartilha. É uma ordem lógica e fácil de escrever numa especificação. A ordem flui como uma história, então parece um design arrumado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเรียงรายการเมนู**ตามลำดับเวิร์กโฟลว์** เมื่อจัดการไฟล์ มักจะเปลี่ยนชื่อ ทำซ้ำ ลบถ้าไม่ต้องใช้ ย้ายเพื่อจัดระเบียบ และสุดท้ายแชร์ เป็นลำดับที่สมเหตุสมผลและเขียนลงสเปกง่าย ลำดับไหลเหมือนเรื่องเล่า จึงดูเหมือนการออกแบบที่เรียบร้อย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sắp xếp các mục menu theo **thứ tự của quy trình làm việc**. Khi xử lý tệp, thường là đổi tên, nhân đôi, xóa nếu không cần, di chuyển để sắp xếp, và cuối cùng chia sẻ. Đó là thứ tự logic và dễ viết vào đặc tả. Thứ tự chảy như một câu chuyện nên trông như thiết kế gọn gàng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky nabídky řadíte **v pořadí pracovního postupu**. Při práci se souborem ho obvykle přejmenujete, duplikujete, smažete, pokud ho nepotřebujete, přesunete kvůli pořádku a nakonec sdílíte. Je to logické pořadí a snadno se zapíše do specifikace. Pořadí plyne jako příběh, takže vypadá jako úhledný design."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sorterer menuens elementer i **arbejdsgangens rækkefølge**. Når man håndterer en fil, omdøber man den som regel, duplikerer den, sletter den, hvis den ikke er nødvendig, flytter den for at organisere og deler den til sidst. Det er en logisk rækkefølge og let at skrive ind i en specifikation. Rækkefølgen flyder som en historie, så det ser ud som et ryddeligt design."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταξινομείς τα στοιχεία του μενού με **τη σειρά της ροής εργασίας**. Όταν χειρίζεσαι ένα αρχείο, συνήθως το μετονομάζεις, το αντιγράφεις, το διαγράφεις αν δεν χρειάζεται, το μετακινείς για να οργανωθείς και τελικά το κοινοποιείς. Είναι λογική σειρά και εύκολη να γραφτεί σε προδιαγραφή. Η σειρά ρέει σαν ιστορία, οπότε φαίνεται τακτοποιημένος σχεδιασμός."
          }
        }
      }
    },
    "메뉴는 **“요청할 때만 나타나는 UI”**의 대표 장치입니다, 평소엔 버튼 하나의 존재감, 탭하면 전체 선택지. minimization 원칙이 액션 목록에 적용된 형태입니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu is the classic example of **“UI that appears only when you ask for it”**: normally it has the presence of a single button, and a tap reveals every option. It is the minimization principle applied to a list of actions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu is the classic example of **“UI that appears only when you ask for it”**: normally it has the presence of a single button, and a tap reveals every option. It is the minimisation principle applied to a list of actions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューは「**求められたときだけ現れるUI**」の代表的な装置です。普段はボタンひとつ分の存在感で、タップするとすべての選択肢が出てくる。minimizationの原則をアクションのリストに適用した形です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单是**“请求时才出现的 UI”**的代表装置：平时只有一个按钮的存在感，点按后展开全部选项。是 minimization 原则用在操作列表上的形态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單是**「請求時才出現的 UI」**的代表裝置：平時只有一個按鈕的存在感，輕點後展開全部選項。是 minimization 原則用在操作列表上的形態。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню - классический пример **«интерфейса, который появляется только по запросу»**: обычно оно присутствует как одна кнопка, а нажатие раскрывает все варианты. Это принцип минимизации, применённый к списку действий."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un menú es el ejemplo clásico de **«interfaz que aparece solo cuando se pide»**: normalmente tiene la presencia de un solo botón, y un toque revela todas las opciones. Es el principio de minimización aplicado a una lista de acciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Menü ist das klassische Beispiel für **„UI, die nur erscheint, wenn man sie verlangt“**: Normalerweise hat es die Präsenz eines einzelnen Buttons, und ein Tipp enthüllt alle Optionen. Es ist das Minimierungsprinzip, angewendet auf eine Liste von Aktionen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un menu est l'exemple classique de **« l'interface qui n'apparaît que lorsqu'on la demande »** : normalement il a la présence d'un seul bouton, et un toucher révèle toutes les options. C'est le principe de minimisation appliqué à une liste d'actions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un menu è l'esempio classico di **«UI che compare solo quando la chiedi»**: normalmente ha la presenza di un solo pulsante, e un tocco rivela tutte le opzioni. È il principio di minimizzazione applicato a un elenco di azioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um menu é o exemplo clássico de **«interface que aparece só quando você pede»**: normalmente tem a presença de um único botão, e um toque revela todas as opções. É o princípio de minimização aplicado a uma lista de ações."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมนูคือตัวอย่างคลาสสิกของ**“UI ที่ปรากฏเมื่อขอเท่านั้น”**: ปกติมีตัวตนเท่าปุ่มเดียว และการแตะเผยทุกตัวเลือก เป็นหลักการย่อขนาดที่ใช้กับรายการการกระทำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu là ví dụ kinh điển của **\"UI chỉ hiện khi bạn yêu cầu\"**: bình thường nó có sự hiện diện của một nút, và một lần chạm mở mọi tùy chọn. Đó là nguyên tắc tối thiểu hóa áp dụng cho danh sách hành động."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabídka je klasickým příkladem **„UI, které se objeví, jen když o ně požádáte“**: normálně má přítomnost jediného tlačítka a klepnutí odhalí všechny možnosti. Je to princip minimalizace aplikovaný na seznam akcí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En menu er det klassiske eksempel på **»brugerflade, der kun vises, når du beder om den«**: normalt har den tilstedeværelsen af en enkelt knap, og et tryk afslører alle valgmuligheder. Det er minimeringsprincippet anvendt på en liste af handlinger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μενού είναι το κλασικό παράδειγμα **«διεπαφής που εμφανίζεται μόνο όταν τη ζητήσεις»**: κανονικά έχει την παρουσία ενός κουμπιού, και ένα πάτημα αποκαλύπτει κάθε επιλογή. Είναι η αρχή ελαχιστοποίησης εφαρμοσμένη σε μια λίστα ενεργειών."
          }
        }
      }
    },
    "메뉴는 접혀 있으니 얼마든 넣어도 화면을 어지럽히지 않는다고 생각한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus are collapsed, so you think you can put in as much as you want without cluttering the screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus are collapsed, so you think you can put in as much as you want without cluttering the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューは折りたたまれているので、いくら入れても画面を散らかさないと考える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "觉得菜单是折叠的，放多少都不会弄乱界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覺得選單是摺疊的，放多少都不會弄亂介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню свёрнуто, поэтому вы считаете, что можно класть сколько угодно, не загромождая экран."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los menús están colapsados, así que piensas que puedes meter todo lo que quieras sin saturar la pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüs sind eingeklappt, also denkst du, du könntest beliebig viel hineinlegen, ohne den Bildschirm zu überladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les menus sont repliés, donc vous pensez pouvoir y mettre autant que vous voulez sans encombrer l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I menu sono compressi, quindi pensi di poterci mettere quanto vuoi senza ingombrare la schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os menus são recolhidos, então você acha que pode pôr neles o quanto quiser sem entulhar a tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมนูถูกยุบอยู่ คุณจึงคิดว่าใส่ได้เท่าที่ต้องการโดยไม่รกหน้าจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu thu gọn, nên bạn nghĩ có thể bỏ vào bao nhiêu tùy thích mà không làm rối màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabídky jsou sbalené, takže si myslíte, že do nich můžete dát, kolik chcete, aniž by se obrazovka zaplnila."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Menuer er sammenfoldede, så du tænker, at du kan lægge så meget ind, som du vil, uden at rode skærmen til."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μενού είναι συμπτυγμένα, οπότε νομίζεις ότι μπορείς να βάλεις όσα θες χωρίς να γεμίσεις την οθόνη."
          }
        }
      }
    },
    "메뉴는 접혀 있으니 화면을 어지럽히지 않는다. 옵션이 늘어날 때마다 관련 있는 것끼리 한 단계 더 묶으면 트리가 깔끔해진다. 설계 문서에서 계층도로 그려 보면 논리적으로 완벽하다. 화면이 아니라 메뉴 안에 넣었으니 비용이 없다고 생각한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus are collapsed, so they don't clutter the screen. Every time options grow, grouping related ones one level deeper keeps the tree tidy. Drawn as a hierarchy in a design doc, it's logically perfect. Since you put it in a menu rather than on the screen, you think it costs nothing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Menus are collapsed, so they don't clutter the screen. Every time options grow, grouping related ones one level deeper keeps the tree tidy. Drawn as a hierarchy in a design doc, it's logically perfect. Since you put it in a menu rather than on the screen, you think it costs nothing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューは折りたたまれているので、画面を散らかさない。オプションが増えるたびに、関係のあるものどうしをもう1段まとめれば、ツリーがすっきりする。設計書で階層図に描いてみると、論理的には完璧だ。画面ではなくメニューの中に入れたのだから、コストはないと考える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单是折叠的，不会弄乱界面。每当选项增加，就把相关的再归一层，树就会整洁。在设计文档里画成层级图，逻辑上完美无缺。因为放进的是菜单而不是界面，就觉得没有成本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單是摺疊的，不會弄亂介面。每當選項增加，就把相關的再歸一層，樹就會整潔。在設計文件裡畫成層級圖，邏輯上完美無缺。因為放進的是選單而不是介面，就覺得沒有成本。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню свёрнуто, поэтому экран оно не загромождает. Каждый раз, когда параметров прибавляется, сгруппировать связанные на уровень глубже, и дерево остаётся опрятным. Нарисованное иерархией в проектном документе, оно логически безупречно. Раз вы положили это в меню, а не на экран, кажется, что это ничего не стоит."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los menús están colapsados, así que no saturan la pantalla. Cada vez que las opciones crecen, agrupar las relacionadas un nivel más hondo mantiene el árbol ordenado. Dibujado como jerarquía en un documento de diseño, es lógicamente perfecto. Como lo metiste en un menú en lugar de en la pantalla, piensas que no cuesta nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüs sind eingeklappt, also überladen sie den Bildschirm nicht. Wachsen die Optionen, hält die Gruppierung zusammengehöriger eine Ebene tiefer den Baum ordentlich. Als Hierarchie in einem Designdokument gezeichnet, ist es logisch perfekt. Da du es in ein Menü und nicht auf den Bildschirm legst, denkst du, es koste nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les menus sont repliés, donc ils n'encombrent pas l'écran. Chaque fois que les options augmentent, regrouper les options liées un niveau plus profond garde l'arbre en ordre. Dessiné comme une hiérarchie dans un document de design, c'est logiquement parfait. Comme vous le mettez dans un menu plutôt que sur l'écran, vous pensez que cela ne coûte rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I menu sono compressi, quindi non ingombrano la schermata. Ogni volta che le opzioni crescono, raggruppare le correlate un livello più in profondità mantiene l'albero ordinato. Disegnato come gerarchia in un documento di design, è logicamente perfetto. Poiché l'hai messo in un menu e non sulla schermata, pensi che non costi nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os menus são recolhidos, então não entulham a tela. Toda vez que as opções crescem, agrupar as relacionadas um nível mais fundo mantém a árvore arrumada. Desenhado como hierarquia num documento de design, é logicamente perfeito. Como você pôs num menu e não na tela, acha que não custa nada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมนูถูกยุบอยู่ จึงไม่รกหน้าจอ ทุกครั้งที่ตัวเลือกเพิ่ม การจัดกลุ่มตัวที่เกี่ยวข้องลงลึกอีกหนึ่งระดับทำให้ต้นไม้เรียบร้อย วาดเป็นลำดับชั้นในเอกสารดีไซน์ สมบูรณ์เชิงตรรกะ เพราะใส่ในเมนูแทนที่จะอยู่บนหน้าจอ คุณจึงคิดว่าไม่เสียอะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu thu gọn nên không làm rối màn hình. Mỗi lần tùy chọn tăng, gom các cái liên quan sâu thêm một cấp giữ cho cây gọn gàng. Vẽ thành thứ bậc trong tài liệu thiết kế thì hoàn hảo về logic. Vì bạn bỏ vào menu chứ không đặt lên màn hình, bạn nghĩ nó không tốn gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabídky jsou sbalené, takže obrazovku nezaplňují. Pokaždé, když možností přibude, seskupení souvisejících o úroveň hlouběji udržuje strom úhledný. Nakresleno jako hierarchie v designovém dokumentu je to logicky dokonalé. Protože to dáváte do nabídky a ne na obrazovku, myslíte si, že to nic nestojí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Menuer er sammenfoldede, så de roder ikke skærmen til. Hver gang valgmulighederne vokser, holder det at gruppere relaterede ét niveau dybere træet ryddeligt. Tegnet som et hierarki i et designdokument er det logisk perfekt. Da du lagde det i en menu frem for på skærmen, tror du, at det ikke koster noget."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μενού είναι συμπτυγμένα, οπότε δεν γεμίζουν την οθόνη. Κάθε φορά που οι επιλογές μεγαλώνουν, η ομαδοποίηση των σχετικών ένα επίπεδο βαθύτερα κρατά το δέντρο τακτοποιημένο. Σχεδιασμένο ως ιεραρχία σε σχεδιαστικό έγγραφο, είναι λογικά τέλειο. Εφόσον το έβαλες σε μενού και όχι στην οθόνη, νομίζεις ότι δεν κοστίζει τίποτα."
          }
        }
      }
    },
    "메뉴는 정독하는 UI가 아니라 **훑는 UI**다. 사람은 메뉴를 열고 대략의 위치로 손을 뻗는다. 그 손이 닿는 범위 안에 되돌릴 수 없는 항목이 같은 모양으로 섞여 있으면, 손이 멈출 이유가 없다. 시스템은 이런 경우를 위해 `Divider`와 `role: .destructive`를 준비해 두었다. 흐름 순서는 기획자의 논리였고, 메뉴의 문법은 무게로 나누는 것이었다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu isn't UI people read closely; it's **UI people scan**. People open a menu and reach toward a rough position. If an irreversible item that looks like everything else sits within that reach, there's nothing to make the hand stop. The system provides `Divider` and `role: .destructive` for exactly this case. Workflow order was the planner's logic; the grammar of menus is to separate items by weight."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu isn't UI people read closely; it's **UI people scan**. People open a menu and reach towards a rough position. If an irreversible item that looks like everything else sits within that reach, there's nothing to make the hand stop. The system provides `Divider` and `role: .destructive` for exactly this case. Workflow order was the planner's logic; the grammar of menus is to separate items by weight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューはじっくり読むUIではなく、**ざっと見るUI**だ。人はメニューを開いて、だいたいの位置に手を伸ばす。その手が届く範囲に、取り消せない項目が同じ見た目で混ざっていたら、手が止まる理由がない。システムはこういう場合のために`Divider`と`role: .destructive`を用意している。流れの順は企画者の論理であり、メニューの文法は重さで分けることだった。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单不是细读的 UI，而是**浏览的 UI**。人们打开菜单，朝大致的位置伸手。如果那只手够得到的范围里，无法撤销的项目以同样的外观混在其中，手就没有理由停下。系统为此准备了 `Divider` 和 `role: .destructive`。流程顺序是策划者的逻辑，菜单的语法则是按分量来划分的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單不是細讀的 UI，而是**瀏覽的 UI**。人們開啟選單，朝大致的位置伸手。如果那隻手夠得到的範圍裡，無法撤銷的項目以同樣的外觀混在其中，手就沒有理由停下。系統為此準備了 `Divider` 和 `role: .destructive`。流程順序是策劃者的邏輯，選單的語法則是按分量來劃分的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню - не интерфейс для вдумчивого чтения, а **интерфейс для беглого просмотра**. Люди открывают меню и тянутся к примерному месту. Если в зоне досягаемости рядом с остальными стоит необратимый пункт, выглядящий так же, ничто не остановит руку. Для этого случая система предоставляет `Divider` и `role: .destructive`. Порядок рабочего процесса был логикой планировщика; грамматика меню - разделять пункты по весу."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un menú no es una interfaz que la gente lea con detalle; es **una interfaz que la gente recorre con la vista**. La gente abre un menú y alarga la mano hacia una posición aproximada. Si un elemento irreversible que se parece a todos los demás está dentro de ese alcance, nada hace que la mano se detenga. El sistema ofrece `Divider` y `role: .destructive` justo para este caso. El orden del flujo de trabajo era la lógica del planificador; la gramática de los menús es separar los elementos por peso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Menü ist keine UI, die Menschen genau lesen; es ist **eine UI, die Menschen überfliegen**. Menschen öffnen ein Menü und greifen zu einer ungefähren Position. Liegt in dieser Reichweite ein unumkehrbarer Eintrag, der wie alle anderen aussieht, hält nichts die Hand auf. Das System stellt genau dafür `Divider` und `role: .destructive` bereit. Die Reihenfolge des Arbeitsablaufs war die Logik des Planers; die Grammatik von Menüs trennt Einträge nach Gewicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un menu n'est pas une interface que les gens lisent de près ; c'est **une interface que les gens survolent**. Les gens ouvrent un menu et tendent la main vers un emplacement approximatif. Si un élément irréversible, identique à tous les autres, se trouve à portée, rien n'arrête la main. Le système fournit `Divider` et `role: .destructive` précisément pour ce cas. L'ordre du déroulement était la logique du concepteur ; la grammaire des menus consiste à séparer les éléments par leur poids."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un menu non è una UI che le persone leggono con attenzione; è **una UI che le persone scorrono con lo sguardo**. Le persone aprono un menu e allungano la mano verso una posizione approssimativa. Se a portata c'è un elemento irreversibile che sembra tutti gli altri, niente fa fermare la mano. Il sistema fornisce `Divider` e `role: .destructive` esattamente per questo caso. L'ordine del flusso di lavoro era la logica di chi pianifica; la grammatica dei menu è separare le voci per peso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um menu não é uma interface que as pessoas leem de perto; é **uma interface que as pessoas percorrem com o olhar**. As pessoas abrem um menu e estendem a mão para uma posição aproximada. Se um item irreversível que se parece com todos os outros fica ao alcance, nada faz a mão parar. O sistema fornece `Divider` e `role: .destructive` exatamente para este caso. A ordem do fluxo de trabalho era a lógica de quem planeja; a gramática dos menus é separar os itens por peso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมนูไม่ใช่ UI ที่คนอ่านอย่างละเอียด แต่เป็น **UI ที่คนไล่ดู** คนเปิดเมนูแล้วเอื้อมไปยังตำแหน่งคร่าว ๆ ถ้ารายการที่ย้อนกลับไม่ได้ซึ่งดูเหมือนทุกอย่างอยู่ในระยะเอื้อมนั้น ก็ไม่มีอะไรทำให้มือหยุด ระบบจัดหา `Divider` และ `role: .destructive` สำหรับกรณีนี้โดยเฉพาะ ลำดับเวิร์กโฟลว์เป็นตรรกะของผู้วางแผน ไวยากรณ์ของเมนูคือการแยกรายการตามน้ำหนัก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu không phải UI để đọc kỹ; nó là **UI để lướt**. Người ta mở menu và với tay về một vị trí đại khái. Nếu một mục không thể hoàn tác trông giống mọi mục khác nằm trong tầm với đó, không có gì làm tay dừng lại. Hệ thống cung cấp `Divider` và `role: .destructive` đúng cho trường hợp này. Thứ tự quy trình là logic của người lên kế hoạch; ngữ pháp của menu là tách các mục theo trọng lượng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nabídka není UI, které lidé čtou pozorně; je to **UI, které lidé přelétají**. Lidé otevřou nabídku a sáhnou na přibližnou pozici. Pokud v tom dosahu sedí nevratná položka vypadající jako všechny ostatní, nic ruku nezastaví. Systém poskytuje `Divider` a `role: .destructive` přesně pro tento případ. Pořadí pracovního postupu byla logika plánovače; gramatikou nabídek je oddělovat položky podle váhy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En menu er ikke brugerflade, folk læser nøje; den er **brugerflade, folk skimmer**. Folk åbner en menu og rækker mod en omtrentlig position. Hvis et uigenkaldeligt element, der ligner alt det andet, sidder inden for den rækkevidde, er der intet, der får hånden til at stoppe. Systemet leverer `Divider` og `role: .destructive` netop til dette tilfælde. Arbejdsgangens rækkefølge var planlæggerens logik; menuers grammatik er at adskille elementer efter vægt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μενού δεν είναι διεπαφή που οι άνθρωποι διαβάζουν προσεκτικά· είναι **διεπαφή που σαρώνουν**. Οι άνθρωποι ανοίγουν ένα μενού και απλώνουν το χέρι προς μια προσεγγιστική θέση. Αν ένα μη αναστρέψιμο στοιχείο που μοιάζει με όλα τα άλλα κάθεται εντός αυτής της εμβέλειας, τίποτα δεν κάνει το χέρι να σταματήσει. Το σύστημα παρέχει `Divider` και `role: .destructive` ακριβώς γι' αυτή την περίπτωση. Η σειρά ροής εργασίας ήταν η λογική του σχεδιαστή· η γραμματική των μενού είναι να χωρίζει τα στοιχεία ανά βάρος."
          }
        }
      }
    },
    "메뉴에 한 단계를 더하고 싶어지면 묻는다. **\"이건 메뉴가 아니라 화면이어야 하지 않나?\"**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you feel like adding another level to a menu, ask: **\"Shouldn't this be a screen instead of a menu?\"**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you feel like adding another level to a menu, ask: **\"Shouldn't this be a screen instead of a menu?\"**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューにもう1段足したくなったら問う。**「これはメニューではなく、画面であるべきではないか」**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想给菜单再加一层时，先问：**“这是不是该做成界面而不是菜单？”**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想給選單再加一層時，先問：**「這是不是該做成介面而不是選單？」**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда хочется добавить в меню ещё один уровень, спросите: **«Не должно ли это быть экраном, а не меню?»**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te apetezca añadir otro nivel a un menú, pregunta: **«¿No debería ser una pantalla en lugar de un menú?»**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Lust hast, einem Menü eine weitere Ebene hinzuzufügen, frage: **„Sollte das nicht ein Bildschirm statt eines Menüs sein?“**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous avez envie d'ajouter un niveau à un menu, demandez : **« Cela ne devrait-il pas être un écran plutôt qu'un menu ? »**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ti viene voglia di aggiungere un altro livello a un menu, chiediti: **«Non dovrebbe essere una schermata invece di un menu?»**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sentir vontade de acrescentar mais um nível a um menu, pergunte: **«Isto não deveria ser uma tela em vez de um menu?»**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อรู้สึกอยากเพิ่มอีกระดับให้เมนู ให้ถาม: **\"นี่ควรเป็นหน้าจอแทนเมนูไหม\"**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn muốn thêm một cấp nữa cho menu, hãy hỏi: **\"Cái này có nên là một màn hình thay vì menu không?\"**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když máte chuť přidat do nabídky další úroveň, zeptejte se: **„Neměla by to být obrazovka místo nabídky?“**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du får lyst til at tilføje endnu et niveau til en menu, så spørg: **»Burde det her være en skærm i stedet for en menu?«**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν σου έρχεται να προσθέσεις ακόμα ένα επίπεδο σε ένα μενού, ρώτα: **«Δεν θα έπρεπε να είναι οθόνη αντί για μενού;»**"
          }
        }
      }
    },
    "메뉴에는 \"제목이 가리키는 대상\"에 대한 액션만. 화면 전체 액션을 넣으면 문법이 깨집니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only actions on \"the thing the title refers to\" belong in the menu. Put screen-wide actions in it and the grammar breaks."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only actions on \"the thing the title refers to\" belong in the menu. Put screen-wide actions in it and the grammar breaks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューには「タイトルが指す対象」に対するアクションだけ。画面全体のアクションを入れると文法が崩れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单里只放“标题所指对象”的操作。放整个界面的操作，语法就破了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單裡只放「標題所指物件」的操作。放整個介面的操作，語法就破了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В меню относятся только действия над «тем, на что указывает заголовок». Положите туда действия для всего экрана, и грамматика ломается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el menú solo caben acciones sobre «aquello a lo que se refiere el título». Mete acciones de toda la pantalla y la gramática se rompe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ins Menü gehören nur Aktionen auf „das, worauf sich der Titel bezieht“. Legst du bildschirmweite Aktionen hinein, bricht die Grammatik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les actions sur « ce à quoi le titre se rapporte » ont leur place dans le menu. Mettez-y des actions pour tout l'écran et la grammaire se brise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel menu vanno solo le azioni su «ciò a cui si riferisce il titolo». Mettici azioni valide per tutta la schermata e la grammatica si rompe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No menu só entram as ações sobre «aquilo a que o título se refere». Ponha ações da tela inteira e a gramática se quebra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะการกระทำต่อ \"สิ่งที่ชื่อเรื่องอ้างถึง\" เท่านั้นที่ควรอยู่ในเมนู ใส่การกระทำระดับหน้าจอ ไวยากรณ์ก็พัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những hành động trên \"thứ mà tiêu đề nhắc đến\" mới thuộc về menu. Đặt hành động của cả màn hình vào đó thì ngữ pháp vỡ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do nabídky patří jen akce na „to, na co nadpis odkazuje“. Dejte tam akce celé obrazovky a gramatika se rozbije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun handlinger på »det, titlen henviser til«, hører hjemme i menuen. Læg handlinger for hele skærmen i den, og grammatikken går i stykker."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο ενέργειες στο «αυτό που αναφέρεται ο τίτλος» ανήκουν στο μενού. Βάλε μέσα ενέργειες ολόκληρης της οθόνης και η γραμματική σπάει."
          }
        }
      }
    },
    "메모 목록 하단에 유리 캡슐이 하나 있고, 그 안에 검색 필드와 새 메모 버튼이 붙어 있다. 한 덩어리로 보이니 버튼이 검색 필드의 부속처럼 읽힌다. 새 메모를 쓰려던 사람은 버튼이 검색 옵션인지 잠깐 멈칫한다. 손끝이 조금만 빗나가도 키보드가 올라온다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the bottom of the notes list there's a single glass capsule, with the search field and the New Note button stuck together inside it. Because it looks like one piece, the button reads as an attachment of the search field. Someone who wanted to write a new note hesitates for a moment, wondering if the button is a search option. If a fingertip misses by just a little, the keyboard pops up."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "At the bottom of the notes list there's a single glass capsule, with the search field and the New Note button stuck together inside it. Because it looks like one piece, the button reads as an attachment of the search field. Someone who wanted to write a new note hesitates for a moment, wondering if the button is a search option. If a fingertip misses by just a little, the keyboard pops up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモ一覧の下部にガラスのカプセルがひとつあり、その中に検索フィールドと新規メモのボタンがくっついている。ひとかたまりに見えるので、ボタンが検索フィールドの付属品のように読める。新しいメモを書こうとした人は、ボタンが検索のオプションなのかと一瞬ためらう。指先が少しずれただけでキーボードが上がってくる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备忘录列表底部有一个玻璃胶囊，里面贴着搜索框和新备忘录按钮。看起来是一整块，按钮就像搜索框的附属。想写新备忘录的人会愣一下：这个按钮是搜索选项吗？手指稍微偏一点，键盘就升起来了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備忘錄列表底部有一個玻璃膠囊，裡面貼著搜尋框和新備忘錄按鈕。看起來是一整塊，按鈕就像搜尋框的附屬。想寫新備忘錄的人會愣一下：這個按鈕是搜尋選項嗎？手指稍微偏一點，鍵盤就升起來了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внизу списка заметок одна стеклянная капсула, а внутри неё склеены поле поиска и кнопка «Новая заметка». Поскольку это выглядит единым целым, кнопка читается как придаток поля поиска. Тот, кто хотел написать новую заметку, на мгновение замирает: не параметр ли это поиска? Если кончик пальца промахнётся хоть немного, выезжает клавиатура."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al final de la lista de notas hay una sola cápsula de cristal, con el campo de búsqueda y el botón Nueva nota pegados dentro. Como parece una sola pieza, el botón se lee como un accesorio del campo de búsqueda. Quien quería escribir una nota nueva duda un momento, preguntándose si el botón es una opción de búsqueda. Si la yema del dedo falla por poco, salta el teclado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten in der Notizenliste liegt eine einzelne Glaskapsel, in der das Suchfeld und der Button Neue Notiz aneinanderkleben. Weil es wie ein Stück aussieht, liest sich der Button als Anhang des Suchfelds. Wer eine neue Notiz schreiben wollte, zögert einen Moment und fragt sich, ob der Button eine Suchoption ist. Verfehlt die Fingerspitze nur ein wenig, springt die Tastatur auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En bas de la liste de notes, il y a une seule capsule de verre, avec le champ de recherche et le bouton Nouvelle note collés à l'intérieur. Comme cela ressemble à une seule pièce, le bouton se lit comme un accessoire du champ de recherche. Quelqu'un qui voulait écrire une nouvelle note hésite un instant, se demandant si le bouton est une option de recherche. Si le bout du doigt rate de peu, le clavier surgit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In fondo all'elenco di note c'è una sola capsula di vetro, con il campo di ricerca e il pulsante Nuova nota incollati dentro. Poiché sembra un unico pezzo, il pulsante si legge come un'appendice del campo di ricerca. Chi voleva scrivere una nuova nota esita per un momento, chiedendosi se il pulsante sia un'opzione di ricerca. Se la punta del dito sbaglia anche di poco, compare la tastiera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No fim da lista de notas há uma única cápsula de vidro, com o campo de busca e o botão Nova nota colados dentro. Como parece uma peça só, o botão é lido como um anexo do campo de busca. Quem queria escrever uma nova nota hesita um instante, perguntando-se se o botão é uma opção de busca. Se a ponta do dedo erra por pouco, o teclado aparece."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่ด้านล่างของรายการโน้ตมีแคปซูลกระจกอันเดียว ช่องค้นหาและปุ่มโน้ตใหม่ติดกันอยู่ข้างใน เพราะดูเป็นชิ้นเดียว ปุ่มจึงถูกอ่านเป็นส่วนต่อของช่องค้นหา คนที่อยากเขียนโน้ตใหม่ลังเลชั่วครู่ สงสัยว่าปุ่มเป็นตัวเลือกการค้นหาไหม ถ้าปลายนิ้วพลาดนิดเดียว คีย์บอร์ดก็เด้งขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở cuối danh sách ghi chú có một capsule kính duy nhất, ô tìm kiếm và nút Ghi chú mới dính vào nhau bên trong. Vì trông như một khối, nút có vẻ là phần đính kèm của ô tìm kiếm. Người muốn viết ghi chú mới do dự một lúc, tự hỏi nút đó có phải tùy chọn tìm kiếm không. Chỉ cần đầu ngón tay lệch một chút là bàn phím bật lên."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dole v seznamu poznámek je jediná skleněná kapsle, v níž jsou vyhledávací pole a tlačítko Nová poznámka slepené dohromady. Protože to vypadá jako jeden kus, tlačítko se čte jako příloha vyhledávacího pole. Kdo chtěl napsat novou poznámku, na chvíli zaváhá a ptá se, zda je to tlačítko možnost hledání. Pokud se špička prstu mine jen o kousek, vyskočí klávesnice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nederst på notelisten er der en enkelt glaskapsel, hvor søgefeltet og knappen Ny note sidder klistret sammen inde i den. Fordi det ligner ét stykke, læses knappen som et tillæg til søgefeltet. Den, der ville skrive en ny note, tøver et øjeblik og undrer sig over, om knappen er en søgemulighed. Hvis en fingerspids bommer bare lidt, springer tastaturet frem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο κάτω μέρος της λίστας σημειώσεων υπάρχει μία κάψουλα γυαλιού, με το πεδίο αναζήτησης και το κουμπί Νέα σημείωση κολλημένα μέσα της. Επειδή μοιάζει με ένα κομμάτι, το κουμπί διαβάζεται ως προσάρτημα του πεδίου αναζήτησης. Όποιος ήθελε να γράψει νέα σημείωση διστάζει για μια στιγμή, αναρωτώμενος αν το κουμπί είναι επιλογή αναζήτησης. Αν μια άκρη δαχτύλου αστοχήσει έστω και λίγο, εμφανίζεται το πληκτρολόγιο."
          }
        }
      }
    },
    "메모 목록 화면의 \"새 메모\" 버튼이 오른쪽 위 구석에 있다. 하단은 비어 있다. 한 손으로 쥔 채 새 메모를 쓰려면 엄지를 한껏 뻗거나 기기를 고쳐 쥐어야 한다. 이 화면에서 가장 자주 하는 일이 가장 손이 안 닿는 자리에 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a notes list screen, the \"New Note\" button sits in the top right corner. The bottom is empty. To write a new note while holding the phone in one hand, you have to stretch your thumb all the way or shift your grip. The thing you do most often on this screen sits in the hardest place to reach."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On a notes list screen, the \"New Note\" button sits in the top right corner. The bottom is empty. To write a new note while holding the phone in one hand, you have to stretch your thumb all the way or shift your grip. The thing you do most often on this screen sits in the hardest place to reach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの一覧画面で、「新規メモ」ボタンが右上の隅にある。下部は空いている。片手で持ったまま新しいメモを書くには、親指を目いっぱい伸ばすか、デバイスを持ち直さなければならない。この画面でいちばんよくすることが、いちばん手の届かない場所にある。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备忘录列表界面的“新备忘录”按钮在右上角。底部是空的。单手握着想写新备忘录，得把拇指伸到极限，或者换握姿。这个界面最常做的事，放在了最难够到的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備忘錄列表介面的「新備忘錄」按鈕在右上角。底部是空的。單手握著想寫新備忘錄，得把拇指伸到極限，或者換握姿。這個介面最常做的事，放在了最難夠到的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране списка заметок кнопка «Новая заметка» стоит в правом верхнем углу. Низ пуст. Чтобы написать новую заметку, держа телефон в одной руке, нужно изо всех сил тянуть большой палец или перехватывать устройство. То, что вы делаете на этом экране чаще всего, лежит в самом труднодоступном месте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una pantalla de lista de notas, el botón «Nueva nota» está en la esquina superior derecha. La parte inferior está vacía. Para escribir una nota nueva con el móvil en una mano, tienes que estirar el pulgar a tope o cambiar el agarre. Lo que más haces en esta pantalla está en el sitio más difícil de alcanzar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem Notizenlisten-Bildschirm sitzt der Button „Neue Notiz“ in der oberen rechten Ecke. Die Unterseite ist leer. Um mit einer Hand eine neue Notiz zu schreiben, muss man den Daumen ganz strecken oder den Griff verlagern. Das, was man auf diesem Bildschirm am häufigsten tut, liegt am schwersten erreichbaren Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un écran de liste de notes, le bouton « Nouvelle note » se trouve dans le coin supérieur droit. Le bas est vide. Pour écrire une nouvelle note en tenant le téléphone d'une main, il faut tendre le pouce au maximum ou changer de prise. Ce que vous faites le plus souvent sur cet écran se trouve à l'endroit le plus difficile à atteindre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una schermata con l'elenco di note, il pulsante «Nuova nota» sta nell'angolo in alto a destra. Il basso è vuoto. Per scrivere una nuova nota tenendo il telefono con una mano, devi allungare tutto il pollice o cambiare presa. La cosa che fai più spesso in questa schermata sta nel punto più difficile da raggiungere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa tela de lista de notas, o botão «Nova nota» fica no canto superior direito. A parte de baixo está vazia. Para escrever uma nova nota segurando o celular com uma mão, é preciso esticar o polegar até o fim ou mudar a pegada. O que você mais faz nesta tela fica no lugar mais difícil de alcançar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้ารายการโน้ต ปุ่ม \"โน้ตใหม่\" อยู่มุมขวาบน ด้านล่างว่าง ในการเขียนโน้ตใหม่ขณะถือโทรศัพท์มือเดียว คุณต้องเหยียดนิ้วโป้งสุดหรือเปลี่ยนการจับ สิ่งที่คุณทำบ่อยที่สุดบนหน้าจอนี้อยู่ในที่ที่เอื้อมยากที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình danh sách ghi chú, nút \"Ghi chú mới\" nằm ở góc trên bên phải. Phía dưới trống. Muốn viết ghi chú mới khi cầm điện thoại một tay, bạn phải với hết cỡ ngón cái hoặc đổi tư thế cầm. Việc bạn làm thường xuyên nhất trên màn hình này nằm ở chỗ khó với tới nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na obrazovce se seznamem poznámek sedí tlačítko „Nová poznámka“ v pravém horním rohu. Dole je prázdno. Chcete-li napsat novou poznámku, když držíte telefon jednou rukou, musíte natáhnout palec až nadoraz nebo změnit úchop. Věc, kterou děláte na této obrazovce nejčastěji, sedí na nejhůř dosažitelném místě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På en notelisteskærm sidder knappen »Ny note« i øverste højre hjørne. Bunden er tom. For at skrive en ny note, mens du holder telefonen i én hånd, må du strække tommelfingeren helt ud eller skifte greb. Det, du gør oftest på denne skærm, sidder på det sværeste sted at nå."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε μια οθόνη λίστας σημειώσεων, το κουμπί «Νέα σημείωση» κάθεται στην πάνω δεξιά γωνία. Το κάτω μέρος είναι άδειο. Για να γράψεις νέα σημείωση κρατώντας το τηλέφωνο με το ένα χέρι, πρέπει να τεντώσεις τον αντίχειρα εντελώς ή να αλλάξεις πιάσιμο. Αυτό που κάνεις πιο συχνά σε αυτή την οθόνη κάθεται στο πιο δύσκολο σημείο για να φτάσεις."
          }
        }
      }
    },
    "메모 목록 화면의 하단 툴바에 톱니바퀴 하나가 떠 있다. 이 화면에서 가장 자주 하는 일은 새 메모를 여는 것인데, 그 버튼은 오른쪽 위에 있다. 엄지가 가장 편하게 닿는 자리를 거의 열지 않는 설정이 차지하고 있고, 매일 누르는 버튼에는 손을 뻗어야 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single gear floats in the bottom toolbar of a note list screen. The most frequent task on this screen is starting a new note, but that button is at the top right. The spot your thumb reaches most comfortably is taken by settings you almost never open, while you have to stretch for the button you tap every day."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A single gear floats in the bottom toolbar of a note list screen. The most frequent task on this screen is starting a new note, but that button is at the top right. The spot your thumb reaches most comfortably is taken by settings you almost never open, while you have to stretch for the button you tap every day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモ一覧画面の下部ツールバーに、歯車がひとつ浮かんでいる。この画面でいちばんよくすることは新しいメモを開くことなのに、そのボタンは右上にある。親指がいちばん楽に届く場所をほとんど開かない設定が占め、毎日押すボタンには手を伸ばさなければならない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备忘录列表界面的底部工具栏里浮着一个齿轮。这个界面最常做的事是新建备忘录，可那个按钮在右上角。拇指最舒服能够到的位置，被几乎不开的设置占着，每天都要点的按钮却得伸手去够。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備忘錄列表介面的底部工具列裡浮著一個齒輪。這個介面最常做的事是新建備忘錄，可那個按鈕在右上角。拇指最舒服能夠到的位置，被幾乎不開的設定佔著，每天都要點的按鈕卻得伸手去夠。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В нижней панели инструментов экрана списка заметок парит одна шестерёнка. Самое частое дело на этом экране - начать новую заметку, но эта кнопка вверху справа. Место, до которого большой палец достаёт удобнее всего, занято настройками, которые почти никогда не открывают, а до кнопки, которую нажимают каждый день, приходится тянуться."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un único engranaje flota en la barra de herramientas inferior de una pantalla de lista de notas. La tarea más frecuente en esta pantalla es empezar una nota nueva, pero ese botón está arriba a la derecha. El sitio al que el pulgar llega con más comodidad lo ocupan unos ajustes que casi nunca abres, mientras que tienes que estirarte para el botón que tocas a diario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der unteren Symbolleiste eines Notizenlisten-Bildschirms schwebt ein einzelnes Zahnrad. Die häufigste Aufgabe auf diesem Bildschirm ist, eine neue Notiz zu beginnen, aber dieser Button ist oben rechts. Der Platz, den dein Daumen am bequemsten erreicht, ist von Einstellungen belegt, die du fast nie öffnest, während du dich nach dem Button strecken musst, den du täglich antippst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul engrenage flotte dans la barre d'outils du bas d'un écran de liste de notes. La tâche la plus fréquente de cet écran est de commencer une nouvelle note, mais ce bouton est en haut à droite. L'endroit que votre pouce atteint le plus confortablement est occupé par des réglages que vous n'ouvrez presque jamais, alors qu'il faut vous étirer pour le bouton que vous touchez chaque jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo ingranaggio fluttua nella barra degli strumenti in basso di una schermata con l'elenco di note. Il compito più frequente in questa schermata è iniziare una nuova nota, ma quel pulsante è in alto a destra. Il punto che il pollice raggiunge più comodamente è occupato dalle impostazioni che non apri quasi mai, mentre devi allungarti per il pulsante che tocchi ogni giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma única engrenagem flutua na barra de ferramentas inferior de uma tela de lista de notas. A tarefa mais frequente desta tela é começar uma nova nota, mas esse botão está no canto superior direito. O lugar que o polegar alcança com mais conforto é tomado por ajustes que você quase nunca abre, enquanto precisa se esticar para o botão que toca todo dia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฟืองอันเดียวลอยอยู่ในแถบเครื่องมือล่างของหน้ารายการโน้ต งานที่บ่อยที่สุดบนหน้าจอนี้คือเริ่มโน้ตใหม่ แต่ปุ่มนั้นอยู่ขวาบน ตำแหน่งที่นิ้วโป้งเอื้อมถึงสบายที่สุดถูกการตั้งค่าที่แทบไม่เปิดยึดไว้ ขณะที่คุณต้องเหยียดไปหาปุ่มที่แตะทุกวัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chiếc bánh răng đơn độc nổi trong thanh công cụ dưới của màn hình danh sách ghi chú. Tác vụ thường xuyên nhất trên màn hình này là bắt đầu ghi chú mới, nhưng nút đó ở trên bên phải. Chỗ ngón cái với tới thoải mái nhất bị chiếm bởi cài đặt bạn gần như không mở, trong khi phải với để chạm nút bạn bấm mỗi ngày."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve spodním panelu nástrojů obrazovky se seznamem poznámek plave osamocené ozubené kolo. Nejčastějším úkolem na této obrazovce je založení nové poznámky, ale to tlačítko je vpravo nahoře. Místo, kam palec dosáhne nejpohodlněji, zabírá nastavení, které téměř nikdy neotevřete, zatímco po tlačítku, na které klepete každý den, se musíte natahovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et enkelt tandhjul svæver i den nederste værktøjslinje på en notelisteskærm. Den hyppigste opgave på denne skærm er at starte en ny note, men den knap sidder øverst til højre. Den plads, tommelfingeren når mest behageligt, er optaget af indstillinger, du næsten aldrig åbner, mens du må strække dig efter knappen, du trykker på hver dag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μόνο γρανάζι επιπλέει στην κάτω γραμμή εργαλείων μιας οθόνης λίστας σημειώσεων. Η πιο συχνή εργασία σε αυτή την οθόνη είναι η έναρξη μιας νέας σημείωσης, αλλά αυτό το κουμπί είναι πάνω δεξιά. Το σημείο που ο αντίχειράς σου φτάνει πιο άνετα καταλαμβάνεται από ρυθμίσεις που σχεδόν ποτέ δεν ανοίγεις, ενώ πρέπει να τεντωθείς για το κουμπί που πατάς κάθε μέρα."
          }
        }
      }
    },
    "메모 목록 화면인데 상단 중앙에 제목 대신 검색 필드가 있다. 화면에 들어왔을 때 여기가 어디인지 말해 주는 것이 없다. 목록을 보러 왔는데 화면은 검색 전용 화면처럼 보인다. 다른 탭에서 넘어오면 방향을 잡을 단서가 목록 내용뿐이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a notes list screen, but the top center shows a search field instead of a title. Nothing tells you where you are when you land on the screen. You came to see the list, yet the screen looks like a search-only screen. Coming over from another tab, the only clue for getting your bearings is the list contents."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a notes list screen, but the top centre shows a search field instead of a title. Nothing tells you where you are when you land on the screen. You came to see the list, yet the screen looks like a search-only screen. Coming over from another tab, the only clue for getting your bearings is the list contents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモ一覧の画面なのに、上部中央にタイトルの代わりに検索フィールドがある。画面に入ったとき、ここがどこなのかを教えてくれるものがない。リストを見に来たのに、画面は検索専用の画面のように見える。ほかのタブから移ってくると、方向をつかむ手がかりはリストの中身だけだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是备忘录列表界面，顶部中间却不是标题而是搜索框。进入界面时，没有任何东西告诉你这里是哪里。明明是来看列表的，界面看上去却像搜索专用界面。从别的标签过来，辨别方向的线索只有列表内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是備忘錄列表介面，頂部中間卻不是標題而是搜尋框。進入介面時，沒有任何東西告訴你這裡是哪裡。明明是來看列表的，介面看上去卻像搜尋專用介面。從別的標籤過來，辨別方向的線索只有列表內容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это экран списка заметок, но вверху по центру вместо заголовка стоит поле поиска. Ничто не говорит, где вы оказались, когда попали на экран. Вы пришли смотреть список, а экран выглядит как экран только для поиска. Если перейти с другой вкладки, единственная подсказка для ориентации - содержимое списка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una pantalla de lista de notas, pero arriba en el centro se muestra un campo de búsqueda en lugar de un título. Nada te dice dónde estás al llegar a la pantalla. Venías a ver la lista, pero la pantalla parece de solo búsqueda. Si vienes de otra pestaña, la única pista para orientarte es el contenido de la lista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein Notizenlisten-Bildschirm, aber oben in der Mitte steht statt eines Titels ein Suchfeld. Nichts sagt dir beim Ankommen, wo du bist. Du wolltest die Liste sehen, doch der Bildschirm wirkt wie ein reiner Suchbildschirm. Kommt man von einem anderen Tab, ist der Listeninhalt der einzige Anhaltspunkt zur Orientierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un écran de liste de notes, mais le haut du centre montre un champ de recherche au lieu d'un titre. Rien ne vous dit où vous êtes en arrivant sur l'écran. Vous êtes venu voir la liste, pourtant l'écran ressemble à un écran dédié à la recherche. En venant d'un autre onglet, le seul indice pour s'orienter est le contenu de la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una schermata con l'elenco di note, ma in alto al centro c'è un campo di ricerca invece di un titolo. Niente ti dice dove sei quando arrivi sulla schermata. Sei venuto a vedere l'elenco, eppure la schermata sembra una schermata solo di ricerca. Arrivando da un'altra scheda, l'unico indizio per orientarsi è il contenuto dell'elenco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É uma tela de lista de notas, mas o topo central mostra um campo de busca em vez de um título. Nada diz onde você está quando cai na tela. Você veio ver a lista, mas a tela parece uma tela só de busca. Vindo de outra aba, a única pista para se orientar é o conteúdo da lista."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นหน้ารายการโน้ต แต่ตรงกลางด้านบนแสดงช่องค้นหาแทนชื่อเรื่อง ไม่มีอะไรบอกว่าคุณอยู่ที่ไหนเมื่อเข้าหน้าจอ คุณมาดูรายการ แต่หน้าจอดูเหมือนหน้าจอสำหรับค้นหาอย่างเดียว เมื่อมาจากแท็บอื่น เบาะแสเดียวสำหรับตั้งหลักคือเนื้อหารายการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là màn hình danh sách ghi chú, nhưng giữa phía trên hiện ô tìm kiếm thay vì tiêu đề. Không có gì cho biết bạn đang ở đâu khi vào màn hình. Bạn đến để xem danh sách, vậy mà màn hình trông như màn hình chỉ có tìm kiếm. Từ tab khác sang, manh mối duy nhất để định hướng là nội dung danh sách."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to obrazovka se seznamem poznámek, ale nahoře uprostřed je místo nadpisu vyhledávací pole. Nic vám neříká, kde jste, když na obrazovku přistanete. Přišli jste se podívat na seznam, a přesto obrazovka vypadá jako obrazovka jen pro hledání. Když přicházíte z jiné karty, jediným vodítkem pro orientaci je obsah seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en notelisteskærm, men øverst i midten vises et søgefelt i stedet for en titel. Intet fortæller dig, hvor du er, når du lander på skærmen. Du kom for at se listen, men skærmen ligner en skærm kun til søgning. Når du kommer fra en anden fane, er det eneste spor til at finde ud af, hvor du er, listens indhold."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι οθόνη λίστας σημειώσεων, αλλά στο πάνω κέντρο εμφανίζεται ένα πεδίο αναζήτησης αντί για τίτλο. Τίποτα δεν σου λέει πού βρίσκεσαι όταν προσγειώνεσαι στην οθόνη. Ήρθες για να δεις τη λίστα, κι όμως η οθόνη μοιάζει με οθόνη μόνο αναζήτησης. Όταν έρχεσαι από άλλη καρτέλα, η μόνη ένδειξη για να προσανατολιστείς είναι το περιεχόμενο της λίστας."
          }
        }
      }
    },
    "메모 상세 화면 오른쪽 상단의 **완료** 버튼 하나": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single **Done** button at the top right of a note detail screen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A single **Done** button at the top right of a note detail screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの詳細画面の右上に**完了**ボタンがひとつ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备忘录详情界面右上角的一个**完成**按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備忘錄詳情介面右上角的一個**完成**按鈕"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна кнопка **«Готово»** справа вверху экрана подробностей заметки"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un único botón **Listo** arriba a la derecha de una pantalla de detalle de nota"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelner **Fertig**-Button oben rechts auf einem Notiz-Detailbildschirm"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul bouton **OK** en haut à droite d'un écran de détail de note"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pulsante **Fine** in alto a destra di una schermata di dettaglio di una nota"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único botão **Concluir** no canto superior direito de uma tela de detalhe de nota"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่ม**เสร็จสิ้น**เดียวที่ขวาบนของหน้ารายละเอียดโน้ต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nút **Xong** duy nhất ở trên bên phải màn hình chi tiết ghi chú"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jediné tlačítko **Hotovo** vpravo nahoře na detailní obrazovce poznámky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En enkelt **Færdig**-knap øverst til højre på en notedetaljeskærm"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μόνο κουμπί **Τέλος** πάνω δεξιά σε οθόνη λεπτομερειών σημείωσης"
          }
        }
      }
    },
    "메모 상세 화면의 툴바에 캡슐이 넷 떠 있다. 완료, 공유, 별표, 더보기. 메모를 다 쓴 사람이 하려는 일은 대개 완료 하나다. 그런데 넷이 같은 크기, 같은 유리로 나란히 있으니 완료를 누르려면 넷을 한 번 훑어야 한다. 본문 위로는 유리가 네 겹 떠 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four capsules float in the toolbar of a note's detail screen: Done, Share, Favorite, More. When people finish writing a note, what they usually want is just one thing: Done. But with all four side by side, the same size and the same glass, you have to scan all four before tapping Done. Four layers of glass hover over the text."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Four capsules float in the toolbar of a note's detail screen: Done, Share, Favourite, More. When people finish writing a note, what they usually want is just one thing: Done. But with all four side by side, the same size and the same glass, you have to scan all four before tapping Done. Four layers of glass hover over the text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの詳細画面のツールバーに、カプセルが4つ浮かんでいる。完了、共有、スター、その他。メモを書き終えた人がしたいことは、たいてい完了ひとつだ。なのに4つが同じ大きさ、同じガラスで並んでいるので、完了を押すには4つを一度見渡さなければならない。本文の上にはガラスが4枚重なって浮かんでいる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备忘录详情界面的工具栏里浮着四个胶囊：完成、分享、星标、更多。写完备忘录的人想做的事，通常只有完成一个。可是四个大小相同、同样是玻璃，并排放着，要点完成就得先扫一遍这四个。正文上方浮着四层玻璃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備忘錄詳情介面的工具列裡浮著四個膠囊：完成、分享、星標、更多。寫完備忘錄的人想做的事，通常只有完成一個。可是四個大小相同、同樣是玻璃，並排放著，要點完成就得先掃一遍這四個。正文上方浮著四層玻璃。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На панели инструментов экрана подробностей заметки парят четыре капсулы: «Готово», «Поделиться», «В избранное», «Ещё». Закончив писать заметку, люди обычно хотят одного: «Готово». Но когда все четыре стоят рядом, одного размера, на одном стекле, чтобы нажать «Готово», приходится просмотреть все четыре. Над текстом парят четыре слоя стекла."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro cápsulas flotan en la barra de herramientas del detalle de una nota: Listo, Compartir, Favorito, Más. Cuando la gente termina de escribir una nota, normalmente quiere una sola cosa: Listo. Pero con los cuatro lado a lado, del mismo tamaño y del mismo cristal, tienes que recorrer los cuatro con la vista antes de tocar Listo. Cuatro capas de cristal flotan sobre el texto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Symbolleiste des Detailbildschirms einer Notiz schweben vier Kapseln: Fertig, Teilen, Favorit, Mehr. Wenn Menschen eine Notiz fertig geschrieben haben, wollen sie meist nur eines: Fertig. Aber mit allen vieren nebeneinander, gleich groß und aus demselben Glas, muss man alle vier überfliegen, bevor man Fertig antippt. Vier Glasebenen schweben über dem Text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre capsules flottent dans la barre d'outils de l'écran de détail d'une note : OK, Partager, Favori, Plus. Quand les gens finissent d'écrire une note, ce qu'ils veulent généralement, c'est une seule chose : OK. Mais avec les quatre côte à côte, de même taille et du même verre, il faut balayer les quatre avant de toucher OK. Quatre couches de verre planent au-dessus du texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quattro capsule fluttuano nella barra degli strumenti del dettaglio di una nota: Fine, Condividi, Preferito, Altro. Quando le persone finiscono di scrivere una nota, di solito vogliono una cosa sola: Fine. Ma con tutte e quattro affiancate, della stessa dimensione e dello stesso vetro, devi scorrere tutte e quattro prima di toccare Fine. Quattro strati di vetro aleggiano sul testo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro cápsulas flutuam na barra de ferramentas do detalhe de uma nota: Concluir, Compartilhar, Favorito, Mais. Quando as pessoas terminam de escrever uma nota, normalmente querem uma coisa só: Concluir. Mas com as quatro lado a lado, do mesmo tamanho e do mesmo vidro, você precisa percorrer as quatro antes de tocar em Concluir. Quatro camadas de vidro pairam sobre o texto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สี่แคปซูลลอยอยู่ในแถบเครื่องมือของหน้ารายละเอียดโน้ต: เสร็จสิ้น แชร์ รายการโปรด เพิ่มเติม เมื่อคนเขียนโน้ตเสร็จ สิ่งที่พวกเขามักต้องการมีอย่างเดียว: เสร็จสิ้น แต่เมื่อทั้งสี่เรียงกันด้วยขนาดและกระจกเท่ากัน คุณต้องไล่ดูทั้งสี่ก่อนแตะเสร็จสิ้น กระจกสี่ชั้นลอยเหนือข้อความ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn capsule nổi trong thanh công cụ của màn hình chi tiết ghi chú: Xong, Chia sẻ, Yêu thích, Thêm. Khi viết xong ghi chú, điều người ta thường muốn chỉ có một: Xong. Nhưng với cả bốn cạnh nhau, cùng cỡ và cùng kính, bạn phải quét cả bốn trước khi chạm Xong. Bốn lớp kính lơ lửng trên văn bản."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V panelu nástrojů detailní obrazovky poznámky plavou čtyři kapsle: Hotovo, Sdílet, Oblíbené, Více. Když lidé dopíšou poznámku, obvykle chtějí jen jedno: Hotovo. Ale se všemi čtyřmi vedle sebe, stejně velkými a ze stejného skla, musíte prohlédnout všechny čtyři, než klepnete na Hotovo. Čtyři vrstvy skla se vznášejí nad textem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire kapsler svæver i værktøjslinjen på en notes detaljeskærm: Færdig, Del, Favorit, Mere. Når folk er færdige med at skrive en note, vil de som regel kun én ting: Færdig. Men med alle fire side om side, i samme størrelse og samme glas, må du skanne alle fire, før du trykker på Færdig. Fire lag glas svæver over teksten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τέσσερις κάψουλες επιπλέουν στη γραμμή εργαλείων της οθόνης λεπτομερειών μιας σημείωσης: Τέλος, Κοινοποίηση, Αγαπημένο, Περισσότερα. Όταν οι άνθρωποι τελειώνουν τη σύνταξη μιας σημείωσης, αυτό που συνήθως θέλουν είναι ένα πράγμα: Τέλος. Αλλά με και τα τέσσερα δίπλα-δίπλα, στο ίδιο μέγεθος και το ίδιο γυαλί, πρέπει να σαρώσεις και τα τέσσερα πριν πατήσεις Τέλος. Τέσσερα στρώματα γυαλιού αιωρούνται πάνω από το κείμενο."
          }
        }
      }
    },
