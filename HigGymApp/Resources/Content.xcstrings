            "value": "ใส่การตั้งค่าที่ใช้เดือนละครั้งในแถบล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt một cài đặt dùng mỗi tháng một lần vào thanh dưới"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dát nastavení používané jednou za měsíc do spodního panelu"
          }
        },
        "da": {
