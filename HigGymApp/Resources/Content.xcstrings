        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผงควบคุมสองบรรทัดที่ซับซ้อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bảng điều khiển hai dòng phức tạp"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složitý dvouřádkový ovládací panel"
          }
        },
        "da": {
