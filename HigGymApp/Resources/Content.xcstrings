        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xử lý trạng thái thu lại (inline) của phụ kiện"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezpracování sbaleného (inline) stavu příslušenství"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At undlade at håndtere tilbehørets sammenfoldede (inline) tilstand"
          }
        },
        "el": {
