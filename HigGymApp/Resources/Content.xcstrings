        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein **kurzes Text-Badge** statt einer Zahl (.badge(\"NEU\")) für Statushinweise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **badge textuel court** à la place d'un nombre (.badge(\"NOUVEAU\")), pour les avis d'état."
          }
        },
        "it": {
