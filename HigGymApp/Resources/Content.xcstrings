    "카드마다 재료를 쓰다 보면 자연스럽게 중첩된다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you give every card a material, they naturally end up nested."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you give every card a material, they naturally end up nested."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードごとにマテリアルを使っているうちに、自然と入れ子になる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张卡片都用材质，自然就会嵌套。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每張卡片都用材質，自然就會巢狀。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если дать материал каждой карточке, они неизбежно оказываются вложенными друг в друга."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si das un material a cada tarjeta, acaban anidadas de forma natural."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt man jeder Karte ein Material, verschachteln sie sich ganz natürlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous donnez un matériau à chaque carte, elles finissent naturellement imbriquées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dai un materiale a ogni scheda, finiscono naturalmente per annidarsi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você dá um material a cada cartão, eles naturalmente acabam aninhados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อให้ทุกการ์ดมีวัสดุ พวกมันก็ซ้อนกันโดยธรรมชาติ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn gán vật liệu cho mọi thẻ, chúng tự nhiên lồng vào nhau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když dáte materiál každé kartě, přirozeně se vnoří jedna do druhé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du giver hvert kort et materiale, ender de naturligt indlejret i hinanden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν δίνεις υλικό σε κάθε κάρτα, καταλήγουν φυσικά να είναι εμφωλευμένες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun annat jokaiselle kortille materiaalin, ne päätyvät luonnollisesti sisäkkäin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat kamu memberi setiap kartu material, mereka secara alami berakhir bersarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du gir hvert kort et material, ender de naturlig opp nestet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je elke kaart een materiaal geeft, komen ze vanzelf genest te zitten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy każdej karcie dasz materiał, naturalnie zaczynają się zagnieżdżać."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ger varje kort ett material hamnar de naturligt nästlade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her karta bir malzeme verirsen doğal olarak iç içe geçerler."
          }
        }
      }
    },
    "카메라 셔터를 상단에 두는 격이다. 빈도 최상위는 엄지 자리로 내린다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's like putting a camera's shutter button at the top. Move the most frequent action down to the thumb's spot."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's like putting a camera's shutter button at the top. Move the most frequent action down to the thumb's spot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラのシャッターを上部に置くようなものだ。頻度がいちばん高いものは親指の場所へ下ろす。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就像把相机快门放在顶部。频率最高的放到拇指的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "就像把相機快門放在頂部。頻率最高的放到拇指的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это как поставить спуск затвора камеры наверх. Перенесите самое частое действие вниз, на место большого пальца."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es como poner el botón del obturador de una cámara arriba. Pasa la acción más frecuente al sitio del pulgar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist, als setzte man den Auslöser einer Kamera nach oben. Verschiebe die häufigste Aktion an den Platz des Daumens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est comme mettre le déclencheur d'un appareil photo en haut. Descendez l'action la plus fréquente à l'emplacement du pouce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È come mettere in alto il pulsante di scatto di una fotocamera. Sposta l'azione più frequente giù, nel punto del pollice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É como pôr o botão de disparo de uma câmera no topo. Mova a ação mais frequente para baixo, para o lugar do polegar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมือนวางปุ่มชัตเตอร์ของกล้องไว้ด้านบน ย้ายการกระทำที่บ่อยที่สุดลงตำแหน่งของนิ้วโป้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Như đặt nút chụp của máy ảnh ở trên cùng. Chuyển hành động thường xuyên nhất xuống chỗ ngón cái."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to jako dát spoušť fotoaparátu nahoru. Přesuňte nejčastější akci dolů na místo palce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er som at sætte et kameras udløserknap øverst. Flyt den hyppigste handling ned på tommelfingerens plads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι σαν να βάζεις το κουμπί του κλείστρου μιας κάμερας πάνω. Μετάφερε την πιο συχνή ενέργεια κάτω, στη θέση του αντίχειρα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on kuin laittaisi kameran suljinpainikkeen ylös. Siirrä eniten toistuva toiminto alas peukalon paikalle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti menaruh tombol rana kamera di atas. Pindahkan aksi yang paling sering ke tempat ibu jari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er som å sette kameraets utløserknapp øverst. Flytt den hyppigste handlingen ned til tommelens plass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is alsof je de sluiterknop van een camera bovenaan zet. Verplaats de meest frequente actie naar de plek van de duim."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jak umieszczenie spustu migawki aparatu u góry. Przenieś najczęstszą akcję tam, gdzie leży kciuk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är som att lägga en kameras avtryckare överst. Flytta den mest frekventa åtgärden ner till tummens plats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kameranın deklanşör düğmesini üste koymak gibi. En sık yapılan eylemi başparmağın bulunduğu yere indir."
          }
        }
      }
    },
    "카메라 앱의 셔터를 상단 trailing에 두는 격. 빈도 최상위 컨트롤이 도달성 최하위 위치에 있어 한 손 사용 시 매번 그립을 바꾸게 됨.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like putting a camera app's shutter at the top trailing edge. The highest-frequency control ends up in the least reachable spot, forcing people to shift their grip every time they use it one-handed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Like putting a camera app's shutter at the top trailing edge. The highest-frequency control ends up in the least reachable spot, forcing people to shift their grip every time they use it one-handed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラアプリのシャッターを上部のtrailingに置くようなもの。頻度が最も高いコントロールが最も届きにくい位置にあり、片手で使うたびに持ち方を変えることになる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "就像把相机应用的快门放在顶部 trailing。频率最高的控件放在可触达性最低的位置，单手使用时每次都得换握姿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "就像把相機應用程式的快門放在頂部 trailing。頻率最高的控制元件放在可觸達性最低的位置，單手使用時每次都得換握姿。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как поставить затвор приложения камеры в верхний конец. Самый частый элемент оказывается в самом труднодоступном месте, и при работе одной рукой людям каждый раз приходится менять хват."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como poner el obturador de una app de cámara en el borde trailing de arriba. El control de más alta frecuencia acaba en el sitio menos alcanzable, obligando a la gente a cambiar el agarre cada vez que lo usa con una mano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie wenn man den Auslöser einer Kamera-App an den oberen trailing-Rand setzt. Das am häufigsten genutzte Steuerelement landet am am schwersten erreichbaren Platz und zwingt Menschen, bei jeder einhändigen Nutzung den Griff zu verlagern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme mettre le déclencheur d'une app photo au bord trailing du haut. Le contrôle le plus fréquent se retrouve à l'endroit le moins accessible, forçant les gens à changer de prise chaque fois qu'ils l'utilisent d'une main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come mettere l'otturatore di un'app fotocamera sul bordo trailing in alto. Il controllo a più alta frequenza finisce nel punto meno raggiungibile, costringendo le persone a cambiare presa a ogni uso con una mano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como pôr o obturador de um app de câmera na borda trailing do topo. O controle de maior frequência acaba no lugar menos alcançável, obrigando as pessoas a mudar a pegada a cada uso com uma mão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหมือนวางชัตเตอร์ของแอปกล้องไว้ขอบ trailing ด้านบน ตัวควบคุมที่ความถี่สูงสุดลงเอยในตำแหน่งที่เอื้อมยากที่สุด บังคับให้คนเปลี่ยนการจับทุกครั้งที่ใช้มือเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Như đặt nút chụp của app máy ảnh ở cạnh trailing phía trên. Điều khiển tần suất cao nhất ở chỗ khó với tới nhất, buộc người ta đổi tư thế cầm mỗi lần dùng bằng một tay."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako dát spoušť aplikace fotoaparátu na okraj trailing nahoře. Ovladač s nejvyšší frekvencí skončí na nejhůř dosažitelném místě a nutí lidi měnit úchop pokaždé, když ho používají jednou rukou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Som at sætte en kamera-apps udløser på øverste trailing-kant. Den hyppigste kontrol ender på det mindst tilgængelige sted og tvinger folk til at skifte greb hver gang, de bruger den med én hånd."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σαν να βάζεις το κλείστρο μιας εφαρμογής κάμερας στην πάνω trailing άκρη. Ο πιο συχνά χρησιμοποιούμενος έλεγχος καταλήγει στο πιο δυσπρόσιτο σημείο, αναγκάζοντας τους ανθρώπους να αλλάζουν πιάσιμο κάθε φορά που τον χρησιμοποιούν με το ένα χέρι."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuin laittaisi kamerasovelluksen suljin oikeaan yläreunaan. Tiheimmin käytetty säädin päätyy vaikeimmin tavoitettavaan paikkaan, pakottaen ihmiset vaihtamaan otetta joka kerta, kun he käyttävät sitä yhdellä kädellä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seperti menaruh rana aplikasi kamera di tepi trailing atas. Kontrol berfrekuensi tertinggi berakhir di tempat paling sulit dijangkau, memaksa orang menggeser genggaman setiap kali memakainya dengan satu tangan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Som å sette en kamerapps utløser på øvre trailing-kant. Kontrollen med høyest frekvens havner på det minst tilgjengelige stedet og tvinger folk til å skifte grep hver gang de bruker den med én hånd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de sluiter van een camera-app rechtsboven zetten. Het bedieningselement met de hoogste frequentie belandt op de minst bereikbare plek, waardoor mensen bij gebruik met één hand elke keer hun greep moeten verschuiven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak umieszczenie migawki aplikacji aparatu w prawym górnym rogu. Kontrolka o największej częstotliwości użycia ląduje w najtrudniej dostępnym miejscu, zmuszając ludzi do zmiany chwytu za każdym razem, gdy używają jej jedną ręką."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som att lägga en kameraapps avtryckare i övre högra kanten. Kontrollen med högst frekvens hamnar på den minst nåbara platsen och tvingar folk att byta grepp varje gång de använder den med en hand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kamera uygulamasının deklanşörünü üst son kenara koymak gibi. En yüksek sıklıklı kontrol en az erişilebilir yere düşer ve tek elle her kullanımda insanları tutuşlarını değiştirmeye zorlar."
          }
        }
      }
    },
    "캘린더 보기 전환(일/주/월) + 오른쪽 **오늘** 버튼": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calendar view switcher (Day/Week/Month) + a **Today** button on the right"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A calendar view switcher (Day/Week/Month) + a **Today** button on the right"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの表示切り替え（日/週/月）+ 右に**今日**ボタン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
