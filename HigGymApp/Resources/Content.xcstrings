        }
      }
    },
    "상단 바 + 하단 바 + 툴바까지 겹치면 콘텐츠 영역이 급격히 줄어듭니다, 작은 기기에서 실제 가시 영역을 확인하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a top bar, a bottom bar and a toolbar all stacked up, the content area shrinks fast. Check the actual visible area on a small device."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With a top bar, a bottom bar and a toolbar all stacked up, the content area shrinks fast. Check the actual visible area on a small device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部のバー＋下部のバー＋ツールバーまで重なると、コンテンツ領域は急激に狭くなります。小さいデバイスで実際に見える領域を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶栏 + 底栏 + 工具栏一叠加，内容区域会急剧缩小。请在小设备上确认实际可见区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂列 + 底列 + 工具列一疊加，內容區域會急劇縮小。請在小裝置上確認實際可見區域。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда верхняя панель, нижняя панель и панель инструментов накладываются друг на друга, область контента быстро сжимается. Проверьте фактическую видимую область на маленьком устройстве."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una barra superior, una barra inferior y una barra de herramientas apiladas, el área de contenido se encoge rápido. Comprueba el área visible real en un dispositivo pequeño."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn obere Leiste, untere Leiste und Symbolleiste alle gestapelt sind, schrumpft der Inhaltsbereich schnell. Prüfe den tatsächlich sichtbaren Bereich auf einem kleinen Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une barre du haut, une barre du bas et une barre d'outils toutes empilées, la zone de contenu rétrécit vite. Vérifiez la zone réellement visible sur un petit appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una barra in alto, una in basso e una barra degli strumenti tutte impilate, l'area del contenuto si riduce in fretta. Controlla l'area realmente visibile su un dispositivo piccolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com uma barra superior, uma inferior e uma barra de ferramentas todas empilhadas, a área de conteúdo encolhe depressa. Confira a área realmente visível num dispositivo pequeno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อแถบด้านบน แถบด้านล่าง และแถบเครื่องมือกองกัน พื้นที่เนื้อหาหดเร็ว ตรวจพื้นที่ที่มองเห็นจริงบนอุปกรณ์เล็ก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thanh trên, thanh dưới và thanh công cụ chồng hết lên nhau, vùng nội dung co rất nhanh. Hãy kiểm tra vùng nhìn thấy thực tế trên thiết bị nhỏ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je horní panel, dolní panel a panel nástrojů všechno nahromaděno, plocha obsahu rychle klesá. Zkontrolujte skutečnou viditelnou plochu na malém zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en øverste bjælke, en nederste bjælke og en værktøjslinje stablet oven på hinanden skrumper indholdsområdet hurtigt. Tjek det faktiske synlige område på en lille enhed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με πάνω γραμμή, κάτω γραμμή και γραμμή εργαλείων όλες στοιβαγμένες, η περιοχή περιεχομένου μικραίνει γρήγορα. Έλεγξε την πραγματική ορατή περιοχή σε μικρή συσκευή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ylä-, ala- ja työkalupalkit on pinottu päällekkäin, sisältöalue kutistuu nopeasti. Tarkista todellinen näkyvä alue pienellä laitteella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan bilah atas, bilah bawah, dan bilah alat bertumpuk, area konten menyusut cepat. Periksa area terlihat sebenarnya di perangkat kecil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med en øvre linje, en nedre linje og en verktøylinje stablet oppå hverandre krymper innholdsområdet raskt. Sjekk det faktiske synlige området på en liten enhet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een bovenbalk, een onderbalk en een werkbalk allemaal opgestapeld krimpt het inhoudsgebied snel. Controleer het werkelijk zichtbare gebied op een klein apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy górnym pasku, dolnym pasku i pasku narzędzi piętrzących się razem obszar treści kurczy się szybko. Sprawdź rzeczywisty widoczny obszar na małym urządzeniu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med ett övre fält, ett nedre fält och ett verktygsfält staplade krymper innehållsytan snabbt. Kontrollera den faktiska synliga ytan på en liten enhet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst çubuk, alt çubuk ve araç çubuğu üst üste yığıldığında içerik alanı hızla küçülür. Küçük bir cihazda gerçekte görünen alanı kontrol et."
          }
        }
      }
    },
