            "state": "translated",
            "value": "En falsk fane som bare åpner et ark uten å gå noe sted"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nep-tabblad dat alleen een sheet opent zonder ergens heen te gaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
