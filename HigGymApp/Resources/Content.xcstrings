          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Slet** med vilje holdt inde i overløb (forhindrer fejltryk)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η **Διαγραφή** σκόπιμα κρατημένη μέσα στο υπερχείλισμα (αποτρέπει κατά λάθος πατήματα)"
          }
        }
      }
    },
    "**상·하단 동시**, 양쪽 모두 soft 페이드로 통일": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Top and bottom at once**, both unified with a soft fade"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Top and bottom at once**, both unified with a soft fade"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**上下同時**。どちらもsoftのフェードで統一"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**上下同时**，两边都统一为 soft 淡出"
