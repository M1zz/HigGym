        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm và nhấn giữ va chạm nhau"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutí a dlouhý stisk se střetnou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og tryk-og-hold støder sammen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πάτημα και το παρατεταμένο πάτημα συγκρούονται"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napautus ja pitkä painallus törmäävät"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dan tekan-tahan bertabrakan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk og trykk-og-hold kolliderer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikken en ingedrukt houden botsen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknięcie i przytrzymanie kolidują"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och tryck-och-håll krockar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokunma ve basılı tutma çakışır"
          }
        }
      }
    },
    "탭과 길게 누르기가 충돌한다. 옮겨 적을 값에만 선별해 건다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and long press collide. Apply it selectively, only to values people will copy."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap and long press collide. Apply it selectively, only to values people will copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップと長押しが衝突する。書き写す値にだけ選んでかける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按和长按冲突。只选择性地加在需要抄写的值上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點和長按衝突。只選擇性地加在需要抄寫的值上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие и долгое нажатие конфликтуют. Применяйте выборочно, только к значениям, которые люди будут копировать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El toque y la pulsación larga chocan. Aplícalo de forma selectiva, solo a los valores que la gente copiará."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen und langes Drücken kollidieren. Wende es selektiv an, nur auf Werte, die Menschen kopieren werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher et appui long entrent en collision. Appliquez-le de façon sélective, seulement aux valeurs que les gens copieront."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocco e pressione prolungata entrano in collisione. Applicalo in modo selettivo, solo ai valori che le persone copieranno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e pressão prolongada colidem. Aplique de forma seletiva, só aos valores que as pessoas vão copiar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแตะและการกดค้างชนกัน ใช้อย่างเลือกสรร เฉพาะค่าที่คนจะคัดลอก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm và nhấn giữ va chạm nhau. Áp có chọn lọc, chỉ cho các giá trị người ta sẽ sao chép."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutí a dlouhý stisk se střetnou. Aplikujte selektivně, jen na hodnoty, které lidé zkopírují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og langt tryk støder sammen. Anvend det selektivt, kun på værdier, folk vil kopiere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πάτημα και το παρατεταμένο πάτημα συγκρούονται. Εφάρμοσέ το επιλεκτικά, μόνο σε τιμές που οι άνθρωποι θα αντιγράψουν."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napautus ja pitkä painallus törmäävät. Sovella sitä valikoivasti, vain arvoihin, joita ihmiset kopioivat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk dan tekan lama bertabrakan. Terapkan secara selektif, hanya pada nilai yang akan disalin orang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk og langt trykk kolliderer. Bruk det selektivt, bare på verdier folk vil kopiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikken en lang indrukken botsen. Pas het selectief toe, alleen op waarden die mensen gaan kopiëren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknięcie i długie naciśnięcie kolidują. Stosuj selektywnie, tylko do wartości, które ludzie będą kopiować."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och långt tryck krockar. Tillämpa det selektivt, bara på värden som folk kommer att kopiera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokunma ve uzun basma çakışır. Yalnızca insanların kopyalayacağı değerlere seçici olarak uygula."
          }
        }
      }
    },
    "탭바 **위 층**에 전역 상태(미니 플레이어 등)가 상주": {
      "extractionState": "manual",
      "localizations": {
        "en": {
