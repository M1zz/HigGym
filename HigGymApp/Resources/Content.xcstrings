            "value": "En «under samtale»- eller «opptak»-statuslinje"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een statusbalk \"in gesprek\" of \"opname\""
          }
        },
        "pl": {
