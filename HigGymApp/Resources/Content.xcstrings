          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một app tài liệu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace pro dokumenty"
          }
        },
        "da": {
          "stringUnit": {
