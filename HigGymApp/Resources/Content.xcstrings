    "**하단 safe area**에 커스텀 바, 홈 인디케이터 회피는 시스템 몫": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom bar in the **bottom safe area**, with the system handling clearance from the Home indicator"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A custom bar in the **bottom safe area**, with the system handling clearance from the Home indicator"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**下部のセーフエリア**にカスタムバー。ホームインジケータを避けるのはシステムの仕事"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在**底部 safe area** 放自定义栏，避开主屏幕指示条交给系统"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在**底部 safe area** 放自定義列，避開主螢幕指示條交給系統"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательская панель в **нижней safe area**, а отступ от индикатора «Домой» берёт на себя система"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra personalizada en el **área segura inferior**, con el sistema ocupándose de la distancia al indicador de inicio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine eigene Leiste im **unteren sicheren Bereich**, wobei das System den Abstand zum Home-Indikator übernimmt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre personnalisée dans la **zone sûre du bas**, le système se chargeant de l'écart avec l'indicateur d'accueil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra personalizzata nell'**area sicura in basso**, con il sistema che gestisce la distanza dall'indicatore Home"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra personalizada na **área segura inferior**, com o sistema cuidando da folga em relação ao indicador Início"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบที่กำหนดเองใน**safe area ด้านล่าง** โดยระบบจัดการระยะห่างจาก Home indicator"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thanh tùy chỉnh trong **safe area dưới**, với hệ thống lo khoảng cách với Home indicator"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní panel v **dolní safe area**, kde odstup od indikátoru Domů řeší systém"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En brugerdefineret bjælke i **det nederste safe area**, hvor systemet står for afstanden til Home-indikatoren"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια προσαρμοσμένη γραμμή στην **κάτω ασφαλή περιοχή**, με το σύστημα να φροντίζει την απόσταση από τον δείκτη Home"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukautettu palkki **alemmalla turva-alueella**, järjestelmän hoitaessa etäisyyden Home-indikaattorista"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah kustom di **area aman bawah**, dengan sistem yang mengatur jarak dari indikator Home"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En egendefinert linje i **det nedre trygge området**, der systemet håndterer avstanden til Home-indikatoren"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aangepaste balk in de **onderste safe area**, waarbij het systeem de afstand tot de Home-indicator regelt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własny pasek w **dolnej safe area**, w którym system dba o odstęp od wskaźnika Home"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett eget fält i **nedre säkra området**, där systemet hanterar avståndet till hemindikatorn"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Alt safe area**'da özel bir çubuk, Ana ekran göstergesinden uzak durmayı sistem halleder"
          }
        }
      }
    },
    "**하단(.bottomBar)**, 엄지가 닿는 자리에 고빈도 액션": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bottom (.bottomBar)**: a high-frequency action within thumb reach"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bottom (.bottomBar)**: a high-frequency action within thumb reach"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**下部（.bottomBar）**、親指が届く範囲に高頻度のアクション"
