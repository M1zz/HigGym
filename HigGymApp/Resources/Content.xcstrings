        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η **Αποθήκευση**, η πιο χρησιμοποιούμενη ενέργεια, διπλωμένη στο υπερχείλισμα λόγω της σειράς δήλωσης"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tallenna**, eniten käytetty toiminto, taitettu ylivuotoon ilmoitusjärjestyksen vuoksi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Simpan**, aksi yang paling sering dipakai, terlipat ke overflow karena urutan deklarasi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Lagre**, den mest brukte handlingen, foldet inn i overflyt på grunn av deklarasjonsrekkefølge"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bewaar**, de meestgebruikte actie, weggeklapt in overflow vanwege de volgorde van declaratie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Zapisz**, najczęściej używana akcja, zwinięte do przepełnienia z powodu kolejności deklaracji"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Spara**, den mest använda åtgärden, vikt in i överflödet på grund av deklarationsordningen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok kullanılan eylem olan **Kaydet**, tanımlama sırası yüzünden taşmaya katlandı"
          }
        }
      }
    },
    "가장 자주 쓰는 액션을 상단 구석에 두고 하단은 비운다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the most frequent action in a top corner and leaving the bottom empty"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the most frequent action in a top corner and leaving the bottom empty"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばんよく使うアクションを上の隅に置き、下部を空けておく"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把最常用的操作放在顶部角落，底部留空"
