    "회사 조직도(부서별 탭)를 그대로 탭 구조로 이식": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transplanting the company org chart (a tab per department) straight into the tab structure"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Transplanting the company org chart (a tab per department) straight into the tab structure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会社の組織図（部署ごとのタブ）をそのままタブ構造に移植する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把公司组织架构（按部门的标签）原样搬成标签结构"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把公司組織架構（按部門的標籤）原樣搬成標籤結構"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямой перенос организационной схемы компании (вкладка на отдел) в структуру вкладок"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasplantar el organigrama de la empresa (una pestaña por departamento) directamente a la estructura de pestañas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Organigramm der Firma (ein Tab pro Abteilung) direkt in die Tab-Struktur verpflanzen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transplanter l'organigramme de l'entreprise (un onglet par service) directement dans la structure d'onglets"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trapiantare l'organigramma aziendale (una scheda per reparto) direttamente nella struttura delle schede"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transplantar o organograma da empresa (uma aba por departamento) direto para a estrutura de abas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายผังองค์กรของบริษัท (หนึ่งแท็บต่อแผนก) ลงในโครงสร้างแท็บตรง ๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấy nguyên sơ đồ tổ chức công ty (mỗi phòng ban một tab) vào cấu trúc tab"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přenesení firemního organizačního diagramu (karta na oddělení) přímo do struktury karet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At overføre virksomhedens organisationsdiagram (en fane pr. afdeling) direkte til fanestrukturen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφύτευση του οργανογράμματος της εταιρείας (μία καρτέλα ανά τμήμα) απευθείας στη δομή καρτελών"
          }
        }
      }
    },
