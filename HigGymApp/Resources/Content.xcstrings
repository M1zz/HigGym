            "value": "Uma barra de finalização de compra + um botão de ajuda"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบชำระเงิน + ปุ่มช่วยเหลือ"
          }
        },
        "vi": {
          "stringUnit": {
