          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un campo de búsqueda siempre expuesto en una pantalla donde apenas se busca"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dauerhaft angezeigtes Suchfeld auf einem Bildschirm, auf dem kaum gesucht wird"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un champ de recherche toujours affiché sur un écran où la recherche est à peine utilisée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un campo di ricerca sempre in mostra in una schermata in cui la ricerca si usa appena"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um campo de busca sempre à mostra numa tela em que a busca mal é usada"
