        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise en page fixe où le contenu n'atteint jamais le dessous de la barre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un layout fisso in cui il contenuto non arriva mai sotto la barra"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um layout fixo em que o conteúdo nunca chega por baixo da barra"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลย์เอาต์ตายตัวที่เนื้อหาไม่เคยไปอยู่ใต้แถบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bố cục cố định nơi nội dung không bao giờ chạm xuống dưới thanh"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pevné rozvržení, kde obsah nikdy nesahá pod panel"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et fast layout, hvor indholdet aldrig når ind under bjælken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια σταθερή διάταξη όπου το περιεχόμενο δεν φτάνει ποτέ κάτω από τη γραμμή"
          }
        }
      }
    },
    "콘텐츠가 자동으로 그 아래부터": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content automatically starts below it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Content automatically starts below it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツは自動的にその下から"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容自动从它的下方开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容自動從它的下方開始"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое автоматически начинается под ней"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido empieza automáticamente por debajo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalt beginnt automatisch darunter"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu commence automatiquement en dessous"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto parte automaticamente sotto di essa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo começa automaticamente abaixo dela"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาเริ่มใต้มันโดยอัตโนมัติ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung tự bắt đầu bên dưới"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsah automaticky začíná pod ním"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indholdet starter automatisk under den"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιεχόμενο ξεκινά αυτόματα από κάτω της"
          }
        }
      }
    },
    "콘텐츠에 **고유한 높이**가 있을 때, 버튼 몇 개짜리 액션 패널, 재생 컨트롤 등 medium도 과한 작은 UI.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the content has **a height of its own**: small UI for which even medium is too much, like an action panel with a few buttons or playback controls."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the content has **a height of its own**: small UI for which even medium is too much, like an action panel with a few buttons or playback controls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツに**固有の高さ**があるとき。ボタン数個のアクションパネルや再生コントロールなど、mediumでも大きすぎる小さなUI。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容有**自身高度**时：只有几个按钮的操作面板、播放控件等连 medium 也嫌大的小 UI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容有**自身高度**時：只有幾個按鈕的操作面板、播放控制元件等連 medium 也嫌大的小 UI。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда у содержимого **своя высота**: небольшой интерфейс, для которого и medium слишком много, как панель действий с парой кнопок или управление воспроизведением."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el contenido tiene **una altura propia**: una interfaz pequeña para la que incluso medium es demasiado, como un panel de acciones con unos pocos botones o controles de reproducción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Inhalt **eine eigene Höhe** hat: kleine UI, für die selbst medium zu viel ist, wie ein Aktionspanel mit ein paar Buttons oder Wiedergabesteuerung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le contenu a **sa propre hauteur** : une petite interface pour laquelle même medium est trop, comme un panneau d'actions avec quelques boutons ou des commandes de lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il contenuto ha **un'altezza propria**: piccole UI per cui persino medium è troppo, come un pannello di azioni con pochi pulsanti o controlli di riproduzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o conteúdo tem **altura própria**: pequenas interfaces para as quais até medium é demais, como um painel de ações com alguns botões ou controles de reprodução."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเนื้อหา**มีความสูงของตัวเอง**: UI เล็กที่แม้ medium ก็มากเกินไป เช่นแผงการกระทำที่มีปุ่มไม่กี่ปุ่มหรือตัวควบคุมการเล่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi nội dung **có chiều cao riêng**: UI nhỏ mà ngay cả medium cũng quá lớn, như bảng hành động có vài nút hay điều khiển phát."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když má obsah **vlastní výšku**: malé UI, pro které je i medium příliš, jako panel akcí s několika tlačítky nebo ovládání přehrávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når indholdet har **sin egen højde**: lille brugerflade, hvor selv medium er for meget, som et handlingspanel med nogle få knapper eller afspilningskontroller."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το περιεχόμενο έχει **δικό του ύψος**: μικρό UI για το οποίο ακόμα και το medium είναι υπερβολικό, όπως ένα πάνελ ενεργειών με λίγα κουμπιά ή έλεγχοι αναπαραγωγής."
          }
        }
      }
    },
    "쿠폰 코드는": {
      "extractionState": "manual",
      "localizations": {
