    "넘치는 아이템은 **⋯ 메뉴**로 자동으로 접힘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items that overflow fold automatically into **the ⋯ menu**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Items that overflow fold automatically into **the ⋯ menu**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あふれたアイテムは⋯**メニュー**へ自動で折りたたまれる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "溢出的项目会**自动折叠进 ⋯ 菜单**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溢位的項目會**自動摺疊進 ⋯ 選單**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы, не поместившиеся, автоматически сворачиваются в **меню ⋯**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos que desbordan se pliegan automáticamente en **el menú ⋯**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
