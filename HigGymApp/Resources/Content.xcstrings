    "**탭 + 검색 + 액세서리**, 하단 시스템의 풀 구성": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tabs + search + accessory**, the full bottom-system setup"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tabs + search + accessory**, the full bottom-system setup"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**タブ＋検索＋アクセサリ**。下部システムのフル構成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**标签 + 搜索 + 附件**，底部系统的完整配置"
          }
        },
        "zh-Hant": {
