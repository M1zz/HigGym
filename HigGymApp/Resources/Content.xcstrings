        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu cara paling sederhana menaruh sesuatu di atas layar, jadi itulah yang pertama kamu raih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er den enkleste måten å sette noe oppå skjermen på, så det er det du griper til først."
          }
