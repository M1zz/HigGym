    },
    "값과 표기를 한 문자열에 담아 문화권 규칙을 앱이 정해버렸다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Value and format went into one string, so the app decided the cultural rules itself"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Value and format went into one string, so the app decided the cultural rules itself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値と表記をひとつの文字列に詰め込み、文化圏のルールをアプリが決めてしまった"
          }
        }
      }
    },
    "값은 Measurement로 들고 표기는 로케일에 맡긴다. 마일권 사용자에게 km를 강요하지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the value as a Measurement and leave the formatting to the locale. Don't force kilometers on people who think in miles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the value as a Measurement and leave the formatting to the locale. Don't force kilometres on people who think in miles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はMeasurementで持ち、表記はロケールに任せる。マイル圏のユーザーにkmを押しつけない。"
          }
        }
      }
    },
    "값은 앱이, 표기는 로케일이": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app owns the value, the locale owns the format"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The app owns the value, the locale owns the format"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はアプリが、表記はロケールが"
          }
        }
      }
    },
    "값이 바뀌면 화면 전체가 바뀜": {
      "extractionState": "manual",
      "localizations": {
        "en": {
