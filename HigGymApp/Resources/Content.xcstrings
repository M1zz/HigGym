        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以為把四個位置全部填滿才算完成"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мысль, что заполнение всех четырёх слотов завершает дизайн"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensar que llenar los cuatro sitios completa el diseño"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denken, dass das Füllen aller vier Plätze das Design vollständig macht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Penser que remplir les quatre emplacements rend le design complet"
          }
        },
        "it": {
