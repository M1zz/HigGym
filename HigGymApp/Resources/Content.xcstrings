    },
    "“미니멀해 보인다”는 이유로 전 화면 일괄 비활성화": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled across every screen because \"it looks more minimal\""
          }
        },
        "en-GB": {
          "stringUnit": {
