    "좋았던 설정을 다른 텍스트로 옮길 때, 그 설정이 좋았던 이유가 여기서도 참인지 먼저 확인한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you carry a setting that worked over to other text, first check whether the reason it worked still holds there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you carry a setting that worked over to other text, first check whether the reason it worked still holds there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいった設定をほかのテキストに持ち込むときは、その設定がうまくいった理由がここでも成り立つかを先に確かめる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把好用的设置搬到别的文字上时，先确认那个设置好用的理由在这里是否依然成立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把好用的設定搬到別的文字上時，先確認那個設定好用的理由在這裡是否依然成立。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда переносите настройку, которая работала, на другой текст, сначала проверьте, действует ли там причина, по которой она работала."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando traslades a otro texto un ajuste que funcionaba, comprueba primero si el motivo por el que funcionaba sigue valiendo allí."
          }
        }
      }
    },
    "좌우 가장자리 바를 동시에 사용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using bars on the left and right edges at once"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Using bars on the left and right edges at once"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右の端のバーを同時に使う"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时使用左右两侧边缘栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時使用左右兩側邊緣列"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременное использование панелей на левом и правом краях"
