          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**アクセシビリティの大きな文字サイズで確認していないlineLimit(1)** (2.1.1違反)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
