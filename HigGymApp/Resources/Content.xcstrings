        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een detailscherm wordt de ruimte van de tabbalk **teruggegeven aan de inhoud**"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ekranie szczegółów miejsce paska kart jest **oddawane treści**"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På en detaljskärm **ges flikfältets utrymme tillbaka till innehållet**"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ayrıntı ekranında sekme çubuğunun alanı **içeriğe geri verilir**"
          }
        }
      }
    },
    "상세 화면에서는 숨기는 게 규칙이라고 외워서 적용한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You memorized \"hide it on detail screens\" as a rule and apply it everywhere."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You memorised \"hide it on detail screens\" as a rule and apply it everywhere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面では隠すのがルールだと覚えて、そのまま当てはめる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把“详情界面要隐藏”背成规则来应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把「詳情介面要隱藏」背成規則來應用程式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выучили «скрывай на экранах подробностей» как правило и применяете его везде."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memorizaste «ocúltala en las pantallas de detalle» como regla y la aplicas en todas partes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dir „auf Detailbildschirmen ausblenden“ als Regel eingeprägt und wendest sie überall an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez mémorisé « masquer sur les écrans de détail » comme une règle et vous l'appliquez partout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai memorizzato «nascondila nelle schermate di dettaglio» come regola e la applichi ovunque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você memorizou «oculte nas telas de detalhe» como regra e aplica em todo lugar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจำ \"ซ่อนบนหน้ารายละเอียด\" เป็นกฎและใช้ทุกที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thuộc lòng \"ẩn trên màn hình chi tiết\" như một quy tắc và áp ở mọi nơi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naučili jste se nazpaměť „skrýt na detailních obrazovkách“ jako pravidlo a aplikujete ho všude."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lærte »skjul den på detaljeskærme« udenad som en regel og anvender den overalt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έμαθες απ' έξω το «κρύψε την σε οθόνες λεπτομερειών» ως κανόνα και τον εφαρμόζεις παντού."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Opettelit ulkoa ”piilota se yksityiskohtanäkymissä” sääntönä ja sovellat sitä kaikkialle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu menghafal \"sembunyikan di layar detail\" sebagai aturan dan menerapkannya di mana-mana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lærte «skjul den på detaljskjermer» utenat som en regel og bruker den overalt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je leerde \"verberg het op detailschermen\" uit je hoofd als regel en past die overal toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauczyłeś się na pamięć „ukryj to na ekranach szczegółów” jako reguły i stosujesz ją wszędzie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du lärde dig ”dölj det på detaljskärmar” utantill som en regel och tillämpar den överallt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Ayrıntı ekranlarında gizle” kuralını ezberledin ve her yere uyguluyorsun."
          }
        }
      }
    },
    "상세 화면에선 사용자가 이미 맥락을 알고 들어왔으므로 제목의 역할이 작음 → 세로 공간을 아껴 **콘텐츠를 한 줄이라도 더**(content-first). 위계 표현이기도 함: 제목 크기가 계층 깊이를 암시.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a detail screen, people arrive already knowing the context, so the title has less to do → save vertical space to show **even one more line of content** (content-first). It also expresses hierarchy: title size hints at depth."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On a detail screen, people arrive already knowing the context, so the title has less to do → save vertical space to show **even one more line of content** (content-first). It also expresses hierarchy: title size hints at depth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面では、ユーザーはすでに文脈をわかったうえで入ってきているので、タイトルの役割は小さい → 縦のスペースを節約して**コンテンツを1行でも多く**（content-first）。階層の表現でもある。タイトルの大きさが階層の深さを示す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在详情界面里，用户是知道上下文才进来的，所以标题的作用较小 → 节省纵向空间，**哪怕多露出一行内容**（content-first）。这也是层级的表达：标题大小暗示层级深度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在詳情介面裡，使用者是知道上下文才進來的，所以標題的作用較小 → 節省縱向空間，**哪怕多露出一行內容**（content-first）。這也是層級的表達：標題大小暗示層級深度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране подробностей люди приходят, уже зная контекст, поэтому у заголовка меньше работы → сэкономить вертикальное место, чтобы показать **хотя бы ещё одну строку содержимого** (content-first). Это ещё и выражение иерархии: размер заголовка намекает на глубину."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una pantalla de detalle, la gente llega ya sabiendo el contexto, así que el título tiene menos que hacer → ahorra espacio vertical para mostrar **aunque sea una línea más de contenido** (content-first). También expresa la jerarquía: el tamaño del título sugiere la profundidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem Detailbildschirm kommen Menschen schon mit Kenntnis des Kontexts an, also hat der Titel weniger zu tun → spare vertikalen Platz, um **auch nur eine Zeile mehr Inhalt** zu zeigen (Inhalt zuerst). Es drückt auch Hierarchie aus: Die Titelgröße deutet die Tiefe an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un écran de détail, les gens arrivent en connaissant déjà le contexte, donc le titre a moins à faire → économisez de l'espace vertical pour montrer **ne serait-ce qu'une ligne de contenu de plus** (content-first). Cela exprime aussi la hiérarchie : la taille du titre laisse deviner la profondeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una schermata di dettaglio, le persone arrivano già conoscendo il contesto, quindi il titolo ha meno da fare → risparmia spazio verticale per mostrare **anche solo una riga di contenuto in più** (content-first). Esprime anche la gerarchia: la dimensione del titolo suggerisce la profondità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa tela de detalhe, as pessoas chegam já conhecendo o contexto, então o título tem menos a fazer → economize espaço vertical para mostrar **nem que seja mais uma linha de conteúdo** (content-first). Também expressa hierarquia: o tamanho do título sugere a profundidade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้ารายละเอียด คนมาถึงโดยรู้บริบทแล้ว ชื่อเรื่องจึงมีหน้าที่น้อยลง → ประหยัดพื้นที่แนวตั้งเพื่อแสดง**เนื้อหาเพิ่มอีกเพียงหนึ่งบรรทัด** (content-first) มันยังแสดงลำดับชั้น: ขนาดชื่อเรื่องบอกใบ้ความลึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình chi tiết, người ta đến đã biết bối cảnh, nên tiêu đề ít việc hơn → tiết kiệm chiều dọc để hiện **thêm dù chỉ một dòng nội dung** (nội dung trước hết). Nó cũng biểu đạt thứ bậc: cỡ tiêu đề gợi độ sâu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na detailní obrazovce lidé přicházejí už se znalostí kontextu, takže nadpis má méně práce → ušetřete svislé místo, abyste ukázali **byť jen o jeden řádek víc obsahu** (content-first). Také vyjadřuje hierarchii: velikost nadpisu napovídá hloubku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På en detaljeskærm ankommer folk allerede med kendskab til konteksten, så titlen har mindre at gøre → spar lodret plads for at vise **bare én linje mere indhold** (content-first). Det udtrykker også hierarki: titelstørrelsen antyder dybde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε οθόνη λεπτομερειών, οι άνθρωποι φτάνουν ήδη γνωρίζοντας το πλαίσιο, οπότε ο τίτλος έχει λιγότερα να κάνει → εξοικονόμησε κάθετο χώρο για να δείξεις **ακόμα και μία γραμμή περισσότερο περιεχόμενο** (content-first). Εκφράζει επίσης ιεραρχία: το μέγεθος του τίτλου υπονοεί βάθος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksityiskohtanäkymässä ihmiset saapuvat jo tietäen kontekstin, joten otsikolla on vähemmän tehtävää → säästä pystytilaa näyttääksesi **vielä yhden rivin sisältöä** (content-first). Se ilmaisee myös hierarkiaa: otsikon koko vihjaa syvyydestä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di layar detail, orang tiba dengan sudah tahu konteksnya, jadi judul punya lebih sedikit tugas → hemat ruang vertikal untuk menampilkan **satu baris konten lagi** (konten lebih dulu). Ia juga mengungkapkan hierarki: ukuran judul memberi petunjuk kedalaman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På en detaljskjerm kommer folk inn med konteksten allerede kjent, så tittelen har mindre å gjøre → spar vertikal plass for å vise **enda en linje innhold** (innhold først). Den uttrykker også hierarki: tittelstørrelsen antyder dybde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een detailscherm komen mensen aan terwijl ze de context al kennen, dus de titel heeft minder te doen → bespaar verticale ruimte om **zelfs maar één regel extra inhoud** te tonen (content-first). Het drukt ook hiërarchie uit: de titelgrootte hint op diepte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ekranie szczegółów ludzie przychodzą, znając już kontekst, więc tytuł ma mniej do zrobienia → oszczędź miejsce w pionie, by pokazać **choćby jeszcze jeden wiersz treści** (content-first). Wyraża to także hierarchię: rozmiar tytułu sugeruje głębokość."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På en detaljskärm kommer folk redan med sammanhanget klart för sig, så rubriken har mindre att göra → spara lodrätt utrymme för att visa **även en rad innehåll till** (content-first). Det uttrycker också hierarki: rubrikstorleken antyder djup."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ayrıntı ekranına insanlar bağlamı zaten bilerek gelir, bu yüzden başlığın yapacağı iş azalır → **bir satır daha içerik** göstermek için dikey alandan tasarruf et (önce içerik). Hiyerarşiyi de ifade eder: başlık boyutu derinliğe işaret eder."
          }
        }
      }
    },
    "상세 화면의 Inline 제목이 \"월간 정기 결제 내역 상세 조회\"다. 내비바 가운데에서 \"월간 정기 결제 내…\"로 잘린다. 오른쪽에 버튼이 붙는 화면에서는 더 짧아진다. 잘린 뒷부분에 화면을 구별하는 말이 있어서, 비슷한 화면끼리 제목이 똑같아 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Inline title on a detail screen reads \"Monthly Subscription Payment History Details.\" In the middle of the navigation bar it gets cut off as \"Monthly Subscription Pay…\". On screens with buttons on the right, it gets even shorter. The words that tell screens apart are in the part that gets cut, so similar screens end up with titles that look identical."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Inline title on a detail screen reads \"Monthly Subscription Payment History Details.\" In the middle of the navigation bar it gets cut off as \"Monthly Subscription Pay…\". On screens with buttons on the right, it gets even shorter. The words that tell screens apart are in the part that gets cut, so similar screens end up with titles that look identical."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面の Inline タイトルが「月額定期支払い履歴の詳細照会」になっている。ナビゲーションバーの中央で「月額定期支払い履…」と切れる。右側にボタンが付く画面ではさらに短くなる。切れた後半に画面を区別する言葉があるため、似た画面同士でタイトルが同じに見えてしまう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详情界面的 Inline 标题是“月度定期支付记录详情查询”。在导航栏中间被截成“月度定期支付记…”。右侧贴着按钮的界面里会更短。区分界面的词在被截断的后半部分，所以相似的界面标题看起来一模一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詳情介面的 Inline 標題是「月度定期付款記錄詳情查詢」。在導覽列中間被截成「月度定期付款記…」。右側貼著按鈕的介面裡會更短。區分介面的詞在被截斷的後半部分，所以相似的介面標題看起來一模一樣。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline-заголовок экрана подробностей - «Сведения о ежемесячной истории регулярных платежей по подписке». В середине панели навигации он обрезается как «Сведения о ежемесячной истории…». На экранах с кнопками справа он ещё короче. Слова, различающие экраны, лежат в обрезанной части, поэтому похожие экраны получают внешне одинаковые заголовки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título Inline de una pantalla de detalle dice «Detalles del historial de pagos de la suscripción mensual». En el medio de la barra de navegación se corta como «Detalles del historial de pa…». En pantallas con botones a la derecha, queda aún más corto. Las palabras que distinguen las pantallas están en la parte que se corta, así que pantallas parecidas acaban con títulos que se ven idénticos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inline-Titel auf einem Detailbildschirm lautet „Details zum Zahlungsverlauf des Monatsabonnements“. In der Mitte der Navigationsleiste wird er als „Details zum Zahlungs…“ abgeschnitten. Auf Bildschirmen mit Buttons rechts wird er noch kürzer. Die Wörter, die Bildschirme unterscheiden, stehen im abgeschnittenen Teil, sodass ähnliche Bildschirme am Ende identisch aussehende Titel haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre Inline sur un écran de détail dit « Détails de l'historique des paiements de l'abonnement mensuel ». Au milieu de la barre de navigation, il est coupé en « Détails de l'historique des pa… ». Sur les écrans avec des boutons à droite, il devient encore plus court. Les mots qui distinguent les écrans sont dans la partie coupée, si bien que des écrans semblables finissent avec des titres d'apparence identique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo Inline in una schermata di dettaglio dice «Dettagli dello storico dei pagamenti dell'abbonamento mensile». A metà della barra di navigazione viene tagliato come «Dettagli dello storico dei pag…». Nelle schermate con pulsanti a destra diventa ancora più corto. Le parole che distinguono le schermate stanno nella parte tagliata, quindi schermate simili finiscono con titoli che sembrano identici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título Inline numa tela de detalhe diz «Detalhes do histórico de pagamentos da assinatura mensal». No meio da barra de navegação é cortado como «Detalhes do histórico de pag…». Em telas com botões à direita, fica ainda mais curto. As palavras que distinguem as telas estão na parte cortada, então telas parecidas acabam com títulos que parecem idênticos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่อง Inline บนหน้ารายละเอียดอ่านว่า \"รายละเอียดประวัติการชำระเงินสมาชิกรายเดือน\" กลางแถบนำทางมันถูกตัดเป็น \"รายละเอียดประวัติการชำระ…\" บนหน้าจอที่มีปุ่มทางขวา ยิ่งสั้นลงอีก คำที่แยกหน้าจอออกจากกันอยู่ในส่วนที่ถูกตัด หน้าจอที่คล้ายกันจึงลงเอยด้วยชื่อเรื่องที่ดูเหมือนกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề Inline trên màn hình chi tiết ghi \"Chi tiết lịch sử thanh toán đăng ký hàng tháng.\" Giữa thanh điều hướng nó bị cắt thành \"Chi tiết lịch sử thanh…\". Trên màn hình có nút bên phải, nó còn ngắn hơn. Những từ phân biệt các màn hình nằm ở phần bị cắt, nên các màn hình tương tự có tiêu đề trông y hệt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline nadpis na detailní obrazovce zní „Podrobnosti historie plateb měsíčního předplatného.“ Uprostřed navigačního panelu je oříznut na „Podrobnosti historie pl…“. Na obrazovkách s tlačítky vpravo je ještě kratší. Slova, která obrazovky rozlišují, jsou v části, která se ořízne, takže podobné obrazovky mají nadpisy, které vypadají stejně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline-titlen på en detaljeskærm lyder »Detaljer om månedlig abonnementsbetalingshistorik.« I midten af navigationsbjælken bliver den skåret af som »Månedlig abonnementsbet…«. På skærme med knapper til højre bliver den endnu kortere. Ordene, der skiller skærme ad, ligger i den del, der bliver skåret af, så lignende skærme ender med titler, der ser identiske ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Inline τίτλος σε οθόνη λεπτομερειών γράφει «Λεπτομέρειες ιστορικού πληρωμών μηνιαίας συνδρομής». Στη μέση της γραμμής πλοήγησης κόβεται ως «Λεπτομέρειες ιστορικού πληρ…». Σε οθόνες με κουμπιά δεξιά, γίνεται ακόμα συντομότερος. Οι λέξεις που ξεχωρίζουν τις οθόνες είναι στο μέρος που κόβεται, οπότε παρόμοιες οθόνες καταλήγουν με τίτλους που φαίνονται πανομοιότυποι."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksityiskohtanäkymän Inline-otsikko kuuluu ”Kuukausitilauksen maksuhistorian tiedot”. Navigointipalkin keskellä se katkeaa muotoon ”Kuukausitilauksen maksuh…”. Näkymissä, joissa on painikkeita oikealla, se lyhenee vielä enemmän. Näkymät toisistaan erottavat sanat ovat katkaistussa osassa, joten samankaltaisten näkymien otsikot näyttävät identtisiltä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul Inline di layar detail berbunyi \"Rincian Riwayat Pembayaran Langganan Bulanan.\" Di tengah bilah navigasi ia terpotong menjadi \"Rincian Riwayat Pembay…\". Di layar dengan tombol di kanan, ia makin pendek. Kata-kata yang membedakan layar ada di bagian yang terpotong, sehingga layar yang mirip berakhir dengan judul yang tampak identik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline-tittelen på en detaljskjerm lyder «Detaljer om betalingshistorikk for månedlig abonnement». Midt i navigasjonslinjen blir den kuttet til «Detaljer om betalingshist…». På skjermer med knapper til høyre blir den enda kortere. Ordene som skiller skjermer fra hverandre ligger i delen som kuttes, så like skjermer ender opp med titler som ser identiske ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Inline-titel op een detailscherm luidt \"Details betalingsgeschiedenis maandabonnement\". In het midden van de navigatiebalk wordt hij afgekapt als \"Details betalingsgeschiedeni…\". Op schermen met knoppen rechts wordt hij nog korter. De woorden die schermen onderscheiden zitten in het deel dat wordt afgekapt, dus vergelijkbare schermen krijgen titels die er identiek uitzien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuł Inline na ekranie szczegółów brzmi „Szczegóły historii płatności abonamentu miesięcznego”. Pośrodku paska nawigacji zostaje obcięty do „Szczegóły historii płatnoś…”. Na ekranach z przyciskami po prawej jest jeszcze krótszy. Słowa odróżniające ekrany są w odciętej części, więc podobne ekrany kończą z tytułami, które wyglądają identycznie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline-rubriken på en detaljskärm lyder ”Månadsprenumeration: betalningshistorik, detaljer”. Mitt i navigeringsfältet kapas den till ”Månadsprenumeration: betaln…”. På skärmar med knappar till höger blir den ännu kortare. Orden som skiljer skärmar åt finns i den kapade delen, så liknande skärmar får rubriker som ser identiska ut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ayrıntı ekranındaki Inline başlık “Aylık Abonelik Ödeme Geçmişi Ayrıntıları” diyor. Gezinme çubuğunun ortasında “Aylık Abonelik Öde…” diye kesiliyor. Sağda düğmeler olan ekranlarda daha da kısalıyor. Ekranları birbirinden ayıran sözcükler kesilen kısımda, bu yüzden benzer ekranların başlıkları aynı görünüyor."
          }
        }
      }
    },
    "상세 화면의 leading에는 뒤로가기만 둔다. 도구 묶음은 trailing 쪽 캡슐로 옮기고, 편집 중에 반복해서 누르는 도구라면 하단 툴바로 내린다. 왼쪽 위는 다시 한 가지 뜻만 갖는다. 1.1.2 Leading Cluster and Trailing Item 예제의 설명을 보면 이 패턴이 루트 화면이나 모달처럼 **back이 없는 화면**을 전제로 한다는 점이 적혀 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the detail screen, put only Back in leading. Move the tool group to a capsule on the trailing side, and if they're tools you tap repeatedly while editing, move them down to the bottom toolbar. The top left goes back to having a single meaning. The description of the 1.1.2 Leading Cluster and Trailing Item example notes that this pattern assumes a **screen without Back**, such as a root screen or a modal."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On the detail screen, put only Back in leading. Move the tool group to a capsule on the trailing side, and if they're tools you tap repeatedly while editing, move them down to the bottom toolbar. The top left goes back to having a single meaning. The description of the 1.1.2 Leading Cluster and Trailing Item example notes that this pattern assumes a **screen without Back**, such as a root screen or a modal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面のleadingには戻るボタンだけを置く。ツールのまとまりはtrailing側のカプセルに移し、編集中に繰り返し押すツールなら下部のツールバーに下ろす。左上は再びひとつの意味だけを持つ。1.1.2 Leading Cluster and Trailing Itemの例の説明を見ると、このパターンはルート画面やモーダルのような**戻るボタンのない画面**を前提にしていると書かれている。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详情界面的 leading 只放返回。工具组移到 trailing 一侧的胶囊，如果是编辑期间反复点按的工具，就下放到底部工具栏。左上角重新只表示一种含义。看 1.1.2 Leading Cluster and Trailing Item 示例的说明，里面写明这个模式以根界面或模态这类**没有返回的界面**为前提。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詳情介面的 leading 只放返回。工具組移到 trailing 一側的膠囊，如果是編輯期間反覆輕點的工具，就下放到底部工具列。左上角重新只表示一種含義。看 1.1.2 Leading Cluster and Trailing Item 示例的說明，裡面寫明這個模式以根介面或模態這類**沒有返回的介面**為前提。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране подробностей в leading оставьте только «Назад». Группу инструментов перенесите в капсулу со стороны trailing, а если это инструменты, которые нажимают повторно при редактировании, спустите их в нижнюю панель инструментов. Левый верх снова обретает единственное значение. Описание примера 1.1.2 Leading Cluster and Trailing Item отмечает, что этот шаблон предполагает **экран без «Назад»**, такой как корневой экран или модальное окно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pantalla de detalle, pon solo Atrás en leading. Pasa el grupo de herramientas a una cápsula del lado trailing, y si son herramientas que tocas repetidamente al editar, bájalas a la barra de herramientas inferior. La parte superior izquierda vuelve a tener un único significado. La descripción del ejemplo 1.1.2 Leading Cluster and Trailing Item señala que este patrón presupone una **pantalla sin Atrás**, como una pantalla raíz o un modal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze auf dem Detailbildschirm nur Zurück nach leading. Verschiebe die Werkzeuggruppe in eine Kapsel auf der trailing-Seite, und sind es Werkzeuge, die du beim Bearbeiten wiederholt antippst, verschiebe sie nach unten in die untere Symbolleiste. Die obere linke Ecke hat wieder eine einzige Bedeutung. Die Beschreibung des Beispiels 1.1.2 Leading Cluster and Trailing Item vermerkt, dass dieses Muster einen **Bildschirm ohne Zurück** voraussetzt, etwa einen Wurzelbildschirm oder ein Modal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur l'écran de détail, ne mettez que Retour en leading. Déplacez le groupe d'outils dans une capsule du côté trailing, et si ce sont des outils que vous touchez à répétition en éditant, descendez-les dans la barre d'outils du bas. Le coin supérieur gauche retrouve un sens unique. La description de l'exemple 1.1.2 Leading Cluster and Trailing Item note que ce motif suppose un **écran sans Retour**, comme un écran racine ou une modale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella schermata di dettaglio, metti solo Indietro in leading. Sposta il gruppo di strumenti in una capsula sul lato trailing e, se sono strumenti che tocchi ripetutamente mentre modifichi, spostali giù nella barra degli strumenti in basso. L'alto a sinistra torna ad avere un solo significato. La descrizione dell'esempio 1.1.2 Gruppo leading ed elemento trailing nota che questo schema presuppone una **schermata senza Indietro**, come una schermata radice o un modale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tela de detalhe, ponha só Voltar em leading. Mova o grupo de ferramentas para uma cápsula do lado trailing e, se são ferramentas que você toca repetidamente ao editar, mova-as para a barra de ferramentas inferior. O canto superior esquerdo volta a ter um único significado. A descrição do exemplo 1.1.2 Grupo leading e item trailing observa que esse padrão pressupõe uma **tela sem Voltar**, como uma tela raiz ou um modal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้ารายละเอียด ใส่แค่ย้อนกลับใน leading ย้ายกลุ่มเครื่องมือไปเป็นแคปซูลฝั่ง trailing และถ้าเป็นเครื่องมือที่คุณแตะซ้ำขณะแก้ไข ย้ายลงแถบเครื่องมือล่าง ซ้ายบนกลับมามีความหมายเดียว คำอธิบายของตัวอย่าง 1.1.2 Leading Cluster and Trailing Item ระบุว่ารูปแบบนี้สมมติ**หน้าจอที่ไม่มีย้อนกลับ** เช่นหน้าจอรากหรือโมดัล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình chi tiết, chỉ đặt Quay lại ở leading. Chuyển nhóm công cụ sang capsule ở phía trailing, và nếu là công cụ bạn chạm lặp lại khi chỉnh sửa, chuyển xuống thanh công cụ dưới. Góc trên bên trái lại chỉ có một ý nghĩa. Mô tả ví dụ 1.1.2 Leading Cluster and Trailing Item ghi chú rằng mẫu này giả định một **màn hình không có Quay lại**, như màn hình gốc hoặc modal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na detailní obrazovce dejte do leading jen Zpět. Skupinu nástrojů přesuňte do kapsle na straně trailing, a pokud jde o nástroje, na které při úpravě klepete opakovaně, přesuňte je dolů do spodního panelu nástrojů. Levý horní roh opět má jediný význam. Popis příkladu 1.1.2 Leading Cluster and Trailing Item poznamenává, že tento vzor předpokládá **obrazovku bez Zpět**, jako je kořenová obrazovka nebo modál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På detaljeskærmen lægger du kun Tilbage i leading. Flyt værktøjsgruppen til en kapsel i trailing-siden, og hvis det er værktøjer, du trykker på gentagne gange under redigering, så flyt dem ned i den nederste værktøjslinje. Øverste venstre hjørne får igen en enkelt betydning. Beskrivelsen af eksempel 1.1.2 Leading-klynge og trailing-element bemærker, at dette mønster forudsætter en **skærm uden Tilbage**, som en rodskærm eller en modal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στην οθόνη λεπτομερειών, βάλε μόνο το Πίσω στο leading. Μετάφερε την ομάδα εργαλείων σε κάψουλα στην trailing πλευρά, και αν είναι εργαλεία που πατάς επανειλημμένα κατά την επεξεργασία, μετάφερέ τα κάτω στην κάτω γραμμή εργαλείων. Η πάνω αριστερή γωνία ξαναποκτά ένα μοναδικό νόημα. Η περιγραφή του παραδείγματος 1.1.2 Leading ομάδα και trailing στοιχείο σημειώνει ότι αυτό το μοτίβο προϋποθέτει μια **οθόνη χωρίς Πίσω**, όπως αρχική οθόνη ή modal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita yksityiskohtanäkymässä leadingiin vain Takaisin. Siirrä työkaluryhmä trailing-puolen kapseliin, ja jos ne ovat työkaluja, joita napautat toistuvasti muokatessa, siirrä ne alas alatyökalupalkkiin. Vasen yläkulma saa jälleen yhden merkityksen. Esimerkin 1.1.2 Leading-ryhmä ja Trailing-kohde kuvaus toteaa, että tämä malli olettaa **näkymän ilman Takaisinia**, kuten juurinäkymän tai modaalin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di layar detail, taruh hanya Kembali di leading. Pindahkan grup alat ke kapsul di sisi trailing, dan jika itu alat yang diketuk berulang saat menyunting, pindahkan ke bilah alat bawah. Kiri atas kembali punya satu makna. Deskripsi contoh 1.1.2 Leading Cluster and Trailing Item mencatat bahwa pola ini mengasumsikan **layar tanpa Kembali**, seperti layar akar atau modal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På detaljskjermen, sett bare Tilbake i leading. Flytt verktøygruppen til en kapsel på trailing-siden, og hvis det er verktøy du trykker på gjentatte ganger mens du redigerer, flytt dem ned til bunnverktøylinjen. Øverst til venstre får igjen én enkelt mening. Beskrivelsen av eksempelet 1.1.2 Leading Cluster and Trailing Item merker at dette mønsteret forutsetter en **skjerm uten Tilbake**, som en rotskjerm eller en modal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet op het detailscherm alleen Terug in leading. Verplaats de gereedschapsgroep naar een capsule aan de trailing-kant, en als het gereedschappen zijn waarop je tijdens het bewerken herhaaldelijk tikt, verplaats ze dan naar de onderste werkbalk. De linkerbovenhoek heeft weer één betekenis. De beschrijving van het voorbeeld 1.1.2 Leading-cluster en trailing-item merkt op dat dit patroon uitgaat van een **scherm zonder Terug**, zoals een rootscherm of een modal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ekranie szczegółów zostaw w leading tylko Wstecz. Przenieś grupę narzędzi do kapsuły po stronie trailing, a jeśli to narzędzia, w które stukasz wielokrotnie podczas edycji, przenieś je na dolny pasek narzędzi. Lewy górny róg znów ma jedno znaczenie. Opis przykładu 1.1.2 Klaster leading i element trailing zauważa, że ten wzorzec zakłada **ekran bez Wstecz**, taki jak ekran główny lub modal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På detaljskärmen, lägg bara Tillbaka i leading. Flytta verktygsgruppen till en kapsel på trailing-sidan, och om det är verktyg du trycker på upprepat under redigering, flytta dem ner till det nedre verktygsfältet. Det övre vänstra hörnet får tillbaka en enda betydelse. Beskrivningen av exemplet 1.1.2 Leading Cluster and Trailing Item noterar att det här mönstret förutsätter en **skärm utan Tillbaka**, som en rotskärm eller en modal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıntı ekranında başa yalnızca Geri'yi koy. Araç grubunu sondaki bir kapsüle taşı ve düzenlerken tekrar tekrar dokunduğun araçlarsa alt araç çubuğuna indir. Sol üst yine tek bir anlam taşır. 1.1.2 Leading Cluster and Trailing Item örneğinin açıklaması, bu kalıbın kök ekran ya da modal gibi **Geri'si olmayan bir ekran** varsaydığını belirtir."
          }
        }
      }
    },
    "상세가 **몰입형**일 때, 사진 전체 화면, 영상 재생, 읽기 화면. 또는 작성 중 화면처럼 탭 전환이 흐름을 깨는 경우.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the detail is **immersive**: a full-screen photo, video playback, a reading view. Or when switching tabs would break the flow, as on a compose screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the detail is **immersive**: a full-screen photo, video playback, a reading view. Or when switching tabs would break the flow, as on a compose screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細が**没入型**のとき。写真のフルスクリーン表示、動画の再生、読む画面など。あるいは作成中の画面のように、タブ切り替えが流れを壊す場合。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当详情是**沉浸型**时：照片全屏、视频播放、阅读界面。或者像撰写中界面那样，切换标签会打断流程的情形。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當詳情是**沉浸型**時：照片全螢幕、影片播放、閱讀介面。或者像撰寫中介面那樣，切換標籤會打斷流程的情形。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда подробности **погружающие**: полноэкранное фото, воспроизведение видео, экран чтения. Или когда переключение вкладок ломало бы поток, как на экране написания."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el detalle es **inmersivo**: una foto a pantalla completa, reproducción de vídeo, una vista de lectura. O cuando cambiar de pestaña rompería el flujo, como en una pantalla de redactar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Detail **immersiv** ist: ein Vollbildfoto, Videowiedergabe, eine Leseansicht. Oder wenn ein Tab-Wechsel den Ablauf unterbrechen würde, wie auf einem Verfassen-Bildschirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le détail est **immersif** : une photo plein écran, une lecture vidéo, une vue de lecture. Ou quand changer d'onglet briserait le parcours, comme sur un écran de rédaction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il dettaglio è **immersivo**: una foto a schermo intero, la riproduzione di un video, una vista di lettura. O quando cambiare scheda romperebbe il flusso, come in una schermata di scrittura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o detalhe é **imersivo**: uma foto em tela cheia, reprodução de vídeo, uma vista de leitura. Ou quando trocar de aba quebraria o fluxo, como numa tela de escrita."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อรายละเอียด**ดื่มด่ำ**: รูปถ่ายเต็มหน้าจอ การเล่นวิดีโอ มุมมองอ่าน หรือเมื่อการสลับแท็บจะทำลายขั้นตอน เช่นบนหน้าจอเขียน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi chi tiết mang tính **đắm chìm**: ảnh toàn màn hình, phát video, màn hình đọc. Hoặc khi chuyển tab sẽ phá luồng, như màn hình soạn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je detail **pohlcující**: fotka na celou obrazovku, přehrávání videa, čtecí zobrazení. Nebo když by přepínání karet narušilo tok, jako na obrazovce psaní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når detaljen er **fordybende**: et fuldskærmsfoto, videoafspilning, en læsevisning. Eller når fanevalg ville bryde flowet, som på en skriveskærm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν η λεπτομέρεια είναι **εμβυθιστική**: μια φωτογραφία πλήρους οθόνης, αναπαραγωγή βίντεο, μια προβολή ανάγνωσης. Ή όταν η εναλλαγή καρτελών θα έσπαγε τη ροή, όπως σε οθόνη σύνταξης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun yksityiskohta on **immersiivinen**: kokoruudun valokuva, videon toisto, lukunäkymä. Tai kun välilehtien vaihto rikkoisi kulun, kuten kirjoitusnäkymässä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat detailnya **imersif**: foto layar penuh, pemutaran video, tampilan baca. Atau saat berpindah tab akan merusak alur, seperti di layar tulis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når detaljen er **oppslukende**: et helskjermbilde, videoavspilling, en lesevisning. Eller når bytte av faner ville bryte flyten, som på en skriveskjerm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer het detail **meeslepend** is: een foto op volledig scherm, het afspelen van video, een leesweergave. Of wanneer van tabblad wisselen de flow zou breken, zoals op een schrijfscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy szczegóły są **immersyjne**: zdjęcie na pełnym ekranie, odtwarzanie wideo, widok czytania. Albo gdy przełączanie kart zerwałoby przepływ, jak na ekranie pisania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När detaljen är **uppslukande**: ett helskärmsfoto, videouppspelning, en lässkärm. Eller när byte av flik skulle bryta flödet, som på en skrivskärm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıntı **sürükleyici** olduğunda: tam ekran bir fotoğraf, video oynatma, bir okuma görünümü. Ya da yazma ekranında olduğu gibi sekme değiştirmenin akışı bozacağı durumlarda."
          }
        }
      }
    },
    "상세로 들어가도 탭바가 **항상 유지**, 상시 지도 역할": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar **stays put** even in detail screens, serving as a constant map"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar **stays put** even in detail screens, serving as a constant map"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面に入ってもタブバーが**常に残り**、常設の地図の役割を果たす"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入详情，标签栏也**始终保留**，起常驻地图的作用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入詳情，標籤列也**始終保留**，起常駐地圖的作用"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок **остаётся на месте** даже на экранах подробностей, служа постоянной картой"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas **se queda** incluso en las pantallas de detalle, sirviendo como mapa constante"
          }
        },
        "de": {
          "stringUnit": {
