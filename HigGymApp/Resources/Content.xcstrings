    "검색 필드를 **툴바에** 배치, iPhone은 하단 유리 캡슐, iPad는 상단 trailing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search field placed **in the toolbar**: a glass capsule at the bottom on iPhone, top trailing on iPad."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The search field placed **in the toolbar**: a glass capsule at the bottom on iPhone, top trailing on iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索フィールドを**ツールバーに**配置。iPhoneでは下部のガラスカプセル、iPadでは上部のtrailing。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把搜索框放在**工具栏里**：iPhone 是底部玻璃胶囊，iPad 是顶部 trailing。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把搜尋框放在**工具列裡**：iPhone 是底部玻璃膠囊，iPad 是頂部 trailing。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле поиска, размещённое **на панели инструментов**: стеклянная капсула внизу на iPhone, вверху trailing на iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El campo de búsqueda colocado **en la barra de herramientas**: una cápsula de cristal abajo en iPhone, arriba a la derecha en iPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Suchfeld **in der Symbolleiste** platziert: eine Glaskapsel unten auf dem iPhone, oben trailing auf dem iPad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le champ de recherche placé **dans la barre d'outils** : une capsule de verre en bas sur iPhone, en haut à droite (trailing) sur iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il campo di ricerca collocato **nella barra degli strumenti**: una capsula di vetro in basso su iPhone, in alto in trailing su iPad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O campo de busca colocado **na barra de ferramentas**: uma cápsula de vidro embaixo no iPhone, topo trailing no iPad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่องค้นหาวาง**ในแถบเครื่องมือ**: แคปซูลกระจกที่ด้านล่างบน iPhone ขวาบนบน iPad"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ô tìm kiếm đặt **trong thanh công cụ**: capsule kính ở dưới cùng trên iPhone, trailing phía trên trên iPad."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávací pole umístěné **v panelu nástrojů**: skleněná kapsle dole na iPhonu, vpravo nahoře na iPadu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgefeltet placeret **i værktøjslinjen**: en glaskapsel nederst på iPhone, øverst trailing på iPad."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πεδίο αναζήτησης τοποθετημένο **στη γραμμή εργαλείων**: κάψουλα γυαλιού κάτω στο iPhone, πάνω trailing στο iPad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakukenttä sijoitettuna **työkalupalkkiin**: lasikapseli alhaalla iPhonella, oikea yläkulma iPadilla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolom pencarian ditaruh **di bilah alat**: kapsul kaca di bawah pada iPhone, trailing atas pada iPad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søkefeltet plassert **i verktøylinjen**: en glasskapsel nederst på iPhone, øverst trailing på iPad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zoekveld geplaatst **in de werkbalk**: een glazen capsule onderaan op iPhone, rechtsboven op iPad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pole wyszukiwania umieszczone **na pasku narzędzi**: szklana kapsuła na dole na iPhonie, prawy górny róg na iPadzie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökfältet placerat **i verktygsfältet**: en glaskapsel längst ner på iPhone, uppe till höger på iPad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Araç çubuğuna** yerleştirilen arama alanı: iPhone'da altta bir cam kapsül, iPad'de sağ üst."
          }
        }
      }
    },
    "검색 필드를 툴바 **정중앙(principal)**에, 제목 자리를 검색이 차지.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search field in the toolbar's **dead center (principal)**, with search taking over the title slot."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The search field in the toolbar's **dead centre (principal)**, with search taking over the title slot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索フィールドをツールバーの**真ん中（principal**）に。タイトルの位置を検索が占める。"
