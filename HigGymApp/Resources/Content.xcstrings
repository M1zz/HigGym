    "성격이 다른 **삭제 + 정렬**을 한 캡슐에 묶어 한 세트처럼 보이게 함": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Delete + Sort**, two very different things, bound into one capsule so they look like a set"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Delete + Sort**, two very different things, bound into one capsule so they look like a set"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "性格の異なる**削除 + 並べ替え**をひとつのカプセルにまとめ、セットのように見せている"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把性质不同的**删除 + 排序**放进同一个胶囊，看起来像一组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把性質不同的**刪除 + 排序**放進同一個膠囊，看起來像一組"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**«Удалить» + «Сортировка»**, две совсем разные вещи, связанные в одной капсуле, чтобы выглядеть как набор"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Eliminar + Ordenar**, dos cosas muy distintas, atadas en una cápsula para que parezcan un conjunto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Löschen + Sortieren**, zwei sehr verschiedene Dinge, in eine Kapsel gebunden, sodass sie wie ein Set aussehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Supprimer + Trier**, deux choses très différentes, liées dans une capsule pour paraître former un ensemble"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina + Ordina**, due cose molto diverse, unite in una capsula così sembrano un insieme"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Excluir + Ordenar**, duas coisas muito diferentes, reunidas numa cápsula para parecerem um conjunto"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ลบ + เรียงลำดับ** สองสิ่งที่ต่างกันมาก ผูกเป็นแคปซูลเดียวจนดูเหมือนเป็นชุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Xóa + Sắp xếp**, hai việc rất khác nhau, gộp vào một capsule để trông như một bộ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Smazat + Seřadit**, dvě velmi odlišné věci, svázané do jedné kapsle, aby vypadaly jako sada"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Slet + Sortér**, to vidt forskellige ting, bundet sammen i én kapsel, så de ligner et sæt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Διαγραφή + Ταξινόμηση**, δύο πολύ διαφορετικά πράγματα, δεμένα σε μία κάψουλα ώστε να μοιάζουν με σύνολο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Poista + Lajittele**, kaksi hyvin erilaista asiaa, sidottuna yhteen kapseliin niin että ne näyttävät kokonaisuudelta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hapus + Urutkan**, dua hal yang sangat berbeda, diikat dalam satu kapsul sehingga tampak seperti satu set"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Slett + Sorter**, to svært ulike ting, bundet sammen i én kapsel slik at de ser ut som et sett"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Verwijder + Sorteer**, twee heel verschillende dingen, gebundeld in één capsule zodat ze eruitzien als een set"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Usuń + Sortuj**, dwie bardzo różne rzeczy, związane w jedną kapsułę, by wyglądały jak zestaw"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Radera + Sortera**, två mycket olika saker, ihopbundna i en kapsel så att de ser ut som en uppsättning"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sil + Sırala**, çok farklı iki şey, bir set gibi görünsünler diye tek kapsüle bağlanmış"
          }
        }
      }
    },
