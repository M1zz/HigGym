            "value": "Faner + søkekapsel + minispiller + minimize"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabbladen + zoekcapsule + miniplayer + minimaliseren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty + kapsuła wyszukiwania + mini odtwarzacz + minimalizowanie"
          }
        },
        "sv": {
