    },
    "서랍 검색바를 **스크롤해도 고정** (.always)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawer search bar **pinned even while scrolling** (.always)"
