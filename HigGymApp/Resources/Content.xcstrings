            "value": "An action button in the center and the screen mode control in trailing (hierarchy reversed)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An action button in the centre and the screen mode control in trailing (hierarchy reversed)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央にアクションボタン、trailingに画面モードのコントロール（階層が逆転）"
