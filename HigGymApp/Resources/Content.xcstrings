    "크기가 변하는 자리에 넣을 뷰는 **가장 작은 상태부터** 그린다. 거기서 남는 것이 그 뷰의 핵심이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a view that goes into a spot whose size changes, design it **starting from the smallest state**. Whatever survives there is the core of that view."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For a view that goes into a spot whose size changes, design it **starting from the smallest state**. Whatever survives there is the core of that view."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズが変わる場所に入れるビューは、**いちばん小さい状態から**描く。そこで残るものが、そのビューの核心だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放进大小会变化的位置的视图，要**从最小的状态画起**。剩下的就是这个视图的核心。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放進大小會變化的位置的檢視，要**從最小的狀態畫起**。剩下的就是這個檢視的核心。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вида, попадающего в место, размер которого меняется, проектируйте его **начиная с самого малого состояния**. То, что там выживает, - ядро этого вида."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para una vista que va a un sitio cuyo tamaño cambia, diséñala **empezando por el estado más pequeño**. Lo que sobreviva ahí es el núcleo de esa vista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestalte eine Ansicht, die an einen Platz kommt, dessen Größe sich ändert, **ausgehend vom kleinsten Zustand**. Was dort überlebt, ist der Kern dieser Ansicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une vue qui va dans un emplacement dont la taille change, concevez-la **en partant de l'état le plus petit**. Ce qui y survit est le cœur de cette vue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per una vista che va in un posto la cui dimensione cambia, progettala **partendo dallo stato più piccolo**. Ciò che sopravvive lì è il cuore di quella vista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para uma view que vai num lugar cujo tamanho muda, projete-a **partindo do menor estado**. O que sobrevive ali é o cerne dessa view."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับ view ที่ไปอยู่ในตำแหน่งที่ขนาดเปลี่ยน ให้ออกแบบ**เริ่มจากสถานะที่เล็กที่สุด** สิ่งที่รอดที่นั่นคือแก่นของ view นั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với một view đi vào chỗ có kích thước thay đổi, hãy thiết kế nó **bắt đầu từ trạng thái nhỏ nhất**. Thứ gì sống sót ở đó chính là cốt lõi của view."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U view, které jde na místo s měnící se velikostí, ho navrhněte **počínaje nejmenším stavem**. Co tam přežije, je jádro toho view."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For en visning, der kommer ind på en plads, hvis størrelse ændres, så design den **med udgangspunkt i den mindste tilstand**. Det, der overlever der, er visningens kerne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για μια προβολή που μπαίνει σε σημείο με μεταβαλλόμενο μέγεθος, σχεδίασέ την **ξεκινώντας από τη μικρότερη κατάσταση**. Ό,τι επιβιώνει εκεί είναι ο πυρήνας της προβολής."
          }
        }
      }
    },
    "크롬(제목·바·버튼)은 콘텐츠를 돕는 수단이지 주인공이 아님. **안 쓰는 순간에는 접히거나 사라져야** 함.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome (titles, bars, buttons) is a means of supporting the content, not the star. **When it's not in use, it should collapse or disappear.**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome (titles, bars, buttons) is a means of supporting the content, not the star. **When it's not in use, it should collapse or disappear.**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クローム（タイトル・バー・ボタン）はコンテンツを助ける手段であって、主役ではない。**使わない瞬間には折りたたまれるか、消えるべき**。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面框架（标题、栏、按钮）是帮助内容的手段，不是主角。**不用的时候应该折叠或消失。**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面框架（標題、列、按鈕）是幫助內容的手段，不是主角。**不用的時候應該摺疊或消失。**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хром (заголовки, панели, кнопки) - средство поддержки содержимого, а не главный герой. **Когда им не пользуются, он должен сворачиваться или исчезать.**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cromo (títulos, barras, botones) es un medio para apoyar el contenido, no el protagonista. **Cuando no se usa, debería colapsarse o desaparecer.**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome (Titel, Leisten, Buttons) ist ein Mittel, den Inhalt zu stützen, nicht der Star. **Wird es nicht genutzt, sollte es zusammenklappen oder verschwinden.**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chrome (titres, barres, boutons) est un moyen de soutenir le contenu, pas la vedette. **Quand il n'est pas utilisé, il devrait se replier ou disparaître.**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il chrome (titoli, barre, pulsanti) è un mezzo per sostenere il contenuto, non la star. **Quando non è in uso, dovrebbe comprimersi o sparire.**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O chrome (títulos, barras, botões) é um meio de sustentar o conteúdo, não a estrela. **Quando não está em uso, deve recolher ou sumir.**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนห่อหุ้ม (ชื่อเรื่อง แถบ ปุ่ม) เป็นวิธีสนับสนุนเนื้อหา ไม่ใช่พระเอก **เมื่อไม่ใช้ ควรยุบหรือหายไป**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khung giao diện (tiêu đề, thanh, nút) là phương tiện hỗ trợ nội dung, không phải ngôi sao. **Khi không dùng, nó nên thu lại hoặc biến mất.**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rámec (nadpisy, panely, tlačítka) je prostředek k podpoře obsahu, ne hvězda. **Když se nepoužívá, měl by se sbalit nebo zmizet.**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome (titler, bjælker, knapper) er et middel til at støtte indholdet, ikke stjernen. **Når det ikke er i brug, skal det folde sig sammen eller forsvinde.**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το chrome (τίτλοι, γραμμές, κουμπιά) είναι μέσο υποστήριξης του περιεχομένου, όχι ο πρωταγωνιστής. **Όταν δεν χρησιμοποιείται, πρέπει να συμπτύσσεται ή να εξαφανίζεται.**"
          }
        }
      }
    },
    "큰 iPhone 에서는 탭, 검색 캡슐, 미니 플레이어가 여유 있게 자리를 나눈다. 같은 앱을 SE급 작은 화면에서 열면 탭 라벨이 잘리고, 미니 플레이어의 곡 제목은 몇 글자만 남고, 콘텐츠가 보이는 높이가 눈에 띄게 줄어든다. 고정 높이로 띄운 시트는 아래쪽 버튼이 화면 밖으로 넘친다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a large iPhone, the tabs, search capsule, and mini player share the space comfortably. Open the same app on a small SE-class screen and the tab labels get truncated, the mini player's song title shrinks to a few characters, and the height where content is visible drops noticeably. A sheet presented at a fixed height spills its bottom buttons off the screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On a large iPhone, the tabs, search capsule, and mini player share the space comfortably. Open the same app on a small SE-class screen and the tab labels get truncated, the mini player's song title shrinks to a few characters, and the height where content is visible drops noticeably. A sheet presented at a fixed height spills its bottom buttons off the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きい iPhone では、タブ、検索カプセル、ミニプレーヤーがゆったりと場所を分け合う。同じアプリを SE クラスの小さい画面で開くと、タブのラベルが切れ、ミニプレーヤーの曲名は数文字しか残らず、コンテンツが見える高さが目に見えて減る。固定の高さで表示したシートは、下のボタンが画面の外にはみ出す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在大屏 iPhone 上，标签、搜索胶囊、迷你播放器从容地分着位置。同一个应用在 SE 级小屏幕上打开，标签文字被截断，迷你播放器的歌名只剩几个字，内容可见的高度明显减少。以固定高度弹出的弹层，下面的按钮溢出到屏幕外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在大屏 iPhone 上，標籤、搜尋膠囊、迷你播放器從容地分著位置。同一個應用程式在 SE 級小螢幕上開啟，標籤文字被截斷，迷你播放器的歌名只剩幾個字，內容可見的高度明顯減少。以固定高度彈出的工作表，下面的按鈕溢位到螢幕外。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На большом iPhone вкладки, капсула поиска и мини-плеер удобно делят место. Откройте то же приложение на маленьком экране класса SE, и подписи вкладок усекаются, название песни в мини-плеере сжимается до нескольких символов, а высота, на которой видно содержимое, заметно падает. Шторка, показанная с фиксированной высотой, роняет нижние кнопки за экран."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un iPhone grande, las pestañas, la cápsula de búsqueda y el minirreproductor comparten el espacio con holgura. Abre la misma app en una pantalla pequeña clase SE y las etiquetas de las pestañas se truncan, el título de la canción del minirreproductor se reduce a unos pocos caracteres, y la altura donde se ve el contenido baja notablemente. Una hoja presentada con altura fija deja los botones inferiores fuera de la pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem großen iPhone teilen sich Tabs, Suchkapsel und Miniplayer bequem den Platz. Öffnet man dieselbe App auf einem kleinen Bildschirm der SE-Klasse, werden die Tab-Beschriftungen abgeschnitten, der Songtitel des Miniplayers schrumpft auf ein paar Zeichen, und die Höhe, in der Inhalt sichtbar ist, sinkt spürbar. Ein Sheet mit fester Höhe lässt seine unteren Buttons aus dem Bildschirm laufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un grand iPhone, les onglets, la capsule de recherche et le mini-lecteur se partagent confortablement l'espace. Ouvrez la même app sur un petit écran de classe SE et les libellés d'onglets sont tronqués, le titre du morceau du mini-lecteur rétrécit à quelques caractères, et la hauteur où le contenu est visible baisse nettement. Une feuille présentée à hauteur fixe laisse ses boutons du bas déborder de l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un iPhone grande, schede, capsula di ricerca e mini player condividono lo spazio comodamente. Apri la stessa app su un piccolo schermo di classe SE e le etichette delle schede vengono troncate, il titolo del brano del mini player si riduce a pochi caratteri e l'altezza in cui il contenuto è visibile cala sensibilmente. Un foglio presentato a un'altezza fissa fa traboccare dallo schermo i pulsanti in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Num iPhone grande, as abas, a cápsula de busca e o mini player dividem o espaço com conforto. Abra o mesmo app numa tela pequena de classe SE e os rótulos das abas são truncados, o título da música do mini player encolhe para poucos caracteres e a altura em que o conteúdo é visível cai de forma notável. Uma folha apresentada a uma altura fixa derrama os botões inferiores para fora da tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน iPhone ใหญ่ แท็บ แคปซูลค้นหา และมินิเพลเยอร์ใช้พื้นที่ร่วมกันได้สบาย เปิดแอปเดียวกันบนหน้าจอเล็กระดับ SE ป้ายชื่อแท็บถูกตัด ชื่อเพลงของมินิเพลเยอร์หดเหลือไม่กี่ตัวอักษร และความสูงที่เนื้อหามองเห็นลดลงอย่างเห็นได้ชัด ชีตที่แสดงด้วยความสูงตายตัวทำให้ปุ่มล่างล้นออกนอกหน้าจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên iPhone lớn, các tab, capsule tìm kiếm và trình phát mini chia sẻ chỗ thoải mái. Mở cùng app trên màn hình nhỏ cỡ SE và nhãn tab bị cắt, tên bài hát của trình phát mini co còn vài ký tự, và chiều cao thấy được nội dung giảm rõ rệt. Một sheet hiện ở chiều cao cố định làm các nút dưới tràn khỏi màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na velkém iPhonu spolu karty, kapsle hledání a mini přehrávač pohodlně sdílejí místo. Otevřete stejnou aplikaci na malé obrazovce třídy SE a popisky karet se ořežou, název písně v mini přehrávači se zmenší na pár znaků a výška, kde je obsah vidět, citelně klesne. Sheet zobrazený v pevné výšce vysype spodní tlačítka mimo obrazovku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På en stor iPhone deler fanerne, søgekapslen og miniafspilleren pladsen behageligt. Åbn den samme app på en lille SE-klasse skærm, og fanemærkaterne bliver afkortet, miniafspillerens sangtitel skrumper til nogle få tegn, og den højde, hvor indholdet er synligt, falder mærkbart. Et ark vist i fast højde spilder sine nederste knapper ud over skærmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε μεγάλο iPhone, οι καρτέλες, η κάψουλα αναζήτησης και ο μίνι player μοιράζονται άνετα τον χώρο. Άνοιξε την ίδια εφαρμογή σε μικρή οθόνη κλάσης SE και οι ετικέτες των καρτελών περικόπτονται, ο τίτλος τραγουδιού του μίνι player σμικρύνεται σε λίγους χαρακτήρες, και το ύψος όπου φαίνεται το περιεχόμενο πέφτει αισθητά. Ένα φύλλο που παρουσιάζεται με σταθερό ύψος χύνει τα κάτω κουμπιά του εκτός οθόνης."
          }
        }
      }
    },
    "큰 글씨 설정에서 한 번 연다. 시스템 헤더가 공짜로 해주던 일이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it once with a large text setting. It's work the system header used to do for free."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it once with a large text setting. It's work the system header used to do for free."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな文字の設定で一度開いてみる。システムのヘッダがタダでやってくれていた仕事だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在大字号设置下打开一次。这是系统标题区免费替你做的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在大字號設定下開啟一次。這是系統標題區免費替你做的事。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте один раз с настройкой крупного текста. Это работа, которую системная шапка раньше делала бесплатно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrelo una vez con un ajuste de texto grande. Es trabajo que el encabezado del sistema solía hacer gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne es einmal mit einer großen Texteinstellung. Es ist Arbeit, die der System-Header sonst gratis erledigte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez-le une fois avec un grand réglage de texte. C'est un travail que l'en-tête système faisait gratuitement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprilo una volta con un'impostazione di testo grande. È un lavoro che l'intestazione di sistema faceva gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma vez com um ajuste de texto grande. É um trabalho que o cabeçalho do sistema fazia de graça."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดสักครั้งด้วยการตั้งค่าตัวอักษรใหญ่ เป็นงานที่ส่วนหัวของระบบเคยทำให้ฟรี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở một lần với cài đặt chữ lớn. Đó là việc header hệ thống từng làm miễn phí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete to jednou s nastavením velkého textu. Je to práce, kterou systémová hlavička dělala zdarma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn den én gang med en stor tekstindstilling. Det er arbejde, systemheaderen plejede at gøre gratis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξέ το μία φορά με ρύθμιση μεγάλου κειμένου. Είναι δουλειά που έκανε δωρεάν η κεφαλίδα του συστήματος."
          }
        }
      }
    },
    "큰 글씨에서 깨짐": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It breaks at large text sizes"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It breaks at large text sizes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな文字で崩れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在大字号下崩坏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在大字號下崩壞"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ломается при крупных размерах текста"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rompe con tamaños de texto grandes"
          }
        },
        "de": {
