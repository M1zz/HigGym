            "value": "Miniatura de foto → visualizador em tela cheia"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพย่อรูปถ่าย → ตัวดูเต็มหน้าจอ"
          }
        },
        "vi": {
