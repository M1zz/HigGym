          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca prende **lo slot del titolo (centro)**, per quando «questa schermata = ricerca»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca ocupa **o lugar do título (centro)**, para quando «esta tela = busca»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหายึด**ช่องชื่อเรื่อง (กึ่งกลาง)** สำหรับเมื่อ “หน้าจอนี้ = การค้นหา”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm chiếm **ô tiêu đề (giữa)**, cho khi “màn hình này = tìm kiếm”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání zabere **místo nadpisu (střed)**, pro případ „tato obrazovka = hledání“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søg tager **titelpladsen (midten)**, når »denne skærm = søgning«"
