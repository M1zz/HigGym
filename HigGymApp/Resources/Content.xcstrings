    },
    "시스템 2단으로 충분한데 픽셀 미세조정에 집착": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsessing over pixel-level tweaks when the two system steps would do"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsessing over pixel-level tweaks when the two system steps would do"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの2段階で足りるのに、ピクセル単位の微調整にこだわる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统两档就够了，却执着于像素微调"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統兩檔就夠了，卻執著於畫素微調"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одержимость пиксельной подгонкой, когда хватило бы двух системных ступеней"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsesionarse con retoques a nivel de píxel cuando bastarían los dos escalones del sistema"
          }
        }
      }
    },
    "시스템 검색바를 다른 툴바 아이템들과 **한 툴바 체계 안에 통합**, 자리 확보·분리·축소를 조합.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system search bar **integrated into one toolbar system** with the other toolbar items, combining slot reservation, separation, and minimization."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system search bar **integrated into one toolbar system** with the other toolbar items, combining slot reservation, separation, and minimisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの検索バーをほかのツールバーアイテムと**ひとつのツールバー体系の中に統合**。位置の確保・分離・縮小を組み合わせる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把系统搜索栏与其他工具栏项目**整合进同一套工具栏体系**，组合了留位 · 分离 · 缩小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把系統搜尋列與其他工具列項目**整合進同一套工具列體系**，組合了留位 · 分離 · 縮小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная строка поиска, **интегрированная в одну систему панели инструментов** с остальными элементами панели, сочетающая резервирование места, разделение и минимизацию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de búsqueda del sistema **integrada en un único sistema de barra de herramientas** con los demás elementos de la barra, combinando reserva de hueco, separación y minimización."
          }
        }
      }
    },
    "시스템 규약 이탈": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaks the system convention"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaks the system convention"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのお約束から外れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏离系统约定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偏離系統約定"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарушает системное соглашение"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompe la convención del sistema"
          }
        }
      }
    },
    "시스템 내비게이션 바를 쓰지 않는 화면에서 **자체 헤더**가 필요할 때, 브랜드 디자인이 강한 앱, 특수 레이아웃의 홈 화면.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a screen that doesn't use the system navigation bar needs **its own header**: apps with a strong brand design, home screens with special layouts."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a screen that doesn't use the system navigation bar needs **its own header**: apps with a strong brand design, home screens with special layouts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーを使わない画面で**独自のヘッダー**が必要なとき。ブランドデザインの強いアプリ、特殊なレイアウトのホーム画面など。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不使用系统导航栏的界面里需要**自有标题区**时：品牌设计很强的应用、特殊布局的首页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在不使用系統導覽列的介面裡需要**自有標題區**時：品牌設計很強的應用程式、特殊佈局的首頁。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда экрану, не использующему системную панель навигации, нужен **собственный заголовок**: приложения с сильным дизайном бренда, главные экраны со специальной раскладкой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una pantalla que no usa la barra de navegación del sistema necesita **su propio encabezado**: apps con un fuerte diseño de marca, pantallas de inicio con un diseño especial."
          }
        }
      }
    },
    "시스템 내비바는 Dynamic Type 대응과 스크롤 시 제목 축소를 **공짜로** 해 주고 있었다. `safeAreaBar`로 옮기면 인셋과 가장자리 효과는 시스템이 대지만 그 공짜 기능은 따라오지 않는다. 고정 크기 헤더는 글자가 변한다는 사실을 계산에 넣지 않은 레이아웃이다. 잘림이 안전장치가 아니라 기본 결과가 됐다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system navigation bar was handling Dynamic Type and shrinking the title on scroll **for free**. Move to `safeAreaBar`, and the system still supplies the inset and edge effect, but those free features don't come along. A fixed-size header is a layout that never accounted for text changing size. Truncation became the default outcome instead of a safety net."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system navigation bar was handling Dynamic Type and shrinking the title on scroll **for free**. Move to `safeAreaBar`, and the system still supplies the inset and edge effect, but those free features don't come along. A fixed-size header is a layout that never accounted for text changing size. Truncation became the default outcome instead of a safety net."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーは、Dynamic Typeへの対応とスクロール時のタイトル縮小を**タダで**やってくれていた。`safeAreaBar`に移すと、インセットとエッジエフェクトはシステムが用意してくれるが、そのタダの機能はついてこない。固定サイズのヘッダは、文字が変わるという事実を計算に入れていないレイアウトだ。切り詰めが安全装置ではなく、当たり前の結果になってしまった。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统导航栏本来**免费**提供了 Dynamic Type 适配和滚动时标题缩小。换成 `safeAreaBar` 后，内边距和边缘效果系统会给，但那些免费功能不会跟来。固定尺寸的标题区，是没把文字会变化这件事算进去的布局。截断不再是安全装置，而成了默认结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統導覽列本來**免費**提供了 Dynamic Type 適配和滾動時標題縮小。換成 `safeAreaBar` 後，內邊距和邊緣效果系統會給，但那些免費功能不會跟來。固定尺寸的標題區，是沒把文字會變化這件事算進去的佈局。截斷不再是安全裝置，而成了預設結果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная панель навигации **бесплатно** справлялась с Dynamic Type и сжатием заголовка при прокрутке. Перейдёте на `safeAreaBar`, и система всё ещё даёт отступ и эффект края, но эти бесплатные возможности не следуют. Заголовок фиксированного размера - это макет, который не учёл, что текст меняет размер. Обрезка стала результатом по умолчанию, а не страховкой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de navegación del sistema se ocupaba **gratis** de Dynamic Type y de reducir el título al desplazar. Pasa a `safeAreaBar` y el sistema sigue aportando el margen y el efecto de borde, pero esas funciones gratuitas no vienen incluidas. Un encabezado de tamaño fijo es un diseño que nunca tuvo en cuenta que el texto cambia de tamaño. El truncamiento pasó a ser el resultado por defecto en lugar de una red de seguridad."
          }
        }
      }
    },
    "시스템 내비바로 돌아가고 상단 아이템 수를 줄인다. 일부는 하단 툴바로, 드문 것은 ⋯ 안으로 보낸다. 남는 것 중 무엇이 먼저 접힐지 순서를 설계한다. 버튼은 제 크기를 되찾고, 회전과 큰 글씨는 시스템이 다시 맡는다. 1.2.4 Inline with 5 Toolbar Items 예제를 열어 시스템이 제목과 아이템 사이에서 공간을 어떻게 나누는지 직접 보라.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to the system navigation bar and reduce the number of top items. Move some to the bottom toolbar and send rarely used ones into ⋯. Design the order in which the remaining ones fold. The buttons get their proper size back, and the system takes over rotation and larger text again. Open the 1.2.4 Inline with 5 Toolbar Items example and see for yourself how the system divides space between the title and the items."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to the system navigation bar and reduce the number of top items. Move some to the bottom toolbar and send rarely used ones into ⋯. Design the order in which the remaining ones fold. The buttons get their proper size back, and the system takes over rotation and larger text again. Open the 1.2.4 Inline with 5 Toolbar Items example and see for yourself how the system divides space between the title and the items."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーに戻し、上部のアイテム数を減らす。一部は下部のツールバーへ、まれにしか使わないものは ⋯ の中へ送る。残ったもののうち、どれから先に折りたたまれるかの順番を設計する。ボタンは本来のサイズを取り戻し、回転や大きな文字は再びシステムが引き受ける。1.2.4 Inline with 5 Toolbar Items の例を開いて、システムがタイトルとアイテムの間でスペースをどう分けるかを自分の目で見てみよう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到系统导航栏，并减少顶部项目数量。一部分移到底部工具栏，少用的放进 ⋯。剩下的东西里，设计好哪个先被折叠的顺序。按钮恢复了本来的大小，旋转和大字号重新交给系统。打开 1.2.4 Inline with 5 Toolbar Items 示例，亲眼看系统是如何在标题与项目之间分配空间的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到系統導覽列，並減少頂部項目數量。一部分移到底部工具列，少用的放進 ⋯。剩下的東西里，設計好哪個先被摺疊的順序。按鈕恢復了本來的大小，旋轉和大字號重新交給系統。開啟 1.2.4 Inline with 5 Toolbar Items 示例，親眼看系統是如何在標題與項目之間分配空間的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь к системной панели навигации и сократите число верхних элементов. Часть перенесите в нижнюю панель инструментов, а редко используемые отправьте в ⋯. Продумайте порядок, в котором оставшиеся сворачиваются. Кнопки возвращают себе нужный размер, а поворот и крупный текст снова берёт на себя система. Откройте пример 1.2.4 Inline with 5 Toolbar Items и посмотрите сами, как система делит место между заголовком и элементами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a la barra de navegación del sistema y reduce el número de elementos de arriba. Pasa algunos a la barra de herramientas inferior y manda los poco usados a ⋯. Diseña el orden en que se pliegan los restantes. Los botones recuperan su tamaño adecuado, y el sistema vuelve a encargarse de la rotación y del texto más grande. Abre el ejemplo 1.2.4 Inline with 5 Toolbar Items y comprueba tú mismo cómo reparte el sistema el espacio entre el título y los elementos."
          }
        }
      }
    },
    "시스템 내비바로는 안 되는 **상단 상시 UI**, 필터 칩 줄, 동기화 상태 배너, 커스텀 헤더처럼 콘텐츠 위에 늘 떠 있어야 하는 것.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Persistent top UI** the system navigation bar can't provide, things that must always float above the content: a row of filter chips, a sync status banner, a custom header."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Persistent top UI** the system navigation bar can't provide, things that must always float above the content: a row of filter chips, a sync status banner, a custom header."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーでは実現できない**上部の常設UI**。フィルタチップの列、同期状態のバナー、カスタムヘッダーのように、常にコンテンツの上に浮かんでいるべきもの。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统导航栏做不到的**顶部常驻 UI**：筛选标签行、同步状态横幅、自定义标题区这类必须始终浮在内容之上的东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統導覽列做不到的**頂部常駐 UI**：篩選標籤行、同步狀態橫幅、自定義標題區這類必須始終浮在內容之上的東西。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Постоянный верхний интерфейс**, который системная панель навигации дать не может, то, что должно всегда парить над контентом: ряд чипов-фильтров, баннер состояния синхронизации, пользовательский заголовок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Interfaz superior permanente** que la barra de navegación del sistema no puede ofrecer, cosas que deben flotar siempre sobre el contenido: una fila de chips de filtro, un banner de estado de sincronización, un encabezado personalizado."
          }
        }
      }
    },
    "시스템 내비바를 버리면 제목 배치·인셋·가장자리 효과를 전부 직접 구현해야 했습니다, safeAreaBar는 그 **인프라(인셋+효과)는 시스템이 대고, 내용만 앱이 채우는** 절충안. 완전 커스텀과 시스템 동작 사이의 중간 지대.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropping the system navigation bar used to mean building title placement, insets and edge effects all yourself. safeAreaBar is the compromise where **the system provides the infrastructure (inset + effects) and the app supplies only the content**. A middle ground between fully custom and system behavior."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropping the system navigation bar used to mean building title placement, insets and edge effects all yourself. safeAreaBar is the compromise where **the system provides the infrastructure (inset + effects) and the app supplies only the content**. A middle ground between fully custom and system behaviour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーを捨てると、タイトルの配置・インセット・エッジエフェクトをすべて自前で実装する必要がありました。safeAreaBarは、その**インフラ（インセット＋エフェクト）はシステムが用意し、中身だけをアプリが埋める**折衷案。完全なカスタムとシステムの動作の中間地帯。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抛开系统导航栏，标题布局 · 内边距 · 边缘效果就得全部自己实现。safeAreaBar 是**基础设施（内边距 + 效果）由系统提供，只有内容由应用填充**的折中方案。是完全自定义与系统行为之间的中间地带。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拋開系統導覽列，標題佈局 · 內邊距 · 邊緣效果就得全部自己實作。safeAreaBar 是**基礎設施（內邊距 + 效果）由系統提供，只有內容由應用程式填充**的折中方案。是完全自定義與系統行為之間的中間地帶。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказ от системной панели навигации раньше означал самостоятельную реализацию расположения заголовка, отступов и эффектов края. safeAreaBar - компромисс, где **инфраструктуру (отступ + эффекты) даёт система, а содержимое - только приложение**. Середина между полностью пользовательским и системным поведением."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prescindir de la barra de navegación del sistema solía significar construir tú mismo la colocación del título, los márgenes y los efectos de borde. safeAreaBar es el compromiso en el que **el sistema aporta la infraestructura (margen + efectos) y la app aporta solo el contenido**. Un término medio entre lo totalmente personalizado y el comportamiento del sistema."
          }
        }
      }
    },
    "시스템 내비바에 넣으면 셋만 남고 둘이 ⋯ 안으로 접힌다. 접힌 것은 안 보이니 안 쓰일 것 같다. 커스텀으로 만들면 다섯을 다 보여 줄 수 있고, 평상시 모습을 흉내 내는 건 어렵지 않다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put them in the system navigation bar and only three remain, with two folded into ⋯. Anything folded away is out of sight, so it seems like it won't get used. A custom bar can show all five, and mimicking the usual look isn't hard."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put them in the system navigation bar and only three remain, with two folded into ⋯. Anything folded away is out of sight, so it seems like it won't get used. A custom bar can show all five, and mimicking the usual look isn't hard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーに入れると3つだけが残り、2つは ⋯ の中に折りたたまれる。折りたたまれたものは見えないから、使われなさそうに思える。カスタムで作れば5つとも見せられるし、普段の見た目を真似るのは難しくない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放进系统导航栏的话，只剩三个，两个被折叠进 ⋯。被折叠的看不见，似乎就不会被用。自定义的话，五个都能显示，模仿平常的样子也不难。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放進系統導覽列的話，只剩三個，兩個被摺疊進 ⋯。被摺疊的看不見，似乎就不會被用。自定義的話，五個都能顯示，模仿平常的樣子也不難。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положите их в системную панель навигации, и останутся только три, а два свернутся в ⋯. Свёрнутое вне поля зрения, поэтому кажется, что им не станут пользоваться. Пользовательская панель может показать все пять, а подражать привычному виду нетрудно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponlos en la barra de navegación del sistema y solo quedan tres, con dos plegados en ⋯. Lo plegado queda fuera de la vista, así que parece que no se usará. Una barra personalizada puede mostrar los cinco, e imitar el aspecto habitual no es difícil."
          }
        }
      }
    },
    "시스템 내비바와 커스텀 타이틀 바를 동시에": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the system navigation bar and a custom title bar at the same time"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the system navigation bar and a custom title bar at the same time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーとカスタムのタイトルバーを同時に使う"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时用系统导航栏和自定义标题栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時用系統導覽列和自定義標題列"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременное использование системной панели навигации и пользовательской панели заголовка"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar a la vez la barra de navegación del sistema y una barra de título personalizada"
          }
        }
      }
    },
    "시스템 내비바와 커스텀 헤더를 동시에 띄운다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing both the system navigation bar and a custom header"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing both the system navigation bar and a custom header"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーとカスタムヘッダを同時に表示する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时显示系统导航栏和自定义标题区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時顯示系統導覽列和自定義標題區"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременный показ системной панели навигации и пользовательского заголовка"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a la vez la barra de navegación del sistema y un encabezado personalizado"
          }
        }
      }
    },
    "시스템 내비바의 공짜 기능(스크롤 시 제목 축소, Dynamic Type 대응)은 따라오지 않습니다, 큰 글씨 설정에서 헤더가 깨지는지 직접 확인하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't get the system navigation bar's free features (the title shrinking on scroll, Dynamic Type support). Check for yourself that the header doesn't break at large text sizes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't get the system navigation bar's free features (the title shrinking on scroll, Dynamic Type support). Check for yourself that the header doesn't break at large text sizes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーにタダで付いてくる機能（スクロール時のタイトル縮小、Dynamic Type対応）は付いてきません。大きな文字サイズの設定でヘッダーが崩れないか、自分で確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统导航栏的免费功能（滚动时标题缩小、Dynamic Type 适配）不会跟来，请亲自确认大字号设置下标题区是否崩坏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統導覽列的免費功能（滾動時標題縮小、Dynamic Type 適配）不會跟來，請親自確認大字號設定下標題區是否崩壞。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатные возможности системной панели навигации (сжатие заголовка при прокрутке, поддержка Dynamic Type) не приходят. Убедитесь сами, что заголовок не ломается при крупных размерах текста."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No recibes las funciones gratuitas de la barra de navegación del sistema (el título que se encoge al desplazar, la compatibilidad con Dynamic Type). Comprueba tú mismo que el encabezado no se rompe con tamaños de texto grandes."
          }
        }
      }
    },
    "시스템 동작이 거슬릴 때 끄기 전에 묻는다. \"이 움직임은 무엇을 말하려던 걸까?\" 답을 찾으면 대개 끌 이유가 사라진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a system behavior bothers you, ask before turning it off: \"What was this motion trying to say?\" Once you find the answer, the reason to turn it off usually goes away."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a system behaviour bothers you, ask before turning it off: \"What was this motion trying to say?\" Once you find the answer, the reason to turn it off usually goes away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの動作が気になったら、オフにする前に問う。「この動きは何を伝えようとしていたのか？」 答えが見つかれば、たいていオフにする理由はなくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统行为让人别扭、想关掉之前先问：“这个动效原本想说什么？”找到答案，通常就没有关掉的理由了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統行為讓人彆扭、想關掉之前先問：「這個動效原本想說什麼？」找到答案，通常就沒有關掉的理由了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда системное поведение мешает, спросите, прежде чем отключать: «Что это движение пыталось сказать?» Найдёте ответ - и причина отключать обычно пропадает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un comportamiento del sistema te moleste, pregunta antes de desactivarlo: «¿Qué intentaba decir este movimiento?» Una vez que encuentras la respuesta, el motivo para desactivarlo suele desaparecer."
          }
        }
      }
    },
    "시스템 바 자리에 광고·프로모션을 얹는다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Placing ads and promotions where the system bars go"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Placing ads and promotions where the system bars go"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのバーの場所に、広告やプロモーションを載せる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统栏的位置放广告 · 促销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統列的位置放廣告 · 促銷"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещение рекламы и акций там, где стоят системные панели"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar anuncios y promociones donde van las barras del sistema"
          }
        }
      }
    },
    "시스템 바를 다시 만드는 순간 접근성·회전·Dynamic Type을 전부 떠안는다. 개수를 줄인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moment you rebuild a system bar, accessibility, rotation, and Dynamic Type all become your problem. Cut down the number of items."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The moment you rebuild a system bar, accessibility, rotation, and Dynamic Type all become your problem. Cut down the number of items."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのバーを作り直した瞬間、アクセシビリティ、回転、Dynamic Type をすべて自分で抱え込む。数を減らす。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦重做系统栏，无障碍、旋转、Dynamic Type 就全要自己扛。减少数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦重做系統列，無障礙、旋轉、Dynamic Type 就全要自己扛。減少數量。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В момент, когда вы переделываете системную панель, универсальный доступ, поворот и Dynamic Type становятся вашей проблемой. Сократите число элементов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el momento en que reconstruyes una barra del sistema, la accesibilidad, la rotación y Dynamic Type pasan a ser problema tuyo. Reduce el número de elementos."
          }
        }
      }
    },
    "시스템 요소를 커스텀으로 바꿀 때마다 묻는다. **\"시스템이 공짜로 해 주던 일 중 무엇을 내가 떠안았나?\"**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every time you replace a system element with a custom one, ask: **\"What work that the system did for free have I now taken on?\"**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Every time you replace a system element with a custom one, ask: **\"What work that the system did for free have I now taken on?\"**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの要素をカスタムに置き換えるたびに問う。**「システムがタダでやってくれていた仕事のうち、何を自分が引き受けたのか」**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次把系统元素换成自定义时都要问：**“系统免费替我做的事，有哪些现在得我自己扛？”**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次把系統元素換成自定義時都要問：**「系統免費替我做的事，有哪些現在得我自己扛？」**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раз, заменяя системный элемент пользовательским, спрашивайте: **«Какую работу, которую система делала бесплатно, я теперь взял на себя?»**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que sustituyas un elemento del sistema por uno personalizado, pregunta: **«¿Qué trabajo que el sistema hacía gratis he asumido ahora?»**"
          }
        }
      }
    },
    "시스템 자리를 꾸미고 싶을 때는 **모양이 아니라 약속을 빌리고 있는지** 확인한다. 약속은 role 선언 하나로 온다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you want to decorate a system spot, check **whether you're borrowing the promise, not just the shape**. The promise comes with a single role declaration."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you want to decorate a system spot, check **whether you're borrowing the promise, not just the shape**. The promise comes with a single role declaration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの場所を飾りたくなったら、**形ではなく約束を借りているか**を確かめる。約束は role の宣言ひとつでついてくる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想装饰系统位置时，先确认借的是**约定而不是外形**。约定只需声明一个 role 就来了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想裝飾系統位置時，先確認借的是**約定而不是外形**。約定只需宣告一個 role 就來了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда хочется украсить системное место, проверьте, **заимствуете ли вы обещание, а не только форму**. Обещание приходит с одним объявлением роли."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando quieras decorar un sitio del sistema, comprueba **si estás tomando prestada la promesa, no solo la forma**. La promesa viene con una única declaración de rol."
          }
        }
      }
    },
    "시스템 컨트롤을 다시 그리고 싶어지면 **모양과 함께 무엇을 버리게 되는지** 목록부터 적는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you feel like redrawing a system control, start by listing **what you'd be throwing away along with the look**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you feel like redrawing a system control, start by listing **what you'd be throwing away along with the look**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのコントロールを描き直したくなったら、まず**見た目と一緒に何を捨てることになるか**をリストに書き出す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想重画系统控件时，先写下**与外形一起会丢掉什么**的清单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想重畫系統控制元件時，先寫下**與外形一起會丟掉什麼**的清單。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда хочется перерисовать системный элемент управления, начните с перечня **того, что вы выбросите вместе с внешним видом**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te apetezca redibujar un control del sistema, empieza por enumerar **lo que tirarías junto con el aspecto**."
          }
        }
      }
    },
    "시스템 컴포넌트를 다시 만들기 전에 묻는다. **\"그것이 대신 해 주던 일을 전부 셀 수 있는가?\"** 그리고 상단에 다섯이 필요하다는 것 자체가 설계를 다시 보라는 신호다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before rebuilding a system component, ask: **\"Can I list every job it was doing for me?\"** And needing five items at the top is itself a sign to revisit the design."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before rebuilding a system component, ask: **\"Can I list every job it was doing for me?\"** And needing five items at the top is itself a sign to revisit the design."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのコンポーネントを作り直す前に問う。**「それが代わりにやってくれていた仕事を、すべて数え上げられるか？」** そもそも上部に5つ必要だということ自体が、設計を見直せというサインだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重做系统组件之前先问：**“能把它原本替我做的事全数出来吗？”**而且，顶部需要五个本身就是该重新审视设计的信号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重做系統元件之前先問：**「能把它原本替我做的事全數出來嗎？」**而且，頂部需要五個本身就是該重新審視設計的訊號。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем переделывать системный компонент, спросите: **«Могу ли я перечислить все задачи, которые он за меня выполнял?»** А нужда в пяти элементах вверху сама - повод пересмотреть дизайн."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de reconstruir un componente del sistema, pregunta: **«¿Puedo enumerar todos los trabajos que hacía por mí?»** Y necesitar cinco elementos arriba es en sí una señal para revisar el diseño."
          }
        }
      }
    },
    "시스템 탭바가 원하는 모양이 아니다. 가운데 칸을 크게 만들고 싶거나 브랜드 색을 채우고 싶다. 시스템 것을 숨기고 직접 그리면 모양을 마음대로 할 수 있고, 겉보기에는 사용자에게 달라지는 게 없어 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system tab bar doesn't look the way you want. You want to make the center slot bigger or fill it with your brand color. If you hide the system one and draw your own, you can shape it however you like, and on the surface nothing seems to change for users."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system tab bar doesn't look the way you want. You want to make the centre slot bigger or fill it with your brand colour. If you hide the system one and draw your own, you can shape it however you like, and on the surface nothing seems to change for users."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのタブバーが思いどおりの見た目ではない。真ん中のタブを大きくしたい、ブランドカラーで塗りたい。システムのものを隠して自分で描けば形を自由にでき、見た目の上ではユーザーにとって何も変わらないように思える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统标签栏不是想要的样子。想把中间一格做大，或者想填上品牌色。把系统的藏起来、自己画，外形就能随心所欲，而且表面上看，用户那边好像没什么变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統標籤列不是想要的樣子。想把中間一格做大，或者想填上品牌色。把系統的藏起來、自己畫，外形就能隨心所欲，而且表面上看，使用者那邊好像沒什麼變化。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная панель вкладок выглядит не так, как вам хочется. Вы хотите сделать центральную ячейку больше или залить её фирменным цветом. Если скрыть системную и нарисовать свою, можно придать ей любую форму, и на поверхности для пользователей ничего не меняется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas del sistema no se ve como quieres. Quieres hacer más grande el hueco central o rellenarlo con el color de tu marca. Si ocultas la del sistema y dibujas la tuya, puedes darle la forma que quieras, y en la superficie nada parece cambiar para los usuarios."
          }
        }
      }
    },
    "시스템 탭바가 원하는 모양이 아니어서 직접 만든다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system tab bar doesn't look the way you want, so you build your own."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system tab bar doesn't look the way you want, so you build your own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのタブバーが思いどおりの見た目ではないので、自分で作る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统标签栏不是想要的样子，所以自己做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統標籤列不是想要的樣子，所以自己做。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная панель вкладок выглядит не так, как вам хочется, поэтому вы делаете свою."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas del sistema no se ve como quieres, así que haces la tuya."
          }
        }
      }
    },
    "시스템 툴바보다 눈에 띄고 브랜드 색을 입히기도 좋아 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stands out more than the system toolbar and seems like a better canvas for the brand color."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It stands out more than the system toolbar and seems like a better canvas for the brand colour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのツールバーより目立ち、ブランドカラーも乗せやすそうに見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比系统工具栏更显眼，也好上品牌色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比系統工具列更顯眼，也好上品牌色。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она заметнее системной панели инструментов и кажется лучшим холстом для фирменного цвета."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca más que la barra de herramientas del sistema y parece un mejor lienzo para el color de marca."
          }
        }
      }
    },
    "시스템 툴바의 버튼은 작고 차분해서 덜 눈에 띈다. 떠 있는 원은 크고, 브랜드 색을 입히기 좋고, 화면의 주인공처럼 보인다. 유일한 액션이니 가장 눈에 띄게 만드는 게 친절해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons in the system toolbar are small and understated, so they stand out less. A floating circle is big, easy to dress in the brand color, and looks like the star of the screen. Since it's the only action, making it as visible as possible seems like the considerate thing to do."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons in the system toolbar are small and understated, so they stand out less. A floating circle is big, easy to dress in the brand colour, and looks like the star of the screen. Since it's the only action, making it as visible as possible seems like the considerate thing to do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのツールバーのボタンは小さく控えめなので、あまり目立たない。浮かんだ丸は大きく、ブランドカラーも乗せやすく、画面の主役のように見える。唯一のアクションなのだから、いちばん目立たせるのが親切に思える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统工具栏的按钮小而沉稳，不太显眼。悬浮的圆形大，好上品牌色，看起来像界面的主角。既然是唯一的操作，做得最显眼似乎才友好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統工具列的按鈕小而沉穩，不太顯眼。懸浮的圓形大，好上品牌色，看起來像介面的主角。既然是唯一的操作，做得最顯眼似乎才友好。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки системной панели инструментов маленькие и сдержанные, поэтому менее заметные. Парящий круг большой, его легко одеть в фирменный цвет, и он выглядит главным героем экрана. Раз действие единственное, сделать его как можно заметнее кажется заботливым."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones de la barra de herramientas del sistema son pequeños y discretos, así que destacan menos. Un círculo flotante es grande, fácil de vestir con el color de marca, y parece el protagonista de la pantalla. Como es la única acción, hacerla lo más visible posible parece lo considerado."
          }
        }
      }
    },
    "시스템의 제목 메뉴(`toolbarTitleMenu`)를 써서 제목 옆에 ⌄ 표시가 붙게 둔다. 제목은 여전히 화면의 이름을 말하고, 동시에 \"눌러서 바꿀 수 있는 대상\"이라는 것도 말한다. 폴더를 바꾸려는 사람은 툴바를 뒤지지 않고 제목을 누른다. 1.2.5 Inline with Toolbar Title Menu 예제를 열어 표시가 붙은 제목이 어떻게 보이는지 확인해 보라. 표시 하나가 화면을 어지럽히지 않는다는 것도 함께 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the system title menu (`toolbarTitleMenu`) and let it attach the ⌄ next to the title. The title still names the screen, and at the same time says it's \"something you can tap to change.\" People who want to switch folders tap the title instead of digging through the toolbar. Open the 1.2.5 Inline with Toolbar Title Menu example to see how a title with the indicator looks. You'll also see that one small indicator doesn't clutter the screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the system title menu (`toolbarTitleMenu`) and let it attach the ⌄ next to the title. The title still names the screen, and at the same time says it's \"something you can tap to change.\" People who want to switch folders tap the title instead of digging through the toolbar. Open the 1.2.5 Inline with Toolbar Title Menu example to see how a title with the indicator looks. You'll also see that one small indicator doesn't clutter the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのタイトルメニュー（`toolbarTitleMenu`）を使い、タイトルの横に ⌄ が付くようにする。タイトルは引き続き画面の名前を伝え、同時に「押して切り替えられる対象」であることも伝える。フォルダを変えたい人はツールバーを探し回らず、タイトルを押す。1.2.5 Inline with Toolbar Title Menu の例を開いて、表示の付いたタイトルがどう見えるかを確かめてみよう。表示ひとつで画面が散らからないことも一緒に分かる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用系统的标题菜单（`toolbarTitleMenu`），让标题旁出现 ⌄ 标记。标题仍然在说界面的名字，同时也在说它是“点按可以更换的对象”。想换文件夹的人不用翻工具栏，直接点标题。打开 1.2.5 Inline with Toolbar Title Menu 示例，看看带标记的标题是什么样。也能同时看到，一个标记不会弄乱界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用系統的標題選單（`toolbarTitleMenu`），讓標題旁出現 ⌄ 標記。標題仍然在說介面的名字，同時也在說它是「輕點可以更換的物件」。想換資料夾的人不用翻工具列，直接點標題。開啟 1.2.5 Inline with Toolbar Title Menu 示例，看看帶標記的標題是什麼樣。也能同時看到，一個標記不會弄亂介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте системное меню заголовка (`toolbarTitleMenu`) и позвольте ему поставить ⌄ рядом с заголовком. Заголовок по-прежнему называет экран и одновременно говорит, что это «то, что можно нажать, чтобы изменить». Те, кто хочет сменить папку, нажимают на заголовок, а не роются в панели инструментов. Откройте пример 1.2.5 Inline with Toolbar Title Menu, чтобы увидеть, как выглядит заголовок с индикатором. Вы также увидите, что один небольшой индикатор экран не загромождает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el menú de título del sistema (`toolbarTitleMenu`) y deja que añada el ⌄ junto al título. El título sigue nombrando la pantalla y a la vez dice que es «algo que puedes tocar para cambiar». Quienes quieren cambiar de carpeta tocan el título en lugar de rebuscar en la barra de herramientas. Abre el ejemplo 1.2.5 Inline with Toolbar Title Menu para ver cómo luce un título con el indicador. También verás que un pequeño indicador no satura la pantalla."
          }
        }
      }
    },
    "시스템이 맞춰 주는 것은 **자리**이지 **내용**이 아니다. 좁은 폭에서 탭 라벨과 액세서리 안의 글자가 어떻게 줄어들지는 앱이 결정해야 하고, 결정하지 않으면 잘림이 대신 결정한다. 고정 px 높이는 기기가 작거나 Dynamic Type 이 커지면 내용보다 작아진다. 두 경우 모두 **큰 화면에서는 보이지 않는 문제**라서, 작은 화면에서 한 번 열어 보지 않으면 만날 일이 없다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system adjusts is **the placement**, not **the content**. How the text in the tab labels and the accessory shrinks at narrow widths is for the app to decide, and if it doesn't decide, truncation decides instead. A fixed pixel height ends up smaller than the content when the device is small or Dynamic Type is large. Both are **problems you can't see on a large screen**, so unless you open the app once on a small screen, you'll never run into them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system adjusts is **the placement**, not **the content**. How the text in the tab labels and the accessory shrinks at narrow widths is for the app to decide, and if it doesn't decide, truncation decides instead. A fixed pixel height ends up smaller than the content when the device is small or Dynamic Type is large. Both are **problems you can't see on a large screen**, so unless you open the app once on a small screen, you'll never run into them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが合わせてくれるのは**場所**であって**中身**ではない。狭い幅でタブのラベルやアクセサリの中の文字がどう縮むかはアプリが決めなければならず、決めなければ切り詰めが代わりに決める。固定 px の高さは、端末が小さかったり Dynamic Type が大きくなったりすると、コンテンツより小さくなる。どちらも**大きい画面では見えない問題**なので、小さい画面で一度開いてみなければ出会うことがない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统帮你对齐的是**位置**，不是**内容**。在窄宽度下，标签文字和附件内的文字怎样缩减，要由应用来决定，不决定的话，由截断代为决定。固定 px 高度在设备较小或 Dynamic Type 变大时，会比内容还小。两种情况都是**在大屏幕上看不出的问题**，所以不在小屏幕上打开一次，就遇不到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統幫你對齊的是**位置**，不是**內容**。在窄寬度下，標籤文字和附件內的文字怎樣縮減，要由應用程式來決定，不決定的話，由截斷代為決定。固定 px 高度在裝置較小或 Dynamic Type 變大時，會比內容還小。兩種情況都是**在大螢幕上看不出的問題**，所以不在小螢幕上開啟一次，就遇不到。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система подстраивает **расположение**, а не **содержимое**. Как сжимается текст в подписях вкладок и в accessory при узкой ширине, должно решать приложение, а если оно не решит, решит обрезка. Фиксированная высота в пикселях оказывается меньше содержимого, когда устройство маленькое или Dynamic Type крупный. Оба случая - **проблемы, которых не видно на большом экране**, так что пока вы хотя бы раз не откроете приложение на маленьком экране, вы с ними не столкнётесь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el sistema ajusta es **la colocación**, no **el contenido**. Cómo se encoge el texto de las etiquetas de pestañas y del accesorio con anchos estrechos lo decide la app, y si no lo decide, lo decide el truncamiento. Una altura fija en píxeles acaba siendo menor que el contenido cuando el dispositivo es pequeño o Dynamic Type es grande. Ambos son **problemas que no se ven en una pantalla grande**, así que a menos que abras la app una vez en una pantalla pequeña, nunca te toparás con ellos."
          }
        }
      }
    },
    "시스템이 무언가를 접거나 자르면, 그건 대개 제약이 아니라 **경고**다. 우회하기 전에 무엇을 경고하는지 먼저 읽는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the system folds or truncates something, it's usually not a limitation but a **warning**. Before working around it, read what it's warning you about."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the system folds or truncates something, it's usually not a limitation but a **warning**. Before working around it, read what it's warning you about."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが何かを折りたたんだり切ったりしたら、それはたいてい制約ではなく**警告**だ。回避する前に、何を警告しているのかをまず読む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统把什么折叠或截断了，通常不是限制，而是**警告**。绕开之前，先读它在警告什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統把什麼摺疊或截斷了，通常不是限制，而是**警告**。繞開之前，先讀它在警告什麼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда система что-то сворачивает или обрезает, это обычно не ограничение, а **предупреждение**. Прежде чем обходить, прочтите, о чём оно предупреждает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el sistema pliega o trunca algo, normalmente no es una limitación sino **un aviso**. Antes de esquivarlo, lee de qué te está avisando."
          }
        }
      }
    },
    "시스템이 배경 대비를 관리하는 유리 위에 임의 배경을 얹으면 재질 계층이 깨지고 다크모드·투명도 감소 설정에서 대비가 예측 불가능해짐.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Placing an arbitrary background on glass whose contrast the system manages breaks the material hierarchy, and contrast becomes unpredictable in Dark Mode and with Reduce Transparency."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Placing an arbitrary background on glass whose contrast the system manages breaks the material hierarchy, and contrast becomes unpredictable in Dark Mode and with Reduce Transparency."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが背景とのコントラストを管理しているガラスの上に任意の背景を載せると、マテリアルの階層が崩れ、ダークモードや「透明度を下げる」設定でのコントラストが予測できなくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统负责管理背景对比度的玻璃上叠任意背景，材质层级就会被破坏，在深色模式、降低透明度设置下对比度变得不可预测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統負責管理背景對比度的玻璃上疊任意背景，材質層級就會被破壞，在深色模式、降低透明度設定下對比度變得不可預測。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещение произвольного фона на стекле, контраст которого управляется системой, ломает иерархию материалов, и контраст в тёмной теме и при «Уменьшении прозрачности» становится непредсказуемым."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar un fondo arbitrario sobre cristal cuyo contraste gestiona el sistema rompe la jerarquía de materiales, y el contraste se vuelve impredecible en modo oscuro y con Reducir transparencia."
          }
        }
      }
    },
    "시스템이 보장하는 것은 **자리의 규약**이다. 탭은 왼쪽 묶음, 검색은 오른쪽 분리 캡슐, 액세서리는 위 층. 겹치지 않게 놓아 줄 뿐, 그중 무엇이 이 앱에 필요한지는 정해 주지 않는다. 하단은 이미 가장 붐비는 자리다. 요소를 모두 켜면 각자는 규약대로 서 있어도 **하단 전체가 과밀**해지고, 콘텐츠가 눌린다.\n\n탭바가 있는 화면에서 하단 툴바 액션까지 더하면 같은 자리를 두고 경쟁하게 된다. 근거 항목도 그런 화면에서는 하단 액션을 절제하라고 적는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system guarantees is **the conventions of placement**. Tabs in a group on the left, search in a separate capsule on the right, the accessory on the layer above. It just keeps them from overlapping; it doesn't decide which of them this app needs. The bottom is already the most crowded area. Turn on every element, and even if each one stands where the conventions say, **the bottom as a whole becomes overcrowded** and the content gets squeezed.\n\nOn a screen with a tab bar, adding bottom toolbar actions as well makes them compete for the same space. The source topic also says to keep bottom actions to a minimum on such screens."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system guarantees is **the conventions of placement**. Tabs in a group on the left, search in a separate capsule on the right, the accessory on the layer above. It just keeps them from overlapping; it doesn't decide which of them this app needs. The bottom is already the most crowded area. Turn on every element, and even if each one stands where the conventions say, **the bottom as a whole becomes overcrowded** and the content gets squeezed.\n\nOn a screen with a tab bar, adding bottom toolbar actions as well makes them compete for the same space. The source topic also says to keep bottom actions to a minimum on such screens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが保証するのは**配置の取り決め**だ。タブは左のまとまり、検索は右の分離されたカプセル、アクセサリはその上の層。重ならないように置いてくれるだけで、そのうちどれがこのアプリに必要かは決めてくれない。下部はもともと最も混み合う場所だ。要素を全部オンにすると、それぞれは取り決めどおりに立っていても**下部全体が過密**になり、コンテンツが押しつぶされる。\n\nタブバーのある画面で下部ツールバーのアクションまで加えると、同じ場所を奪い合うことになる。根拠のトピックも、そうした画面では下部のアクションを控えるよう書いている。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统保证的是**位置的约定**：标签在左侧一组，搜索在右侧分离胶囊，附件在上面一层。它只负责让它们摆放时不重叠，其中哪些是这个应用需要的，它不替你决定。底部本来就是最拥挤的位置。把元素都打开，即使各自按约定站着，**整个底部也会过于拥挤**，内容被压住。\n\n在有标签栏的界面里再加上底部工具栏的操作，就会争夺同一个位置。依据条目也写着，这样的界面里要克制底部操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統保證的是**位置的約定**：標籤在左側一組，搜尋在右側分離膠囊，附件在上面一層。它只負責讓它們擺放時不重疊，其中哪些是這個應用程式需要的，它不替你決定。底部本來就是最擁擠的位置。把元素都開啟，即使各自按約定站著，**整個底部也會過於擁擠**，內容被壓住。\n\n在有標籤列的介面裡再加上底部工具列的操作，就會爭奪同一個位置。依據條目也寫著，這樣的介面裡要剋制底部操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система гарантирует **соглашения о расположении**. Вкладки группой слева, поиск отдельной капсулой справа, accessory слоем выше. Она лишь следит, чтобы они не накладывались; она не решает, какие из них нужны этому приложению. Низ - и без того самое людное место. Включите все элементы, и даже если каждый стоит по соглашениям, **низ в целом окажется перегруженным**, а контент сжат.\n\nНа экране с панелью вкладок добавление ещё и действий нижней панели инструментов заставляет их соревноваться за то же место. В исходной теме тоже сказано сдерживать нижние действия на таких экранах."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el sistema garantiza son **las convenciones de colocación**. Pestañas en grupo a la izquierda, búsqueda en una cápsula separada a la derecha, el accesorio en la capa de arriba. Solo cuida de que no se solapen; no decide cuáles necesita esta app. La parte inferior ya es la zona más concurrida. Activa todos los elementos, y aunque cada uno esté donde dicen las convenciones, **la parte inferior en conjunto queda sobrecargada** y el contenido se aprieta.\n\nEn una pantalla con barra de pestañas, añadir además acciones de la barra de herramientas inferior las hace competir por el mismo espacio. El tema fuente también dice que se mantengan al mínimo las acciones inferiores en tales pantallas."
          }
        }
      }
    },
    "시스템이 아이템을 접는 이유 중 하나는 **최소 터치 타깃을 지키는 것**이다. 버튼을 무한정 줄여 넣으면 손가락보다 작아지므로, 시스템은 넘치는 것을 메뉴로 보낸다. 접기를 피하려고 아이콘을 줄이면 그 보장을 스스로 걷어낸 셈이다.\n\n또 일곱이 다 보인다고 일곱을 다 찾기 쉬운 건 아니다. 한 줄에 일곱이 있으면 무엇을 누르든 일곱 중에서 골라야 한다. 자주 쓰는 하나를 찾는 비용이 오히려 커진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One reason the system folds items is **to protect the minimum touch target**. Keep shrinking buttons and they become smaller than a finger, so the system sends the overflow into a menu. Shrinking icons to avoid folding means throwing away that guarantee yourself.\n\nAlso, seeing all seven doesn't make all seven easy to find. With seven in a row, whatever you tap, you have to choose from seven. Finding the one you use often actually costs more."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "One reason the system folds items is **to protect the minimum touch target**. Keep shrinking buttons and they become smaller than a finger, so the system sends the overflow into a menu. Shrinking icons to avoid folding means throwing away that guarantee yourself.\n\nAlso, seeing all seven doesn't make all seven easy to find. With seven in a row, whatever you tap, you have to choose from seven. Finding the one you use often actually costs more."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムがアイテムを折りたたむ理由のひとつは、**最小タッチターゲットを守ること**だ。ボタンを際限なく縮めると指より小さくなるので、システムはあふれたものをメニューに送る。折りたたみを避けようとアイコンを縮めるのは、その保証を自分から取り払うのと同じだ。\n\nまた、7つ全部が見えるからといって、7つ全部が見つけやすいわけではない。1行に7つあれば、何を押すにも7つの中から選ばなければならない。よく使うひとつを探すコストが、かえって大きくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统折叠项目的理由之一是**守住最小触控目标**。把按钮无限缩小地塞进去，会比手指还小，所以系统把溢出的送进菜单。为避开折叠而缩小图标，等于自己撤掉了这个保证。\n\n而且七个都看得见，并不等于七个都好找。一行里有七个，点什么都得七选一。找到那个常用的一个，成本反而变大了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統摺疊項目的理由之一是**守住最小觸控目標**。把按鈕無限縮小地塞進去，會比手指還小，所以系統把溢位的送進選單。為避開摺疊而縮小圖示，等於自己撤掉了這個保證。\n\n而且七個都看得見，並不等於七個都好找。一行裡有七個，點什麼都得七選一。找到那個常用的一個，成本反而變大了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна из причин, по которой система сворачивает элементы, - **защита минимальной области касания**. Продолжайте уменьшать кнопки, и они станут меньше пальца, поэтому система отправляет лишнее в меню. Уменьшая значки, чтобы избежать сворачивания, вы сами отбрасываете эту гарантию.\n\nКроме того, видимость всех семи не значит, что все семь легко найти. Когда в ряду семь, что бы вы ни нажимали, приходится выбирать из семи. Найти тот, которым пользуются часто, на деле стоит дороже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una razón por la que el sistema pliega elementos es **proteger el objetivo táctil mínimo**. Sigue encogiendo botones y se vuelven más pequeños que un dedo, así que el sistema manda el desbordamiento a un menú. Encoger iconos para evitar el plegado es tirar tú mismo esa garantía.\n\nAdemás, ver los siete no hace que los siete sean fáciles de encontrar. Con siete en fila, toques lo que toques, tienes que elegir entre siete. Encontrar el que usas a menudo cuesta en realidad más."
          }
        }
      }
    },
    "시스템이 우선순위를 정해 **제목을 줄이거나 아이템을 접는** 자동 협상을 하도록 설계됨, 개발자가 기기 폭마다 분기하지 않아도 되게. \"깨지지 않고 우아하게 줄어든다(graceful degradation)\"가 기본 동작인 이유.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system is designed to set priorities and negotiate automatically, **shrinking the title or folding items**, so developers don't have to branch for every device width. That is why \"shrinking gracefully instead of breaking (graceful degradation)\" is the default behavior."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system is designed to set priorities and negotiate automatically, **shrinking the title or folding items**, so developers don't have to branch for every device width. That is why \"shrinking gracefully instead of breaking (graceful degradation)\" is the default behaviour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが優先度を決めて、**タイトルを縮めたりアイテムを折りたたんだり**する自動の交渉を行うよう設計されている。開発者がデバイスの幅ごとに分岐しなくて済むように。「壊れずに上品に縮む（graceful degradation）」がデフォルトの動作である理由。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设计成自行协商优先级，**缩短标题或折叠项目**，让开发者不必按设备宽度分支。这就是“不崩溃、优雅地缩减（graceful degradation）”成为默认行为的原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設計成自行協商優先順序，**縮短標題或摺疊項目**，讓開發者不必按裝置寬度分支。這就是「不崩潰、優雅地縮減（graceful degradation）」成為預設行為的原因。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система устроена так, чтобы самой расставлять приоритеты и договариваться, **сжимая заголовок или сворачивая элементы**, чтобы разработчикам не приходилось ветвиться по ширине каждого устройства. Вот почему «изящно сокращаться, не ломаясь (graceful degradation)» - поведение по умолчанию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema está diseñado para fijar prioridades y negociar automáticamente, **encogiendo el título o plegando elementos**, para que los desarrolladores no tengan que ramificar por cada ancho de dispositivo. Por eso «encogerse con elegancia en lugar de romperse (graceful degradation)» es el comportamiento por defecto."
          }
        }
      }
    },
    "시스템이 자동으로 해 주는 것은 **자리의 이동**이다. 탭바가 접히면 액세서리가 사라지지 않고 탭바 자리로 승격되는 것까지가 시스템의 몫이다. 그 좁아진 자리에 **무엇을 남길지는 앱이 정해야** 한다. 넓은 레이아웃을 그대로 밀어 넣으면 잘림이 레이아웃을 대신 결정하고, 가장 중요한 버튼이 가장 먼저 잘릴 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system does automatically is **move the spot**. When the tab bar collapses, the accessory doesn't disappear but gets promoted into the tab bar's spot, and that's as far as the system goes. **What stays in that narrowed spot is up to the app.** If you just push the wide layout in as is, truncation decides the layout for you, and the most important button may be the first to get cut off."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system does automatically is **move the spot**. When the tab bar collapses, the accessory doesn't disappear but gets promoted into the tab bar's spot, and that's as far as the system goes. **What stays in that narrowed spot is up to the app.** If you just push the wide layout in as is, truncation decides the layout for you, and the most important button may be the first to get cut off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが自動でやってくれるのは**場所の移動**だ。タブバーが折りたたまれると、アクセサリは消えずにタブバーの場所へ格上げされる。そこまでがシステムの役目だ。その狭くなった場所に**何を残すかはアプリが決めなければ**ならない。広いレイアウトをそのまま押し込むと、切り詰めがレイアウトを代わりに決めてしまい、最も重要なボタンが真っ先に切れることもある。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统自动帮你做的是**位置的移动**。标签栏折叠时，附件不会消失而是升级到标签栏的位置，这一步由系统负责。但在那个变窄的位置里**留下什么，要由应用来决定**。把宽布局原样塞进去，就由截断代为决定布局，最重要的按钮可能最先被截掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統自動幫你做的是**位置的移動**。標籤列摺疊時，附件不會消失而是升級到標籤列的位置，這一步由系統負責。但在那個變窄的位置裡**留下什麼，要由應用程式來決定**。把寬佈局原樣塞進去，就由截斷代為決定佈局，最重要的按鈕可能最先被截掉。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что система делает автоматически - это **перемещение места**. Когда панель вкладок сворачивается, accessory не исчезает, а повышается до места панели вкладок, и на этом доля системы заканчивается. **Что останется в этом сузившемся месте, решает приложение.** Если просто втиснуть широкую раскладку как есть, раскладку за вас решит обрезка, и самая важная кнопка может оказаться обрезанной первой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el sistema hace automáticamente es **mover el sitio**. Cuando la barra de pestañas se colapsa, el accesorio no desaparece sino que asciende al sitio de la barra de pestañas, y ahí llega el sistema. **Lo que se queda en ese sitio estrechado lo decide la app.** Si simplemente metes el diseño ancho tal cual, el truncamiento decide el diseño por ti, y el botón más importante puede ser el primero en cortarse."
          }
        }
      }
    },
    "시스템이 접는 건 최소 터치 크기를 지키려는 것이다. 접히게 두고 순서를 설계한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system folds items to protect the minimum touch size. Let them fold, and design the order instead."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system folds items to protect the minimum touch size. Let them fold, and design the order instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが折りたたむのは、最小タッチサイズを守るためだ。折りたたまれるに任せて、順番を設計する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统折叠是为了守住最小触控尺寸。让它折叠，并设计好顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統摺疊是為了守住最小觸控尺寸。讓它摺疊，並設計好順序。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система сворачивает, чтобы защитить минимальный размер касания. Позвольте им сворачиваться и продумайте порядок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema pliega para proteger el tamaño táctil mínimo. Deja que se plieguen y diseña el orden."
          }
        }
      }
    },
    "시스템이 접어버리니 커스텀으로 만들면 전부 보여줄 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system folds them away, so building it yourself lets you show everything."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system folds them away, so building it yourself lets you show everything."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが折りたたんでしまうので、カスタムで作れば全部見せられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统会折叠，所以自己做的话就能全部显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會摺疊，所以自己做的話就能全部顯示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система сворачивает, поэтому если сделать самому, можно показать всё."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema los pliega, así que construyéndolo tú mismo puedes mostrarlo todo."
          }
        }
      }
    },
    "시스템이 정해둔 trailing 자리에 둔다. 사용자는 이미 그 자리를 찾을 줄 안다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put it in the trailing slot the system defines. Users already know to look there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put it in the trailing slot the system defines. Users already know to look there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが決めたtrailingの場所に置く。ユーザーはすでにその場所を探せる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放在系统定好的 trailing 位置。用户已经知道去那个位置找。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放在系統定好的 trailing 位置。使用者已經知道去那個位置找。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте в слот trailing, который определяет система. Пользователи уже знают, что смотреть там."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponlo en el sitio trailing que define el sistema. Los usuarios ya saben que deben mirar ahí."
          }
        }
      }
    },
    "시스템이 주는 모양이 브랜드와 안 맞아 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shape the system provides doesn't seem to fit your brand."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The shape the system provides doesn't seem to fit your brand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが提供する形がブランドに合わないように見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统给的外形似乎和品牌不搭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統給的外形似乎和品牌不搭。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма, которую даёт система, кажется не подходящей вашему бренду."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma que ofrece el sistema parece no encajar con tu marca."
          }
        }
      }
    },
    "시스템이 주는 캡슐이 브랜드와 어울리지 않아 보인다. 위치와 모양만 비슷하게 맞추면 사용자에게는 같은 것으로 보일 테고, 대신 색과 크기는 자유롭게 고를 수 있다. 직접 만들면 전환 방식도 원하는 대로 할 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capsule the system provides doesn't seem to match your brand. If you roughly match the position and shape, users will see it as the same thing, and you get to choose the color and size freely. Build it yourself, and you can control the transition too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The capsule the system provides doesn't seem to match your brand. If you roughly match the position and shape, users will see it as the same thing, and you get to choose the colour and size freely. Build it yourself, and you can control the transition too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが提供するカプセルがブランドに合わないように見える。位置と形さえ似せればユーザーには同じものに見えるだろうし、その代わり色とサイズは自由に選べる。自分で作れば遷移の仕方も思いどおりにできる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统给的胶囊似乎和品牌不搭。只要把位置和外形做得相似，用户看起来就是同一个东西，而颜色和大小可以自由选择。自己做的话，转场方式也能随心所欲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統給的膠囊似乎和品牌不搭。只要把位置和外形做得相似，使用者看起來就是同一個東西，而顏色和大小可以自由選擇。自己做的話，轉場方式也能隨心所欲。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Капсула, которую даёт система, кажется не подходящей вашему бренду. Если примерно совпасть положением и формой, пользователи увидят в ней то же самое, а цвет и размер можно выбрать свободно. Сделаете сами - сможете управлять и переходом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cápsula que ofrece el sistema parece no encajar con tu marca. Si igualas aproximadamente la posición y la forma, los usuarios la verán como lo mismo, y puedes elegir libremente el color y el tamaño. Constrúyela tú mismo y podrás controlar también la transición."
          }
        }
      }
    },
    "시안에 250pt라고 적혀 있다. 그 숫자를 그대로 옮기면 시안과 픽셀이 맞는다. medium은 이 패널에 너무 크고, 커스텀 detent가 있으니 정확한 값을 주는 게 성실한 구현처럼 보인다. 확인도 시안을 그린 기기 하나에서 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mockup says 250pt. Copy that number as is and you match the mockup pixel for pixel. medium is too big for this panel, and since custom detents exist, giving an exact value feels like a diligent implementation. You also check it only on the one device the mockup was drawn for."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The mockup says 250pt. Copy that number as is and you match the mockup pixel for pixel. medium is too big for this panel, and since custom detents exist, giving an exact value feels like a diligent implementation. You also check it only on the one device the mockup was drawn for."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインカンプに 250pt と書いてある。その数字をそのまま移せばカンプとピクセルが合う。medium はこのパネルには大きすぎるし、カスタム detent があるのだから正確な値を指定するのが誠実な実装に見える。確認も、カンプを描いた端末ひとつで済ませる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设计稿上写着 250pt。照搬这个数字，就能和设计稿像素对齐。medium 对这个面板太大，既然有自定义 detent，给出精确值似乎才是认真的实现。检查也只在画设计稿的那一台设备上做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設計稿上寫著 250pt。照搬這個數字，就能和設計稿畫素對齊。medium 對這個面板太大，既然有自定義 detent，給出精確值似乎才是認真的實作。檢查也只在畫設計稿的那一臺裝置上做。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В макете написано 250 pt. Скопируйте это число как есть, и вы совпадёте с макетом до пикселя. Medium слишком велик для этой панели, а раз есть пользовательские detent, точное значение кажется добросовестной реализацией. К тому же вы проверяете только на одном устройстве, для которого рисовали макет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La maqueta dice 250 pt. Copia ese número tal cual y coincidirás con la maqueta píxel por píxel. Medium es demasiado grande para este panel, y como existen detents personalizados, dar un valor exacto parece una implementación diligente. Además, lo compruebas solo en el único dispositivo para el que se dibujó la maqueta."
          }
        }
      }
    },
    "시안에 적힌 250pt를 그대로 옮긴다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You copy the 250pt written in the mockup as is."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You copy the 250pt written in the mockup as is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインカンプに書かれた 250pt をそのまま移す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把设计稿上写的 250pt 原样搬过来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把設計稿上寫的 250pt 原樣搬過來。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы переносите как есть 250 pt, написанные в макете."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasladas tal cual los 250 pt escritos en la maqueta."
          }
        }
      }
    },
    "시안에서 빈 자리가 보이면 채울 것을 찾기 전에 묻는다. \"이 자리가 비어 있어서 사용자가 못 하게 되는 일이 있나?\" 대개는 없다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you spot an empty slot in a mockup, ask before looking for something to fill it: \"Does leaving this slot empty stop users from doing anything?\" Usually it doesn't."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you spot an empty slot in a mockup, ask before looking for something to fill it: \"Does leaving this slot empty stop users from doing anything?\" Usually it doesn't."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザイン案に空いた場所を見つけたら、埋めるものを探す前に問う。「この場所が空いていることで、ユーザーができなくなることはあるか？」たいていはない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设计稿里看到空位时，先别急着找东西填，先问：“因为这里空着，用户有做不了的事吗？”通常没有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設計稿裡看到空位時，先別急著找東西填，先問：「因為這裡空著，使用者有做不了的事嗎？」通常沒有。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увидев в макете пустой слот, прежде чем искать, чем его заполнить, спросите: «Мешает ли пустота этого слота пользователям что-то сделать?» Обычно не мешает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando veas un hueco vacío en una maqueta, antes de buscar algo con lo que llenarlo, pregunta: «¿Impide este hueco vacío a los usuarios hacer algo?» Normalmente no."
          }
        }
      }
    },
    "시안에서는 이 투명함이 가장 아름다웠다. 사진이 유리 너머로 비치는 모습이 Liquid Glass답다. 시안에 쓴 배경은 대개 그 투명함이 가장 잘 사는 배경이다. 가장 좋은 순간을 기준으로 삼으면 그 순간을 지키고 싶어진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the mockup, this transparency looked most beautiful. Photos showing through the glass feel very Liquid Glass. The background used in a mockup is usually the one that shows off that transparency best. When you take the best moment as your benchmark, you want to protect that moment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In the mockup, this transparency looked most beautiful. Photos showing through the glass feel very Liquid Glass. The background used in a mockup is usually the one that shows off that transparency best. When you take the best moment as your benchmark, you want to protect that moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンプでは、この透明感がいちばん美しかった。写真がガラス越しに透ける様子は、いかにも Liquid Glass らしい。カンプに使う背景は、たいていその透明感がいちばん映える背景だ。いちばん良い瞬間を基準にすると、その瞬間を守りたくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设计稿里，这种通透最漂亮。照片隔着玻璃透出来，很有 Liquid Glass 的味道。设计稿用的背景，通常是让这种通透最出彩的背景。以最好的瞬间为基准，就想守住那个瞬间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設計稿裡，這種通透最漂亮。照片隔著玻璃透出來，很有 Liquid Glass 的味道。設計稿用的背景，通常是讓這種通透最出彩的背景。以最好的瞬間為基準，就想守住那個瞬間。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В макете эта прозрачность выглядела прекраснее всего. Фотографии, просвечивающие сквозь стекло, очень в духе Liquid Glass. Фон, использованный в макете, обычно лучше всего показывает эту прозрачность. Когда лучший момент берётся за эталон, хочется его сохранить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la maqueta, esta transparencia se veía lo más hermosa. Las fotos que se transparentan a través del cristal son muy Liquid Glass. El fondo usado en una maqueta suele ser el que mejor luce esa transparencia. Cuando tomas el mejor momento como referencia, quieres protegerlo."
          }
        }
      }
    },
    "시안은 펼친 상태로만 그렸다. 탭바 최소화와 액세서리 배치는 시스템이 처리하니, 접힌 상태도 시스템이 알아서 맞춰 줄 것이라 여기기 쉽다. 개발 중에는 스크롤을 거의 하지 않아 접힌 모습을 볼 일이 적다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mockups only showed the expanded state. Since the system handles minimizing the tab bar and placing the accessory, it's easy to assume it'll adjust the collapsed state for you too. During development you barely scroll, so you rarely see the collapsed version."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The mockups only showed the expanded state. Since the system handles minimising the tab bar and placing the accessory, it's easy to assume it'll adjust the collapsed state for you too. During development you barely scroll, so you rarely see the collapsed version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインカンプは展開した状態だけで描いた。タブバーの最小化とアクセサリの配置はシステムが処理するので、折りたたまれた状態もシステムが合わせてくれるだろうと思いがちだ。開発中はほとんどスクロールしないので、折りたたまれた姿を見る機会も少ない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设计稿只画了展开状态。标签栏最小化和附件布局由系统处理，容易以为折叠状态系统也会自动调好。开发期间几乎不怎么滚动，很少看到折叠的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設計稿只畫了展開狀態。標籤列最小化和附件佈局由系統處理，容易以為摺疊狀態系統也會自動調好。開發期間幾乎不怎麼滾動，很少看到摺疊的樣子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Макеты показывали только развёрнутое состояние. Поскольку сворачиванием панели вкладок и расположением accessory занимается система, легко решить, что она подстроит и свёрнутое состояние. Во время разработки вы почти не прокручиваете, так что свёрнутый вид видите редко."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las maquetas solo mostraban el estado expandido. Como el sistema se ocupa de minimizar la barra de pestañas y de colocar el accesorio, es fácil suponer que también ajustará el estado colapsado. Durante el desarrollo apenas desplazas, así que rara vez ves la versión colapsada."
          }
        }
      }
    },
    "시안을 판정할 때 배경을 가장 나쁜 것으로 바꿔 끼운다. 거기서 읽히면 통과다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When judging a mockup, swap in the worst possible background. If it's readable there, it passes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When judging a mockup, swap in the worst possible background. If it's readable there, it passes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンプを判定するときは、背景をいちばん悪いものに差し替える。そこで読めれば合格だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评判设计稿时，把背景换成最糟糕的。在那里读得清，才算通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "評判設計稿時，把背景換成最糟糕的。在那裡讀得清，才算透過。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценивая макет, подставьте худший из возможных фонов. Если там читается, он проходит."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al juzgar una maqueta, sustituye el fondo por el peor posible. Si se lee ahí, aprueba."
          }
        }
      }
    },
    "시안의 숫자를 옮기기 전에 묻는다. \"이 숫자는 어떤 기기, 어떤 글자 크기에서 맞춘 값인가?\" 답이 하나뿐이면 그 숫자는 쓰지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before copying a number from the mockup, ask: \"Which device and which text size was this number tuned for?\" If there's only one answer, don't use that number."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before copying a number from the mockup, ask: \"Which device and which text size was this number tuned for?\" If there's only one answer, don't use that number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインカンプの数字を移す前に問う。「この数字は、どの端末、どの文字サイズで合わせた値か？」 答えがひとつしかないなら、その数字は使わない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搬设计稿的数字之前先问：“这个数字是在哪种设备、哪种字号下调出来的？”答案只有一个的话，这个数字就不要用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搬設計稿的數字之前先問：「這個數字是在哪種裝置、哪種字號下調出來的？」答案只有一個的話，這個數字就不要用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем переносить число из макета, спросите: «Для какого устройства и какого размера текста это число подбиралось?» Если ответ один, не используйте это число."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de copiar un número de la maqueta, pregunta: «¿Para qué dispositivo y qué tamaño de texto se ajustó este número?» Si solo hay una respuesta, no uses ese número."
          }
        }
      }
    },
    "시작(위치)과 끝(파일명)이 모두 정보": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the start (location) and the end (file name) carry information"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the start (location) and the end (file name) carry information"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始まり（場所）と終わり（ファイル名）の両方が情報"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开头（位置）和结尾（文件名）都是信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開頭（位置）和結尾（檔名）都是資訊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И начало (расположение), и конец (имя файла) несут информацию"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanto el principio (la ubicación) como el final (el nombre del archivo) llevan información"
          }
        }
      }
    },
    "시작점 모호": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where it starts becomes unclear"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Where it starts becomes unclear"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこから始まるのかがあいまい"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起点不明确"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "起點不明確"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Становится неясно, откуда начинается"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No queda claro dónde empieza"
          }
        }
      }
    },
    "시트 꼭대기의 작은 회색 선은 화면에서 유일하게 의미 없어 보이는 요소다. 빼면 위쪽이 깔끔해진다. 시트는 원래 끌 수 있는 것이니 사용자도 알아서 끌어 보리라 생각한다. 만드는 사람은 detent가 둘이라는 걸 알기 때문에 선이 없어도 불편을 못 느낀다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The small gray line at the top of the sheet is the only element on the screen that looks meaningless. Remove it and the top looks cleaner. Sheets can be dragged by nature, so you assume users will try dragging on their own. As the builder, you know there are two detents, so you don't feel any inconvenience without the line."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The small grey line at the top of the sheet is the only element on the screen that looks meaningless. Remove it and the top looks cleaner. Sheets can be dragged by nature, so you assume users will try dragging on their own. As the builder, you know there are two detents, so you don't feel any inconvenience without the line."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートのいちばん上の小さなグレーの線は、画面の中で唯一意味がなさそうに見える要素だ。外せば上部がすっきりする。シートはもともとドラッグできるものなので、ユーザーも自分で引っ張ってみるだろうと考える。作る側は detent が2つあると知っているので、線がなくても不便を感じない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层顶部那条灰色小线，是界面里唯一看起来没有意义的元素。去掉它，上方就干净了。弹层本来就能拖，用户自己会试着拖。做的人知道有两个 detent，所以没有这条线也感觉不到不便。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表頂部那條灰色小線，是介面裡唯一看起來沒有意義的元素。去掉它，上方就乾淨了。工作表本來就能拖，使用者自己會試著拖。做的人知道有兩個 detent，所以沒有這條線也感覺不到不便。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленькая серая линия вверху шторки - единственный элемент на экране, который выглядит бессмысленным. Уберите её, и верх выглядит чище. Шторки по природе перетаскиваются, поэтому вы полагаете, что пользователи сами попробуют потянуть. Вы, как создатель, знаете, что detent два, поэтому без линии неудобства не ощущаете."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pequeña línea gris de lo alto de la hoja es el único elemento de la pantalla que parece no tener sentido. Quítala y la parte superior se ve más limpia. Las hojas se pueden arrastrar por naturaleza, así que supones que los usuarios probarán a arrastrar por su cuenta. Como constructor, sabes que hay dos detents, así que sin la línea no notas inconveniente."
          }
        }
      }
    },
    "시트 내용이 **탭한 요소의 확장**일 때, 카드를 탭해 그 카드의 상세 시트가 열리는 구조.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the sheet's content is **an expansion of the tapped element**: you tap a card and that card's detail sheet opens."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the sheet's content is **an expansion of the tapped element**: you tap a card and that card's detail sheet opens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートの内容が**タップした要素の拡張**であるとき。カードをタップすると、そのカードの詳細シートが開く構造。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当弹层内容是**被点按元素的延伸**时：点按一张卡片，打开该卡片的详情弹层的结构。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當工作表內容是**被輕點元素的延伸**時：輕點一張卡片，開啟該卡片的詳情工作表的結構。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда содержимое шторки - **продолжение нажатого элемента**: вы нажимаете карточку, и открывается шторка с подробностями этой карточки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el contenido de la hoja es **una expansión del elemento tocado**: tocas una tarjeta y se abre la hoja de detalle de esa tarjeta."
          }
        }
      }
    },
    "시트 높이는 가벼워 보이는 쪽이 아니라 **내용이 정하는 쪽**을 따른다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet's height follows **what the content dictates**, not what looks lighter."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet's height follows **what the content dictates**, not what looks lighter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートの高さは、軽く見えるほうではなく**内容が決めるほう**に従う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层高度不是看起来轻不轻，而是要听**内容的**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表高度不是看起來輕不輕，而是要聽**內容的**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высота шторки определяется **тем, чего требует содержимое**, а не тем, что выглядит легче."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La altura de una hoja la dicta **lo que exige el contenido**, no lo que parece más ligero."
          }
        }
      }
    },
    "시트 높이는 콘텐츠가 결정해야 합니다, medium에 작은 콘텐츠를 넣으면 **잉여 공백이 “뭔가 더 있나?”라는 오독**을 만듭니다. 다만 자유 높이는 일관성을 해치므로, detent 시스템 안에서 커스텀을 허용하는 절충 설계.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content should decide the sheet's height. Put small content in a medium sheet and **the extra white space gets misread as \"Is there more?\"** Free-form heights would hurt consistency, though, so the design compromises by allowing custom values within the detent system."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The content should decide the sheet's height. Put small content in a medium sheet and **the extra white space gets misread as \"Is there more?\"** Free-form heights would hurt consistency, though, so the design compromises by allowing custom values within the detent system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートの高さはコンテンツが決めるべきです。mediumに小さなコンテンツを入れると、**余った空白が「まだ何かあるの？」という誤読**を生みます。ただし自由な高さは一貫性を損なうので、デタントのシステムの中でカスタムを許す折衷的な設計。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层高度应由内容决定。把小内容放进 medium，**多余的空白会造成“还有别的吧？”的误读**。不过自由高度会损害一致性，所以这是在 detent 体系内允许自定义的折中设计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表高度應由內容決定。把小內容放進 medium，**多餘的空白會造成「還有別的吧？」的誤讀**。不過自由高度會損害一致性，所以這是在 detent 體系內允許自定義的折中設計。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высоту шторки должно определять содержимое. Положите маленькое содержимое в шторку medium, и **лишнее белое пространство прочтут как «а там есть ещё?»** Свободные высоты, правда, вредили бы единообразию, поэтому решение-компромисс допускает пользовательские значения внутри системы detent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido debería decidir la altura de la hoja. Pon contenido pequeño en una hoja medium y **el espacio en blanco sobrante se malinterpreta como «¿hay más?»** Las alturas libres dañarían la coherencia, sin embargo, así que el diseño llega a un compromiso permitiendo valores personalizados dentro del sistema de detents."
          }
        }
      }
    },
    "시트 높이를 정할 때 **\"시트 뒤에 있는 것이 이 작업의 재료인가\"**를 묻는다. 재료라면 덮지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When deciding a sheet's height, ask **\"Is what's behind the sheet the material for this task?\"** If it is, don't cover it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When deciding a sheet's height, ask **\"Is what's behind the sheet the material for this task?\"** If it is, don't cover it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートの高さを決めるときは、**「シートの後ろにあるものは、この作業の材料か**」を問う。材料なら覆わない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定弹层高度时问**“弹层后面的东西，是这项任务的材料吗？”**是材料，就不要盖住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定工作表高度時問**「工作表後面的東西，是這項任務的材料嗎？」**是材料，就不要蓋住。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяя высоту шторки, спросите **«То, что позади шторки, - это материал для данной задачи?»** Если да, не закрывайте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al decidir la altura de una hoja, pregunta **«¿Lo que hay detrás de la hoja es el material de esta tarea?»** Si lo es, no lo tapes."
          }
        }
      }
    },
    "시트가 **도구 팔레트** 역할일 때, 지도를 계속 움직이면서 결과 시트 유지, 본문을 스크롤하면서 서식 패널 사용.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the sheet acts as a **tool palette**: keeping a results sheet open while you keep panning the map, or using a formatting panel while you scroll through the document."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the sheet acts as a **tool palette**: keeping a results sheet open while you keep panning the map, or using a formatting panel while you scroll through the document."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートが**ツールパレット**の役割を果たすとき。地図を動かし続けながら結果のシートを開いたままにする、本文をスクロールしながら書式パネルを使う、など。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当弹层充当**工具调色板**时：一边不停地移动地图，一边保持结果弹层；一边滚动正文，一边使用格式面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當工作表充當**工具調色盤**時：一邊不停地移動地圖，一邊保持結果工作表；一邊滾動正文，一邊使用格式面板。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда шторка выступает **палитрой инструментов**: держать шторку с результатами открытой, пока вы продолжаете двигать карту, или пользоваться панелью форматирования, пока прокручиваете документ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la hoja actúa como **paleta de herramientas**: mantener abierta una hoja de resultados mientras sigues moviendo el mapa, o usar un panel de formato mientras te desplazas por el documento."
          }
        }
      }
    },
    "시트가 화면을 다 덮지 않는 쪽이 가벼워 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet that doesn't cover the whole screen feels lighter."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet that doesn't cover the whole screen feels lighter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を全部覆わないシートのほうが軽く見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层不盖满整个界面，看起来更轻盈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表不蓋滿整個介面，看起來更輕盈。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шторка, не закрывающая весь экран, ощущается легче."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja que no cubre toda la pantalla se siente más ligera."
          }
        }
      }
    },
    "시트는 **“임시 컨텍스트 전환”**의 장치, large는 사실상 새 화면이지만, 뒤가 살짝 보이는 스택 은유로 “끝나면 원래 화면으로 돌아간다”는 감각을 유지합니다. 영구 이동인 push와 구분되는 이유가 이 은유.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet is a device for **\"a temporary context switch.\"** Large is effectively a new screen, but the stacked metaphor, with the screen behind just peeking out, keeps the sense that \"when I'm done, I'll go back to where I was.\" That metaphor is what sets it apart from push, which is a permanent move."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet is a device for **\"a temporary context switch.\"** Large is effectively a new screen, but the stacked metaphor, with the screen behind just peeking out, keeps the sense that \"when I'm done, I'll go back to where I was.\" That metaphor is what sets it apart from push, which is a permanent move."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートは「**一時的な文脈の切り替え**」のための装置。largeは実質的に新しい画面だが、背後が少し見えるスタックの比喩によって「終われば元の画面に戻る」という感覚を保ちます。恒久的な移動であるpushと区別される理由が、この比喩。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层是**“临时切换上下文”**的装置。large 实际上是新界面，但靠后面隐约可见的堆叠隐喻，保持“结束后回到原界面”的感觉。这个隐喻就是它与永久移动的 push 的区别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表是**「臨時切換上下文」**的裝置。large 實際上是新介面，但靠後面隱約可見的堆疊隱喻，保持「結束後回到原介面」的感覺。這個隱喻就是它與永久移動的 push 的區別。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шторка - средство для **«временного переключения контекста»**. Large по сути новый экран, но метафора стопки, когда экран позади лишь выглядывает, сохраняет ощущение «закончу - вернусь туда, где был». Эта метафора и отличает её от push, постоянного перехода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja es un recurso para **«un cambio temporal de contexto».** Large es en la práctica una pantalla nueva, pero la metáfora apilada, con la pantalla de detrás asomando apenas, conserva la sensación de que «cuando termine, volveré a donde estaba». Esa metáfora es lo que la distingue de push, que es un movimiento permanente."
          }
        }
      }
    },
    "시트는 집중을 위한 것이니 다 덮는 게 맞다고 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You see sheets as tools for focus, so covering everything seems right."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You see sheets as tools for focus, so covering everything seems right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートは集中のためのものなので、全部覆うのが正しいと考える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "觉得弹层是为专注准备的，所以盖满才对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覺得工作表是為專注準備的，所以蓋滿才對。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы видите в шторках средство для сосредоточения, поэтому закрыть всё кажется верным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ves las hojas como herramientas de concentración, así que cubrirlo todo parece correcto."
          }
        }
      }
    },
    "시트는 집중을 위한 장치이니, 다 덮어야 사용자가 지금 할 일에만 집중할 수 있다고 본다. 반쯤 열린 시트는 어정쩡해 보이고, 뒤 화면이 보이면 산만할 것 같다. 기본값이 large 이니 그대로 두는 것이 가장 무난해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet is a tool for focus, so you think it has to cover everything for users to focus only on what they're doing now. A half-open sheet looks half-hearted, and seeing the screen behind seems distracting. The default is large, so leaving it as is seems the safest bet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet is a tool for focus, so you think it has to cover everything for users to focus only on what they're doing now. A half-open sheet looks half-hearted, and seeing the screen behind seems distracting. The default is large, so leaving it as is seems the safest bet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートは集中のための仕組みなので、全部覆ってこそユーザーが今やることだけに集中できると考える。半分だけ開いたシートは中途半端に見え、後ろの画面が見えると気が散りそうだ。デフォルトが large なので、そのままにするのが最も無難に見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "觉得弹层是帮助专注的装置，盖满了用户才能只专注于眼前要做的事。半开的弹层看起来半吊子，后面的界面看得见又会分心。默认值是 large，保持不动似乎最稳妥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覺得工作表是幫助專注的裝置，蓋滿了使用者才能只專注於眼前要做的事。半開的工作表看起來半吊子，後面的介面看得見又會分心。預設值是 large，保持不動似乎最穩妥。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шторка - средство для сосредоточения, поэтому вы думаете, что она должна закрывать всё, чтобы пользователи могли сосредоточиться только на том, что делают сейчас. Полуоткрытая шторка выглядит недоделанной, а экран позади отвлекает. По умолчанию large, так что оставить как есть кажется самым надёжным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja es una herramienta de concentración, así que piensas que tiene que cubrirlo todo para que los usuarios se concentren solo en lo que hacen ahora. Una hoja a medio abrir parece a medias, y ver la pantalla de detrás parece distraer. El valor por defecto es large, así que dejarlo como está parece la apuesta más segura."
          }
        }
      }
    },
    "시트를 띄울 때 기본값을 받아들이기 전에 **\"이 작업은 뒤 화면을 떠나는 일인가\"**를 묻는다. 아니라면 전부 덮지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before accepting the default when presenting a sheet, ask **\"Does this task mean leaving the screen behind?\"** If not, don't cover all of it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before accepting the default when presenting a sheet, ask **\"Does this task mean leaving the screen behind?\"** If not, don't cover all of it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートを表示するとき、デフォルトを受け入れる前に「**この作業は後ろの画面を離れることなのか**」を問う。そうでなければ、全部を覆わない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹出弹层时，接受默认值之前先问**“这项任务是要离开后面的界面吗？”**不是的话，就不要全部盖住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈出工作表時，接受預設值之前先問**「這項任務是要離開後面的介面嗎？」**不是的話，就不要全部蓋住。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем принять значение по умолчанию при показе шторки, спросите **«Означает ли эта задача уход с экрана позади?»** Если нет, не закрывайте его целиком."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de aceptar el valor por defecto al presentar una hoja, pregunta **«¿Esta tarea implica dejar la pantalla de detrás?»** Si no, no la cubras entera."
          }
        }
      }
    },
    "시트를 만들 때 기본값이 large라 그대로 둔다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you create a sheet, the default is large, so you leave it that way."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you create a sheet, the default is large, so you leave it that way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートを作るとデフォルトが large なので、そのままにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做弹层时默认是 large，所以就那样放着。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做工作表時預設是 large，所以就那樣放著。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавая шторку, вы видите, что по умолчанию large, и оставляете так."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando creas una hoja, el valor por defecto es large, así que lo dejas así."
          }
        }
      }
    },
    "시트마다 커스텀 슬라이드 방향을 달리함": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Varying the custom slide direction from sheet to sheet"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Varying the custom slide direction from sheet to sheet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートごとにカスタムのスライド方向を変える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个弹层的自定义滑动方向各不相同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個工作表的自定義滑動方向各不相同"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разное направление пользовательского выезда у разных шторок"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Variar la dirección de deslizamiento personalizada de una hoja a otra"
          }
        }
      }
    },
    "시트와 달리 뒤가 전혀 안 보이고 제스처 닫기도 없음**“이 작업을 끝내거나, 명시적으로 나가라”**는 강한 모달성입니다. 가벼운 시트와 무거운 커버를 시스템이 굳이 별도 API로 분리한 건, 이 무게 차이가 사용자 기대의 문제이기 때문.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlike a sheet, nothing behind it shows and there's no gesture to dismiss it: a strong modality that says **\"finish this task, or leave explicitly.\"** The system deliberately splits the light sheet and the heavy cover into separate APIs because this difference in weight is a matter of user expectations."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlike a sheet, nothing behind it shows and there's no gesture to dismiss it: a strong modality that says **\"finish this task, or leave explicitly.\"** The system deliberately splits the light sheet and the heavy cover into separate APIs because this difference in weight is a matter of user expectations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートと違って背後はまったく見えず、ジェスチャーで閉じることもできない。**「この作業を終えるか、明示的に出ていくか**」という強いモーダル性です。軽いシートと重いカバーをシステムがわざわざ別のAPIに分けたのは、この重さの違いがユーザーの期待に関わる問題だから。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与弹层不同，后面完全看不见，也不能用手势关闭：这是**“要么完成这项工作，要么明确退出”**的强模态性。系统特意把轻量的弹层和厚重的覆盖拆成不同的 API，是因为这种分量差异关系到用户的期待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與工作表不同，後面完全看不見，也不能用手勢關閉：這是**「要麼完成這項工作，要麼明確退出」**的強模態性。系統特意把輕量的工作表和厚重的覆蓋拆成不同的 API，是因為這種分量差異關係到使用者的期待。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В отличие от шторки, позади ничего не видно и жеста закрытия нет: сильная модальность, говорящая **«завершите эту задачу или выйдите явно».** Система намеренно разделяет лёгкую шторку и тяжёлое покрытие на разные API, потому что эта разница в весе - дело ожиданий пользователей."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A diferencia de una hoja, no se ve nada detrás y no hay gesto para descartarla: una modalidad fuerte que dice **«termina esta tarea, o sal de forma explícita».** El sistema separa deliberadamente la hoja ligera y la cubierta pesada en APIs distintas porque esta diferencia de peso es cuestión de las expectativas del usuario."
          }
        }
      }
    },
    "시트의 핵심 변수는 **detent(멈춤 높이)**와 **모달성**, 화면을 얼마나 차지할지, 그리고 뒤 콘텐츠와의 관계(차단 vs 병행)를 어떻게 설정할지가 다섯 케이스의 전부입니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet's key variables are **the detent (its resting height)** and **modality**: how much of the screen it takes up, and how it relates to the content behind it (blocking vs. working alongside). That covers all five cases."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet's key variables are **the detent (its resting height)** and **modality**: how much of the screen it takes up, and how it relates to the content behind it (blocking vs. working alongside). That covers all five cases."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートの核となる変数は**detent（止まる高さ**）と**モーダル性**です。画面をどれだけ占めるか、そして背後のコンテンツとの関係（遮断か並行か）をどう設定するか。5つのケースはそれに尽きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层的关键变量是 **detent（停靠高度）**和**模态性**：占多少屏幕，以及怎样设定与后面内容的关系（屏蔽还是并行），就是五个案例的全部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表的關鍵變數是 **detent（停靠高度）**和**模態性**：佔多少螢幕，以及怎樣設定與後面內容的關係（遮蔽還是並行），就是五個案例的全部。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключевые переменные шторки - **detent (высота остановки)** и **модальность**: сколько экрана она занимает и как связана с контентом позади (блокировка или работа рядом). Этим исчерпываются все пять случаев."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las variables clave de una hoja son **el detent (su altura de reposo)** y **la modalidad**: cuánta pantalla ocupa y cómo se relaciona con el contenido de detrás (bloquear o trabajar al lado). Eso cubre los cinco casos."
          }
        }
      }
    },
    "시트의 형제지만 성격은 반대**뒤를 완전히 가리고, 스와이프로 닫을 수 없는 강한 모달**입니다. 선택 기준은 “실수로 이탈하면 안 되는 흐름인가”.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sibling of the sheet with the opposite personality: **a strong modal that fully covers what is behind it and cannot be dismissed with a swipe**. The criterion: “Is this a flow people must not leave by accident?”"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sibling of the sheet with the opposite personality: **a strong modal that fully covers what is behind it and cannot be dismissed with a swipe**. The criterion: “Is this a flow people must not leave by accident?”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートの兄弟ですが、性格は正反対。**背後を完全に覆い、スワイプで閉じられない強いモーダル**です。選ぶ基準は「うっかり離脱してはいけないフローか」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层的兄弟，性格却相反：这是**完全盖住后面、不能用滑动关闭的强模态**。选择标准是“是不是不能因误操作而退出的流程”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表的兄弟，性格卻相反：這是**完全蓋住後面、不能用滑動關閉的強模態**。選擇標準是「是不是不能因誤操作而退出的流程」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Родственник шторки с противоположным характером: **сильное модальное окно, полностью закрывающее то, что позади, и не закрывающееся смахиванием**. Критерий: «Это сценарий, который люди не должны покидать случайно?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hermano de la hoja con el carácter opuesto: **un modal fuerte que cubre por completo lo que hay detrás y no se puede descartar deslizando**. El criterio: «¿Es un flujo que la gente no debe abandonar por accidente?»"
          }
        }
      }
    },
    "시트처럼 쓸어내려 닫히겠거니 하고 넘어간다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You assume it will close with a downward swipe, like a sheet, and move on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You assume it will close with a downward swipe, like a sheet, and move on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートと同じように下へスワイプすれば閉じるだろうと思い、そのままにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以为像弹层一样向下轻扫就能关闭，就这么放过去了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以為像工作表一樣向下輕掃就能關閉，就這麼放過去了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы считаете, что оно закроется смахиванием вниз, как шторка, и идёте дальше."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supones que se cerrará deslizando hacia abajo, como una hoja, y sigues adelante."
          }
        }
      }
    },
    "신뢰 소모": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wears away trust"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wears away trust"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼をすり減らす"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消耗信任"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "消耗信任"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтачивает доверие"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desgasta la confianza"
          }
        }
      }
    },
    "신호와 동작을 일치시킨다. 만질 수 있으면 어둡게 하지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the signal match the behavior. If it can be touched, don't dim it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the signal match the behaviour. If it can be touched, don't dim it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインと動作を一致させる。触れるなら暗くしない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让信号和动作一致。能操作的话，就不要压暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓訊號和動作一致。能操作的話，就不要壓暗。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте так, чтобы сигнал совпадал с поведением. Если можно трогать, не затемняйте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que la señal coincida con el comportamiento. Si se puede tocar, no lo atenúes."
          }
        }
      }
    },
    "실기기에서 스크롤 방향 전환 시 접힘/펼침 애니메이션을 확인하세요. 스크롤이 짧은 화면에는 부적합합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a real device, check the collapse and expand animations as the scroll direction changes. It's a poor fit for screens with little scrolling."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On a real device, check the collapse and expand animations as the scroll direction changes. It's a poor fit for screens with little scrolling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実機で、スクロールの向きが変わるときの折りたたみ・展開のアニメーションを確認してください。スクロールの短い画面には向きません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在真机上确认滚动方向切换时的折叠/展开动画。不适合滚动很短的界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在真機上確認滾動方向切換時的摺疊/展開動畫。不適合滾動很短的介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте на настоящем устройстве анимации сворачивания и разворачивания при смене направления прокрутки. Плохо подходит для экранов с малой прокруткой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba en un dispositivo real las animaciones de colapso y expansión al cambiar la dirección del desplazamiento. Encaja mal en pantallas con poco desplazamiento."
          }
        }
      }
    },
    "썸네일 → 전체 화면 ⤢": {
      "extractionState": "manual",
      "localizations": {
