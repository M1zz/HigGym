            "state": "translated",
            "value": "Using a fixed pixel height without testing across devices"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末ごとの検証なしに固定ピクセルの高さを使う"
          }
        },
        "zh-Hans": {
