        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen piilottaminen matalalla kaksitasoisella asetusnäkymällä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyembunyikannya pada layar pengaturan dangkal dua tingkat"
