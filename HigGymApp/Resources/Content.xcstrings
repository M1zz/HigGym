    },
    "시스템 2단으로 충분한데 픽셀 미세조정에 집착": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsessing over pixel-level tweaks when the two system steps would do"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsessing over pixel-level tweaks when the two system steps would do"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの2段階で足りるのに、ピクセル単位の微調整にこだわる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统两档就够了，却执着于像素微调"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統兩檔就夠了，卻執著於畫素微調"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одержимость пиксельной подгонкой, когда хватило бы двух системных ступеней"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsesionarse con retoques a nivel de píxel cuando bastarían los dos escalones del sistema"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Pixelkorrekturen versessen sein, obwohl die zwei Systemstufen genügt hätten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'obstiner sur des retouches au pixel près alors que les deux crans du système suffiraient"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ossessionarsi su ritocchi a livello di pixel quando bastavano i due passi di sistema"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obcecar-se com ajustes em nível de pixel quando bastavam os dois passos do sistema"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมกมุ่นกับการปรับระดับพิกเซลทั้งที่สองขั้นของระบบก็พอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ám ảnh chỉnh từng pixel khi hai bậc hệ thống là đủ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posedlost úpravami na úrovni pixelů, když by stačily dva kroky systému"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At gå op i pixelnøjagtige justeringer, når de to systemtrin ville række"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμμονή με ρυθμίσεις επιπέδου pixel όταν τα δύο βήματα συστήματος θα αρκούσαν"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikselitason hienosäätöön takertuminen, kun kaksi järjestelmäporrasta riittäisi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terobsesi pada penyetelan tingkat piksel padahal dua langkah sistem sudah cukup"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å bli besatt av tilpasninger på pikselnivå når de to systemtrinnene ville holdt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geobsedeerd zijn door aanpassingen op pixelniveau terwijl de twee systeemstappen volstaan"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsesja na punkcie poprawek na poziomie pikseli, gdy wystarczą dwa stopnie systemu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att fixera sig vid justeringar på pixelnivå när de två systemstegen räckte"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki sistem adımı yeterken piksel düzeyinde ince ayara takılmak"
          }
        }
      }
    },
    "시스템 검색바를 다른 툴바 아이템들과 **한 툴바 체계 안에 통합**, 자리 확보·분리·축소를 조합.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system search bar **integrated into one toolbar system** with the other toolbar items, combining slot reservation, separation, and minimization."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system search bar **integrated into one toolbar system** with the other toolbar items, combining slot reservation, separation, and minimisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの検索バーをほかのツールバーアイテムと**ひとつのツールバー体系の中に統合**。位置の確保・分離・縮小を組み合わせる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把系统搜索栏与其他工具栏项目**整合进同一套工具栏体系**，组合了留位 · 分离 · 缩小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把系統搜尋列與其他工具列項目**整合進同一套工具列體系**，組合了留位 · 分離 · 縮小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная строка поиска, **интегрированная в одну систему панели инструментов** с остальными элементами панели, сочетающая резервирование места, разделение и минимизацию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de búsqueda del sistema **integrada en un único sistema de barra de herramientas** con los demás elementos de la barra, combinando reserva de hueco, separación y minimización."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die System-Suchleiste, **in ein Symbolleistensystem integriert** mit den anderen Symbolleistenelementen, kombiniert Platzreservierung, Trennung und Minimierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre de recherche système **intégrée dans un seul système de barre d'outils** avec les autres éléments de la barre d'outils, combinant réservation d'emplacement, séparation et réduction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra di ricerca di sistema **integrata in un unico sistema di barra degli strumenti** con gli altri elementi, che combina riserva dello slot, separazione e minimizzazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de busca do sistema **integrada num único sistema de barra de ferramentas** com os outros itens, combinando reserva do lugar, separação e minimização."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบค้นหาของระบบที่**รวมเข้าระบบแถบเครื่องมือเดียว**กับรายการแถบเครื่องมืออื่น รวมการสำรองช่อง การแยก และการย่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tìm kiếm hệ thống **tích hợp vào một hệ thống thanh công cụ duy nhất** cùng các mục khác, kết hợp giữ ô, phân tách và thu gọn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systémové vyhledávací pole **integrované do jednoho systému panelu nástrojů** s ostatními položkami panelu nástrojů, kombinující rezervaci slotu, oddělení a minimalizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemets søgebjælke **integreret i ét værktøjslinjesystem** med de andre værktøjslinjeelementer, der kombinerer pladsreservation, adskillelse og minimering."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή αναζήτησης του συστήματος **ενσωματωμένη σε ένα σύστημα γραμμής εργαλείων** με τα άλλα στοιχεία γραμμής εργαλείων, συνδυάζοντας δέσμευση θέσης, διαχωρισμό και ελαχιστοποίηση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmän hakupalkki **integroituna yhteen työkalupalkkijärjestelmään** muiden työkalupalkin kohteiden kanssa, yhdistäen paikan varauksen, erottelun ja minimoinnin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah pencarian sistem yang **terintegrasi ke satu sistem bilah alat** dengan item bilah alat lain, menggabungkan penyisihan slot, pemisahan, dan minimalisasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemets søkelinje **integrert i ett verktøylinjesystem** med de andre verktøylinjeelementene, som kombinerer plassreservasjon, separasjon og minimering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De systeemzoekbalk **geïntegreerd in één werkbalksysteem** met de andere werkbalkitems, die plekreservering, scheiding en minimalisatie combineert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemowy pasek wyszukiwania **zintegrowany w jeden system paska narzędzi** z innymi elementami paska narzędzi, łączący rezerwację miejsca, rozdzielenie i minimalizację."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemets sökfält **integrerat i ett verktygsfältssystem** med de andra verktygsfältsobjekten, som kombinerar platsreservation, åtskillnad och minimering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slot rezervasyonu, ayırma ve küçültmeyi birleştirerek diğer araç çubuğu öğeleriyle **tek bir araç çubuğu sistemine entegre edilmiş** sistem arama çubuğu."
          }
        }
      }
    },
    "시스템 규약 이탈": {
      "extractionState": "manual",
