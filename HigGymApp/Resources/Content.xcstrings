          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et kort → det udvides til det korts detaljeark"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτημα σε κάρτα → επεκτείνεται στο φύλλο λεπτομερειών της κάρτας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta korttia → se laajenee kyseisen kortin yksityiskohtaarkiksi"
          }
        },
        "id": {
