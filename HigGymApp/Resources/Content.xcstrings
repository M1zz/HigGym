          "stringUnit": {
            "state": "translated",
            "value": "You need a place to collect the features that didn't fit anywhere else."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこにも入れられなかった機能を集めておく場所が必要だ。"
          }
        }
      }
    },
    "어떤 배경에서도 판독 유지": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
