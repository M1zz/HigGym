        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abas, cápsula de busca, acessório e minimização são todas ótimas funcionalidades, então você usa todas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บ แคปซูลค้นหา อุปกรณ์เสริม และการย่อ ล้วนเป็นฟีเจอร์ที่ดี คุณจึงใช้ทั้งหมด"
          }
        },
        "vi": {
