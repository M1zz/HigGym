          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση σχεδόν δεν χρησιμοποιείται αλλά μένει στην οθόνη, ακόμα και ελαχιστοποιημένη (το searchable από μόνο του είναι περιττό)"
          }
        }
      }
    },
    "검색을 두 자리에 동시에 제공한다": {
      "extractionState": "manual",
      "localizations": {
