          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉnh equalizer trong khi vẫn điều khiển màn hình phát phía sau"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úprava ekvalizéru při stálém ovládání obrazovky přehrávání vzadu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At justere en equalizer, mens man stadig styrer afspilningsskærmen bagved"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρύθμιση ενός equalizer ενώ ελέγχεις ακόμα την οθόνη αναπαραγωγής πίσω"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taajuuskorjaimen säätäminen samalla, kun ohjaat edelleen takana olevaa toistonäkymää"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyesuaikan equalizer sambil tetap mengendalikan layar pemutaran di belakang"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å justere en equalizer mens du fortsatt styrer avspillingsskjermen bak"
