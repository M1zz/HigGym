    "작은 화면(SE급)에서 겹침·잘림 검증 없이 풀 구성 강행": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcing the full setup without checking for overlap and clipping on small (SE-class) screens"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcing the full setup without checking for overlap and clipping on small (SE-class) screens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さい画面（SEクラス）での重なりや切れを確認せず、フル構成を押し通す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在小屏幕（SE 级）上不验证重叠 · 截断，就强推完整配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在小螢幕（SE 級）上不驗證重疊 · 截斷，就強推完整配置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принудительное применение полной конфигурации без проверки наложений и обрезки на маленьких (класса SE) экранах"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar la configuración completa sin comprobar solapamientos y recortes en pantallas pequeñas (clase SE)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das volle Setup erzwingen, ohne auf kleinen Bildschirmen (SE-Klasse) auf Überlappung und Abschneiden zu prüfen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
