          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Action loin de sa cible"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azione lontana dal suo bersaglio"
          }
        },
        "pt-BR": {
          "stringUnit": {
