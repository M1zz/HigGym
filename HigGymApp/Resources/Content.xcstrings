    "양쪽 모두 여러 아이템, 왼쪽 캡슐 하나, 오른쪽 캡슐 하나로 **두 개의 독립 그룹**.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple items on both sides, one capsule on the left and one on the right, forming **two independent groups**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple items on both sides, one capsule on the left and one on the right, forming **two independent groups**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両側とも複数のアイテム。左にカプセルがひとつ、右にカプセルがひとつで、**2つの独立したグループ**。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两侧都有多个项目，左侧一个胶囊，右侧一个胶囊，是**两个独立的组**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩側都有多個項目，左側一個膠囊，右側一個膠囊，是**兩個獨立的組**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько элементов с обеих сторон, одна капсула слева и одна справа, образующие **две независимые группы**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varios elementos en ambos lados, una cápsula a la izquierda y otra a la derecha, formando **dos grupos independientes**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Elemente auf beiden Seiten, eine Kapsel links und eine rechts, die **zwei unabhängige Gruppen** bilden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs éléments des deux côtés, une capsule à gauche et une à droite, formant **deux groupes indépendants**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più elementi su entrambi i lati, una capsula a sinistra e una a destra, che formano **due gruppi indipendenti**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vários itens nos dois lados, uma cápsula à esquerda e uma à direita, formando **dois grupos independentes**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลายรายการทั้งสองข้าง หนึ่งแคปซูลทางซ้ายและหนึ่งทางขวา เป็น**สองกลุ่มอิสระ**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiều mục ở cả hai bên, một capsule bên trái và một bên phải, tạo thành **hai nhóm độc lập**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Více položek na obou stranách, jedna kapsle vlevo a jedna vpravo, tvořící **dvě nezávislé skupiny**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere elementer på begge sider, én kapsel til venstre og én til højre, der danner **to uafhængige grupper**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολλά στοιχεία και στις δύο πλευρές, μία κάψουλα αριστερά και μία δεξιά, σχηματίζοντας **δύο ανεξάρτητες ομάδες**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Useita kohteita molemmilla puolilla, yksi kapseli vasemmalla ja yksi oikealla, muodostaen **kaksi itsenäistä ryhmää**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa item di kedua sisi, satu kapsul di kiri dan satu di kanan, membentuk **dua grup mandiri**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere elementer på begge sider, én kapsel til venstre og én til høyre, som danner **to uavhengige grupper**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meerdere items aan beide kanten, één capsule links en één rechts, die **twee onafhankelijke groepen** vormen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiele elementów po obu stronach, jedna kapsuła po lewej i jedna po prawej, tworzące **dwie niezależne grupy**."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flera objekt på båda sidor, en kapsel till vänster och en till höger, som bildar **två oberoende grupper**."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki yanda birden çok öğe, solda bir kapsül ve sağda bir kapsül, **iki bağımsız grup** oluşturur."
          }
        }
      }
    },
