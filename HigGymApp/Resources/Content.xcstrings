        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tiêu đề lớn 34pt** dưới thanh điều hướng, thu lại khi cuộn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**34pt velký nadpis** pod navigačním panelem, který se při posouvání sbalí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En **34 pt stor titel** under navigationsbjælken, der folder sammen, mens du scroller"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας **μεγάλος τίτλος 34 pt** κάτω από τη γραμμή πλοήγησης που συμπτύσσεται καθώς κυλάς"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**34 pt:n suuri otsikko** navigointipalkin alapuolella, joka tiivistyy vieritettäessä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Judul besar 34pt** di bawah bilah navigasi yang menciut saat digulir"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En **34 pt stor tittel** under navigasjonslinjen som kollapser når du ruller"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een **grote titel van 34 pt** onder de navigatiebalk die inklapt als je scrolt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Duży tytuł 34 pt** pod paskiem nawigacji, który zwija się przy przewijaniu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En **34 pt stor rubrik** under navigeringsfältet som fälls ihop när du scrollar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezinme çubuğunun altında, kaydırdıkça katlanan **34 pt büyük başlık**"
          }
        }
      }
    },
    "내비바 아래 **34pt 대형 제목**. 스크롤하면 작은 inline 제목으로 자동 축소.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **34pt large title** below the navigation bar. It automatically shrinks to a small inline title as you scroll."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **34pt large title** below the navigation bar. It automatically shrinks to a small inline title as you scroll."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションバーの下に**34ptの大きいタイトル**。スクロールすると小さなinlineタイトルに自動で縮む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航栏下方的 **34pt 大标题**。滚动时自动缩成小的 inline 标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導覽列下方的 **34pt 大標題**。滾動時自動縮成小的 inline 標題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Крупный заголовок 34 pt** под панелью навигации. При прокрутке автоматически сжимается до маленького inline-заголовка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **título grande de 34 pt** bajo la barra de navegación. Se reduce automáticamente a un título inline pequeño al desplazar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein **34-pt-Large-Titel** unter der Navigationsleiste. Beim Scrollen schrumpft er automatisch zu einem kleinen Inline-Titel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **grand titre de 34 pt** sous la barre de navigation. Il rétrécit automatiquement en petit titre inline au défilement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un **titolo grande da 34 pt** sotto la barra di navigazione. Si rimpicciolisce automaticamente in un piccolo titolo inline durante lo scorrimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um **título grande de 34 pt** abaixo da barra de navegação. Encolhe automaticamente para um pequeno título inline ao rolar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ชื่อเรื่องขนาดใหญ่ 34pt** ใต้แถบนำทาง มันหดเป็นชื่อเรื่อง inline เล็กโดยอัตโนมัติเมื่อเลื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tiêu đề lớn 34pt** dưới thanh điều hướng. Nó tự thu nhỏ thành tiêu đề inline nhỏ khi cuộn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**34pt velký nadpis** pod navigačním panelem. Při posouvání se automaticky zmenší na malý inline nadpis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En **34 pt stor titel** under navigationsbjælken. Den skrumper automatisk til en lille inline-titel, mens du scroller."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας **μεγάλος τίτλος 34 pt** κάτω από τη γραμμή πλοήγησης. Μικραίνει αυτόματα σε μικρό inline τίτλο καθώς κυλάς."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**34 pt:n suuri otsikko** navigointipalkin alapuolella. Se kutistuu automaattisesti pieneksi inline-otsikoksi vieritettäessä."
