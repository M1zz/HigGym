          }
        }
      }
    },
    "시스템 툴바보다 눈에 띄고 브랜드 색을 입히기도 좋아 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stands out more than the system toolbar and seems like a better canvas for the brand color."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It stands out more than the system toolbar and seems like a better canvas for the brand colour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのツールバーより目立ち、ブランドカラーも乗せやすそうに見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比系统工具栏更显眼，也好上品牌色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比系統工具列更顯眼，也好上品牌色。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она заметнее системной панели инструментов и кажется лучшим холстом для фирменного цвета."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca más que la barra de herramientas del sistema y parece un mejor lienzo para el color de marca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er fällt mehr auf als die System-Symbolleiste und scheint eine bessere Leinwand für die Markenfarbe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ressort plus que la barre d'outils système et semble une meilleure toile pour la couleur de marque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risalta più della barra degli strumenti di sistema e sembra una tela migliore per il colore del marchio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Destaca-se mais que a barra de ferramentas do sistema e parece uma tela melhor para a cor da marca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันเด่นกว่าแถบเครื่องมือของระบบและดูเป็นแคนวาสที่ดีกว่าสำหรับสีแบรนด์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó nổi bật hơn thanh công cụ hệ thống và có vẻ là tấm toan tốt hơn cho màu thương hiệu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Víc vyčnívá než systémový panel nástrojů a zdá se lepším plátnem pro barvu značky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den skiller sig mere ud end systemets værktøjslinje og virker som et bedre lærred til brandfarven."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεχωρίζει περισσότερο από τη γραμμή εργαλείων του συστήματος και φαίνεται καλύτερος καμβάς για το χρώμα του brand."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se erottuu enemmän kuin järjestelmän työkalupalkki ja näyttää paremmalta kankaalta brändivärille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia lebih menonjol daripada bilah alat sistem dan tampaknya kanvas yang lebih baik untuk warna merek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den skiller seg mer ut enn systemverktøylinjen og ser ut som et bedre lerret for merkefargen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij valt meer op dan de systeemwerkbalk en lijkt een beter canvas voor de merkkleur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyróżnia się bardziej niż systemowy pasek narzędzi i wydaje się lepszym płótnem dla koloru marki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sticker ut mer än systemets verktygsfält och verkar vara en bättre duk för varumärkesfärgen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem araç çubuğundan daha çok öne çıkar ve marka rengi için daha iyi bir tuval gibi görünür."
          }
        }
      }
    },
    "시스템 툴바의 버튼은 작고 차분해서 덜 눈에 띈다. 떠 있는 원은 크고, 브랜드 색을 입히기 좋고, 화면의 주인공처럼 보인다. 유일한 액션이니 가장 눈에 띄게 만드는 게 친절해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons in the system toolbar are small and understated, so they stand out less. A floating circle is big, easy to dress in the brand color, and looks like the star of the screen. Since it's the only action, making it as visible as possible seems like the considerate thing to do."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons in the system toolbar are small and understated, so they stand out less. A floating circle is big, easy to dress in the brand colour, and looks like the star of the screen. Since it's the only action, making it as visible as possible seems like the considerate thing to do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのツールバーのボタンは小さく控えめなので、あまり目立たない。浮かんだ丸は大きく、ブランドカラーも乗せやすく、画面の主役のように見える。唯一のアクションなのだから、いちばん目立たせるのが親切に思える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统工具栏的按钮小而沉稳，不太显眼。悬浮的圆形大，好上品牌色，看起来像界面的主角。既然是唯一的操作，做得最显眼似乎才友好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統工具列的按鈕小而沉穩，不太顯眼。懸浮的圓形大，好上品牌色，看起來像介面的主角。既然是唯一的操作，做得最顯眼似乎才友好。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки системной панели инструментов маленькие и сдержанные, поэтому менее заметные. Парящий круг большой, его легко одеть в фирменный цвет, и он выглядит главным героем экрана. Раз действие единственное, сделать его как можно заметнее кажется заботливым."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones de la barra de herramientas del sistema son pequeños y discretos, así que destacan menos. Un círculo flotante es grande, fácil de vestir con el color de marca, y parece el protagonista de la pantalla. Como es la única acción, hacerla lo más visible posible parece lo considerado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons in der System-Symbolleiste sind klein und zurückhaltend, fallen also weniger auf. Ein schwebender Kreis ist groß, lässt sich leicht in die Markenfarbe kleiden und wirkt wie der Star des Bildschirms. Da es die einzige Aktion ist, scheint es rücksichtsvoll, sie so sichtbar wie möglich zu machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boutons de la barre d'outils système sont petits et discrets, donc ils ressortent moins. Un cercle flottant est grand, facile à habiller de la couleur de marque, et ressemble à la vedette de l'écran. Comme c'est la seule action, la rendre aussi visible que possible semble la chose attentionnée à faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pulsanti nella barra degli strumenti di sistema sono piccoli e sobri, quindi risaltano meno. Un cerchio fluttuante è grande, facile da vestire con il colore del marchio e sembra la protagonista della schermata. Poiché è l'unica azione, renderla il più visibile possibile sembra la cosa premurosa da fare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os botões da barra de ferramentas do sistema são pequenos e discretos, então se destacam menos. Um círculo flutuante é grande, fácil de vestir com a cor da marca e parece a estrela da tela. Como é a única ação, torná-la o mais visível possível parece a coisa atenciosa a fazer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มในแถบเครื่องมือของระบบเล็กและเรียบ จึงเด่นน้อยกว่า วงกลมลอยใหญ่ แต่งสีแบรนด์ง่าย และดูเป็นพระเอกของหน้าจอ เมื่อเป็นการกระทำเดียว การทำให้มองเห็นให้มากที่สุดดูเหมือนการใส่ใจ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nút trong thanh công cụ hệ thống nhỏ và kín đáo, nên ít nổi bật. Vòng tròn nổi thì to, dễ khoác màu thương hiệu, và trông như ngôi sao của màn hình. Vì đó là hành động duy nhất, làm nó dễ thấy nhất có vẻ là chu đáo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítka v systémovém panelu nástrojů jsou malá a nenápadná, takže méně vyčnívají. Plovoucí kruh je velký, snadno se oblékne do barvy značky a vypadá jako hvězda obrazovky. Protože je to jediná akce, udělat ji co nejviditelnější se zdá ohleduplné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper i systemets værktøjslinje er små og afdæmpede, så de skiller sig mindre ud. En flydende cirkel er stor, let at klæde i brandfarven og ligner skærmens stjerne. Da den er den eneste handling, virker det hensynsfuldt at gøre den så synlig som muligt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κουμπιά στη γραμμή εργαλείων του συστήματος είναι μικρά και διακριτικά, οπότε ξεχωρίζουν λιγότερο. Ένας πλωτός κύκλος είναι μεγάλος, εύκολο να ντυθεί με το χρώμα του brand, και μοιάζει με τον πρωταγωνιστή της οθόνης. Εφόσον είναι η μόνη ενέργεια, το να την κάνεις όσο πιο ορατή γίνεται φαίνεται το ευγενικό."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmän työkalupalkin painikkeet ovat pieniä ja hillittyjä, joten ne erottuvat vähemmän. Kelluva ympyrä on iso, helppo pukea brändiväriin ja näyttää näkymän tähdeltä. Koska se on ainoa toiminto, sen tekeminen mahdollisimman näkyväksi tuntuu huomaavaiselta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol di bilah alat sistem kecil dan bersahaja, jadi kurang menonjol. Lingkaran mengambang besar, mudah didandani dengan warna merek, dan tampak seperti bintang layar. Karena ia satu-satunya aksi, membuatnya sejelas mungkin tampak sebagai sikap penuh pertimbangan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper i systemverktøylinjen er små og tilbakeholdne, så de skiller seg mindre ut. En flytende sirkel er stor, lett å kle i merkefargen, og ser ut som skjermens stjerne. Siden det er den eneste handlingen, virker det omtenksomt å gjøre den så synlig som mulig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoppen in de systeemwerkbalk zijn klein en ingetogen, dus ze vallen minder op. Een zwevende cirkel is groot, makkelijk in merkkleur te kleden en lijkt de ster van het scherm. Omdat het de enige actie is, lijkt het zo zichtbaar mogelijk maken het attente om te doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyciski w systemowym pasku narzędzi są małe i stonowane, więc mniej się wyróżniają. Unoszące się kółko jest duże, łatwe do ubrania w kolor marki i wygląda jak gwiazda ekranu. Skoro to jedyna akcja, uczynienie jej jak najbardziej widoczną wydaje się troskliwe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knappar i systemets verktygsfält är små och återhållsamma, så de sticker ut mindre. En svävande cirkel är stor, lätt att klä i varumärkesfärgen och ser ut som skärmens stjärna. Eftersom det är den enda åtgärden verkar det omtänksamt att göra den så synlig som möjligt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem araç çubuğundaki düğmeler küçük ve sade, bu yüzden daha az öne çıkar. Yüzen bir daire büyüktür, marka rengine boyaması kolaydır ve ekranın yıldızı gibi görünür. Tek eylem olduğu için mümkün olduğunca görünür yapmak düşünceli bir şey gibi gelir."
          }
        }
      }
    },
    "시스템의 제목 메뉴(`toolbarTitleMenu`)를 써서 제목 옆에 ⌄ 표시가 붙게 둔다. 제목은 여전히 화면의 이름을 말하고, 동시에 \"눌러서 바꿀 수 있는 대상\"이라는 것도 말한다. 폴더를 바꾸려는 사람은 툴바를 뒤지지 않고 제목을 누른다. 1.2.5 Inline with Toolbar Title Menu 예제를 열어 표시가 붙은 제목이 어떻게 보이는지 확인해 보라. 표시 하나가 화면을 어지럽히지 않는다는 것도 함께 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the system title menu (`toolbarTitleMenu`) and let it attach the ⌄ next to the title. The title still names the screen, and at the same time says it's \"something you can tap to change.\" People who want to switch folders tap the title instead of digging through the toolbar. Open the 1.2.5 Inline with Toolbar Title Menu example to see how a title with the indicator looks. You'll also see that one small indicator doesn't clutter the screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the system title menu (`toolbarTitleMenu`) and let it attach the ⌄ next to the title. The title still names the screen, and at the same time says it's \"something you can tap to change.\" People who want to switch folders tap the title instead of digging through the toolbar. Open the 1.2.5 Inline with Toolbar Title Menu example to see how a title with the indicator looks. You'll also see that one small indicator doesn't clutter the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのタイトルメニュー（`toolbarTitleMenu`）を使い、タイトルの横に ⌄ が付くようにする。タイトルは引き続き画面の名前を伝え、同時に「押して切り替えられる対象」であることも伝える。フォルダを変えたい人はツールバーを探し回らず、タイトルを押す。1.2.5 Inline with Toolbar Title Menu の例を開いて、表示の付いたタイトルがどう見えるかを確かめてみよう。表示ひとつで画面が散らからないことも一緒に分かる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用系统的标题菜单（`toolbarTitleMenu`），让标题旁出现 ⌄ 标记。标题仍然在说界面的名字，同时也在说它是“点按可以更换的对象”。想换文件夹的人不用翻工具栏，直接点标题。打开 1.2.5 Inline with Toolbar Title Menu 示例，看看带标记的标题是什么样。也能同时看到，一个标记不会弄乱界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用系統的標題選單（`toolbarTitleMenu`），讓標題旁出現 ⌄ 標記。標題仍然在說介面的名字，同時也在說它是「輕點可以更換的物件」。想換資料夾的人不用翻工具列，直接點標題。開啟 1.2.5 Inline with Toolbar Title Menu 示例，看看帶標記的標題是什麼樣。也能同時看到，一個標記不會弄亂介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте системное меню заголовка (`toolbarTitleMenu`) и позвольте ему поставить ⌄ рядом с заголовком. Заголовок по-прежнему называет экран и одновременно говорит, что это «то, что можно нажать, чтобы изменить». Те, кто хочет сменить папку, нажимают на заголовок, а не роются в панели инструментов. Откройте пример 1.2.5 Inline with Toolbar Title Menu, чтобы увидеть, как выглядит заголовок с индикатором. Вы также увидите, что один небольшой индикатор экран не загромождает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el menú de título del sistema (`toolbarTitleMenu`) y deja que añada el ⌄ junto al título. El título sigue nombrando la pantalla y a la vez dice que es «algo que puedes tocar para cambiar». Quienes quieren cambiar de carpeta tocan el título en lugar de rebuscar en la barra de herramientas. Abre el ejemplo 1.2.5 Inline with Toolbar Title Menu para ver cómo luce un título con el indicador. También verás que un pequeño indicador no satura la pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze das System-Titelmenü (`toolbarTitleMenu`) und lass es das ⌄ neben dem Titel anbringen. Der Titel benennt weiter den Bildschirm und sagt zugleich, dass er „etwas ist, das man antippen kann, um zu wechseln“. Wer den Ordner wechseln will, tippt den Titel an, statt in der Symbolleiste zu suchen. Öffne das Beispiel 1.2.5 Inline with Toolbar Title Menu, um zu sehen, wie ein Titel mit Indikator aussieht. Du siehst auch, dass ein kleiner Indikator den Bildschirm nicht überlädt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le menu de titre système (`toolbarTitleMenu`) et laissez-le attacher le ⌄ à côté du titre. Le titre nomme toujours l'écran, et dit en même temps qu'il est « quelque chose que l'on peut toucher pour changer ». Les gens qui veulent changer de dossier touchent le titre au lieu de fouiller dans la barre d'outils. Ouvrez l'exemple 1.2.5 Inline with Toolbar Title Menu pour voir l'aspect d'un titre avec l'indicateur. Vous verrez aussi qu'un petit indicateur n'encombre pas l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il menu del titolo di sistema (`toolbarTitleMenu`) e lascia che agganci il ⌄ accanto al titolo. Il titolo continua a nominare la schermata e, allo stesso tempo, dice che è «qualcosa che puoi toccare per cambiare». Chi vuole cambiare cartella tocca il titolo invece di frugare nella barra degli strumenti. Apri l'esempio 1.2.5 Inline con menu del titolo per vedere come appare un titolo con l'indicatore. Vedrai anche che un piccolo indicatore non ingombra la schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o menu do título do sistema (`toolbarTitleMenu`) e deixe que ele prenda o ⌄ ao lado do título. O título continua nomeando a tela e, ao mesmo tempo, diz que é «algo em que você pode tocar para mudar». Quem quer trocar de pasta toca no título em vez de fuçar na barra de ferramentas. Abra o exemplo 1.2.5 Inline com menu do título para ver como fica um título com o indicador. Você verá também que um pequeno indicador não entulha a tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เมนูชื่อเรื่องของระบบ (`toolbarTitleMenu`) และให้มันผูก ⌄ ไว้ข้างชื่อเรื่อง ชื่อเรื่องยังบอกชื่อหน้าจอ และในเวลาเดียวกันบอกว่าเป็น \"สิ่งที่แตะเพื่อเปลี่ยนได้\" คนที่อยากสลับโฟลเดอร์แตะชื่อเรื่องแทนการงมหาในแถบเครื่องมือ เปิดตัวอย่าง 1.2.5 Inline with Toolbar Title Menu เพื่อดูว่าชื่อเรื่องที่มีตัวบ่งชี้เป็นอย่างไร คุณจะเห็นด้วยว่าตัวบ่งชี้เล็ก ๆ อันเดียวไม่ทำให้หน้าจอรก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng menu tiêu đề hệ thống (`toolbarTitleMenu`) và để nó gắn ⌄ cạnh tiêu đề. Tiêu đề vẫn gọi tên màn hình, đồng thời nói rằng đó là \"thứ bạn có thể chạm để đổi.\" Người muốn chuyển thư mục chạm tiêu đề thay vì lục trong thanh công cụ. Mở ví dụ 1.2.5 Inline with Toolbar Title Menu để xem tiêu đề có chỉ báo trông ra sao. Bạn cũng sẽ thấy một chỉ báo nhỏ không làm rối màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte systémovou nabídku nadpisu (`toolbarTitleMenu`) a nechte ji připojit ⌄ vedle nadpisu. Nadpis stále pojmenovává obrazovku a zároveň říká, že je „něco, na co můžete klepnout a změnit“. Lidé, kteří chtějí přepnout složky, klepnou na nadpis místo hrabání v panelu nástrojů. Otevřete příklad 1.2.5 Inline with Toolbar Title Menu a uvidíte, jak nadpis s indikátorem vypadá. Také uvidíte, že jeden malý indikátor obrazovku nezaplní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug systemets titelmenu (`toolbarTitleMenu`), og lad den sætte ⌄ ved siden af titlen. Titlen navngiver stadig skærmen og siger samtidig, at den er »noget, du kan trykke på for at ændre.« Folk, der vil skifte mappe, trykker på titlen i stedet for at grave i værktøjslinjen. Åbn eksempel 1.2.5 Inline med titelmenu i værktøjslinjen for at se, hvordan en titel med indikatoren ser ud. Du vil også se, at én lille indikator ikke roder skærmen til."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε το μενού τίτλου του συστήματος (`toolbarTitleMenu`) και άφησέ το να προσαρτήσει το ⌄ δίπλα στον τίτλο. Ο τίτλος εξακολουθεί να ονομάζει την οθόνη, και ταυτόχρονα λέει ότι είναι «κάτι που μπορείς να πατήσεις για να αλλάξεις». Οι άνθρωποι που θέλουν να αλλάξουν φάκελο πατούν τον τίτλο αντί να ψάχνουν στη γραμμή εργαλείων. Άνοιξε το παράδειγμα 1.2.5 Inline με μενού τίτλου γραμμής εργαλείων για να δεις πώς φαίνεται ένας τίτλος με τον δείκτη. Θα δεις επίσης ότι ένας μικρός δείκτης δεν γεμίζει την οθόνη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä järjestelmän otsikkovalikkoa (`toolbarTitleMenu`) ja anna sen liittää ⌄ otsikon viereen. Otsikko nimeää edelleen näkymän ja samalla sanoo, että se on ”jotain, mitä voit napauttaa vaihtaaksesi”. Ihmiset, jotka haluavat vaihtaa kansiota, napauttavat otsikkoa kaivelun sijaan työkalupalkissa. Avaa esimerkki 1.2.5 Inline työkalupalkin otsikkovalikolla nähdäksesi, miltä otsikko ilmaisimella näyttää. Näet myös, ettei yksi pieni ilmaisin sotke näkymää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai menu judul sistem (`toolbarTitleMenu`) dan biarkan ia menempelkan ⌄ di sebelah judul. Judul tetap menamai layar, dan sekaligus berkata ia \"sesuatu yang bisa diketuk untuk mengubah.\" Orang yang ingin berpindah folder mengetuk judul alih-alih menggali bilah alat. Buka contoh 1.2.5 Inline with Toolbar Title Menu untuk melihat bagaimana judul dengan indikator tampil. Kamu juga akan melihat bahwa satu indikator kecil tidak menjejali layar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk systemets tittelmeny (`toolbarTitleMenu`) og la den feste ⌄ ved siden av tittelen. Tittelen navngir fortsatt skjermen, og sier samtidig at den er «noe du kan trykke på for å endre». Folk som vil bytte mappe trykker på tittelen i stedet for å grave i verktøylinjen. Åpne eksempelet 1.2.5 Inline with Toolbar Title Menu for å se hvordan en tittel med indikatoren ser ut. Du ser også at én liten indikator ikke roter til skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik het systeemtitelmenu (`toolbarTitleMenu`) en laat het de ⌄ naast de titel koppelen. De titel benoemt nog steeds het scherm, en zegt tegelijk dat het \"iets is waarop je kunt tikken om te wijzigen\". Mensen die van map willen wisselen, tikken op de titel in plaats van door de werkbalk te graven. Open het voorbeeld 1.2.5 Inline met titelmenu in de werkbalk om te zien hoe een titel met de indicator eruitziet. Je ziet ook dat één kleine indicator het scherm niet vervuilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj systemowego menu tytułu (`toolbarTitleMenu`) i pozwól mu podpiąć ⌄ obok tytułu. Tytuł nadal nazywa ekran i jednocześnie mówi, że to „coś, w co można stuknąć, by zmienić”. Ludzie, którzy chcą przełączyć folder, stukają tytuł zamiast grzebać w pasku narzędzi. Otwórz przykład 1.2.5 Inline z menu tytułu w pasku narzędzi, by zobaczyć, jak wygląda tytuł ze wskaźnikiem. Zobaczysz też, że jeden mały wskaźnik nie zaśmieca ekranu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd systemets rubrikmeny (`toolbarTitleMenu`) och låt den fästa ⌄ bredvid rubriken. Rubriken namnger fortfarande skärmen, och säger samtidigt att den är ”något du kan trycka på för att ändra”. Folk som vill byta mapp trycker på rubriken i stället för att leta i verktygsfältet. Öppna exemplet 1.2.5 Inline with Toolbar Title Menu för att se hur en rubrik med indikatorn ser ut. Du ser också att en liten indikator inte belamrar skärmen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem başlık menüsünü (`toolbarTitleMenu`) kullan ve ⌄'yi başlığın yanına onun eklemesine izin ver. Başlık yine ekranı adlandırır ve aynı zamanda “değiştirmek için dokunabileceğin bir şey” olduğunu söyler. Klasör değiştirmek isteyenler araç çubuğunu kurcalamak yerine başlığa dokunur. Göstergeli bir başlığın nasıl göründüğünü görmek için 1.2.5 Inline with Toolbar Title Menu örneğini aç. Küçük bir göstergenin ekranı dağıtmadığını da göreceksin."
          }
        }
      }
    },
    "시스템이 맞춰 주는 것은 **자리**이지 **내용**이 아니다. 좁은 폭에서 탭 라벨과 액세서리 안의 글자가 어떻게 줄어들지는 앱이 결정해야 하고, 결정하지 않으면 잘림이 대신 결정한다. 고정 px 높이는 기기가 작거나 Dynamic Type 이 커지면 내용보다 작아진다. 두 경우 모두 **큰 화면에서는 보이지 않는 문제**라서, 작은 화면에서 한 번 열어 보지 않으면 만날 일이 없다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system adjusts is **the placement**, not **the content**. How the text in the tab labels and the accessory shrinks at narrow widths is for the app to decide, and if it doesn't decide, truncation decides instead. A fixed pixel height ends up smaller than the content when the device is small or Dynamic Type is large. Both are **problems you can't see on a large screen**, so unless you open the app once on a small screen, you'll never run into them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system adjusts is **the placement**, not **the content**. How the text in the tab labels and the accessory shrinks at narrow widths is for the app to decide, and if it doesn't decide, truncation decides instead. A fixed pixel height ends up smaller than the content when the device is small or Dynamic Type is large. Both are **problems you can't see on a large screen**, so unless you open the app once on a small screen, you'll never run into them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが合わせてくれるのは**場所**であって**中身**ではない。狭い幅でタブのラベルやアクセサリの中の文字がどう縮むかはアプリが決めなければならず、決めなければ切り詰めが代わりに決める。固定 px の高さは、端末が小さかったり Dynamic Type が大きくなったりすると、コンテンツより小さくなる。どちらも**大きい画面では見えない問題**なので、小さい画面で一度開いてみなければ出会うことがない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统帮你对齐的是**位置**，不是**内容**。在窄宽度下，标签文字和附件内的文字怎样缩减，要由应用来决定，不决定的话，由截断代为决定。固定 px 高度在设备较小或 Dynamic Type 变大时，会比内容还小。两种情况都是**在大屏幕上看不出的问题**，所以不在小屏幕上打开一次，就遇不到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統幫你對齊的是**位置**，不是**內容**。在窄寬度下，標籤文字和附件內的文字怎樣縮減，要由應用程式來決定，不決定的話，由截斷代為決定。固定 px 高度在裝置較小或 Dynamic Type 變大時，會比內容還小。兩種情況都是**在大螢幕上看不出的問題**，所以不在小螢幕上開啟一次，就遇不到。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система подстраивает **расположение**, а не **содержимое**. Как сжимается текст в подписях вкладок и в accessory при узкой ширине, должно решать приложение, а если оно не решит, решит обрезка. Фиксированная высота в пикселях оказывается меньше содержимого, когда устройство маленькое или Dynamic Type крупный. Оба случая - **проблемы, которых не видно на большом экране**, так что пока вы хотя бы раз не откроете приложение на маленьком экране, вы с ними не столкнётесь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el sistema ajusta es **la colocación**, no **el contenido**. Cómo se encoge el texto de las etiquetas de pestañas y del accesorio con anchos estrechos lo decide la app, y si no lo decide, lo decide el truncamiento. Una altura fija en píxeles acaba siendo menor que el contenido cuando el dispositivo es pequeño o Dynamic Type es grande. Ambos son **problemas que no se ven en una pantalla grande**, así que a menos que abras la app una vez en una pantalla pequeña, nunca te toparás con ellos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was das System anpasst, ist **die Platzierung**, nicht **der Inhalt**. Wie der Text in den Tab-Beschriftungen und im Accessory bei schmaler Breite schrumpft, entscheidet die App, und entscheidet sie nicht, entscheidet stattdessen das Abschneiden. Eine feste Pixelhöhe wird kleiner als der Inhalt, wenn das Gerät klein oder Dynamic Type groß ist. Beides sind **Probleme, die man auf einem großen Bildschirm nicht sieht**, also stößt man nie darauf, wenn man die App nicht einmal auf einem kleinen Bildschirm öffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que le système ajuste, c'est **le placement**, pas **le contenu**. La façon dont le texte des libellés d'onglets et de l'accessoire rétrécit aux faibles largeurs revient à l'app, et si elle ne décide pas, c'est la troncature qui décide à sa place. Une hauteur fixe en pixels finit plus petite que le contenu quand l'appareil est petit ou que Dynamic Type est grand. Les deux sont des **problèmes invisibles sur un grand écran**, donc à moins d'ouvrir l'app une fois sur un petit écran, vous ne les rencontrerez jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che il sistema regola è **la collocazione**, non **il contenuto**. Come si rimpicciolisce il testo delle etichette delle schede e dell'accessorio a larghezze strette lo decide l'app, e se non lo decide, decide il troncamento al suo posto. Un'altezza in pixel fissi finisce per essere più piccola del contenuto quando il dispositivo è piccolo o Dynamic Type è grande. Entrambi sono **problemi che non si vedono su uno schermo grande**, quindi a meno che tu non apra l'app una volta su uno schermo piccolo, non li incontrerai mai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o sistema ajusta é **a colocação**, não **o conteúdo**. Como o texto dos rótulos das abas e do acessório encolhe em larguras estreitas é o app que decide, e se ele não decide, o truncamento decide no lugar. Uma altura de pixel fixa acaba menor que o conteúdo quando o dispositivo é pequeno ou o Dynamic Type é grande. Ambos são **problemas que você não vê numa tela grande**, então, a menos que abra o app uma vez numa tela pequena, nunca os encontrará."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ระบบปรับคือ**การวางตำแหน่ง** ไม่ใช่**เนื้อหา** ข้อความในป้ายชื่อแท็บและอุปกรณ์เสริมหดอย่างไรที่ความกว้างแคบเป็นเรื่องที่แอปต้องตัดสินใจ และถ้าไม่ตัดสินใจ การตัดจะตัดสินแทน ความสูงพิกเซลตายตัวลงเอยเล็กกว่าเนื้อหาเมื่ออุปกรณ์เล็กหรือ Dynamic Type ใหญ่ ทั้งสองเป็น**ปัญหาที่เห็นไม่ได้บนหน้าจอใหญ่** ดังนั้นถ้าไม่เปิดแอปบนหน้าจอเล็กสักครั้ง คุณจะไม่เจอเลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều hệ thống điều chỉnh là **vị trí**, không phải **nội dung**. Cách chữ trong nhãn tab và phụ kiện co lại ở độ rộng hẹp là việc của app quyết, và nếu app không quyết thì việc cắt quyết thay. Chiều cao pixel cố định hóa ra nhỏ hơn nội dung khi thiết bị nhỏ hoặc Dynamic Type lớn. Cả hai là **vấn đề bạn không thấy trên màn hình lớn**, nên nếu không mở app một lần trên màn hình nhỏ, bạn sẽ không bao giờ gặp."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co systém upravuje, je **umístění**, ne **obsah**. Jak se text v popiscích karet a příslušenství zmenšuje při úzkých šířkách, je na aplikaci, a pokud nerozhodne, rozhodne místo ní ořez. Pevná výška v pixelech skončí menší než obsah, když je zařízení malé nebo je Dynamic Type velký. Obojí jsou **problémy, které na velké obrazovce neuvidíte**, takže pokud aplikaci jednou neotevřete na malé obrazovce, nikdy na ně nenarazíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, systemet justerer, er **placeringen**, ikke **indholdet**. Hvordan teksten i fanemærkaterne og tilbehøret skrumper ved smalle bredder, er op til appen, og hvis den ikke beslutter det, beslutter afkortning i stedet. En fast pixelhøjde ender med at være mindre end indholdet, når enheden er lille, eller Dynamic Type er stor. Begge er **problemer, du ikke kan se på en stor skærm**, så medmindre du åbner appen én gang på en lille skærm, løber du aldrig ind i dem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό που προσαρμόζει το σύστημα είναι **η τοποθέτηση**, όχι **το περιεχόμενο**. Το πώς σμικρύνεται το κείμενο στις ετικέτες καρτελών και το εξάρτημα σε στενά πλάτη είναι για την εφαρμογή να αποφασίσει, και αν δεν αποφασίσει, αποφασίζει η περικοπή. Ένα σταθερό ύψος pixel καταλήγει μικρότερο από το περιεχόμενο όταν η συσκευή είναι μικρή ή το Dynamic Type μεγάλο. Και τα δύο είναι **προβλήματα που δεν βλέπεις σε μεγάλη οθόνη**, οπότε αν δεν ανοίξεις την εφαρμογή μία φορά σε μικρή οθόνη, δεν θα τα συναντήσεις ποτέ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmä säätää **sijoituksen**, ei **sisältöä**. Se, miten välilehtien nimikkeiden ja accessoryn teksti kutistuu kapeilla leveyksillä, on sovelluksen päätettävä, ja jos se ei päätä, katkaisu päättää sen sijaan. Kiinteä pikselikorkeus jää sisältöä pienemmäksi, kun laite on pieni tai Dynamic Type on suuri. Molemmat ovat **ongelmia, joita ei näe suurella näytöllä**, joten ellet avaa sovellusta kerran pienellä näytöllä, et koskaan kohtaa niitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang disesuaikan sistem adalah **penempatan**, bukan **isi**. Bagaimana teks di label tab dan accessory menyusut pada lebar sempit adalah keputusan aplikasi, dan jika tidak diputuskan, pemotonganlah yang memutuskan. Tinggi piksel tetap berakhir lebih kecil daripada isinya saat perangkat kecil atau Dynamic Type besar. Keduanya adalah **masalah yang tak terlihat di layar besar**, jadi kecuali kamu membuka aplikasi sekali di layar kecil, kamu tak akan pernah menemuinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det systemet justerer er **plasseringen**, ikke **innholdet**. Hvordan teksten i faneetikettene og accessoryen krymper ved smale bredder er opp til appen å avgjøre, og hvis den ikke avgjør, avgjør avkorting i stedet. En fast pikselhøyde ender opp mindre enn innholdet når enheten er liten eller Dynamic Type er stor. Begge er **problemer du ikke ser på en stor skjerm**, så med mindre du åpner appen én gang på en liten skjerm, støter du aldri på dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat het systeem aanpast is **de plaatsing**, niet **de inhoud**. Hoe de tekst in de tablabels en het accessoire bij smalle breedtes krimpt, is aan de app om te beslissen, en als hij dat niet beslist, beslist afkappen in zijn plaats. Een vaste pixelhoogte blijft kleiner dan de inhoud als het apparaat klein is of Dynamic Type groot. Beide zijn **problemen die je op een groot scherm niet ziet**, dus tenzij je de app één keer op een klein scherm opent, loop je er nooit tegenaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co system dostosowuje, to **rozmieszczenie**, a nie **treść**. To, jak tekst w etykietach kart i akcesorium kurczy się przy wąskich szerokościach, należy do aplikacji, a jeśli ona nie zdecyduje, zdecyduje zamiast niej obcinanie. Stała wysokość w pikselach kończy się mniejsza niż treść, gdy urządzenie jest małe lub Dynamic Type duży. Oba to **problemy, których nie widać na dużym ekranie**, więc jeśli nie otworzysz aplikacji raz na małym ekranie, nigdy na nie nie trafisz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det systemet justerar är **placeringen**, inte **innehållet**. Hur texten i fliketiketterna och tillbehöret krymper vid smala bredder är upp till appen att avgöra, och om den inte avgör avgör kapning i stället. En fast pixelhöjd blir mindre än innehållet när enheten är liten eller Dynamic Type är stor. Båda är **problem du inte ser på en stor skärm**, så om du inte öppnar appen en gång på en liten skärm stöter du aldrig på dem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin ayarladığı şey **yerleşimdir**, **içerik** değil. Sekme etiketlerindeki ve aksesuardaki metnin dar genişliklerde nasıl küçüleceğine uygulama karar verir ve karar vermezse bunu kesilme belirler. Sabit bir piksel yüksekliği, cihaz küçük ya da Dinamik Yazı Tipi büyük olduğunda içerikten küçük kalır. İkisi de **büyük ekranda göremeyeceğin sorunlardır**, bu yüzden uygulamayı bir kez küçük bir ekranda açmazsan onlarla hiç karşılaşmazsın."
          }
        }
      }
    },
    "시스템이 무언가를 접거나 자르면, 그건 대개 제약이 아니라 **경고**다. 우회하기 전에 무엇을 경고하는지 먼저 읽는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the system folds or truncates something, it's usually not a limitation but a **warning**. Before working around it, read what it's warning you about."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the system folds or truncates something, it's usually not a limitation but a **warning**. Before working around it, read what it's warning you about."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが何かを折りたたんだり切ったりしたら、それはたいてい制約ではなく**警告**だ。回避する前に、何を警告しているのかをまず読む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统把什么折叠或截断了，通常不是限制，而是**警告**。绕开之前，先读它在警告什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統把什麼摺疊或截斷了，通常不是限制，而是**警告**。繞開之前，先讀它在警告什麼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда система что-то сворачивает или обрезает, это обычно не ограничение, а **предупреждение**. Прежде чем обходить, прочтите, о чём оно предупреждает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el sistema pliega o trunca algo, normalmente no es una limitación sino **un aviso**. Antes de esquivarlo, lee de qué te está avisando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltet oder schneidet das System etwas ab, ist das meist keine Einschränkung, sondern eine **Warnung**. Lies, wovor sie warnt, bevor du sie umgehst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le système replie ou tronque quelque chose, ce n'est généralement pas une limitation mais un **avertissement**. Avant de le contourner, lisez ce dont il vous avertit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il sistema ripiega o tronca qualcosa, di solito non è un limite ma un **avvertimento**. Prima di aggirarlo, leggi di cosa ti sta avvertendo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o sistema dobra ou trunca algo, em geral não é uma limitação mas um **aviso**. Antes de contorná-lo, leia do que ele está avisando."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อระบบพับหรือตัดบางอย่าง มักไม่ใช่ข้อจำกัดแต่เป็น**คำเตือน** ก่อนหาทางอ้อม ให้อ่านว่ามันเตือนอะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi hệ thống gập hoặc cắt thứ gì đó, thường đó không phải hạn chế mà là **một lời cảnh báo**. Trước khi vòng qua, hãy đọc nó đang cảnh báo điều gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když systém něco sbalí nebo ořízne, obvykle to není omezení, ale **varování**. Než to obejdete, přečtěte si, před čím varuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når systemet folder eller afkorter noget, er det som regel ikke en begrænsning men en **advarsel**. Før du omgår det, så læs, hvad det advarer dig om."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το σύστημα διπλώνει ή περικόπτει κάτι, συνήθως δεν είναι περιορισμός αλλά **προειδοποίηση**. Πριν το παρακάμψεις, διάβασε για τι σε προειδοποιεί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun järjestelmä taittaa tai katkaisee jotain, kyse on yleensä ei rajoituksesta vaan **varoituksesta**. Ennen kuin kierrät sen, lue, mistä se varoittaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat sistem melipat atau memotong sesuatu, biasanya itu bukan keterbatasan melainkan **peringatan**. Sebelum menyiasatinya, baca apa yang diperingatkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når systemet folder eller avkorter noe, er det vanligvis ikke en begrensning, men en **advarsel**. Før du jobber deg rundt det, les hva det advarer deg om."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het systeem iets inklapt of afkapt, is dat meestal geen beperking maar een **waarschuwing**. Lees voordat je eromheen werkt waarvoor het waarschuwt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy system coś zwija lub obcina, zwykle to nie ograniczenie, ale **ostrzeżenie**. Zanim go obejdziesz, przeczytaj, przed czym ostrzega."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När systemet viker eller kapar något är det oftast inte en begränsning utan en **varning**. Innan du arbetar runt det, läs vad det varnar dig för."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem bir şeyi katladığında ya da kestiğinde bu genellikle bir sınırlama değil, bir **uyarıdır**. Etrafından dolaşmadan önce neye karşı uyardığını oku."
          }
        }
      }
    },
    "시스템이 배경 대비를 관리하는 유리 위에 임의 배경을 얹으면 재질 계층이 깨지고 다크모드·투명도 감소 설정에서 대비가 예측 불가능해짐.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Placing an arbitrary background on glass whose contrast the system manages breaks the material hierarchy, and contrast becomes unpredictable in Dark Mode and with Reduce Transparency."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Placing an arbitrary background on glass whose contrast the system manages breaks the material hierarchy, and contrast becomes unpredictable in Dark Mode and with Reduce Transparency."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが背景とのコントラストを管理しているガラスの上に任意の背景を載せると、マテリアルの階層が崩れ、ダークモードや「透明度を下げる」設定でのコントラストが予測できなくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统负责管理背景对比度的玻璃上叠任意背景，材质层级就会被破坏，在深色模式、降低透明度设置下对比度变得不可预测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統負責管理背景對比度的玻璃上疊任意背景，材質層級就會被破壞，在深色模式、降低透明度設定下對比度變得不可預測。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещение произвольного фона на стекле, контраст которого управляется системой, ломает иерархию материалов, и контраст в тёмной теме и при «Уменьшении прозрачности» становится непредсказуемым."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar un fondo arbitrario sobre cristal cuyo contraste gestiona el sistema rompe la jerarquía de materiales, y el contraste se vuelve impredecible en modo oscuro y con Reducir transparencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen beliebigen Hintergrund auf Glas zu legen, dessen Kontrast das System verwaltet, bricht die Materialhierarchie, und der Kontrast wird im Dunkelmodus und mit Transparenz reduzieren unvorhersehbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poser un arrière-plan arbitraire sur du verre dont le système gère le contraste brise la hiérarchie des matériaux, et le contraste devient imprévisible en mode sombre et avec Réduire la transparence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettere uno sfondo arbitrario sul vetro il cui contrasto è gestito dal sistema rompe la gerarchia dei materiali, e il contrasto diventa imprevedibile in Modalità Scura e con Riduci trasparenza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pôr um fundo arbitrário sobre um vidro cujo contraste o sistema gerencia quebra a hierarquia de materiais, e o contraste fica imprevisível no Modo Escuro e com Reduzir Transparência."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวางพื้นหลังตามอำเภอใจบนกระจกที่ระบบจัดการความตัดกันทำลายลำดับชั้นวัสดุ และความตัดกันคาดเดาไม่ได้ในโหมดมืดและเมื่อลดความโปร่งใส"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt nền tùy ý lên kính mà độ tương phản do hệ thống quản lý sẽ phá thứ bậc vật liệu, và độ tương phản trở nên không đoán được trong Chế độ tối và với Giảm độ trong suốt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dát libovolné pozadí na sklo, jehož kontrast spravuje systém, rozbije materiálovou hierarchii a kontrast se stane nepředvídatelným v tmavém režimu a s Omezit průhlednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lægge en vilkårlig baggrund på glas, hvis kontrast systemet styrer, bryder materialehierarkiet, og kontrasten bliver uforudsigelig i mørk tilstand og med Reducer gennemsigtighed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τοποθέτηση ενός αυθαίρετου φόντου σε γυαλί του οποίου την αντίθεση διαχειρίζεται το σύστημα σπάει την ιεραρχία υλικών, και η αντίθεση γίνεται απρόβλεπτη στη Σκοτεινή εμφάνιση και με Μείωση διαφάνειας."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mielivaltaisen taustan laittaminen lasille, jonka kontrastia järjestelmä hallinnoi, rikkoo materiaalihierarkian, ja kontrastista tulee arvaamaton tummassa tilassa ja Vähennä läpinäkyvyyttä -asetuksella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menaruh latar sembarang pada kaca yang kontrasnya dikelola sistem merusak hierarki material, dan kontras menjadi tak terduga di Mode Gelap dan dengan Kurangi Transparansi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å legge en vilkårlig bakgrunn på glass der systemet forvalter kontrasten bryter materialhierarkiet, og kontrasten blir uforutsigbar i mørk modus og med Reduser gjennomsiktighet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een willekeurige achtergrond op glas plaatsen waarvan het systeem het contrast beheert, breekt de materiaalhiërarchie, en het contrast wordt onvoorspelbaar in de donkere modus en met Verminder transparantie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieszczenie dowolnego tła na szkle, którego kontrastem zarządza system, łamie hierarchię materiałów, a kontrast staje się nieprzewidywalny w trybie ciemnym i z Ogranicz przezroczystość."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att placera en godtycklig bakgrund på glas vars kontrast systemet hanterar bryter materialhierarkin, och kontrasten blir oförutsägbar i mörkt läge och med Minska transparens."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrastını sistemin yönettiği cama keyfî bir arka plan koymak malzeme hiyerarşisini bozar ve Koyu Mod'da ve Saydamlığı Azalt ile kontrast öngörülemez hale gelir."
          }
        }
      }
    },
    "시스템이 보장하는 것은 **자리의 규약**이다. 탭은 왼쪽 묶음, 검색은 오른쪽 분리 캡슐, 액세서리는 위 층. 겹치지 않게 놓아 줄 뿐, 그중 무엇이 이 앱에 필요한지는 정해 주지 않는다. 하단은 이미 가장 붐비는 자리다. 요소를 모두 켜면 각자는 규약대로 서 있어도 **하단 전체가 과밀**해지고, 콘텐츠가 눌린다.\n\n탭바가 있는 화면에서 하단 툴바 액션까지 더하면 같은 자리를 두고 경쟁하게 된다. 근거 항목도 그런 화면에서는 하단 액션을 절제하라고 적는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system guarantees is **the conventions of placement**. Tabs in a group on the left, search in a separate capsule on the right, the accessory on the layer above. It just keeps them from overlapping; it doesn't decide which of them this app needs. The bottom is already the most crowded area. Turn on every element, and even if each one stands where the conventions say, **the bottom as a whole becomes overcrowded** and the content gets squeezed.\n\nOn a screen with a tab bar, adding bottom toolbar actions as well makes them compete for the same space. The source topic also says to keep bottom actions to a minimum on such screens."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system guarantees is **the conventions of placement**. Tabs in a group on the left, search in a separate capsule on the right, the accessory on the layer above. It just keeps them from overlapping; it doesn't decide which of them this app needs. The bottom is already the most crowded area. Turn on every element, and even if each one stands where the conventions say, **the bottom as a whole becomes overcrowded** and the content gets squeezed.\n\nOn a screen with a tab bar, adding bottom toolbar actions as well makes them compete for the same space. The source topic also says to keep bottom actions to a minimum on such screens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが保証するのは**配置の取り決め**だ。タブは左のまとまり、検索は右の分離されたカプセル、アクセサリはその上の層。重ならないように置いてくれるだけで、そのうちどれがこのアプリに必要かは決めてくれない。下部はもともと最も混み合う場所だ。要素を全部オンにすると、それぞれは取り決めどおりに立っていても**下部全体が過密**になり、コンテンツが押しつぶされる。\n\nタブバーのある画面で下部ツールバーのアクションまで加えると、同じ場所を奪い合うことになる。根拠のトピックも、そうした画面では下部のアクションを控えるよう書いている。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统保证的是**位置的约定**：标签在左侧一组，搜索在右侧分离胶囊，附件在上面一层。它只负责让它们摆放时不重叠，其中哪些是这个应用需要的，它不替你决定。底部本来就是最拥挤的位置。把元素都打开，即使各自按约定站着，**整个底部也会过于拥挤**，内容被压住。\n\n在有标签栏的界面里再加上底部工具栏的操作，就会争夺同一个位置。依据条目也写着，这样的界面里要克制底部操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統保證的是**位置的約定**：標籤在左側一組，搜尋在右側分離膠囊，附件在上面一層。它只負責讓它們擺放時不重疊，其中哪些是這個應用程式需要的，它不替你決定。底部本來就是最擁擠的位置。把元素都開啟，即使各自按約定站著，**整個底部也會過於擁擠**，內容被壓住。\n\n在有標籤列的介面裡再加上底部工具列的操作，就會爭奪同一個位置。依據條目也寫著，這樣的介面裡要剋制底部操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система гарантирует **соглашения о расположении**. Вкладки группой слева, поиск отдельной капсулой справа, accessory слоем выше. Она лишь следит, чтобы они не накладывались; она не решает, какие из них нужны этому приложению. Низ - и без того самое людное место. Включите все элементы, и даже если каждый стоит по соглашениям, **низ в целом окажется перегруженным**, а контент сжат.\n\nНа экране с панелью вкладок добавление ещё и действий нижней панели инструментов заставляет их соревноваться за то же место. В исходной теме тоже сказано сдерживать нижние действия на таких экранах."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el sistema garantiza son **las convenciones de colocación**. Pestañas en grupo a la izquierda, búsqueda en una cápsula separada a la derecha, el accesorio en la capa de arriba. Solo cuida de que no se solapen; no decide cuáles necesita esta app. La parte inferior ya es la zona más concurrida. Activa todos los elementos, y aunque cada uno esté donde dicen las convenciones, **la parte inferior en conjunto queda sobrecargada** y el contenido se aprieta.\n\nEn una pantalla con barra de pestañas, añadir además acciones de la barra de herramientas inferior las hace competir por el mismo espacio. El tema fuente también dice que se mantengan al mínimo las acciones inferiores en tales pantallas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was das System garantiert, sind **die Platzierungskonventionen**. Tabs als Gruppe links, Suche in einer separaten Kapsel rechts, das Accessory auf der Ebene darüber. Es verhindert nur, dass sie sich überlappen; es entscheidet nicht, welche davon diese App braucht. Der untere Rand ist bereits der am dichtesten gedrängte Bereich. Schaltest du jedes Element ein, wird **der untere Rand insgesamt überfüllt**, selbst wenn jedes dort steht, wo die Konventionen es sagen, und der Inhalt wird gequetscht.\n\nHinzu kommt auf einem Bildschirm mit Tab-Leiste: Fügt man zusätzlich Aktionen der unteren Symbolleiste hinzu, konkurrieren sie um denselben Platz. Auch das Quellthema sagt, untere Aktionen auf solchen Bildschirmen auf ein Minimum zu beschränken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que le système garantit, ce sont **les conventions de placement**. Les onglets en groupe à gauche, la recherche dans une capsule séparée à droite, l'accessoire sur la couche au-dessus. Il évite seulement qu'ils se chevauchent ; il ne décide pas lesquels cette app requiert. Le bas est déjà la zone la plus encombrée. Activez chaque élément, et même si chacun se tient là où les conventions le disent, **le bas dans son ensemble devient surchargé** et le contenu est comprimé.\n\nSur un écran avec barre d'onglets, ajouter aussi des actions de barre d'outils du bas les fait concourir pour le même espace. Le sujet source dit aussi de réduire au minimum les actions du bas sur ces écrans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che il sistema garantisce sono **le convenzioni di collocazione**. Le schede in gruppo a sinistra, la ricerca in una capsula separata a destra, l'accessorio sullo strato sopra. Si limita a evitare che si sovrappongano; non decide quali di loro servono a questa app. Il basso è già l'area più affollata. Attiva ogni elemento e, anche se ciascuno sta dove dicono le convenzioni, **il basso nel suo insieme diventa sovraffollato** e il contenuto viene schiacciato.\n\nIn una schermata con una barra delle schede, aggiungere anche azioni della barra degli strumenti in basso le fa competere per lo stesso spazio. Anche l'argomento di origine dice di tenere al minimo le azioni in basso in tali schermate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o sistema garante são **as convenções de colocação**. Abas em grupo à esquerda, busca numa cápsula separada à direita, o acessório na camada acima. Ele só evita que se sobreponham; não decide quais deles este app precisa. A parte de baixo já é a área mais cheia. Ative todos os elementos e, mesmo que cada um esteja onde as convenções mandam, **a parte de baixo como um todo fica sobrecarregada** e o conteúdo é espremido.\n\nNuma tela com barra de abas, acrescentar também ações da barra de ferramentas inferior as faz competir pelo mesmo espaço. O tópico de origem também diz para manter ao mínimo as ações inferiores em tais telas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ระบบรับประกันคือ**ธรรมเนียมของการวางตำแหน่ง** แท็บเป็นกลุ่มทางซ้าย การค้นหาในแคปซูลแยกทางขวา อุปกรณ์เสริมบนชั้นเหนือ มันแค่ไม่ให้ซ้อนทับกัน ไม่ได้ตัดสินว่าแอปนี้ต้องการอันไหน ด้านล่างเป็นพื้นที่ที่แออัดที่สุดอยู่แล้ว เปิดทุกองค์ประกอบ แม้แต่ละอันยืนตามที่ธรรมเนียมบอก **ด้านล่างทั้งหมดก็แออัดเกินไป**และเนื้อหาถูกบี้\n\nบนหน้าจอที่มีแถบแท็บ การเพิ่มการกระทำของแถบเครื่องมือล่างด้วยทำให้แย่งพื้นที่เดียวกัน หัวข้อต้นทางก็บอกให้คงการกระทำด้านล่างให้น้อยที่สุดบนหน้าจอแบบนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều hệ thống bảo đảm là **quy ước vị trí**. Tab thành nhóm bên trái, tìm kiếm trong capsule riêng bên phải, phụ kiện ở lớp phía trên. Nó chỉ giữ cho chúng không chồng nhau; nó không quyết app này cần cái nào. Phần dưới vốn đã là vùng đông đúc nhất. Bật mọi phần tử, và dù mỗi cái đứng đúng chỗ quy ước, **toàn bộ phần dưới trở nên quá tải** và nội dung bị ép.\n\nTrên màn hình có thanh tab, thêm cả hành động thanh công cụ dưới thì chúng tranh nhau cùng chỗ. Chủ đề nguồn cũng nói hãy giữ hành động ở dưới ở mức tối thiểu trên những màn hình như vậy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co systém zaručuje, jsou **konvence umístění**. Karty ve skupině vlevo, hledání v samostatné kapsli vpravo, příslušenství ve vrstvě nad nimi. Jen brání tomu, aby se překrývaly; nerozhoduje, které z nich tato aplikace potřebuje. Spodek je už nejzaplněnější oblast. Zapněte každý prvek a i když každý stojí tam, kde konvence říkají, **spodek jako celek je přeplněný** a obsah je stlačen.\n\nNa obrazovce s panelem karet přidání i akcí spodního panelu nástrojů způsobí, že soupeří o stejné místo. Zdrojové téma také říká, že na takových obrazovkách držte spodní akce na minimu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, systemet garanterer, er **placeringens konventioner**. Faner i en gruppe til venstre, søgning i en separat kapsel til højre, tilbehøret på laget over. Det forhindrer dem bare i at overlappe; det afgør ikke, hvilke af dem denne app har brug for. Bunden er allerede det mest overfyldte område. Slå hvert element til, og selv hvis hvert enkelt står, hvor konventionerne siger, **bliver bunden som helhed overfyldt**, og indholdet bliver presset.\n\nPå en skærm med en fanelinje, hvor der også tilføjes handlinger i den nederste værktøjslinje, konkurrerer de om den samme plads. Kildeemnet siger også, at man skal holde nederste handlinger på et minimum på sådanne skærme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό που εγγυάται το σύστημα είναι **οι συμβάσεις τοποθέτησης**. Καρτέλες σε ομάδα αριστερά, αναζήτηση σε ξεχωριστή κάψουλα δεξιά, το εξάρτημα στο πάνω στρώμα. Απλώς τα εμποδίζει να επικαλύπτονται· δεν αποφασίζει ποια από αυτά χρειάζεται αυτή η εφαρμογή. Το κάτω μέρος είναι ήδη η πιο γεμάτη περιοχή. Ενεργοποίησε κάθε στοιχείο, και ακόμα κι αν το καθένα στέκει εκεί που λένε οι συμβάσεις, **το κάτω μέρος συνολικά γίνεται υπερφορτωμένο** και το περιεχόμενο στριμώχνεται.\n\nΣε οθόνη με γραμμή καρτελών, η προσθήκη και ενεργειών κάτω γραμμής εργαλείων τις κάνει να ανταγωνίζονται για τον ίδιο χώρο. Το θέμα πηγής λέει επίσης να κρατάς τις κάτω ενέργειες στο ελάχιστο σε τέτοιες οθόνες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmä takaa **sijoituksen konventiot**. Välilehdet ryhmänä vasemmalla, haku erillisessä kapselissa oikealla, accessory ylempänä kerroksessa. Se vain estää niitä menemästä päällekkäin; se ei päätä, mitä niistä tämä sovellus tarvitsee. Alaosa on jo ahtain alue. Kytke päälle jokainen elementti, ja vaikka kukin seisoisi konventioiden osoittamassa paikassa, **alaosa kokonaisuutena käy ylitäydeksi** ja sisältö puristuu.\n\nVälilehtipalkin sisältävässä näkymässä alatyökalupalkin toimintojen lisääminen saa ne kilpailemaan samasta tilasta. Lähdeaihe sanoo myös, että alatoiminnot pidetään tällaisissa näkymissä minimissä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang dijamin sistem adalah **konvensi penempatan**. Tab dalam kelompok di kiri, pencarian di kapsul terpisah di kanan, accessory di lapisan di atasnya. Ia hanya menjaga agar tidak bertumpuk; ia tidak memutuskan mana yang dibutuhkan aplikasi ini. Bagian bawah sudah menjadi area paling padat. Nyalakan semua elemen, dan meski masing-masing berdiri di tempat yang ditentukan konvensi, **bagian bawah secara keseluruhan menjadi terlalu penuh** dan konten terperas.\n\nPada layar dengan bilah tab, menambah aksi bilah alat bawah juga membuatnya bersaing untuk ruang yang sama. Topik sumber juga berkata untuk menjaga aksi bawah seminimal mungkin pada layar seperti itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det systemet garanterer er **plasseringskonvensjonene**. Faner i en gruppe til venstre, søk i en separat kapsel til høyre, accessoryen på laget over. Det hindrer bare at de overlapper; det avgjør ikke hvilke av dem denne appen trenger. Bunnen er allerede det mest overfylte området. Slå på hvert element, og selv om hvert enkelt står der konvensjonene sier, **blir bunnen som helhet overfylt** og innholdet klemt.\n\nPå en skjerm med fanelinje får bunnverktøylinjehandlinger til å konkurrere om samme plass. Kildeemnet sier også at du bør holde handlinger nederst på et minimum på slike skjermer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat het systeem garandeert zijn **de conventies van plaatsing**. Tabbladen in een groep links, zoeken in een aparte capsule rechts, het accessoire op de laag erboven. Het voorkomt alleen dat ze overlappen; het beslist niet welke ervan deze app nodig heeft. De onderkant is al het drukste gebied. Zet elk element aan, en zelfs als elk op de plek staat die de conventies zeggen, **wordt de onderkant als geheel overvol** en wordt de inhoud geperst.\n\nOp een scherm met een tabbalk laat het toevoegen van acties in een onderste werkbalk ze om dezelfde ruimte concurreren. Het brononderwerp zegt ook onderste acties tot een minimum te beperken op zulke schermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co gwarantuje system, to **konwencje rozmieszczenia**. Karty w grupie po lewej, wyszukiwanie w osobnej kapsule po prawej, akcesorium na warstwie powyżej. Tylko zapobiega ich nakładaniu się; nie decyduje, które z nich ta aplikacja potrzebuje. Dół jest już najbardziej zatłoczonym obszarem. Włącz każdy element, a nawet jeśli każdy stoi tam, gdzie mówią konwencje, **dół jako całość robi się przepełniony**, a treść jest ściskana.\n\nNa ekranie z paskiem kart dodanie także akcji dolnego paska narzędzi sprawia, że rywalizują o to samo miejsce. Temat źródłowy mówi też, by na takich ekranach ograniczać dolne akcje do minimum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det systemet garanterar är **placeringskonventionerna**. Flikar i en grupp till vänster, sökning i en separat kapsel till höger, tillbehöret på lagret ovanför. Det hindrar dem bara från att överlappa; det avgör inte vilka av dem den här appen behöver. Botten är redan det mest trånga området. Slå på varje element, och även om vart och ett står där konventionerna säger blir **botten som helhet överfull** och innehållet pressas ihop.\n\nPå en skärm med ett flikfält gör tillägg av åtgärder i det nedre verktygsfältet att de tävlar om samma utrymme. Källämnet säger också att hålla nedre åtgärder till ett minimum på sådana skärmar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin garanti ettiği şey **yerleşim gelenekleridir**. Sol tarafta bir grupta sekmeler, sağda ayrı bir kapsülde arama, bir üst katmanda aksesuar. Yalnızca üst üste binmelerini engeller; bu uygulamanın hangisine ihtiyaç duyduğuna karar vermez. Alt zaten en kalabalık alan. Her öğeyi açarsan, her biri geleneklerin dediği yerde dursa bile **alt bir bütün olarak aşırı kalabalık hale gelir** ve içerik sıkışır.\n\nSekme çubuğu olan bir ekranda alt araç çubuğu eylemleri de eklemek onları aynı alan için rekabet ettirir. Kaynak konu da bu tür ekranlarda alt eylemleri asgari tutmayı söyler."
          }
        }
      }
    },
    "시스템이 아이템을 접는 이유 중 하나는 **최소 터치 타깃을 지키는 것**이다. 버튼을 무한정 줄여 넣으면 손가락보다 작아지므로, 시스템은 넘치는 것을 메뉴로 보낸다. 접기를 피하려고 아이콘을 줄이면 그 보장을 스스로 걷어낸 셈이다.\n\n또 일곱이 다 보인다고 일곱을 다 찾기 쉬운 건 아니다. 한 줄에 일곱이 있으면 무엇을 누르든 일곱 중에서 골라야 한다. 자주 쓰는 하나를 찾는 비용이 오히려 커진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One reason the system folds items is **to protect the minimum touch target**. Keep shrinking buttons and they become smaller than a finger, so the system sends the overflow into a menu. Shrinking icons to avoid folding means throwing away that guarantee yourself.\n\nAlso, seeing all seven doesn't make all seven easy to find. With seven in a row, whatever you tap, you have to choose from seven. Finding the one you use often actually costs more."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "One reason the system folds items is **to protect the minimum touch target**. Keep shrinking buttons and they become smaller than a finger, so the system sends the overflow into a menu. Shrinking icons to avoid folding means throwing away that guarantee yourself.\n\nAlso, seeing all seven doesn't make all seven easy to find. With seven in a row, whatever you tap, you have to choose from seven. Finding the one you use often actually costs more."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムがアイテムを折りたたむ理由のひとつは、**最小タッチターゲットを守ること**だ。ボタンを際限なく縮めると指より小さくなるので、システムはあふれたものをメニューに送る。折りたたみを避けようとアイコンを縮めるのは、その保証を自分から取り払うのと同じだ。\n\nまた、7つ全部が見えるからといって、7つ全部が見つけやすいわけではない。1行に7つあれば、何を押すにも7つの中から選ばなければならない。よく使うひとつを探すコストが、かえって大きくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统折叠项目的理由之一是**守住最小触控目标**。把按钮无限缩小地塞进去，会比手指还小，所以系统把溢出的送进菜单。为避开折叠而缩小图标，等于自己撤掉了这个保证。\n\n而且七个都看得见，并不等于七个都好找。一行里有七个，点什么都得七选一。找到那个常用的一个，成本反而变大了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統摺疊項目的理由之一是**守住最小觸控目標**。把按鈕無限縮小地塞進去，會比手指還小，所以系統把溢位的送進選單。為避開摺疊而縮小圖示，等於自己撤掉了這個保證。\n\n而且七個都看得見，並不等於七個都好找。一行裡有七個，點什麼都得七選一。找到那個常用的一個，成本反而變大了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна из причин, по которой система сворачивает элементы, - **защита минимальной области касания**. Продолжайте уменьшать кнопки, и они станут меньше пальца, поэтому система отправляет лишнее в меню. Уменьшая значки, чтобы избежать сворачивания, вы сами отбрасываете эту гарантию.\n\nКроме того, видимость всех семи не значит, что все семь легко найти. Когда в ряду семь, что бы вы ни нажимали, приходится выбирать из семи. Найти тот, которым пользуются часто, на деле стоит дороже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una razón por la que el sistema pliega elementos es **proteger el objetivo táctil mínimo**. Sigue encogiendo botones y se vuelven más pequeños que un dedo, así que el sistema manda el desbordamiento a un menú. Encoger iconos para evitar el plegado es tirar tú mismo esa garantía.\n\nAdemás, ver los siete no hace que los siete sean fáciles de encontrar. Con siete en fila, toques lo que toques, tienes que elegir entre siete. Encontrar el que usas a menudo cuesta en realidad más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Grund, warum das System Elemente faltet, ist, **das minimale Touch-Ziel zu schützen**. Schrumpft man Buttons immer weiter, werden sie kleiner als ein Finger, also schickt das System den Überlauf in ein Menü. Symbole zu verkleinern, um das Falten zu vermeiden, bedeutet, diese Garantie selbst wegzuwerfen.\n\nAußerdem macht es alle sieben nicht leicht auffindbar, wenn man alle sieben sieht. Bei sieben in einer Reihe muss man, was auch immer man antippt, aus sieben wählen. Das häufig Genutzte zu finden kostet tatsächlich mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'une des raisons pour lesquelles le système replie les éléments est de **protéger la cible tactile minimale**. Rétrécissez les boutons sans fin et ils deviennent plus petits qu'un doigt, donc le système envoie le débordement dans un menu. Rétrécir les icônes pour éviter le repli, c'est jeter vous-même cette garantie.\n\nDe plus, voir les sept ne rend pas les sept faciles à trouver. Avec sept à la file, quoi que vous touchiez, il faut choisir parmi sept. Trouver celui que l'on utilise souvent coûte en réalité plus cher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno dei motivi per cui il sistema ripiega gli elementi è **proteggere il bersaglio tattile minimo**. Continua a rimpicciolire i pulsanti e diventano più piccoli di un dito, quindi il sistema manda l'eccedenza in un menu. Rimpicciolire le icone per evitare il ripiegamento significa buttare via da soli quella garanzia.\n\nInoltre, vedere tutte e sette non rende tutte e sette facili da trovare. Con sette in fila, qualunque cosa tocchi devi scegliere tra sette. Trovare quella che usi spesso costa in realtà di più."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dos motivos de o sistema dobrar itens é **proteger o alvo de toque mínimo**. Continue encolhendo botões e ficam menores que um dedo, então o sistema manda o excedente para um menu. Encolher ícones para evitar a dobra significa jogar fora essa garantia por conta própria.\n\nAlém disso, ver os sete não torna os sete fáceis de achar. Com sete em fila, seja o que você toque, é preciso escolher entre sete. Achar o que você usa muito custa na verdade mais."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหตุผลหนึ่งที่ระบบพับรายการคือ**เพื่อปกป้องเป้าสัมผัสขั้นต่ำ** ย่อปุ่มต่อไปก็เล็กกว่านิ้ว ระบบจึงส่งส่วนที่ล้นเข้าเมนู การย่อไอคอนเพื่อหลีกเลี่ยงการพับคือการทิ้งการรับประกันนั้นเอง\n\nอีกอย่าง การเห็นทั้งเจ็ดไม่ได้ทำให้ทั้งเจ็ดหาง่าย เมื่อเรียงเจ็ดในแถว ไม่ว่าแตะอะไร คุณต้องเลือกจากเจ็ด การหาอันที่ใช้บ่อยกลับแพงกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lý do hệ thống gập các mục là **để bảo vệ vùng chạm tối thiểu**. Cứ thu nhỏ nút thì chúng nhỏ hơn ngón tay, nên hệ thống đưa phần tràn vào menu. Thu nhỏ biểu tượng để tránh gập là tự vứt bỏ sự bảo đảm đó.\n\nHơn nữa, thấy cả bảy không có nghĩa cả bảy dễ tìm. Với bảy cái xếp hàng, chạm cái nào bạn cũng phải chọn trong bảy. Tìm cái hay dùng thực ra tốn hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedním z důvodů, proč systém sbaluje položky, je **ochrana minimálního dotykového cíle**. Zmenšujte tlačítka dál a budou menší než prst, takže systém pošle přetečení do nabídky. Zmenšovat ikony, aby se zabránilo sbalení, znamená tu záruku sami zahodit.\n\nTaké vidět všech sedm neznamená, že se všech sedm snadno najde. Se sedmi v řadě musíte vybírat ze sedmi, ať klepnete na cokoli. Nalezení té, kterou často používáte, vlastně stojí víc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én grund til, at systemet folder elementer, er **at beskytte det minimale berøringsmål**. Bliv ved med at skrumpe knapper, og de bliver mindre end en finger, så systemet sender overløbet ind i en menu. At skrumpe ikoner for at undgå sammenfoldning betyder selv at smide den garanti væk.\n\nDesuden gør det at se alle syv ikke, at alle syv er lette at finde. Med syv på række må du vælge blandt syv, uanset hvad du trykker på. At finde den, du ofte bruger, koster faktisk mere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας λόγος που το σύστημα διπλώνει στοιχεία είναι **για να προστατεύσει τον ελάχιστο στόχο αφής**. Συνέχισε να σμικρύνεις κουμπιά και γίνονται μικρότερα από δάχτυλο, οπότε το σύστημα στέλνει το υπερχείλισμα σε μενού. Η σμίκρυνση εικονιδίων για να αποφύγεις τη σύμπτυξη σημαίνει ότι πετάς μόνος σου αυτή την εγγύηση.\n\nΕπίσης, το να βλέπεις και τα εφτά δεν κάνει και τα εφτά εύκολα στον εντοπισμό. Με εφτά στη σειρά, ό,τι κι αν πατήσεις, πρέπει να διαλέξεις από εφτά. Ο εντοπισμός αυτού που χρησιμοποιείς συχνά κοστίζει στην πραγματικότητα περισσότερο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi syy, miksi järjestelmä taittaa kohteita, on **vähimmäiskosketuskohteen suojaaminen**. Jatka painikkeiden kutistamista, ja ne käyvät sormea pienemmiksi, joten järjestelmä lähettää ylivuodon valikkoon. Kuvakkeiden kutistaminen taittumisen välttämiseksi tarkoittaa tuon takuun heittämistä pois itse.\n\nLisäksi kaikkien seitsemän näkeminen ei tee kaikista seitsemästä helppoja löytää. Seitsemällä peräkkäin, mitä tahansa napautatkin, sinun täytyy valita seitsemästä. Usein käyttämäsi löytäminen maksaa itse asiassa enemmän."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu alasan sistem melipat item adalah **melindungi target sentuh minimum**. Terus kecilkan tombol dan ia menjadi lebih kecil dari jari, sehingga sistem mengirim yang meluap ke menu. Mengecilkan ikon agar tidak terlipat berarti membuang jaminan itu sendiri.\n\nSelain itu, melihat ketujuhnya tidak membuat ketujuhnya mudah ditemukan. Dengan tujuh berderet, apa pun yang kamu ketuk, kamu harus memilih dari tujuh. Menemukan yang sering kamu pakai justru lebih mahal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En grunn til at systemet folder elementer er **å beskytte minste berøringsmål**. Fortsett å krympe knapper, og de blir mindre enn en finger, så systemet sender overskuddet inn i en meny. Å krympe ikoner for å unngå folding betyr å kaste bort den garantien selv.\n\nDessuten gjør det ikke alle sju lette å finne å se alle sju. Med sju på rad må du velge fra sju uansett hva du trykker på. Å finne den du bruker ofte koster faktisk mer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een reden dat het systeem items inklapt is **om het minimale aanraakdoel te beschermen**. Blijf knoppen verkleinen en ze worden kleiner dan een vinger, dus het systeem stuurt de overflow naar een menu. Iconen verkleinen om inklappen te vermijden betekent die garantie zelf weggooien.\n\nOok maakt het zien van alle zeven niet alle zeven makkelijk vindbaar. Met zeven op een rij moet je, waarop je ook tikt, uit zeven kiezen. Degene vinden die je vaak gebruikt kost eigenlijk meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednym z powodów, dla których system zwija elementy, jest **ochrona minimalnego celu dotyku**. Zmniejszaj przyciski dalej, a staną się mniejsze niż palec, więc system wysyła nadmiar do menu. Zmniejszanie ikon, by uniknąć zwijania, oznacza samodzielne odrzucenie tej gwarancji.\n\nPoza tym zobaczenie wszystkich siedmiu nie sprawia, że wszystkie siedem jest łatwe do znalezienia. Przy siedmiu w rzędzie, w co byś nie stuknął, musisz wybierać z siedmiu. Znalezienie tej, której używasz często, kosztuje faktycznie więcej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett skäl till att systemet viker objekt är **att skydda minsta tryckyta**. Fortsätt krympa knappar och de blir mindre än ett finger, så systemet skickar överskottet till en meny. Att krympa ikoner för att undvika ihopvikning betyder att du själv kastar bort den garantin.\n\nAtt se alla sju gör dessutom inte alla sju lätta att hitta. Med sju på rad måste du välja bland sju vad du än trycker på. Att hitta den du använder ofta kostar faktiskt mer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin öğeleri katlamasının bir nedeni **asgari dokunma hedefini korumaktır**. Düğmeleri küçültmeye devam edersen parmaktan küçük olurlar, bu yüzden sistem taşanı bir menüye gönderir. Katlanmayı önlemek için simgeleri küçültmek o garantiyi kendin çöpe atmak demektir.\n\nAyrıca yedisini de görmek yedisini de bulmayı kolaylaştırmaz. Yan yana yedi varken ne dokunursan dokun yediden seçmek zorundasın. Sık kullandığını bulmak aslında daha pahalıya gelir."
          }
        }
      }
    },
    "시스템이 우선순위를 정해 **제목을 줄이거나 아이템을 접는** 자동 협상을 하도록 설계됨, 개발자가 기기 폭마다 분기하지 않아도 되게. \"깨지지 않고 우아하게 줄어든다(graceful degradation)\"가 기본 동작인 이유.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system is designed to set priorities and negotiate automatically, **shrinking the title or folding items**, so developers don't have to branch for every device width. That is why \"shrinking gracefully instead of breaking (graceful degradation)\" is the default behavior."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system is designed to set priorities and negotiate automatically, **shrinking the title or folding items**, so developers don't have to branch for every device width. That is why \"shrinking gracefully instead of breaking (graceful degradation)\" is the default behaviour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが優先度を決めて、**タイトルを縮めたりアイテムを折りたたんだり**する自動の交渉を行うよう設計されている。開発者がデバイスの幅ごとに分岐しなくて済むように。「壊れずに上品に縮む（graceful degradation）」がデフォルトの動作である理由。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设计成自行协商优先级，**缩短标题或折叠项目**，让开发者不必按设备宽度分支。这就是“不崩溃、优雅地缩减（graceful degradation）”成为默认行为的原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設計成自行協商優先順序，**縮短標題或摺疊項目**，讓開發者不必按裝置寬度分支。這就是「不崩潰、優雅地縮減（graceful degradation）」成為預設行為的原因。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система устроена так, чтобы самой расставлять приоритеты и договариваться, **сжимая заголовок или сворачивая элементы**, чтобы разработчикам не приходилось ветвиться по ширине каждого устройства. Вот почему «изящно сокращаться, не ломаясь (graceful degradation)» - поведение по умолчанию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema está diseñado para fijar prioridades y negociar automáticamente, **encogiendo el título o plegando elementos**, para que los desarrolladores no tengan que ramificar por cada ancho de dispositivo. Por eso «encogerse con elegancia en lugar de romperse (graceful degradation)» es el comportamiento por defecto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System ist darauf ausgelegt, Prioritäten zu setzen und automatisch zu verhandeln, **den Titel zu verkleinern oder Elemente zu falten**, damit Entwickler nicht für jede Gerätebreite verzweigen müssen. Deshalb ist „würdevoll schrumpfen statt zu brechen (Graceful Degradation)“ das Standardverhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système est conçu pour fixer des priorités et négocier automatiquement, **en réduisant le titre ou en repliant des éléments**, pour que les développeurs n'aient pas à brancher pour chaque largeur d'appareil. C'est pourquoi « rétrécir avec élégance plutôt que casser (dégradation gracieuse) » est le comportement par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sistema è progettato per fissare le priorità e negoziare automaticamente, **rimpicciolendo il titolo o ripiegando gli elementi**, così gli sviluppatori non devono diramare il codice per ogni larghezza di dispositivo. Per questo «rimpicciolire con eleganza invece di rompersi (graceful degradation)» è il comportamento predefinito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema é projetado para definir prioridades e negociar automaticamente, **encolhendo o título ou dobrando itens**, para os desenvolvedores não terem de ramificar o código para cada largura de dispositivo. Por isso «encolher com elegância em vez de quebrar (graceful degradation)» é o comportamento padrão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบออกแบบให้ตั้งลำดับความสำคัญและต่อรองโดยอัตโนมัติ **ย่อชื่อเรื่องหรือพับรายการ** นักพัฒนาจึงไม่ต้องแตกสาขาตามความกว้างอุปกรณ์ทุกแบบ นั่นคือเหตุผลที่ \"ลดทอนอย่างสง่างามแทนที่จะพัง (graceful degradation)\" เป็นพฤติกรรมเริ่มต้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống được thiết kế để đặt ưu tiên và thương lượng tự động, **thu nhỏ tiêu đề hoặc gập các mục**, để nhà phát triển không phải rẽ nhánh cho từng độ rộng thiết bị. Đó là lý do \"thu nhỏ một cách duyên dáng thay vì vỡ (graceful degradation)\" là hành vi mặc định."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systém je navržen tak, aby nastavoval priority a vyjednával automaticky, **zmenšoval nadpis nebo sbaloval položky**, aby vývojáři nemuseli větvit pro každou šířku zařízení. Proto je „půvabné zmenšení místo rozbití (graceful degradation)“ výchozí chování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet er designet til at sætte prioriteter og forhandle automatisk, **skrumpe titlen eller folde elementer**, så udviklere ikke skal forgrene for hver enhedsbredde. Derfor er »at skrumpe elegant i stedet for at gå i stykker (graceful degradation)« standardadfærden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σύστημα είναι σχεδιασμένο να ορίζει προτεραιότητες και να διαπραγματεύεται αυτόματα, **σμικρύνοντας τον τίτλο ή διπλώνοντας στοιχεία**, ώστε οι προγραμματιστές να μην χρειάζεται να διακλαδίζουν για κάθε πλάτος συσκευής. Γι' αυτό η «κομψή σμίκρυνση αντί για κατάρρευση (graceful degradation)» είναι η προεπιλεγμένη συμπεριφορά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmä on suunniteltu asettamaan prioriteetit ja neuvottelemaan automaattisesti, **kutistamalla otsikkoa tai taittamalla kohteita**, jotta kehittäjien ei tarvitse haarautua jokaisen laitteen leveydelle. Siksi ”sulava kutistuminen rikkoutumisen sijaan (graceful degradation)” on oletuskäytös."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem dirancang menetapkan prioritas dan bernegosiasi otomatis, **mengecilkan judul atau melipat item**, sehingga pengembang tak perlu bercabang untuk setiap lebar perangkat. Itulah mengapa \"mengecil dengan anggun alih-alih rusak (graceful degradation)\" adalah perilaku bawaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet er designet for å sette prioriteringer og forhandle automatisk, **krympe tittelen eller folde elementer**, slik at utviklere ikke må forgrene seg for hver enhetsbredde. Derfor er «å krympe elegant i stedet for å gå i stykker (graceful degradation)» standardoppførselen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het systeem is ontworpen om automatisch prioriteiten te stellen en te onderhandelen, **door de titel te verkleinen of items in te klappen**, zodat ontwikkelaars niet voor elke apparaatbreedte hoeven te vertakken. Daarom is \"sierlijk krimpen in plaats van breken (graceful degradation)\" het standaardgedrag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "System jest zaprojektowany, by ustalać priorytety i negocjować automatycznie, **kurcząc tytuł lub zwijając elementy**, aby programiści nie musieli rozgałęziać dla każdej szerokości urządzenia. Dlatego „sierlijne kurczenie się zamiast psucia (graceful degradation)” jest zachowaniem domyślnym."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet är utformat för att sätta prioriteringar och förhandla automatiskt, **krympa rubriken eller vika objekt**, så utvecklare inte behöver förgrena för varje enhetsbredd. Därför är ”att krympa med värdighet i stället för att gå sönder (graceful degradation)” standardbeteendet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem, geliştiricilerin her cihaz genişliği için dallanmasına gerek kalmasın diye **başlığı küçülterek ya da öğeleri katlayarak** öncelikleri belirlemek ve otomatik pazarlık yapmak üzere tasarlandı. “Bozulmak yerine zarifçe küçülmek (graceful degradation)” varsayılan davranış olmasının nedeni budur."
          }
        }
      }
    },
    "시스템이 자동으로 해 주는 것은 **자리의 이동**이다. 탭바가 접히면 액세서리가 사라지지 않고 탭바 자리로 승격되는 것까지가 시스템의 몫이다. 그 좁아진 자리에 **무엇을 남길지는 앱이 정해야** 한다. 넓은 레이아웃을 그대로 밀어 넣으면 잘림이 레이아웃을 대신 결정하고, 가장 중요한 버튼이 가장 먼저 잘릴 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system does automatically is **move the spot**. When the tab bar collapses, the accessory doesn't disappear but gets promoted into the tab bar's spot, and that's as far as the system goes. **What stays in that narrowed spot is up to the app.** If you just push the wide layout in as is, truncation decides the layout for you, and the most important button may be the first to get cut off."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What the system does automatically is **move the spot**. When the tab bar collapses, the accessory doesn't disappear but gets promoted into the tab bar's spot, and that's as far as the system goes. **What stays in that narrowed spot is up to the app.** If you just push the wide layout in as is, truncation decides the layout for you, and the most important button may be the first to get cut off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが自動でやってくれるのは**場所の移動**だ。タブバーが折りたたまれると、アクセサリは消えずにタブバーの場所へ格上げされる。そこまでがシステムの役目だ。その狭くなった場所に**何を残すかはアプリが決めなければ**ならない。広いレイアウトをそのまま押し込むと、切り詰めがレイアウトを代わりに決めてしまい、最も重要なボタンが真っ先に切れることもある。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统自动帮你做的是**位置的移动**。标签栏折叠时，附件不会消失而是升级到标签栏的位置，这一步由系统负责。但在那个变窄的位置里**留下什么，要由应用来决定**。把宽布局原样塞进去，就由截断代为决定布局，最重要的按钮可能最先被截掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統自動幫你做的是**位置的移動**。標籤列摺疊時，附件不會消失而是升級到標籤列的位置，這一步由系統負責。但在那個變窄的位置裡**留下什麼，要由應用程式來決定**。把寬佈局原樣塞進去，就由截斷代為決定佈局，最重要的按鈕可能最先被截掉。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что система делает автоматически - это **перемещение места**. Когда панель вкладок сворачивается, accessory не исчезает, а повышается до места панели вкладок, и на этом доля системы заканчивается. **Что останется в этом сузившемся месте, решает приложение.** Если просто втиснуть широкую раскладку как есть, раскладку за вас решит обрезка, и самая важная кнопка может оказаться обрезанной первой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el sistema hace automáticamente es **mover el sitio**. Cuando la barra de pestañas se colapsa, el accesorio no desaparece sino que asciende al sitio de la barra de pestañas, y ahí llega el sistema. **Lo que se queda en ese sitio estrechado lo decide la app.** Si simplemente metes el diseño ancho tal cual, el truncamiento decide el diseño por ti, y el botón más importante puede ser el primero en cortarse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was das System automatisch tut, ist **den Platz zu wechseln**. Klappt die Tab-Leiste zusammen, verschwindet das Accessory nicht, sondern rückt auf den Platz der Tab-Leiste, und dort endet das System. **Was an diesem verengten Platz bleibt, liegt bei der App.** Schiebt man das breite Layout einfach unverändert hinein, entscheidet das Abschneiden das Layout für dich, und der wichtigste Button wird womöglich als Erstes abgeschnitten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que fait le système automatiquement, c'est **déplacer l'emplacement**. Quand la barre d'onglets se replie, l'accessoire ne disparaît pas mais est promu à la place de la barre d'onglets, et le système s'arrête là. **Ce qui reste dans cet emplacement rétréci dépend de l'app.** Si vous y poussez simplement la disposition large telle quelle, la troncature décide de la disposition à votre place, et le bouton le plus important peut être le premier à être coupé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che il sistema fa automaticamente è **spostare il posto**. Quando la barra delle schede si comprime, l'accessorio non sparisce ma viene promosso al posto della barra delle schede, e il sistema si ferma lì. **Ciò che resta in quel posto ristretto spetta all'app.** Se spingi dentro il layout largo così com'è, è il troncamento a decidere il layout per te, e il pulsante più importante può essere il primo a essere tagliato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o sistema faz automaticamente é **mover o lugar**. Quando a barra de abas recolhe, o acessório não desaparece mas é promovido ao lugar da barra de abas, e o sistema vai só até aí. **O que fica nesse lugar estreitado cabe ao app.** Se você só empurra o layout largo como está, o truncamento decide o layout por você, e o botão mais importante pode ser o primeiro a ser cortado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ระบบทำโดยอัตโนมัติคือ**ย้ายตำแหน่ง** เมื่อแถบแท็บยุบ อุปกรณ์เสริมไม่หายไปแต่ถูกยกไปอยู่ตำแหน่งของแถบแท็บ และระบบทำแค่นั้น **สิ่งที่อยู่ในตำแหน่งที่แคบลงนั้นเป็นเรื่องของแอป** ถ้าคุณดันเลย์เอาต์กว้างเข้าไปตามเดิม การตัดจะตัดสินเลย์เอาต์แทนคุณ และปุ่มที่สำคัญที่สุดอาจถูกตัดก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều hệ thống làm tự động là **dời chỗ**. Khi thanh tab thu lại, phụ kiện không biến mất mà được nâng vào chỗ của thanh tab, và hệ thống chỉ đến đó. **Thứ gì ở lại trong chỗ đã hẹp là việc của app.** Nếu bạn cứ nhét nguyên bố cục rộng vào, việc cắt sẽ quyết bố cục thay bạn, và nút quan trọng nhất có thể bị cắt đầu tiên."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co systém dělá automaticky, je **přesun místa**. Když se panel karet sbalí, příslušenství nezmizí, ale povýší na místo panelu karet, a tam systém končí. **Co zůstane v tom zúženém místě, je na aplikaci.** Pokud tam prostě strčíte široké rozvržení tak, jak je, rozvržení za vás rozhodne ořez a nejdůležitější tlačítko může být odříznuto první."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, systemet gør automatisk, er **at flytte pladsen**. Når fanelinjen folder sammen, forsvinder tilbehøret ikke men rykkes op på fanelinjens plads, og det er så langt, systemet går. **Hvad der bliver på den indsnævrede plads, er op til appen.** Hvis du bare skubber det brede layout ind uændret, afgør afkortning layoutet for dig, og den vigtigste knap kan være den første, der bliver skåret af."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό που κάνει αυτόματα το σύστημα είναι να **μετακινεί τη θέση**. Όταν η γραμμή καρτελών συμπτύσσεται, το εξάρτημα δεν εξαφανίζεται αλλά προάγεται στη θέση της γραμμής καρτελών, και μέχρι εκεί φτάνει το σύστημα. **Τι μένει σε εκείνη τη στενεμένη θέση είναι θέμα της εφαρμογής.** Αν απλώς σπρώξεις την πλατιά διάταξη ως έχει, η περικοπή αποφασίζει τη διάταξη για σένα, και το πιο σημαντικό κουμπί μπορεί να είναι το πρώτο που θα κοπεί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, mitä järjestelmä tekee automaattisesti, on **paikan siirtäminen**. Kun välilehtipalkki tiivistyy, accessory ei katoa vaan ylennetään välilehtipalkin paikalle, ja sinne asti järjestelmä menee. **Se, mikä jää tuohon kaventuneeseen paikkaan, on sovelluksen päätettävä.** Jos työnnät leveän asettelun sisään sellaisenaan, katkaisu päättää asettelun puolestasi, ja tärkein painike voi olla ensimmäinen, joka leikkautuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang dilakukan sistem otomatis adalah **memindahkan tempatnya**. Saat bilah tab menciut, accessory tidak menghilang tetapi dipromosikan ke tempat bilah tab, dan sistem berhenti sampai di situ. **Apa yang bertahan di tempat yang menyempit itu terserah aplikasi.** Jika kamu hanya mendorong tata letak lebar apa adanya, pemotongan yang memutuskan tata letak untukmu, dan tombol terpenting mungkin yang pertama terpotong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det systemet gjør automatisk er **å flytte plassen**. Når fanelinjen kollapser, forsvinner ikke accessoryen, men løftes inn på fanelinjens plass, og der stopper systemet. **Hva som blir på den innsnevrede plassen er opp til appen.** Hvis du bare presser inn den brede layouten som den er, avgjør avkorting layouten for deg, og den viktigste knappen kan bli den første som kuttes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat het systeem automatisch doet is **de plek verplaatsen**. Als de tabbalk inklapt, verdwijnt het accessoire niet maar wordt het gepromoveerd naar de plek van de tabbalk, en dat is zo ver als het systeem gaat. **Wat er op die versmalde plek blijft, is aan de app.** Als je de brede layout gewoon ongewijzigd naar binnen duwt, beslist afkappen voor jou over de layout, en de belangrijkste knop kan als eerste worden afgesneden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co system robi automatycznie, to **przenosi miejsce**. Gdy pasek kart się zwija, akcesorium nie znika, ale zostaje awansowane na miejsce paska kart, i tyle system robi. **To, co zostaje w tym zwężonym miejscu, zależy od aplikacji.** Jeśli po prostu wcisnąć szeroki układ bez zmian, obcinanie zdecyduje za ciebie o układzie, a najważniejszy przycisk może zostać obcięty jako pierwszy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det systemet gör automatiskt är **att flytta platsen**. När flikfältet fälls ihop försvinner inte tillbehöret utan flyttas upp till flikfältets plats, och det är så långt systemet går. **Vad som blir kvar på den smalnade platsen är upp till appen.** Om du bara trycker in den breda layouten som den är avgör kapning layouten åt dig, och den viktigaste knappen kan vara den första som kapas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin otomatik olarak yaptığı şey **yeri taşımaktır**. Sekme çubuğu daraldığında aksesuar kaybolmaz, sekme çubuğunun yerine terfi eder ve sistem oraya kadar gider. **Daralan o yerde nelerin kalacağı uygulamaya aittir.** Geniş düzeni olduğu gibi içeri itersen düzene kesilme karar verir ve en önemli düğme ilk kesilen olabilir."
          }
        }
      }
    },
    "시스템이 접는 건 최소 터치 크기를 지키려는 것이다. 접히게 두고 순서를 설계한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system folds items to protect the minimum touch size. Let them fold, and design the order instead."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system folds items to protect the minimum touch size. Let them fold, and design the order instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが折りたたむのは、最小タッチサイズを守るためだ。折りたたまれるに任せて、順番を設計する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统折叠是为了守住最小触控尺寸。让它折叠，并设计好顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統摺疊是為了守住最小觸控尺寸。讓它摺疊，並設計好順序。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система сворачивает, чтобы защитить минимальный размер касания. Позвольте им сворачиваться и продумайте порядок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema pliega para proteger el tamaño táctil mínimo. Deja que se plieguen y diseña el orden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System faltet Elemente, um die minimale Touch-Größe zu schützen. Lass sie falten und gestalte stattdessen die Reihenfolge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système replie des éléments pour protéger la taille tactile minimale. Laissez-les se replier, et concevez plutôt l'ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sistema ripiega gli elementi per proteggere la dimensione minima del tocco. Lasciali ripiegare e progetta invece l'ordine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema dobra itens para proteger o tamanho mínimo do toque. Deixe dobrarem e projete a ordem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบพับรายการเพื่อปกป้องขนาดสัมผัสขั้นต่ำ ปล่อยให้พับ และออกแบบลำดับแทน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống gập các mục để bảo vệ kích thước chạm tối thiểu. Hãy để chúng gập, và thiết kế thứ tự thay vào đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systém sbaluje položky, aby ochránil minimální velikost dotyku. Nechte je sbalit a místo toho navrhněte pořadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet folder elementer for at beskytte den minimale berøringsstørrelse. Lad dem folde, og design rækkefølgen i stedet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σύστημα διπλώνει στοιχεία για να προστατεύσει το ελάχιστο μέγεθος αφής. Άφησέ τα να διπλώσουν, και σχεδίασε αντί γι' αυτό τη σειρά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmä taittaa kohteita suojatakseen vähimmäiskosketuskoon. Anna niiden taittua ja suunnittele järjestys sen sijaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem melipat item untuk melindungi ukuran sentuh minimum. Biarkan terlipat, dan rancang urutannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet folder elementer for å beskytte minste berøringsstørrelse. La dem foldes, og design rekkefølgen i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het systeem klapt items in om de minimale aanraakgrootte te beschermen. Laat ze inklappen, en ontwerp in plaats daarvan de volgorde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "System zwija elementy, by chronić minimalny rozmiar dotyku. Pozwól im się zwijać i zaprojektuj zamiast tego kolejność."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet viker objekt för att skydda minsta tryckytan. Låt dem vikas, och designa ordningen i stället."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem, asgari dokunma boyutunu korumak için öğeleri katlar. Katlansınlar ve bunun yerine sırayı tasarla."
          }
        }
      }
    },
    "시스템이 접어버리니 커스텀으로 만들면 전부 보여줄 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system folds them away, so building it yourself lets you show everything."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system folds them away, so building it yourself lets you show everything."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが折りたたんでしまうので、カスタムで作れば全部見せられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
