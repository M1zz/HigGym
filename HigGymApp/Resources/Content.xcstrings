    "minimumScaleFactor(0.3) 같은 과도한 축소 허용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing excessive shrinking like minimumScaleFactor(0.3)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing excessive shrinking like minimumScaleFactor(0.3)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor(0.3)のような過度な縮小を許す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 minimumScaleFactor(0.3) 这样过度的缩小"
          }
        },
        "zh-Hant": {
