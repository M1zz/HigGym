          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas se perdem"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนหลงทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người ta bị lạc"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé se ztratí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk farer vild"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι άνθρωποι χάνονται"
          }
        }
      }
    },
    "사용자가 화면 보며 수기로 옮겨 적음": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People copy it down by hand from the screen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "People copy it down by hand from the screen"
          }
        },
        "ja": {
