          "stringUnit": {
            "state": "translated",
            "value": "Sen takana tapahtuvat muutokset jättävät tilan epäjohdonmukaiseksi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan di belakangnya membuat keadaan tidak konsisten"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer bak etterlater tilstanden inkonsistent"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen erachter laten de status inconsistent"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany z tyłu zostawiają stan niespójny"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar bakom lämnar tillståndet inkonsekvent"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaki değişiklikler durumu tutarsız bırakır"
          }
        }
      }
    },
    "뒤를 확인하며 진행할 수 있으면 더 편할 거라 생각한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You think it'd be more convenient if people could check the background while proceeding."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You think it'd be more convenient if people could check the background while proceeding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後ろを確認しながら進められたほうが便利だろうと考える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "觉得如果能一边看着后面一边进行会更方便。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覺得如果能一邊看著後面一邊進行會更方便。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы считаете, что удобнее, если люди могут сверяться с фоном по ходу дела."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piensas que sería más cómodo que la gente pudiera consultar el fondo mientras avanza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du denkst, es wäre bequemer, wenn Menschen den Hintergrund während des Vorgangs prüfen könnten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pensez que ce serait plus commode si les gens pouvaient consulter l'arrière-plan en cours de route."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensi che sarebbe più comodo se le persone potessero controllare lo sfondo mentre procedono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você acha que seria mais cômodo se as pessoas pudessem conferir o fundo enquanto prosseguem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณคิดว่าจะสะดวกกว่าถ้าคนตรวจพื้นหลังได้ระหว่างดำเนินการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn nghĩ sẽ tiện hơn nếu người ta kiểm tra được nền trong lúc tiến hành."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Myslíte si, že by bylo pohodlnější, kdyby lidé mohli během postupu kontrolovat pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du synes, det ville være mere bekvemt, hvis folk kunne tjekke baggrunden, mens de fortsætter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νομίζεις ότι θα ήταν πιο βολικό αν οι άνθρωποι μπορούσαν να ελέγχουν το φόντο ενώ προχωρούν."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luulet, että olisi kätevämpää, jos ihmiset voisivat tarkistaa taustan edetessään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu mengira akan lebih nyaman jika orang bisa memeriksa latar sambil melanjutkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tror det ville vært mer praktisk om folk kunne sjekke bakgrunnen mens de fortsetter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je denkt dat het handiger zou zijn als mensen de achtergrond konden controleren terwijl ze doorgaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uważasz, że byłoby wygodniej, gdyby ludzie mogli sprawdzać tło w trakcie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tror att det vore bekvämare om folk kunde kontrollera bakgrunden medan de fortsätter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanlar devam ederken arka planı kontrol edebilse daha rahat olacağını düşünürsün."
          }
        }
      }
    },
    "뒤에서 값이 바뀌면 결제 대상이 흔들린다. 확정 순간은 모달로 잠근다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If values change behind it, what's being paid for becomes unstable. Lock the moment of confirmation with a modal."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If values change behind it, what's being paid for becomes unstable. Lock the moment of confirmation with a modal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後ろで値が変わると、決済の対象が揺らぐ。確定の瞬間はモーダルでロックする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后面的值一变，支付对象就晃动了。确认的时刻要用模态锁住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後面的值一變，付款物件就晃動了。確認的時刻要用模態鎖住。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если значения позади меняются, то то, за что платят, становится неустойчивым. Заблокируйте момент подтверждения модальным окном."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los valores cambian por detrás, lo que se está pagando se vuelve inestable. Bloquea el momento de la confirmación con un modal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern sich dahinter Werte, wird unsicher, was bezahlt wird. Sperre den Moment der Bestätigung mit einem Modal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les valeurs changent derrière, ce qui est payé devient instable. Verrouillez le moment de la confirmation avec une modale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se i valori cambiano dietro, ciò che si sta pagando diventa instabile. Blocca il momento della conferma con un modale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os valores mudam atrás, o que está sendo pago fica instável. Trave o momento da confirmação com um modal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าค่าเปลี่ยนไปด้านหลัง สิ่งที่กำลังจ่ายจะไม่เสถียร ล็อกจังหวะยืนยันด้วยโมดัล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu giá trị phía sau đổi, khoản đang thanh toán trở nên không ổn định. Khóa khoảnh khắc xác nhận bằng modal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se hodnoty za ním změní, to, co se platí, se stane nestabilním. Uzamkněte okamžik potvrzení modalem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis værdier ændres bagved, bliver det, der betales for, ustabilt. Lås bekræftelsesøjeblikket med en modal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν οι τιμές αλλάζουν πίσω, αυτό που πληρώνεται γίνεται ασταθές. Κλείδωσε τη στιγμή της επιβεβαίωσης με ένα modal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos arvot muuttuvat sen takana, se, mistä maksetaan, muuttuu epävakaaksi. Lukitse vahvistuksen hetki modaalilla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika nilai berubah di belakangnya, apa yang dibayar menjadi tidak stabil. Kunci momen konfirmasi dengan modal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis verdier endres bak, blir det som betales for ustabilt. Lås bekreftelsesøyeblikket med en modal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als waarden erachter veranderen, wordt wat wordt betaald instabiel. Vergrendel het moment van bevestiging met een modal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli wartości z tyłu się zmieniają, to, za co się płaci, staje się niestabilne. Zablokuj moment potwierdzenia modalem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om värden ändras bakom blir det som betalas instabilt. Lås bekräftelseögonblicket med en modal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkada değerler değişirse ödenen şey dengesiz hale gelir. Onay anını bir modalle kilitle."
          }
        }
      }
    },
    "드물게 쓰는 액션은 지금의 과업에 기여할 확률이 낮으므로 접어둠. 기능의 완전성은 유지하면서 화면 점유는 기여도에 비례": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rarely used actions are unlikely to contribute to the current task, so they're folded away. The feature set stays complete while screen space stays proportional to contribution"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Rarely used actions are unlikely to contribute to the current task, so they're folded away. The feature set stays complete while screen space stays proportional to contribution"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まれにしか使わないアクションは今の作業に貢献する見込みが低いので、たたんでおく。機能の完全さは保ちつつ、画面の占有は貢献度に比例"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很少用的操作对当前任务贡献的概率低，所以折叠起来。既保持功能完整，又让界面占用与贡献度成正比"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "很少用的操作對當前任務貢獻的機率低，所以摺疊起來。既保持功能完整，又讓介面佔用與貢獻度成正比"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редко используемые действия вряд ли вносят вклад в текущую задачу, поэтому их сворачивают. Набор функций остаётся полным, а место на экране остаётся пропорциональным вкладу"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones poco usadas es poco probable que contribuyan a la tarea actual, así que se pliegan. El conjunto de funciones sigue completo mientras el espacio de pantalla se mantiene proporcional a la aportación"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selten genutzte Aktionen tragen wohl kaum zur aktuellen Aufgabe bei, also werden sie weggefaltet. Der Funktionsumfang bleibt vollständig, während der Bildschirmplatz im Verhältnis zum Beitrag bleibt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions rarement utilisées ont peu de chances de contribuer à la tâche en cours, donc on les replie. L'ensemble des fonctions reste complet tandis que l'espace d'écran reste proportionnel à la contribution"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni usate di rado difficilmente contribuiscono al compito attuale, quindi vengono ripiegate. L'insieme delle funzioni resta completo mentre lo spazio sullo schermo resta proporzionale al contributo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações pouco usadas dificilmente contribuem para a tarefa atual, então são dobradas. O conjunto de funcionalidades continua completo enquanto o espaço da tela continua proporcional à contribuição"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำที่ใช้น้อยไม่น่าจะมีส่วนช่วยงานปัจจุบัน จึงถูกพับเก็บ ชุดฟีเจอร์ยังครบถ้วนขณะที่พื้นที่หน้าจอเป็นสัดส่วนกับคุณูปการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động ít dùng khó đóng góp cho tác vụ hiện tại nên được gập lại. Bộ tính năng vẫn đầy đủ trong khi chỗ trên màn hình tỉ lệ với đóng góp"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zřídka používané akce pravděpodobně nepřispívají k aktuálnímu úkolu, takže se sbalí. Sada funkcí zůstává úplná, zatímco místo na obrazovce zůstává úměrné příspěvku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjældent brugte handlinger bidrager næppe til den aktuelle opgave, så de foldes væk. Funktionssættet forbliver komplet, mens skærmpladsen forbliver proportional med bidraget"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σπάνια χρησιμοποιούμενες ενέργειες είναι απίθανο να συμβάλλουν στην τρέχουσα εργασία, οπότε διπλώνονται. Το σύνολο λειτουργιών μένει πλήρες ενώ ο χώρος της οθόνης μένει ανάλογος της συμβολής"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harvoin käytetyt toiminnot eivät todennäköisesti edistä käsillä olevaa tehtävää, joten ne taitetaan pois. Ominaisuusjoukko pysyy täydellisenä, kun taas näyttötila pysyy verrannollisena vaikutukseen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksi yang jarang dipakai kecil kemungkinannya berkontribusi pada tugas saat ini, jadi dilipat. Kumpulan fitur tetap lengkap sementara ruang layar tetap sebanding dengan kontribusi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjelden brukte handlinger bidrar neppe til den aktuelle oppgaven, så de foldes bort. Funksjonssettet forblir komplett mens skjermplassen forblir proporsjonal med bidraget"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelden gebruikte acties dragen waarschijnlijk niet bij aan de huidige taak, dus ze worden weggeklapt. De functieset blijft compleet terwijl de schermruimte evenredig blijft met de bijdrage"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rzadko używane akcje raczej nie wniosą nic do bieżącego zadania, więc są zwijane. Zestaw funkcji pozostaje kompletny, a miejsce na ekranie proporcjonalne do wkładu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sällan använda åtgärder bidrar sannolikt inte till den aktuella uppgiften, så de viks undan. Funktionsuppsättningen förblir komplett medan skärmutrymmet förblir proportionellt mot bidraget"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadiren kullanılan eylemlerin mevcut göreve katkı sağlama olasılığı düşüktür, bu yüzden katlanırlar. Özellik seti eksiksiz kalır, ekran alanı ise katkıyla orantılı kalır"
          }
        }
      }
    },
