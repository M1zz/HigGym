          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovladač uprostřed + **vedlejší akce vpravo**, oddělení hierarchie pozicí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Midterkontrol + **en støttehandling til højre**, der adskiller hierarki efter position"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κεντρικός έλεγχος + **μια υποστηρικτική ενέργεια δεξιά**, με διαχωρισμό της ιεραρχίας μέσω θέσης"
          }
        }
      }
    },
    "중앙에 무언가를 놓기 전에 묻는다. \"이게 이 화면의 이름인가?\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before putting something in the center, ask: \"Is this the name of this screen?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before putting something in the centre, ask: \"Is this the name of this screen?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央に何かを置く前に問う。「これはこの画面の名前か？」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在中间放东西之前先问：“这是这个界面的名字吗？”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在中間放東西之前先問：「這是這個介面的名字嗎？」"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем поставить что-то в центр, спросите: «Это название данного экрана?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de poner algo en el centro, pregunta: «¿Es este el nombre de esta pantalla?»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du etwas in die Mitte setzt, frage: „Ist das der Name dieses Bildschirms?“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de mettre quelque chose au centre, demandez : « Est-ce le nom de cet écran ? »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di mettere qualcosa al centro, chiediti: «È il nome di questa schermata?»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de pôr algo no centro, pergunte: «Este é o nome desta tela?»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนใส่อะไรไว้กลาง ให้ถาม: \"นี่คือชื่อของหน้าจอนี้หรือไม่\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi đặt gì vào giữa, hãy hỏi: \"Đây có phải tên của màn hình này không?\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než něco dáte doprostřed, zeptejte se: „Je to název této obrazovky?“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du lægger noget i midten, så spørg: »Er dette navnet på denne skærm?«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν βάλεις κάτι στο κέντρο, ρώτα: «Είναι αυτό το όνομα της οθόνης;»"
          }
        }
      }
    },
    "중앙에 무언가를 두기 전에 묻는다. \"이 값이 바뀌면 화면 전체가 바뀌나?\" 아니라면 그건 제목을 밀어낼 자격이 없다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before putting something in the center, ask: \"If this value changes, does the whole screen change?\" If not, it has no right to push the title out."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before putting something in the centre, ask: \"If this value changes, does the whole screen change?\" If not, it has no right to push the title out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央に何かを置く前に問う。「この値が変わると、画面全体が変わるか？」変わらないなら、それにタイトルを押しのける資格はない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在中间放东西之前先问：“这个值一变，整个界面都会变吗？”不是的话，它没有资格挤掉标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在中間放東西之前先問：「這個值一變，整個介面都會變嗎？」不是的話，它沒有資格擠掉標題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем поставить что-то в центр, спросите: «Если это значение изменится, изменится ли весь экран?» Если нет, у него нет права вытеснять заголовок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de poner algo en el centro, pregunta: «Si este valor cambia, ¿cambia toda la pantalla?» Si no, no tiene derecho a desplazar al título."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du etwas in die Mitte setzt, frage: „Ändert sich der ganze Bildschirm, wenn sich dieser Wert ändert?“ Wenn nicht, hat es kein Recht, den Titel zu verdrängen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de mettre quelque chose au centre, demandez : « Si cette valeur change, tout l'écran change-t-il ? » Sinon, cela n'a pas le droit de chasser le titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di mettere qualcosa al centro, chiediti: «Se questo valore cambia, cambia l'intera schermata?» Se no, non ha il diritto di spingere via il titolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de pôr algo no centro, pergunte: «Se este valor mudar, a tela inteira muda?» Se não, não tem o direito de empurrar o título para fora."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนใส่อะไรไว้กลาง ให้ถาม: \"ถ้าค่านี้เปลี่ยน ทั้งหน้าจอเปลี่ยนไหม\" ถ้าไม่ มันไม่มีสิทธิ์ผลักชื่อเรื่องออก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi đặt gì vào giữa, hãy hỏi: \"Nếu giá trị này đổi, cả màn hình có đổi không?\" Nếu không, nó không có quyền đẩy tiêu đề ra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než něco dáte doprostřed, zeptejte se: „Pokud se tato hodnota změní, změní se celá obrazovka?“ Pokud ne, nemá právo vytlačit nadpis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du lægger noget i midten, så spørg: »Hvis denne værdi ændres, ændres hele skærmen så?« Hvis ikke, har den ingen ret til at skubbe titlen ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν βάλεις κάτι στο κέντρο, ρώτα: «Αν αλλάξει αυτή η τιμή, αλλάζει ολόκληρη η οθόνη;» Αν όχι, δεν έχει δικαίωμα να διώξει τον τίτλο."
          }
        }
      }
    },
    "중앙에 액션 버튼, trailing에 화면 모드 컨트롤(위계가 뒤바뀜)": {
