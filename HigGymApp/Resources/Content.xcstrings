          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné přejetí pro zavření"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet stryg for at afvise"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
