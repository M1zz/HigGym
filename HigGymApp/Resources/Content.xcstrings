        }
      }
    },
    "스크롤 안의 스크롤은 조작을 잃게 만든다. 길면 large나 별도 화면으로.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling inside scrolling makes people lose track of what they're controlling. If it's long, use large or a separate screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling inside scrolling makes people lose track of what they're controlling. If it's long, use large or a separate screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールの中のスクロールは、何を操作しているかを見失わせる。長いなら large か別の画面へ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动里套滚动会让人失去操控。长的话，用 large 或单独的界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動裡套滾動會讓人失去操控。長的話，用 large 或單獨的介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутка внутри прокрутки лишает людей понимания, чем они управляют. Если длинное, используйте large или отдельный экран."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplazar dentro de desplazar hace que la gente pierda el control de lo que maneja. Si es largo, usa large o una pantalla aparte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollen im Scrollen lässt Menschen den Überblick verlieren, was sie steuern. Ist es lang, nutze large oder einen eigenen Bildschirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défiler dans le défilement fait perdre aux gens la trace de ce qu'ils contrôlent. Si c'est long, utilisez large ou un écran séparé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorrere dentro lo scorrimento fa perdere alle persone il filo di ciò che stanno controllando. Se è lungo, usa large o una schermata separata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolagem dentro de rolagem faz as pessoas perderem o fio do que estão controlando. Se é longo, use large ou uma tela separada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลื่อนซ้อนการเลื่อนทำให้คนตามไม่ทันว่ากำลังควบคุมอะไร ถ้ายาว ให้ใช้ large หรือหน้าจอแยก"
