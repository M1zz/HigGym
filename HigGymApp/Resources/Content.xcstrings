          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własna kontrolka w **miejscu dokładnie pośrodku**, gdzie idzie tytuł (.principal), zastępująca tytuł."
          }
        },
        "sv": {
