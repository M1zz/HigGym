        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Формулировка не переработана, хотя заголовок постоянно усекается"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No reformular el texto cuando el título se sigue truncando"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Formulierung nicht überarbeiten, wenn der Titel immer wieder abgeschnitten wird"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas retravailler la formulation quand le titre est sans cesse tronqué"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non rielaborare la formulazione quando il titolo continua a essere troncato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não retrabalhar a redação quando o título continua sendo truncado"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ปรับถ้อยคำเมื่อชื่อเรื่องถูกตัดอยู่เรื่อย ๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không làm lại cách diễn đạt khi tiêu đề cứ bị cắt"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepřepracování formulace, když se nadpis stále ořezává"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At undlade at omarbejde formuleringen, når titlen bliver ved med at blive afkortet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ξαναδουλεύεις τη διατύπωση όταν ο τίτλος περικόπτεται συνεχώς"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanamuodon uudelleen työstämättä jättäminen, kun otsikko katkeaa jatkuvasti"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak mengerjakan ulang kata-kata saat judul terus terpotong"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å ikke bearbeide ordlyden på nytt når tittelen stadig avkortes"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De formulering niet herwerken terwijl de titel steeds wordt afgekapt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprzepracowanie sformułowania, gdy tytuł jest wciąż obcinany"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att inte arbeta om formuleringen när rubriken fortsätter att kapas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlık sürekli kesilirken ifadeyi yeniden çalışmamak"
          }
        }
      }
    },
    "제목이 길어 계속 잘리는데 짧게 다듬지 않고 방치": {
      "extractionState": "manual",
