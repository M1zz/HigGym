        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏng trên nền khác và trong Chế độ tối"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozbije se na jiných pozadích a v tmavém režimu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Går i stykker på andre baggrunde og i mørk tilstand"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σπάει σε άλλα φόντα και στη Σκοτεινή εμφάνιση"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rikkoutuu muilla taustoilla ja tummassa tilassa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rusak di latar lain dan di Mode Gelap"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svikter på andre bakgrunner og i mørk modus"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breekt op andere achtergronden en in de donkere modus"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Psuje się na innych tłach i w trybie ciemnym"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Går sönder på andra bakgrunder och i mörkt läge"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer arka planlarda ve Koyu Modda bozulur"
          }
        }
      }
    },
    "다른 텍스트와 같은 규칙을 적용하면 일관돼 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying the same rule as other text looks consistent."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying the same rule as other text looks consistent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのテキストと同じルールを当てはめれば、一貫して見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用与其他文字相同的规则，看起来就一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式與其他文字相同的規則，看起來就一致。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применение того же правила, что к остальному тексту, выглядит последовательно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar la misma regla que a los demás textos parece coherente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Regel wie bei anderem Text anzuwenden wirkt konsistent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer la même règle que pour les autres textes paraît cohérent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicare la stessa regola degli altri testi sembra coerente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar a mesma regra dos outros textos parece consistente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้กฎเดียวกับข้อความอื่นดูสอดคล้อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp cùng quy tắc như văn bản khác trông nhất quán."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použití stejného pravidla jako u jiného textu vypadá konzistentně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At anvende samme regel som anden tekst ser ensartet ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή του ίδιου κανόνα με το άλλο κείμενο φαίνεται συνεπής."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saman säännön soveltaminen kuin muuhun tekstiin näyttää johdonmukaiselta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerapkan aturan yang sama dengan teks lain tampak konsisten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å bruke samme regel som for annen tekst ser konsekvent ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezelfde regel toepassen als op andere tekst lijkt consistent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastosowanie tej samej reguły co dla innego tekstu wygląda spójnie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att tillämpa samma regel som för annan text ser konsekvent ut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer metinlerle aynı kuralı uygulamak tutarlı görünür."
          }
        }
      }
    },
    "다른 텍스트와 같은 규칙을 적용하면 일관돼 보인다. \"넘치면 tail로 자른다\"는 한 가지 규칙이 앱 전체에 깔끔하게 적용된다. 기본값이니 따로 정할 것도 없다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying the same rule as other text looks consistent. A single rule, \"if it overflows, truncate the tail,\" applies cleanly across the whole app. It's the default, so there's nothing extra to decide."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying the same rule as other text looks consistent. A single rule, \"if it overflows, truncate the tail,\" applies cleanly across the whole app. It's the default, so there's nothing extra to decide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのテキストと同じルールを当てはめれば、一貫して見える。「あふれたらtailで切り詰める」という1つのルールが、アプリ全体にすっきりと適用される。デフォルトなので、別に決めることもない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用与其他文字相同的规则，看起来就一致。“溢出就用 tail 截断”这一条规则干净地铺满整个应用。它是默认值，也无需另行决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式與其他文字相同的規則，看起來就一致。「溢位就用 tail 截斷」這一條規則乾淨地鋪滿整個應用程式。它是預設值，也無需另行決定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применение того же правила, что к остальному тексту, выглядит последовательно. Единственное правило «если переполняется, обрезай хвост» аккуратно применяется во всём приложении. Это значение по умолчанию, так что ничего дополнительно решать не нужно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar la misma regla que a los demás textos parece coherente. Una sola regla, «si desborda, trunca el final», se aplica limpiamente a toda la app. Es el valor por defecto, así que no hay nada extra que decidir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Regel wie bei anderem Text anzuwenden wirkt konsistent. Eine einzige Regel, „läuft es über, schneide das Ende ab“, gilt sauber in der ganzen App. Es ist der Standard, also gibt es nichts Zusätzliches zu entscheiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer la même règle que pour les autres textes paraît cohérent. Une seule règle, « si ça déborde, tronquez la fin », s'applique proprement dans toute l'app. C'est le réglage par défaut, donc il n'y a rien de plus à décider."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicare la stessa regola degli altri testi sembra coerente. Un'unica regola, «se trabocca, tronca la coda», si applica in modo pulito a tutta l'app. È il predefinito, quindi non c'è nulla in più da decidere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar a mesma regra dos outros textos parece consistente. Uma única regra, «se transborda, trunque o fim», se aplica com limpeza ao app inteiro. É o padrão, então não há nada extra a decidir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้กฎเดียวกับข้อความอื่นดูสอดคล้อง กฎเดียว \"ถ้าล้น ให้ตัดท้าย\" ใช้ได้เรียบร้อยทั่วทั้งแอป เป็นค่าเริ่มต้น จึงไม่มีอะไรเพิ่มให้ตัดสินใจ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp cùng quy tắc như văn bản khác trông nhất quán. Một quy tắc duy nhất, \"tràn thì cắt đuôi\", áp gọn trên toàn app. Đó là mặc định nên không có gì thêm để quyết định."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použití stejného pravidla jako u jiného textu vypadá konzistentně. Jediné pravidlo „když přetéká, ořízni konec“ se čistě aplikuje v celé aplikaci. Je to výchozí, takže není o čem navíc rozhodovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At anvende samme regel som anden tekst ser ensartet ud. Én regel, »hvis det løber over, afkort enden«, gælder rent i hele appen. Det er standarden, så der er intet ekstra at beslutte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή του ίδιου κανόνα με το άλλο κείμενο φαίνεται συνεπής. Ένας μόνο κανόνας, «αν υπερχειλίζει, περίκοψε το τέλος», εφαρμόζεται καθαρά σε ολόκληρη την εφαρμογή. Είναι η προεπιλογή, οπότε δεν υπάρχει τίποτα επιπλέον να αποφασίσεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saman säännön soveltaminen kuin muuhun tekstiin näyttää johdonmukaiselta. Yksi sääntö, ”jos ylivuotaa, katkaise loppu”, soveltuu siististi koko sovellukseen. Se on oletus, joten mitään ylimääräistä ei tarvitse päättää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerapkan aturan yang sama dengan teks lain tampak konsisten. Satu aturan, \"jika meluap, potong ekornya,\" berlaku rapi di seluruh aplikasi. Itu bawaan, jadi tak ada yang perlu diputuskan tambahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å bruke samme regel som for annen tekst ser konsekvent ut. Én enkelt regel, «hvis det flyter over, avkort halen», gjelder rent i hele appen. Det er standarden, så det er ingenting ekstra å avgjøre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezelfde regel toepassen als op andere tekst lijkt consistent. Eén regel, \"als het overloopt, kap het eind af\", geldt netjes voor de hele app. Het is de standaard, dus er valt niets extra te beslissen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastosowanie tej samej reguły co dla innego tekstu wygląda spójnie. Jedna reguła, „jeśli się przepełnia, obetnij koniec”, stosuje się czysto w całej aplikacji. To ustawienie domyślne, więc nie ma niczego dodatkowego do decydowania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att tillämpa samma regel som för annan text ser konsekvent ut. En enda regel, ”om det flödar över, kapa slutet”, gäller rent över hela appen. Det är standard, så det finns inget extra att avgöra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer metinlerle aynı kuralı uygulamak tutarlı görünür. Tek bir kural, “taşarsa sonu kes”, tüm uygulamada temiz biçimde uygulanır. Varsayılan, bu yüzden karar verilecek fazladan bir şey yok."
          }
        }
      }
    },
    "다른 플랫폼과 자리를 맞추기 전에, 이 플랫폼의 시스템 배치가 무엇을 풀려고 바뀌었는지 먼저 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before matching another platform's placement, first look at what problem this platform's system placement changed to solve."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before matching another platform's placement, first look at what problem this platform's system placement changed to solve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのプラットフォームと位置をそろえる前に、このプラットフォームのシステムの配置が何を解決するために変わったのかを先に見る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与其他平台对齐位置之前，先看这个平台的系统布局是为解决什么而改变的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與其他平臺對齊位置之前，先看這個平臺的系統佈局是為解決什麼而改變的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем выравнивать расположение по другой платформе, сначала посмотрите, какую проблему решало изменение системного расположения на этой платформе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de copiar la colocación de otra plataforma, mira primero qué problema cambió a resolver la colocación del sistema de esta plataforma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du die Platzierung einer anderen Plattform übernimmst, sieh zuerst, welches Problem die Systemplatzierung dieser Plattform lösen sollte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de reproduire le placement d'une autre plateforme, regardez d'abord quel problème le placement système de cette plateforme-ci a changé pour résoudre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di imitare la collocazione di un'altra piattaforma, guarda prima quale problema ha cambiato per risolvere la collocazione di sistema di questa piattaforma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de copiar a colocação de outra plataforma, veja primeiro que problema a colocação de sistema desta plataforma mudou para resolver."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนจะจับคู่ตำแหน่งของแพลตฟอร์มอื่น ให้ดูก่อนว่าการวางของระบบแพลตฟอร์มนี้เปลี่ยนไปเพื่อแก้ปัญหาอะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi khớp vị trí của nền tảng khác, trước hết hãy xem vị trí hệ thống của nền tảng này được đổi để giải quyết vấn đề gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než se přizpůsobíte umístění jiné platformy, nejdřív se podívejte, jaký problém systémové umístění této platformy změnilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du matcher en anden platforms placering, så se først på, hvilket problem denne platforms systemplacering ændrede sig for at løse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν ταιριάξεις την τοποθέτηση μιας άλλης πλατφόρμας, δες πρώτα ποιο πρόβλημα άλλαξε η τοποθέτηση συστήματος αυτής της πλατφόρμας για να λύσει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennen kuin sovitat toisen alustan sijoituksen, katso ensin, minkä ongelman ratkaisemiseksi tämän alustan järjestelmäsijoitus muuttui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum menyamakan penempatan platform lain, lihat dulu masalah apa yang diubah penempatan sistem platform ini untuk diselesaikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du matcher en annen plattforms plassering, se først på hvilket problem denne plattformens systemplassering ble endret for å løse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat je de plaatsing van een ander platform overneemt, kijk eerst welk probleem de systeemplaatsing van dit platform wilde oplossen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim dopasujesz się do rozmieszczenia innej platformy, najpierw zobacz, jaki problem miało rozwiązać systemowe rozmieszczenie tej platformy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Innan du matchar en annan plattforms placering, titta först på vilket problem den här plattformens systemplacering förändrades för att lösa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir platformun yerleşimine uymadan önce bu platformun sistem yerleşiminin hangi sorunu çözmek için değiştiğine bak."
          }
        }
      }
    },
    "단계마다 레이아웃이 확 바뀜": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A layout that changes abruptly at each step"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A layout that changes abruptly at each step"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "段階ごとにレイアウトががらりと変わる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一步布局都大幅变化"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一步佈局都大幅變化"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раскладка, резко меняющаяся на каждом шаге"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un diseño que cambia bruscamente en cada escalón"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Layout, das sich bei jedem Schritt abrupt ändert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une disposition qui change brusquement à chaque étape"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un layout che cambia bruscamente a ogni passo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um layout que muda bruscamente a cada passo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลย์เอาต์ที่เปลี่ยนอย่างฉับพลันในแต่ละขั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục thay đổi đột ngột ở mỗi bước"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozvržení, které se na každém kroku náhle mění"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et layout, der ændrer sig brat ved hvert trin"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια διάταξη που αλλάζει απότομα σε κάθε βήμα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettelu, joka muuttuu äkillisesti jokaisessa vaiheessa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letak yang berubah mendadak di setiap langkah"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En layout som endres brått ved hvert trinn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een layout die bij elke stap abrupt verandert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Układ, który zmienia się gwałtownie na każdym kroku"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En layout som ändras abrupt vid varje steg"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her adımda aniden değişen bir düzen"
          }
        }
      }
    },
    "단색 판은 뒤 콘텐츠와 **단절된 스티커**다. 콘텐츠가 옆을 스쳐 지나갈 때 흐름이 바의 경계에서 뚝 끊기고, 화면은 둘로 잘린다. 또 단색의 대비는 한 가지 배경에서만 계산된 값이라 사진이 바뀌면 어느 쪽에선가 어긋난다. 깔끔함은 시안의 배경에서만 참이었다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A solid panel is a **sticker cut off** from the content behind it. As content glides past, the flow stops dead at the bar's edge, and the screen is cut in two. The solid color's contrast is also calculated against a single background, so when the photo changes, it falls apart on one side or the other. The cleanness was only true on the mockup's background."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A solid panel is a **sticker cut off** from the content behind it. As content glides past, the flow stops dead at the bar's edge, and the screen is cut in two. The solid colour's contrast is also calculated against a single background, so when the photo changes, it falls apart on one side or the other. The cleanness was only true on the mockup's background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単色の板は、背後のコンテンツから**切り離されたステッカー**だ。コンテンツが横を通り過ぎるとき、流れがバーの境目でぷつりと途切れ、画面は2つに切れる。また単色のコントラストは1つの背景でだけ計算された値なので、写真が変わるとどちらかでずれる。すっきり感は、カンプの背景でだけ本当だった。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯色底板是与后面内容**脱节的贴纸**。内容从旁边掠过时，流动在栏的边界处戛然而止，界面被切成两半。而且纯色的对比度只是针对某一个背景算出的值，照片一换，总会在某一边出错。整洁只在设计稿的背景上成立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "純色底板是與後面內容**脫節的貼紙**。內容從旁邊掠過時，流動在列的邊界處戛然而止，介面被切成兩半。而且純色的對比度只是針對某一個背景算出的值，照片一換，總會在某一邊出錯。整潔只在設計稿的背景上成立。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сплошная панель - это **наклейка, оторванная** от контента позади. Когда контент скользит мимо, поток упирается в край панели, и экран оказывается разрезан надвое. Контраст сплошного цвета тоже рассчитан на один фон, поэтому при смене фотографии он разваливается с одной из сторон. Чистота была верна только на фоне макета."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel sólido es una **pegatina cortada** del contenido de detrás. Cuando el contenido se desliza por detrás, el flujo se detiene en seco en el borde de la barra y la pantalla queda partida en dos. El contraste del color sólido también se calcula contra un solo fondo, así que cuando cambia la foto, se desmorona por un lado u otro. La limpieza solo era cierta sobre el fondo de la maqueta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einfarbiges Panel ist ein **Aufkleber, abgeschnitten** vom Inhalt dahinter. Gleitet Inhalt vorbei, bricht der Fluss am Rand der Leiste ab, und der Bildschirm wird in zwei geschnitten. Auch der Kontrast der Vollfarbe ist gegen einen einzigen Hintergrund berechnet, sodass er auf der einen oder anderen Seite zerfällt, wenn sich das Foto ändert. Die Sauberkeit stimmte nur auf dem Hintergrund des Mockups."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panneau uni est un **autocollant découpé** du contenu derrière lui. Quand le contenu glisse, le flux s'arrête net au bord de la barre, et l'écran est coupé en deux. Le contraste de la couleur unie est aussi calculé pour un seul arrière-plan, donc quand la photo change, il s'effondre d'un côté ou de l'autre. La netteté n'était vraie que sur l'arrière-plan de la maquette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pannello pieno è un **adesivo ritagliato** dal contenuto che sta dietro. Mentre il contenuto scivola, il flusso si ferma di colpo al bordo della barra e la schermata è tagliata in due. Anche il contrasto del colore pieno è calcolato su un solo sfondo, quindi quando la foto cambia, cede da una parte o dall'altra. La pulizia era vera solo sullo sfondo del mockup."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um painel sólido é um **adesivo recortado** do conteúdo que está atrás. Conforme o conteúdo desliza, o fluxo para seco na borda da barra e a tela é cortada em duas. O contraste da cor sólida também é calculado contra um único fundo, então, quando a foto muda, desmorona de um lado ou do outro. A limpeza só era verdade no fundo do mockup."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผงทึบคือ**สติกเกอร์ที่ขาดจาก**เนื้อหาด้านหลัง ขณะที่เนื้อหาเลื่อนผ่าน การไหลหยุดตายที่ขอบของแถบ และหน้าจอถูกตัดเป็นสอง ความตัดกันของสีทึบก็คำนวณกับพื้นหลังเดียว เมื่อรูปถ่ายเปลี่ยน มันจึงพังด้านใดด้านหนึ่ง ความเรียบร้อยจริงเฉพาะบนพื้นหลังของม็อกอัป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng đặc là **miếng dán cắt rời** khỏi nội dung phía sau. Khi nội dung lướt qua, dòng chảy dừng cụt ở mép thanh, và màn hình bị cắt làm đôi. Độ tương phản của màu đặc cũng chỉ tính với một nền, nên khi ảnh đổi, nó vỡ ở bên này hoặc bên kia. Sự gọn gàng chỉ đúng trên nền của mockup."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pevný panel je **odříznutá nálepka** od obsahu za ním. Jak obsah klouže kolem, tok se na okraji panelu zastaví a obrazovka je rozříznuta na dvě. Kontrast pevné barvy je také počítán vůči jedinému pozadí, takže když se fotka změní, rozpadne se na jedné nebo druhé straně. Čistota platila jen na pozadí mockupu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ensfarvet panel er et **udskåret klistermærke** fra indholdet bagved. Når indhold glider forbi, stopper flowet dødt ved bjælkens kant, og skærmen skæres i to. Den ensfarvede kontrast er også beregnet mod én enkelt baggrund, så når fotoet skifter, falder den fra hinanden på den ene eller anden side. Renheden var kun sand på mockuppets baggrund."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα συμπαγές πάνελ είναι ένα **αυτοκόλλητο αποκομμένο** από το περιεχόμενο πίσω του. Καθώς το περιεχόμενο γλιστρά, η ροή σταματά νεκρή στην άκρη της γραμμής, και η οθόνη κόβεται στα δύο. Η αντίθεση του συμπαγούς χρώματος υπολογίζεται επίσης έναντι ενός μόνο φόντου, οπότε όταν αλλάζει η φωτογραφία, καταρρέει από τη μία ή την άλλη πλευρά. Η καθαρότητα ίσχυε μόνο στο φόντο του μοντέλου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhtenäinen paneeli on **irrotettu tarra** sen takana olevasta sisällöstä. Kun sisältö liukuu ohi, virtaus pysähtyy kuolleena palkin reunaan, ja näkymä leikkautuu kahtia. Yhtenäisen värin kontrasti on myös laskettu yhtä taustaa vasten, joten kun valokuva vaihtuu, se hajoaa toiselta tai toiselta puolelta. Siisteys oli tosi vain luonnoksen taustalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel solid adalah **stiker yang terputus** dari konten di belakangnya. Saat konten meluncur lewat, alirannya berhenti mati di tepi bilah, dan layar terbelah dua. Kontras warna solid juga dihitung terhadap satu latar, sehingga saat foto berganti, ia berantakan di satu sisi atau lainnya. Kebersihannya hanya benar pada latar mockup."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ensfarget panel er et **klistremerke avskåret** fra innholdet bak. Mens innholdet glir forbi, stopper flyten dødt ved linjens kant, og skjermen kuttes i to. Den ensfargede fargens kontrast er også regnet ut mot én bakgrunn, så når bildet endres, faller den fra hverandre på den ene eller andre siden. Renheten var bare sann på utkastets bakgrunn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een effen paneel is **een losgesneden sticker** van de inhoud erachter. Terwijl inhoud voorbijglijdt, stopt de stroom abrupt aan de rand van de balk, en wordt het scherm in tweeën gesneden. Het contrast van de effen kleur is ook berekend tegen één achtergrond, dus als de foto verandert, valt het aan de ene of andere kant uit elkaar. De netheid was alleen waar op de achtergrond van de mockup."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednolity panel to **odcięta naklejka** od treści za nim. Gdy treść przesuwa się obok, przepływ zatrzymuje się martwo na krawędzi paska, a ekran jest przecięty na dwoje. Kontrast jednolitego koloru jest też obliczony względem jednego tła, więc gdy zdjęcie się zmienia, rozpada się po jednej lub drugiej stronie. Czystość była prawdziwa tylko na tle makiety."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En massiv panel är ett **avskuret klistermärke** från innehållet bakom. När innehållet glider förbi stannar flödet tvärt vid fältets kant, och skärmen skärs i två. Den massiva färgens kontrast beräknas också mot en enda bakgrund, så när fotot ändras faller det sönder åt ena eller andra hållet. Renheten var bara sann på skissens bakgrund."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düz bir panel, arkasındaki içerikten **kesilmiş bir etikettir**. İçerik kayarken akış çubuğun kenarında bir anda durur ve ekran ikiye bölünür. Düz rengin kontrastı da tek bir arka plana göre hesaplanır, bu yüzden fotoğraf değiştiğinde bir yandan ya da öbür yandan dağılır. Temizlik yalnızca taslağın arka planında doğruydu."
          }
        }
      }
    },
