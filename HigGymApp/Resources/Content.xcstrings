        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題被截斷了，不減少項目數，只硬縮小文字"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок обрезается, но вместо сокращения числа элементов текст принудительно сжимают"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título se recorta, pero en lugar de reducir el número de elementos, se encoge el texto a la fuerza"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel wird abgeschnitten, aber statt die Zahl der Elemente zu verringern, wird der Text zwangsweise verkleinert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre est coupé, mais au lieu de réduire le nombre d'éléments, le texte est rétréci de force"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo viene tagliato, ma invece di ridurre il numero di elementi, il testo viene rimpicciolito a forza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título é cortado, mas em vez de reduzir o número de itens, o texto é encolhido à força"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องถูกตัด แต่แทนที่จะลดจำนวนรายการ กลับบังคับย่อข้อความ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề bị cắt, nhưng thay vì giảm số mục, chữ bị ép co lại"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadpis se ořezává, ale místo snížení počtu položek se text násilně zmenší"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlen bliver klippet, men i stedet for at reducere antallet af elementer bliver teksten tvangsskrumpet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο τίτλος κόβεται, αλλά αντί να μειώσεις τα στοιχεία, το κείμενο σμικρύνεται με το ζόρι"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsikko leikkautuu, mutta kohteiden vähentämisen sijaan teksti pakotetaan kutistumaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul terpotong, tetapi alih-alih mengurangi jumlah item, teks dipaksa menyusut"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tittelen blir kuttet, men i stedet for å redusere antall elementer krympes teksten med makt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De titel wordt afgesneden, maar in plaats van het aantal items te verminderen, wordt de tekst geforceerd verkleind"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuł jest ucinany, ale zamiast zmniejszyć liczbę elementów, tekst jest na siłę zmniejszany"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubriken klipps, men i stället för att minska antalet objekt tvingas texten att krympa"
