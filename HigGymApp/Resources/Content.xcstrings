          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'onglets **reste en place** même dans les écrans de détail, servant de carte permanente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra delle schede **resta ferma** anche nelle schermate di dettaglio, fungendo da mappa costante"
