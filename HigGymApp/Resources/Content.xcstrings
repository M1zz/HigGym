    "자동 인셋을 못 믿고 수동 패딩을 중복": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not trusting the automatic inset and adding manual padding on top"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not trusting the automatic inset and adding manual padding on top"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動インセットを信用せず手動のパディングを重ねる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不信任自动内边距，又重复加手动内边距"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不信任自動內邊距，又重複加手動內邊距"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоверие к автоматическому отступу и добавление ручного паддинга сверху"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No fiarse del margen automático y añadir relleno manual encima"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem automatischen Einzug nicht trauen und manuelles Padding obendrauf geben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas se fier au décalage automatique et ajouter un padding manuel par-dessus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non fidarsi dello spostamento automatico e aggiungere un padding manuale sopra"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não confiar no recuo automático e acrescentar padding manual por cima"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เชื่อการเว้นระยะอัตโนมัติและเพิ่ม padding แบบแมนนวลซ้อนทับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tin phần đệm tự động và thêm padding thủ công lên trên"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedůvěřovat automatickému odsazení a přidat nahoru ruční padding"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At ikke stole på den automatiske indrykning og tilføje manuel padding oven i"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μη εμπιστοσύνη στην αυτόματη εσοχή και προσθήκη χειροκίνητου padding από πάνω"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattisen sisennyksen epäileminen ja manuaalisen paddingin lisääminen päälle"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak mempercayai inset otomatis dan menambah padding manual di atasnya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å ikke stole på det automatiske innrykket og legge til manuell padding oppå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De automatische inset niet vertrouwen en er handmatige padding bovenop zetten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zaufania do automatycznego marginesu i dodanie ręcznego paddingu na wierzchu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att inte lita på den automatiska indragningen och lägga till manuell padding ovanpå"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik girintiye güvenmeyip üstüne elle dolgu eklemek"
          }
        }
      }
    },
    "자동으로 배경과 조화": {
      "extractionState": "manual",
