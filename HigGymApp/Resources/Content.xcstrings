        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is de eenvoudigste manier om iets boven op het scherm te zetten, dus het is wat je als eerste pakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To najprostszy sposób, by coś położyć na wierzchu ekranu, więc to po niego sięgasz najpierw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är det enklaste sättet att lägga något ovanpå skärmen, så det är det du tar till först."
          }
        },
        "tr": {
          "stringUnit": {
