          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng chiều cao pixel cố định mà không thử trên các thiết bị"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použití pevné výšky v pixelech bez testování napříč zařízeními"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
