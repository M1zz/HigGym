    "화면 **하단 툴바**(.bottomBar)에 아이템 하나. 떠 있는 유리로 표시.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single item in the **bottom toolbar** (.bottomBar), shown as floating glass."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A single item in the **bottom toolbar** (.bottomBar), shown as floating glass."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の**下部のツールバー**（.bottomBar）にアイテムがひとつ。浮かぶガラスとして表示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面**底部工具栏**（.bottomBar）放一个项目。显示为浮着的玻璃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面**底部工具列**（.bottomBar）放一個項目。顯示為浮著的玻璃。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единственный элемент на **нижней панели инструментов** (.bottomBar), отображаемый парящим стеклом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un único elemento en la **barra de herramientas inferior** (.bottomBar), mostrado como cristal flotante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelnes Element in der **unteren Symbolleiste** (.bottomBar), als schwebendes Glas dargestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul élément dans la **barre d'outils du bas** (.bottomBar), affiché comme du verre flottant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singolo elemento nella **barra degli strumenti in basso** (.bottomBar), mostrato come vetro fluttuante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único item na **barra de ferramentas inferior** (.bottomBar), mostrado como vidro flutuante."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการเดี่ยวใน**แถบเครื่องมือล่าง** (.bottomBar) แสดงเป็นกระจกลอย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mục đơn trong **thanh công cụ dưới** (.bottomBar), hiện như kính nổi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jediná položka ve **spodním panelu nástrojů** (.bottomBar), zobrazená jako plovoucí sklo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et enkelt element i den **nederste værktøjslinje** (.bottomBar), vist som flydende glas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μόνο στοιχείο στην **κάτω γραμμή εργαλείων** (.bottomBar), που εμφανίζεται ως πλωτό γυαλί."
          }
        }
      }
    },
    "화면 끝까지 꽉 채우는 편이 시원해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filling the screen all the way to the edge looks cleaner."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Filling the screen all the way to the edge looks cleaner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の端までぎっしり埋めたほうがすっきり見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铺满到屏幕尽头显得畅快。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鋪滿到螢幕盡頭顯得暢快。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заполнение экрана до самого края выглядит чище."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llenar la pantalla hasta el borde se ve más limpio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Bildschirm bis zum Rand zu füllen wirkt sauberer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplir l'écran jusqu'au bord paraît plus propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riempire lo schermo fino al bordo sembra più pulito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencher a tela até a borda parece mais limpo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเติมหน้าจอจนถึงขอบดูสะอาดกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấp đầy màn hình đến tận mép trông gọn hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplnění obrazovky až k okraji vypadá čistěji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At fylde skærmen helt ud til kanten ser renere ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το να γεμίζεις την οθόνη μέχρι την άκρη φαίνεται πιο καθαρό."
          }
        }
      }
    },
    "화면 끝까지 꽉 채운 바는 시원해 보인다. 아래에 빈 띠가 남으면 덜 만든 화면 같다. 하단은 엄지가 닿는 좋은 자리이니 가능한 한 아래로 내리면 더 누르기 쉬울 것 같다. safe area를 무시하고 직접 배치하면 원하는 위치에 정확히 둘 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bar that fills the screen all the way to the edge looks clean. Leave an empty strip at the bottom, and the screen looks unfinished. The bottom is a great spot for the thumb, so pushing things as low as possible seems like it would make them easier to tap. Ignore the safe area and lay things out yourself, and you can place them exactly where you want."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A bar that fills the screen all the way to the edge looks clean. Leave an empty strip at the bottom, and the screen looks unfinished. The bottom is a great spot for the thumb, so pushing things as low as possible seems like it would make them easier to tap. Ignore the safe area and lay things out yourself, and you can place them exactly where you want."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の端までぎっしり埋めたバーはすっきり見える。下に空いた帯が残ると、作りかけの画面のように見える。下部は親指が届くいい場所なので、できるだけ下に置けばもっと押しやすくなりそうだ。safe areaを無視して自分で配置すれば、狙った位置に正確に置ける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "铺满到屏幕尽头的栏显得畅快。下面留一条空带，就像没做完的界面。底部是拇指够得着的好位置，尽量往下放似乎更好点。无视 safe area 自己摆放，能精确放在想要的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鋪滿到螢幕盡頭的列顯得暢快。下面留一條空帶，就像沒做完的介面。底部是拇指夠得著的好位置，儘量往下放似乎更好點。無視 safe area 自己擺放，能精確放在想要的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель, заполняющая экран до самого края, выглядит чисто. Оставьте внизу пустую полосу, и экран выглядит незаконченным. Низ - отличное место для большого пальца, поэтому прижать всё как можно ниже кажется способом упростить нажатие. Проигнорируйте safe area и компонуйте сами, и можно разместить всё точно где хочется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra que llena la pantalla hasta el borde se ve limpia. Deja una franja vacía abajo y la pantalla parece inacabada. La parte inferior es un sitio estupendo para el pulgar, así que empujar las cosas lo más abajo posible parece que las haría más fáciles de tocar. Ignora el área segura y coloca las cosas tú mismo, y podrás ponerlas exactamente donde quieras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Leiste, die den Bildschirm bis zum Rand füllt, wirkt sauber. Lässt man unten einen leeren Streifen, wirkt der Bildschirm unfertig. Der untere Rand ist ein großartiger Platz für den Daumen, also scheint es, als machte es Dinge leichter antippbar, sie so tief wie möglich zu schieben. Ignoriert man den sicheren Bereich und ordnet selbst an, kann man alles genau dorthin setzen, wo man es will."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre qui remplit l'écran jusqu'au bord paraît propre. Laissez une bande vide en bas, et l'écran paraît inachevé. Le bas est un excellent emplacement pour le pouce, donc pousser les choses le plus bas possible semble les rendre plus faciles à toucher. Ignorez la zone sûre et disposez les choses vous-même, et vous pouvez les placer exactement où vous voulez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra che riempie lo schermo fino al bordo sembra pulita. Lascia una fascia vuota in basso e la schermata sembra non finita. Il basso è un ottimo posto per il pollice, quindi spingere le cose il più in basso possibile sembra renderle più facili da toccare. Ignora l'area sicura e disponi le cose da solo e puoi collocarle esattamente dove vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra que preenche a tela até a borda parece limpa. Deixe uma faixa vazia embaixo e a tela parece inacabada. A parte de baixo é um ótimo lugar para o polegar, então empurrar as coisas o mais para baixo possível parece torná-las mais fáceis de tocar. Ignore a área segura e disponha as coisas você mesmo, e poderá colocá-las exatamente onde quiser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบที่เติมหน้าจอจนถึงขอบดูสะอาด ทิ้งแถบว่างไว้ด้านล่าง หน้าจอก็ดูไม่เสร็จ ด้านล่างเป็นที่ที่ดีสำหรับนิ้วโป้ง การดันสิ่งต่าง ๆ ให้ต่ำที่สุดจึงดูเหมือนจะแตะง่ายขึ้น ละเลย safe area และจัดวางเอง คุณวางได้ตรงที่ต้องการพอดี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thanh lấp đầy màn hình đến tận mép trông gọn. Để lại một dải trống ở dưới, màn hình trông chưa xong. Phần dưới là chỗ tuyệt vời cho ngón cái, nên đẩy mọi thứ xuống thấp nhất có vẻ khiến dễ chạm hơn. Bỏ qua safe area và tự bố trí, bạn đặt được đúng chỗ muốn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel vyplňující obrazovku až k okraji vypadá čistě. Nechte dole prázdný pás a obrazovka vypadá nedokončeně. Spodek je skvělé místo pro palec, takže tlačit věci co nejníž se zdá, že usnadní klepnutí. Ignorujte safe area a rozvrhněte věci sami a můžete je umístit přesně tam, kam chcete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En bjælke, der fylder skærmen helt ud til kanten, ser ren ud. Lad en tom strimmel stå i bunden, og skærmen ser uafsluttet ud. Bunden er en fantastisk plads til tommelfingeren, så at skubbe ting så langt ned som muligt ser ud til at gøre dem nemmere at trykke på. Ignorer safe area og læg ud selv, og du kan placere ting præcis, hvor du vil."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γραμμή που γεμίζει την οθόνη μέχρι την άκρη φαίνεται καθαρή. Άφησε μια άδεια λωρίδα κάτω και η οθόνη φαίνεται ημιτελής. Το κάτω μέρος είναι εξαιρετικό σημείο για τον αντίχειρα, οπότε το να σπρώξεις τα πράγματα όσο πιο χαμηλά γίνεται φαίνεται ότι θα τα κάνει πιο εύκολα στο πάτημα. Αγνόησε την ασφαλή περιοχή και διάταξέ τα μόνος σου, και μπορείς να τα βάλεις ακριβώς όπου θέλεις."
          }
        }
      }
    },
    "화면 내용과 무관한 브랜드 로고를 principal에 넣고 제목을 없앰": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A brand logo unrelated to the screen's content placed in principal, removing the title"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A brand logo unrelated to the screen's content placed in principal, removing the title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の内容と無関係なブランドロゴをprincipalに入れ、タイトルをなくしている"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把与界面内容无关的品牌标志放进 principal，去掉标题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把與介面內容無關的品牌標誌放進 principal，去掉標題"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фирменный логотип, не связанный с содержимым экрана, помещён в principal, а заголовок убран"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un logotipo de marca sin relación con el contenido de la pantalla colocado en principal, quitando el título"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Markenlogo, das mit dem Inhalt des Bildschirms nichts zu tun hat, in principal setzen und dadurch den Titel entfernen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un logo de marque sans rapport avec le contenu de l'écran placé dans principal, supprimant le titre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un logo del marchio non legato al contenuto della schermata collocato in principal, che rimuove il titolo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um logo de marca sem relação com o conteúdo da tela posto em principal, removendo o título"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โลโก้แบรนด์ที่ไม่เกี่ยวกับเนื้อหาของหน้าจอวางใน principal และเอาชื่อเรื่องออก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một logo thương hiệu không liên quan nội dung màn hình đặt trong principal, bỏ tiêu đề"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo značky nesouvisející s obsahem obrazovky umístěné v principal, odstraňující nadpis"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et brandlogo, der er urelateret til skærmens indhold, placeret i principal og fjerner titlen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα λογότυπο brand άσχετο με το περιεχόμενο της οθόνης τοποθετημένο στο principal, αφαιρώντας τον τίτλο"
          }
        }
      }
    },
    "화면 라벨이 없어도 **accessibilityLabel은 필수**입니다. VoiceOver 사용자에겐 그 라벨이 전부입니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even without an on-screen label, **accessibilityLabel is required**. For VoiceOver users, that label is everything."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Even without an on-screen label, **accessibilityLabel is required**. For VoiceOver users, that label is everything."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のラベルがなくても**accessibilityLabelは必須**です。VoiceOverのユーザーにとっては、そのラベルがすべてです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面没有标签时，**accessibilityLabel 也是必需的**。对 VoiceOver 用户来说，那个标签就是全部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面沒有標籤時，**accessibilityLabel 也是必需的**。對 VoiceOver 使用者來說，那個標籤就是全部。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже без подписи на экране **accessibilityLabel обязателен**. Для пользователей VoiceOver эта подпись - всё."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso sin etiqueta en pantalla, **accessibilityLabel es obligatorio**. Para los usuarios de VoiceOver, esa etiqueta lo es todo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch ohne Beschriftung auf dem Bildschirm ist **accessibilityLabel Pflicht**. Für VoiceOver-Nutzer ist diese Beschriftung alles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même sans libellé à l'écran, **accessibilityLabel est obligatoire**. Pour les utilisateurs de VoiceOver, ce libellé est tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche senza un'etichetta sullo schermo, **accessibilityLabel è obbligatorio**. Per gli utenti di VoiceOver, quell'etichetta è tutto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo sem rótulo na tela, **accessibilityLabel é obrigatório**. Para os usuários do VoiceOver, esse rótulo é tudo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้ไม่มีป้ายชื่อบนหน้าจอ **accessibilityLabel ก็จำเป็น** สำหรับผู้ใช้ VoiceOver ป้ายนั้นคือทุกอย่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay cả khi không có nhãn trên màn hình, **accessibilityLabel là bắt buộc**. Với người dùng VoiceOver, nhãn đó là tất cả."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I bez popisku na obrazovce je **accessibilityLabel povinný**. Pro uživatele VoiceOveru je tento popisek vším."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv uden en etiket på skærmen er **accessibilityLabel påkrævet**. For VoiceOver-brugere er den etiket alt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμα και χωρίς ετικέτα στην οθόνη, **το accessibilityLabel είναι υποχρεωτικό**. Για τους χρήστες VoiceOver, αυτή η ετικέτα είναι τα πάντα."
          }
        }
      }
    },
    "화면 모드를 바꾸는 컨트롤(중앙)과, 그 모드와 무관하게 늘 필요한 액션(오른쪽, 예: 더보기, 설정)이 **동시에** 필요할 때.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you need, **at the same time**, a control that switches the screen's mode (center) and an action that is always needed regardless of that mode (right; for example, More or Settings)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you need, **at the same time**, a control that switches the screen's mode (centre) and an action that is always needed regardless of that mode (right; for example, More or Settings)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のモードを切り替えるコントロール（中央）と、そのモードに関係なく常に必要なアクション（右。例：その他、設定）が**同時に**必要なとき。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时需要改变界面模式的控件（中间），以及与该模式无关、始终需要的操作（右侧，如更多、设置）时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時需要改變介面模式的控制元件（中間），以及與該模式無關、始終需要的操作（右側，如更多、設定）時。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вам нужны **одновременно** элемент, переключающий режим экрана (центр), и действие, нужное всегда независимо от этого режима (справа; например, «Ещё» или «Настройки»)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando necesitas, **a la vez**, un control que cambia el modo de la pantalla (centro) y una acción que siempre hace falta independientemente de ese modo (derecha; por ejemplo, Más o Ajustes)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du **zugleich** ein Steuerelement brauchst, das den Modus des Bildschirms umschaltet (Mitte), und eine Aktion, die unabhängig von diesem Modus immer gebraucht wird (rechts; zum Beispiel Mehr oder Einstellungen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous avez besoin, **en même temps**, d'un contrôle qui change le mode de l'écran (centre) et d'une action toujours nécessaire quel que soit ce mode (droite ; par exemple, Plus ou Réglages)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ti servono, **nello stesso momento**, un controllo che cambia la modalità della schermata (centro) e un'azione sempre necessaria a prescindere da quella modalità (destra; per esempio Altro o Impostazioni)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você precisa, **ao mesmo tempo**, de um controle que troca o modo da tela (centro) e de uma ação sempre necessária independentemente desse modo (direita; por exemplo, Mais ou Ajustes)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณต้องการ**พร้อมกัน** ตัวควบคุมที่สลับโหมดของหน้าจอ (กลาง) และการกระทำที่ต้องการเสมอไม่ว่าโหมดไหน (ขวา เช่นเพิ่มเติมหรือการตั้งค่า)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn cần, **cùng một lúc**, một điều khiển đổi chế độ màn hình (giữa) và một hành động luôn cần bất kể chế độ đó (phải; ví dụ Thêm hoặc Cài đặt)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když potřebujete **současně** ovladač, který přepíná režim obrazovky (střed), a akci, která je vždy potřeba bez ohledu na ten režim (vpravo; například Více nebo Nastavení)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du **samtidig** har brug for en kontrol, der skifter skærmens tilstand (midten), og en handling, der altid er nødvendig uanset tilstanden (højre; for eksempel Mere eller Indstillinger)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν χρειάζεσαι, **ταυτόχρονα**, έναν έλεγχο που αλλάζει τη λειτουργία της οθόνης (κέντρο) και μια ενέργεια που χρειάζεται πάντα ανεξάρτητα από αυτή τη λειτουργία (δεξιά· για παράδειγμα Περισσότερα ή Ρυθμίσεις)."
          }
        }
      }
    },
    "화면 사용 흐름에서 **검색이 반복적으로 필요한** 경우, 연락처처럼 \"찾기\"가 주 사용 패턴이고, 스크롤 중에도 언제든 재검색할 수 있어야 할 때.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the screen's flow **needs search again and again**: \"finding\" is the main usage pattern, as in Contacts, and people must be able to search again at any point while scrolling."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the screen's flow **needs search again and again**: \"finding\" is the main usage pattern, as in Contacts, and people must be able to search again at any point while scrolling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の使い方の流れの中で**検索が繰り返し必要な**場合。連絡先のように「探す」が主な使い方で、スクロール中でもいつでも検索し直せる必要があるとき。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在界面使用流程里**需要反复搜索**时：像通讯录那样“查找”是主要使用模式，滚动中也必须随时能重新搜索时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在介面使用流程裡**需要反覆搜尋**時：像通訊錄那樣「查詢」是主要使用模式，滾動中也必須隨時能重新搜尋時。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда сценарий экрана **требует поиска снова и снова**: «найти» - основной способ использования, как в «Контактах», и люди должны иметь возможность искать заново в любой момент прокрутки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el flujo de la pantalla **necesita búsqueda una y otra vez**: «encontrar» es el patrón de uso principal, como en Contactos, y la gente debe poder volver a buscar en cualquier punto del desplazamiento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Ablauf des Bildschirms **die Suche immer wieder braucht**: „Finden“ ist das Hauptnutzungsmuster, wie in Kontakte, und Menschen müssen an jedem Punkt beim Scrollen erneut suchen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le déroulement de l'écran **a besoin de la recherche encore et encore** : « trouver » est le principal usage, comme dans Contacts, et les gens doivent pouvoir rechercher à nouveau à n'importe quel moment du défilement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il flusso della schermata **ha bisogno della ricerca di continuo**: «trovare» è il modo d'uso principale, come in Contatti, e le persone devono poter cercare di nuovo in qualsiasi punto mentre scorrono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o fluxo da tela **precisa de busca o tempo todo**: «encontrar» é o modo de uso principal, como em Contatos, e as pessoas precisam poder buscar de novo em qualquer ponto ao rolar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อกระแสของหน้าจอ**ต้องการการค้นหาซ้ำแล้วซ้ำอีก**: \"การหา\" เป็นรูปแบบการใช้หลัก เช่นในรายชื่อติดต่อ และคนต้องค้นหาอีกได้ทุกจุดขณะเลื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi luồng của màn hình **cần tìm kiếm lặp đi lặp lại**: \"tìm\" là cách dùng chính, như trong Danh bạ, và người ta phải tìm lại được tại bất kỳ điểm nào khi cuộn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když tok obrazovky **potřebuje hledání znovu a znovu**: „hledání“ je hlavním způsobem používání, jako v Kontaktech, a lidé musejí moci hledat znovu v kterémkoli bodě při posouvání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når skærmens flow **har brug for søgning igen og igen**: »at finde« er det primære brugsmønster, som i Kontakter, og folk skal kunne søge igen når som helst under scrolling."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν η ροή της οθόνης **χρειάζεται αναζήτηση ξανά και ξανά**: το «εύρεση» είναι το κύριο μοτίβο χρήσης, όπως στις Επαφές, και οι άνθρωποι πρέπει να μπορούν να ξαναψάξουν σε οποιοδήποτε σημείο ενώ κυλούν."
          }
        }
      }
    },
    "화면 위에 무언가를 올리는 가장 익숙한 방법은 ZStack이나 overlay다. 바를 위에 쌓고 정렬만 top으로 주면 원하는 자리에 붙는다. 첫 줄이 가리면 목록 위쪽에 패딩을 적당히 더하면 될 것 같다. 바는 커스텀 뷰이니 시스템 바의 규칙과는 상관없다고 여긴다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most familiar way to put something on top of the screen is a ZStack or an overlay. Stack the bar on top, set the alignment to top, and it sticks where you want it. If the first row gets covered, adding some padding to the top of the list seems like it would do. The bar is a custom view, so you assume the rules for system bars don't apply."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The most familiar way to put something on top of the screen is a ZStack or an overlay. Stack the bar on top, set the alignment to top, and it sticks where you want it. If the first row gets covered, adding some padding to the top of the list seems like it would do. The bar is a custom view, so you assume the rules for system bars don't apply."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の上に何かを載せるいちばんなじみのある方法は、ZStackかoverlayだ。バーを上に重ねて配置をtopにすれば、狙った場所に収まる。1行目が隠れるなら、リストの上側に適当にパディングを足せばよさそうだ。バーはカスタムビューなので、システムバーのルールとは関係ないと思い込む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "往界面上叠东西最熟悉的方法是 ZStack 或 overlay。把栏叠在上面，只要对齐设成 top 就贴在想要的位置。第一行被遮住的话，在列表上方适当加点内边距就行。栏是自定义视图，似乎与系统栏的规则无关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往介面上疊東西最熟悉的方法是 ZStack 或 overlay。把列疊在上面，只要對齊設成 top 就貼在想要的位置。第一行被遮住的話，在列表上方適當加點內邊距就行。列是自定義檢視，似乎與系統列的規則無關。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самый привычный способ положить что-то поверх экрана - ZStack или overlay. Наложите панель сверху, задайте выравнивание по верху, и она приклеится куда нужно. Если закрыта первая строка, кажется, что хватит добавить отступ сверху списка. Панель - пользовательский вид, поэтому вы полагаете, что правила для системных панелей на неё не распространяются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma más familiar de poner algo sobre la pantalla es un ZStack o un overlay. Apila la barra encima, fija la alineación arriba y se pega donde quieres. Si la primera fila queda tapada, añadir algo de relleno arriba de la lista parece que bastará. La barra es una vista personalizada, así que supones que las reglas de las barras del sistema no se aplican."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vertrauteste Weg, etwas über den Bildschirm zu legen, ist eine ZStack oder ein Overlay. Stapele die Leiste obenauf, setze die Ausrichtung auf oben, und sie klebt, wo du sie willst. Wird die erste Zeile verdeckt, scheint etwas Padding oben an der Liste zu genügen. Die Leiste ist eine eigene Ansicht, also nimmst du an, dass die Regeln für Systemleisten nicht gelten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La façon la plus familière de poser quelque chose sur l'écran est une ZStack ou un overlay. Empilez la barre dessus, réglez l'alignement sur le haut, et elle colle où vous voulez. Si la première ligne est recouverte, ajouter un peu de padding en haut de la liste semble suffire. La barre est une vue personnalisée, donc vous supposez que les règles des barres système ne s'appliquent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modo più familiare di mettere qualcosa sopra la schermata è uno ZStack o un overlay. Impila la barra sopra, imposta l'allineamento in alto e resta dove vuoi. Se la prima riga viene coperta, aggiungere un po' di padding in cima all'elenco sembra bastare. La barra è una vista personalizzata, quindi presumi che le regole delle barre di sistema non si applichino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jeito mais familiar de pôr algo sobre a tela é um ZStack ou um overlay. Empilhe a barra por cima, defina o alinhamento no topo e ela fica onde você quer. Se a primeira linha fica coberta, acrescentar um padding no topo da lista parece resolver. A barra é uma view personalizada, então você presume que as regras das barras do sistema não se aplicam."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิธีที่คุ้นเคยที่สุดในการวางบางอย่างบนหน้าจอคือ ZStack หรือ overlay ซ้อนแถบด้านบน ตั้ง alignment เป็น top แล้วมันติดตามที่ต้องการ ถ้าแถวแรกถูกบัง การเพิ่ม padding ด้านบนรายการดูเหมือนจะพอ แถบเป็น view ที่กำหนดเอง คุณจึงสมมติว่ากฎของแถบระบบไม่ใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách quen thuộc nhất để đặt thứ gì lên trên màn hình là ZStack hoặc overlay. Chồng thanh lên trên, đặt căn lề là trên, và nó dính đúng chỗ bạn muốn. Nếu dòng đầu bị che, thêm chút padding trên cùng danh sách có vẻ là đủ. Thanh là view tùy chỉnh, nên bạn cho rằng quy tắc của thanh hệ thống không áp dụng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejznámější způsob, jak dát něco nad obrazovku, je ZStack nebo overlay. Naskládejte panel navrch, nastavte zarovnání nahoru a drží, kde ho chcete. Pokud se první řádek zakryje, přidání paddingu nahoře seznamu se zdá stačit. Panel je vlastní view, takže předpokládáte, že pravidla pro systémové panely neplatí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den mest velkendte måde at lægge noget oven på skærmen på er en ZStack eller en overlay. Stabl bjælken ovenpå, sæt justeringen til top, og den sidder fast, hvor du vil have den. Hvis den første række bliver dækket, ser det ud til, at lidt padding øverst på listen ville klare det. Bjælken er en brugerdefineret visning, så du antager, at reglerne for systembjælker ikke gælder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο πιο οικείος τρόπος να βάλεις κάτι πάνω από την οθόνη είναι ένα ZStack ή ένα overlay. Στοίβαξε τη γραμμή από πάνω, όρισε τη στοίχιση σε top, και κολλά όπου θέλεις. Αν καλυφθεί η πρώτη γραμμή, το να προσθέσεις λίγο padding στην κορυφή της λίστας φαίνεται ότι αρκεί. Η γραμμή είναι προσαρμοσμένη προβολή, οπότε υποθέτεις ότι οι κανόνες των γραμμών συστήματος δεν ισχύουν."
          }
        }
      }
    },
    "화면 위에 무언가를 올릴 때 묻는다. \"밑에 있는 콘텐츠가 이게 있다는 걸 아는가?\" 모른다면 쌓은 게 아니라 가린 것이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you put something on top of the screen, ask: \"Does the content underneath know this is here?\" If it doesn't, you haven't stacked it, you've covered it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you put something on top of the screen, ask: \"Does the content underneath know this is here?\" If it doesn't, you haven't stacked it, you've covered it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の上に何かを載せるときに問う。「下にあるコンテンツは、これがあることを知っているか」知らないなら、それは重ねたのではなく隠したのだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "往界面上叠东西时先问：“下面的内容知道这个东西存在吗？”不知道的话，那不是叠上去了，而是遮住了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往介面上疊東西時先問：「下面的內容知道這個東西存在嗎？」不知道的話，那不是疊上去了，而是遮住了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кладя что-то поверх экрана, спросите: «Знает ли содержимое под этим, что оно здесь?» Если нет, вы не наложили, а закрыли."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando pongas algo sobre la pantalla, pregunta: «¿Sabe el contenido de debajo que esto está aquí?» Si no lo sabe, no lo has apilado, lo has tapado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage, wenn du etwas über den Bildschirm legst: „Weiß der Inhalt darunter, dass das hier ist?“ Wenn nicht, hast du es nicht gestapelt, sondern abgedeckt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous posez quelque chose sur l'écran, demandez : « Le contenu dessous sait-il que c'est là ? » Sinon, vous ne l'avez pas empilé, vous l'avez recouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando metti qualcosa sopra la schermata, chiediti: «Il contenuto sotto sa che questa cosa è qui?» Se non lo sa, non l'hai sovrapposta, l'hai coperto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você põe algo sobre a tela, pergunte: «O conteúdo por baixo sabe que isto está aqui?» Se não sabe, você não empilhou, você cobriu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อวางบางอย่างบนหน้าจอ ให้ถาม: \"เนื้อหาข้างใต้รู้ไหมว่ามีสิ่งนี้อยู่\" ถ้าไม่รู้ คุณไม่ได้ซ้อน คุณบัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn đặt thứ gì lên trên màn hình, hãy hỏi: \"Nội dung bên dưới có biết thứ này ở đó không?\" Nếu không, bạn chưa xếp chồng nó, bạn đã che nó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když něco dáváte nad obrazovku, zeptejte se: „Ví obsah pod tím, že to tam je?“ Pokud ne, nenaskládali jste to, zakryli jste to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du lægger noget oven på skærmen, så spørg: »Ved indholdet under det, at det er der?« Hvis ikke, har du ikke stablet det, du har dækket."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν βάζεις κάτι πάνω από την οθόνη, ρώτα: «Ξέρει το περιεχόμενο από κάτω ότι αυτό είναι εδώ;» Αν δεν ξέρει, δεν το στοίβαξες, το κάλυψες."
          }
        }
      }
    },
    "화면 위에 올리는 가장 간단한 방법이라 먼저 손이 간다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the simplest way to put something on top of the screen, so it's what you reach for first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the simplest way to put something on top of the screen, so it's what you reach for first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の上に載せるいちばん簡単な方法なので、まず手が伸びる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是往界面上叠东西最简单的方法，所以先伸手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是往介面上疊東西最簡單的方法，所以先伸手。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это простейший способ положить что-то поверх экрана, поэтому вы берётесь за него первым."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la forma más simple de poner algo sobre la pantalla, así que es lo primero que se te ocurre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist der einfachste Weg, etwas über den Bildschirm zu legen, also greifst du zuerst danach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la façon la plus simple de poser quelque chose sur l'écran, donc c'est ce vers quoi vous allez d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il modo più semplice di mettere qualcosa sopra la schermata, quindi è quello a cui ricorri per primo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o jeito mais simples de pôr algo sobre a tela, então é a que você usa primeiro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นวิธีง่ายที่สุดในการวางบางอย่างบนหน้าจอ จึงเป็นสิ่งที่คุณคว้าก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là cách đơn giản nhất để đặt thứ gì lên trên màn hình, nên bạn với tay lấy nó trước."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to nejjednodušší způsob, jak něco dát nad obrazovku, takže po tom sáhnete první."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er den enkleste måde at lægge noget oven på skærmen på, så det er det, du griber efter først."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι ο πιο απλός τρόπος να βάλεις κάτι πάνω από την οθόνη, γι' αυτό είναι αυτό που χρησιμοποιείς πρώτο."
          }
        }
      }
    },
    "화면 위의 요소는 **각자 다른 일을 한다**고 읽힌다. 같은 아이콘이 두 자리에 있으면 사용자는 같은 기능이 두 번 있다고 생각하기보다 비슷한 기능이 두 개 있다고 생각한다. 친절하려고 둔 두 번째 버튼이 오히려 판단을 하나 늘린다.\n\n그리고 둘 중 하나는 늘 기여하지 않으면서 자리를 차지한다. 그 자리는 원래 다른 일을 말할 수 있었던 자리다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elements on screen are read as **each doing something different**. When the same icon appears in two places, users are more likely to assume there are two similar features than one feature shown twice. The second button, added to be helpful, actually adds one more decision.\n\nAnd one of the two always takes up space without contributing. That space could have said something else."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Elements on screen are read as **each doing something different**. When the same icon appears in two places, users are more likely to assume there are two similar features than one feature shown twice. The second button, added to be helpful, actually adds one more decision.\n\nAnd one of the two always takes up space without contributing. That space could have said something else."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上の要素は、**それぞれ別の仕事をする**と読まれる。同じアイコンが2か所にあると、ユーザーは同じ機能が2回あると考えるより、似た機能が2つあると考える。親切のつもりで置いた2つ目のボタンが、かえって判断をひとつ増やす。\n\nそして2つのうち片方は、常に貢献しないまま場所を占めている。その場所は本来、別のことを語れたはずの場所だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面上的元素会被读成**各做各的事**。同一个图标出现在两个位置，用户不会想成同一个功能有两处，而是想成有两个相似的功能。为了体贴而放的第二个按钮，反而多了一次判断。\n\n而且两者之一始终没有贡献，却占着位置。那个位置原本可以用来说别的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面上的元素會被讀成**各做各的事**。同一個圖示出現在兩個位置，使用者不會想成同一個功能有兩處，而是想成有兩個相似的功能。為了體貼而放的第二個按鈕，反而多了一次判斷。\n\n而且兩者之一始終沒有貢獻，卻佔著位置。那個位置原本可以用來說別的事。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы на экране читаются как **делающие каждый своё**. Когда один и тот же значок встречается в двух местах, пользователи скорее решат, что функций две похожих, чем что одна функция показана дважды. Вторая кнопка, добавленная ради удобства, на деле добавляет ещё одно решение.\n\nИ одна из двух всегда занимает место, ничего не давая. Это место могло бы сказать что-то другое."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de la pantalla se leen como **cada uno haciendo algo distinto**. Cuando el mismo icono aparece en dos sitios, es más probable que los usuarios supongan que hay dos funciones parecidas que una sola función mostrada dos veces. El segundo botón, añadido por ayudar, en realidad añade una decisión más.\n\nY uno de los dos siempre ocupa espacio sin aportar. Ese espacio podría haber dicho otra cosa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemente auf dem Bildschirm werden gelesen, als **täte jedes etwas anderes**. Erscheint dasselbe Symbol an zwei Stellen, nehmen Nutzer eher an, es gebe zwei ähnliche Funktionen als eine zweimal gezeigte. Der zweite Button, der hilfreich sein sollte, fügt tatsächlich eine weitere Entscheidung hinzu.\n\nUnd eines der beiden belegt immer Platz, ohne beizutragen. Dieser Platz hätte etwas anderes sagen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments à l'écran sont lus comme **faisant chacun quelque chose de différent**. Quand la même icône apparaît à deux endroits, les utilisateurs supposent plus volontiers deux fonctions semblables qu'une seule fonction montrée deux fois. Le deuxième bouton, ajouté pour aider, ajoute en réalité une décision de plus.\n\nEt l'un des deux occupe toujours de l'espace sans contribuer. Cet espace aurait pu dire autre chose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi sullo schermo vengono letti come **ciascuno con un compito diverso**. Quando la stessa icona compare in due posti, gli utenti sono più portati a pensare a due funzioni simili che a una funzione mostrata due volte. Il secondo pulsante, aggiunto per essere utile, aggiunge in realtà una decisione in più.\n\nE uno dei due occupa sempre spazio senza contribuire. Quello spazio avrebbe potuto dire altro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os elementos na tela são lidos como **cada um fazendo uma coisa diferente**. Quando o mesmo ícone aparece em dois lugares, os usuários tendem mais a supor duas funcionalidades parecidas do que uma funcionalidade mostrada duas vezes. O segundo botão, acrescentado para ajudar, na verdade soma mais uma decisão.\n\nE um dos dois sempre ocupa espaço sem contribuir. Esse espaço poderia ter dito outra coisa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "องค์ประกอบบนหน้าจอถูกอ่านว่า**แต่ละอย่างทำสิ่งต่างกัน** เมื่อไอคอนเดียวกันปรากฏสองที่ ผู้ใช้มีแนวโน้มสมมติว่ามีสองฟีเจอร์ที่คล้ายกันมากกว่าฟีเจอร์เดียวที่แสดงสองครั้ง ปุ่มที่สองที่เพิ่มเพื่อช่วยจริง ๆ เพิ่มอีกหนึ่งการตัดสินใจ\n\nและหนึ่งในสองกินพื้นที่โดยไม่ช่วยอะไรเสมอ พื้นที่นั้นพูดสิ่งอื่นได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phần tử trên màn hình được đọc là **mỗi cái làm một việc khác nhau**. Khi cùng một biểu tượng xuất hiện ở hai nơi, người dùng dễ cho rằng có hai tính năng tương tự hơn là một tính năng hiện hai lần. Nút thứ hai, thêm vào với ý tốt, thực ra thêm một quyết định nữa.\n\nVà một trong hai luôn chiếm chỗ mà không đóng góp. Chỗ đó lẽ ra nói được điều khác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvky na obrazovce se čtou jako **každý dělá něco jiného**. Když se stejná ikona objeví na dvou místech, uživatelé spíš předpokládají dvě podobné funkce než jednu funkci zobrazenou dvakrát. Druhé tlačítko, přidané s dobrým úmyslem, ve skutečnosti přidá další rozhodnutí.\n\nA jedno ze dvou vždy zabírá místo, aniž by přispívalo. To místo mohlo říkat něco jiného."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementer på skærmen læses som **hver især at gøre noget forskelligt**. Når det samme ikon optræder to steder, er det mere sandsynligt, at brugerne antager, at der er to lignende funktioner, end at der er én funktion vist to gange. Den anden knap, tilføjet for at hjælpe, tilføjer faktisk endnu en beslutning.\n\nOg en af de to optager altid plads uden at bidrage. Den plads kunne have sagt noget andet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία στην οθόνη διαβάζονται ως **το καθένα κάνει κάτι διαφορετικό**. Όταν το ίδιο εικονίδιο εμφανίζεται σε δύο σημεία, οι χρήστες είναι πιο πιθανό να υποθέσουν ότι υπάρχουν δύο παρόμοιες λειτουργίες παρά μία που φαίνεται δύο φορές. Το δεύτερο κουμπί, που προστέθηκε για να βοηθήσει, προσθέτει στην πραγματικότητα μία ακόμα απόφαση.\n\nΚαι ένα από τα δύο πιάνει πάντα χώρο χωρίς να συμβάλλει. Αυτός ο χώρος θα μπορούσε να έλεγε κάτι άλλο."
          }
        }
      }
    },
    "화면 전부가 콘텐츠": {
      "extractionState": "manual",
