          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekmece araması ve alt arama aynı anda sunuluyor (çift yuva)"
          }
        }
      }
    },
    "서랍 검색바를 **스크롤해도 고정** (.always)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawer search bar **pinned even while scrolling** (.always)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawer search bar **pinned even while scrolling** (.always)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き出しの検索バーを**スクロールしても固定**（.always）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让抽屉搜索栏**滚动时也固定**（.always）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
