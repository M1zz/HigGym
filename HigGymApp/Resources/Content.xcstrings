            "value": "Um grupo de ferramentas à **esquerda** + uma única ação decisiva à **direita**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลุ่มเครื่องมือทางด้าน**ซ้าย** + การกระทำเพื่อตัดสินใจหนึ่งอย่างทางด้าน**ขวา**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cụm công cụ ở **bên trái** + một hành động quyết định duy nhất ở **bên phải**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupina nástrojů **vlevo** + jedna rozhodující akce **vpravo**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En værktøjsklynge til **venstre** + en enkelt afgørende handling til **højre**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ομάδα εργαλείων στα **αριστερά** + μία μοναδική αποφασιστική ενέργεια στα **δεξιά**"
          }
        }
      }
    },
    "**위 · 중앙 · 아래** 전 위치 조합, 자리마다 다른 문법": {
      "extractionState": "manual",
      "localizations": {
