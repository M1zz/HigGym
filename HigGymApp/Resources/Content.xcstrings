    "공간은 계약, 텍스트는 가변": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space is a contract, text is variable"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Space is a contract, text is variable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースは契約、テキストは可変"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间是约定，文字是可变的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空間是約定，文字是可變的"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пространство - договорённость, текст - переменная"
