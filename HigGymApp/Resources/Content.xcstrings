        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È l'azione di conferma più importante, quindi le dai il posto migliore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É a ação de confirmação mais importante, então você lhe dá o melhor lugar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นการกระทำเพื่อยืนยันที่สำคัญที่สุด คุณจึงให้ตำแหน่งที่ดีที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là hành động xác nhận quan trọng nhất, nên bạn cho nó vị trí tốt nhất."
