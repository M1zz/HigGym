        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **title** inside the top bar, a custom header without the system navigation bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部のバーの中に**タイトル**。システムのナビゲーションバーを使わないカスタムヘッダー"
