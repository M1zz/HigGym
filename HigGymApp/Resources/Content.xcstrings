        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθέτηση της αναζήτησης σε συρτάρι που εξαφανίζεται στην κύλιση, σε εφαρμογή χτισμένη γύρω από την αναζήτηση"
          }
        }
      }
    },
    "검색이 핵심인 앱인데 스크롤하면 사라지는 서랍에 배치": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search is the core of the app, yet it sits in a drawer that disappears on scroll"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Search is the core of the app, yet it sits in a drawer that disappears on scroll"
          }
        },
        "ja": {
