            "state": "translated",
            "value": "Bản xem trước đánh giá đặt phạm vi 2...4 dòng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukázky recenzí nastavené na rozsah 2...4 řádků"
          }
        },
        "da": {
          "stringUnit": {
