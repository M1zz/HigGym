          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".safeAreaBar(edge: .top): размещает пользовательское представление в **верхней safe area**. Прокручиваемый контент автоматически начинается под ним."
          }
        },
        "es": {
