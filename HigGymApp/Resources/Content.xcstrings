    },
    "화면 정체성과 무관한 **공유** 버튼을 정중앙에": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **Share** button, unrelated to the screen's identity, placed dead center"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **Share** button, unrelated to the screen's identity, placed dead centre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のアイデンティティと無関係な**共有**ボタンを真ん中に"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把与界面身份无关的**分享**按钮放在正中间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把與介面身份無關的**分享**按鈕放在正中間"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка **«Поделиться»**, не связанная с идентичностью экрана, поставлена строго по центру"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón **Compartir**, sin relación con la identidad de la pantalla, colocado en el centro exacto"
          }
        }
      }
    },
    "화면 정체성과 무관한 버튼을 정중앙(principal)에 둔다": {
      "extractionState": "manual",
      "localizations": {
