          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconderla e poi ricostruire in basso una barra delle schede simile (un'implementazione duplicata)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
