          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια οθόνη όπου ο τίτλος και τα κουμπιά σε γραμμή εργαλείων γυαλιού πρέπει να διατηρούν τις σχετικές θέσεις τους"
          }
        }
      }
    },
    "유일한 액션을 시스템 자리 대신 커스텀 플로팅 버튼으로 화면 위에 띄움": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only action floats over the screen as a custom floating button instead of using the system slot"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The only action floats over the screen as a custom floating button instead of using the system slot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "唯一のアクションを、システムの位置ではなくカスタムのフローティングボタンとして画面上に浮かべている"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把唯一的操作不放在系统位置，而是做成悬浮在界面上的自定义悬浮按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把唯一的操作不放在系統位置，而是做成懸浮在介面上的自定義懸浮按鈕"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единственное действие парит над экраном как пользовательская плавающая кнопка вместо системного слота"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La única acción flota sobre la pantalla como un botón flotante personalizado en lugar de usar el sitio del sistema"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die einzige Aktion schwebt als eigener schwebender Button über dem Bildschirm statt im Systemplatz"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seule action flotte au-dessus de l'écran comme un bouton flottant personnalisé au lieu d'utiliser l'emplacement système"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'unica azione fluttua sulla schermata come pulsante fluttuante personalizzato invece di usare lo slot di sistema"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A única ação flutua sobre a tela como um botão flutuante personalizado em vez de usar o lugar do sistema"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำเดียวลอยเหนือหน้าจอเป็นปุ่มลอยที่กำหนดเองแทนการใช้ช่องของระบบ"
          }
        },
        "vi": {
