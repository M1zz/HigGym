    },
    "어디서든 닿게 해주는 게 친절이라고 생각한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You think making it reachable from anywhere is the considerate thing to do."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You think making it reachable from anywhere is the considerate thing to do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこからでも届くようにするのが親切だと考える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "觉得让用户在哪里都能够到才是体贴。"
