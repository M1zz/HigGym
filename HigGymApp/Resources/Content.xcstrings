          }
        }
      }
    },
    "상단 바가 과하게 높아 콘텐츠 영역 잠식": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A top bar so tall it eats into the content area"
