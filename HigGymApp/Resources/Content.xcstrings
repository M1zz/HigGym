            "state": "translated",
            "value": "Mantener permanentemente visible una búsqueda poco usada"
          }
        }
      }
    },
    "검색": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        },
        "en-GB": {
