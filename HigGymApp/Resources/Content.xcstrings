        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen where the title and buttons on a glass toolbar must keep their relative positions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガラスのツールバーでタイトルとボタンの相対的な位置を固定すべき画面"
