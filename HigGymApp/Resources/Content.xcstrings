            "state": "translated",
            "value": "Bricht bei großen Textgrößen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela casse aux grandes tailles de texte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rompe alle grandi dimensioni di testo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quebra em tamanhos grandes de texto"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พังที่ขนาดตัวอักษรใหญ่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vỡ ở cỡ chữ lớn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozbije se při velkých velikostech textu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den går i stykker ved store tekststørrelser"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σπάει σε μεγάλα μεγέθη κειμένου"
          }
        }
      }
    },
    "큰 제목이 **내비바 안에 고정**, 스크롤에도 위치 유지": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A large title **pinned inside the navigation bar**, holding its position as you scroll"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A large title **pinned inside the navigation bar**, holding its position as you scroll"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きいタイトルが**ナビゲーションバーの中に固定**され、スクロールしても位置を保つ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大标题**固定在导航栏内**，滚动时位置也保持"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大標題**固定在導覽列內**，滾動時位置也保持"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупный заголовок, **закреплённый внутри панели навигации**, сохраняющий положение при прокрутке"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un título grande **fijado dentro de la barra de navegación**, que conserva su posición al desplazar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Large-Titel, **in der Navigationsleiste fixiert**, der beim Scrollen seine Position hält"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grand titre **épinglé dans la barre de navigation**, gardant sa position au défilement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un titolo grande **fissato dentro la barra di navigazione**, che mantiene la posizione mentre scorri"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um título grande **fixado dentro da barra de navegação**, mantendo a posição enquanto você rola"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องขนาดใหญ่ที่**ตรึงไว้ในแถบนำทาง** คงตำแหน่งขณะเลื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tiêu đề lớn **ghim trong thanh điều hướng**, giữ vị trí khi bạn cuộn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velký nadpis **připnutý uvnitř navigačního panelu**, držící pozici při posouvání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En stor titel **fastgjort inde i navigationsbjælken**, der holder sin position, mens du scroller"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας μεγάλος τίτλος **καρφωμένος μέσα στη γραμμή πλοήγησης**, που κρατά τη θέση του καθώς κυλάς"
          }
        }
      }
    },
    "큰 화면에서 상단은 한 손으로 닿기 어려움. **사용 빈도가 배치 높이를 결정**한다는 원칙.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a large screen, the top is hard to reach with one hand. The principle that **frequency of use determines vertical placement**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On a large screen, the top is hard to reach with one hand. The principle that **frequency of use determines vertical placement**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな画面では、上部は片手で届きにくい。**使う頻度が配置の高さを決める**という原則。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在大屏幕上，顶部单手难以够到。**使用频率决定布局高度**的原则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在大螢幕上，頂部單手難以夠到。**使用頻率決定佈局高度**的原則。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На большом экране до верха трудно дотянуться одной рукой. Принцип: **частота использования определяет вертикальное положение**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una pantalla grande, la parte superior es difícil de alcanzar con una mano. El principio de que **la frecuencia de uso determina la colocación vertical**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem großen Bildschirm ist die Oberseite einhändig schwer zu erreichen. Das Prinzip, dass **die Nutzungshäufigkeit die vertikale Platzierung bestimmt**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un grand écran, le haut est difficile à atteindre d'une main. Le principe selon lequel **la fréquence d'usage détermine le placement vertical**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su uno schermo grande, l'alto è difficile da raggiungere con una mano. Il principio per cui **la frequenza d'uso determina la collocazione verticale**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa tela grande, o topo é difícil de alcançar com uma mão. O princípio de que **a frequência de uso determina a colocação vertical**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้าจอใหญ่ ด้านบนเอื้อมยากด้วยมือเดียว หลักการที่ว่า **ความถี่ในการใช้กำหนดตำแหน่งแนวตั้ง**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình lớn, phần trên khó với tới bằng một tay. Nguyên tắc rằng **tần suất dùng quyết định vị trí dọc**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na velké obrazovce je horní část těžko dosažitelná jednou rukou. Zásada, že **frekvence používání určuje svislé umístění**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På en stor skærm er toppen svær at nå med én hånd. Princippet om, at **brugshyppighed afgør lodret placering**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε μεγάλη οθόνη, η κορυφή είναι δύσκολο να προσεγγιστεί με το ένα χέρι. Η αρχή ότι **η συχνότητα χρήσης καθορίζει την κάθετη τοποθέτηση**."
          }
        }
      }
    },
    "큰 화면에서 좋았던 배치를 옮길 때 묻는다. **\"이 바가 가져가는 자원이 이 기기에서도 넉넉한가?\"**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you carry over a layout that worked well on a large screen, ask: **\"Is the resource this bar takes still plentiful on this device?\"**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you carry over a layout that worked well on a large screen, ask: **\"Is the resource this bar takes still plentiful on this device?\"**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな画面でうまくいった配置を移すときに問う。**「このバーが持っていく資源は、このデバイスでも十分にあるか」**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搬运在大屏幕上好用的布局时先问：**“这个栏拿走的资源，在这台设备上也宽裕吗？”**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搬運在大螢幕上好用的佈局時先問：**「這個列拿走的資源，在這臺裝置上也寬裕嗎？」**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенося макет, хорошо работавший на большом экране, спросите: **«Остался ли на этом устройстве в достатке ресурс, который занимает эта панель?»**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando traslades un diseño que funcionaba bien en una pantalla grande, pregunta: **«¿Sigue habiendo en abundancia en este dispositivo el recurso que ocupa esta barra?»**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überträgst du ein Layout, das auf einem großen Bildschirm gut funktionierte, frage: **„Ist die Ressource, die diese Leiste braucht, auf diesem Gerät noch reichlich vorhanden?“**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous reprenez une disposition qui fonctionnait bien sur un grand écran, demandez : **« La ressource que prend cette barre est-elle encore abondante sur cet appareil ? »**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando porti un layout che funzionava bene su uno schermo grande, chiediti: **«La risorsa che questa barra occupa è ancora abbondante su questo dispositivo?»**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você leva um layout que funcionava bem numa tela grande, pergunte: **«O recurso que esta barra ocupa ainda é abundante neste dispositivo?»**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อนำเลย์เอาต์ที่ใช้ได้ดีบนหน้าจอใหญ่ไปใช้ ให้ถาม: **\"ทรัพยากรที่แถบนี้กินยังเหลือเฟือบนอุปกรณ์นี้ไหม\"**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi mang sang một bố cục chạy tốt trên màn hình lớn, hãy hỏi: **\"Tài nguyên mà thanh này chiếm có còn dồi dào trên thiết bị này không?\"**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přenášíte rozvržení, které dobře fungovalo na velké obrazovce, zeptejte se: **„Je zdroj, který tento panel zabírá, na tomto zařízení stále hojný?“**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du tager et layout, der fungerede godt på en stor skærm, med over, så spørg: **»Er den ressource, denne bjælke tager, stadig rigelig på denne enhed?«**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν μεταφέρεις μια διάταξη που δούλευε καλά σε μεγάλη οθόνη, ρώτα: **«Είναι ο πόρος που παίρνει αυτή η γραμμή ακόμα άφθονος σε αυτή τη συσκευή;»**"
          }
        }
      }
    },
