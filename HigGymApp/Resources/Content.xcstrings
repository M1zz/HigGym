            "value": "การกระทำห่างจากเป้าหมาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động xa đối tượng của nó"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akce daleko od svého cíle"
          }
        },
        "da": {
          "stringUnit": {
