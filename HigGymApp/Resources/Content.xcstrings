        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to výchozí a myslíte si, že přechody jsou věcí vkusu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er standarden, og du tror, at overgange er en smagssag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι η προεπιλογή, και νομίζεις ότι οι μεταβάσεις είναι θέμα γούστου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on oletus, ja luulet siirtymien olevan makuasia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu bawaan, dan kamu mengira transisi hanyalah soal selera."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er standarden, og du tror overganger er en smaksak."
