    "회사 조직도(부서별 탭)를 그대로 탭 구조로 이식": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transplanting the company org chart (a tab per department) straight into the tab structure"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Transplanting the company org chart (a tab per department) straight into the tab structure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会社の組織図（部署ごとのタブ）をそのままタブ構造に移植する"
