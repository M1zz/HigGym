    "레이아웃은 **가장 나쁜 조건**에서 끝난다. 작은 화면 한 번, 큰 글씨 한 번이 가장 싼 검증이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A layout is finished under **the worst conditions**. One pass on a small screen and one with large text are the cheapest tests you can run."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A layout is finished under **the worst conditions**. One pass on a small screen and one with large text are the cheapest tests you can run."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトは**最も悪い条件**で完成する。小さい画面で一回、大きい文字で一回が、最も安上がりな検証だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局要在**最糟糕的条件**下才算完。小屏幕看一次、大字号看一次，是最便宜的验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佈局要在**最糟糕的條件**下才算完。小螢幕看一次、大字號看一次，是最便宜的驗證。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Макет заканчивается в **худших условиях**. Один прогон на маленьком экране и один с крупным текстом - самые дешёвые тесты."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un diseño se termina en **las peores condiciones**. Una pasada en una pantalla pequeña y otra con texto grande son las pruebas más baratas que puedes hacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Layout wird unter **den schlechtesten Bedingungen** fertiggestellt. Ein Durchgang auf einem kleinen Bildschirm und einer mit großem Text sind die günstigsten Tests, die du fahren kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise en page se termine dans **les pires conditions**. Un passage sur un petit écran et un avec un grand texte sont les tests les moins chers que vous puissiez faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un layout è finito solo **nelle condizioni peggiori**. Un passaggio su uno schermo piccolo e uno con testo grande sono i test più economici che puoi fare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um layout só está pronto **nas piores condições**. Uma passada numa tela pequena e outra com texto grande são os testes mais baratos que você pode fazer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลย์เอาต์เสร็จภายใต้**สภาวะที่แย่ที่สุด** การตรวจหนึ่งรอบบนหน้าจอเล็กและหนึ่งรอบกับตัวอักษรใหญ่คือการทดสอบที่ถูกที่สุดที่ทำได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một bố cục chỉ hoàn thiện dưới **điều kiện tệ nhất**. Một lượt trên màn hình nhỏ và một lượt với chữ lớn là các bài kiểm tra rẻ nhất bạn có thể chạy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozvržení je hotové **za nejhorších podmínek**. Jeden průchod na malé obrazovce a jeden s velkým textem jsou nejlevnější testy, které můžete provést."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et layout er færdigt under **de værste forhold**. Ét gennemløb på en lille skærm og ét med stor tekst er de billigste tests, du kan køre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια διάταξη τελειώνει υπό **τις χειρότερες συνθήκες**. Ένας έλεγχος σε μικρή οθόνη και ένας με μεγάλο κείμενο είναι οι φθηνότεροι έλεγχοι που μπορείς να τρέξεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettelu on valmis **pahimmissa olosuhteissa**. Yksi läpikäynti pienellä näytöllä ja yksi suurella tekstillä ovat halvimmat testit, joita voit ajaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letak diselesaikan di bawah **kondisi terburuk**. Satu putaran di layar kecil dan satu dengan teks besar adalah pengujian termurah yang bisa kamu lakukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En layout er ferdig under **de verste forholdene**. Én runde på en liten skjerm og én med stor tekst er de billigste testene du kan kjøre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een layout is af onder **de slechtste omstandigheden**. Eén ronde op een klein scherm en één met grote tekst zijn de goedkoopste tests die je kunt doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Układ jest gotowy w **najgorszych warunkach**. Jedno przejście na małym ekranie i jedno z dużym tekstem to najtańsze testy, jakie możesz zrobić."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En layout är färdig under **de sämsta förhållandena**. En omgång på en liten skärm och en med stor text är de billigaste testerna du kan köra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir düzen **en kötü koşullar altında** biter. Küçük bir ekranda bir geçiş ve büyük metinle bir geçiş yapabileceğin en ucuz testlerdir."
          }
        }
      }
    },
    "레이아웃이 텍스트가 변한다는 사실을 계산에 넣지 않았다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layout didn't account for the fact that text changes"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The layout didn't account for the fact that text changes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストが変わるという事実を、レイアウトが計算に入れていない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局没有把文字会变化这一点算进去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佈局沒有把文字會變化這一點算進去"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Макет не учёл, что текст меняется"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diseño no tuvo en cuenta que el texto cambia"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Layout berücksichtigte nicht, dass sich Text ändert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise en page n'a pas tenu compte du fait que le texte change"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il layout non ha tenuto conto del fatto che il testo cambia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O layout não considerou o fato de que o texto muda"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลย์เอาต์ไม่ได้คำนึงถึงข้อเท็จจริงที่ว่าข้อความเปลี่ยนแปลง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bố cục đã không tính đến việc văn bản thay đổi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozvržení nepočítalo s tím, že se text mění"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Layoutet tog ikke højde for, at tekst ændrer sig"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διάταξη δεν έλαβε υπόψη ότι το κείμενο αλλάζει"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettelu ei ottanut huomioon sitä, että teksti muuttuu"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tata letak tidak memperhitungkan bahwa teks berubah"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Layouten tok ikke hensyn til at teksten endres"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De layout hield er geen rekening mee dat tekst verandert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Układ nie uwzględniał faktu, że tekst się zmienia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Layouten räknade inte med att text ändras"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzen, metnin değişebileceğini hesaba katmadı"
          }
        }
      }
    },
    "레이아웃이 흔들리는 게 싫다. 넉넉하게 잡아 두면 어떤 텍스트가 와도 높이가 같다. 안전 여유처럼 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hate the layout jumping around. Reserve generous room and the height stays the same no matter what text comes in. It looks like a safety margin."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You hate the layout jumping around. Reserve generous room and the height stays the same no matter what text comes in. It looks like a safety margin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトが揺れるのは嫌だ。余裕を持って確保しておけば、どんなテキストが来ても高さが同じになる。安全マージンのように見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "讨厌布局晃动。留得宽裕一点，来什么文字高度都一样。看起来像安全余量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "討厭佈局晃動。留得寬裕一點，來什麼文字高度都一樣。看起來像安全餘量。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы ненавидите прыгающий макет. Зарезервируйте с запасом, и высота будет одинаковой, какой бы текст ни пришёл. Выглядит как запас прочности."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Odias que el diseño salte. Reserva espacio de sobra y la altura se mantiene igual entre cualquier texto que entre. Parece un margen de seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hasst es, wenn das Layout herumspringt. Reserviere großzügig Platz, und die Höhe bleibt gleich, egal welcher Text hereinkommt. Es sieht wie ein Sicherheitspuffer aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous détestez que la mise en page saute. Réservez largement de la place et la hauteur reste la même quel que soit le texte qui arrive. Cela ressemble à une marge de sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Odi che il layout salti. Riserva molto spazio e l'altezza resta la stessa qualunque testo arrivi. Sembra un margine di sicurezza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você odeia o layout saltando. Reserve bastante espaço e a altura continua a mesma qualquer que seja o texto que chegue. Parece uma margem de segurança."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเกลียดเลย์เอาต์ที่กระโดด สำรองที่ให้มากไว้ แล้วความสูงคงที่ไม่ว่าข้อความอะไรเข้ามา ดูเหมือนส่วนเผื่อความปลอดภัย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn ghét bố cục nhảy lung tung. Giữ chỗ rộng rãi thì chiều cao không đổi dù văn bản nào đến. Trông như một biên an toàn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesnášíte, když rozvržení poskakuje. Rezervujte štědře místa a výška zůstane stejná, ať přijde jakýkoli text. Vypadá to jako bezpečnostní rezerva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hader, at layoutet hopper rundt. Reserver rigelig plads, og højden forbliver den samme, uanset hvilken tekst der kommer ind. Det ligner en sikkerhedsmargen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μισείς το πήδημα της διάταξης. Δέσμευσε γενναιόδωρο χώρο και το ύψος μένει ίδιο ανεξαρτήτως ποιο κείμενο μπαίνει. Φαίνεται σαν περιθώριο ασφαλείας."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhoat sitä, että asettelu hyppii. Varaa reilusti tilaa, ja korkeus pysyy samana riippumatta siitä, mikä teksti tulee sisään. Se näyttää turvamarginaalilta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu benci tata letak yang melompat-lompat. Sisihkan ruang yang lega dan tinggi tetap sama apa pun teks yang masuk. Tampak seperti margin pengaman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hater at layouten hopper rundt. Reserver romslig plass, så forblir høyden den samme uansett hvilken tekst som kommer inn. Det ser ut som en sikkerhetsmargin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je haat het als de layout rondspringt. Reserveer ruim en de hoogte blijft hetzelfde, welke tekst er ook binnenkomt. Het lijkt een veiligheidsmarge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nienawidzisz, gdy układ skacze. Zarezerwuj obficie miejsca, a wysokość pozostanie taka sama, jaki tekst by nie wszedł. Wygląda to jak margines bezpieczeństwa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hatar att layouten hoppar runt. Reservera gott om utrymme så förblir höjden densamma oavsett vilken text som kommer in. Det ser ut som en säkerhetsmarginal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenin zıplamasından nefret edersin. Bol yer ayır, hangi metin gelirse gelsin yükseklik aynı kalır. Bir güvenlik payı gibi görünür."
          }
        }
      }
    },
    "레이아웃이 흔들리는 게 싫어 넉넉하게 잡아둔다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You hate the layout jumping around, so you reserve plenty of room."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You hate the layout jumping around, so you reserve plenty of room."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウトが揺れるのが嫌で、余裕を持って確保しておく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "讨厌布局晃动，所以留得宽裕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "討厭佈局晃動，所以留得寬裕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы ненавидите прыгающий макет, поэтому резервируете с запасом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Odias que el diseño salte, así que reservas espacio de sobra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hasst es, wenn das Layout herumspringt, also reservierst du reichlich Platz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous détestez que la mise en page saute, donc vous réservez beaucoup de place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Odi che il layout salti, quindi riservi molto spazio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você odeia o layout saltando, então reserva bastante espaço."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเกลียดเลย์เอาต์ที่กระโดด จึงสำรองที่ไว้เยอะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn ghét bố cục nhảy lung tung nên giữ thật nhiều chỗ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesnášíte, když rozvržení poskakuje, tak rezervujete spoustu místa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hader, at layoutet hopper rundt, så du reserverer rigelig plads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μισείς το πήδημα της διάταξης, οπότε δεσμεύεις άφθονο χώρο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhoat sitä, että asettelu hyppii, joten varaat runsaasti tilaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu benci tata letak yang melompat-lompat, jadi kamu menyisihkan ruang yang banyak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hater at layouten hopper rundt, så du reserverer rikelig med plass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je haat het als de layout rondspringt, dus je reserveert ruim."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nienawidzisz, gdy układ skacze, więc rezerwujesz dużo miejsca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hatar att layouten hoppar runt, så du reserverar gott om utrymme."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenin zıplamasından nefret ediyorsun, bu yüzden bol yer ayırıyorsun."
          }
        }
      }
    },
    "로고는 **어느 화면에서나 같은 값**이다. 화면을 서로 구별해 주지 못한다. 제목 자리가 해야 할 일은 \"여기가 어디인가\"를 말하는 것인데, 로고는 \"이건 어느 앱인가\"를 말한다. 그건 사용자가 이미 아는 사실이다.\n\n첫 진입 화면에서 로고는 기여한다. 두 번째 화면부터는 기여하지 않으면서 가장 강한 자리를 차지한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The logo is **the same value on every screen**. It can't tell screens apart. The title slot's job is to say \"where am I?\", but the logo says \"which app is this?\", something users already know.\n\nOn the first entry screen, the logo contributes. From the second screen on, it occupies the strongest slot without contributing anything."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The logo is **the same value on every screen**. It can't tell screens apart. The title slot's job is to say \"where am I?\", but the logo says \"which app is this?\", something users already know.\n\nOn the first entry screen, the logo contributes. From the second screen on, it occupies the strongest slot without contributing anything."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴは**どの画面でも同じ値**だ。画面同士を区別できない。タイトルの場所の仕事は「ここはどこか」を語ることなのに、ロゴは「これはどのアプリか」を語る。それはユーザーがすでに知っていることだ。\n\n最初の入口の画面では、ロゴは貢献する。2つ目の画面からは、貢献しないまま、もっとも強い場所を占める。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标志在**任何界面里都是同一个值**。它无法让界面彼此区分。标题位置该做的事是说“这里是哪里”，而标志说的是“这是哪个应用”，这是用户早就知道的事。\n\n在第一次进入的界面里，标志有贡献。从第二个界面起，它没有贡献，却占着最强的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標誌在**任何介面裡都是同一個值**。它無法讓介面彼此區分。標題位置該做的事是說「這裡是哪裡」，而標誌說的是「這是哪個應用程式」，這是使用者早就知道的事。\n\n在第一次進入的介面裡，標誌有貢獻。從第二個介面起，它沒有貢獻，卻佔著最強的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Логотип - **одно и то же значение на каждом экране**. Он не различает экраны. Задача слота заголовка - сказать «где я?», а логотип говорит «что это за приложение?», а это пользователи уже знают.\n\nНа первом экране входа логотип вносит вклад. Начиная со второго экрана он занимает самый сильный слот, ничего не вкладывая."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El logotipo es **el mismo valor en todas las pantallas**. No puede distinguir unas de otras. El trabajo del sitio del título es decir «¿dónde estoy?», pero el logotipo dice «¿qué app es esta?», algo que los usuarios ya saben.\n\nEn la primera pantalla de entrada, el logotipo contribuye. Desde la segunda pantalla, ocupa el sitio más fuerte sin aportar nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Logo ist **auf jedem Bildschirm derselbe Wert**. Es kann Bildschirme nicht unterscheiden. Die Aufgabe des Titelplatzes ist, „Wo bin ich?“ zu sagen, aber das Logo sagt „Welche App ist das?“, etwas, das Nutzer schon wissen.\n\nAuf dem ersten Einstiegsbildschirm trägt das Logo bei. Vom zweiten Bildschirm an belegt es den stärksten Platz, ohne etwas beizutragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le logo est **la même valeur sur chaque écran**. Il ne peut pas distinguer les écrans. Le rôle de l'emplacement du titre est de dire « où suis-je ? », mais le logo dit « quelle app est-ce ? », ce que les utilisateurs savent déjà.\n\nSur le premier écran d'entrée, le logo contribue. À partir du deuxième écran, il occupe l'emplacement le plus fort sans rien apporter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il logo è **lo stesso valore su ogni schermata**. Non può distinguere le schermate. Il compito dello slot del titolo è dire «dove sono?», ma il logo dice «di che app si tratta?», qualcosa che gli utenti sanno già.\n\nNella prima schermata d'ingresso il logo contribuisce. Dalla seconda schermata in poi occupa lo slot più forte senza contribuire a nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O logo é **o mesmo valor em todas as telas**. Não consegue distinguir telas. O trabalho do lugar do título é dizer «onde estou?», mas o logo diz «que app é este?», algo que os usuários já sabem.\n\nNa primeira tela de entrada, o logo contribui. Da segunda tela em diante, ocupa o lugar mais forte sem contribuir com nada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โลโก้เป็น**ค่าเดียวกันทุกหน้าจอ** มันแยกหน้าจอไม่ได้ หน้าที่ของช่องชื่อเรื่องคือบอกว่า \"ฉันอยู่ที่ไหน\" แต่โลโก้บอกว่า \"นี่คือแอปอะไร\" ซึ่งผู้ใช้รู้อยู่แล้ว\n\nบนหน้าจอแรกที่เข้า โลโก้ช่วยได้ ตั้งแต่หน้าจอที่สองเป็นต้นไป มันยึดช่องที่แรงที่สุดโดยไม่ช่วยอะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo là **cùng một giá trị trên mọi màn hình**. Nó không phân biệt được các màn hình. Việc của ô tiêu đề là nói \"tôi đang ở đâu?\", còn logo nói \"đây là app nào?\", điều người dùng đã biết.\n\nTrên màn hình vào đầu tiên, logo có đóng góp. Từ màn hình thứ hai trở đi, nó chiếm ô mạnh nhất mà chẳng đóng góp gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo je **stejná hodnota na každé obrazovce**. Nerozliší obrazovky. Úkolem slotu nadpisu je říct „kde jsem?“, ale logo říká „která je to aplikace?“, což uživatelé už vědí.\n\nNa první vstupní obrazovce logo přispívá. Od druhé obrazovky zabírá nejsilnější slot, aniž by cokoli přispívalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logoet er **den samme værdi på hver skærm**. Det kan ikke skelne skærme fra hinanden. Titelpladsens opgave er at sige »hvor er jeg?«, men logoet siger »hvilken app er det her?«, noget brugerne allerede ved.\n\nPå den første indgangsskærm bidrager logoet. Fra anden skærm og frem optager det den stærkeste plads uden at bidrage med noget."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το λογότυπο είναι **η ίδια τιμή σε κάθε οθόνη**. Δεν μπορεί να ξεχωρίσει οθόνες. Η δουλειά της θέσης τίτλου είναι να λέει «πού είμαι;», αλλά το λογότυπο λέει «ποια εφαρμογή είναι αυτή;», κάτι που οι χρήστες ήδη ξέρουν.\n\nΣτην πρώτη οθόνη εισόδου, το λογότυπο συμβάλλει. Από τη δεύτερη οθόνη και μετά, καταλαμβάνει την πιο δυνατή θέση χωρίς να συμβάλλει σε τίποτα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo on **sama arvo jokaisessa näkymässä**. Se ei voi erottaa näkymiä toisistaan. Otsikkopaikan tehtävä on sanoa ”missä olen?”, mutta logo sanoo ”mikä sovellus tämä on?”, jotain, minkä käyttäjät jo tietävät.\n\nEnsimmäisessä sisääntulonäkymässä logo edistää. Toisesta näkymästä alkaen se vie vahvimman paikan edistämättä mitään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo adalah **nilai yang sama di setiap layar**. Ia tidak bisa membedakan layar. Tugas slot judul adalah berkata \"di mana aku?\", tetapi logo berkata \"ini aplikasi apa?\", sesuatu yang sudah diketahui pengguna.\n\nPada layar masuk pertama, logo berkontribusi. Mulai layar kedua, ia menempati slot terkuat tanpa berkontribusi apa-apa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logoen er **den samme verdien på hver skjerm**. Den kan ikke skille skjermer. Tittelplassens jobb er å si «hvor er jeg?», men logoen sier «hvilken app er dette?», noe brukerne allerede vet.\n\nPå den første inngangsskjermen bidrar logoen. Fra den andre skjermen og utover opptar den den sterkeste plassen uten å bidra med noe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het logo is **dezelfde waarde op elk scherm**. Het kan schermen niet onderscheiden. De taak van de titelplek is \"waar ben ik?\" te zeggen, maar het logo zegt \"welke app is dit?\", iets wat gebruikers al weten.\n\nOp het eerste instapscherm draagt het logo bij. Vanaf het tweede scherm neemt het de sterkste plek in zonder iets bij te dragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo to **ta sama wartość na każdym ekranie**. Nie odróżnia ekranów. Zadaniem miejsca tytułu jest mówić „gdzie jestem?”, ale logo mówi „która to aplikacja?”, co użytkownicy już wiedzą.\n\nNa pierwszym ekranie wejściowym logo coś wnosi. Od drugiego ekranu zajmuje najmocniejsze miejsce, nic nie wnosząc."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logotypen är **samma värde på varje skärm**. Den kan inte skilja skärmar åt. Rubrikplatsens uppgift är att säga ”var är jag?”, men logotypen säger ”vilken app är det här?”, något användare redan vet.\n\nPå den första ingångsskärmen bidrar logotypen. Från den andra skärmen och framåt upptar den den starkaste platsen utan att bidra med något."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo **her ekranda aynı değerdir**. Ekranları birbirinden ayıramaz. Başlık yerinin işi “neredeyim?” demektir, ama logo “bu hangi uygulama?” der, kullanıcıların zaten bildiği bir şey.\n\nİlk giriş ekranında logo katkı sağlar. İkinci ekrandan itibaren en güçlü yeri hiçbir katkı sağlamadan kaplar."
          }
        }
      }
    },
    "로고는 앱 홈 한 곳에만 둔다. 1.2.6 Custom Large Title처럼 제목 자리를 유지한 채 내용물만 로고로 바꾸면, 스크롤 축소 같은 시스템 동작도 그대로 따라온다. 나머지 화면은 텍스트 제목으로 돌아가 각자 자기 이름을 말한다. 1.1.5 Single Principal Item 예제를 열어 보면 principal이 제목을 대체할 때 어떤 조건이 필요한지 적혀 있다. 로고는 그 조건에 맞지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the logo only on the app's home screen. If, as in 1.2.6 Custom Large Title, you keep the title slot and only swap its content for the logo, system behaviors such as shrinking on scroll come along for free. Every other screen goes back to a text title that says its own name. Open the 1.1.5 Single Principal Item example and you'll find the conditions required for principal to replace the title. A logo doesn't meet them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the logo only on the app's home screen. If, as in 1.2.6 Custom Large Title, you keep the title slot and only swap its content for the logo, system behaviours such as shrinking on scroll come along for free. Every other screen goes back to a text title that says its own name. Open the 1.1.5 Single Principal Item example and you'll find the conditions required for principal to replace the title. A logo doesn't meet them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴはアプリのホーム1か所だけに置く。1.2.6 Custom Large Titleのように、タイトルの場所を保ったまま中身だけをロゴに替えれば、スクロール時の縮小などのシステムの動作もそのままついてくる。ほかの画面はテキストのタイトルに戻り、それぞれが自分の名前を語る。1.1.5 Single Principal Itemの例を開くと、principalがタイトルの代わりになるにはどんな条件が必要かが書かれている。ロゴはその条件に合わない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标志只放在应用首页一处。像 1.2.6 Custom Large Title 那样，保留标题位置、只把内容换成标志，滚动缩小这类系统行为也会跟着来。其余界面回到文字标题，各自说出自己的名字。打开 1.1.5 Single Principal Item 示例，里面写着 principal 取代标题时需要什么条件。标志不满足这个条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標誌只放在應用程式首頁一處。像 1.2.6 Custom Large Title 那樣，保留標題位置、只把內容換成標誌，滾動縮小這類系統行為也會跟著來。其餘介面回到文字標題，各自說出自己的名字。開啟 1.1.5 Single Principal Item 示例，裡面寫著 principal 取代標題時需要什麼條件。標誌不滿足這個條件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставьте логотип только на главный экран приложения. Если, как в 1.2.6 Custom Large Title, сохранить слот заголовка и заменить лишь его содержимое логотипом, системные поведения вроде сжатия при прокрутке достаются даром. Все остальные экраны возвращаются к текстовому заголовку, говорящему собственное имя. Откройте пример 1.1.5 Single Principal Item, и вы найдёте условия, при которых principal заменяет заголовок. Логотип им не удовлетворяет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon el logotipo solo en la pantalla de inicio de la app. Si, como en 1.2.6 Custom Large Title, conservas el sitio del título y solo cambias su contenido por el logotipo, comportamientos del sistema como reducirse al desplazar vienen gratis. Todas las demás pantallas vuelven a un título de texto que dice su propio nombre. Abre el ejemplo 1.1.5 Single Principal Item y encontrarás las condiciones necesarias para que principal sustituya al título. Un logotipo no las cumple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze das Logo nur auf den Startbildschirm der App. Behältst du wie in 1.2.6 Custom Large Title den Titelplatz und tauschst nur seinen Inhalt gegen das Logo, kommen Systemverhalten wie das Schrumpfen beim Scrollen gratis mit. Jeder andere Bildschirm kehrt zu einem Texttitel zurück, der seinen eigenen Namen nennt. Öffne das Beispiel 1.1.5 Single Principal Item, und du findest die Bedingungen, die erfüllt sein müssen, damit principal den Titel ersetzt. Ein Logo erfüllt sie nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez le logo uniquement sur l'écran d'accueil de l'app. Si, comme dans 1.2.6 Custom Large Title, vous gardez l'emplacement du titre et ne remplacez que son contenu par le logo, les comportements système comme le rétrécissement au défilement viennent gratuitement. Tous les autres écrans reviennent à un titre textuel qui dit son propre nom. Ouvrez l'exemple 1.1.5 Single Principal Item et vous trouverez les conditions requises pour que principal remplace le titre. Un logo ne les remplit pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti il logo solo nella schermata home dell'app. Se, come in 1.2.6 Titolo grande personalizzato, tieni lo slot del titolo e ne scambi solo il contenuto con il logo, comportamenti di sistema come la riduzione allo scorrimento arrivano gratis. Ogni altra schermata torna a un titolo di testo che dice il proprio nome. Apri l'esempio 1.1.5 Unico elemento principal e troverai le condizioni richieste perché principal sostituisca il titolo. Un logo non le soddisfa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponha o logo só na tela inicial do app. Se, como em 1.2.6 Título grande personalizado, você mantém o lugar do título e só troca o conteúdo pelo logo, comportamentos do sistema como o encolher ao rolar vêm de graça. Toda outra tela volta a um título em texto que diz o próprio nome. Abra o exemplo 1.1.5 Único item principal e você achará as condições exigidas para principal substituir o título. Um logo não as atende."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางโลโก้เฉพาะบนหน้าแรกของแอป ถ้าอย่างใน 1.2.6 Custom Large Title คุณคงช่องชื่อเรื่องไว้และสลับแค่เนื้อหาเป็นโลโก้ พฤติกรรมของระบบอย่างการหดเมื่อเลื่อนก็ตามมาฟรี ทุกหน้าจออื่นกลับไปใช้ชื่อเรื่องข้อความที่บอกชื่อตัวเอง เปิดตัวอย่าง 1.1.5 Single Principal Item แล้วคุณจะพบเงื่อนไขที่ principal ต้องมีเพื่อแทนชื่อเรื่อง โลโก้ไม่เข้าเงื่อนไข"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ đặt logo trên màn hình chính của app. Nếu, như ở 1.2.6 Custom Large Title, bạn giữ ô tiêu đề và chỉ đổi nội dung của nó thành logo, các hành vi hệ thống như thu nhỏ khi cuộn đi kèm miễn phí. Mọi màn hình khác quay về tiêu đề chữ nói tên của chính nó. Mở ví dụ 1.1.5 Single Principal Item và bạn sẽ thấy các điều kiện để principal thay tiêu đề. Logo không đáp ứng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte logo jen na domovskou obrazovku aplikace. Pokud, jako v 1.2.6 Custom Large Title, ponecháte slot nadpisu a jen vyměníte jeho obsah za logo, systémová chování jako zmenšení při posouvání přijdou zdarma. Každá další obrazovka se vrací k textovému nadpisu, který říká své vlastní jméno. Otevřete příklad 1.1.5 Single Principal Item a najdete podmínky potřebné k tomu, aby principal nahradil nadpis. Logo je nesplňuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg kun logoet på appens hjemmeskærm. Hvis du, som i 1.2.6 Brugerdefineret stor titel, beholder titelpladsen og kun bytter dens indhold ud med logoet, følger systemadfærd som skrumpning ved scroll gratis med. Alle andre skærme går tilbage til en teksttitel, der siger sit eget navn. Åbn eksempel 1.1.5 Enkelt principal-element, og du finder de betingelser, der kræves, for at principal kan erstatte titlen. Et logo opfylder dem ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε το λογότυπο μόνο στην αρχική οθόνη της εφαρμογής. Αν, όπως στο 1.2.6 Προσαρμοσμένος μεγάλος τίτλος, κρατήσεις τη θέση τίτλου και αντικαταστήσεις μόνο το περιεχόμενό της με το λογότυπο, οι συμπεριφορές συστήματος όπως η σμίκρυνση στην κύλιση έρχονται δωρεάν. Κάθε άλλη οθόνη γυρίζει σε τίτλο κειμένου που λέει το δικό της όνομα. Άνοιξε το παράδειγμα 1.1.5 Ένα principal στοιχείο και θα βρεις τις συνθήκες που απαιτούνται για να αντικαταστήσει το principal τον τίτλο. Ένα λογότυπο δεν τις πληροί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita logo vain sovelluksen kotinäkymään. Jos kuten kohdassa 1.2.6 Mukautettu suuri otsikko pidät otsikkopaikan ja vaihdat vain sen sisällön logoon, järjestelmäkäytökset, kuten kutistuminen vieritettäessä, tulevat ilmaiseksi mukana. Jokainen muu näkymä palaa tekstiotsikkoon, joka sanoo oman nimensä. Avaa esimerkki 1.1.5 Yksi Principal-kohde ja löydät ehdot, jotka vaaditaan, jotta principal voi korvata otsikon. Logo ei täytä niitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh logo hanya di layar beranda aplikasi. Jika, seperti di 1.2.6 Custom Large Title, kamu mempertahankan slot judul dan hanya menukar isinya dengan logo, perilaku sistem seperti menyusut saat digulir ikut gratis. Setiap layar lain kembali ke judul teks yang menyebut namanya sendiri. Buka contoh 1.1.5 Single Principal Item dan kamu akan menemukan syarat yang dibutuhkan agar principal menggantikan judul. Logo tidak memenuhinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett logoen bare på appens hjemmeskjerm. Hvis du, som i 1.2.6 Custom Large Title, beholder tittelplassen og bare bytter innholdet med logoen, følger systemoppførsel som å krympe ved rulling med gratis. Alle andre skjermer går tilbake til en teksttittel som sier sitt eget navn. Åpne eksempelet 1.1.5 Single Principal Item, så finner du betingelsene som kreves for at principal skal erstatte tittelen. En logo oppfyller dem ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet het logo alleen op het startscherm van de app. Als je, zoals bij 1.2.6 Aangepaste grote titel, de titelplek behoudt en alleen de inhoud door het logo vervangt, komt systeemgedrag zoals krimpen bij scrollen gratis mee. Elk ander scherm gaat terug naar een teksttitel die zijn eigen naam zegt. Open het voorbeeld 1.1.5 Eén principal-item en je vindt de voorwaarden waaraan principal moet voldoen om de titel te vervangen. Een logo voldoet er niet aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść logo tylko na ekranie głównym aplikacji. Jeśli, jak w 1.2.6 Własny duży tytuł, zachowasz miejsce tytułu i tylko podmienisz jego zawartość na logo, zachowania systemowe jak kurczenie przy przewijaniu przychodzą za darmo. Każdy inny ekran wraca do tytułu tekstowego, który mówi własną nazwę. Otwórz przykład 1.1.5 Jeden element principal, a znajdziesz warunki, jakie musi spełniać principal, by zastąpić tytuł. Logo ich nie spełnia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg logotypen bara på appens startskärm. Om du, som i 1.2.6 Custom Large Title, behåller rubrikplatsen och bara byter ut dess innehåll mot logotypen, följer systembeteenden som att krympa vid scrollning med på köpet. Varje annan skärm går tillbaka till en textrubrik som säger sitt eget namn. Öppna exemplet 1.1.5 Single Principal Item så hittar du villkoren som krävs för att principal ska ersätta rubriken. En logotyp uppfyller dem inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logoyu yalnızca uygulamanın ana ekranına koy. 1.2.6 Custom Large Title'daki gibi başlık yerini koruyup yalnızca içeriğini logoyla değiştirirsen kaydırınca küçülme gibi sistem davranışları bedavaya gelir. Diğer her ekran kendi adını söyleyen bir metin başlığına döner. 1.1.5 Single Principal Item örneğini aç, principal'ın başlığın yerini alması için gereken koşulları bulursun. Bir logo onları karşılamaz."
          }
        }
      }
    },
    "로고는 진입 화면 한 곳이면 충분하다. 나머지 화면은 지금 어디인지를 말해야 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The logo on the entry screen alone is enough. Every other screen should say where you are."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The logo on the entry screen alone is enough. Every other screen should say where you are."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロゴは入口の画面1か所で十分だ。ほかの画面は、いまどこにいるかを語るべきだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标志在进入界面处放一个就够了。其余界面要说明现在在哪里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標誌在進入介面處放一個就夠了。其餘介面要說明現在在哪裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Логотипа на экране входа достаточно. Все остальные экраны должны говорить, где вы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta con el logotipo en la pantalla de entrada. Todas las demás pantallas deben decir dónde estás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Logo allein auf dem Einstiegsbildschirm genügt. Jeder andere Bildschirm sollte sagen, wo du bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le logo sur l'écran d'entrée seul suffit. Tous les autres écrans devraient dire où vous êtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il logo nella sola schermata d'ingresso basta. Ogni altra schermata deve dire dove ti trovi."
          }
