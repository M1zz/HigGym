            "value": "Dejte to do slotu trailing, který systém definuje. Uživatelé už vědí, že tam mají hledat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg den i den trailing-plads, systemet definerer. Brugerne ved allerede, at de skal kigge der."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλ' το στην trailing θέση που ορίζει το σύστημα. Οι χρήστες ήδη ξέρουν να κοιτάξουν εκεί."
          }
        }
      }
    },
    "시스템이 주는 모양이 브랜드와 안 맞아 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shape the system provides doesn't seem to fit your brand."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The shape the system provides doesn't seem to fit your brand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが提供する形がブランドに合わないように見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统给的外形似乎和品牌不搭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統給的外形似乎和品牌不搭。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма, которую даёт система, кажется не подходящей вашему бренду."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma que ofrece el sistema parece no encajar con tu marca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vom System gelieferte Form scheint nicht zu deiner Marke zu passen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La forme fournie par le système ne semble pas convenir à votre marque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma che il sistema fornisce non sembra adattarsi al tuo marchio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A forma que o sistema fornece não parece combinar com a sua marca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปทรงที่ระบบให้ดูไม่เข้ากับแบรนด์ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình dạng hệ thống cung cấp có vẻ không hợp với thương hiệu của bạn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvar, který systém poskytuje, se nezdá hodit k vaší značce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den form, systemet leverer, ser ikke ud til at passe til dit brand."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σχήμα που παρέχει το σύστημα δεν φαίνεται να ταιριάζει στο brand σου."
          }
        }
      }
    },
    "시스템이 주는 캡슐이 브랜드와 어울리지 않아 보인다. 위치와 모양만 비슷하게 맞추면 사용자에게는 같은 것으로 보일 테고, 대신 색과 크기는 자유롭게 고를 수 있다. 직접 만들면 전환 방식도 원하는 대로 할 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capsule the system provides doesn't seem to match your brand. If you roughly match the position and shape, users will see it as the same thing, and you get to choose the color and size freely. Build it yourself, and you can control the transition too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The capsule the system provides doesn't seem to match your brand. If you roughly match the position and shape, users will see it as the same thing, and you get to choose the colour and size freely. Build it yourself, and you can control the transition too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが提供するカプセルがブランドに合わないように見える。位置と形さえ似せればユーザーには同じものに見えるだろうし、その代わり色とサイズは自由に選べる。自分で作れば遷移の仕方も思いどおりにできる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统给的胶囊似乎和品牌不搭。只要把位置和外形做得相似，用户看起来就是同一个东西，而颜色和大小可以自由选择。自己做的话，转场方式也能随心所欲。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統給的膠囊似乎和品牌不搭。只要把位置和外形做得相似，使用者看起來就是同一個東西，而顏色和大小可以自由選擇。自己做的話，轉場方式也能隨心所欲。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Капсула, которую даёт система, кажется не подходящей вашему бренду. Если примерно совпасть положением и формой, пользователи увидят в ней то же самое, а цвет и размер можно выбрать свободно. Сделаете сами - сможете управлять и переходом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cápsula que ofrece el sistema parece no encajar con tu marca. Si igualas aproximadamente la posición y la forma, los usuarios la verán como lo mismo, y puedes elegir libremente el color y el tamaño. Constrúyela tú mismo y podrás controlar también la transición."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vom System gelieferte Kapsel scheint nicht zu deiner Marke zu passen. Triffst du Position und Form ungefähr, sehen Nutzer es als dasselbe an, und Farbe und Größe kannst du frei wählen. Baust du es selbst, kannst du auch den Übergang steuern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La capsule fournie par le système ne semble pas correspondre à votre marque. Si vous reproduisez à peu près la position et la forme, les utilisateurs y verront la même chose, et vous choisissez librement la couleur et la taille. Construisez-la vous-même, et vous pouvez aussi contrôler la transition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La capsula che il sistema fornisce non sembra corrispondere al tuo marchio. Se imiti più o meno posizione e forma, gli utenti la vedranno come la stessa cosa e potrai scegliere liberamente colore e dimensione. Costruiscila tu e potrai controllare anche la transizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cápsula que o sistema fornece não parece combinar com a sua marca. Se você imita mais ou menos a posição e a forma, os usuários a verão como a mesma coisa e você escolhe livremente cor e tamanho. Construa você mesmo e poderá controlar também a transição."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แคปซูลที่ระบบให้ดูไม่เข้ากับแบรนด์ของคุณ ถ้าคุณทำตำแหน่งและรูปทรงให้คล้าย ผู้ใช้จะมองว่าเป็นสิ่งเดียวกัน และคุณเลือกสีและขนาดได้อิสระ สร้างเอง คุณควบคุมทรานซิชันได้ด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule hệ thống cung cấp có vẻ không khớp thương hiệu của bạn. Nếu khớp đại khái vị trí và hình dạng, người dùng sẽ coi là cùng một thứ, và bạn tự do chọn màu và kích thước. Tự dựng thì bạn kiểm soát được cả chuyển cảnh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapsle, kterou systém poskytuje, se nezdá odpovídat vaší značce. Pokud zhruba odpovídáte pozici a tvaru, uživatelé to uvidí jako totéž a můžete volně volit barvu a velikost. Postavte si to sami a můžete ovládat i přechod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kapsel, systemet leverer, ser ikke ud til at passe til dit brand. Hvis du nogenlunde matcher position og form, ser brugerne den som det samme, og du kan frit vælge farve og størrelse. Byg den selv, og du kan også styre overgangen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάψουλα που παρέχει το σύστημα δεν φαίνεται να ταιριάζει στο brand σου. Αν ταιριάξεις περίπου τη θέση και το σχήμα, οι χρήστες θα το δουν ως το ίδιο πράγμα, και μπορείς να διαλέξεις ελεύθερα χρώμα και μέγεθος. Φτιάξ' το μόνος σου και μπορείς να ελέγξεις και τη μετάβαση."
          }
        }
      }
    },
    "시안에 250pt라고 적혀 있다. 그 숫자를 그대로 옮기면 시안과 픽셀이 맞는다. medium은 이 패널에 너무 크고, 커스텀 detent가 있으니 정확한 값을 주는 게 성실한 구현처럼 보인다. 확인도 시안을 그린 기기 하나에서 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mockup says 250pt. Copy that number as is and you match the mockup pixel for pixel. medium is too big for this panel, and since custom detents exist, giving an exact value feels like a diligent implementation. You also check it only on the one device the mockup was drawn for."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The mockup says 250pt. Copy that number as is and you match the mockup pixel for pixel. medium is too big for this panel, and since custom detents exist, giving an exact value feels like a diligent implementation. You also check it only on the one device the mockup was drawn for."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインカンプに 250pt と書いてある。その数字をそのまま移せばカンプとピクセルが合う。medium はこのパネルには大きすぎるし、カスタム detent があるのだから正確な値を指定するのが誠実な実装に見える。確認も、カンプを描いた端末ひとつで済ませる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设计稿上写着 250pt。照搬这个数字，就能和设计稿像素对齐。medium 对这个面板太大，既然有自定义 detent，给出精确值似乎才是认真的实现。检查也只在画设计稿的那一台设备上做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設計稿上寫著 250pt。照搬這個數字，就能和設計稿畫素對齊。medium 對這個面板太大，既然有自定義 detent，給出精確值似乎才是認真的實作。檢查也只在畫設計稿的那一臺裝置上做。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В макете написано 250 pt. Скопируйте это число как есть, и вы совпадёте с макетом до пикселя. Medium слишком велик для этой панели, а раз есть пользовательские detent, точное значение кажется добросовестной реализацией. К тому же вы проверяете только на одном устройстве, для которого рисовали макет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La maqueta dice 250 pt. Copia ese número tal cual y coincidirás con la maqueta píxel por píxel. Medium es demasiado grande para este panel, y como existen detents personalizados, dar un valor exacto parece una implementación diligente. Además, lo compruebas solo en el único dispositivo para el que se dibujó la maqueta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mockup sagt 250 pt. Kopierst du diese Zahl unverändert, triffst du das Mockup pixelgenau. medium ist für dieses Panel zu groß, und da es eigene Detents gibt, fühlt sich ein exakter Wert nach sorgfältiger Umsetzung an. Außerdem prüfst du es nur auf dem einen Gerät, für das das Mockup gezeichnet wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La maquette dit 250 pt. Copiez ce nombre tel quel et vous collez à la maquette au pixel près. medium est trop grand pour ce panneau, et puisque les detents personnalisés existent, donner une valeur exacte ressemble à une implémentation consciencieuse. Vous ne vérifiez non plus que sur le seul appareil pour lequel la maquette a été dessinée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mockup dice 250 pt. Copia quel numero così com'è e corrisponde al mockup pixel per pixel. medium è troppo grande per questo pannello, e visto che esistono i detent personalizzati, dare un valore esatto sembra un'implementazione diligente. Inoltre controlli solo sull'unico dispositivo per cui il mockup è stato disegnato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mockup diz 250 pt. Copie esse número como está e você combina com o mockup pixel a pixel. medium é grande demais para este painel e, já que existem detents personalizados, dar um valor exato parece uma implementação diligente. Você também confere só no único dispositivo para o qual o mockup foi desenhado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ม็อกอัปบอก 250pt คัดลอกตัวเลขนั้นตามเดิม คุณก็ตรงม็อกอัปพิกเซลต่อพิกเซล medium ใหญ่เกินไปสำหรับแผงนี้ และเนื่องจากมี detent กำหนดเอง การให้ค่าที่แน่นอนรู้สึกเหมือนการทำที่ขยัน คุณยังตรวจเฉพาะบนอุปกรณ์เดียวที่ม็อกอัปถูกวาด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mockup ghi 250pt. Chép nguyên con số thì khớp mockup từng pixel. medium quá lớn cho bảng này, và vì có detent tùy chỉnh, đưa giá trị chính xác có cảm giác là cài đặt chăm chỉ. Bạn cũng chỉ kiểm tra trên đúng một thiết bị mà mockup được vẽ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V mockupu stojí 250pt. Zkopírujte to číslo tak, jak je, a shodnete se s mockupem na pixel. medium je pro tento panel moc velké a protože existují vlastní detenty, zadání přesné hodnoty působí jako pečlivá implementace. Také to kontrolujete jen na jediném zařízení, pro které byl mockup nakreslen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mockuppet siger 250 pt. Kopiér det tal uændret, og du matcher mockuppet pixel for pixel. medium er for stort til dette panel, og da brugerdefinerede detents findes, føles det flittigt at give en præcis værdi. Du tjekker det også kun på den ene enhed, mockuppet blev tegnet til."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο λέει 250 pt. Αντίγραψε αυτόν τον αριθμό ως έχει και ταιριάζεις το μοντέλο pixel προς pixel. Το medium είναι πολύ μεγάλο για αυτό το πάνελ, και εφόσον υπάρχουν προσαρμοσμένα detents, η παροχή ακριβούς τιμής νιώθεται επιμελής υλοποίηση. Επίσης το ελέγχεις μόνο στη μία συσκευή για την οποία σχεδιάστηκε το μοντέλο."
          }
        }
      }
    },
    "시안에 적힌 250pt를 그대로 옮긴다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You copy the 250pt written in the mockup as is."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You copy the 250pt written in the mockup as is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインカンプに書かれた 250pt をそのまま移す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把设计稿上写的 250pt 原样搬过来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把設計稿上寫的 250pt 原樣搬過來。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы переносите как есть 250 pt, написанные в макете."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasladas tal cual los 250 pt escritos en la maqueta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kopierst die im Mockup stehenden 250 pt unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous copiez tels quels les 250 pt écrits dans la maquette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copi così com'è i 250 pt scritti nel mockup."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você copia como está os 250 pt escritos no mockup."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณคัดลอก 250pt ที่เขียนในม็อกอัปตามเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chép nguyên 250pt ghi trong mockup."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírujete 250pt zapsané v mockupu tak, jak je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kopierer de 250 pt, der står i mockuppet, uændret."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντιγράφεις ως έχουν τα 250 pt που γράφει το μοντέλο."
          }
        }
      }
    },
    "시안에서 빈 자리가 보이면 채울 것을 찾기 전에 묻는다. \"이 자리가 비어 있어서 사용자가 못 하게 되는 일이 있나?\" 대개는 없다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you spot an empty slot in a mockup, ask before looking for something to fill it: \"Does leaving this slot empty stop users from doing anything?\" Usually it doesn't."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you spot an empty slot in a mockup, ask before looking for something to fill it: \"Does leaving this slot empty stop users from doing anything?\" Usually it doesn't."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザイン案に空いた場所を見つけたら、埋めるものを探す前に問う。「この場所が空いていることで、ユーザーができなくなることはあるか？」たいていはない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设计稿里看到空位时，先别急着找东西填，先问：“因为这里空着，用户有做不了的事吗？”通常没有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設計稿裡看到空位時，先別急著找東西填，先問：「因為這裡空著，使用者有做不了的事嗎？」通常沒有。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увидев в макете пустой слот, прежде чем искать, чем его заполнить, спросите: «Мешает ли пустота этого слота пользователям что-то сделать?» Обычно не мешает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando veas un hueco vacío en una maqueta, antes de buscar algo con lo que llenarlo, pregunta: «¿Impide este hueco vacío a los usuarios hacer algo?» Normalmente no."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdeckst du in einem Mockup einen leeren Platz, frage, bevor du etwas zum Füllen suchst: „Hindert es Nutzer an irgendetwas, wenn dieser Platz leer bleibt?“ Meist nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous repérez un emplacement vide dans une maquette, demandez avant de chercher de quoi le remplir : « Laisser cet emplacement vide empêche-t-il les utilisateurs de faire quoi que ce soit ? » En général non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando vedi uno slot vuoto in un mockup, chiediti prima di cercare qualcosa con cui riempirlo: «Lasciare vuoto questo slot impedisce agli utenti di fare qualcosa?» Di solito no."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você vê um lugar vazio num mockup, pergunte antes de procurar algo para preenchê-lo: «Deixar este lugar vazio impede os usuários de fazer alguma coisa?» Em geral não."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเห็นช่องว่างในม็อกอัป ให้ถามก่อนหาสิ่งมาเติม: \"การปล่อยช่องนี้ว่างทำให้ผู้ใช้ทำอะไรไม่ได้หรือไม่\" โดยปกติไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thấy một ô trống trong mockup, hãy hỏi trước khi tìm thứ để lấp: \"Để trống ô này có ngăn người dùng làm gì không?\" Thường thì không."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když v mockupu zahlédnete prázdný slot, zeptejte se, než začnete hledat, čím ho vyplnit: „Brání ponechání tohoto slotu prázdného uživatelům v něčem?“ Obvykle ne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du opdager en tom plads i et mockup, så spørg, før du leder efter noget at fylde den med: »Forhindrer det brugerne i at gøre noget at lade denne plads stå tom?« Det gør det som regel ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν εντοπίσεις μια άδεια θέση σε ένα μοντέλο, ρώτα πριν ψάξεις κάτι να τη γεμίσεις: «Εμποδίζει τους χρήστες να κάνουν οτιδήποτε το να αφήσεις αυτή τη θέση άδεια;» Συνήθως όχι."
          }
        }
      }
    },
    "시안에서는 이 투명함이 가장 아름다웠다. 사진이 유리 너머로 비치는 모습이 Liquid Glass답다. 시안에 쓴 배경은 대개 그 투명함이 가장 잘 사는 배경이다. 가장 좋은 순간을 기준으로 삼으면 그 순간을 지키고 싶어진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the mockup, this transparency looked most beautiful. Photos showing through the glass feel very Liquid Glass. The background used in a mockup is usually the one that shows off that transparency best. When you take the best moment as your benchmark, you want to protect that moment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In the mockup, this transparency looked most beautiful. Photos showing through the glass feel very Liquid Glass. The background used in a mockup is usually the one that shows off that transparency best. When you take the best moment as your benchmark, you want to protect that moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンプでは、この透明感がいちばん美しかった。写真がガラス越しに透ける様子は、いかにも Liquid Glass らしい。カンプに使う背景は、たいていその透明感がいちばん映える背景だ。いちばん良い瞬間を基準にすると、その瞬間を守りたくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设计稿里，这种通透最漂亮。照片隔着玻璃透出来，很有 Liquid Glass 的味道。设计稿用的背景，通常是让这种通透最出彩的背景。以最好的瞬间为基准，就想守住那个瞬间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設計稿裡，這種通透最漂亮。照片隔著玻璃透出來，很有 Liquid Glass 的味道。設計稿用的背景，通常是讓這種通透最出彩的背景。以最好的瞬間為基準，就想守住那個瞬間。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В макете эта прозрачность выглядела прекраснее всего. Фотографии, просвечивающие сквозь стекло, очень в духе Liquid Glass. Фон, использованный в макете, обычно лучше всего показывает эту прозрачность. Когда лучший момент берётся за эталон, хочется его сохранить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la maqueta, esta transparencia se veía lo más hermosa. Las fotos que se transparentan a través del cristal son muy Liquid Glass. El fondo usado en una maqueta suele ser el que mejor luce esa transparencia. Cuando tomas el mejor momento como referencia, quieres protegerlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Mockup sah diese Transparenz am schönsten aus. Fotos, die durch das Glas scheinen, wirken sehr nach Liquid Glass. Der in einem Mockup genutzte Hintergrund ist meist der, der diese Transparenz am besten zur Geltung bringt. Nimmst du den besten Moment als Maßstab, willst du diesen Moment schützen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la maquette, cette transparence paraissait la plus belle. Les photos qui transparaissent à travers le verre font très Liquid Glass. L'arrière-plan utilisé dans une maquette est généralement celui qui met le mieux en valeur cette transparence. Quand vous prenez le meilleur moment comme référence, vous voulez protéger ce moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel mockup, questa trasparenza sembrava bellissima. Le foto che traspaiono attraverso il vetro fanno molto Liquid Glass. Lo sfondo usato in un mockup è di solito quello che mette meglio in mostra quella trasparenza. Quando prendi come riferimento il momento migliore, vuoi proteggere quel momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No mockup, essa transparência ficava mais bonita. Fotos transparecendo pelo vidro dão muito a sensação de Liquid Glass. O fundo usado num mockup costuma ser o que melhor exibe essa transparência. Quando você toma o melhor momento como referência, quer proteger esse momento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในม็อกอัป ความโปร่งใสนี้ดูสวยที่สุด รูปถ่ายที่มองทะลุกระจกให้ความรู้สึก Liquid Glass มาก พื้นหลังที่ใช้ในม็อกอัปมักเป็นพื้นหลังที่โชว์ความโปร่งใสนั้นดีที่สุด เมื่อคุณถือช่วงที่ดีที่สุดเป็นเกณฑ์ คุณก็อยากปกป้องช่วงนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong mockup, độ trong suốt này trông đẹp nhất. Ảnh lộ qua kính rất Liquid Glass. Nền dùng trong mockup thường là nền khoe độ trong suốt đó tốt nhất. Khi lấy khoảnh khắc đẹp nhất làm chuẩn, bạn muốn bảo vệ khoảnh khắc đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V mockupu tato průhlednost vypadala nejkrásněji. Fotky prosvítající sklem působí velmi Liquid Glass. Pozadí použité v mockupu je obvykle to, které tuto průhlednost nejlépe předvede. Když vezmete nejlepší okamžik za měřítko, chcete ten okamžik chránit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I mockuppet så denne gennemsigtighed smukkest ud. Fotos, der skinner igennem glasset, føles meget Liquid Glass. Baggrunden i et mockup er som regel den, der fremviser gennemsigtigheden bedst. Når du tager det bedste øjeblik som målestok, vil du beskytte det øjeblik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο μοντέλο, αυτή η διαφάνεια φαινόταν η πιο όμορφη. Φωτογραφίες που διαφαίνονται μέσα από το γυαλί μοιάζουν πολύ Liquid Glass. Το φόντο που χρησιμοποιείται σε ένα μοντέλο είναι συνήθως αυτό που προβάλλει καλύτερα εκείνη τη διαφάνεια. Όταν παίρνεις την καλύτερη στιγμή ως μέτρο, θέλεις να προστατεύσεις εκείνη τη στιγμή."
          }
        }
      }
    },
    "시안은 펼친 상태로만 그렸다. 탭바 최소화와 액세서리 배치는 시스템이 처리하니, 접힌 상태도 시스템이 알아서 맞춰 줄 것이라 여기기 쉽다. 개발 중에는 스크롤을 거의 하지 않아 접힌 모습을 볼 일이 적다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mockups only showed the expanded state. Since the system handles minimizing the tab bar and placing the accessory, it's easy to assume it'll adjust the collapsed state for you too. During development you barely scroll, so you rarely see the collapsed version."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The mockups only showed the expanded state. Since the system handles minimising the tab bar and placing the accessory, it's easy to assume it'll adjust the collapsed state for you too. During development you barely scroll, so you rarely see the collapsed version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインカンプは展開した状態だけで描いた。タブバーの最小化とアクセサリの配置はシステムが処理するので、折りたたまれた状態もシステムが合わせてくれるだろうと思いがちだ。開発中はほとんどスクロールしないので、折りたたまれた姿を見る機会も少ない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设计稿只画了展开状态。标签栏最小化和附件布局由系统处理，容易以为折叠状态系统也会自动调好。开发期间几乎不怎么滚动，很少看到折叠的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設計稿只畫了展開狀態。標籤列最小化和附件佈局由系統處理，容易以為摺疊狀態系統也會自動調好。開發期間幾乎不怎麼滾動，很少看到摺疊的樣子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Макеты показывали только развёрнутое состояние. Поскольку сворачиванием панели вкладок и расположением accessory занимается система, легко решить, что она подстроит и свёрнутое состояние. Во время разработки вы почти не прокручиваете, так что свёрнутый вид видите редко."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las maquetas solo mostraban el estado expandido. Como el sistema se ocupa de minimizar la barra de pestañas y de colocar el accesorio, es fácil suponer que también ajustará el estado colapsado. Durante el desarrollo apenas desplazas, así que rara vez ves la versión colapsada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mockups zeigten nur den erweiterten Zustand. Da das System das Minimieren der Tab-Leiste und die Platzierung des Accessory übernimmt, nimmt man leicht an, dass es auch den zusammengeklappten Zustand für dich anpasst. Während der Entwicklung scrollt man kaum, also sieht man die zusammengeklappte Version selten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les maquettes ne montraient que l'état déployé. Comme le système gère la réduction de la barre d'onglets et le placement de l'accessoire, on suppose facilement qu'il ajustera aussi l'état replié pour vous. Pendant le développement, on défile à peine, donc on voit rarement la version repliée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I mockup mostravano solo lo stato espanso. Poiché il sistema gestisce la riduzione della barra delle schede e la collocazione dell'accessorio, è facile presumere che regolerà da solo anche lo stato compresso. Durante lo sviluppo scorri a malapena, quindi la versione compressa la vedi di rado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os mockups mostravam só o estado expandido. Como o sistema cuida de minimizar a barra de abas e de posicionar o acessório, é fácil presumir que ele ajustará também o estado recolhido. Durante o desenvolvimento você mal rola, então raramente vê a versão recolhida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ม็อกอัปแสดงเฉพาะสถานะขยาย เนื่องจากระบบจัดการการย่อแถบแท็บและการวางอุปกรณ์เสริม จึงสมมติได้ง่ายว่ามันจะปรับสถานะยุบให้ด้วย ระหว่างพัฒนา คุณแทบไม่เลื่อน จึงไม่ค่อยเห็นเวอร์ชันที่ยุบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mockup chỉ cho thấy trạng thái mở rộng. Vì hệ thống lo việc thu gọn thanh tab và đặt phụ kiện, dễ cho rằng nó cũng sẽ chỉnh trạng thái thu gọn cho bạn. Khi phát triển bạn hầu như không cuộn, nên hiếm khi thấy bản thu gọn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mockupy ukazovaly jen rozbalený stav. Protože systém zajišťuje minimalizaci panelu karet a umístění příslušenství, snadno předpokládáte, že upraví i sbalený stav za vás. Při vývoji skoro neposouváte, takže sbalenou verzi vidíte jen zřídka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mockuppene viste kun den udvidede tilstand. Da systemet håndterer minimeringen af fanelinjen og placeringen af tilbehøret, er det let at antage, at det også justerer den sammenfoldede tilstand for dig. Under udviklingen scroller du næsten ikke, så du ser sjældent den sammenfoldede version."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μοντέλα έδειχναν μόνο την ανεπτυγμένη κατάσταση. Εφόσον το σύστημα χειρίζεται την ελαχιστοποίηση της γραμμής καρτελών και την τοποθέτηση του εξαρτήματος, είναι εύκολο να υποθέσεις ότι θα προσαρμόσει και τη συμπτυγμένη κατάσταση για σένα. Κατά την ανάπτυξη σχεδόν δεν κυλάς, οπότε σπάνια βλέπεις τη συμπτυγμένη έκδοση."
          }
        }
      }
    },
    "시안을 판정할 때 배경을 가장 나쁜 것으로 바꿔 끼운다. 거기서 읽히면 통과다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When judging a mockup, swap in the worst possible background. If it's readable there, it passes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When judging a mockup, swap in the worst possible background. If it's readable there, it passes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンプを判定するときは、背景をいちばん悪いものに差し替える。そこで読めれば合格だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "评判设计稿时，把背景换成最糟糕的。在那里读得清，才算通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "評判設計稿時，把背景換成最糟糕的。在那裡讀得清，才算透過。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценивая макет, подставьте худший из возможных фонов. Если там читается, он проходит."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al juzgar una maqueta, sustituye el fondo por el peor posible. Si se lee ahí, aprueba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tausche beim Beurteilen eines Mockups den schlechtestmöglichen Hintergrund ein. Ist es dort lesbar, besteht es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En jugeant une maquette, remplacez par le pire arrière-plan possible. S'il est lisible là, il passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando giudichi un mockup, sostituisci con lo sfondo peggiore possibile. Se lì è leggibile, passa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao julgar um mockup, troque pelo pior fundo possível. Se ali é legível, passa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อตัดสินม็อกอัป ให้สลับพื้นหลังที่แย่ที่สุดเท่าที่เป็นไปได้เข้าไป ถ้าอ่านออกที่นั่น ก็ผ่าน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đánh giá mockup, hãy thay bằng nền tệ nhất có thể. Nếu đọc được ở đó thì đạt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při posuzování mockupu dosaďte nejhorší možné pozadí. Pokud je tam čitelný, projde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du bedømmer et mockup, så skift den værst tænkelige baggrund ind. Hvis den er læselig der, består den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν κρίνεις ένα μοντέλο, άλλαξε με το χειρότερο δυνατό φόντο. Αν διαβάζεται εκεί, περνά."
          }
        }
      }
    },
    "시안의 숫자를 옮기기 전에 묻는다. \"이 숫자는 어떤 기기, 어떤 글자 크기에서 맞춘 값인가?\" 답이 하나뿐이면 그 숫자는 쓰지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before copying a number from the mockup, ask: \"Which device and which text size was this number tuned for?\" If there's only one answer, don't use that number."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before copying a number from the mockup, ask: \"Which device and which text size was this number tuned for?\" If there's only one answer, don't use that number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインカンプの数字を移す前に問う。「この数字は、どの端末、どの文字サイズで合わせた値か？」 答えがひとつしかないなら、その数字は使わない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搬设计稿的数字之前先问：“这个数字是在哪种设备、哪种字号下调出来的？”答案只有一个的话，这个数字就不要用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搬設計稿的數字之前先問：「這個數字是在哪種裝置、哪種字號下調出來的？」答案只有一個的話，這個數字就不要用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем переносить число из макета, спросите: «Для какого устройства и какого размера текста это число подбиралось?» Если ответ один, не используйте это число."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de copiar un número de la maqueta, pregunta: «¿Para qué dispositivo y qué tamaño de texto se ajustó este número?» Si solo hay una respuesta, no uses ese número."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage, bevor du eine Zahl aus dem Mockup kopierst: „Für welches Gerät und welche Textgröße wurde diese Zahl abgestimmt?“ Gibt es nur eine Antwort, nutze diese Zahl nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de copier un nombre de la maquette, demandez : « Pour quel appareil et quelle taille de texte ce nombre a-t-il été réglé ? » S'il n'y a qu'une réponse, n'utilisez pas ce nombre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di copiare un numero dal mockup, chiediti: «Per quale dispositivo e quale dimensione di testo è stato regolato questo numero?» Se c'è una sola risposta, non usare quel numero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de copiar um número do mockup, pergunte: «Para que dispositivo e que tamanho de texto este número foi ajustado?» Se só há uma resposta, não use esse número."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนคัดลอกตัวเลขจากม็อกอัป ให้ถาม: \"ตัวเลขนี้ปรับสำหรับอุปกรณ์ไหนและขนาดตัวอักษรเท่าไร\" ถ้ามีคำตอบเดียว อย่าใช้ตัวเลขนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi chép một con số từ mockup, hãy hỏi: \"Con số này được chỉnh cho thiết bị nào và cỡ chữ nào?\" Nếu chỉ có một đáp án thì đừng dùng con số đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než zkopírujete číslo z mockupu, zeptejte se: „Pro které zařízení a velikost textu bylo toto číslo vyladěno?“ Pokud existuje jediná odpověď, to číslo nepoužívejte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du kopierer et tal fra mockuppet, så spørg: »Hvilken enhed og hvilken tekststørrelse blev dette tal tunet til?« Hvis der kun er ét svar, så brug ikke det tal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν αντιγράψεις έναν αριθμό από το μοντέλο, ρώτα: «Για ποια συσκευή και ποιο μέγεθος κειμένου ρυθμίστηκε αυτός ο αριθμός;» Αν υπάρχει μόνο μία απάντηση, μη χρησιμοποιήσεις αυτόν τον αριθμό."
          }
        }
      }
    },
    "시작(위치)과 끝(파일명)이 모두 정보": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the start (location) and the end (file name) carry information"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Both the start (location) and the end (file name) carry information"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始まり（場所）と終わり（ファイル名）の両方が情報"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开头（位置）和结尾（文件名）都是信息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開頭（位置）和結尾（檔名）都是資訊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И начало (расположение), и конец (имя файла) несут информацию"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanto el principio (la ubicación) como el final (el nombre del archivo) llevan información"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sowohl der Anfang (Ort) als auch das Ende (Dateiname) tragen Information"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le début (emplacement) comme la fin (nom du fichier) portent de l'information"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sia l'inizio (la posizione) sia la fine (il nome del file) portano informazione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanto o começo (local) quanto o fim (nome do arquivo) carregam informação"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งส่วนต้น (ตำแหน่ง) และส่วนท้าย (ชื่อไฟล์) มีข้อมูล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả phần đầu (vị trí) lẫn phần cuối (tên tệp) đều mang thông tin"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začátek (umístění) i konec (název souboru) nesou informaci"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Både begyndelsen (placeringen) og enden (filnavnet) bærer information"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Και η αρχή (τοποθεσία) και το τέλος (όνομα αρχείου) φέρουν πληροφορία"
          }
        }
      }
    },
    "시작점 모호": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where it starts becomes unclear"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Where it starts becomes unclear"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこから始まるのかがあいまい"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起点不明确"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "起點不明確"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Становится неясно, откуда начинается"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No queda claro dónde empieza"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo es beginnt, wird unklar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'endroit où cela commence devient flou"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si capisce più da dove inizia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica incerto onde começa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จุดเริ่มไม่ชัด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỗ bắt đầu trở nên không rõ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místo, kde to začíná, se stává nejasným"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor det starter, bliver uklart"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πού ξεκινά γίνεται ασαφές"
          }
        }
      }
    },
    "시트 꼭대기의 작은 회색 선은 화면에서 유일하게 의미 없어 보이는 요소다. 빼면 위쪽이 깔끔해진다. 시트는 원래 끌 수 있는 것이니 사용자도 알아서 끌어 보리라 생각한다. 만드는 사람은 detent가 둘이라는 걸 알기 때문에 선이 없어도 불편을 못 느낀다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The small gray line at the top of the sheet is the only element on the screen that looks meaningless. Remove it and the top looks cleaner. Sheets can be dragged by nature, so you assume users will try dragging on their own. As the builder, you know there are two detents, so you don't feel any inconvenience without the line."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The small grey line at the top of the sheet is the only element on the screen that looks meaningless. Remove it and the top looks cleaner. Sheets can be dragged by nature, so you assume users will try dragging on their own. As the builder, you know there are two detents, so you don't feel any inconvenience without the line."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートのいちばん上の小さなグレーの線は、画面の中で唯一意味がなさそうに見える要素だ。外せば上部がすっきりする。シートはもともとドラッグできるものなので、ユーザーも自分で引っ張ってみるだろうと考える。作る側は detent が2つあると知っているので、線がなくても不便を感じない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层顶部那条灰色小线，是界面里唯一看起来没有意义的元素。去掉它，上方就干净了。弹层本来就能拖，用户自己会试着拖。做的人知道有两个 detent，所以没有这条线也感觉不到不便。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表頂部那條灰色小線，是介面裡唯一看起來沒有意義的元素。去掉它，上方就乾淨了。工作表本來就能拖，使用者自己會試著拖。做的人知道有兩個 detent，所以沒有這條線也感覺不到不便。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маленькая серая линия вверху шторки - единственный элемент на экране, который выглядит бессмысленным. Уберите её, и верх выглядит чище. Шторки по природе перетаскиваются, поэтому вы полагаете, что пользователи сами попробуют потянуть. Вы, как создатель, знаете, что detent два, поэтому без линии неудобства не ощущаете."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pequeña línea gris de lo alto de la hoja es el único elemento de la pantalla que parece no tener sentido. Quítala y la parte superior se ve más limpia. Las hojas se pueden arrastrar por naturaleza, así que supones que los usuarios probarán a arrastrar por su cuenta. Como constructor, sabes que hay dos detents, así que sin la línea no notas inconveniente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kleine graue Linie oben am Sheet ist das einzige Element auf dem Bildschirm, das bedeutungslos aussieht. Entfernt man sie, wirkt die Oberseite sauberer. Sheets lassen sich von Natur aus ziehen, also nimmst du an, Nutzer probieren das selbst. Als Entwickler weißt du, dass es zwei Detents gibt, also spürst du ohne die Linie keine Unannehmlichkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La petite ligne grise en haut de la feuille est le seul élément de l'écran qui paraisse sans signification. Retirez-la et le haut paraît plus propre. Les feuilles se font glisser par nature, donc vous supposez que les utilisateurs essaieront de glisser d'eux-mêmes. En tant que concepteur, vous savez qu'il y a deux detents, donc vous ne ressentez aucune gêne sans la ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La piccola linea grigia in cima al foglio è l'unico elemento della schermata che sembra privo di senso. Toglila e l'alto sembra più pulito. I fogli per natura si possono trascinare, quindi presumi che gli utenti proveranno a trascinare da soli. Da chi costruisce, sai che ci sono due detent, quindi senza la linea non senti alcun disagio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pequena linha cinza no topo da folha é o único elemento da tela que parece sem sentido. Remova e o topo fica mais limpo. As folhas por natureza podem ser arrastadas, então você presume que os usuários tentarão arrastar por conta própria. Como quem constrói, você sabe que há dois detents, então não sente incômodo sem a linha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นสีเทาเล็ก ๆ ที่ด้านบนของชีตเป็นองค์ประกอบเดียวบนหน้าจอที่ดูไร้ความหมาย เอาออก ด้านบนก็ดูสะอาดขึ้น ชีตลากได้โดยธรรมชาติ คุณจึงสมมติว่าผู้ใช้จะลองลากเอง ในฐานะผู้สร้าง คุณรู้ว่ามีสอง detent จึงไม่รู้สึกไม่สะดวกเมื่อไม่มีเส้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đường xám nhỏ ở đầu sheet là phần tử duy nhất trên màn hình trông vô nghĩa. Bỏ nó thì phần trên gọn hơn. Sheet vốn kéo được, nên bạn cho rằng người dùng sẽ tự thử kéo. Là người xây, bạn biết có hai detent, nên không thấy bất tiện khi thiếu đường đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malá šedá čára nahoře na sheetu je jediný prvek na obrazovce, který vypadá bezvýznamně. Odstraňte ji a horní část vypadá čistěji. Sheety jsou ze své podstaty táhnutelné, takže předpokládáte, že uživatelé zkusí tažení sami. Jako tvůrce víte, že jsou dva detenty, takže bez čáry necítíte žádné nepohodlí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lille grå streg øverst på arket er det eneste element på skærmen, der ser meningsløst ud. Fjern den, og toppen ser renere ud. Ark kan trækkes af natur, så du antager, at brugerne selv prøver at trække. Som bygger ved du, at der er to detents, så du mærker ingen ulejlighed uden stregen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μικρή γκρι γραμμή στην κορυφή του φύλλου είναι το μόνο στοιχείο στην οθόνη που φαίνεται χωρίς νόημα. Αφαίρεσέ την και η κορυφή φαίνεται καθαρότερη. Τα φύλλα σέρνονται από τη φύση τους, οπότε υποθέτεις ότι οι χρήστες θα δοκιμάσουν να σύρουν μόνοι τους. Ως δημιουργός, ξέρεις ότι υπάρχουν δύο detents, οπότε δεν νιώθεις καμία ταλαιπωρία χωρίς τη γραμμή."
          }
        }
      }
    },
    "시트 내용이 **탭한 요소의 확장**일 때, 카드를 탭해 그 카드의 상세 시트가 열리는 구조.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the sheet's content is **an expansion of the tapped element**: you tap a card and that card's detail sheet opens."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the sheet's content is **an expansion of the tapped element**: you tap a card and that card's detail sheet opens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートの内容が**タップした要素の拡張**であるとき。カードをタップすると、そのカードの詳細シートが開く構造。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当弹层内容是**被点按元素的延伸**时：点按一张卡片，打开该卡片的详情弹层的结构。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當工作表內容是**被輕點元素的延伸**時：輕點一張卡片，開啟該卡片的詳情工作表的結構。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда содержимое шторки - **продолжение нажатого элемента**: вы нажимаете карточку, и открывается шторка с подробностями этой карточки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el contenido de la hoja es **una expansión del elemento tocado**: tocas una tarjeta y se abre la hoja de detalle de esa tarjeta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Inhalt des Sheets **eine Erweiterung des angetippten Elements** ist: Du tippst eine Karte an, und das Detail-Sheet dieser Karte öffnet sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le contenu de la feuille est **un prolongement de l'élément touché** : vous touchez une carte et la feuille de détail de cette carte s'ouvre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il contenuto del foglio è **un'espansione dell'elemento toccato**: tocchi una scheda e si apre il foglio di dettaglio di quella scheda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o conteúdo da folha é **uma expansão do elemento tocado**: você toca num cartão e abre a folha de detalhe daquele cartão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเนื้อหาของชีตเป็น**การขยายของสิ่งที่แตะ**: คุณแตะการ์ด แล้วชีตรายละเอียดของการ์ดนั้นเปิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi nội dung sheet là **sự mở rộng của phần tử vừa chạm**: bạn chạm một thẻ và sheet chi tiết của thẻ đó mở ra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je obsah sheetu **rozšířením klepnutého prvku**: klepnete na kartu a otevře se detailní sheet té karty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når arkets indhold er **en udvidelse af det element, der blev trykket på**: du trykker på et kort, og det korts detaljeark åbner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το περιεχόμενο του φύλλου είναι **επέκταση του στοιχείου που πατήθηκε**: πατάς μια κάρτα και ανοίγει το φύλλο λεπτομερειών εκείνης της κάρτας."
          }
        }
      }
    },
    "시트 높이는 가벼워 보이는 쪽이 아니라 **내용이 정하는 쪽**을 따른다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet's height follows **what the content dictates**, not what looks lighter."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet's height follows **what the content dictates**, not what looks lighter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートの高さは、軽く見えるほうではなく**内容が決めるほう**に従う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层高度不是看起来轻不轻，而是要听**内容的**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表高度不是看起來輕不輕，而是要聽**內容的**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высота шторки определяется **тем, чего требует содержимое**, а не тем, что выглядит легче."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La altura de una hoja la dicta **lo que exige el contenido**, no lo que parece más ligero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Höhe eines Sheets folgt dem, **was der Inhalt verlangt**, nicht dem, was leichter aussieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La hauteur d'une feuille suit **ce que dicte le contenu**, pas ce qui paraît plus léger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'altezza di un foglio segue **ciò che detta il contenuto**, non ciò che sembra più leggero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A altura de uma folha segue **o que o conteúdo dita**, não o que parece mais leve."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความสูงของชีตตาม**สิ่งที่เนื้อหากำหนด** ไม่ใช่สิ่งที่ดูเบากว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiều cao sheet theo **điều nội dung đòi hỏi**, không theo điều trông nhẹ hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výška sheetu se řídí **tím, co obsah vyžaduje**, ne tím, co vypadá lehčeji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et arks højde følger **det, indholdet dikterer**, ikke det, der ser lettere ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ύψος ενός φύλλου ακολουθεί **αυτό που υπαγορεύει το περιεχόμενο**, όχι αυτό που φαίνεται ελαφρύτερο."
          }
        }
      }
    },
    "시트 높이는 콘텐츠가 결정해야 합니다, medium에 작은 콘텐츠를 넣으면 **잉여 공백이 “뭔가 더 있나?”라는 오독**을 만듭니다. 다만 자유 높이는 일관성을 해치므로, detent 시스템 안에서 커스텀을 허용하는 절충 설계.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content should decide the sheet's height. Put small content in a medium sheet and **the extra white space gets misread as \"Is there more?\"** Free-form heights would hurt consistency, though, so the design compromises by allowing custom values within the detent system."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The content should decide the sheet's height. Put small content in a medium sheet and **the extra white space gets misread as \"Is there more?\"** Free-form heights would hurt consistency, though, so the design compromises by allowing custom values within the detent system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートの高さはコンテンツが決めるべきです。mediumに小さなコンテンツを入れると、**余った空白が「まだ何かあるの？」という誤読**を生みます。ただし自由な高さは一貫性を損なうので、デタントのシステムの中でカスタムを許す折衷的な設計。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层高度应由内容决定。把小内容放进 medium，**多余的空白会造成“还有别的吧？”的误读**。不过自由高度会损害一致性，所以这是在 detent 体系内允许自定义的折中设计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表高度應由內容決定。把小內容放進 medium，**多餘的空白會造成「還有別的吧？」的誤讀**。不過自由高度會損害一致性，所以這是在 detent 體系內允許自定義的折中設計。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высоту шторки должно определять содержимое. Положите маленькое содержимое в шторку medium, и **лишнее белое пространство прочтут как «а там есть ещё?»** Свободные высоты, правда, вредили бы единообразию, поэтому решение-компромисс допускает пользовательские значения внутри системы detent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido debería decidir la altura de la hoja. Pon contenido pequeño en una hoja medium y **el espacio en blanco sobrante se malinterpreta como «¿hay más?»** Las alturas libres dañarían la coherencia, sin embargo, así que el diseño llega a un compromiso permitiendo valores personalizados dentro del sistema de detents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt sollte die Höhe des Sheets bestimmen. Setzt man kleinen Inhalt in ein medium-Sheet, **wird der überschüssige Leerraum als „Gibt es noch mehr?“ missverstanden**. Freie Höhen würden aber der Konsistenz schaden, also kompromittiert das Design, indem es eigene Werte innerhalb des Detent-Systems erlaubt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu devrait décider de la hauteur de la feuille. Mettez un petit contenu dans une feuille medium et **le surplus de blanc est mal interprété comme « Y en a-t-il plus ? »** Des hauteurs libres nuiraient toutefois à la cohérence, donc le design transige en permettant des valeurs personnalisées au sein du système de detents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovrebbe essere il contenuto a decidere l'altezza del foglio. Metti un contenuto piccolo in un foglio medium e **lo spazio bianco in più viene scambiato per «c'è dell'altro?»** Altezze libere danneggerebbero però la coerenza, quindi il design arriva a un compromesso consentendo valori personalizzati dentro il sistema dei detent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo deve decidir a altura da folha. Ponha um conteúdo pequeno numa folha medium e **o espaço em branco extra é lido errado como «tem mais?»** Alturas livres prejudicariam a consistência, porém, então o design chega a um meio-termo permitindo valores personalizados dentro do sistema de detents."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาควรเป็นตัวกำหนดความสูงของชีต ใส่เนื้อหาเล็กในชีต medium แล้ว**ที่ว่างสีขาวส่วนเกินถูกอ่านผิดเป็น \"ยังมีอีกไหม\"** ความสูงอิสระจะทำร้ายความสอดคล้อง การออกแบบจึงประนีประนอมด้วยการอนุญาตค่ากำหนดเองภายในระบบ detent"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung nên quyết chiều cao sheet. Đặt nội dung nhỏ vào sheet medium và **khoảng trắng thừa bị hiểu nhầm là \"Còn nữa không?\"** Chiều cao tự do thì hại tính nhất quán, nên thiết kế dung hòa bằng cách cho phép giá trị tùy chỉnh trong hệ detent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O výšce sheetu by měl rozhodovat obsah. Dejte malý obsah do sheetu medium a **přebytečné bílé místo se špatně čte jako „Je tam víc?“** Volné výšky by ale poškodily konzistenci, takže design dělá kompromis tím, že v systému detentů dovoluje vlastní hodnoty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indholdet bør afgøre arkets højde. Læg lille indhold i et medium-ark, og **den ekstra hvide plads bliver misforstået som »Er der mere?«** Frie højder ville dog skade ensartetheden, så designet går på kompromis ved at tillade brugerdefinerede værdier inden for detent-systemet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιεχόμενο πρέπει να αποφασίζει το ύψος του φύλλου. Βάλε μικρό περιεχόμενο σε medium φύλλο και **ο επιπλέον λευκός χώρος παρερμηνεύεται ως «Υπάρχει κι άλλο;»** Τα ελεύθερα ύψη όμως θα έβλαπταν τη συνέπεια, οπότε ο σχεδιασμός κάνει συμβιβασμό επιτρέποντας προσαρμοσμένες τιμές μέσα στο σύστημα detents."
          }
        }
      }
    },
    "시트 높이를 정할 때 **\"시트 뒤에 있는 것이 이 작업의 재료인가\"**를 묻는다. 재료라면 덮지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When deciding a sheet's height, ask **\"Is what's behind the sheet the material for this task?\"** If it is, don't cover it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When deciding a sheet's height, ask **\"Is what's behind the sheet the material for this task?\"** If it is, don't cover it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートの高さを決めるときは、**「シートの後ろにあるものは、この作業の材料か**」を問う。材料なら覆わない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定弹层高度时问**“弹层后面的东西，是这项任务的材料吗？”**是材料，就不要盖住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定工作表高度時問**「工作表後面的東西，是這項任務的材料嗎？」**是材料，就不要蓋住。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяя высоту шторки, спросите **«То, что позади шторки, - это материал для данной задачи?»** Если да, не закрывайте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al decidir la altura de una hoja, pregunta **«¿Lo que hay detrás de la hoja es el material de esta tarea?»** Si lo es, no lo tapes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage bei der Wahl der Sheet-Höhe: **„Ist das, was hinter dem Sheet liegt, das Material für diese Aufgabe?“** Wenn ja, decke es nicht ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour décider de la hauteur d'une feuille, demandez **« Ce qui est derrière la feuille est-il la matière de cette tâche ? »** Si oui, ne le recouvrez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando decidi l'altezza di un foglio, chiediti **«Ciò che sta dietro il foglio è il materiale per questo compito?»** Se lo è, non coprirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao decidir a altura de uma folha, pergunte **«O que está atrás da folha é o material desta tarefa?»** Se é, não cubra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อตัดสินความสูงของชีต ให้ถาม **\"สิ่งที่อยู่หลังชีตเป็นวัตถุดิบของงานนี้หรือไม่\"** ถ้าใช่ อย่าคลุม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi quyết chiều cao sheet, hãy hỏi **\"Thứ phía sau sheet có phải nguyên liệu cho tác vụ này không?\"** Nếu có, đừng che nó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když rozhodujete o výšce sheetu, zeptejte se **„Je to, co je za sheetem, materiálem pro tento úkol?“** Pokud ano, nezakrývejte to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du beslutter et arks højde, så spørg **»Er det, der ligger bag arket, materialet til denne opgave?«** Hvis det er, så dæk det ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν αποφασίζεις το ύψος ενός φύλλου, ρώτα **«Είναι αυτό που βρίσκεται πίσω από το φύλλο το υλικό για αυτή την εργασία;»** Αν είναι, μην το καλύπτεις."
          }
        }
      }
    },
    "시트가 **도구 팔레트** 역할일 때, 지도를 계속 움직이면서 결과 시트 유지, 본문을 스크롤하면서 서식 패널 사용.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the sheet acts as a **tool palette**: keeping a results sheet open while you keep panning the map, or using a formatting panel while you scroll through the document."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the sheet acts as a **tool palette**: keeping a results sheet open while you keep panning the map, or using a formatting panel while you scroll through the document."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートが**ツールパレット**の役割を果たすとき。地図を動かし続けながら結果のシートを開いたままにする、本文をスクロールしながら書式パネルを使う、など。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当弹层充当**工具调色板**时：一边不停地移动地图，一边保持结果弹层；一边滚动正文，一边使用格式面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當工作表充當**工具調色盤**時：一邊不停地移動地圖，一邊保持結果工作表；一邊滾動正文，一邊使用格式面板。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда шторка выступает **палитрой инструментов**: держать шторку с результатами открытой, пока вы продолжаете двигать карту, или пользоваться панелью форматирования, пока прокручиваете документ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la hoja actúa como **paleta de herramientas**: mantener abierta una hoja de resultados mientras sigues moviendo el mapa, o usar un panel de formato mientras te desplazas por el documento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Sheet als **Werkzeugpalette** dient: ein Ergebnis-Sheet offen halten, während du die Karte weiter verschiebst, oder ein Formatierungspanel nutzen, während du durch das Dokument scrollst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la feuille sert de **palette d'outils** : garder une feuille de résultats ouverte pendant que vous continuez à déplacer la carte, ou utiliser un panneau de mise en forme en faisant défiler le document."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il foglio funge da **tavolozza di strumenti**: tenere aperto un foglio dei risultati mentre continui a spostare la mappa, o usare un pannello di formattazione mentre scorri il documento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a folha funciona como **paleta de ferramentas**: manter uma folha de resultados aberta enquanto você continua movendo o mapa, ou usar um painel de formatação enquanto rola o documento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อชีตทำหน้าที่เป็น**จานเครื่องมือ**: คงชีตผลลัพธ์เปิดไว้ขณะแพนแผนที่ต่อ หรือใช้แผงจัดรูปแบบขณะเลื่อนผ่านเอกสาร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi sheet đóng vai **bảng công cụ**: giữ sheet kết quả mở trong lúc bạn tiếp tục kéo bản đồ, hoặc dùng bảng định dạng khi cuộn qua tài liệu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když sheet působí jako **paleta nástrojů**: nechat sheet s výsledky otevřený, zatímco dál posouváte mapu, nebo použít formátovací panel při posouvání dokumentem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når arket fungerer som en **værktøjspalet**: at holde et resultatark åbent, mens du bliver ved med at panorere kortet, eller bruge et formateringspanel, mens du scroller gennem dokumentet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το φύλλο λειτουργεί ως **παλέτα εργαλείων**: κρατώντας ένα φύλλο αποτελεσμάτων ανοιχτό ενώ συνεχίζεις να μετακινείς τον χάρτη, ή χρησιμοποιώντας ένα πάνελ μορφοποίησης ενώ κυλάς στο έγγραφο."
          }
        }
      }
    },
    "시트가 화면을 다 덮지 않는 쪽이 가벼워 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet that doesn't cover the whole screen feels lighter."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet that doesn't cover the whole screen feels lighter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を全部覆わないシートのほうが軽く見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层不盖满整个界面，看起来更轻盈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表不蓋滿整個介面，看起來更輕盈。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шторка, не закрывающая весь экран, ощущается легче."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja que no cubre toda la pantalla se siente más ligera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sheet, das nicht den ganzen Bildschirm abdeckt, wirkt leichter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une feuille qui ne recouvre pas tout l'écran paraît plus légère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un foglio che non copre l'intero schermo sembra più leggero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma folha que não cobre a tela inteira parece mais leve."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีตที่ไม่คลุมทั้งหน้าจอรู้สึกเบากว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet không phủ cả màn hình cảm giác nhẹ hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet, který nezakrývá celou obrazovku, působí lehčeji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ark, der ikke dækker hele skærmen, føles lettere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα φύλλο που δεν καλύπτει ολόκληρη την οθόνη νιώθεται ελαφρύτερο."
          }
        }
      }
    },
    "시트는 **“임시 컨텍스트 전환”**의 장치, large는 사실상 새 화면이지만, 뒤가 살짝 보이는 스택 은유로 “끝나면 원래 화면으로 돌아간다”는 감각을 유지합니다. 영구 이동인 push와 구분되는 이유가 이 은유.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet is a device for **\"a temporary context switch.\"** Large is effectively a new screen, but the stacked metaphor, with the screen behind just peeking out, keeps the sense that \"when I'm done, I'll go back to where I was.\" That metaphor is what sets it apart from push, which is a permanent move."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet is a device for **\"a temporary context switch.\"** Large is effectively a new screen, but the stacked metaphor, with the screen behind just peeking out, keeps the sense that \"when I'm done, I'll go back to where I was.\" That metaphor is what sets it apart from push, which is a permanent move."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートは「**一時的な文脈の切り替え**」のための装置。largeは実質的に新しい画面だが、背後が少し見えるスタックの比喩によって「終われば元の画面に戻る」という感覚を保ちます。恒久的な移動であるpushと区別される理由が、この比喩。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层是**“临时切换上下文”**的装置。large 实际上是新界面，但靠后面隐约可见的堆叠隐喻，保持“结束后回到原界面”的感觉。这个隐喻就是它与永久移动的 push 的区别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表是**「臨時切換上下文」**的裝置。large 實際上是新介面，但靠後面隱約可見的堆疊隱喻，保持「結束後回到原介面」的感覺。這個隱喻就是它與永久移動的 push 的區別。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шторка - средство для **«временного переключения контекста»**. Large по сути новый экран, но метафора стопки, когда экран позади лишь выглядывает, сохраняет ощущение «закончу - вернусь туда, где был». Эта метафора и отличает её от push, постоянного перехода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja es un recurso para **«un cambio temporal de contexto».** Large es en la práctica una pantalla nueva, pero la metáfora apilada, con la pantalla de detrás asomando apenas, conserva la sensación de que «cuando termine, volveré a donde estaba». Esa metáfora es lo que la distingue de push, que es un movimiento permanente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sheet ist ein Mittel für **„einen vorübergehenden Kontextwechsel“.** Large ist praktisch ein neuer Bildschirm, aber die gestapelte Metapher, bei der der Bildschirm dahinter nur hervorlugt, bewahrt das Gefühl, dass „ich nach dem Fertigwerden dorthin zurückkehre, wo ich war“. Diese Metapher unterscheidet es von Push, einem dauerhaften Wechsel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une feuille est un dispositif pour **« un changement de contexte temporaire ».** Large est en pratique un nouvel écran, mais la métaphore empilée, avec l'écran derrière qui dépasse à peine, garde le sentiment que « quand j'aurai fini, je reviendrai là où j'étais ». Cette métaphore la distingue du push, qui est un déplacement permanent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un foglio è un dispositivo per **«un cambio di contesto temporaneo».** Large è di fatto una nuova schermata, ma la metafora impilata, con la schermata dietro che fa solo capolino, mantiene la sensazione che «quando avrò finito, tornerò dove ero». Quella metafora è ciò che lo distingue dal push, che è uno spostamento permanente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma folha é um dispositivo para **«uma troca temporária de contexto».** Large é na prática uma nova tela, mas a metáfora empilhada, com a tela de trás só espiando, mantém a sensação de que «quando eu terminar, volto para onde estava». Essa metáfora é o que a distingue do push, que é uma mudança permanente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีตคือกลไกสำหรับ**\"การสลับบริบทชั่วคราว\"** Large แทบเป็นหน้าจอใหม่ แต่อุปมาการซ้อน ที่หน้าจอด้านหลังโผล่ให้เห็นนิดเดียว คงความรู้สึกว่า \"พอเสร็จ ฉันจะกลับไปที่เดิม\" อุปมานั้นคือสิ่งที่แยกมันจาก push ซึ่งเป็นการย้ายถาวร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet là thiết bị cho **\"một chuyển ngữ cảnh tạm thời.\"** Large thực chất là màn hình mới, nhưng ẩn dụ xếp chồng, với màn hình phía sau chỉ ló ra, giữ cảm giác \"xong thì tôi sẽ quay về chỗ cũ.\" Ẩn dụ đó khiến nó khác với push, một lần chuyển vĩnh viễn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet je nástroj pro **„dočasné přepnutí kontextu.“** Large je prakticky nová obrazovka, ale metafora zásobníku, kdy obrazovka za ním jen vykukuje, drží pocit, že „až skončím, vrátím se tam, kde jsem byl“. Ta metafora ho odlišuje od push, což je trvalý přesun."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ark er en mekanisme til **»et midlertidigt kontekstskifte.«** Large er reelt en ny skærm, men den stablede metafor, hvor skærmen bagved lige titter frem, bevarer fornemmelsen af, at »når jeg er færdig, går jeg tilbage til, hvor jeg var.« Den metafor er det, der adskiller det fra push, som er et permanent skift."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα φύλλο είναι μηχανισμός για **«μια προσωρινή αλλαγή πλαισίου».** Το Large είναι ουσιαστικά νέα οθόνη, αλλά η στοιβαγμένη μεταφορά, με την οθόνη πίσω να κρυφοκοιτάζει, κρατά την αίσθηση ότι «όταν τελειώσω, θα γυρίσω εκεί που ήμουν». Αυτή η μεταφορά το ξεχωρίζει από το push, που είναι μόνιμη μετάβαση."
          }
        }
      }
    },
    "시트는 집중을 위한 것이니 다 덮는 게 맞다고 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You see sheets as tools for focus, so covering everything seems right."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You see sheets as tools for focus, so covering everything seems right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートは集中のためのものなので、全部覆うのが正しいと考える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "觉得弹层是为专注准备的，所以盖满才对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覺得工作表是為專注準備的，所以蓋滿才對。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы видите в шторках средство для сосредоточения, поэтому закрыть всё кажется верным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ves las hojas como herramientas de concentración, así que cubrirlo todo parece correcto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst Sheets als Werkzeuge für Fokus, also scheint es richtig, alles abzudecken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voyez les feuilles comme des outils de concentration, donc tout recouvrir semble juste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi i fogli come strumenti per concentrarsi, quindi coprire tutto sembra giusto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vê as folhas como ferramentas de foco, então cobrir tudo parece certo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณมองชีตเป็นเครื่องมือเพื่อโฟกัส การคลุมทุกอย่างจึงดูถูกต้อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn coi sheet là công cụ để tập trung nên che hết có vẻ đúng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheety vidíte jako nástroje pro soustředění, takže zakrýt všechno se zdá správné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ser ark som værktøjer til fokus, så det virker rigtigt at dække alt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βλέπεις τα φύλλα ως εργαλεία εστίασης, οπότε το να καλύψεις τα πάντα φαίνεται σωστό."
          }
        }
      }
    },
    "시트는 집중을 위한 장치이니, 다 덮어야 사용자가 지금 할 일에만 집중할 수 있다고 본다. 반쯤 열린 시트는 어정쩡해 보이고, 뒤 화면이 보이면 산만할 것 같다. 기본값이 large 이니 그대로 두는 것이 가장 무난해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet is a tool for focus, so you think it has to cover everything for users to focus only on what they're doing now. A half-open sheet looks half-hearted, and seeing the screen behind seems distracting. The default is large, so leaving it as is seems the safest bet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet is a tool for focus, so you think it has to cover everything for users to focus only on what they're doing now. A half-open sheet looks half-hearted, and seeing the screen behind seems distracting. The default is large, so leaving it as is seems the safest bet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートは集中のための仕組みなので、全部覆ってこそユーザーが今やることだけに集中できると考える。半分だけ開いたシートは中途半端に見え、後ろの画面が見えると気が散りそうだ。デフォルトが large なので、そのままにするのが最も無難に見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "觉得弹层是帮助专注的装置，盖满了用户才能只专注于眼前要做的事。半开的弹层看起来半吊子，后面的界面看得见又会分心。默认值是 large，保持不动似乎最稳妥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覺得工作表是幫助專注的裝置，蓋滿了使用者才能只專注於眼前要做的事。半開的工作表看起來半吊子，後面的介面看得見又會分心。預設值是 large，保持不動似乎最穩妥。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шторка - средство для сосредоточения, поэтому вы думаете, что она должна закрывать всё, чтобы пользователи могли сосредоточиться только на том, что делают сейчас. Полуоткрытая шторка выглядит недоделанной, а экран позади отвлекает. По умолчанию large, так что оставить как есть кажется самым надёжным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja es una herramienta de concentración, así que piensas que tiene que cubrirlo todo para que los usuarios se concentren solo en lo que hacen ahora. Una hoja a medio abrir parece a medias, y ver la pantalla de detrás parece distraer. El valor por defecto es large, así que dejarlo como está parece la apuesta más segura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sheet ist ein Werkzeug für Fokus, also denkst du, es müsse alles abdecken, damit Nutzer sich nur auf das konzentrieren, was sie gerade tun. Ein halb geöffnetes Sheet wirkt halbherzig, und den Bildschirm dahinter zu sehen scheint abzulenken. Der Standard ist large, also scheint es am sichersten, ihn zu belassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une feuille est un outil de concentration, donc vous pensez qu'elle doit tout recouvrir pour que les utilisateurs ne se concentrent que sur ce qu'ils font maintenant. Une feuille à moitié ouverte paraît timide, et voir l'écran derrière semble distrayant. La valeur par défaut est large, donc la laisser telle quelle paraît le pari le plus sûr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un foglio è uno strumento per concentrarsi, quindi pensi che debba coprire tutto perché gli utenti si concentrino solo su ciò che fanno adesso. Un foglio mezzo aperto sembra tiepido, e vedere la schermata dietro sembra una distrazione. Il predefinito è large, quindi lasciarlo così sembra la scommessa più sicura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma folha é uma ferramenta de foco, então você acha que ela tem de cobrir tudo para os usuários se concentrarem só no que fazem agora. Uma folha meio aberta parece sem convicção, e ver a tela de trás parece distração. O padrão é large, então deixar como está parece a aposta mais segura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีตเป็นเครื่องมือเพื่อโฟกัส คุณจึงคิดว่ามันต้องคลุมทุกอย่างเพื่อให้ผู้ใช้โฟกัสเฉพาะสิ่งที่ทำอยู่ ชีตที่เปิดครึ่งเดียวดูไม่เต็มใจ และการเห็นหน้าจอด้านหลังดูเป็นสิ่งรบกวน ค่าเริ่มต้นคือ large ปล่อยไว้ตามเดิมจึงดูเป็นการเดิมพันที่ปลอดภัยที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet là công cụ để tập trung, nên bạn nghĩ nó phải che hết để người dùng chỉ tập trung vào việc đang làm. Sheet mở nửa trông nửa vời, và nhìn thấy màn hình phía sau có vẻ gây xao nhãng. Mặc định là large, nên để nguyên có vẻ là cược an toàn nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet je nástroj pro soustředění, takže si myslíte, že musí zakrýt všechno, aby se uživatelé soustředili jen na to, co teď dělají. Napůl otevřený sheet vypadá nedůsledně a vidět obrazovku za ním se zdá rušivé. Výchozí je large, takže jeho ponechání se zdá nejbezpečnější sázkou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ark er et værktøj til fokus, så du tror, at det må dække alt, for at brugerne kun fokuserer på det, de gør nu. Et halvt åbent ark ser halvhjertet ud, og at se skærmen bagved virker distraherende. Standarden er large, så at lade den være virker som det sikreste bud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα φύλλο είναι εργαλείο εστίασης, οπότε νομίζεις ότι πρέπει να καλύπτει τα πάντα ώστε οι χρήστες να εστιάζουν μόνο σε ό,τι κάνουν τώρα. Ένα μισάνοιχτο φύλλο φαίνεται μισερό, και το να βλέπεις την οθόνη πίσω φαίνεται αποσπαστικό. Η προεπιλογή είναι large, οπότε το να την αφήσεις φαίνεται το ασφαλέστερο στοίχημα."
          }
        }
      }
    },
    "시트를 띄울 때 기본값을 받아들이기 전에 **\"이 작업은 뒤 화면을 떠나는 일인가\"**를 묻는다. 아니라면 전부 덮지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before accepting the default when presenting a sheet, ask **\"Does this task mean leaving the screen behind?\"** If not, don't cover all of it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before accepting the default when presenting a sheet, ask **\"Does this task mean leaving the screen behind?\"** If not, don't cover all of it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートを表示するとき、デフォルトを受け入れる前に「**この作業は後ろの画面を離れることなのか**」を問う。そうでなければ、全部を覆わない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹出弹层时，接受默认值之前先问**“这项任务是要离开后面的界面吗？”**不是的话，就不要全部盖住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "彈出工作表時，接受預設值之前先問**「這項任務是要離開後面的介面嗎？」**不是的話，就不要全部蓋住。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем принять значение по умолчанию при показе шторки, спросите **«Означает ли эта задача уход с экрана позади?»** Если нет, не закрывайте его целиком."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de aceptar el valor por defecto al presentar una hoja, pregunta **«¿Esta tarea implica dejar la pantalla de detrás?»** Si no, no la cubras entera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage, bevor du beim Präsentieren eines Sheets den Standard akzeptierst: **„Bedeutet diese Aufgabe, den Bildschirm dahinter zu verlassen?“** Wenn nicht, decke nicht alles ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'accepter le réglage par défaut en présentant une feuille, demandez **« Cette tâche implique-t-elle de quitter l'écran derrière ? »** Sinon, ne le recouvrez pas entièrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di accettare il predefinito quando presenti un foglio, chiediti **«Questo compito richiede di lasciare la schermata dietro?»** Se no, non coprirla tutta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de aceitar o padrão ao apresentar uma folha, pergunte **«Esta tarefa significa deixar a tela de trás?»** Se não, não cubra toda ela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนยอมรับค่าเริ่มต้นเมื่อแสดงชีต ให้ถาม **\"งานนี้หมายถึงการออกจากหน้าจอด้านหลังหรือไม่\"** ถ้าไม่ อย่าคลุมทั้งหมด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi chấp nhận mặc định khi hiện sheet, hãy hỏi **\"Tác vụ này có nghĩa là rời màn hình phía sau không?\"** Nếu không, đừng che hết."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než přijmete výchozí při zobrazení sheetu, zeptejte se **„Znamená tento úkol opuštění obrazovky za ním?“** Pokud ne, nezakrývejte všechno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du accepterer standarden, når du viser et ark, så spørg **»Betyder denne opgave, at man forlader skærmen bagved?«** Hvis ikke, så dæk ikke det hele."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν δεχτείς την προεπιλογή όταν παρουσιάζεις ένα φύλλο, ρώτα **«Σημαίνει αυτή η εργασία ότι φεύγουμε από την οθόνη πίσω;»** Αν όχι, μην καλύψεις όλη."
          }
        }
      }
    },
    "시트를 만들 때 기본값이 large라 그대로 둔다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you create a sheet, the default is large, so you leave it that way."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you create a sheet, the default is large, so you leave it that way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートを作るとデフォルトが large なので、そのままにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做弹层时默认是 large，所以就那样放着。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做工作表時預設是 large，所以就那樣放著。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавая шторку, вы видите, что по умолчанию large, и оставляете так."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando creas una hoja, el valor por defecto es large, así que lo dejas así."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Sheet erstellst, ist der Standard large, also lässt du es dabei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous créez une feuille, la valeur par défaut est large, donc vous la laissez ainsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando crei un foglio, il predefinito è large, quindi lo lasci così."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você cria uma folha, o padrão é large, então deixa assim."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อสร้างชีต ค่าเริ่มต้นคือ large คุณจึงปล่อยไว้แบบนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tạo sheet, mặc định là large nên bạn để vậy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když vytvoříte sheet, výchozí je large, takže to tak necháte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du opretter et ark, er standarden large, så du lader det være."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν δημιουργείς ένα φύλλο, η προεπιλογή είναι large, οπότε την αφήνεις έτσι."
          }
        }
      }
    },
    "시트마다 커스텀 슬라이드 방향을 달리함": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Varying the custom slide direction from sheet to sheet"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Varying the custom slide direction from sheet to sheet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートごとにカスタムのスライド方向を変える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个弹层的自定义滑动方向各不相同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個工作表的自定義滑動方向各不相同"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разное направление пользовательского выезда у разных шторок"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Variar la dirección de deslizamiento personalizada de una hoja a otra"
          }
        },
        "de": {
          "stringUnit": {
