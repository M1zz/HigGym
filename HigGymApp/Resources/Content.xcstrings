        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางการกระทำที่ใช้บ่อยที่สุดไว้มุมบนและปล่อยด้านล่างว่าง"
          }
        },
        "vi": {
          "stringUnit": {
