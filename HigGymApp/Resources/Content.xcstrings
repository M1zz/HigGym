    "4~5번째 탭이 “기타/더보기”가 되고 있다면 정보 구조를 다시 그려야 한다는 신호입니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your fourth or fifth tab is turning into \"Other\" or \"More,\" that's a sign you need to redraw your information architecture."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If your fourth or fifth tab is turning into \"Other\" or \"More,\" that's a sign you need to redraw your information architecture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4つ目や5つ目のタブが「その他」「もっと見る」になりつつあるなら、情報構造を描き直すべきサインです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果第 4、5 个标签变成了“其他 / 更多”，就说明该重画信息结构了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果第 4、5 個標籤變成了「其他 / 更多」，就說明該重畫資訊結構了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если четвёртая или пятая вкладка превращается в «Другое» или «Ещё», это признак того, что нужно перерисовать информационную архитектуру."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu cuarta o quinta pestaña se está convirtiendo en «Otros» o «Más», es señal de que tienes que redibujar tu arquitectura de la información."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird dein vierter oder fünfter Tab zu „Sonstiges“ oder „Mehr“, ist das ein Zeichen, dass du deine Informationsarchitektur neu zeichnen musst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre quatrième ou cinquième onglet devient « Autre » ou « Plus », c'est le signe qu'il faut redessiner votre architecture de l'information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la tua quarta o quinta scheda sta diventando «Altro» o «Di più», è un segno che devi ridisegnare l'architettura dell'informazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sua quarta ou quinta aba está virando «Outros» ou «Mais», é sinal de que você precisa redesenhar sua arquitetura da informação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าแท็บที่สี่หรือห้าของคุณกลายเป็น \"อื่น ๆ\" หรือ \"เพิ่มเติม\" นั่นเป็นสัญญาณว่าต้องวาดสถาปัตยกรรมข้อมูลใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu tab thứ tư hoặc thứ năm của bạn đang thành \"Khác\" hay \"Thêm\", đó là dấu hiệu bạn cần vẽ lại kiến trúc thông tin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se vaše čtvrtá nebo pátá karta mění na „Ostatní“ nebo „Více“, je to znamení, že musíte překreslit informační architekturu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis din fjerde eller femte fane er ved at blive til »Andet« eller »Mere«, er det et tegn på, at du skal tegne din informationsarkitektur om."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν η τέταρτη ή πέμπτη καρτέλα σου μετατρέπεται σε «Άλλα» ή «Περισσότερα», είναι σημάδι ότι πρέπει να ξανασχεδιάσεις την αρχιτεκτονική πληροφορίας σου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos neljännestä tai viidennestä välilehdestäsi on tulossa ”Muu” tai ”Lisää”, se on merkki siitä, että sinun täytyy piirtää tietoarkkitehtuurisi uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tab keempat atau kelimamu berubah menjadi \"Lainnya\" atau \"Selengkapnya,\" itu tanda kamu perlu menggambar ulang arsitektur informasimu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis din fjerde eller femte fane blir til «Annet» eller «Mer», er det et tegn på at du må tegne informasjonsarkitekturen din på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je vierde of vijfde tabblad \"Overig\" of \"Meer\" wordt, is dat een teken dat je je informatiearchitectuur opnieuw moet tekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli twoja czwarta lub piąta karta zamienia się w „Inne” lub „Więcej”, to znak, że trzeba przerysować architekturę informacji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om din fjärde eller femte flik håller på att bli ”Övrigt” eller ”Mer” är det ett tecken på att du behöver rita om din informationsarkitektur."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dördüncü ya da beşinci sekmen “Diğer” ya da “Daha Fazla”ya dönüşüyorsa bilgi mimarini yeniden çizmen gerektiğinin işaretidir."
          }
        }
      }
    },
    "5개 전부 노출을 강제하려고 커스텀 내비바를 직접 구현": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand-building a custom navigation bar to force all five to stay visible"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand-building a custom navigation bar to force all five to stay visible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5つすべてを無理に表示させようと、カスタムのナビゲーションバーを自前で実装"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了强制 5 个全部显示，自己实现自定义导航栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了強制 5 個全部顯示，自己實作自定義導覽列"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самому собрать пользовательскую панель навигации, чтобы заставить все пять оставаться видимыми"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construir a mano una barra de navegación personalizada para forzar que los cinco sigan visibles"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine eigene Navigationsleiste von Hand bauen, um zu erzwingen, dass alle fünf sichtbar bleiben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construire à la main une barre de navigation personnalisée pour forcer les cinq à rester visibles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruire a mano una barra di navigazione personalizzata per forzare tutte e cinque a restare visibili"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Construir à mão uma barra de navegação personalizada para forçar as cinco a ficarem visíveis"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างแถบนำทางที่กำหนดเองด้วยมือเพื่อบังคับให้ทั้งห้าอันมองเห็นอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự tay xây một thanh điều hướng tùy chỉnh để ép cả năm mục luôn hiển thị"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruční stavba vlastního navigačního panelu, aby všech pět zůstalo viditelných"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At håndbygge en brugerdefineret navigationsbjælke for at tvinge alle fem til at forblive synlige"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χειροποίητη προσαρμοσμένη γραμμή πλοήγησης για να μένουν και τα πέντε ορατά με το ζόρι"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukautetun navigointipalkin käsin rakentaminen pakottaaksesi kaikki viisi pysymään näkyvissä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membangun bilah navigasi kustom secara manual untuk memaksa kelimanya tetap terlihat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å håndbygge en egendefinert navigasjonslinje for å tvinge alle fem til å forbli synlige"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de hand een aangepaste navigatiebalk bouwen om alle vijf zichtbaar te houden"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ręczne budowanie własnego paska nawigacji, by wymusić widoczność wszystkich pięciu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att handbygga ett eget navigeringsfält för att tvinga alla fem att vara synliga"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beşinin de görünür kalmasını zorlamak için elle özel bir gezinme çubuğu yapmak"
          }
        }
      }
    },
