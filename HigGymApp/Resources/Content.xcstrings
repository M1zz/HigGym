        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Thứ tự họ và tên** là quy tắc văn hóa; không bao giờ nhúng cứng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pořadí příjmení a křestního jména** je kulturní pravidlo; nikdy ho nezapisujte napevno"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rækkefølgen af efternavn og fornavn** er en kulturel regel; hardkod den aldrig"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Η σειρά επωνύμου και ονόματος** είναι πολιτισμικός κανόνας· μην την κωδικοποιείς ποτέ σκληρά"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Suku- ja etunimen järjestys** on kulttuurinen sääntö; älä koskaan kovakoodaa sitä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Urutan nama keluarga dan nama depan** adalah aturan budaya; jangan pernah menanamnya secara hard-coded"
