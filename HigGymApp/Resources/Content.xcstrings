    "길게 누르면 **전체가 선택·복사**, “이건 데이터” 신호": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold to **select and copy the whole thing**, a “this is data” signal"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold to **select and copy the whole thing**, a “this is data” signal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しすると**全体が選択・コピー**される。「これはデータ」というサイン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按就**整体选择、复制**，是“这是数据”的信号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按就**整體選擇、複製**，是「這是資料」的訊號"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие и удержание **выделяет и копирует всё целиком**: сигнал «это данные»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener pulsado para **seleccionar y copiar todo**, una señal de «esto son datos»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedrückt halten, um **das Ganze auszuwählen und zu kopieren**, ein „Das sind Daten“-Signal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appui long pour **sélectionner et copier le tout**, un signal « ce sont des données »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per **selezionare e copiare tutto**, un segnale «questi sono dati»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione e segure para **selecionar e copiar tudo**, um sinal de «isto são dados»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดค้างเพื่อ**เลือกและคัดลอกทั้งหมด** สัญญาณ “นี่คือข้อมูล”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ để **chọn và sao chép toàn bộ**, một tín hiệu “đây là dữ liệu”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dlouhý stisk pro **vybrání a zkopírování celku**, signál „toto jsou data“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og hold for at **markere og kopiere det hele**, et »dette er data«-signal"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα πατημένο για να **επιλέξεις και να αντιγράψεις το σύνολο**, ένα σήμα «αυτό είναι δεδομένα»"
          }
        }
      }
    },
    "길이가 변해도 한 줄 유지": {
