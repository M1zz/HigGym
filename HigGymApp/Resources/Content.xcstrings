        }
      }
    },
    "본문 문단에 글자 축소를 걸어 화면마다 크기가 달라진다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaling body paragraphs, so the text size changes from screen to screen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaling body paragraphs, so the text size changes from screen to screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の段落に文字の縮小をかけ、画面ごとにサイズが変わる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给正文段落加文字缩小，各界面的大小就不一样了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給正文段落加文字縮小，各介面的大小就不一樣了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштабирование абзацев основного текста, из-за чего размер текста меняется от экрана к экрану"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalar los párrafos del cuerpo, de modo que el tamaño del texto cambia de una pantalla a otra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fließtext skalieren, sodass sich die Textgröße von Bildschirm zu Bildschirm ändert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à l'échelle les paragraphes du corps du texte, si bien que la taille du texte change d'un écran à l'autre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalare i paragrafi del corpo, così la dimensione del testo cambia da schermata a schermata"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalar os parágrafos do corpo, então o tamanho do texto muda de tela para tela"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับขนาดย่อหน้าเนื้อความ ทำให้ขนาดตัวอักษรเปลี่ยนไปในแต่ละหน้าจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Co chữ cho đoạn nội dung, khiến cỡ chữ đổi từ màn hình này sang màn hình khác"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Škálování odstavců textu, takže se velikost textu mění od obrazovky k obrazovce"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At skalere brødtekstafsnit, så tekststørrelsen ændrer sig fra skærm til skærm"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλιμάκωση παραγράφων κειμένου, οπότε το μέγεθος κειμένου αλλάζει από οθόνη σε οθόνη"
          }
        }
      }
    },
    "본문 문단에 적용해 화면마다 글자 크기가 제각각": {
