          }
        }
      }
    },
    "경계가 정보인 화면에서는 hard로 어디까지가 콘텐츠인지 분명히 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On screens where the boundary is information, use hard to make clear where the content ends."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On screens where the boundary is information, use hard to make clear where the content ends."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "境界が情報である画面では、hard でどこまでがコンテンツかをはっきりさせる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在边界就是信息的界面里，用 hard 把内容到哪里为止说清楚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在邊界就是資訊的介面裡，用 hard 把內容到哪裡為止說清楚。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экранах, где граница - информация, используйте hard, чтобы ясно показать, где контент заканчивается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pantallas donde el límite es información, usa hard para dejar claro dónde termina el contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze auf Bildschirmen, auf denen die Grenze Information ist, hard, um klarzumachen, wo der Inhalt endet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les écrans où la limite est de l'information, utilisez hard pour bien montrer où le contenu s'arrête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelle schermate in cui il confine è informazione, usa hard per chiarire dove finisce il contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em telas em que a fronteira é informação, use hard para deixar claro onde o conteúdo termina."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้าจอที่ขอบเขตคือข้อมูล ใช้ hard เพื่อทำให้ชัดว่าเนื้อหาจบที่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình mà ranh giới là thông tin, dùng hard để rõ nội dung kết thúc ở đâu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na obrazovkách, kde je hranice informací, použijte hard, aby bylo jasné, kde obsah končí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På skærme, hvor grænsen er information, brug hard for at gøre klart, hvor indholdet slutter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε οθόνες όπου το όριο είναι πληροφορία, χρησιμοποίησε hard για να γίνει σαφές πού τελειώνει το περιεχόμενο."
          }
        }
      }
    },
    "경계가 중요한 입력창 위에 soft 유지": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping soft above an input field where the boundary matters"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping soft above an input field where the boundary matters"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "境界が大事な入力欄の上でsoftのまま"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在边界很重要的输入框上方保持 soft"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在邊界很重要的輸入框上方保持 soft"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить soft над полем ввода, где граница важна"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener soft sobre un campo de entrada donde el límite importa"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "soft über einem Eingabefeld beibehalten, wo die Grenze zählt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder soft au-dessus d'un champ de saisie où la limite compte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere soft sopra un campo di input dove il confine conta"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter soft acima de um campo de entrada onde a fronteira importa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คง soft ไว้เหนือช่องกรอกที่ขอบเขตสำคัญ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ soft phía trên ô nhập liệu nơi ranh giới quan trọng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechání soft nad vstupním polem, kde na hranici záleží"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At beholde soft over et inputfelt, hvor grænsen betyder noget"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατήρηση του soft πάνω από πεδίο εισαγωγής όπου το όριο μετράει"
          }
        }
      }
    },
    "경계선 없이 콘텐츠가 **부드럽게 스며드는** 페이드, 기본값": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fade where content **softly blends away** with no divider line; the default"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A fade where content **softly blends away** with no divider line; the default"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "境界線なしでコンテンツが**やわらかく溶け込む**フェード。デフォルト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有分隔线，内容**柔和渗入**的淡出，默认值"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有分隔線，內容**柔和滲入**的淡出，預設值"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затухание, при котором контент **мягко растворяется** без разделительной линии; значение по умолчанию"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un desvanecimiento en el que el contenido **se funde suavemente** sin línea divisoria; el valor por defecto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ausblenden, bei dem der Inhalt **sanft verschwimmt**, ohne Trennlinie; der Standard"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fondu où le contenu **se fond en douceur** sans ligne de séparation ; le réglage par défaut"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dissolvenza in cui il contenuto **si fonde dolcemente** senza linea di divisione; il predefinito"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma dissolvência em que o conteúdo **se funde suavemente** sem linha divisória; o padrão"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การจางที่เนื้อหา**ผสานหายไปอย่างนุ่มนวล** ไม่มีเส้นคั่น ค่าเริ่มต้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mờ dần nơi nội dung **nhẹ nhàng hòa tan** không có đường phân cách; mặc định"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mizení, při kterém se obsah **jemně rozplyne** bez dělicí čáry; výchozí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En udtoning, hvor indhold **blødt går i ét** uden skillelinje; standarden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα σβήσιμο όπου το περιεχόμενο **ενώνεται απαλά** χωρίς γραμμή διαχωρισμού· η προεπιλογή"
          }
        }
      }
    },
    "경계선은 그 자체로 시각 요소라 **UI의 존재감을 늘림**. 콘텐츠가 \"잘리는\" 게 아니라 \"스며드는\" 표현이 유리라는 재질 은유와 맞고, 몰입을 덜 깨기 때문에 이것이 기본값.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A divider line is a visual element in its own right, so it **adds to the UI's presence**. Content that \"blends away\" rather than \"gets cut off\" fits the material metaphor of glass and breaks immersion less, which is why this is the default."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A divider line is a visual element in its own right, so it **adds to the UI's presence**. Content that \"blends away\" rather than \"gets cut off\" fits the material metaphor of glass and breaks immersion less, which is why this is the default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "境界線はそれ自体が視覚要素なので、**UIの存在感を増やす**。コンテンツが「切れる」のではなく「溶け込む」表現はガラスという素材のメタファーに合い、没入感を損ないにくい。だからこれがデフォルト。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分隔线本身就是视觉元素，会**增加 UI 的存在感**。符合“内容不是被‘截断’而是‘渗入’更有利”的玻璃材质隐喻，也不太破坏沉浸，所以是默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分隔線本身就是視覺元素，會**增加 UI 的存在感**。符合「內容不是被『截斷』而是『滲入』更有利」的玻璃材質隱喻，也不太破壞沉浸，所以是預設值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделительная линия - самостоятельный визуальный элемент, поэтому она **добавляет интерфейсу заметности**. Контент, который «растворяется», а не «обрезается», вписывается в метафору стеклянного материала и меньше нарушает погружение, поэтому это значение по умолчанию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea divisoria es un elemento visual por derecho propio, así que **suma presencia a la interfaz**. Un contenido que «se funde» en lugar de «cortarse» encaja con la metáfora de material del cristal y rompe menos la inmersión, por eso este es el valor por defecto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Trennlinie ist ein eigenes visuelles Element und **erhöht daher die Präsenz der UI**. Inhalt, der „verschwimmt“ statt „abgeschnitten wird“, passt zur Materialmetapher von Glas und stört die Immersion weniger, weshalb dies der Standard ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne de séparation est un élément visuel en soi, donc elle **accroît la présence de l'interface**. Un contenu qui « se fond » plutôt que d'être « coupé » s'accorde avec la métaphore du verre et brise moins l'immersion, c'est pourquoi c'est la valeur par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una linea di divisione è di per sé un elemento visivo, quindi **aumenta la presenza della UI**. Il contenuto che «si fonde» invece di «essere tagliato» si addice alla metafora del materiale del vetro e rompe meno l'immersione, ed è per questo il predefinito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha divisória é um elemento visual por si só, então **aumenta a presença da interface**. O conteúdo que «se funde» em vez de «ser cortado» combina com a metáfora de material do vidro e quebra menos a imersão, e por isso é o padrão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นคั่นเป็นองค์ประกอบภาพในตัวมันเอง จึง**เพิ่มตัวตนให้ UI** เนื้อหาที่ \"ผสานหายไป\" แทนที่จะ \"ถูกตัด\" เข้ากับอุปมาวัสดุของกระจกและทำลายความดื่มด่ำน้อยกว่า นั่นคือเหตุผลที่นี่เป็นค่าเริ่มต้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đường phân cách là một yếu tố thị giác tự thân, nên nó **làm tăng sự hiện diện của UI**. Nội dung \"hòa tan đi\" thay vì \"bị cắt\" hợp với ẩn dụ vật liệu của kính và ít phá vỡ sự đắm chìm hơn, đó là lý do đây là mặc định."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dělicí čára je sama o sobě vizuální prvek, takže **zvyšuje přítomnost UI**. Obsah, který se „rozplyne“ místo aby „byl odříznut“, odpovídá materiálové metafoře skla a méně narušuje pohlcení, proto je to výchozí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En skillelinje er et visuelt element i sig selv, så den **øger brugerfladens tilstedeværelse**. Indhold, der »toner ud« frem for at »blive skåret af«, passer til glassets materialemetafor og bryder fordybelsen mindre, og derfor er det standarden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γραμμή διαχωρισμού είναι οπτικό στοιχείο από μόνη της, οπότε **προσθέτει στην παρουσία της διεπαφής**. Το περιεχόμενο που «ενώνεται» αντί να «κόβεται» ταιριάζει στη μεταφορά υλικού του γυαλιού και σπάει λιγότερο την εμβύθιση, γι' αυτό είναι η προεπιλογή."
          }
        }
      }
    },
    "경로는 앞이 공통 접두사라 앞만 보이면 구분 불가. 정보 가치가 양 끝에 있으니 가운데를 접는 것이 기준에 맞는 선택.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paths share a common prefix, so if only the beginning shows, you can't tell them apart. The useful information is at both ends, so collapsing the middle is the choice that fits the criterion."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Paths share a common prefix, so if only the beginning shows, you can't tell them apart. The useful information is at both ends, so collapsing the middle is the choice that fits the criterion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスは先頭が共通の接頭辞なので、先頭だけでは区別できない。情報の価値は両端にあるから、真ん中を省くのが基準に合った選択だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路径的开头是共同前缀，只看开头无法区分。信息价值在两端，所以折叠中间是符合标准的选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路徑的開頭是共同字首，只看開頭無法區分。資訊價值在兩端，所以摺疊中間是符合標準的選擇。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У путей общий префикс, поэтому по одному началу их не различить. Полезная информация находится на обоих концах, поэтому свернуть середину - выбор, соответствующий критерию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rutas comparten un prefijo común, así que si solo se muestra el principio, no se pueden distinguir. La información útil está en ambos extremos, así que colapsar el medio es la opción que encaja con el criterio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfade haben ein gemeinsames Präfix, sodass man sie nicht unterscheiden kann, wenn nur der Anfang sichtbar ist. Die nützliche Information liegt an beiden Enden, daher passt das Zusammenfalten der Mitte zum Kriterium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chemins partagent un préfixe commun, donc si seul le début s'affiche, on ne peut pas les distinguer. L'information utile se trouve aux deux extrémités, donc replier le milieu est le choix qui répond au critère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I percorsi condividono un prefisso comune, quindi se si vede solo l'inizio non si distinguono. L'informazione utile sta a entrambe le estremità, quindi comprimere il centro è la scelta che si adatta al criterio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhos compartilham um prefixo comum, então, se só o começo aparece, não dá para distingui-los. A informação útil está nas duas pontas, então dobrar o meio é a escolha que atende ao critério."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พาธมีคำนำหน้าร่วมกัน ถ้าเห็นแค่ส่วนต้นก็แยกไม่ออก ข้อมูลที่มีประโยชน์อยู่ที่ทั้งสองปลาย การยุบส่วนกลางจึงเป็นตัวเลือกที่ตรงตามเกณฑ์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đường dẫn có chung tiền tố, nên nếu chỉ hiện phần đầu thì không phân biệt được. Thông tin hữu ích nằm ở cả hai đầu, nên gập phần giữa là lựa chọn hợp với tiêu chí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cesty mají společnou předponu, takže pokud je vidět jen začátek, nerozlišíte je. Užitečná informace je na obou koncích, takže sbalení středu je volba odpovídající kritériu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stier deler et fælles præfiks, så hvis kun begyndelsen vises, kan du ikke se forskel. Den nyttige information sidder i begge ender, så at folde midten sammen er det valg, der passer til kriteriet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διαδρομές μοιράζονται κοινό πρόθεμα, οπότε αν φαίνεται μόνο η αρχή, δεν μπορείς να τις ξεχωρίσεις. Η χρήσιμη πληροφορία βρίσκεται και στα δύο άκρα, οπότε η σύμπτυξη της μέσης είναι η επιλογή που ταιριάζει στο κριτήριο."
          }
        }
      }
    },
    "경로에서 middle이 좋았으니 이름에도 좋을 거라 옮겨 적는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle worked well for paths, so it gets carried over to names, assuming it will work there too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle worked well for paths, so it gets carried over to names, assuming it will work there too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスでmiddleがうまくいったので、名前にもよいだろうとそのまま持ち込む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路径用 middle 很好，所以想当然地搬到姓名上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路徑用 middle 很好，所以想當然地搬到姓名上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle хорошо сработал для путей, поэтому его переносят на имена, полагая, что и там сработает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle funcionaba bien con las rutas, así que se traslada a los nombres suponiendo que allí también funcionará."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle funktionierte bei Pfaden gut, also wird es auf Namen übertragen, in der Annahme, dass es dort auch funktioniert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle fonctionnait bien pour les chemins, donc on le transpose aux noms, en supposant que cela y fonctionnera aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle ha funzionato bene per i percorsi, quindi viene portato ai nomi, presumendo che funzioni anche lì."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle funcionou bem para caminhos, então é levado para nomes, presumindo que funcionará ali também."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle ใช้ได้ดีกับพาธ จึงยกไปใช้กับชื่อโดยสมมติว่าจะใช้ได้ที่นั่นด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle chạy tốt với đường dẫn, nên được mang sang tên, với giả định cũng sẽ ổn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle fungoval dobře pro cesty, tak se přenáší na jména s předpokladem, že tam bude fungovat také."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Middle virkede godt til stier, så det overføres til navne i den antagelse, at det også virker der."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το middle δούλεψε καλά για διαδρομές, οπότε μεταφέρεται στα ονόματα με την υπόθεση ότι θα δουλέψει κι εκεί."
          }
        }
      }
    },
    "고빈도 기능이 둘 이상이면 **둘 다 하단에 있어야** reachability가 일관됨. 이때 DefaultToolbarItem(kind:.search)으로 검색의 자리를 명시하고 ToolbarSpacer로 분리, 검색(입력)과 버튼(액션)은 성격이 다르므로 **다른 캡슐**로 보이게 하는 것.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When two or more features are high-frequency, **both need to be at the bottom** for reachability to stay consistent. Here you declare search's slot with DefaultToolbarItem(kind:.search) and separate it with ToolbarSpacer: search (input) and buttons (actions) differ in nature, so they should read as **different capsules**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When two or more features are high-frequency, **both need to be at the bottom** for reachability to stay consistent. Here you declare search's slot with DefaultToolbarItem(kind:.search) and separate it with ToolbarSpacer: search (input) and buttons (actions) differ in nature, so they should read as **different capsules**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高頻度の機能が2つ以上あるなら、**両方とも下部にある**ことでreachabilityが一貫する。このときDefaultToolbarItem(kind:.search)で検索の位置を明示し、ToolbarSpacerで分ける。検索（入力）とボタン（アクション）は性格が違うので、**別のカプセル**に見えるようにするということ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高频功能有两个以上时，**两个都要在底部**，可触达性才一致。这时用 DefaultToolbarItem(kind:.search) 明确搜索的位置，用 ToolbarSpacer 分开：搜索（输入）和按钮（操作）性质不同，所以要让它们显示为**不同的胶囊**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高頻功能有兩個以上時，**兩個都要在底部**，可觸達性才一致。這時用 DefaultToolbarItem(kind:.search) 明確搜尋的位置，用 ToolbarSpacer 分開：搜尋（輸入）和按鈕（操作）性質不同，所以要讓它們顯示為**不同的膠囊**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда два или больше частых функции, **обе должны быть внизу**, чтобы досягаемость оставалась последовательной. Здесь вы объявляете слот поиска через DefaultToolbarItem(kind:.search) и отделяете его через ToolbarSpacer: поиск (ввод) и кнопки (действия) различны по природе, поэтому должны читаться как **разные капсулы**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando dos o más funciones son de alta frecuencia, **ambas deben estar abajo** para que el alcance sea coherente. Aquí declaras el sitio de la búsqueda con DefaultToolbarItem(kind:.search) y lo separas con ToolbarSpacer: la búsqueda (entrada) y los botones (acciones) difieren en naturaleza, así que deben leerse como **cápsulas distintas**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind zwei oder mehr Funktionen häufig, müssen **beide unten sein**, damit die Erreichbarkeit konsistent bleibt. Hier erklärst du den Platz der Suche mit DefaultToolbarItem(kind:.search) und trennst ihn mit ToolbarSpacer: Suche (Eingabe) und Buttons (Aktionen) sind verschiedener Natur, daher sollten sie als **verschiedene Kapseln** gelesen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand deux fonctions ou plus sont à haute fréquence, **toutes deux doivent être en bas** pour que l'accessibilité reste cohérente. Ici vous déclarez l'emplacement de la recherche avec DefaultToolbarItem(kind:.search) et la séparez avec ToolbarSpacer : la recherche (saisie) et les boutons (actions) sont de nature différente, donc ils doivent se lire comme **des capsules différentes**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando due o più funzioni sono ad alta frequenza, **entrambe devono stare in basso** perché la raggiungibilità resti coerente. Qui dichiari lo slot della ricerca con DefaultToolbarItem(kind:.search) e lo separi con ToolbarSpacer: ricerca (input) e pulsanti (azioni) sono di natura diversa, quindi devono leggersi come **capsule diverse**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando duas ou mais funcionalidades são de alta frequência, **ambas precisam ficar embaixo** para o alcance continuar consistente. Aqui você declara o lugar da busca com DefaultToolbarItem(kind:.search) e a separa com ToolbarSpacer: busca (entrada) e botões (ações) são de natureza diferente, então devem ser lidos como **cápsulas diferentes**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อสองฟีเจอร์ขึ้นไปใช้บ่อย **ทั้งสองต้องอยู่ด้านล่าง**เพื่อให้การเอื้อมถึงสอดคล้อง ที่นี่คุณประกาศช่องของการค้นหาด้วย DefaultToolbarItem(kind:.search) และแยกด้วย ToolbarSpacer: การค้นหา (อินพุต) กับปุ่ม (การกระทำ) ต่างลักษณะกัน จึงควรอ่านเป็น**คนละแคปซูล**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có từ hai tính năng tần suất cao trở lên, **cả hai cần ở dưới cùng** để khả năng với tới nhất quán. Ở đây bạn khai báo ô của tìm kiếm bằng DefaultToolbarItem(kind:.search) và tách bằng ToolbarSpacer: tìm kiếm (nhập liệu) và các nút (hành động) khác bản chất, nên cần đọc như **các capsule khác nhau**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když jsou dvě nebo více funkcí s vysokou frekvencí, **obě musejí být dole**, aby dosah zůstal konzistentní. Zde deklarujete slot hledání pomocí DefaultToolbarItem(kind:.search) a oddělíte ho pomocí ToolbarSpacer: hledání (vstup) a tlačítka (akce) se liší povahou, takže by se měly číst jako **různé kapsle**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når to eller flere funktioner er højfrekvente, skal **begge være i bunden** for at holde rækkevidden konsekvent. Her erklærer du søgningens plads med DefaultToolbarItem(kind:.search) og adskiller den med ToolbarSpacer: søgning (input) og knapper (handlinger) er forskellige af natur, så de bør læses som **forskellige kapsler**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν δύο ή περισσότερες λειτουργίες είναι υψηλής συχνότητας, **και οι δύο πρέπει να είναι κάτω** ώστε η εμβέλεια να μένει συνεπής. Εδώ δηλώνεις τη θέση της αναζήτησης με DefaultToolbarItem(kind:.search) και τη χωρίζεις με ToolbarSpacer: η αναζήτηση (εισαγωγή) και τα κουμπιά (ενέργειες) διαφέρουν στη φύση, οπότε πρέπει να διαβάζονται ως **διαφορετικές κάψουλες**."
          }
        }
      }
    },
    "고빈도 기능인 검색이 기존엔 가장 닿기 어려운 상단에 있었음. 빈도-높이 반비례 기준에 맞게 시스템 차원에서 교정한 사례. iPad는 양손 파지 기준으로 상단 trailing, 같은 기준을 기기 인체공학에 맞게 적용.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search, a high-frequency feature, used to sit at the top, the hardest place to reach. A case of the system itself correcting course to match the rule that frequency and height are inversely related. On iPad it sits at the top trailing edge for a two-handed grip, applying the same criterion to that device's ergonomics."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Search, a high-frequency feature, used to sit at the top, the hardest place to reach. A case of the system itself correcting course to match the rule that frequency and height are inversely related. On iPad it sits at the top trailing edge for a two-handed grip, applying the same criterion to that device's ergonomics."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度の高い機能である検索が、以前は最も届きにくい上部にあった。頻度と高さの反比例という基準に合わせて、システム自身が修正した事例。iPadでは両手で持つことを前提に上部のtrailing。同じ基準をデバイスの人間工学に合わせて当てはめている。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索是高频功能，过去却在最难够到的顶部。这是系统层面按“频率与高度成反比”的标准纠正的例子。iPad 以双手握持为基准放在顶部 trailing，把同一个标准按设备的人体工学加以应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋是高頻功能，過去卻在最難夠到的頂部。這是系統層面按「頻率與高度成反比」的標準糾正的例子。iPad 以雙手握持為基準放在頂部 trailing，把同一個標準按裝置的人體工學加以應用程式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск, частая функция, раньше стоял вверху, в самом труднодоступном месте. Случай, когда сама система исправила курс в соответствии с правилом «частота и высота обратно пропорциональны». На iPad он стоит вверху trailing под хват двумя руками, применяя тот же критерий к эргономике этого устройства."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda, una función de alta frecuencia, solía estar arriba, el sitio más difícil de alcanzar. Un caso del propio sistema corrigiendo el rumbo para ajustarse a la regla de que frecuencia y altura son inversamente proporcionales. En iPad está arriba a la derecha para un agarre a dos manos, aplicando el mismo criterio a la ergonomía de ese dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche, eine häufige Funktion, saß früher oben, am schwersten erreichbaren Ort. Ein Fall, in dem das System selbst den Kurs korrigiert, um der Regel zu entsprechen, dass Häufigkeit und Höhe umgekehrt zusammenhängen. Auf dem iPad sitzt sie für den Zweihandgriff oben am Ende, wobei dasselbe Kriterium auf die Ergonomie dieses Geräts angewendet wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche, fonction à haute fréquence, se trouvait autrefois en haut, l'endroit le plus difficile à atteindre. Un cas où le système lui-même corrige son cap pour respecter la règle selon laquelle fréquence et hauteur sont inversement liées. Sur iPad, elle se place au bord trailing du haut pour une prise à deux mains, appliquant le même critère à l'ergonomie de cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca, funzione ad alta frequenza, stava in alto, il posto più difficile da raggiungere. Un caso in cui il sistema stesso corregge la rotta per adeguarsi alla regola che frequenza e altezza sono inversamente legate. Su iPad sta sul bordo trailing in alto per una presa a due mani, applicando lo stesso criterio all'ergonomia di quel dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca, uma funcionalidade de alta frequência, ficava no topo, o lugar mais difícil de alcançar. Um caso em que o próprio sistema corrige o rumo para se ajustar à regra de que frequência e altura são inversamente relacionadas. No iPad ela fica na borda trailing do topo para uma pegada com as duas mãos, aplicando o mesmo critério à ergonomia desse dispositivo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาซึ่งเป็นฟีเจอร์ที่ใช้บ่อยเคยอยู่ด้านบน ที่ที่เอื้อมยากที่สุด กรณีที่ระบบแก้ทิศทางเองให้ตรงกับกฎที่ว่าความถี่กับความสูงสวนทางกัน บน iPad มันอยู่ขอบ trailing ด้านบนเพื่อการจับสองมือ ใช้เกณฑ์เดียวกันกับยศาสตร์ของอุปกรณ์นั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm, một tính năng tần suất cao, từng nằm ở trên cùng, chỗ khó với tới nhất. Đó là trường hợp chính hệ thống tự sửa hướng để khớp quy tắc rằng tần suất và độ cao tỉ lệ nghịch. Trên iPad nó nằm ở cạnh trailing phía trên để cầm hai tay, áp dụng cùng tiêu chí cho công thái học của thiết bị đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání, funkce s vysokou frekvencí, dřív sedělo nahoře, na nejhůř dosažitelném místě. Případ, kdy se systém sám napravuje, aby odpovídal pravidlu, že frekvence a výška jsou v nepřímém vztahu. Na iPadu sedí vpravo nahoře pro držení oběma rukama, čímž se stejné kritérium aplikuje na ergonomii toho zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgning, en højfrekvent funktion, plejede at sidde øverst, det sværeste sted at nå. Et tilfælde af, at systemet selv retter kurs for at passe til reglen om, at hyppighed og højde er omvendt relaterede. På iPad sidder den øverst trailing til et tohåndsgreb, hvor det samme kriterium anvendes på den enheds ergonomi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση, μια λειτουργία υψηλής συχνότητας, καθόταν παλιά στην κορυφή, το πιο δύσκολο σημείο για να φτάσεις. Μια περίπτωση όπου το ίδιο το σύστημα διορθώνει πορεία για να ταιριάξει με τον κανόνα ότι η συχνότητα και το ύψος σχετίζονται αντίστροφα. Στο iPad κάθεται στην πάνω trailing άκρη για πιάσιμο με δύο χέρια, εφαρμόζοντας το ίδιο κριτήριο στην εργονομία εκείνης της συσκευής."
          }
        }
      }
    },
    "고정 hex를 지우고 `.foregroundStyle(.secondary)`로 되돌린다. 보조 설명이 배경에 따라 스스로 대비를 맞추고, 밝은 사진, 어두운 사진, 다크 모드에서 모두 제목보다 한 단계 낮은 위계로 읽힌다. 정보를 **색이 아니라 위계로** 구분하게 된다. 더 또렷해야 한다면 hex가 아니라 위계를 한 단계 올린다. 앱의 6.2.1 Vibrancy 예제에서 material 위 시맨틱 스타일이 배경을 끌어오는 모습을 볼 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the fixed hex and go back to `.foregroundStyle(.secondary)`. The description sets its own contrast for the background, and over bright photos, dark photos, and in Dark Mode alike, it reads as one level below the title. You end up distinguishing information **by hierarchy, not by color**. If it needs to be sharper, raise its hierarchy one level instead of reaching for a hex. In the app's 6.2.1 Vibrancy example, you can see semantic styles on a material drawing in the background."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the fixed hex and go back to `.foregroundStyle(.secondary)`. The description sets its own contrast for the background, and over bright photos, dark photos, and in Dark Mode alike, it reads as one level below the title. You end up distinguishing information **by hierarchy, not by colour**. If it needs to be sharper, raise its hierarchy one level instead of reaching for a hex. In the app's 6.2.1 Vibrancy example, you can see semantic styles on a material drawing in the background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定のhexを消して、`.foregroundStyle(.secondary)`に戻す。補足の説明が背景に応じて自らコントラストを合わせ、明るい写真でも暗い写真でもダークモードでも、タイトルより1段低い階層として読める。情報を**色ではなく階層で**区別するようになる。もっとはっきりさせたいなら、hexではなく階層を1段上げる。アプリの6.2.1 Vibrancyの例で、material上のセマンティックなスタイルが背景を取り込む様子を見られる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉固定 hex，改回 `.foregroundStyle(.secondary)`。辅助说明会按背景自己调整对比度，在明亮照片、深色照片、深色模式下，都比标题低一级地被读出。信息靠**层级而不是颜色**来区分。想要更清晰，就把层级提高一级，而不是改 hex。在应用的 6.2.1 Vibrancy 示例里，可以看到 material 上的语义样式引入背景的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉固定 hex，改回 `.foregroundStyle(.secondary)`。輔助說明會按背景自己調整對比度，在明亮照片、深色照片、深色模式下，都比標題低一級地被讀出。資訊靠**層級而不是顏色**來區分。想要更清晰，就把層級提高一級，而不是改 hex。在應用程式的 6.2.1 Vibrancy 示例裡，可以看到 material 上的語義樣式引入背景的樣子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите фиксированный hex и вернитесь к `.foregroundStyle(.secondary)`. Описание само настраивает контраст под фон и на ярких фотографиях, тёмных фотографиях и в тёмной теме читается на уровень ниже заголовка. Информация различается **по иерархии, а не по цвету**. Если нужно чётче, поднимите иерархию на уровень выше, а не хватайтесь за hex. В примере 6.2.1 Vibrancy видно, как семантические стили на материале подтягивают фон."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra el hex fijo y vuelve a `.foregroundStyle(.secondary)`. La descripción fija su propio contraste para el fondo, y sobre fotos brillantes, fotos oscuras y en modo oscuro por igual, se lee un nivel por debajo del título. Acabas distinguiendo la información **por jerarquía, no por color**. Si necesita ser más nítida, sube su jerarquía un nivel en lugar de recurrir a un hex. En el ejemplo 6.2.1 Vibrancy de la app puedes ver estilos semánticos sobre un material absorbiendo el fondo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche das feste Hex und kehre zu `.foregroundStyle(.secondary)` zurück. Die Beschreibung stellt ihren eigenen Kontrast für den Hintergrund ein und liest sich über hellen Fotos, dunklen Fotos und im Dunkelmodus gleichermaßen eine Stufe unter dem Titel. So unterscheidest du Information am Ende **nach Hierarchie, nicht nach Farbe**. Muss es schärfer sein, hebe die Hierarchie eine Stufe an, statt zu einem Hex zu greifen. Im Beispiel 6.2.1 Vibrancy der App siehst du semantische Stile, die den Hintergrund eines Materials einzeichnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez le hex fixe et revenez à `.foregroundStyle(.secondary)`. La description règle son propre contraste pour l'arrière-plan, et sur des photos claires, des photos sombres et en mode sombre, elle se lit un cran sous le titre. Vous finissez par distinguer l'information **par la hiérarchie, pas par la couleur**. S'il faut plus de netteté, montez sa hiérarchie d'un cran au lieu de chercher un hex. Dans l'exemple 6.2.1 Vibrancy de l'app, vous voyez des styles sémantiques sur un matériau qui puisent dans l'arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina l'esadecimale fisso e torna a `.foregroundStyle(.secondary)`. La descrizione regola da sé il contrasto per lo sfondo e, su foto luminose, foto scure e in Modalità Scura, si legge un livello sotto il titolo. Finisci per distinguere le informazioni **per gerarchia, non per colore**. Se deve essere più nitida, alza la sua gerarchia di un livello invece di cercare un esadecimale. Nell'esempio 6.2.1 Vibrancy dell'app puoi vedere gli stili semantici su un materiale che attingono dallo sfondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague o hex fixo e volte para `.foregroundStyle(.secondary)`. A descrição define o próprio contraste para o fundo e, sobre fotos claras, fotos escuras e no Modo Escuro, é lida um nível abaixo do título. Você acaba distinguindo a informação **por hierarquia, não por cor**. Se precisa ser mais nítida, suba um nível na hierarquia em vez de recorrer a um hex. No exemplo 6.2.1 Vibrancy do app, você vê estilos semânticos sobre um material puxando o fundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบฐานสิบหกตายตัวแล้วกลับไปใช้ `.foregroundStyle(.secondary)` คำอธิบายตั้งความตัดกันของตัวเองตามพื้นหลัง และเหนือรูปถ่ายสว่าง รูปถ่ายมืด และในโหมดมืด มันอ่านเป็นหนึ่งระดับใต้ชื่อเรื่อง คุณลงเอยด้วยการแยกข้อมูล**ตามลำดับชั้น ไม่ใช่ตามสี** ถ้าต้องการให้คมขึ้น ให้ยกลำดับชั้นขึ้นหนึ่งระดับแทนการคว้าฐานสิบหก ในตัวอย่าง 6.2.1 Vibrancy ของแอป คุณเห็นสไตล์เชิงความหมายบนวัสดุดึงพื้นหลังเข้ามา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa mã hex cố định và quay về `.foregroundStyle(.secondary)`. Phần mô tả tự đặt độ tương phản theo nền, và trên ảnh sáng, ảnh tối hay Chế độ tối đều đọc thấp hơn tiêu đề một bậc. Rốt cuộc bạn phân biệt thông tin **theo thứ bậc, không theo màu**. Nếu cần sắc hơn, nâng thứ bậc lên một cấp thay vì với tay lấy mã hex. Trong ví dụ 6.2.1 Vibrancy của app, bạn thấy các style ngữ nghĩa trên vật liệu hòa với nền."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smažte pevný hex a vraťte se k `.foregroundStyle(.secondary)`. Popis si nastavuje vlastní kontrast vůči pozadí a nad světlými fotkami, tmavými fotkami i v tmavém režimu se čte o úroveň pod nadpisem. Nakonec informace rozlišujete **hierarchií, ne barvou**. Pokud to má být ostřejší, zvyšte jeho hierarchii o jednu úroveň místo sahání po hex. V příkladu 6.2.1 Vibrancy aplikace vidíte sémantické styly na materiálu přimíchávající pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet den faste hex, og gå tilbage til `.foregroundStyle(.secondary)`. Beskrivelsen sætter selv sin kontrast til baggrunden, og over lyse fotos, mørke fotos og i mørk tilstand læses den som ét niveau under titlen. Du ender med at skelne information **efter hierarki, ikke efter farve**. Hvis den skal være skarpere, så hæv dens hierarki ét niveau i stedet for at række ud efter en hex. I appens eksempel 6.2.1 Vibrancy kan du se semantiske stilarter på et materiale trække baggrunden ind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σβήσε το σταθερό hex και γύρνα στο `.foregroundStyle(.secondary)`. Η περιγραφή ορίζει τη δική της αντίθεση για το φόντο, και πάνω από φωτεινές φωτογραφίες, σκοτεινές φωτογραφίες και στη Σκοτεινή εμφάνιση, διαβάζεται ένα επίπεδο κάτω από τον τίτλο. Καταλήγεις να ξεχωρίζεις την πληροφορία **με ιεραρχία, όχι με χρώμα**. Αν χρειάζεται να είναι πιο καθαρή, ανέβασε την ιεραρχία της ένα επίπεδο αντί να απλώσεις το χέρι σε hex. Στο παράδειγμα 6.2.1 Vibrancy της εφαρμογής, μπορείς να δεις σημασιολογικά στυλ σε υλικό να τραβούν το φόντο."
          }
        }
      }
    },
    "고정 px 대신 `.fraction(0.3)`처럼 화면 비율로 주거나, 콘텐츠가 medium에 어울린다면 시스템 2단(medium·large)으로 돌아간다. 비율은 화면이 커지고 작아질 때 함께 움직이고, 시스템 detent는 이미 모든 기기에서 검증된 높이다. 어느 쪽이든 큰 글씨 설정에서 한 번 열어 마지막 줄이 보이는지 확인한다. 앱의 4.1.3 Presentation Detent: Custom 예제가 콘텐츠 고유 높이에 맞춘 detent를 보여 준다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of fixed pixels, specify a proportion of the screen like `.fraction(0.3)`, or if the content suits medium, go back to the system's two steps (medium and large). A proportion moves along as the screen gets bigger or smaller, and the system detents are heights already validated on every device. Either way, open it once with a large text setting and check that the last row is visible. The app's 4.1.3 Presentation Detent: Custom example shows a detent fitted to the content's intrinsic height."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Instead of fixed pixels, specify a proportion of the screen like `.fraction(0.3)`, or if the content suits medium, go back to the system's two steps (medium and large). A proportion moves along as the screen gets bigger or smaller, and the system detents are heights already validated on every device. Either way, open it once with a large text setting and check that the last row is visible. The app's 4.1.3 Presentation Detent: Custom example shows a detent fitted to the content's intrinsic height."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定 px の代わりに `.fraction(0.3)` のように画面の比率で指定するか、コンテンツが medium に合うならシステムの2段階（medium と large）に戻る。比率は画面が大きくなっても小さくなっても一緒に動き、システムの detent はすでにすべての端末で検証された高さだ。どちらにしても、大きい文字の設定で一度開いて最後の列が見えるかを確かめる。アプリの 4.1.3 Presentation Detent: Custom の例が、コンテンツ本来の高さに合わせた detent を見せてくれる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要固定 px，改为 `.fraction(0.3)` 这样按屏幕比例，或者如果内容适合 medium，就回到系统两档（medium · large）。比例会随屏幕变大变小一起变，系统 detent 则是已在所有设备上验证过的高度。无论哪种，都要在大字号设置下打开一次，确认最后一行看得见。应用的 4.1.3 Presentation Detent: Custom 示例展示了按内容自身高度定制的 detent。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要固定 px，改為 `.fraction(0.3)` 這樣按螢幕比例，或者如果內容適合 medium，就回到系統兩檔（medium · large）。比例會隨螢幕變大變小一起變，系統 detent 則是已在所有裝置上驗證過的高度。無論哪種，都要在大字號設定下開啟一次，確認最後一行看得見。應用程式的 4.1.3 Presentation Detent: Custom 示例展示了按內容自身高度定製的 detent。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо фиксированных пикселей задайте долю экрана вроде `.fraction(0.3)` или, если содержимое подходит medium, вернитесь к двум системным ступеням (medium и large). Доля движется вместе с размером экрана, а системные detent - высоты, уже проверенные на всех устройствах. В любом случае откройте один раз при крупном тексте и проверьте, что последняя строка видна. Пример 4.1.3 Presentation Detent: Custom показывает detent под собственную высоту содержимого."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugar de píxeles fijos, indica una proporción de la pantalla como `.fraction(0.3)`, o si el contenido encaja en medium, vuelve a los dos escalones del sistema (medium y large). Una proporción se mueve al agrandarse o reducirse la pantalla, y los detents del sistema son alturas ya validadas en todos los dispositivos. En cualquier caso, ábrelo una vez con un ajuste de texto grande y comprueba que la última fila se ve. El ejemplo 4.1.3 Presentation Detent: Custom de la app muestra un detent ajustado a la altura intrínseca del contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib statt fester Pixel einen Anteil des Bildschirms wie `.fraction(0.3)` an, oder wenn der Inhalt zu medium passt, kehre zu den zwei Stufen des Systems (medium und large) zurück. Ein Anteil wandert mit, wenn der Bildschirm größer oder kleiner wird, und die System-Detents sind Höhen, die auf jedem Gerät bereits erprobt sind. So oder so: Öffne es einmal mit einer großen Texteinstellung und prüfe, dass die letzte Zeile sichtbar ist. Das Beispiel 4.1.3 Presentation Detent: Custom der App zeigt einen Detent, der an die intrinsische Höhe des Inhalts angepasst ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu de pixels fixes, indiquez une proportion de l'écran comme `.fraction(0.3)`, ou si le contenu convient à medium, revenez aux deux crans du système (medium et large). Une proportion suit quand l'écran grandit ou rétrécit, et les detents système sont des hauteurs déjà validées sur tous les appareils. Dans les deux cas, ouvrez-le une fois avec un grand réglage de texte et vérifiez que la dernière ligne est visible. L'exemple 4.1.3 Presentation Detent: Custom de l'app montre un detent ajusté à la hauteur intrinsèque du contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invece di pixel fissi, specifica una proporzione dello schermo come `.fraction(0.3)`, oppure, se il contenuto si adatta a medium, torna ai due passi del sistema (medium e large). Una proporzione si muove con lo schermo che cresce o si riduce, e i detent di sistema sono altezze già validate su ogni dispositivo. In entrambi i casi, aprilo una volta con testo grande e verifica che l'ultima riga sia visibile. L'esempio 4.1.3 Detent di presentazione: personalizzato dell'app mostra un detent adattato all'altezza intrinseca del contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de pixels fixos, especifique uma proporção da tela como `.fraction(0.3)` ou, se o conteúdo combina com medium, volte aos dois passos do sistema (medium e large). Uma proporção acompanha a tela ficando maior ou menor, e os detents do sistema são alturas já validadas em todo dispositivo. De qualquer modo, abra uma vez com um ajuste de texto grande e confira se a última linha está visível. O exemplo 4.1.3 Detent de apresentação: personalizado do app mostra um detent ajustado à altura intrínseca do conteúdo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทนพิกเซลตายตัว ระบุสัดส่วนของหน้าจอเช่น `.fraction(0.3)` หรือถ้าเนื้อหาเหมาะกับ medium ให้กลับไปใช้สองขั้นของระบบ (medium และ large) สัดส่วนขยับตามเมื่อหน้าจอใหญ่หรือเล็ก และ detent ของระบบคือความสูงที่ผ่านการตรวจสอบบนทุกอุปกรณ์แล้ว ไม่ว่าแบบใด ให้เปิดสักครั้งด้วยการตั้งค่าตัวอักษรใหญ่และตรวจว่าแถวสุดท้ายมองเห็น ตัวอย่าง 4.1.3 Presentation Detent: Custom ของแอปแสดง detent ที่พอดีกับความสูงโดยธรรมชาติของเนื้อหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay vì pixel cố định, chỉ định tỷ lệ màn hình như `.fraction(0.3)`, hoặc nếu nội dung hợp với medium thì quay về hai bậc của hệ thống (medium và large). Tỷ lệ di chuyển theo khi màn hình to nhỏ, còn detent của hệ thống là các chiều cao đã được kiểm chứng trên mọi thiết bị. Dù cách nào, hãy mở một lần với cỡ chữ lớn và kiểm tra dòng cuối còn thấy không. Ví dụ 4.1.3 Presentation Detent: Custom của app cho thấy một detent vừa với chiều cao nội tại của nội dung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místo pevných pixelů zadejte poměr obrazovky jako `.fraction(0.3)`, nebo pokud se obsah hodí k medium, vraťte se ke dvěma krokům systému (medium a large). Poměr se pohybuje spolu s tím, jak je obrazovka větší nebo menší, a systémové detenty jsou výšky už ověřené na každém zařízení. V obou případech to jednou otevřete s nastavením velkého textu a zkontrolujte, že je poslední řádek vidět. Příklad 4.1.3 Presentation Detent: Custom aplikace ukazuje detent přizpůsobený vnitřní výšce obsahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I stedet for faste pixels, angiv en andel af skærmen som `.fraction(0.3)`, eller hvis indholdet passer til medium, gå tilbage til systemets to trin (medium og large). En andel flytter sig med, når skærmen bliver større eller mindre, og systemets detents er højder, der allerede er valideret på alle enheder. Uanset hvad, åbn den én gang med en stor tekstindstilling, og tjek, at den sidste række er synlig. Appens eksempel 4.1.3 Presentation Detent: Brugerdefineret viser en detent tilpasset indholdets egen højde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντί για σταθερά pixels, όρισε ένα ποσοστό της οθόνης όπως `.fraction(0.3)`, ή αν το περιεχόμενο ταιριάζει στο medium, γύρνα στα δύο βήματα του συστήματος (medium και large). Ένα ποσοστό μετακινείται καθώς η οθόνη μεγαλώνει ή μικραίνει, και τα detents του συστήματος είναι ύψη που έχουν ήδη επικυρωθεί σε κάθε συσκευή. Έτσι κι αλλιώς, άνοιξέ το μία φορά με ρύθμιση μεγάλου κειμένου και έλεγξε ότι η τελευταία γραμμή είναι ορατή. Το παράδειγμα 4.1.3 Presentation Detent: Προσαρμοσμένο της εφαρμογής δείχνει ένα detent προσαρμοσμένο στο εγγενές ύψος του περιεχομένου."
          }
        }
      }
    },
    "고정 px보다 .fraction이나 콘텐츠 크기 기반이 안전합니다, Dynamic Type 큰 글씨에서 내용이 잘리는지 꼭 확인하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction or content-based sizing is safer than fixed pixel values. Always check whether content gets clipped at large Dynamic Type sizes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction or content-based sizing is safer than fixed pixel values. Always check whether content gets clipped at large Dynamic Type sizes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定のピクセル値より、.fractionやコンテンツのサイズに基づくほうが安全です。Dynamic Type（文字サイズ）を大きくしたときに内容が切れないか、必ず確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比起固定 px，.fraction 或基于内容大小更安全，一定要确认 Dynamic Type 大字号下内容是否被截断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比起固定 px，.fraction 或基於內容大小更安全，一定要確認 Dynamic Type 大字號下內容是否被截斷。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction или размер по содержимому надёжнее фиксированных пикселей. Обязательно проверяйте, не обрезается ли содержимое при крупных размерах Dynamic Type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction o el dimensionado según el contenido es más seguro que los valores de píxeles fijos. Comprueba siempre si el contenido se recorta con tamaños grandes de Dynamic Type."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction oder inhaltsbasierte Bemessung ist sicherer als feste Pixelwerte. Prüfe stets, ob Inhalt bei großen Dynamic-Type-Größen abgeschnitten wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction ou un dimensionnement fondé sur le contenu est plus sûr que des valeurs en pixels fixes. Vérifiez toujours si le contenu est coupé aux grandes tailles Dynamic Type."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction o il dimensionamento basato sul contenuto è più sicuro dei valori in pixel fissi. Controlla sempre se il contenuto viene tagliato alle dimensioni grandi di Dynamic Type."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction ou o dimensionamento baseado no conteúdo é mais seguro que valores de pixel fixos. Confira sempre se o conteúdo é cortado nos tamanhos grandes de Dynamic Type."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction หรือการกำหนดขนาดตามเนื้อหาปลอดภัยกว่าค่าพิกเซลตายตัว ตรวจเสมอว่าเนื้อหาถูกตัดที่ขนาด Dynamic Type ใหญ่หรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction hoặc cỡ theo nội dung an toàn hơn giá trị pixel cố định. Luôn kiểm tra nội dung có bị cắt ở cỡ Dynamic Type lớn không."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction nebo velikost podle obsahu je bezpečnější než pevné hodnoty v pixelech. Vždy zkontrolujte, zda se obsah při velkých velikostech Dynamic Type neořezává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ".fraction eller indholdsbaseret størrelse er sikrere end faste pixelværdier. Tjek altid, om indhold bliver klippet ved store Dynamic Type-størrelser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το .fraction ή η διαστασιολόγηση βάσει περιεχομένου είναι ασφαλέστερα από σταθερές τιμές pixel. Έλεγχε πάντα αν το περιεχόμενο κόβεται σε μεγάλα μεγέθη Dynamic Type."
          }
        }
      }
    },
    "고정 색 배경은 배경과 단절된 “스티커”처럼 보입니다, material은 뒤를 비춤으로써 **“이 레이어는 콘텐츠 위에 떠 있다”는 깊이 관계**를 형태로 표현합니다. 라이트/다크·배경 밝기에 맞춰 시스템이 자동 보정하므로, 개발자가 배경별 색을 계산하지 않아도 대비가 유지됨, material이 “색”이 아니라 “재질”인 이유.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed-color background looks like a \"sticker\" cut off from what's behind it. A material shows the background through, expressing **the depth relationship \"this layer floats above the content\"** in its very form. The system adjusts automatically for light/dark and background brightness, so contrast holds without developers working out a color for each background. That's why a material is a \"material,\" not a \"color.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed-colour background looks like a \"sticker\" cut off from what's behind it. A material shows the background through, expressing **the depth relationship \"this layer floats above the content\"** in its very form. The system adjusts automatically for light/dark and background brightness, so contrast holds without developers working out a colour for each background. That's why a material is a \"material,\" not a \"colour.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定色の背景は、背後から切り離された「ステッカー」のように見えます。materialは背後を透かすことで、**「このレイヤーはコンテンツの上に浮いている」という奥行きの関係**を形で表現します。ライト／ダークや背景の明るさに合わせてシステムが自動で補正するので、開発者が背景ごとの色を計算しなくてもコントラストが保たれる。materialが「色」ではなく「素材」である理由。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定颜色的背景看起来像和背景脱节的“贴纸”。material 通过透出背后，用形态表达**“这一层浮在内容之上”的纵深关系**。系统会按亮色/深色和背景亮度自动校正，开发者不必按背景计算颜色，对比度也能保持。这就是 material 是“材质”而不是“颜色”的原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定顏色的背景看起來像和背景脫節的「貼紙」。material 透過透出背後，用形態表達**「這一層浮在內容之上」的縱深關係**。系統會按亮色/深色和背景亮度自動校正，開發者不必按背景計算顏色，對比度也能保持。這就是 material 是「材質」而不是「顏色」的原因。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон фиксированного цвета выглядит «наклейкой», оторванной от того, что позади. Материал пропускает фон, выражая самой формой **отношение глубины «этот слой парит над контентом»**. Система автоматически подстраивается под светлую/тёмную тему и яркость фона, так что контраст сохраняется без расчёта цвета под каждый фон. Поэтому материал - это «материал», а не «цвет»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fondo de color fijo parece una «pegatina» desligada de lo que hay detrás. Un material deja ver el fondo, expresando en su propia forma **la relación de profundidad «esta capa flota sobre el contenido»**. El sistema se ajusta automáticamente a claro/oscuro y al brillo del fondo, así que el contraste se mantiene sin que los desarrolladores calculen un color para cada fondo. Por eso un material es un «material», no un «color»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hintergrund in fester Farbe wirkt wie ein „Aufkleber“, abgeschnitten von dem, was dahinter liegt. Ein Material lässt den Hintergrund durchscheinen und drückt **die Tiefenbeziehung „diese Ebene schwebt über dem Inhalt“** schon in seiner Form aus. Das System stellt sich automatisch auf hell/dunkel und die Helligkeit des Hintergrunds ein, sodass der Kontrast hält, ohne dass Entwickler für jeden Hintergrund eine Farbe errechnen. Deshalb ist ein Material ein „Material“ und keine „Farbe“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fond de couleur fixe ressemble à un « autocollant » découpé de ce qui est derrière. Un matériau laisse transparaître l'arrière-plan, exprimant **la relation de profondeur « cette couche flotte au-dessus du contenu »** dans sa forme même. Le système s'ajuste automatiquement au clair/sombre et à la luminosité de l'arrière-plan, si bien que le contraste tient sans que les développeurs calculent une couleur pour chaque arrière-plan. C'est pourquoi un matériau est un « matériau », pas une « couleur »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno sfondo di colore fisso sembra un «adesivo» staccato da ciò che sta dietro. Un materiale lascia trasparire lo sfondo, esprimendo nella sua stessa forma **la relazione di profondità «questo strato galleggia sopra il contenuto»**. Il sistema si adatta automaticamente a chiaro/scuro e alla luminosità dello sfondo, quindi il contrasto regge senza che gli sviluppatori calcolino un colore per ogni sfondo. Per questo un materiale è un «materiale», non un «colore»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um fundo de cor fixa parece um «adesivo» recortado do que está atrás. Um material deixa o fundo transparecer, expressando na própria forma **a relação de profundidade «esta camada flutua sobre o conteúdo»**. O sistema se ajusta automaticamente a claro/escuro e ao brilho do fundo, então o contraste se mantém sem que os desenvolvedores calculem uma cor para cada fundo. Por isso um material é um «material», não uma «cor»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นหลังสีตายตัวดูเหมือน \"สติกเกอร์\" ที่ขาดจากสิ่งด้านหลัง วัสดุให้พื้นหลังมองทะลุ แสดง**ความสัมพันธ์เชิงความลึก \"ชั้นนี้ลอยอยู่เหนือเนื้อหา\"** ในรูปทรงของมันเอง ระบบปรับอัตโนมัติตามสว่าง/มืดและความสว่างพื้นหลัง ความตัดกันจึงคงอยู่โดยนักพัฒนาไม่ต้องคำนวณสีสำหรับแต่ละพื้นหลัง นั่นคือเหตุผลที่วัสดุเป็น \"วัสดุ\" ไม่ใช่ \"สี\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nền màu cố định trông như \"miếng dán\" cắt rời khỏi thứ phía sau. Vật liệu cho thấy nền xuyên qua, biểu đạt ngay trong hình thức **quan hệ chiều sâu \"lớp này nổi trên nội dung\"**. Hệ thống tự điều chỉnh theo sáng/tối và độ sáng nền, nên độ tương phản giữ vững mà nhà phát triển không phải tính màu cho từng nền. Vì thế vật liệu là \"vật liệu\", không phải \"màu\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadí pevné barvy vypadá jako „nálepka“ odříznutá od toho, co je za ní. Materiál nechává pozadí prosvítat a vyjadřuje **vztah hloubky „tato vrstva se vznáší nad obsahem“** ve své samotné formě. Systém se přizpůsobuje světlému/tmavému režimu a jasu pozadí automaticky, takže kontrast drží, aniž by vývojáři museli vymýšlet barvu pro každé pozadí. Proto je materiál „materiál“, ne „barva“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En baggrund i fast farve ligner et »klistermærke«, skåret af fra det bagved. Et materiale lader baggrunden skinne igennem og udtrykker **dybderelationen »dette lag svæver over indholdet«** i selve sin form. Systemet justerer automatisk for lys/mørk og baggrundens lysstyrke, så kontrasten holder uden at udviklere skal regne en farve ud til hver baggrund. Derfor er et materiale et »materiale«, ikke en »farve«."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα φόντο σταθερού χρώματος μοιάζει με «αυτοκόλλητο» αποκομμένο από ό,τι υπάρχει πίσω. Ένα υλικό αφήνει το φόντο να διαφαίνεται, εκφράζοντας **τη σχέση βάθους «αυτό το στρώμα επιπλέει πάνω από το περιεχόμενο»** στην ίδια του τη μορφή. Το σύστημα προσαρμόζεται αυτόματα για φωτεινό/σκοτεινό και φωτεινότητα φόντου, οπότε η αντίθεση κρατά χωρίς οι προγραμματιστές να υπολογίζουν χρώμα για κάθε φόντο. Γι' αυτό ένα υλικό είναι «υλικό», όχι «χρώμα»."
          }
        }
      }
    },
    "고정 크기로 그려야 시안과 픽셀이 맞는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing it at a fixed size is the only way to match the mockup pixel for pixel."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing it at a fixed size is the only way to match the mockup pixel for pixel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定サイズで描かないと、カンプとピクセルが合わない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须按固定尺寸画，才能和设计稿像素对齐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必須按固定尺寸畫，才能和設計稿畫素對齊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисовать фиксированного размера - единственный способ совпасть с макетом до пикселя."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibujarlo a tamaño fijo es la única forma de igualar la maqueta píxel por píxel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In fester Größe zu zeichnen ist der einzige Weg, das Mockup pixelgenau zu treffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessiner à une taille fixe est le seul moyen de coller à la maquette au pixel près."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegnarlo a dimensione fissa è l'unico modo per corrispondere al mockup pixel per pixel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhá-lo em tamanho fixo é o único jeito de bater com o mockup pixel a pixel."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวาดที่ขนาดตายตัวเป็นวิธีเดียวที่จะตรงกับม็อกอัปพิกเซลต่อพิกเซล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ ở kích thước cố định là cách duy nhất để khớp từng pixel với bản mockup."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreslit to pevnou velikostí je jediný způsob, jak se shodnout s mockupem na pixel."
          }
        },
