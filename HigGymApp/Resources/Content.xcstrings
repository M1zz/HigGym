        }
      }
    },
    "몰입이 목적인 화면에서는 숨긴다. 유일한 예외 지대다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide it on screens meant for immersion. That's the one exception zone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide it on screens meant for immersion. That's the one exception zone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "没入が目的の画面では隠す。それが唯一の例外ゾーンだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以沉浸为目的的界面里要隐藏。这是唯一的例外地带。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以沉浸為目的的介面裡要隱藏。這是唯一的例外地帶。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывайте на экранах, созданных для погружения. Это единственная зона исключения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocúltala en pantallas pensadas para la inmersión. Esa es la única zona de excepción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verberge sie auf Bildschirmen, die für Immersion gedacht sind. Das ist die einzige Ausnahmezone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez-la sur les écrans conçus pour l'immersion. C'est la seule zone d'exception."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondila nelle schermate pensate per l'immersione. Quella è l'unica zona di eccezione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte nas telas pensadas para imersão. Essa é a única zona de exceção."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนบนหน้าจอที่มีไว้เพื่อความดื่มด่ำ นั่นคือโซนข้อยกเว้นเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn nó trên màn hình dành cho sự đắm chìm. Đó là vùng ngoại lệ duy nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryjte ho na obrazovkách určených k pohlcení. To je jediná výjimečná zóna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjul den på skærme beregnet til fordybelse. Det er den ene undtagelseszone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρύψ' την σε οθόνες που προορίζονται για εμβύθιση. Αυτή είναι η μία ζώνη εξαίρεσης."
          }
        }
      }
    },
    "몰입할 것이 없는 화면에서 숨기면 이동성만 잃는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding it on a screen with nothing to immerse in only costs you mobility."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding it on a screen with nothing to immerse in only costs you mobility."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "没入するものがない画面で隠しても、移動のしやすさを失うだけだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在没有什么需要沉浸的界面里隐藏，只会失去可移动性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在沒有什麼需要沉浸的介面裡隱藏，只會失去可移動性。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрытие на экране, где нечем погружаться, стоит лишь подвижности."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultarla en una pantalla sin nada en lo que sumergirse solo te cuesta movilidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie auf einem Bildschirm ohne etwas zum Eintauchen zu verbergen, kostet dich nur Mobilität."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La masquer sur un écran où il n'y a rien dans quoi s'immerger ne vous coûte que de la mobilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconderla in una schermata senza nulla in cui immergersi ti costa solo mobilità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar numa tela sem nada em que se imergir só lhe custa mobilidade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซ่อนบนหน้าจอที่ไม่มีอะไรให้ดื่มด่ำ เสียแค่ความคล่องตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn nó trên màn hình không có gì để đắm chìm chỉ làm bạn mất tính cơ động."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrytí na obrazovce, kde není do čeho se pohltit, vás stojí jen pohyblivost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At skjule den på en skærm uden noget at fordybe sig i koster dig kun mobilitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απόκρυψή της σε οθόνη χωρίς τίποτα για εμβύθιση σου κοστίζει μόνο κινητικότητα."
          }
        }
      }
    },
    "무게는 크기가 아니라 문구로 준다. 확인은 alert나 작은 시트로.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give weight through wording, not size. Use an alert or a small sheet for confirmations."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Give weight through wording, not size. Use an alert or a small sheet for confirmations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重みはサイズではなく文言で与える。確認は alert か小さなシートで。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分量靠措辞来给，而不是靠尺寸。确认用 alert 或小弹层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分量靠措辭來給，而不是靠尺寸。確認用 alert 或小工作表。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вес придают формулировкой, а не размером. Для подтверждений используйте alert или небольшую шторку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da peso con las palabras, no con el tamaño. Usa una alerta o una hoja pequeña para las confirmaciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Gewicht durch Wortwahl, nicht durch Größe. Nutze für Bestätigungen einen Alert oder ein kleines Sheet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez du poids par la formulation, pas par la taille. Utilisez une alerte ou une petite feuille pour les confirmations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai peso con le parole, non con la dimensione. Usa un avviso o un piccolo foglio per le conferme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê peso pelas palavras, não pelo tamanho. Use um alerta ou uma pequena folha para confirmações."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้น้ำหนักด้วยถ้อยคำ ไม่ใช่ขนาด ใช้การแจ้งเตือนหรือชีตเล็กสำหรับการยืนยัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo trọng lượng bằng lời lẽ, không bằng kích thước. Dùng alert hoặc sheet nhỏ cho xác nhận."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dávejte váhu formulací, ne velikostí. Pro potvrzení použijte alert nebo malý sheet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv vægt gennem formulering, ikke størrelse. Brug en advarsel eller et lille ark til bekræftelser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώσε βάρος μέσω διατύπωσης, όχι μεγέθους. Χρησιμοποίησε μια ειδοποίηση ή ένα μικρό φύλλο για επιβεβαιώσεις."
          }
        }
      }
    },
    "무엇을 포기할지 먼저 정한다. 검색이 가끔 쓰는 기능이라면 분리 캡슐 대신 목록 화면의 `.searchable` 로 내린다. 하단 툴바 액션은 상단으로 올린다. 풀 구성이 정말 필요하다면 최소화를 켜서 콘텐츠를 볼 때는 탭바가 물러나게 한다. 앱의 3.5.3 예제가 풀 구성의 모습을 보여 주니, 거기서 무엇을 빼도 되는지 하나씩 지워 보며 비교하면 좋다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide first what to give up. If search is used only occasionally, demote it from the separate capsule to `.searchable` on the list screen. Move bottom toolbar actions to the top. If you truly need the full setup, turn on minimizing so the tab bar steps back while people view content. The app's 3.5.3 example shows the full setup, so try removing things one at a time there and compare to see what you can drop."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide first what to give up. If search is used only occasionally, demote it from the separate capsule to `.searchable` on the list screen. Move bottom toolbar actions to the top. If you truly need the full setup, turn on minimising so the tab bar steps back while people view content. The app's 3.5.3 example shows the full setup, so try removing things one at a time there and compare to see what you can drop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何をあきらめるかを先に決める。検索がたまにしか使わない機能なら、分離されたカプセルではなくリスト画面の `.searchable` に格下げする。下部ツールバーのアクションは上部に移す。フル構成が本当に必要なら、最小化をオンにして、コンテンツを見ている間はタブバーが退くようにする。アプリの 3.5.3 の例がフル構成の姿を見せてくれるので、そこから何を外してもいいか、ひとつずつ消しながら比べてみるといい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先定好放弃什么。如果搜索只是偶尔使用的功能，就不用分离胶囊，而是下放到列表界面的 `.searchable`。底部工具栏的操作上移到顶部。如果真的需要完整配置，就打开最小化，让标签栏在看内容时退后。应用的 3.5.3 示例展示了完整配置的样子，在那里把能删的一个个删掉对比，会很有帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先定好放棄什麼。如果搜尋只是偶爾使用的功能，就不用分離膠囊，而是下放到列表介面的 `.searchable`。底部工具列的操作上移到頂部。如果真的需要完整配置，就開啟最小化，讓標籤列在看內容時退後。應用程式的 3.5.3 示例展示了完整配置的樣子，在那裡把能刪的一個個刪掉對比，會很有幫助。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала решите, чем пожертвовать. Если поиск используется лишь изредка, переведите его из отдельной капсулы в `.searchable` на экране списка. Действия нижней панели инструментов поднимите наверх. Если полная конфигурация действительно нужна, включите минимизацию, чтобы панель вкладок отступала, пока люди смотрят контент. Пример 3.5.3 показывает полную конфигурацию, так что попробуйте убирать там элементы по одному и сравнивайте, от чего можно отказаться."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide primero a qué renunciar. Si la búsqueda se usa solo de vez en cuando, degrádala de la cápsula separada a `.searchable` en la pantalla de lista. Pasa las acciones de la barra de herramientas inferior arriba. Si de verdad necesitas la configuración completa, activa la minimización para que la barra de pestañas retroceda mientras la gente ve contenido. El ejemplo 3.5.3 de la app muestra la configuración completa, así que prueba a quitar cosas una por una ahí y compara para ver qué puedes descartar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide zuerst, worauf du verzichtest. Wird die Suche nur gelegentlich genutzt, stufe sie von der separaten Kapsel auf `.searchable` am Listenbildschirm herab. Verschiebe Aktionen der unteren Symbolleiste nach oben. Brauchst du wirklich das volle Setup, schalte das Minimieren ein, damit die Tab-Leiste zurücktritt, während Menschen Inhalt ansehen. Das Beispiel 3.5.3 der App zeigt das volle Setup, also versuche dort, Dinge einzeln zu entfernen, und vergleiche, worauf du verzichten kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décidez d'abord ce à quoi renoncer. Si la recherche n'est utilisée qu'occasionnellement, rétrogradez-la de la capsule séparée à `.searchable` sur l'écran de liste. Déplacez les actions de la barre d'outils du bas vers le haut. Si vous avez vraiment besoin de la configuration complète, activez la réduction pour que la barre d'onglets s'efface pendant que les gens regardent le contenu. L'exemple 3.5.3 de l'app montre la configuration complète, donc essayez d'y retirer des choses une à une et comparez pour voir ce que vous pouvez abandonner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi prima a che cosa rinunciare. Se la ricerca si usa solo ogni tanto, declassala dalla capsula separata a `.searchable` sulla schermata a elenco. Sposta in alto le azioni della barra degli strumenti in basso. Se ti serve davvero la configurazione completa, attiva la riduzione così la barra delle schede si fa da parte mentre le persone guardano il contenuto. L'esempio 3.5.3 dell'app mostra la configurazione completa, quindi prova a togliere le cose una alla volta lì e confronta per vedere a che cosa puoi rinunciare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Decida primeiro a que renunciar. Se a busca é usada só de vez em quando, rebaixe-a da cápsula separada para `.searchable` na tela de lista. Mova para o topo as ações da barra de ferramentas inferior. Se você realmente precisa da configuração completa, ative a minimização para a barra de abas recuar enquanto as pessoas veem o conteúdo. O exemplo 3.5.3 do app mostra a configuração completa, então tente tirar coisas uma de cada vez ali e compare para ver o que dá para abrir mão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัดสินใจก่อนว่าจะสละอะไร ถ้าการค้นหาใช้เพียงนาน ๆ ครั้ง ลดระดับจากแคปซูลแยกเป็น `.searchable` บนหน้ารายการ ย้ายการกระทำของแถบเครื่องมือล่างไปด้านบน ถ้าจำเป็นต้องมีการตั้งค่าเต็มรูปแบบจริง ๆ ให้เปิดการย่อเพื่อให้แถบแท็บถอยขณะคนดูเนื้อหา ตัวอย่าง 3.5.3 ของแอปแสดงการตั้งค่าเต็มรูปแบบ ลองเอาออกทีละอย่างที่นั่นแล้วเปรียบเทียบดูว่าทิ้งอะไรได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyết định trước cái gì phải bỏ. Nếu tìm kiếm chỉ thỉnh thoảng dùng, hạ nó từ capsule riêng xuống `.searchable` trên màn hình danh sách. Chuyển hành động của thanh công cụ dưới lên trên. Nếu thật sự cần bộ đầy đủ, bật thu gọn để thanh tab lùi lại trong lúc người ta xem nội dung. Ví dụ 3.5.3 của app cho thấy bộ đầy đủ, nên hãy thử bỏ từng thứ ở đó và so sánh để biết có thể bỏ gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív rozhodněte, čeho se vzdát. Pokud se hledání používá jen občas, degradujte ho ze samostatné kapsle na `.searchable` na obrazovce se seznamem. Akce spodního panelu nástrojů přesuňte nahoru. Pokud opravdu potřebujete plné nastavení, zapněte minimalizaci, aby panel karet ustoupil, zatímco lidé prohlížejí obsah. Příklad 3.5.3 aplikace ukazuje plné nastavení, takže zkuste odebírat věci po jedné a porovnávat, co se dá vynechat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beslut først, hvad du vil opgive. Hvis søgning kun bruges en gang imellem, så nedgrader den fra den separate kapsel til `.searchable` på listeskærmen. Flyt handlinger i den nederste værktøjslinje til toppen. Hvis du virkelig har brug for den fulde opsætning, så slå minimering til, så fanelinjen træder tilbage, mens folk ser indhold. Appens eksempel 3.5.3 viser den fulde opsætning, så prøv at fjerne ting ét ad gangen der og sammenlign for at se, hvad du kan undvære."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποφάσισε πρώτα τι θα εγκαταλείψεις. Αν η αναζήτηση χρησιμοποιείται μόνο περιστασιακά, υποβάθμισέ την από την ξεχωριστή κάψουλα σε `.searchable` στην οθόνη λίστας. Μετάφερε ενέργειες της κάτω γραμμής εργαλείων στην κορυφή. Αν πραγματικά χρειάζεσαι την πλήρη διάταξη, ενεργοποίησε την ελαχιστοποίηση ώστε η γραμμή καρτελών να υποχωρεί ενώ οι άνθρωποι βλέπουν περιεχόμενο. Το παράδειγμα 3.5.3 της εφαρμογής δείχνει την πλήρη διάταξη, οπότε δοκίμασε να αφαιρέσεις πράγματα ένα-ένα εκεί και σύγκρινε για να δεις τι μπορείς να παραλείψεις."
          }
        }
      }
    },
    "무엇이 부러졌나": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What broke"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What broke"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が壊れたのか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么断了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼斷了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что сломалось"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué se rompió"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was kaputtging"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui a cassé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa si è rotto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que quebrou"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่พัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cái gì đã hỏng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co se rozbilo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, der gik i stykker"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι χάλασε"
          }
        }
      }
    },
    "무엇이 식별에 쓰이는지로 정한다. 주문번호·파일명은 끝이 살아야 하므로 middle이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide by what is used for identification. Order numbers and file names need their endings intact, so use middle."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide by what is used for identification. Order numbers and file names need their endings intact, so use middle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が識別に使われるかで決める。注文番号やファイル名は末尾が残らないといけないので、middleだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按用什么来识别决定。订单号、文件名要保住结尾，所以用 middle。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按用什麼來識別決定。訂單號、檔名要保住結尾，所以用 middle。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решайте по тому, что используется для идентификации. У номеров заказов и имён файлов должен быть цел конец, поэтому middle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide por lo que se usa para identificar. Los números de pedido y los nombres de archivo necesitan sus finales intactos, así que usa middle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide danach, was zur Identifizierung dient. Bestellnummern und Dateinamen brauchen ihre Enden unversehrt, also nutze middle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décidez selon ce qui sert à l'identification. Les numéros de commande et les noms de fichiers ont besoin que leur fin reste intacte, donc utilisez middle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi in base a ciò che serve per l'identificazione. Numeri d'ordine e nomi di file hanno bisogno che la fine sia intatta, quindi usa middle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Decida pelo que serve para identificação. Números de pedido e nomes de arquivo precisam do final intacto, então use middle."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัดสินจากสิ่งที่ใช้ระบุตัวตน เลขคำสั่งซื้อและชื่อไฟล์ต้องคงส่วนท้าย จึงใช้ middle"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyết định theo thứ dùng để nhận diện. Mã đơn hàng và tên tệp cần phần cuối còn nguyên, nên dùng middle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozhodněte podle toho, co se používá k identifikaci. Čísla objednávek a názvy souborů potřebují zachované konce, takže použijte middle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgør efter det, der bruges til identifikation. Ordrenumre og filnavne har brug for, at deres ender er intakte, så brug middle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποφάσισε με βάση αυτό που χρησιμοποιείται για την αναγνώριση. Οι αριθμοί παραγγελίας και τα ονόματα αρχείων χρειάζονται τα τέλη τους άθικτα, οπότε χρησιμοποίησε middle."
          }
        }
      }
    },
    "묶음은 곧 '한 세트'라는 선언이다. 도구는 도구끼리, 확정 액션은 따로 떼어 놓는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group is a declaration that \"these are one set.\" Keep tools with tools, and set commit actions apart."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A group is a declaration that \"these are one set.\" Keep tools with tools, and set commit actions apart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まとまりは「ひとつのセット」だという宣言だ。ツールはツール同士で、確定のアクションは別に離しておく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分组就是“同一组”的宣告。工具和工具放一起，确认操作单独分开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分組就是「同一組」的宣告。工具和工具放一起，確認操作單獨分開。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группа - заявление «это один набор». Держите инструменты с инструментами, а подтверждающие действия отделяйте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grupo es una declaración de que «estos son un conjunto». Mantén las herramientas con las herramientas y pon aparte las acciones de confirmación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gruppe ist eine Erklärung, dass „dies ein Set ist“. Halte Werkzeuge bei Werkzeugen und setze Bestätigungsaktionen ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un groupe est une déclaration que « ceci forme un ensemble ». Gardez les outils avec les outils, et mettez à part les actions de validation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gruppo è una dichiarazione che «questi sono un insieme». Tieni gli strumenti con gli strumenti e metti a parte le azioni di conferma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um grupo é uma declaração de que «estes são um conjunto». Mantenha ferramentas com ferramentas e deixe as ações de confirmação à parte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลุ่มคือคำประกาศว่า \"นี่คือชุดเดียว\" เก็บเครื่องมือไว้กับเครื่องมือ และแยกการกระทำเพื่อยืนยันออกไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nhóm là lời tuyên bố \"đây là một bộ.\" Giữ công cụ với công cụ, và tách riêng các hành động xác nhận."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupina je prohlášení „toto je jedna sada“. Nástroje držte s nástroji a potvrzující akce oddělte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gruppe er en erklæring om, at »disse er ét sæt.« Hold værktøjer sammen med værktøjer, og sæt forpligtende handlinger for sig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ομάδα είναι δήλωση ότι «αυτά είναι ένα σύνολο». Κράτα εργαλεία με εργαλεία, και χώρισε τις δεσμευτικές ενέργειες."
          }
        }
      }
    },
    "문단에서 축소를 뺀다. 본문은 줄 수로 다룬다. 상세 화면이면 줄 수 제한 없이 스크롤해서 읽고, 목록의 미리보기라면 `lineLimit`으로 자른다. 모든 화면의 본문이 같은 크기가 되고, 글이 길면 화면이 길어질 뿐 글자는 작아지지 않는다. 축소는 금액·타이머 같은 한 줄 값에만 남긴다. 2.1.3 예제에서 축소가 어떤 텍스트를 위한 것인지 확인할 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove scaling from paragraphs and handle body text with line counts. On a detail screen, let it scroll with no line limit; in a list preview, truncate it with `lineLimit`. Body text becomes the same size on every screen, and long text just makes the screen longer without making the text smaller. Keep scaling only for single-line values like amounts and timers. The 2.1.3 example shows what kind of text scaling is meant for."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove scaling from paragraphs and handle body text with line counts. On a detail screen, let it scroll with no line limit; in a list preview, truncate it with `lineLimit`. Body text becomes the same size on every screen, and long text just makes the screen longer without making the text smaller. Keep scaling only for single-line values like amounts and timers. The 2.1.3 example shows what kind of text scaling is meant for."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "段落から縮小を外し、本文は行数で扱う。詳細画面なら行数の制限なしにスクロールして読ませ、リストのプレビューなら `lineLimit` で切り詰める。すべての画面で本文が同じサイズになり、文章が長ければ画面が長くなるだけで文字は小さくならない。縮小は金額・タイマーのような1行の値にだけ残す。縮小がどんなテキストのためのものかは、2.1.3の例で確かめられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "段落去掉缩小。正文按行数处理。详情界面不限行数、滚动阅读；列表里的预览则用 `lineLimit` 截断。所有界面的正文大小一致，文章长了只是界面变长，字不会变小。缩小只留给金额、计时器这类一行的值。在 2.1.3 示例里可以确认缩小是为哪类文字准备的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "段落去掉縮小。正文按行數處理。詳情介面不限行數、滾動閱讀；列表裡的預覽則用 `lineLimit` 截斷。所有介面的正文大小一致，文章長了只是介面變長，字不會變小。縮小隻留給金額、計時器這類一行的值。在 2.1.3 示例裡可以確認縮小是為哪類文字準備的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите масштабирование из абзацев и работайте с основным текстом через число строк. На экране подробностей пусть прокручивается без ограничения строк; в предпросмотре списка обрезайте через `lineLimit`. Основной текст получает одинаковый размер на всех экранах, а длинный текст лишь удлиняет экран, не уменьшая текст. Масштабирование оставьте только для однострочных значений вроде сумм и таймеров. Пример 2.1.3 показывает, для какого текста предназначено масштабирование."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita el escalado de los párrafos y gestiona el texto del cuerpo con el número de líneas. En una pantalla de detalle, déjalo desplazarse sin límite de líneas; en una vista previa de lista, trúncalo con `lineLimit`. El texto del cuerpo queda del mismo tamaño en todas las pantallas, y el texto largo solo alarga la pantalla sin hacer más pequeño el texto. Deja el escalado solo para valores de una línea como importes y temporizadores. El ejemplo 2.1.3 muestra para qué tipo de texto está pensado el escalado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne die Skalierung von Absätzen und behandle Fließtext mit Zeilenzahlen. Lass ihn auf einem Detailbildschirm ohne Zeilenlimit scrollen; in einer Listenvorschau schneide ihn mit `lineLimit` ab. Fließtext hat auf jedem Bildschirm dieselbe Größe, und langer Text macht nur den Bildschirm länger, ohne den Text zu verkleinern. Behalte die Skalierung nur für einzeilige Werte wie Beträge und Timer. Das Beispiel 2.1.3 zeigt, für welche Art von Text die Skalierung gedacht ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez la mise à l'échelle des paragraphes et traitez le corps du texte avec des nombres de lignes. Sur un écran de détail, laissez-le défiler sans limite de lignes ; dans un aperçu de liste, tronquez-le avec `lineLimit`. Le corps du texte a la même taille sur chaque écran, et un long texte rend simplement l'écran plus long sans rendre le texte plus petit. Ne gardez la mise à l'échelle que pour les valeurs d'une ligne comme les montants et les minuteurs. L'exemple 2.1.3 montre à quel genre de texte la mise à l'échelle est destinée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli la scalatura dai paragrafi e gestisci il testo del corpo con il numero di righe. In una schermata di dettaglio lascialo scorrere senza limite di righe; nell'anteprima di un elenco, troncalo con `lineLimit`. Il testo del corpo ha la stessa dimensione in ogni schermata, e un testo lungo fa solo diventare più lunga la schermata senza rimpicciolire il testo. Tieni la scalatura solo per valori su una riga come importi e timer. L'esempio 2.1.3 mostra per che tipo di testo è pensata la scalatura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire a escala dos parágrafos e trate o texto do corpo com a contagem de linhas. Numa tela de detalhe, deixe rolar sem limite de linhas; numa prévia de lista, trunque com `lineLimit`. O texto do corpo fica do mesmo tamanho em toda tela, e o texto longo só faz a tela ficar mais comprida sem encolher o texto. Mantenha a escala só para valores de uma linha como valores monetários e cronômetros. O exemplo 2.1.3 mostra para que tipo de texto a escala é pensada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาการปรับขนาดออกจากย่อหน้า และจัดการเนื้อความด้วยจำนวนบรรทัด บนหน้ารายละเอียด ให้เลื่อนได้โดยไม่จำกัดบรรทัด ในตัวอย่างรายการ ตัดด้วย `lineLimit` เนื้อความมีขนาดเท่ากันทุกหน้าจอ และข้อความยาวแค่ทำให้หน้าจอยาวขึ้นโดยไม่ทำให้ข้อความเล็กลง คงการปรับขนาดไว้เฉพาะค่าบรรทัดเดียวอย่างจำนวนเงินและตัวจับเวลา ตัวอย่าง 2.1.3 แสดงว่าการปรับขนาดข้อความมีไว้สำหรับข้อความแบบไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ co chữ khỏi đoạn văn và xử lý nội dung bằng số dòng. Trên màn hình chi tiết, cho cuộn không giới hạn dòng; trong bản xem trước của danh sách, cắt bằng `lineLimit`. Nội dung có cùng cỡ trên mọi màn hình, và văn bản dài chỉ làm màn hình dài ra chứ không làm chữ nhỏ đi. Chỉ giữ co chữ cho giá trị một dòng như số tiền và hẹn giờ. Ví dụ 2.1.3 cho thấy co chữ dành cho loại văn bản nào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeberte škálování u odstavců a text řešte počtem řádků. Na detailní obrazovce nechte posouvat bez limitu řádků; v ukázce v seznamu ořízněte pomocí `lineLimit`. Text bude mít na každé obrazovce stejnou velikost a dlouhý text jen prodlouží obrazovku, aniž by zmenšil písmo. Škálování ponechte jen pro jednořádkové hodnoty jako částky a časovače. Příklad 2.1.3 ukazuje, pro jaký druh textu je škálování určeno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern skalering fra afsnit, og håndtér brødtekst med linjeantal. På en detaljeskærm, lad den scrolle uden linjegrænse; i en listeforhåndsvisning, afkort den med `lineLimit`. Brødtekst bliver samme størrelse på hver skærm, og lang tekst gør bare skærmen længere uden at gøre teksten mindre. Behold kun skalering til enkeltlinjeværdier som beløb og timere. Eksempel 2.1.3 viser, hvilken slags tekst skalering er beregnet til."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεσε την κλιμάκωση από τις παραγράφους και χειρίσου το κείμενο με αριθμό γραμμών. Σε οθόνη λεπτομερειών, άφησέ το να κυλά χωρίς όριο γραμμών· σε προεπισκόπηση λίστας, περίκοψέ το με `lineLimit`. Το κείμενο γίνεται του ίδιου μεγέθους σε κάθε οθόνη, και το μακρύ κείμενο απλώς κάνει την οθόνη μακρύτερη χωρίς να μικραίνει το κείμενο. Κράτα την κλιμάκωση μόνο για τιμές μίας γραμμής όπως ποσά και χρονόμετρα. Το παράδειγμα 2.1.3 δείχνει για ποιο είδος κειμένου προορίζεται η κλιμάκωση."
          }
        }
      }
    },
    "문서 앱": {
      "extractionState": "manual",
      "localizations": {
