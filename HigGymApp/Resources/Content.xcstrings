    "스크롤 ↓ 시 접힘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapses on scroll ↓"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapses on scroll ↓"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロール↓で折りたたみ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向下滚动 ↓ 时折叠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向下滾動 ↓ 時摺疊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сворачивается при прокрутке вниз ↓"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se colapsa al desplazar ↓"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klappt beim Scrollen zusammen ↓"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se replie au défilement ↓"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si comprime allo scorrimento ↓"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
