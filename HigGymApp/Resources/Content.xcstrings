            "value": "半螢幕高度就夠的選項、分享類工作表"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шторки с опциями и «Поделиться», где достаточно половины высоты"
          }
        },
        "es": {
          "stringUnit": {
