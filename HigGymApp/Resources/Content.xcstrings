        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowanie paska kart w pełnoekranowej przeglądarce mediów"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att behålla flikfältet i en helskärmsmediavisare"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekran bir medya görüntüleyicide sekme çubuğunu korumak"
          }
        }
      }
    },
    "전환마다 복원 동작 필요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every switch needs a restore"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Every switch needs a restore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えのたびに元に戻す操作が必要になる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次转场都需要恢复动作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次轉場都需要恢復動作"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждому переключателю нужно восстановление"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo cambio necesita una restauración"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Wechsel braucht eine Rückkehr"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque bascule a besoin d'un retour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni interruttore ha bisogno di un ripristino"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo interruptor precisa de uma restauração"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกสวิตช์ต้องมีการกู้คืน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi công tắc đều cần một lối khôi phục"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý přepínač potřebuje obnovu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver kontakt har brug for en gendannelse"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε εναλλαγή χρειάζεται επαναφορά"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kytkin tarvitsee palautuksen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap sakelar butuh pemulihan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver bryter trenger en gjenoppretting"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke schakelaar heeft een herstel nodig"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy przełącznik potrzebuje przywrócenia"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje omkopplare behöver en återställning"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her geçişin bir geri yüklemesi olmalı"
          }
        }
      }
    },
    "전환은 **“이 화면이 어디서 왔는가”에 대한 답**입니다, 출처가 의미 없으면 standard(아래에서), 탭한 요소가 곧 열리는 내용이면 zoom(그 자리에서 확대).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transition is **the answer to “where did this screen come from?”** If the origin carries no meaning, use standard (from the bottom); if the tapped element is itself what opens, use zoom (expanding in place)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A transition is **the answer to “where did this screen come from?”** If the origin carries no meaning, use standard (from the bottom); if the tapped element is itself what opens, use zoom (expanding in place)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジションは「**この画面はどこから来たのか」への答え**です。出どころに意味がなければstandard（下から）、タップした要素がそのまま開く内容ならzoom（その場で拡大）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转场是**对“这个界面从哪里来”的回答**：来源没有意义就用 standard（从下方），被点按的元素就是要打开的内容，则用 zoom（就地放大）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉場是**對「這個介面從哪裡來」的回答**：來源沒有意義就用 standard（從下方），被輕點的元素就是要開啟的內容，則用 zoom（就地放大）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход - это **ответ на вопрос «откуда взялся этот экран?»**. Если источник ничего не значит, используйте стандартный (снизу); если сам нажатый элемент и есть то, что открывается, используйте zoom (раскрытие на месте)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transición es **la respuesta a «¿de dónde vino esta pantalla?»** Si el origen no tiene significado, usa standard (desde abajo); si el propio elemento tocado es lo que se abre, usa zoom (expandiéndose en su sitio)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Übergang ist **die Antwort auf „Woher kam dieser Bildschirm?“**. Trägt der Ursprung keine Bedeutung, nutze Standard (von unten); ist das angetippte Element selbst das, was sich öffnet, nutze Zoom (an Ort und Stelle erweitern)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une transition est **la réponse à « d'où vient cet écran ? »**. Si l'origine n'a pas de sens, utilisez standard (depuis le bas) ; si l'élément touché est lui-même ce qui s'ouvre, utilisez zoom (déploiement sur place)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transizione è **la risposta a «da dove arriva questa schermata?»** Se l'origine non ha significato, usa lo standard (dal basso); se è l'elemento toccato stesso a ciò che si apre, usa lo zoom (che si espande sul posto)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma transição é **a resposta a «de onde veio esta tela?»** Se a origem não carrega significado, use o padrão (de baixo); se o próprio elemento tocado é o que abre, use zoom (expandindo no lugar)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทรานซิชันคือ**คำตอบของ “หน้าจอนี้มาจากไหน”** ถ้าต้นทางไม่มีความหมาย ใช้ standard (จากด้านล่าง) ถ้าองค์ประกอบที่แตะเองคือสิ่งที่เปิด ใช้ zoom (ขยายอยู่กับที่)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chuyển cảnh là **câu trả lời cho “màn hình này đến từ đâu?”** Nếu nguồn gốc không mang ý nghĩa, dùng standard (từ dưới lên); nếu chính phần tử được chạm là thứ mở ra, dùng zoom (phóng to tại chỗ)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přechod je **odpověď na „odkud ta obrazovka přišla?“** Pokud původ nenese žádný význam, použijte standard (zespodu); pokud je to samotný klepnutý prvek, co se otevírá, použijte zoom (rozbalení na místě)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En overgang er **svaret på »hvor kom denne skærm fra?«** Hvis oprindelsen ikke bærer nogen betydning, brug standard (fra bunden); hvis det trykkede element selv er det, der åbner, brug zoom (udvidelse på stedet)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια μετάβαση είναι **η απάντηση στο «από πού ήρθε αυτή η οθόνη;»**. Αν η προέλευση δεν έχει νόημα, χρησιμοποίησε το standard (από κάτω)· αν το στοιχείο που πάτησες είναι αυτό που ανοίγει, χρησιμοποίησε zoom (επέκταση επιτόπου)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtymä on **vastaus kysymykseen ”mistä tämä näkymä tuli?”** Jos lähtöpaikalla ei ole merkitystä, käytä standardia (alhaalta); jos napautettu elementti on itse se, mikä avautuu, käytä zoomia (laajeneminen paikallaan)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transisi adalah **jawaban atas \"dari mana layar ini berasal?\"** Jika asalnya tak bermakna, pakai standar (dari bawah); jika elemen yang diketuk itu sendiri yang terbuka, pakai zoom (membesar di tempat)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En overgang er **svaret på «hvor kom denne skjermen fra?»** Hvis opprinnelsen ikke bærer noen mening, bruk standard (fra bunnen); hvis elementet som ble trykket på selv er det som åpnes, bruk zoom (utvides på stedet)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een overgang is **het antwoord op \"waar kwam dit scherm vandaan?\"** Als de herkomst geen betekenis draagt, gebruik dan standaard (van onderaf); als het aangetikte element zelf is wat opent, gebruik dan zoom (ter plekke uitvouwend)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejście to **odpowiedź na „skąd wziął się ten ekran?”** Jeśli pochodzenie nie niesie znaczenia, użyj standardu (od dołu); jeśli stuknięty element sam jest tym, co się otwiera, użyj zoomu (rozwijanie w miejscu)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En övergång är **svaret på ”varifrån kom den här skärmen?”** Om ursprunget saknar mening, använd standard (från botten); om det tryckta elementet i sig är det som öppnas, använd zoom (expanderar på plats)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir geçiş **“bu ekran nereden geldi?” sorusunun cevabıdır**. Köken bir anlam taşımıyorsa standart (alttan) kullan; dokunulan öğenin kendisi açılıyorsa zoom (yerinde genişleme) kullan."
          }
        }
      }
    },
    "전환을 검토할 때 여는 쪽만큼 **닫는 쪽을 한 번 더** 본다. 끝난 자리가 시작한 자리와 같은지.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When reviewing a transition, look at **the closing side one more time**, just as carefully as the opening. Does it end where it started?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When reviewing a transition, look at **the closing side one more time**, just as carefully as the opening. Does it end where it started?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジションを見直すときは、開く側と同じくらい**閉じる側をもう一度**見る。終わった場所が始まった場所と同じかどうか。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审视转场时，除了打开一侧，**再看一遍关闭一侧**。结束的位置是不是和开始的位置一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審視轉場時，除了開啟一側，**再看一遍關閉一側**。結束的位置是不是和開始的位置一樣。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяя переход, **ещё раз взгляните на закрывающую сторону**, так же внимательно, как на открывающую. Заканчивается ли он там, где начался?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al revisar una transición, mira **el lado del cierre una vez más**, con el mismo cuidado que la apertura. ¿Termina donde empezó?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir beim Prüfen eines Übergangs **die Schließseite noch einmal** genauso sorgfältig an wie das Öffnen. Endet er dort, wo er begann?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En examinant une transition, regardez **encore une fois le côté fermeture**, aussi soigneusement que l'ouverture. Se termine-t-elle là où elle a commencé ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando riesamini una transizione, guarda **ancora una volta il lato di chiusura**, con la stessa cura dell'apertura. Finisce dove era iniziata?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao revisar uma transição, olhe **mais uma vez o lado do fechamento**, com o mesmo cuidado que a abertura. Termina onde começou?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อรีวิวทรานซิชัน ให้ดู**ฝั่งปิดอีกครั้ง** อย่างละเอียดเท่ากับฝั่งเปิด มันจบที่ที่เริ่มหรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi xem lại một chuyển cảnh, hãy nhìn **phía đóng thêm một lần nữa**, cẩn thận như phía mở. Nó có kết thúc ở chỗ bắt đầu không?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při kontrole přechodu se podívejte **ještě jednou na zavírací stranu**, stejně pečlivě jako na otevírací. Končí tam, kde začal?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du gennemgår en overgang, så se på **lukkesiden en gang til**, lige så omhyggeligt som åbningen. Ender den, hvor den startede?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ελέγχεις μια μετάβαση, κοίτα **άλλη μία φορά την πλευρά του κλεισίματος**, το ίδιο προσεκτικά όσο το άνοιγμα. Τελειώνει εκεί που ξεκίνησε;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tarkistat siirtymää, katso **sulkemispuolta vielä kerran** yhtä huolellisesti kuin avautumista. Päättyykö se sinne, mistä alkoi?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat meninjau transisi, lihat **sisi penutupan sekali lagi**, secermat sisi pembukaan. Apakah ia berakhir di tempat ia dimulai?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du gjennomgår en overgang, se på **lukkesiden en gang til**, like nøye som åpningen. Ender den der den startet?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk bij het beoordelen van een overgang **nog een keer naar de sluitende kant**, even zorgvuldig als naar het openen. Eindigt hij waar hij begon?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oceniając przejście, spójrz **jeszcze raz na stronę zamykającą**, równie starannie jak na otwarcie. Czy kończy się tam, gdzie zaczęło?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du granskar en övergång, titta på **stängningssidan en gång till**, lika noggrant som på öppningen. Slutar den där den började?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir geçişi gözden geçirirken **kapanış tarafına bir kez daha** bak, açılış kadar dikkatle. Başladığı yerde bitiyor mu?"
          }
        }
      }
    },
    "전환을 고르기 전에 묻는다. **\"이 화면은 어디서 왔는가?\"** 답이 화면 위의 특정 요소라면 그 요소에서 열리게 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before choosing a transition, ask: **\"Where did this screen come from?\"** If the answer is a specific element on screen, make it open from that element."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before choosing a transition, ask: **\"Where did this screen come from?\"** If the answer is a specific element on screen, make it open from that element."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジションを選ぶ前に問う。**「この画面はどこから来たのか**」答えが画面上の特定の要素なら、その要素から開くようにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选转场之前先问：“**这个界面是从哪里来的**？”答案是界面上的某个特定元素，就让它从那个元素打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選轉場之前先問：「**這個介面是從哪裡來的**？」答案是介面上的某個特定元素，就讓它從那個元素開啟。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирая переход, спросите: **«Откуда взялся этот экран?»** Если ответ - определённый элемент на экране, пусть он открывается из этого элемента."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de elegir una transición, pregunta: **«¿De dónde vino esta pantalla?»** Si la respuesta es un elemento concreto de la pantalla, haz que se abra desde ese elemento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage vor der Wahl eines Übergangs: **„Woher kam dieser Bildschirm?“** Ist die Antwort ein bestimmtes Element auf dem Bildschirm, lass ihn aus diesem Element heraus öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de choisir une transition, demandez : **« D'où vient cet écran ? »** Si la réponse est un élément précis de l'écran, faites-le s'ouvrir depuis cet élément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di scegliere una transizione, chiediti: **«Da dove arriva questa schermata?»** Se la risposta è un elemento specifico sullo schermo, falla aprire da quell'elemento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de escolher uma transição, pergunte: **«De onde veio esta tela?»** Se a resposta é um elemento específico na tela, faça-a abrir a partir desse elemento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนเลือกทรานซิชัน ให้ถาม: **\"หน้าจอนี้มาจากไหน\"** ถ้าคำตอบคือองค์ประกอบเฉพาะบนหน้าจอ ให้มันเปิดจากองค์ประกอบนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi chọn chuyển cảnh, hãy hỏi: **\"Màn hình này đến từ đâu?\"** Nếu câu trả lời là một phần tử cụ thể trên màn hình, hãy cho nó mở ra từ phần tử đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než vyberete přechod, zeptejte se: **„Odkud ta obrazovka přišla?“** Pokud je odpovědí konkrétní prvek na obrazovce, nechte ji otevřít z toho prvku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du vælger en overgang, så spørg: **»Hvor kom denne skærm fra?«** Hvis svaret er et bestemt element på skærmen, så lad den åbne fra det element."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν διαλέξεις μετάβαση, ρώτα: **«Από πού ήρθε αυτή η οθόνη;»** Αν η απάντηση είναι ένα συγκεκριμένο στοιχείο της οθόνης, κάν' την να ανοίγει από εκείνο το στοιχείο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennen kuin valitset siirtymän, kysy: **”Mistä tämä näkymä tuli?”** Jos vastaus on tietty elementti näytöllä, anna sen avautua siitä elementistä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum memilih transisi, tanyakan: **\"Dari mana layar ini berasal?\"** Jika jawabannya adalah elemen tertentu di layar, buat ia terbuka dari elemen itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du velger en overgang, spør: **«Hvor kom denne skjermen fra?»** Hvis svaret er et bestemt element på skjermen, få den til å åpnes fra det elementet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag voordat je een overgang kiest: **\"Waar kwam dit scherm vandaan?\"** Als het antwoord een specifiek element op het scherm is, laat het dan vanuit dat element openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim wybierzesz przejście, zapytaj: **„Skąd wziął się ten ekran?”** Jeśli odpowiedzią jest konkretny element na ekranie, spraw, by otwierał się z tego elementu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Innan du väljer en övergång, fråga: **”Varifrån kom den här skärmen?”** Om svaret är ett specifikt element på skärmen, låt den öppnas från det elementet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir geçiş seçmeden önce sor: **“Bu ekran nereden geldi?”** Cevap ekrandaki belirli bir öğeyse o öğeden açılmasını sağla."
          }
        }
      }
    },
    "전환을 만들 때 관심은 여는 순간에 쏠린다. 확대로 열리는 모습을 몇 번이고 다듬는다. 닫는 쪽은 한 번 보고 넘어가는 순간이라 기본 동작이나 간단한 사라짐으로 둬도 충분해 보인다. 확대 애니메이션을 직접 구현하다 보니 되돌아가는 경로까지는 손이 가지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When building a transition, attention goes to the moment it opens. You polish the zoom-in again and again. Closing is a moment people glance at and move past, so a default behavior or a simple fade seems good enough. Having built the zoom animation by hand, you never get around to the return path."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When building a transition, attention goes to the moment it opens. You polish the zoom-in again and again. Closing is a moment people glance at and move past, so a default behaviour or a simple fade seems good enough. Having built the zoom animation by hand, you never get around to the return path."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジションを作るとき、関心は開く瞬間に集中する。拡大して開く様子を何度も磨き上げる。閉じる側は一度見て通り過ぎる瞬間なので、デフォルトの動作や単純に消えるだけで十分に思える。拡大アニメーションを自前で実装しているうちに、戻る経路にまでは手が回らない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做转场时，注意力集中在打开的那一刻。放大打开的样子被反复打磨。关闭一侧只是看一眼就过去的瞬间，用默认行为或简单的消失似乎就够了。自己实现放大动画，就顾不上返回的路径了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做轉場時，注意力集中在開啟的那一刻。放大開啟的樣子被反覆打磨。關閉一側只是看一眼就過去的瞬間，用預設行為或簡單的消失似乎就夠了。自己實作放大動畫，就顧不上返回的路徑了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы строите переход, внимание уходит на момент открытия. Вы снова и снова шлифуете увеличение. Закрытие - момент, на который люди бросают взгляд и идут дальше, поэтому поведение по умолчанию или простое затухание кажется достаточным. Сделав анимацию zoom вручную, вы так и не добираетесь до обратного пути."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al construir una transición, la atención va al momento en que se abre. Pules el zoom de entrada una y otra vez. Cerrar es un momento al que la gente echa un vistazo y pasa de largo, así que un comportamiento por defecto o un simple fundido parece suficiente. Habiendo construido a mano la animación de zoom, nunca llegas al camino de vuelta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Bauen eines Übergangs gilt die Aufmerksamkeit dem Moment des Öffnens. Du polierst das Hineinzoomen immer wieder. Das Schließen ist ein Moment, den Menschen streifen und weitergehen, also scheinen ein Standardverhalten oder ein einfaches Überblenden gut genug. Hast du die Zoom-Animation von Hand gebaut, kommst du nie zum Rückweg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand on construit une transition, l'attention va au moment de l'ouverture. Vous peaufinez le zoom avant encore et encore. La fermeture est un moment que les gens effleurent du regard avant de passer à autre chose, donc un comportement par défaut ou un simple fondu semble suffire. Ayant construit l'animation de zoom à la main, vous n'arrivez jamais au chemin du retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando costruisci una transizione, l'attenzione va al momento in cui si apre. Rifinisci l'ingrandimento ancora e ancora. La chiusura è un momento che le persone guardano di sfuggita e superano, quindi un comportamento predefinito o una semplice dissolvenza sembra abbastanza. Avendo costruito a mano l'animazione dello zoom, non arrivi mai al percorso di ritorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao construir uma transição, a atenção vai para o momento em que abre. Você lapida o zoom de entrada de novo e de novo. O fechamento é um momento que as pessoas olham de relance e superam, então um comportamento padrão ou uma simples dissolvência parece bastar. Tendo construído a animação de zoom à mão, você nunca chega ao caminho de volta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อสร้างทรานซิชัน ความสนใจไปที่จังหวะเปิด คุณขัดเกลาการซูมเข้าซ้ำแล้วซ้ำอีก การปิดเป็นจังหวะที่คนเหลือบผ่าน พฤติกรรมเริ่มต้นหรือการเฟดง่าย ๆ จึงดูพอ เมื่อสร้างแอนิเมชันซูมด้วยมือ คุณไม่เคยไปถึงเส้นทางกลับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi dựng chuyển cảnh, sự chú ý dồn vào khoảnh khắc mở. Bạn trau chuốt cú phóng to hết lần này đến lần khác. Đóng là khoảnh khắc người ta liếc qua rồi đi tiếp, nên hành vi mặc định hoặc một hiệu ứng mờ đơn giản có vẻ đủ. Đã tự tay dựng hoạt ảnh zoom, bạn chẳng bao giờ đến lượt đường về."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při stavbě přechodu jde pozornost na okamžik otevření. Piplete se se zoomem dokola. Zavírání je chvíle, na kterou se lidé jen letmo podívají a jdou dál, takže výchozí chování nebo jednoduché prolnutí se zdá dost dobré. Když jste animaci zoomu postavili ručně, nikdy se nedostanete k cestě zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du bygger en overgang, går opmærksomheden til det øjeblik, den åbner. Du pudser zoom-ind igen og igen. Lukning er et øjeblik, folk kaster et blik på og går videre fra, så en standardadfærd eller en simpel overtoning virker godt nok. Efter at have bygget zoomanimationen i hånden kommer du aldrig rundt til tilbagevejen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν φτιάχνεις μια μετάβαση, η προσοχή πάει στη στιγμή που ανοίγει. Γυαλίζεις το zoom-in ξανά και ξανά. Το κλείσιμο είναι μια στιγμή που οι άνθρωποι την προσπερνούν με μια ματιά, οπότε μια προεπιλεγμένη συμπεριφορά ή ένα απλό fade φαίνεται αρκετό. Αφού έφτιαξες το animation του zoom στο χέρι, δεν φτάνεις ποτέ στη διαδρομή επιστροφής."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtymää rakentaessa huomio menee avautumishetkeen. Hiot zoom-sisäänajoa yhä uudelleen. Sulkeminen on hetki, jonka ihmiset vilkaisevat ja ohittavat, joten oletuskäytös tai yksinkertainen häivytys tuntuu riittävältä. Rakennettuasi zoom-animaation käsin et koskaan pääse paluureittiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat membangun transisi, perhatian tertuju pada momen pembukaan. Kamu menyempurnakan zoom-in berkali-kali. Penutupan adalah momen yang sekilas dilihat orang lalu dilewati, jadi perilaku bawaan atau pudar sederhana tampak cukup. Setelah membangun animasi zoom dengan tangan, kamu tak pernah sempat mengerjakan jalur kembalinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du bygger en overgang, går oppmerksomheten til øyeblikket den åpnes. Du pusser zoom-inn-animasjonen igjen og igjen. Lukking er et øyeblikk folk kaster et blikk på og går videre fra, så en standardoppførsel eller en enkel fade virker god nok. Etter å ha bygd zoom-animasjonen for hånd kommer du aldri til returveien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het bouwen van een overgang gaat de aandacht naar het moment van openen. Je poetst het inzoomen steeds weer op. Sluiten is een moment waar mensen even naar kijken en dan voorbijgaan, dus standaardgedrag of een simpele fade lijkt goed genoeg. Nadat je de zoomanimatie met de hand hebt gebouwd, kom je nooit toe aan het terugpad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy budowaniu przejścia uwaga idzie na moment otwarcia. Szlifujesz przybliżenie raz po raz. Zamknięcie to chwila, na którą ludzie zerkają i idą dalej, więc zachowanie domyślne lub proste przenikanie wydaje się wystarczające. Zbudowawszy animację zoomu ręcznie, nigdy nie dochodzisz do ścieżki powrotnej."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du bygger en övergång går uppmärksamheten till ögonblicket den öppnas. Du putsar inzoomningen om och om igen. Stängning är ett ögonblick som folk blickar på och går vidare från, så ett standardbeteende eller en enkel toning verkar gott nog. Efter att ha byggt zoomanimationen för hand kommer du aldrig till returvägen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir geçiş kurarken dikkat açılış anına gider. Yakınlaştırmayı tekrar tekrar cilalarsın. Kapanış, insanların göz ucuyla bakıp geçtiği bir andır, bu yüzden varsayılan bir davranış ya da basit bir solma yeterli görünür. Zoom animasyonunu elle kurduğun için dönüş yoluna hiç sıra gelmez."
          }
        }
      }
    },
    "절반 높이 시트 안에 입력 칸이 열 개 넘는 폼이 들어 있다. 폼을 스크롤하려고 손가락을 올리면 시트가 커지고, 내리면 폼 대신 시트가 닫히려 한다. 입력 칸을 누르면 키보드가 올라오면서 시트가 갑자기 커진다. 사용자는 지금 움직이는 것이 폼인지 시트인지 매번 확인해야 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A half-height sheet contains a form with more than ten input fields. When you swipe up to scroll the form, the sheet grows; when you swipe down, the sheet tries to close instead of the form scrolling. Tapping an input field brings up the keyboard and the sheet suddenly expands. Users have to check every time whether what's moving is the form or the sheet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A half-height sheet contains a form with more than ten input fields. When you swipe up to scroll the form, the sheet grows; when you swipe down, the sheet tries to close instead of the form scrolling. Tapping an input field brings up the keyboard and the sheet suddenly expands. Users have to check every time whether what's moving is the form or the sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分の高さのシートの中に、入力欄が10個を超えるフォームが入っている。フォームをスクロールしようと指を上げるとシートが大きくなり、下げるとフォームではなくシートが閉じようとする。入力欄をタップするとキーボードが上がってきて、シートが急に大きくなる。ユーザーは今動いているのがフォームなのかシートなのかを毎回確かめなければならない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半屏高度的弹层里装着一个有十几个输入框的表单。想滚动表单而把手指向上，弹层变大；向下，弹层而不是表单想要关闭。点输入框，键盘升起，弹层突然变大。用户每次都得确认，现在在动的是表单还是弹层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半螢幕高度的工作表裡裝著一個有十幾個輸入框的表單。想滾動表單而把手指向上，工作表變大；向下，工作表而不是表單想要關閉。點輸入框，鍵盤升起，工作表突然變大。使用者每次都得確認，現在在動的是表單還是工作表。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В шторке половинной высоты форма с более чем десятью полями ввода. Когда вы смахиваете вверх, чтобы прокрутить форму, шторка вырастает; когда смахиваете вниз, шторка пытается закрыться вместо прокрутки формы. Нажатие на поле ввода вызывает клавиатуру, и шторка внезапно разворачивается. Пользователям каждый раз приходится проверять, что движется: форма или шторка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja de media altura contiene un formulario con más de diez campos de entrada. Cuando deslizas hacia arriba para desplazar el formulario, la hoja crece; cuando deslizas hacia abajo, la hoja intenta cerrarse en lugar de desplazarse el formulario. Al tocar un campo de entrada aparece el teclado y la hoja se expande de repente. Los usuarios tienen que comprobar cada vez si lo que se mueve es el formulario o la hoja."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sheet auf halber Höhe enthält ein Formular mit mehr als zehn Eingabefeldern. Wischt man nach oben, um das Formular zu scrollen, wächst das Sheet; wischt man nach unten, versucht das Sheet sich zu schließen, statt dass das Formular scrollt. Tippt man ein Eingabefeld an, kommt die Tastatur hoch und das Sheet dehnt sich plötzlich aus. Nutzer müssen jedes Mal prüfen, ob sich das Formular oder das Sheet bewegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une feuille à mi-hauteur contient un formulaire de plus de dix champs de saisie. Quand vous balayez vers le haut pour faire défiler le formulaire, la feuille grandit ; quand vous balayez vers le bas, la feuille tente de se fermer au lieu que le formulaire défile. Toucher un champ de saisie fait apparaître le clavier et la feuille se déploie soudain. Les utilisateurs doivent vérifier à chaque fois si ce qui bouge est le formulaire ou la feuille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un foglio a mezza altezza contiene un modulo con più di dieci campi di input. Quando scorri verso l'alto per far scorrere il modulo, il foglio cresce; quando scorri verso il basso, il foglio cerca di chiudersi invece di far scorrere il modulo. Toccando un campo di input compare la tastiera e il foglio si espande di colpo. Gli utenti devono controllare ogni volta se ciò che si muove è il modulo o il foglio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma folha de meia altura contém um formulário com mais de dez campos de entrada. Quando você desliza para cima para rolar o formulário, a folha cresce; quando desliza para baixo, a folha tenta fechar em vez de o formulário rolar. Tocar num campo de entrada faz subir o teclado e a folha se expande de repente. Os usuários precisam conferir toda vez se o que se move é o formulário ou a folha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีตครึ่งความสูงมีฟอร์มที่มีช่องกรอกมากกว่าสิบช่อง เมื่อปัดขึ้นเพื่อเลื่อนฟอร์ม ชีตโตขึ้น เมื่อปัดลง ชีตพยายามปิดแทนที่ฟอร์มจะเลื่อน การแตะช่องกรอกเรียกคีย์บอร์ดและชีตขยายอย่างกะทันหัน ผู้ใช้ต้องตรวจทุกครั้งว่าสิ่งที่ขยับคือฟอร์มหรือชีต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một sheet nửa chiều cao chứa biểu mẫu với hơn mười ô nhập. Khi bạn vuốt lên để cuộn biểu mẫu, sheet lớn lên; khi vuốt xuống, sheet cố đóng thay vì biểu mẫu cuộn. Chạm vào ô nhập hiện bàn phím và sheet bất ngờ mở rộng. Người dùng phải kiểm tra mỗi lần xem thứ đang di chuyển là biểu mẫu hay sheet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet v poloviční výšce obsahuje formulář s více než deseti vstupními poli. Když přejedete nahoru a posouváte formulář, sheet roste; když přejedete dolů, sheet se místo posouvání formuláře pokusí zavřít. Klepnutí na vstupní pole vyvolá klávesnici a sheet se náhle rozšíří. Uživatelé musejí pokaždé zkontrolovat, zda se hýbe formulář, nebo sheet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ark i halv højde indeholder en formular med mere end ti inputfelter. Når du stryger opad for at scrolle formularen, vokser arket; når du stryger nedad, forsøger arket at lukke i stedet for at formularen scroller. Et tryk på et inputfelt får tastaturet frem, og arket udvider sig pludselig. Brugerne må tjekke hver gang, om det, der bevæger sig, er formularen eller arket."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα φύλλο μισού ύψους περιέχει μια φόρμα με πάνω από δέκα πεδία εισαγωγής. Όταν σύρεις προς τα πάνω για να κυλήσεις τη φόρμα, το φύλλο μεγαλώνει· όταν σύρεις προς τα κάτω, το φύλλο προσπαθεί να κλείσει αντί να κυλήσει η φόρμα. Αν πατήσεις ένα πεδίο, εμφανίζεται το πληκτρολόγιο και το φύλλο επεκτείνεται ξαφνικά. Οι χρήστες πρέπει να ελέγχουν κάθε φορά αν κινείται η φόρμα ή το φύλλο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puolikkaan korkeuden arkki sisältää lomakkeen, jossa on yli kymmenen syöttökenttää. Kun pyyhkäiset ylös vierittääksesi lomaketta, arkki kasvaa; kun pyyhkäiset alas, arkki yrittää sulkeutua lomakkeen vierittämisen sijaan. Syöttökentän napautus tuo esiin näppäimistön, ja arkki laajenee yhtäkkiä. Käyttäjien täytyy tarkistaa joka kerta, onko liikkuva asia lomake vai arkki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembar setengah tinggi berisi formulir dengan lebih dari sepuluh kolom input. Saat kamu menggeser ke atas untuk menggulir formulir, lembar membesar; saat menggeser ke bawah, lembar mencoba menutup alih-alih formulir menggulir. Mengetuk kolom input memunculkan keyboard dan lembar tiba-tiba meluas. Pengguna harus memeriksa setiap kali apakah yang bergerak itu formulir atau lembar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et halvhøyde-ark inneholder et skjema med mer enn ti inndatafelt. Når du sveiper opp for å rulle skjemaet, vokser arket; når du sveiper ned, prøver arket å lukkes i stedet for at skjemaet ruller. Å trykke på et inndatafelt henter frem tastaturet, og arket utvides plutselig. Brukerne må sjekke hver gang om det som beveger seg er skjemaet eller arket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een sheet van halve hoogte bevat een formulier met meer dan tien invoervelden. Als je omhoog veegt om het formulier te scrollen, groeit de sheet; als je omlaag veegt, probeert de sheet te sluiten in plaats van dat het formulier scrolt. Tikken op een invoerveld brengt het toetsenbord omhoog en de sheet vouwt plotseling uit. Gebruikers moeten telkens controleren of wat beweegt het formulier of de sheet is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkusz o połowie wysokości zawiera formularz z ponad dziesięcioma polami wprowadzania. Gdy przesuwasz w górę, by przewinąć formularz, arkusz rośnie; gdy przesuwasz w dół, arkusz próbuje się zamknąć zamiast przewijać formularz. Stuknięcie pola wprowadzania wywołuje klawiaturę i arkusz nagle się rozwija. Użytkownicy muszą za każdym razem sprawdzać, czy to, co się rusza, to formularz, czy arkusz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett ark med halv höjd innehåller ett formulär med mer än tio inmatningsfält. När du sveper uppåt för att scrolla formuläret växer arket; när du sveper nedåt försöker arket stängas i stället för att formuläret scrollar. Att trycka på ett inmatningsfält tar fram tangentbordet och arket expanderar plötsligt. Användare måste varje gång kontrollera om det som rör sig är formuläret eller arket."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarım yükseklikte bir sayfa on'dan fazla giriş alanı olan bir form içeriyor. Formu kaydırmak için yukarı kaydırdığında sayfa büyüyor; aşağı kaydırdığında form kaymak yerine sayfa kapanmaya çalışıyor. Bir giriş alanına dokunmak klavyeyi getiriyor ve sayfa aniden genişliyor. Kullanıcılar her seferinde hareket edenin form mu sayfa mı olduğunu kontrol etmek zorunda kalıyor."
          }
        }
      }
    },
    "절반 높이는 **“원본과의 대화”** 은유, 화면을 나눠 가짐으로써 시트가 배경 콘텐츠에 대한 것임을 형태로 말합니다. 지도 앱이 만든 패턴을 시스템 detent로 표준화한 것.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half height is the metaphor of **\"a conversation with the original.\"** By sharing the screen, the sheet's shape itself says it's about the content behind it. It turns a pattern the Maps app pioneered into a standard system detent."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Half height is the metaphor of **\"a conversation with the original.\"** By sharing the screen, the sheet's shape itself says it's about the content behind it. It turns a pattern the Maps app pioneered into a standard system detent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分の高さは「**元の画面との対話**」の比喩。画面を分け合うことで、シートが背後のコンテンツについてのものだと形で語ります。マップアプリが生んだパターンを、システムのデタントとして標準化したもの。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半屏高度是“**与原件对话**”的隐喻：通过平分屏幕，用形态说明这个弹层是关于背景内容的。这是把地图应用创造的模式，标准化成了系统 detent。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半螢幕高度是「**與原件對話**」的隱喻：透過平分螢幕，用形態說明這個工作表是關於背景內容的。這是把地圖應用程式創造的模式，標準化成了系統 detent。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Половинная высота - метафора **«разговора с оригиналом»**. Делясь экраном, сама форма шторки говорит, что речь о содержимом позади. Это превращает паттерн, который впервые применили Карты, в стандартный системный detent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La media altura es la metáfora de **«una conversación con el original».** Al compartir la pantalla, la propia forma de la hoja dice que trata del contenido de detrás. Convierte un patrón que abrió la app Mapas en un detent estándar del sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halbe Höhe ist die Metapher **„eines Gesprächs mit dem Original“**. Indem es sich den Bildschirm teilt, sagt die Form des Sheets selbst, dass es um den Inhalt dahinter geht. Es macht ein Muster, das die Karten-App eingeführt hat, zu einem standardmäßigen System-Detent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mi-hauteur est la métaphore d'**« une conversation avec l'original »**. En partageant l'écran, la forme même de la feuille dit qu'il s'agit du contenu derrière. Elle fait d'un motif lancé par l'app Plans un detent système standard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezza altezza è la metafora di **«una conversazione con l'originale».** Condividendo lo schermo, la forma stessa del foglio dice che riguarda il contenuto che sta dietro. Trasforma un modello inaugurato dall'app Mappe in un detent di sistema standard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Meia altura é a metáfora de **«uma conversa com o original».** Ao dividir a tela, a própria forma da folha diz que trata do conteúdo atrás. Transforma um padrão pioneiro do app Mapas num detent de sistema padrão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ครึ่งความสูงคืออุปมาของ“**บทสนทนากับต้นฉบับ**” ด้วยการแบ่งหน้าจอ รูปทรงของชีตเองบอกว่าเกี่ยวกับเนื้อหาด้านหลัง มันเปลี่ยนรูปแบบที่แอปแผนที่บุกเบิกให้เป็น detent มาตรฐานของระบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nửa chiều cao là ẩn dụ của **\"cuộc trò chuyện với bản gốc.\"** Bằng cách chia sẻ màn hình, hình dạng của sheet tự nói nó nói về nội dung phía sau. Nó biến một mẫu mà app Bản đồ tiên phong thành một detent hệ thống chuẩn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poloviční výška je metafora **„rozhovoru s originálem“.** Sdílením obrazovky sama tvar sheetu říká, že se týká obsahu za ním. Mění vzor, který prosadila aplikace Mapy, na standardní systémový detent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Halv højde er metaforen for **»en samtale med originalen.«** Ved at dele skærmen siger arkets form selv, at det handler om indholdet bagved. Det gør et mønster, Kort-appen var pioner for, til en standard system-detent."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μισό ύψος είναι η μεταφορά της **«συζήτησης με το πρωτότυπο»**. Μοιραζόμενο την οθόνη, το ίδιο το σχήμα του φύλλου λέει ότι αφορά το περιεχόμενο πίσω του. Μετατρέπει ένα μοτίβο που πρωτοεισήγαγε η εφαρμογή Χάρτες σε τυπικό detent του συστήματος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puolikas korkeus on **”keskustelun alkuperäisen kanssa”** metafora. Jakamalla näytön arkin muoto itse kertoo, että se koskee sen takana olevaa sisältöä. Se muuttaa Kartat-sovelluksen aloittaman mallin järjestelmän vakiodetentiksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setengah tinggi adalah metafora **\"percakapan dengan aslinya.\"** Dengan berbagi layar, bentuk lembar itu sendiri berkata ia tentang konten di belakangnya. Ia mengubah pola yang dirintis aplikasi Peta menjadi detent sistem standar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Halv høyde er metaforen for **«en samtale med originalen».** Ved å dele skjermen sier arkets form selv at det handler om innholdet bak. Det gjør et mønster Kart-appen var pioner for til en standard systemdetent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Halve hoogte is de metafoor van **\"een gesprek met het origineel\".** Door het scherm te delen zegt de vorm van de sheet zelf dat het over de inhoud erachter gaat. Het maakt van een patroon dat de Kaarten-app pionierde een standaard systeemdetent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połowa wysokości to metafora **„rozmowy z oryginałem”.** Dzieląc ekran, sama forma arkusza mówi, że dotyczy treści za nim. Zamienia wzorzec, który zapoczątkowała aplikacja Mapy, w standardowy detent systemowy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Halv höjd är metaforen för **”ett samtal med originalet”.** Genom att dela skärmen säger arkets form i sig att det handlar om innehållet bakom det. Det gör ett mönster som appen Kartor var först med till en vanlig systemdetent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarım yükseklik **“aslıyla bir konuşma”** metaforudur. Ekranı paylaşarak sayfanın biçimi kendi başına arkadaki içerikle ilgili olduğunu söyler. Haritalar uygulamasının öncülük ettiği bir kalıbı standart bir sistem detent'ine çevirir."
          }
        }
      }
    },
    "절반 높이로 충분한 옵션·공유류 시트": {
      "extractionState": "manual",
