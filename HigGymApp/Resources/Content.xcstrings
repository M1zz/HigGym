            "value": "Al desplazar solo se colapsa la barra de pestañas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Tab-Leiste klappt beim Scrollen zusammen"
          }
        },
        "fr": {
