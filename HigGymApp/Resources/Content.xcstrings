      }
    },
    "덮는 만큼 맥락을 뺏는다. 내용 높이에 맞는 detent를 고른다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The more it covers, the more context it takes away. Pick a detent that fits the content's height."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The more it covers, the more context it takes away. Pick a detent that fits the content's height."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覆うほど文脈を奪う。コンテンツの高さに合った detent を選ぶ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "盖住多少就夺走多少上下文。选一个与内容高度相符的 detent。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋住多少就奪走多少上下文。選一個與內容高度相符的 detent。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем больше закрывает, тем больше отнимает контекста. Подберите detent под высоту содержимого."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más cubre, más contexto quita. Elige un detent que se ajuste a la altura del contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mehr es abdeckt, desto mehr Kontext nimmt es weg. Wähle einen Detent, der zur Inhaltshöhe passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus il recouvre, plus il enlève de contexte. Choisissez un detent adapté à la hauteur du contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più copre, più contesto toglie. Scegli un detent adatto all'altezza del contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais cobre, mais contexto tira. Escolha um detent que se ajuste à altura do conteúdo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยิ่งคลุมมาก ก็ยิ่งเอาบริบทไปมาก เลือก detent ที่พอดีกับความสูงของเนื้อหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Càng che nhiều càng lấy đi nhiều bối cảnh. Chọn detent vừa với chiều cao nội dung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čím víc zakrývá, tím víc kontextu bere. Vyberte detent, který odpovídá výšce obsahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo mere den dækker, jo mere kontekst tager den væk. Vælg en detent, der passer til indholdets højde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο περισσότερο καλύπτει, τόσο περισσότερο πλαίσιο αφαιρεί. Διάλεξε ένα detent που ταιριάζει στο ύψος του περιεχομένου."
          }
        }
      }
    },
