            "value": "Ein Sortierkriterium als Picker hinzugefügt, mit Häkchen beim aktuellen Wert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un critère de tri ajouté sous forme de Picker, avec une coche sur la valeur actuelle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un criterio di ordinamento aggiunto come Picker, con un segno di spunta sul valore attuale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um critério de ordenação acrescentado como Picker, com um sinal de verificação no valor atual"
