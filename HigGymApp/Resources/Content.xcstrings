        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นตำแหน่งที่มองเห็นมากที่สุด จึงดูถูกต้องที่จะวางปุ่มสำคัญที่สุดตรงนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là vị trí dễ thấy nhất, nên đặt nút quan trọng nhất ở đó có vẻ đúng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to nejviditelnější místo, takže se zdá správné dát tam nejdůležitější tlačítko."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er den mest synlige plads, så det virker rigtigt at lægge den vigtigste knap der."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι το πιο ορατό σημείο, οπότε φαίνεται σωστό να βάλεις εκεί το πιο σημαντικό κουμπί."
          }
        }
      }
    },
    "가장 중요한 확정 액션이니 가장 좋은 자리를 준다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the most important confirming action, so you give it the best spot."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the most important confirming action, so you give it the best spot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん重要な確定のアクションなので、いちばん良い場所を与える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是最重要的确认操作，所以给它最好的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是最重要的確認操作，所以給它最好的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это самое важное подтверждающее действие, поэтому ему отдают лучшее место."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la acción de confirmación más importante, así que le das el mejor sitio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist die wichtigste bestätigende Aktion, also gibst du ihr den besten Platz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'action de confirmation la plus importante, donc vous lui donnez le meilleur emplacement."
