        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trộn soft và hard giữa các màn hình mà không có quy tắc"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Míchání soft a hard z obrazovky na obrazovku bez pravidla"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At blande soft og hard fra skærm til skærm uden nogen regel"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανάμειξη soft και hard από οθόνη σε οθόνη χωρίς κανόνα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Softin ja hardin sekoittaminen näkymästä toiseen ilman sääntöä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencampur soft dan hard dari layar ke layar tanpa aturan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å blande soft og hard fra skjerm til skjerm uten regel"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacht en hard van scherm tot scherm mengen zonder regel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieszanie miękkiego i twardego od ekranu do ekranu bez reguły"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att blanda soft och hard från skärm till skärm utan regel"
