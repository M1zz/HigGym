        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลขที่ลดลงเมื่อคุณไล่จัดการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một con số giảm xuống khi bạn xử lý dần"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Číslo, které klesá, jak je vyřizujete"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tal, der falder, efterhånden som du arbejder dig igennem dem"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας αριθμός που πέφτει καθώς τα διεκπεραιώνεις"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luku, joka laskee asioita hoitaessasi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka yang turun saat kamu menanganinya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tall som går ned etter hvert som du jobber deg gjennom dem"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een getal dat daalt naarmate je ze afhandelt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba, która maleje w miarę ich obsługi"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett tal som sjunker medan du hanterar dem"
          }
        },
        "tr": {
