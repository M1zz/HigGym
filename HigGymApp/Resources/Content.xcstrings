            "state": "translated",
            "value": "En permanent badge, der aldrig går ned (et marketing-»1«)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μόνιμο σήμα που δεν κατεβαίνει ποτέ (ένα μάρκετινγκ «1»)"
          }
        }
      }
    },
    "처리해도 줄지 않는 상시 배지를 붙인다": {
