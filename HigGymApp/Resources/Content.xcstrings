        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å skjule den på en grunn innstillingsskjerm på to nivåer"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verbergen op een ondiep instellingenscherm van twee niveaus"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrywanie go na płytkim dwupoziomowym ekranie ustawień"
