          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用 safeAreaBar 而用 ZStack 疊加，內容的第一行被遮住"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наложить через ZStack вместо safeAreaBar, закрыв первую строку контента"
          }
        },
        "es": {
