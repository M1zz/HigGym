        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Elimina** tenuto di proposito dentro l'overflow (previene i tocchi accidentali)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
