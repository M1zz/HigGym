        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Два независимых кластера** по краям; промежуток между ними сигнализирует «разные задачи»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dos grupos independientes** a cada lado; el espacio entre ellos indica «trabajos distintos»"
          }
        }
