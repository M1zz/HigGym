            "value": "El minirreproductor de Música"
          }
        }
      }
    },
    "미디어 앱": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A media app"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A media app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアアプリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "媒體應用程式"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиаприложение"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app de medios"
          }
        }
      }
    },
    "미디어·콘텐츠 대형 앱에서 하단에 **이동(탭)·검색·전역 상태(액세서리)**를 모두 담아야 할 때.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a large media or content app must fit **navigation (tabs), search and global state (accessory)** all into the bottom."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a large media or content app must fit **navigation (tabs), search and global state (accessory)** all into the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大規模なメディア・コンテンツアプリで、下部に**移動（タブ）・検索・グローバルな状態（アクセサリ**）をすべて収める必要があるとき。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在媒体 · 内容类大型应用里，底部需要同时容纳**导航（标签）· 搜索 · 全局状态（附件）**时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在媒體 · 內容類大型應用程式裡，底部需要同時容納**導覽（標籤）· 搜尋 · 全域性狀態（附件）**時。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда большому медиа- или контентному приложению нужно вместить внизу **навигацию (вкладки), поиск и глобальное состояние (accessory)**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una gran app de medios o de contenido tiene que meter **navegación (pestañas), búsqueda y estado global (accesorio)** todo abajo."
          }
        }
      }
    },
    "미리보기 → 확장 편집의 단계 전환": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stepping from a preview to expanded editing"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stepping from a preview to expanded editing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー→拡張した編集への段階の切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览 → 展开编辑的阶段切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽 → 展開編輯的階段切換"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаговый переход от предпросмотра к развёрнутому редактированию"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar de una vista previa a la edición expandida"
          }
        }
      }
    },
    "바 높이는 하나씩이 아니라 상하 합계로 본다. 작은 기기에서 남은 콘텐츠 영역을 확인한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Judge bar height by the combined total of top and bottom, not one bar at a time. Check how much content area remains on a small device."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Judge bar height by the combined total of top and bottom, not one bar at a time. Check how much content area remains on a small device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの高さは1本ずつではなく、上下の合計で見る。小さなデバイスで残るコンテンツ領域を確かめる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栏的高度不要一个一个看，而要看上下合计。在小设备上确认剩下的内容区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列的高度不要一個一個看，而要看上下合計。在小裝置上確認剩下的內容區域。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценивайте высоту панелей по суммарному итогу верха и низа, а не по одной панели. Проверьте, сколько области контента остаётся на маленьком устройстве."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juzga la altura de las barras por el total combinado de arriba y abajo, no barra por barra. Comprueba cuánta área de contenido queda en un dispositivo pequeño."
          }
        }
      }
    },
    "바 뒤로 **사진·영상·고대비 그래픽**처럼 복잡한 콘텐츠가 지나가는 화면. soft/hard의 반투명으로는 컨트롤 글자가 묻힐 때의 최종 수단.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screens where busy content like **photos, video, or high-contrast graphics** passes behind the bar. The last resort when the translucency of soft or hard buries the control labels."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Screens where busy content like **photos, video, or high-contrast graphics** passes behind the bar. The last resort when the translucency of soft or hard buries the control labels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの後ろを**写真・動画・高コントラストのグラフィック**のような複雑なコンテンツが通る画面。soft/hardの半透明ではコントロールの文字が埋もれてしまうときの最終手段。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**照片、视频、高对比图形**这类复杂内容从栏后经过的界面。soft/hard 的半透明挡不住控件文字被淹没时的最终手段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**照片、影片、高對比圖形**這類複雜內容從列後經過的介面。soft/hard 的半透明擋不住控制元件文字被淹沒時的最終手段。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экраны, где за панелью проходит сложный контент вроде **фото, видео или контрастной графики**. Последнее средство, когда полупрозрачность soft или hard хоронит подписи элементов управления."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantallas donde pasa por detrás de la barra contenido cargado como **fotos, vídeo o gráficos de alto contraste**. El último recurso cuando la translucidez de soft o hard entierra las etiquetas de los controles."
          }
        }
      }
    },
    "바 하나하나는 이유가 있다. 필터는 자주 쓰고, 배너는 상태를 알려야 하고, 결제 버튼은 늘 보여야 한다. 기능이 하나 늘 때마다 가장 눈에 띄는 자리인 바에 한 줄을 더한다. 각각 따로 검토하면 모두 합리적이고, 큰 화면 시안에서는 공간도 넉넉해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bar has a reason. Filters get used often, the banner has to report status, and the checkout button must always be visible. Every time a feature is added, you add another row to the bar, the most noticeable spot. Reviewed one by one, each is reasonable, and in a large-screen mockup there seems to be plenty of room."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bar has a reason. Filters get used often, the banner has to report status, and the checkout button must always be visible. Every time a feature is added, you add another row to the bar, the most noticeable spot. Reviewed one by one, each is reasonable, and in a large-screen mockup there seems to be plenty of room."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのバーにも理由がある。フィルタはよく使うし、バナーは状態を知らせなければならないし、決済ボタンは常に見えていなければならない。機能が1つ増えるたびに、いちばん目立つ場所であるバーに1行足す。1つずつ検討すればどれも妥当で、大きな画面のカンプではスペースも十分に見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个栏都有它的理由。筛选常用，横幅要告知状态，支付按钮要始终可见。每多一个功能，就往最显眼的位置（栏）再加一行。单独审视，每一条都合理，在大屏幕的设计稿上空间也显得很充裕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個列都有它的理由。篩選常用，橫幅要告知狀態，付款按鈕要始終可見。每多一個功能，就往最顯眼的位置（列）再加一行。單獨審視，每一條都合理，在大螢幕的設計稿上空間也顯得很充裕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой панели есть причина. Фильтры используют часто, баннер должен сообщать состояние, а кнопка оплаты должна быть видна всегда. Каждый раз, когда добавляется функция, в панель, самое заметное место, добавляется строка. По отдельности каждая разумна, а на макете для большого экрана места вроде хватает с запасом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada barra tiene su motivo. Los filtros se usan a menudo, el banner tiene que informar del estado, y el botón de pago debe estar siempre visible. Cada vez que se añade una función, se añade otra fila a la barra, el sitio más llamativo. Revisadas una a una, cada una es razonable, y en una maqueta de pantalla grande parece que hay espacio de sobra."
          }
        }
      }
    },
    "바는 하나씩 평가하면 안 되는 것이었다. 바의 비용은 **합계**로 치른다. 상단 바와 하단 바와 툴바가 겹치면 콘텐츠 영역이 급격히 줄고, 작은 기기에서 그 줄어든 폭이 가장 크게 드러난다. 바들이 자리를 지키는 동안 화면의 주인인 콘텐츠가 밀려났다. 상하 바 합계가 화면의 큰 몫을 차지하기 시작하면 콘텐츠는 압사한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bars were never something to evaluate one at a time. You pay for bars **in total**. When top bars, bottom bars, and toolbars pile up, the content area shrinks fast, and on small devices that shrinkage shows the most. While the bars held their ground, the content, the real owner of the screen, got pushed out. Once the combined top and bottom bars start taking a big share of the screen, the content gets crushed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bars were never something to evaluate one at a time. You pay for bars **in total**. When top bars, bottom bars, and toolbars pile up, the content area shrinks fast, and on small devices that shrinkage shows the most. While the bars held their ground, the content, the real owner of the screen, got pushed out. Once the combined top and bottom bars start taking a big share of the screen, the content gets crushed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーは1本ずつ評価してはいけないものだった。バーのコストは**合計**で支払う。上部のバー、下部のバー、ツールバーが重なると、コンテンツ領域は急激に狭まり、小さなデバイスほどその減り方がはっきり表れる。バーたちが場所を守っているあいだに、画面の主役であるコンテンツが押し出された。上下のバーの合計が画面の大きな割合を占めはじめると、コンテンツは押しつぶされる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栏是不能一个一个评价的。栏的成本要按**合计**来付。顶栏、底栏和工具栏一叠加，内容区域急剧缩小，在小设备上，缩小的幅度最明显。栏们各守其位的时候，界面的主角（内容）被挤走了。上下栏的合计开始占据界面的大块时，内容就被压垮了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列是不能一個一個評價的。列的成本要按**合計**來付。頂列、底列和工具列一疊加，內容區域急劇縮小，在小裝置上，縮小的幅度最明顯。列們各守其位的時候，介面的主角（內容）被擠走了。上下列的合計開始佔據介面的大塊時，內容就被壓垮了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панели нельзя было оценивать по одной. Панели оплачиваются **в сумме**. Когда накладываются верхние панели, нижние и панели инструментов, область контента быстро сжимается, а на маленьких устройствах это сжатие заметнее всего. Пока панели держали свои места, контент, настоящий хозяин экрана, был вытеснен. Когда суммарные верхние и нижние панели начинают занимать большую долю экрана, контент раздавлен."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras nunca fueron algo que evaluar una a una. Pagas las barras **en total**. Cuando se acumulan barras superiores, inferiores y de herramientas, el área de contenido se encoge rápido, y en dispositivos pequeños esa reducción se nota más. Mientras las barras mantenían su posición, el contenido, el verdadero dueño de la pantalla, fue empujado fuera. Cuando las barras superior e inferior combinadas empiezan a ocupar una gran parte de la pantalla, el contenido queda aplastado."
          }
        }
      }
    },
    "바마다 필요한 것을 담다 보니 높이가 계속 자란다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bar gets whatever it needs, and the height keeps growing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bar gets whatever it needs, and the height keeps growing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーごとに必要なものを入れていくうちに、高さがどんどん増えていく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个栏都装进自己需要的东西，高度就一直在长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個列都裝進自己需要的東西，高度就一直在長。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая панель получает всё, что ей нужно, и высота продолжает расти."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada barra recibe lo que necesita, y la altura sigue creciendo."
          }
        }
      }
    },
    "바에 한 줄을 더할 때 그 줄만 보지 않는다. **남는 콘텐츠 영역**을 작은 화면에서 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add a row to a bar, don't look at that row alone. Look at **the content area that's left** on a small screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add a row to a bar, don't look at that row alone. Look at **the content area that's left** on a small screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーに1行足すときは、その行だけを見ない。小さな画面で**残るコンテンツ領域**を見る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给栏加一行时，不要只看那一行。要在小屏幕上看**剩下的内容区域**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給列加一行時，不要只看那一行。要在小螢幕上看**剩下的內容區域**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляя строку в панель, не смотрите на неё одну. Посмотрите на **область контента, которая остаётся**, на маленьком экране."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando añadas una fila a una barra, no mires esa fila sola. Mira **el área de contenido que queda** en una pantalla pequeña."
          }
        }
      }
    },
    "바의 배경을 시스템 material로 바꾼다. 뒤의 사진이 은은하게 비쳐 콘텐츠가 바 밑으로 이어지고, 바는 \"콘텐츠 위에 떠 있는 판\"이라는 깊이 관계를 형태로 말한다. 뒤가 복잡할수록 두꺼운 material을 골라 아이콘이 흔들리지 않게 한다. 밝기 보정은 시스템이 배경에 맞춰 한다. 앱의 5.2.1 Leading, Top Alignment, with Material 예제에서 세로 바 뒤로 콘텐츠가 흐르는 모습을 볼 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the bar's background to a system material. The photo behind shows through softly, so the content continues under the bar, and the bar's form expresses the depth relationship of \"a panel floating above the content.\" The busier the background, the thicker the material you choose, so the icons don't waver. The system adjusts brightness to match the background. In the app's 5.2.1 Leading, Top Alignment, with Material example, you can see content flowing behind a vertical bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the bar's background to a system material. The photo behind shows through softly, so the content continues under the bar, and the bar's form expresses the depth relationship of \"a panel floating above the content.\" The busier the background, the thicker the material you choose, so the icons don't waver. The system adjusts brightness to match the background. In the app's 5.2.1 Leading, Top Alignment, with Material example, you can see content flowing behind a vertical bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの背景をシステムのmaterialに変える。背後の写真がほんのり透けてコンテンツがバーの下へつながり、バーは「コンテンツの上に浮いている板」という奥行きの関係を形で語る。背後が複雑なほど厚いmaterialを選び、アイコンが揺れないようにする。明るさの補正は、システムが背景に合わせて行う。アプリの5.2.1 Leading, Top Alignment, with Materialの例で、縦のバーの背後をコンテンツが流れる様子を見られる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把栏的背景换成系统 material。后面的照片隐约透出，内容延伸到栏下方，栏用形态说出“浮在内容之上的底板”这层纵深关系。背后越复杂，就选越厚的 material，让图标不晃。亮度校正由系统按背景来做。在应用的 5.2.1 Leading, Top Alignment, with Material 示例里，可以看到内容在竖向栏后面流动的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把列的背景換成系統 material。後面的照片隱約透出，內容延伸到列下方，列用形態說出「浮在內容之上的底板」這層縱深關係。背後越複雜，就選越厚的 material，讓圖示不晃。亮度校正由系統按背景來做。在應用程式的 5.2.1 Leading, Top Alignment, with Material 示例裡，可以看到內容在豎向列後面流動的樣子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смените фон панели на системный материал. Фотография позади слабо просвечивает, поэтому контент продолжается под панелью, а форма панели выражает глубину «плиты, парящей над контентом». Чем сложнее фон, тем толще выбирайте материал, чтобы значки не колебались. Яркость система подстраивает под фон. В примере 5.2.1 Leading, Top Alignment, with Material видно, как контент течёт позади вертикальной панели."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el fondo de la barra a un material del sistema. La foto de detrás se transparenta con suavidad, así que el contenido continúa bajo la barra, y la forma de la barra expresa la relación de profundidad de «un panel flotando sobre el contenido». Cuanto más cargado el fondo, más grueso el material que eliges, para que los iconos no vacilen. El sistema ajusta el brillo para igualarlo con el fondo. En el ejemplo 5.2.1 Leading, Top Alignment, with Material de la app puedes ver el contenido fluyendo por detrás de una barra vertical."
          }
        }
      }
    },
    "바의 배경을 정할 때 묻는다. \"뒤의 콘텐츠가 이 바를 지나 **이어져 보이는가, 잘려 보이는가**?\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When choosing a bar's background, ask: \"Does the content behind look **continuous through this bar, or cut off**?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When choosing a bar's background, ask: \"Does the content behind look **continuous through this bar, or cut off**?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの背景を決めるときに問う。「背後のコンテンツは、このバーを通って**つながって見えるか、切れて見えるか**」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定栏的背景时先问：“后面的内容经过这个栏，是**看起来延续，还是看起来被切断**？”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定列的背景時先問：「後面的內容經過這個列，是**看起來延續，還是看起來被切斷**？」"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирая фон панели, спросите: «Выглядит ли контент позади **продолжающимся сквозь эту панель или обрезанным**?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al elegir el fondo de una barra, pregunta: «¿Se ve el contenido de detrás **continuo a través de esta barra, o cortado**?»"
          }
        }
      }
    },
    "반높이를 쓴 이유가 소멸": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defeats the purpose of half height"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Defeats the purpose of half height"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分の高さにした理由が消える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用半屏高度的理由消失了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用半螢幕高度的理由消失了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводит на нет смысл половинной высоты"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anula el sentido de la media altura"
          }
        }
      }
    },
    "반투명 바는 뒤의 사진이 비쳐 지저분해 보인다. 아이콘이 알록달록한 배경 위에서 흔들리는 것 같다. 단색으로 채우면 판이 또렷하고 아이콘 대비도 한 번에 정할 수 있다. 시안의 기본 배경에서는 단색이 가장 깔끔해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A translucent bar lets the photo behind show through and looks messy. The icons seem to waver over a colorful background. Fill it with a solid color, and the panel looks crisp and you can set the icon contrast once and be done. On the mockup's default background, a solid color looks cleanest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A translucent bar lets the photo behind show through and looks messy. The icons seem to waver over a colourful background. Fill it with a solid colour, and the panel looks crisp and you can set the icon contrast once and be done. On the mockup's default background, a solid colour looks cleanest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明のバーは背後の写真が透けて、ごちゃごちゃして見える。カラフルな背景の上でアイコンが揺れているように感じる。単色で塗れば板がくっきりして、アイコンのコントラストも一度で決められる。カンプのデフォルトの背景では、単色がいちばんすっきり見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明的栏会透出后面的照片，显得杂乱。图标在花花绿绿的背景上好像在晃。填成纯色，底板清晰，图标对比度也能一次定下来。在设计稿的默认背景上，纯色看起来最干净。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明的列會透出後面的照片，顯得雜亂。圖示在花花綠綠的背景上好像在晃。填成純色，底板清晰，圖示對比度也能一次定下來。在設計稿的預設背景上，純色看起來最乾淨。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полупрозрачная панель пропускает фотографию позади и выглядит неопрятно. Значки, кажется, колеблются на пёстром фоне. Залейте сплошным цветом, и панель получится чёткой, а контраст значков можно задать один раз и забыть. На стандартном фоне макета сплошной цвет выглядит чище всего."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra translúcida deja ver la foto de detrás y se ve desordenada. Los iconos parecen vacilar sobre un fondo colorido. Rellénala con un color sólido y el panel se ve nítido y puedes fijar el contraste de los iconos una vez y olvidarte. Sobre el fondo por defecto de la maqueta, un color sólido es lo que queda más limpio."
          }
        }
      }
    },
    "반투명은 뒤가 비쳐 지저분해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translucency lets the background show through and looks messy."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Translucency lets the background show through and looks messy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明は背景が透けて、ごちゃごちゃして見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明会透出后面，显得杂乱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明會透出後面，顯得雜亂。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полупрозрачность пропускает фон и выглядит неопрятно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La translucidez deja ver el fondo y se ve desordenado."
          }
        }
      }
    },
    "반투명을 숫자로 적고 싶어질 때 묻는다. **\"이 값은 어떤 배경 위에서 뽑았나?\"** 배경이 바뀌는 곳이라면 색이 아니라 재질을 쓴다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you feel like writing translucency down as a number, ask: **\"What background did I pick this value from?\"** Where the background changes, use a material, not a color."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you feel like writing translucency down as a number, ask: **\"What background did I pick this value from?\"** Where the background changes, use a material, not a colour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明を数値で書きたくなったときに問う。**「この値は、どの背景の上で拾ったのか**」背景が変わる場所なら、色ではなくマテリアルを使う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想把半透明写成数字时先问：**“这个值是在什么背景上取的？”**背景会变的地方，用材质而不是颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想把半透明寫成數字時先問：**「這個值是在什麼背景上取的？」**背景會變的地方，用材質而不是顏色。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда хочется записать полупрозрачность числом, спросите: **«С какого фона я взял это значение?»** Там, где фон меняется, используйте материал, а не цвет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te apetezca escribir una translucidez como un número, pregunta: **«¿De qué fondo saqué este valor?»** Donde el fondo cambia, usa un material, no un color."
          }
        }
      }
    },
    "발견 불가": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody discovers it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody discovers it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つけられない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法被发现"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法被發現"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не обнаружит"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie lo descubre"
          }
        }
      }
    },
    "밝은 화면 한 조건에서만 확인하고 끄면, 흰 사진이 바 뒤를 지나는 순간 컨트롤이 사라짐. \"최악의 배경에서 검증\" 기준을 건너뛴 경우": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it off after checking only one bright condition, and the controls vanish the moment a white photo passes behind the bar. This skips the \"test against the worst background\" criterion"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it off after checking only one bright condition, and the controls vanish the moment a white photo passes behind the bar. This skips the \"test against the worst background\" criterion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るい画面というひとつの条件だけで確認して切ると、白い写真がバーの後ろを通った瞬間にコントロールが消える。「最悪の背景で検証する」という基準を飛ばしたケース"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在一个明亮界面的条件下确认就关掉，白色照片从栏后经过的瞬间，控件就消失了。这是跳过了“在最糟糕的背景上验证”标准的情形"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在一個明亮介面的條件下確認就關掉，白色照片從列後經過的瞬間，控制元件就消失了。這是跳過了「在最糟糕的背景上驗證」標準的情形"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключить, проверив только одно яркое условие, элементы управления исчезнут в момент, когда белая фотография пройдёт за панелью. Это пропуск критерия «проверять на худшем фоне»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo tras comprobar solo una condición brillante, y los controles desaparecen en el momento en que una foto blanca pasa tras la barra. Esto se salta el criterio de «probar contra el peor fondo»"
          }
        }
      }
    },
    "방어 장치를 넣기 전에 묻는다. \"이 화면의 배경이 정말 방어가 필요한가?\" 방어는 필요한 곳에만 둔다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before adding a safeguard, ask: \"Does this screen's background really need defending?\" Defend only where defense is needed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before adding a safeguard, ask: \"Does this screen's background really need defending?\" Defend only where defence is needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "守りの仕掛けを入れる前に問う。「この画面の背景は、本当に守りが必要か？」 守りは必要な場所にだけ置く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加防护之前先问：“这个界面的背景真的需要防护吗？”防护只放在需要的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加防護之前先問：「這個介面的背景真的需要防護嗎？」防護只放在需要的地方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем добавлять защиту, спросите: «Нужна ли фону этого экрана на самом деле защита?» Защищайте только там, где защита нужна."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de añadir una salvaguarda, pregunta: «¿Necesita realmente defensa el fondo de esta pantalla?» Defiende solo donde haga falta defensa."
          }
        }
      }
    },
    "방향별 역할 분리": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roles split by direction"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Roles split by direction"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方向ごとの役割分担"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按方向分离角色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按方向分離角色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Роли, разделённые по направлению"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciones repartidas por dirección"
          }
        }
      }
    },
    "배경과 섞이지 않아 탁하고 죽은 색": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It never blends with the background, leaving a murky, lifeless color"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It never blends with the background, leaving a murky, lifeless colour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景と混ざらず、濁った死んだ色"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不和背景混合，发浑、像死掉的颜色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不和背景混合，發渾、像死掉的顏色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не смешивается с фоном, оставляя мутный безжизненный цвет"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se mezcla con el fondo, dejando un color turbio y sin vida"
          }
        }
      }
    },
    "배경을 어둡게 할지는 보기 좋음으로 정하지 않는다. 먼저 묻는다. \"지금 뒤를 만질 수 있나?\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't decide whether to dim the background based on looks. Ask first: \"Can the background be touched right now?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't decide whether to dim the background based on looks. Ask first: \"Can the background be touched right now?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景を暗くするかどうかは、見栄えで決めない。まず問う。「今、後ろに触れられるか？」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要不要把背景压暗，不凭好看来定。先问：“现在能操作后面吗？”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要不要把背景壓暗，不憑好看來定。先問：「現在能操作後面嗎？」"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решайте, затемнять ли фон, не по внешнему виду. Сначала спросите: «Можно ли сейчас трогать фон?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No decidas si atenuar el fondo según el aspecto. Pregunta primero: «¿Se puede tocar el fondo ahora mismo?»"
          }
        }
      }
    },
    "배경이 **확실히 단순·균일**해서 겹쳐도 가독성 문제가 없거나, 콘텐츠가 아예 바 뒤까지 도달하지 않는 레이아웃일 때만. **예외적 선택.**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when the background is **reliably simple and uniform**, so overlap causes no legibility problems, or when the layout never lets content reach behind the bar. **An exceptional choice.**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when the background is **reliably simple and uniform**, so overlap causes no legibility problems, or when the layout never lets content reach behind the bar. **An exceptional choice.**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が**確実にシンプルで均一**なので重なっても読みやすさに問題がないか、コンテンツがそもそもバーの後ろまで届かないレイアウトのときだけ。**例外的な選択。**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当背景**确定简单、均匀**，叠在一起也没有可读性问题，或者内容根本不会到达栏后面的布局时。**例外选择。**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當背景**確定簡單、均勻**，疊在一起也沒有可讀性問題，或者內容根本不會到達列後面的佈局時。**例外選擇。**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только когда фон **заведомо прост и однороден**, так что наложение не вызывает проблем с читаемостью, или когда раскладка не допускает попадания контента за панель. **Исключительный выбор.**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuando el fondo es **sencillo y uniforme de forma fiable**, de modo que el solapamiento no causa problemas de legibilidad, o cuando el diseño nunca deja que el contenido llegue detrás de la barra. **Una elección excepcional.**"
          }
        }
      }
    },
    "배경이 비쳐도 판 유지": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a solid plane even as the background shows through"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a solid plane even as the background shows through"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が透けても面が保たれる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出时保持底板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出時保持底板"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет сплошную плоскость, даже когда фон просвечивает"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene un plano sólido aunque el fondo se transparente"
          }
        }
      }
    },
    "배경이 비쳐서 안 읽히길래 색을 깔아 대비를 직접 확보한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background shows through and makes it hard to read, so you lay down a color to secure contrast yourself."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The background shows through and makes it hard to read, so you lay down a colour to secure contrast yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が透けて読みにくいので、色を敷いて自分でコントラストを確保する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出来读不清，于是铺上颜色，自己保证对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出來讀不清，於是鋪上顏色，自己保證對比度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон просвечивает и мешает читать, поэтому вы заливаете цвет, чтобы самому обеспечить контраст."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo se transparenta y dificulta la lectura, así que pones un color tú mismo para asegurar el contraste."
          }
        }
      }
    },
    "배경이 비쳐서 안 읽히니 색을 깔아 대비를 직접 확보하는 게 가장 빠르다. 눈앞의 화면에서는 문제가 바로 사라진다. 대비 문제를 스스로 해결했다고 느끼기 쉽다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background shows through and the text is hard to read, so laying down a color to secure contrast yourself is the quickest fix. On the screen in front of you, the problem vanishes immediately. It's easy to feel you've solved the contrast problem on your own."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The background shows through and the text is hard to read, so laying down a colour to secure contrast yourself is the quickest fix. On the screen in front of you, the problem vanishes immediately. It's easy to feel you've solved the contrast problem on your own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が透けて読めないのだから、色を敷いて自分でコントラストを確保するのがいちばん早い。目の前の画面では、問題がすぐに消える。コントラストの問題を自分で解決したと感じやすい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出来读不清，铺上颜色亲手保证对比度是最快的。眼前的界面里，问题立刻消失。很容易觉得自己解决了对比度问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出來讀不清，鋪上顏色親手保證對比度是最快的。眼前的介面裡，問題立刻消失。很容易覺得自己解決了對比度問題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон просвечивает, читать трудно, поэтому быстрее всего залить цвет и самому обеспечить контраст. На экране перед вами проблема исчезает сразу. Легко почувствовать, что вы решили проблему контраста самостоятельно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo se transparenta y el texto cuesta de leer, así que poner un color tú mismo para asegurar el contraste es el arreglo más rápido. En la pantalla que tienes delante, el problema desaparece al instante. Es fácil sentir que has resuelto el problema de contraste por tu cuenta."
          }
        }
      }
    },
    "배경이 이미 어둡고 잔잔하면 soft로 충분하다. 방어는 필요한 곳에만.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the background is already dark and calm, soft is enough. Defend only where defense is needed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If the background is already dark and calm, soft is enough. Defend only where defence is needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景がすでに暗く穏やかなら、soft で十分だ。守りは必要な場所にだけ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景本来就暗而平静的话，soft 就够了。防护只放在需要的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景本來就暗而平靜的話，soft 就夠了。防護只放在需要的地方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если фон уже тёмный и спокойный, достаточно soft. Защищайте только там, где защита нужна."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el fondo ya es oscuro y tranquilo, soft basta. Defiende solo donde haga falta defensa."
          }
        }
      }
    },
    "배경이 확실히 균일한 단색 화면": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen with a reliably uniform solid background"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen with a reliably uniform solid background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が確実に均一な単色の画面"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景确定是均匀纯色的界面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景確定是均勻純色的介面"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран с заведомо однородным сплошным фоном"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pantalla con un fondo sólido uniforme de forma fiable"
          }
        }
      }
    },
    "배너를 콘텐츠 목록 안으로 옮긴다. 스크롤하다 만나고, 스크롤로 지나칠 수 있다. 하단 층은 다시 조작과 진행 중 상태만 담는다. 그 층에 있는 것은 누르기 전에 따져 보지 않아도 되는 것들이 된다. 3.5.1 3 Tab Items 예제에서 액세서리 자리에 무엇이 오는지, 1.1.8 Custom Views in Bottom Toolbar 예제에서 하단 바가 무엇을 모으는 자리인지 확인해 보라.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the banner into the content list. People come across it while scrolling and can scroll right past it. The bottom layer once again holds only controls and ongoing states. Everything in that layer becomes something you can tap without second-guessing. See what goes in the accessory slot in the 3.5.1 3 Tab Items example, and what the bottom bar is meant to gather in the 1.1.8 Custom Views in Bottom Toolbar example."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the banner into the content list. People come across it while scrolling and can scroll right past it. The bottom layer once again holds only controls and ongoing states. Everything in that layer becomes something you can tap without second-guessing. See what goes in the accessory slot in the 3.5.1 3 Tab Items example, and what the bottom bar is meant to gather in the 1.1.8 Custom Views in Bottom Toolbar example."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バナーはコンテンツのリストの中に移す。スクロールしながら出会い、スクロールで通り過ぎることができる。下部の層は再び、操作と進行中の状態だけを載せる。その層にあるものは、押す前に疑わなくていいものになる。3.5.1 3 Tab Itemsの例でアクセサリの場所に何が来るのか、1.1.8 Custom Views in Bottom Toolbarの例で下部のバーが何を集める場所なのかを確かめてみよう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把横幅移到内容列表里。滚动时遇到，也可以滚动略过。底部这一层重新只装操作和进行中的状态。放在那一层的东西，成为点按之前不用多想的东西。在 3.5.1 3 Tab Items 示例里看附件位置会放什么，在 1.1.8 Custom Views in Bottom Toolbar 示例里看底部栏是汇集什么的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把橫幅移到內容列表裡。滾動時遇到，也可以滾動略過。底部這一層重新只裝操作和進行中的狀態。放在那一層的東西，成為輕點之前不用多想的東西。在 3.5.1 3 Tab Items 示例裡看附件位置會放什麼，在 1.1.8 Custom Views in Bottom Toolbar 示例裡看底部列是匯集什麼的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесите баннер в список контента. Люди наткнутся на него при прокрутке и могут прокрутить мимо. Нижний слой снова содержит только элементы управления и текущие состояния. Всё в этом слое становится тем, что можно нажать, не раздумывая. Посмотрите, что кладётся на место accessory, в примере 3.5.1 3 Tab Items, и что должна собирать нижняя панель, в примере 1.1.8 Custom Views in Bottom Toolbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el banner a la lista de contenido. La gente se lo encuentra al desplazar y puede pasar de largo. La capa inferior vuelve a tener solo controles y estados en curso. Todo en esa capa pasa a ser algo que puedes tocar sin dudar. Mira qué va en el sitio del accesorio en el ejemplo 3.5.1 3 Tab Items, y qué se pretende reunir en la barra inferior en el ejemplo 1.1.8 Custom Views in Bottom Toolbar."
          }
        }
      }
    },
    "배송 조회 화면에 운송장 번호가 크게 적혀 있다. 택배사 앱에 붙여 넣으려고 길게 눌러도 아무 반응이 없다. 쓰는 사람은 화면을 보며 열 자리가 넘는 숫자를 한 자씩 옮겨 적는다. 인증 코드를 보여 주는 화면도 마찬가지다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shipment tracking screen shows the tracking number in large text. Long-pressing it to paste into the carrier's app does nothing. People look at the screen and copy a number of more than ten digits one character at a time. The same goes for screens that show verification codes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A shipment tracking screen shows the tracking number in large text. Long-pressing it to paste into the carrier's app does nothing. People look at the screen and copy a number of more than ten digits one character at a time. The same goes for screens that show verification codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配送状況の画面に追跡番号が大きく表示されている。配送業者のアプリに貼り付けようと長押ししても、何も反応しない。使う人は画面を見ながら、10桁を超える数字を1文字ずつ書き写す。認証コードを表示する画面も同じだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询物流的界面上，运单号写得很大。长按想粘贴到快递公司的应用里，却毫无反应。使用者看着屏幕，把十几位的数字一个一个抄下来。显示验证码的界面也一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查詢物流的介面上，運單號寫得很大。長按想貼上到快遞公司的應用程式裡，卻毫無反應。使用者看著螢幕，把十幾位的數字一個一個抄下來。顯示驗證碼的介面也一樣。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране отслеживания посылки номер отправления написан крупным текстом. Долгое нажатие, чтобы вставить его в приложение перевозчика, ничего не даёт. Люди смотрят на экран и переписывают число из более чем десяти цифр по одному знаку. То же с экранами, показывающими проверочные коды."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pantalla de seguimiento de un envío muestra el número de seguimiento en texto grande. Mantenerlo pulsado para pegarlo en la app del transportista no hace nada. La gente mira la pantalla y copia un número de más de diez cifras carácter a carácter. Lo mismo pasa con las pantallas que muestran códigos de verificación."
          }
        }
      }
    },
    "배송지 목록 화면이다. 셀마다 주소가 한 줄로 잘려 \"서울특별시 강남구 테헤란로…\"에서 끝난다. 셀을 눌러도 상세 화면이 없고, 펼칠 방법도 없다. 동·호수가 맞는지 확인할 길이 화면 어디에도 없다. 쓰는 사람은 잘린 주소를 보고 배송지를 골라야 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a shipping address list screen. Each cell's address is cut to one line, ending at \"123 Teheran-ro, Gangnam-gu, Seoul…\". Tapping a cell doesn't open a detail screen, and there's no way to expand it either. Nowhere on the screen can you check whether the building and unit number are right. People have to choose a shipping address from a truncated address."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a shipping address list screen. Each cell's address is cut to one line, ending at \"123 Teheran-ro, Gangnam-gu, Seoul…\". Tapping a cell doesn't open a detail screen, and there's no way to expand it either. Nowhere on the screen can you check whether the building and unit number are right. People have to choose a shipping address from a truncated address."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配送先リストの画面だ。セルごとに住所が1行で切れて、「ソウル特別市江南区テヘラン路…」で終わる。セルを押しても詳細画面はなく、展開する方法もない。棟や部屋番号が合っているかを確かめる手段が、画面のどこにもない。使う人は切れた住所を見て配送先を選ばなければならない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是收货地址列表界面。每个单元格的地址被截成一行，止于“上海市浦东新区世纪大道…”。点单元格没有详情界面，也没有展开的办法。界面上没有任何途径确认楼号和房号对不对。使用者得看着被截断的地址来选收货地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是收貨地址列表介面。每個單元格的地址被截成一行，止於「台北市信義區信義路…」。點單元格沒有詳情介面，也沒有展開的辦法。介面上沒有任何途徑確認樓號和房號對不對。使用者得看著被截斷的地址來選收貨地址。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это экран списка адресов доставки. Адрес в каждой ячейке обрезан до одной строки и заканчивается на «Москва, ул. Тверская, д. 12…». Нажатие на ячейку не открывает экран подробностей, и развернуть её тоже нельзя. Нигде на экране нет способа проверить, верны ли дом и квартира. Людям приходится выбирать адрес доставки по обрезанному адресу."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una pantalla de lista de direcciones de envío. La dirección de cada celda se corta a una línea, terminando en «Calle de Alcalá 123, Madrid…». Al tocar una celda no se abre una pantalla de detalle, y tampoco hay forma de expandirla. En ningún sitio de la pantalla puedes comprobar si el portal y el piso son correctos. La gente tiene que elegir una dirección de envío a partir de una dirección truncada."
          }
        }
      }
    },
    "배지는 '처리할 것이 남았다'는 약속이다. 한 번 거짓말하면 이후의 모든 배지를 무시당한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A badge is a promise that \"something here still needs handling.\" Lie once, and every badge after that gets ignored."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A badge is a promise that \"something here still needs handling.\" Lie once, and every badge after that gets ignored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジは「処理すべきものが残っている」という約束だ。一度嘘をつくと、それ以降すべてのバッジが無視される。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角标是“还有待处理的事”的承诺。骗一次，之后所有角标都会被无视。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記是「還有待處理的事」的承諾。騙一次，之後所有標記都會被無視。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бейдж - это обещание, что «здесь ещё что-то требует обработки». Соврите один раз, и после этого все бейджи будут игнорироваться."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una insignia es una promesa de que «algo aquí sigue necesitando atención». Miente una vez, y todas las insignias siguientes se ignoran."
          }
        }
      }
    },
    "배지는 사용자를 부르는 **인터럽트 장치**. 빨강+숫자는 OS 전체에서 “처리 안 된 것”의 규약이라 앱이 따로 학습시킬 필요가 없음. 모든 탭에 배지를 달면 인터럽트 가치가 인플레이션, 진짜 중요한 알림이 묻힘.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A badge is an **interruption device** that calls the user over. Red plus a number is the OS-wide convention for \"not yet handled,\" so the app doesn't need to teach it. Badge every tab and the interruption loses its value, burying the alerts that really matter."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A badge is an **interruption device** that calls the user over. Red plus a number is the OS-wide convention for \"not yet handled,\" so the app doesn't need to teach it. Badge every tab and the interruption loses its value, burying the alerts that really matter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジはユーザーを呼び寄せる**割り込みの装置**。赤＋数字はOS全体で「未処理のもの」を表すお約束なので、アプリが改めて教える必要はない。すべてのタブにバッジを付けると割り込みの価値がインフレし、本当に大事な通知が埋もれる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角标是呼唤用户的**打断装置**。红色 + 数字在整个 OS 里是“未处理”的约定，应用无需另外教。给所有标签都加角标，打断的价值就会通货膨胀，真正重要的通知被淹没。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記是呼喚使用者的**打斷裝置**。紅色 + 數字在整個 OS 裡是「未處理」的約定，應用程式無需另外教。給所有標籤都加標記，打斷的價值就會通貨膨脹，真正重要的通知被淹沒。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бейдж - **прерывающее устройство**, зовущее пользователя. Красный цвет с числом - общесистемное соглашение для «ещё не обработано», поэтому приложению не нужно его объяснять. Повесьте бейдж на каждую вкладку, и прерывание обесценится, а по-настоящему важные уведомления потеряются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una insignia es un **mecanismo de interrupción** que llama al usuario. Rojo más un número es la convención de todo el sistema para «aún sin atender», así que la app no necesita enseñarla. Pon insignia a todas las pestañas y la interrupción pierde su valor, enterrando los avisos que de verdad importan."
          }
        }
      }
    },
    "배지는 장식이 아니라 **\"여기 처리할 것이 남았다\"는 약속**이다. 빨강과 숫자는 OS 전체에서 \"처리 안 된 것\"의 규약이라 앱이 따로 가르칠 필요가 없다. 그 규약을 빌려 놓고 약속을 지키지 않으면, 사용자는 눌러서 확인하고 헛걸음하는 일을 반복하다가 빨간 점을 보지 않는 법을 배운다.\n\n그때 잃는 것은 배지 하나가 아니라 **그 앱의 모든 배지**다. 정말 급한 것에 배지를 달아도 이미 무시하는 법을 익힌 뒤다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A badge is not decoration but **a promise that \"something here still needs handling.\"** Red and numbers are the OS-wide convention for \"unhandled,\" so the app doesn't need to teach them. Borrow that convention and break the promise, and users who keep tapping to check and coming up empty learn to stop seeing red dots.\n\nWhat you lose then is not one badge but **every badge in the app**. Even when you badge something truly urgent, they've already learned to ignore it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A badge is not decoration but **a promise that \"something here still needs handling.\"** Red and numbers are the OS-wide convention for \"unhandled,\" so the app doesn't need to teach them. Borrow that convention and break the promise, and users who keep tapping to check and coming up empty learn to stop seeing red dots.\n\nWhat you lose then is not one badge but **every badge in the app**. Even when you badge something truly urgent, they've already learned to ignore it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジは飾りではなく、**「ここに処理すべきものが残っている」という約束**だ。赤と数字はOS全体で「未処理のもの」を表す決まりごとなので、アプリが別に教える必要はない。その決まりごとを借りておきながら約束を守らないと、ユーザーは押して確かめては空振りすることを繰り返し、赤い印を見ない術を身につける。\n\nそのとき失うのはバッジ1つではなく、**そのアプリのすべてのバッジ**だ。本当に急ぎのものにバッジを付けても、すでに無視する術を覚えたあとなのだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角标不是装饰，而是**“这里还有待处理的事”的承诺**。红色和数字在整个 OS 里是“未处理”的约定，应用无需另外教。借了这个约定却不守承诺，用户会反复点进去确认、白跑一趟，最后学会不去看红点。\n\n那时失去的不是一个角标，而是**这个应用的所有角标**。真正紧急的事即使挂上角标，用户也已经学会了无视。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記不是裝飾，而是**「這裡還有待處理的事」的承諾**。紅色和數字在整個 OS 裡是「未處理」的約定，應用程式無需另外教。借了這個約定卻不守承諾，使用者會反覆點進去確認、白跑一趟，最後學會不去看紅點。\n\n那時失去的不是一個標記，而是**這個應用程式的所有標記**。真正緊急的事即使掛上標記，使用者也已經學會了無視。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бейдж - не украшение, а **обещание, что «здесь ещё что-то требует обработки»**. Красный цвет и числа - общесистемное соглашение для «необработанного», поэтому приложению не нужно его объяснять. Заимствуйте это соглашение и нарушьте обещание, и пользователи, которые нажимают, чтобы проверить, и остаются ни с чем, учатся не замечать красные точки.\n\nТо, что вы теряете тогда, - не один бейдж, а **все бейджи приложения**. Даже если вы повесите бейдж на действительно срочное, они уже научились его игнорировать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una insignia no es decoración sino **una promesa de que «algo aquí sigue necesitando atención»**. El rojo y los números son la convención de todo el sistema para «sin atender», así que la app no necesita enseñarlos. Toma prestada esa convención y rompe la promesa, y los usuarios que siguen tocando para comprobar y se quedan con las manos vacías aprenden a dejar de ver los puntos rojos.\n\nLo que pierdes entonces no es una insignia sino **todas las insignias de la app**. Incluso cuando pones insignia a algo realmente urgente, ya han aprendido a ignorarla."
          }
        }
      }
    },
    "배지를 달자는 이야기가 나오면 하나만 묻는다. **\"이 숫자는 무엇을 하면 줄어드는가?\"** 답이 없으면 붙이지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone suggests adding a badge, ask just one thing: **\"What do you do to make this number go down?\"** If there's no answer, don't add it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone suggests adding a badge, ask just one thing: **\"What do you do to make this number go down?\"** If there's no answer, don't add it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジを付けようという話が出たら、1つだけ問う。**「この数字は何をすれば減るのか?」** 答えがなければ付けない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提到要加角标时，只问一句：**“这个数字做什么就会减少？”**没有答案，就不要加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提到要加標記時，只問一句：**「這個數字做什麼就會減少？」**沒有答案，就不要加。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда предлагают добавить бейдж, спросите одно: **«Что нужно сделать, чтобы это число уменьшилось?»** Если ответа нет, не добавляйте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando alguien proponga añadir una insignia, pregunta solo una cosa: **«¿Qué haces para que este número baje?»** Si no hay respuesta, no la añadas."
          }
        }
      }
    },
    "배지를 실제로 처리할 수 있는 개수에 묶는다. 안 읽은 메시지, 오늘 마감인 할 일처럼 처리하면 줄어드는 수다. 0이 되면 \"0\"을 보이지 말고 배지를 없앤다. 상태를 알리는 글자 배지(\"NEW\", \"LIVE\")라면 조건이 끝나는 순간 떼어 낸다. 앱의 3.1.3 Badge Count 예제에서 숫자 배지가 무엇을 약속하는지 확인할 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie the badge to a count of things that can actually be handled: numbers that go down as you deal with them, like unread messages or to-dos due today. When it reaches 0, don't show \"0\"; remove the badge. For text badges that signal status (\"NEW,\" \"LIVE\"), take them off the moment the condition ends. The app's 3.1.3 Badge Count example shows what a number badge promises."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tie the badge to a count of things that can actually be handled: numbers that go down as you deal with them, like unread messages or to-dos due today. When it reaches 0, don't show \"0\"; remove the badge. For text badges that signal status (\"NEW,\" \"LIVE\"), take them off the moment the condition ends. The app's 3.1.3 Badge Count example shows what a number badge promises."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジを、実際に処理できる件数に結びつける。未読のメッセージや今日が締め切りのタスクのように、処理すれば減る数だ。0になったら「0」を表示せず、バッジを消す。状態を知らせる文字のバッジ（「NEW」「LIVE」）なら、条件が終わった瞬間に外す。アプリの3.1.3 Badge Countの例で、数字のバッジが何を約束しているかを確かめられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把角标绑定到真正能处理的数量上。未读消息、今天到期的待办这类处理了就会减少的数。归零时不要显示“0”，而是去掉角标。如果是标明状态的文字角标（“NEW”“LIVE”），条件一结束就摘掉。在应用的 3.1.3 Badge Count 示例里，可以确认数字角标承诺了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把標記繫結到真正能處理的數量上。未讀訊息、今天到期的待辦這類處理了就會減少的數。歸零時不要顯示「0」，而是去掉標記。如果是標明狀態的文字標記（「NEW」「LIVE」），條件一結束就摘掉。在應用程式的 3.1.3 Badge Count 示例裡，可以確認數字標記承諾了什麼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привяжите бейдж к числу того, что действительно можно обработать: числам, которые уменьшаются по мере работы, вроде непрочитанных сообщений или дел, срок которых сегодня. Когда число доходит до 0, не показывайте «0», уберите бейдж. Для текстовых бейджей, сигнализирующих о состоянии («NEW», «LIVE»), снимайте их, как только условие закончилось. Пример 3.1.3 Badge Count показывает, что обещает числовой бейдж."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ata la insignia a un recuento de cosas que realmente se puedan atender: números que bajan a medida que te ocupas de ellos, como mensajes sin leer o tareas que vencen hoy. Al llegar a 0, no muestres «0»; quita la insignia. Para las insignias de texto que señalan un estado («NUEVO», «EN VIVO»), quítalas en el momento en que termine la condición. El ejemplo 3.1.3 Badge Count de la app muestra lo que promete una insignia numérica."
          }
        }
      }
    },
    "배지에 무엇을 적을지 정할 때 **가장 긴 값**부터 넣어 본다. 그 값이 자리를 넘치면, 접는 규칙을 미리 정해 둔다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When deciding what goes in a badge, try **the longest value** first. If that value overflows the spot, decide on a collapsing rule in advance."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When deciding what goes in a badge, try **the longest value** first. If that value overflows the spot, decide on a collapsing rule in advance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッジに何を表示するかを決めるときは、**いちばん長い値**から入れてみる。その値が場所からあふれるなら、まとめるルールをあらかじめ決めておく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定角标写什么时，先从**最长的值**开始放。如果那个值放不下，就提前定好折叠规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定標記寫什麼時，先從**最長的值**開始放。如果那個值放不下，就提前定好摺疊規則。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решая, что писать на бейдже, сначала попробуйте **самое длинное значение**. Если оно не вмещается, заранее определите правило сворачивания."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al decidir qué va en una insignia, prueba primero **el valor más largo**. Si ese valor desborda el sitio, decide de antemano una regla de colapso."
          }
        }
      }
    },
    "배치 규약이 시스템 전역에서 동일해 **학습이 필요 없는 것**이 메뉴의 가치, 자주 쓰는 항목은 버튼 가까운 쪽(열리는 방향에 따라 위/아래), 관련 항목은 섹션으로 묶고, 파괴적 액션은 Divider로 분리해 빨간색. 아이콘을 곁들이는 이유는 텍스트보다 **스캔이 빠르기 때문**, 메뉴는 정독이 아니라 훑는 UI입니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu's value is that **it needs no learning**, because its layout conventions are the same across the system: frequently used items sit closest to the button (above or below, depending on which way it opens), related items are grouped into sections, and destructive actions are set apart with a Divider and shown in red. Icons are added because they're **faster to scan** than text: a menu is UI you skim, not read closely."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu's value is that **it needs no learning**, because its layout conventions are the same across the system: frequently used items sit closest to the button (above or below, depending on which way it opens), related items are grouped into sections, and destructive actions are set apart with a Divider and shown in red. Icons are added because they're **faster to scan** than text: a menu is UI you skim, not read closely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配置のお約束がシステム全体で同じなので**覚える必要がない**ことがメニューの価値。よく使う項目はボタンに近い側（開く方向によって上か下）、関連する項目はセクションでまとめ、破壊的なアクションはDividerで分けて赤にする。アイコンを添えるのはテキストより**ざっと見て探しやすいから**。メニューはじっくり読むのではなく、ざっと目を通すUIです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局惯例在整个系统中一致，**无需学习**，这就是菜单的价值：常用项靠近按钮（按展开方向在上/下），相关项按分区归组，破坏性操作用 Divider 隔开并设为红色。配图标的原因是比文字**扫视更快**，菜单不是细读，而是浏览的 UI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佈局慣例在整個系統中一致，**無需學習**，這就是選單的價值：常用項靠近按鈕（按展開方向在上/下），相關項按分割槽歸組，破壞性操作用 Divider 隔開並設為紅色。配圖示的原因是比文字**掃視更快**，選單不是細讀，而是瀏覽的 UI。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ценность меню в том, что **учиться не нужно**, потому что его соглашения о раскладке одинаковы во всей системе: часто используемые пункты стоят ближе к кнопке (выше или ниже, в зависимости от направления открытия), связанные пункты группируются в разделы, а разрушительные действия отделяются Divider и показываются красным. Значки добавляют, потому что они **быстрее для беглого просмотра**, чем текст: меню - интерфейс, который просматривают, а не читают вдумчиво."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor de un menú es que **no necesita aprendizaje**, porque sus convenciones de diseño son las mismas en todo el sistema: los elementos de uso frecuente están lo más cerca del botón (arriba o abajo, según hacia dónde se abra), los elementos relacionados se agrupan en secciones, y las acciones destructivas se separan con un Divider y se muestran en rojo. Se añaden iconos porque son **más rápidos de escanear** que el texto: un menú es una interfaz que se hojea, no que se lee con detalle."
          }
        }
      }
    },
    "배치 기준은 **검색의 지위**: 이 화면에서 검색이 ① 주인공인가 ② 자주 쓰는 조연인가 ③ 가끔 쓰는 단역인가. iOS 26의 큰 변화, 검색의 기본 위치가 **상단에서 하단으로** 이동(reachability).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Placement depends on **the status of search**: on this screen, is search ① the star, ② a frequently used supporting role, or ③ an occasional bit part? The big change in iOS 26: search's default position moved **from the top to the bottom** (reachability)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Placement depends on **the status of search**: on this screen, is search ① the star, ② a frequently used supporting role, or ③ an occasional bit part? The big change in iOS 26: search's default position moved **from the top to the bottom** (reachability)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配置の基準は**検索の立ち位置**：この画面で検索は ① 主役か、② よく使う脇役か、③ たまに出る端役か。iOS 26の大きな変化として、検索のデフォルト位置が**上部から下部へ**移動した（reachability）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布局标准是**搜索的地位**：在这个界面里搜索是 ① 主角 ② 常用的配角 ③ 偶尔用的小角色。iOS 26 的一大变化，是搜索的默认位置从**顶部移到了底部**（可触达性）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佈局標準是**搜尋的地位**：在這個介面裡搜尋是 ① 主角 ② 常用的配角 ③ 偶爾用的小角色。iOS 26 的一大變化，是搜尋的預設位置從**頂部移到了底部**（可觸達性）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расположение зависит от **статуса поиска**: на этом экране поиск ① главный герой, ② часто используемая второстепенная роль или ③ редкая эпизодическая? Большое изменение в iOS 26: положение поиска по умолчанию переместилось **сверху вниз** (досягаемость)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La colocación depende de **la categoría de la búsqueda**: en esta pantalla, ¿la búsqueda es ① la protagonista, ② una función de apoyo de uso frecuente o ③ un papel secundario ocasional? El gran cambio de iOS 26: la posición por defecto de la búsqueda pasó **de arriba a abajo** (alcance)."
          }
        }
      }
    },
    "버튼 라벨에 선택 허용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selection enabled on button labels"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Selection enabled on button labels"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンのラベルで選択を有効にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许在按钮标签上选择文字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許在按鈕標籤上選擇文字"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделение включено на подписях кнопок"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selección activada en las etiquetas de los botones"
          }
        }
      }
    },
    "버튼 라벨에까지 텍스트 선택을 허용한다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing text selection even on button labels"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing text selection even on button labels"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンのラベルにまでテキスト選択を許可する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连按钮标签也允许文本选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連按鈕標籤也允許文字選擇"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение выделять текст даже на подписях кнопок"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir la selección de texto incluso en las etiquetas de los botones"
          }
        }
      }
    },
    "버튼 자리를 정할 때 \"얼마나 중요한가\" 대신 **\"몇 번 누르는가\"**를 먼저 적는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When deciding where a button goes, first write down **\"how many times is it tapped?\"** instead of \"how important is it?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When deciding where a button goes, first write down **\"how many times is it tapped?\"** instead of \"how important is it?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンの場所を決めるときは、「どれだけ重要か」の代わりに、まず「**何回押すか**」を書き出す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定按钮位置时，先写下**“点几次”**，而不是“有多重要”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定按鈕位置時，先寫下**「點幾次」**，而不是「有多重要」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решая, куда поставить кнопку, сначала запишите **«сколько раз её нажимают»**, а не «насколько она важна»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al decidir dónde va un botón, anota primero **«¿cuántas veces se toca?»** en lugar de «¿qué importancia tiene?»"
          }
        }
      }
    },
    "버튼을 눈에 띄게 만들기 전에 묻는다. \"사용자가 이미 찾을 줄 아는 자리에 있나?\" 찾을 줄 아는 자리에 있으면 눈에 띌 필요가 줄어든다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before making a button stand out, ask: \"Is it somewhere users already know to look?\" If it is, it doesn't need to stand out nearly as much."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before making a button stand out, ask: \"Is it somewhere users already know to look?\" If it is, it doesn't need to stand out nearly as much."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを目立たせる前に問う。「ユーザーがすでに探し方を知っている場所にあるか？」そういう場所にあれば、目立つ必要は小さくなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想让按钮显眼之前先问：“它在用户已经知道去找的位置吗？”在知道去找的位置上，就不用那么显眼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想讓按鈕顯眼之前先問：「它在使用者已經知道去找的位置嗎？」在知道去找的位置上，就不用那麼顯眼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем делать кнопку заметной, спросите: «Стоит ли она там, где пользователи уже знают, что искать?» Если да, ей не нужно быть настолько заметной."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de hacer que un botón destaque, pregunta: «¿Está en un sitio donde los usuarios ya saben mirar?» Si lo está, no necesita destacar ni de lejos tanto."
          }
        }
      }
    },
    "버튼을 모아두면 정리돼 보이고 구현도 단순하다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grouping buttons together looks tidy and keeps the implementation simple."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Grouping buttons together looks tidy and keeps the implementation simple."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンをまとめておくと整理されて見えるし、実装も単純だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把按钮聚在一起，看起来整齐，实现也简单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把按鈕聚在一起，看起來整齊，實作也簡單。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если собрать кнопки вместе, всё выглядит аккуратно, а реализация проста."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupar botones queda ordenado y mantiene sencilla la implementación."
          }
        }
      }
    },
    "버튼을 하나 더 만들기 전에 묻는다. **\"이 액션의 대상이 이미 화면에 있나?\"** 있다면 그 대상을 누르게 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before making one more button, ask: **\"Is the target of this action already on screen?\"** If it is, let people tap the target itself."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before making one more button, ask: **\"Is the target of this action already on screen?\"** If it is, let people tap the target itself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンをもう1つ作る前に問う。**「このアクションの対象は、すでに画面にあるか**」あるなら、その対象をタップさせる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再做一个按钮之前，先问：**“这个操作的对象已经在界面上了吗？”**有的话，就让用户点按那个对象。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再做一個按鈕之前，先問：**「這個操作的物件已經在介面上了嗎？」**有的話，就讓使用者輕點那個物件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем делать ещё одну кнопку, спросите: **«Объект этого действия уже есть на экране?»** Если да, пусть люди нажимают на сам объект."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de hacer un botón más, pregunta: **«¿Está ya en pantalla el objetivo de esta acción?»** Si lo está, deja que la gente toque el propio objetivo."
          }
        }
      }
    },
    "범위만 지정하고 넘친 내용을 볼 “더보기” 경로를 안 만듦": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A range is set, but there's no “More” path to see the content that overflows"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A range is set, but there's no “More” path to see the content that overflows"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲だけ指定して、あふれた内容を見る「もっと見る」の手段を用意していない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只指定了范围，却没做可看溢出内容的“查看更多”路径"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只指定了範圍，卻沒做可看溢位內容的「檢視更多」路徑"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диапазон задан, но нет пути «Ещё», чтобы увидеть переполнившее содержимое"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se fija un rango, pero no hay un camino de «Más» para ver el contenido que desborda"
          }
        }
      }
    },
    "보관함": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Library"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料库"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca"
          }
        }
      }
    },
    "보기 전환·정렬·필터는 한 캡슐(한 세트=도구), 완료는 별도 단일 캡슐(결정). 캡슐 사이의 빈 공간이 \"서로 다른 일\"이라는 정보를 전달 (1.1.3).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View switching, sorting and filtering share one capsule (one set = tools), while Done gets its own single capsule (a decision). The empty space between the capsules tells users these are \"different jobs\" (1.1.3)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "View switching, sorting and filtering share one capsule (one set = tools), while Done gets its own single capsule (a decision). The empty space between the capsules tells users these are \"different jobs\" (1.1.3)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示切り替え・並べ替え・フィルタはひとつのカプセル（ひとつのセット = ツール）、完了は独立したカプセル（決定）。カプセル間の余白が「別々の仕事」という情報を伝える (1.1.3)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换视图 · 排序 · 筛选在一个胶囊里（一组 = 工具），完成是单独的胶囊（决定）。胶囊之间的空白传达“这是不同的事”的信息（1.1.3）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換檢視 · 排序 · 篩選在一個膠囊裡（一組 = 工具），完成是單獨的膠囊（決定）。膠囊之間的空白傳達「這是不同的事」的資訊（1.1.3）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смена вида, сортировка и фильтр - в одной капсуле (один набор = инструменты), а «Готово» получает свою отдельную капсулу (решение). Пустое место между капсулами сообщает пользователям, что это «разные задачи» (1.1.3)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio de vista, ordenar y filtrar comparten una cápsula (un conjunto = herramientas), mientras que Listo tiene su propia cápsula individual (una decisión). El espacio vacío entre las cápsulas dice a los usuarios que son «trabajos distintos» (1.1.3)."
          }
        }
      }
    },
    "복사해 쓸 값이 몇 개 있다. 하나하나 거는 것보다 상위 뷰에 한 번 거는 게 편하다. 선택은 막는 것보다 허용하는 쪽이 친절해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are a few values people will want to copy. Applying it once to the parent view is easier than applying it to each one. Allowing selection seems friendlier than blocking it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There are a few values people will want to copy. Applying it once to the parent view is easier than applying it to each one. Allowing selection seems friendlier than blocking it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーして使う値がいくつかある。1つずつかけるより、親ビューに一度かけるほうが楽だ。選択は、禁止するより許可するほうが親切に見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有几个值是要复制来用的。比起一个个加，在上层视图加一次更方便。比起禁止，允许选择看起来更体贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有幾個值是要複製來用的。比起一個個加，在上層檢視加一次更方便。比起禁止，允許選擇看起來更體貼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть несколько значений, которые люди захотят скопировать. Применить один раз к родительскому представлению проще, чем к каждому. Разрешить выделение кажется дружелюбнее, чем запретить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay unos pocos valores que la gente querrá copiar. Aplicarlo una vez a la vista padre es más fácil que aplicarlo a cada uno. Permitir la selección parece más amable que bloquearla."
          }
        }
      }
    },
    "복잡한 배경에서 반투명 유리의 대비가 부족해지면 투명도(미학)를 포기하고 불투명 배경으로 가독성을 확보. \"예쁜데 안 읽힌다\"에 대한 공식 탈출구": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When translucent glass loses contrast over a busy background, give up transparency (aesthetics) and secure legibility with an opaque background. The official way out of \"pretty but unreadable\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When translucent glass loses contrast over a busy background, give up transparency (aesthetics) and secure legibility with an opaque background. The official way out of \"pretty but unreadable\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複雑な背景で半透明のガラスのコントラストが足りなくなったら、透明感（美しさ）を手放し、不透明な背景で可読性を確保する。「きれいだけど読めない」への公式の逃げ道"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在复杂背景上，半透明玻璃对比度不足时，放弃通透（美观），用不透明背景来保证可读性。这是“好看但读不清”的官方出路"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在複雜背景上，半透明玻璃對比度不足時，放棄通透（美觀），用不透明背景來保證可讀性。這是「好看但讀不清」的官方出路"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда полупрозрачное стекло теряет контраст на сложном фоне, откажитесь от прозрачности (эстетики) и обеспечьте читаемость непрозрачным фоном. Официальный выход из ситуации «красиво, но не читается»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el cristal translúcido pierde contraste sobre un fondo cargado, renuncia a la transparencia (estética) y asegura la legibilidad con un fondo opaco. La salida oficial de lo «bonito pero ilegible»"
          }
        }
      }
    },
    "본문 긴 문단까지 vibrant 처리": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Making long body paragraphs vibrant too"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Making long body paragraphs vibrant too"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の長い段落までvibrantにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连长正文段落也做 vibrant 处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連長正文段落也做 vibrant 處理"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делать vibrant и длинные абзацы основного текста"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer vibrantes también los párrafos largos del cuerpo"
          }
        }
      }
    },
    "본문 문단에 글자 축소를 걸어 화면마다 크기가 달라진다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaling body paragraphs, so the text size changes from screen to screen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaling body paragraphs, so the text size changes from screen to screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の段落に文字の縮小をかけ、画面ごとにサイズが変わる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给正文段落加文字缩小，各界面的大小就不一样了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給正文段落加文字縮小，各介面的大小就不一樣了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштабирование абзацев основного текста, из-за чего размер текста меняется от экрана к экрану"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalar los párrafos del cuerpo, de modo que el tamaño del texto cambia de una pantalla a otra"
          }
        }
      }
    },
    "본문 문단에 적용해 화면마다 글자 크기가 제각각": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied to body paragraphs, so the text size differs from screen to screen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied to body paragraphs, so the text size differs from screen to screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の段落に適用し、画面ごとに文字サイズがばらばら"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
