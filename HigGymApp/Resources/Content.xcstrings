    "⋯ 메뉴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ⋯ menu"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A ⋯ menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⋯メニュー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⋯ 菜单"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⋯ 選單"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню ⋯"
          }
        },
        "es": {
          "stringUnit": {
