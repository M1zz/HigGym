    "**iOS 26의 검색 하단 이동** (1.4.1)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Search moving to the bottom in iOS 26** (1.4.1)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Search moving to the bottom in iOS 26** (1.4.1)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**iOS 26での検索の下部への移動**（1.4.1）"
          }
