            "state": "translated",
            "value": "性質の違うアクションをひとつのカプセルにまとめる"
          }
        }
      }
    },
    "세 자리 숫자를 그대로 노출": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
