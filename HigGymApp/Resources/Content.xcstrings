            "value": "Нажать карточку → она раскрывается в шторку подробностей этой карточки"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar una tarjeta → se expande en la hoja de detalle de esa tarjeta"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karte antippen → sie erweitert sich zum Detail-Sheet dieser Karte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une carte → elle se déploie en la feuille de détail de cette carte"
          }
        },
        "it": {
