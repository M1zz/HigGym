        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slået fra på alle skærme, fordi »det ser mere minimalt ud«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιημένο σε κάθε οθόνη επειδή «φαίνεται πιο μινιμαλιστικό»"
          }
        }
      }
    },
    "“빈 자리 = 실패”라는 오해로 모든 위치에 버튼을 배분": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons spread across every position out of the misconception that “an empty slot = failure”"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons spread across every position out of the misconception that “an empty slot = failure”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「空いた位置 = 失敗」という誤解から、すべての位置にボタンを配分"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "误以为“空位 = 失败”，把按钮分配到每个位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "誤以為「空位 = 失敗」，把按鈕分配到每個位置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки расставлены на каждое место из-за заблуждения, что «пустое место = провал»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Botones repartidos por todas las posiciones por la idea equivocada de que «un hueco vacío = fracaso»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons auf jede Position verteilt, aus dem Irrglauben, ein „leerer Platz = Fehler“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des boutons répartis à chaque position par erreur de croire qu'« un emplacement vide = un échec »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsanti sparsi in ogni posizione per il malinteso che «uno slot vuoto = fallimento»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Botões espalhados por todas as posições pelo equívoco de que «um lugar vazio = fracasso»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มกระจายทุกตำแหน่งจากความเข้าใจผิดที่ว่า “ช่องว่าง = ความล้มเหลว”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nút rải khắp mọi vị trí do hiểu lầm “ô trống = thất bại”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítka rozházená po každé pozici z mylné představy, že „prázdný slot = selhání“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper spredt over alle positioner ud fra den misforståelse, at »en tom plads = fiasko«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κουμπιά απλωμένα σε κάθε θέση από την παρανόηση ότι «μια άδεια θέση = αποτυχία»"
          }
        }
      }
    },
    "“어디로 가는가”에 답 못 함": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It can't answer \"Where does it go?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It can't answer \"Where does it go?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「どこへ行くのか」に答えられない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答不了“要去哪里”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回答不了「要去哪裡」"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не может ответить «куда это ведёт?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede responder a «¿Adónde va?»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann „Wohin geht es?“ nicht beantworten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne peut pas répondre à « Où cela va-t-il ? »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sa rispondere a «Dove va?»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegue responder «Onde vai?»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันตอบ \"จะไปอยู่ที่ไหน\" ไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó không trả lời được \"Nó đi đâu?\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neodpoví na „Kam to vede?“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan ikke svare på »Hvor hører den hjemme?«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν μπορεί να απαντήσει «Πού πηγαίνει;»"
          }
        }
      }
    },
    "“지금 얼마나 보고 싶은지”는 시스템이 판단할 수 없는 **사용자의 의도**, 그래서 높이 선택권 자체를 사용자에게 넘긴 것. 끌어올리는 제스처가 곧 의도 표현이고, 그랩바는 “단계가 더 있다”는 어포던스입니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"How much do I want to see right now?\" is **the user's intent**, which the system can't judge, so the choice of height itself is handed to the user. The drag-up gesture is how they express that intent, and the grabber is the affordance that says \"there are more steps.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "\"How much do I want to see right now?\" is **the user's intent**, which the system can't judge, so the choice of height itself is handed to the user. The drag-up gesture is how they express that intent, and the grabber is the affordance that says \"there are more steps.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今どれだけ見たいか」はシステムには判断できない**ユーザーの意図**。だから高さを選ぶこと自体をユーザーに委ねた。引き上げるジェスチャーがそのまま意図の表明で、グラバーは「まだ段階がある」ことを示すアフォーダンスです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“现在想看多少”是系统无法判断的**用户意图**，所以把高度的选择权本身交给了用户。向上拉的手势就是意图的表达，抓取条是“还有更多档位”的提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「現在想看多少」是系統無法判斷的**使用者意圖**，所以把高度的選擇權本身交給了使用者。向上拉的手勢就是意圖的表達，抓取列是「還有更多檔位」的提示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сколько я хочу видеть прямо сейчас» - это **намерение пользователя**, которое система оценить не может, поэтому выбор самой высоты отдан пользователю. Жест вытягивания вверх - способ выразить это намерение, а ручка-индикатор - подсказка «ступеней больше»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«¿Cuánto quiero ver ahora mismo?» es **la intención del usuario**, que el sistema no puede juzgar, así que la elección de altura se entrega al propio usuario. El gesto de arrastrar hacia arriba es cómo expresa esa intención, y el tirador es la pista visual que dice «hay más escalones»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wie viel will ich gerade sehen?“ ist **die Absicht des Nutzers**, die das System nicht beurteilen kann, also wird die Wahl der Höhe selbst dem Nutzer überlassen. Die Ziehgeste nach oben ist seine Art, diese Absicht auszudrücken, und der Griff ist das Affordance, das sagt: „Es gibt weitere Stufen.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Combien est-ce que je veux voir en ce moment ? » est **l'intention de l'utilisateur**, que le système ne peut pas juger, donc le choix de la hauteur elle-même est remis à l'utilisateur. Le geste de tirer vers le haut est sa façon d'exprimer cette intention, et la poignée est l'affordance qui dit « il y a d'autres crans »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Quanto voglio vedere adesso?» è **l'intenzione dell'utente**, che il sistema non può giudicare, quindi la scelta stessa dell'altezza viene affidata all'utente. Il gesto di trascinare su è il modo in cui esprime quell'intenzione, e la maniglia è l'affordance che dice «ci sono altri passi»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "«Quanto quero ver agora?» é **a intenção do usuário**, que o sistema não consegue julgar, então a escolha da própria altura é entregue ao usuário. O gesto de arrastar para cima é o modo de ele expressar essa intenção, e a alça é a affordance que diz «há mais passos»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ตอนนี้อยากเห็นมากแค่ไหน\" คือ**เจตนาของผู้ใช้** ซึ่งระบบตัดสินแทนไม่ได้ การเลือกความสูงจึงถูกมอบให้ผู้ใช้ ท่าทางลากขึ้นคือวิธีที่พวกเขาแสดงเจตนานั้น และ grabber คือ affordance ที่บอกว่า \"ยังมีขั้นอีก\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Lúc này tôi muốn xem bao nhiêu?\" là **ý định của người dùng**, điều hệ thống không phán đoán được, nên việc chọn chiều cao được trao cho người dùng. Cử chỉ kéo lên là cách họ bày tỏ ý định đó, và grabber là affordance nói rằng \"còn bậc nữa.\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Kolik chci právě teď vidět?“ je **záměr uživatele**, který systém posoudit nemůže, a proto je volba výšky svěřena uživateli. Gesto tažení nahoru je způsob, jak ten záměr vyjádří, a grabber je affordance, která říká „je tu víc kroků“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»Hvor meget vil jeg se lige nu?« er **brugerens hensigt**, som systemet ikke kan bedømme, så selve valget af højde overlades til brugeren. Trækbevægelsen opad er måden, de udtrykker den hensigt på, og grabberen er affordancen, der siger »der er flere trin.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «πόσο θέλω να δω αυτή τη στιγμή» είναι **η πρόθεση του χρήστη**, την οποία το σύστημα δεν μπορεί να κρίνει, οπότε η ίδια η επιλογή ύψους παραδίδεται στον χρήστη. Η χειρονομία σύρσιμου προς τα πάνω είναι ο τρόπος που εκφράζει αυτή την πρόθεση, και το grabber είναι το affordance που λέει «υπάρχουν κι άλλα βήματα»."
          }
        }
      }
    },
