        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกณฑ์การเรียงที่เพิ่มเป็น Picker พร้อมเครื่องหมายถูกที่ค่าปัจจุบัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
