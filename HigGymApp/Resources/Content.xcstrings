        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Li fondi in un unico pezzo per sfruttare al meglio l'unica riga in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você os funde numa peça só para aproveitar ao máximo a única linha de baixo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณรวมเป็นชิ้นเดียวเพื่อใช้แถวเดียวที่ด้านล่างให้เต็มที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn gộp chúng thành một khối để tận dụng hàng duy nhất ở dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučíte je do jednoho kusu, abyste využili jediný řádek dole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du slår dem sammen til ét stykke for at udnytte den enkelte række i bunden bedst muligt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα συγχωνεύεις σε ένα κομμάτι για να αξιοποιήσεις στο έπακρο τη μοναδική γραμμή κάτω."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistät ne yhdeksi kappaleeksi hyödyntääksesi alaosan yhden rivin parhaalla tavalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu menggabungkan keduanya menjadi satu bagian untuk memanfaatkan satu baris di bawah sebaik-baiknya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du slår dem sammen til ett stykke for å få mest mulig ut av den enkelte raden nederst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je voegt ze samen tot één stuk om het meeste uit de ene rij onderaan te halen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalasz je w jedną całość, by jak najlepiej wykorzystać pojedynczy rząd u dołu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du slår ihop dem till ett stycke för att utnyttja den enda raden längst ner på bästa sätt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alttaki tek satırdan en iyi şekilde yararlanmak için ikisini tek parçada birleştirirsin."
          }
        }
      }
    },
    "하단에 **상태 정보 + 액션**을 함께 보여줄 때, Safari의 주소창, 메일의 \"업데이트됨: 방금 전\" + 작성 버튼, 음악 재생 컨트롤 등.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the bottom shows **status and actions** together: Safari's address bar, Mail's \"Updated Just Now\" + the compose button, music playback controls, and so on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the bottom shows **status and actions** together: Safari's address bar, Mail's \"Updated Just Now\" + the compose button, music playback controls, and so on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部に**状態の情報 + アクション**を一緒に見せるとき。Safariのアドレスバー、メールの「更新：たった今」+ 作成ボタン、音楽の再生コントロールなど。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在底部同时显示**状态信息 + 操作**时：Safari 的地址栏、邮件的“更新于：刚刚”+ 撰写按钮、音乐播放控件等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在底部同時顯示**狀態資訊 + 操作**時：Safari 的位址列、郵件的「更新於：剛剛」+ 撰寫按鈕、音樂播放控制元件等。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда внизу показаны **состояние и действия** вместе: адресная строка Safari, «Обновлено только что» + кнопка создания письма в Почте, элементы управления воспроизведением музыки и так далее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la parte inferior muestra **estado y acciones** juntos: la barra de direcciones de Safari, «Actualizado ahora mismo» de Correo + el botón de redactar, los controles de reproducción de música, etc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der untere Rand **Status und Aktionen** zusammen zeigt: die Adressleiste von Safari, Mails „Gerade aktualisiert“ + der Verfassen-Button, Musikwiedergabesteuerung und so weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le bas montre **un état et des actions** ensemble : la barre d'adresse de Safari, le « Mis à jour à l'instant » de Mail + le bouton Rédiger, les commandes de lecture musicale, et ainsi de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando il basso mostra insieme **stato e azioni**: la barra degli indirizzi di Safari, «Aggiornato adesso» di Mail + il pulsante di scrittura, i controlli di riproduzione musicale e così via."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a parte de baixo mostra **status e ações** juntos: a barra de endereço do Safari, «Atualizado agora» do Mail + o botão de escrever, os controles de reprodução de música e assim por diante."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อด้านล่างแสดง**สถานะและการกระทำ**ด้วยกัน: แถบที่อยู่ของ Safari \"อัปเดตเมื่อสักครู่\" + ปุ่มเขียนของเมล ปุ่มควบคุมการเล่นเพลง และอื่น ๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi phần dưới hiển thị **trạng thái và hành động** cùng nhau: thanh địa chỉ của Safari, \"Vừa cập nhật\" + nút soạn của Mail, điều khiển phát nhạc, v.v."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když spodek zobrazuje **stav a akce** společně: adresní řádek Safari, „Právě aktualizováno“ + tlačítko psaní v Poště, ovládání přehrávání hudby a podobně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når bunden viser **status og handlinger** sammen: Safaris adresselinje, Mails »Opdateret lige nu« + skriveknappen, musikafspilningskontroller og så videre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το κάτω μέρος δείχνει **κατάσταση και ενέργειες** μαζί: η γραμμή διευθύνσεων του Safari, το «Μόλις ενημερώθηκε» του Mail + το κουμπί σύνταξης, οι έλεγχοι αναπαραγωγής μουσικής κ.ο.κ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun alaosa näyttää **tilan ja toiminnot** yhdessä: Safarin osoitepalkki, Mailin ”Päivitetty juuri nyt” + kirjoituspainike, musiikin toistosäätimet ja niin edelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat bagian bawah menampilkan **status dan aksi** bersama: kolom alamat Safari, \"Baru Diperbarui\" Mail + tombol tulis, kontrol pemutaran musik, dan sebagainya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når bunnen viser **status og handlinger** sammen: Safaris adresselinje, Mails «Oppdatert nå nettopp» + skriveknappen, musikkavspillingskontroller og så videre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer de onderkant **status en acties** samen toont: de adresbalk van Safari, \"Zojuist bijgewerkt\" + de schrijfknop van Mail, afspeelbediening van muziek, enzovoort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy dół pokazuje **stan i akcje** razem: pasek adresu Safari, „Zaktualizowano przed chwilą” + przycisk tworzenia w Mailu, sterowanie odtwarzaniem muzyki i tym podobne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När botten visar **status och åtgärder** tillsammans: Safaris adressfält, Mails ”Uppdaterad nyss” + skrivknappen, musikuppspelningskontroller och så vidare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt kısım **durumu ve eylemleri** birlikte gösterdiğinde: Safari'nin adres çubuğu, Mail'in “Az Önce Güncellendi” + yaz düğmesi, müzik oynatma kontrolleri ve benzerleri."
          }
        }
      }
    },
    "하단에 검색+버튼 2개 이상이면 과밀입니다. 검색 + 핵심 액션 1개가 균형점.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search plus two or more buttons at the bottom is overcrowded. Search + one core action is the sweet spot."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Search plus two or more buttons at the bottom is overcrowded. Search + one core action is the sweet spot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部に検索 + ボタン2つ以上は詰め込みすぎです。検索 + 核となるアクション1つがちょうどいいバランス。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部有搜索 + 两个以上按钮就拥挤了。搜索 + 一个核心操作才是平衡点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "底部有搜尋 + 兩個以上按鈕就擁擠了。搜尋 + 一個核心操作才是平衡點。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск плюс две и более кнопки внизу - перебор. Поиск + одно основное действие - золотая середина."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Búsqueda más dos o más botones abajo es abarrotado. Búsqueda + una acción principal es el punto óptimo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche plus zwei oder mehr Buttons unten ist überfüllt. Suche + eine Kernaktion ist der Sweet Spot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche plus deux boutons ou plus en bas est surchargé. Recherche + une action principale est le point idéal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca più due o più pulsanti in basso è sovraffollato. Ricerca + un'azione chiave è il punto ideale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca mais dois ou mais botões embaixo é sobrecarga. Busca + uma ação central é o ponto ideal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาบวกสองปุ่มขึ้นไปที่ด้านล่างแออัด การค้นหา + หนึ่งการกระทำหลักคือจุดที่ลงตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm cộng hai nút trở lên ở dưới là quá tải. Tìm kiếm + một hành động cốt lõi là điểm ngọt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání plus dvě nebo více tlačítek dole je přeplněné. Hledání + jedna klíčová akce je ideální bod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgning plus to eller flere knapper i bunden er overfyldt. Søgning + én hovedhandling er det optimale punkt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζήτηση συν δύο ή περισσότερα κουμπιά κάτω είναι υπερφορτωμένο. Αναζήτηση + μία βασική ενέργεια είναι το ιδανικό σημείο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haku plus kaksi tai useampia painikkeita alhaalla on ylitäysi. Haku + yksi keskeinen toiminto on ihanteellinen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian plus dua tombol atau lebih di bawah itu terlalu penuh. Pencarian + satu aksi inti adalah titik terbaik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søk pluss to eller flere knapper nederst er overfylt. Søk + én kjernehandling er det optimale punktet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoeken plus twee of meer knoppen onderaan is overvol. Zoeken + één kernactie is het ideale punt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie plus dwa lub więcej przycisków u dołu to przeładowanie. Wyszukiwanie + jedna główna akcja to złoty środek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökning plus två eller fler knappar längst ner är överfullt. Sökning + en kärnåtgärd är den bästa balansen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altta arama artı iki ya da daha fazla düğme aşırı kalabalık. Arama + bir temel eylem tatlı noktadır."
          }
        }
      }
    },
