          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "[.medium, .large]: ประกาศ detent **หลายอัน** และให้คนลากระหว่างขั้น"
          }
        },
        "vi": {
          "stringUnit": {
