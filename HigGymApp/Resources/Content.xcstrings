            "value": "Το να το εφαρμόσεις σε ολόκληρη την οθόνη μονομιάς είναι βολικό."
          }
        }
      }
    },
    "화면 정체성과 무관한 **공유** 버튼을 정중앙에": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **Share** button, unrelated to the screen's identity, placed dead center"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **Share** button, unrelated to the screen's identity, placed dead centre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のアイデンティティと無関係な**共有**ボタンを真ん中に"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把与界面身份无关的**分享**按钮放在正中间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把與介面身份無關的**分享**按鈕放在正中間"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка **«Поделиться»**, не связанная с идентичностью экрана, поставлена строго по центру"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón **Compartir**, sin relación con la identidad de la pantalla, colocado en el centro exacto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein **Teilen**-Button, der mit der Identität des Bildschirms nichts zu tun hat, genau in der Mitte platziert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bouton **Partager**, sans rapport avec l'identité de l'écran, placé pile au centre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pulsante **Condividi**, estraneo all'identità della schermata, collocato al centro esatto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um botão **Compartilhar**, sem relação com a identidade da tela, posto no centro exato"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่ม**แชร์**ที่ไม่เกี่ยวกับตัวตนของหน้าจอ วางกึ่งกลางพอดี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nút **Chia sẻ**, không liên quan đến danh tính màn hình, đặt ngay chính giữa"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítko **Sdílet**, nesouvisející s identitou obrazovky, umístěné přesně uprostřed"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En **Del**-knap, urelateret til skærmens identitet, placeret i den nøjagtige midte"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα κουμπί **Κοινοποίηση**, άσχετο με την ταυτότητα της οθόνης, τοποθετημένο στο ακριβές κέντρο"
          }
        }
      }
    },
    "화면 정체성과 무관한 버튼을 정중앙(principal)에 둔다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting a button unrelated to the screen's identity in the center (principal)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting a button unrelated to the screen's identity in the centre (principal)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のアイデンティティと無関係なボタンを真ん中（principal）に置く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把与界面身份无关的按钮放在正中间（principal）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
