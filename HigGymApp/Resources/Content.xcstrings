    "요소가 **화면 전체로 확대**, 사진 뷰어 패턴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The element **expands to fill the screen**, the photo viewer pattern"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The element **expands to fill the screen**, the photo viewer pattern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要素が**画面全体へ拡大**。写真ビューアのパターン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "元素**放大到整个屏幕**，照片查看器的模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "元素**放大到整個螢幕**，照片檢視器的模式"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент **разворачивается на весь экран**, паттерн просмотрщика фото"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento **se expande hasta llenar la pantalla**, el patrón del visor de fotos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Element **dehnt sich auf den ganzen Bildschirm aus**, das Muster des Fotobetrachters"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément **se déploie pour remplir l'écran**, le motif du visualiseur de photos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
