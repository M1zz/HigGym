            "state": "translated",
            "value": "Input og handlinger er forskellige slags ting. Del kapslerne for at skelne dem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εισαγωγή και οι ενέργειες είναι διαφορετικά είδη πραγμάτων. Χώρισε τις κάψουλες για να τα ξεχωρίσεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syöttö ja toiminnot ovat eri lajin asioita. Jaa kapselit erottaaksesi ne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Input dan aksi adalah hal yang berbeda jenis. Pisahkan kapsul untuk membedakannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inndata og handlinger er ulike typer ting. Del kapslene for å skille dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Invoer en acties zijn verschillende soorten dingen. Splits de capsules om ze uit elkaar te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadzanie i akcje to różne rodzaje rzeczy. Rozdziel kapsuły, by je odróżnić."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inmatning och åtgärder är olika slags saker. Dela kapslarna för att skilja dem åt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdi ve eylemler farklı türden şeylerdir. Ayırt etmek için kapsülleri böl."
          }
        }
      }
    },
    "입력은 경계가 생명이다. 하단만 hard로 바꾼다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For input, the boundary is everything. Switch only the bottom to hard."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For input, the boundary is everything. Switch only the bottom to hard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力は境界が命だ。下部だけを hard に変える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入的生命在于边界。只把底部改成 hard。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入的生命在於邊界。只把底部改成 hard。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ввода граница решает всё. Переключите на hard только нижнюю."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la entrada, el límite lo es todo. Cambia a hard solo la parte inferior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Eingabe ist die Grenze alles. Stelle nur den unteren Rand auf hard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour la saisie, la limite est tout. Ne passez que le bas sur hard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per l'input, il confine è tutto. Passa a hard solo il basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a entrada, a fronteira é tudo. Passe para hard só a parte de baixo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับอินพุต ขอบเขตคือทุกอย่าง สลับเฉพาะด้านล่างเป็น hard"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với nhập liệu, ranh giới là tất cả. Chỉ chuyển phần dưới sang hard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U vstupu je hranice vším. Přepněte na hard jen spodek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For input er grænsen alt. Skift kun bunden til hard."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για εισαγωγή, το όριο είναι τα πάντα. Άλλαξε μόνο το κάτω σε hard."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötössä raja on kaikki. Vaihda vain alaosa hardiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk input, batas adalah segalanya. Ubah hanya bagian bawah ke hard."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For inndata er grensen alt. Bytt bare bunnen til hard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor invoer is de grens alles. Zet alleen de onderkant op hard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla wprowadzania granica jest wszystkim. Przełącz na hard tylko dół."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För inmatning är gränsen allt. Byt bara botten till hard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdi için sınır her şeydir. Yalnızca altı hard'a çevir."
          }
        }
      }
    },
    "입력창 위에 soft를 남겨 입력 영역의 시작점을 흐린다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving soft above the input field and blurring where the input area starts"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving soft above the input field and blurring where the input area starts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄の上に soft を残し、入力領域の始まりをぼかす"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在输入框上方保留 soft，模糊了输入区域的起点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入框上方保留 soft，模糊了輸入區域的起點"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставление soft над полем ввода и размытие места, где начинается область ввода"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar soft sobre el campo de entrada y desdibujar dónde empieza el área de entrada"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "soft über dem Eingabefeld lassen und verwischen, wo der Eingabebereich beginnt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser soft au-dessus du champ de saisie et brouiller l'endroit où commence la zone de saisie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciare soft sopra il campo di input e sfocare dove inizia l'area di input"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar soft acima do campo de entrada e borrar onde começa a área de entrada"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปล่อย soft ไว้เหนือช่องกรอกและทำให้จุดเริ่มของพื้นที่กรอกพร่ามัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để soft phía trên ô nhập liệu và làm nhòe chỗ vùng nhập bắt đầu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechání soft nad vstupním polem a rozmazání místa, kde oblast vstupu začíná"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lade soft stå over inputfeltet og sløre, hvor inputområdet begynder"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήνοντας soft πάνω από το πεδίο εισαγωγής και θολώνοντας πού αρχίζει η περιοχή εισαγωγής"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Softin jättäminen syöttökentän yläpuolelle ja syöttöalueen alkukohdan sumentaminen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membiarkan soft di atas kolom input dan mengaburkan di mana area input dimulai"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å la soft stå over inndatafeltet og gjøre det uskarpt hvor inndataområdet begynner"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacht laten boven het invoerveld en vervagen waar het invoergebied begint"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostawienie soft nad polem wprowadzania i zatarcie miejsca, gdzie zaczyna się obszar wprowadzania"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att lämna soft ovanför inmatningsfältet och sudda ut var inmatningsområdet börjar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdi alanının üstünde soft bırakıp girdi alanının nerede başladığını bulanıklaştırmak"
          }
        }
      }
    },
    "입력창(hard로 경계 명확) + 시스템 툴바 버튼 공존": {
