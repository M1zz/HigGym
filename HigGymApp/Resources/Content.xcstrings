          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi in eccesso si ripiegano automaticamente nel **menu ⋯**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
