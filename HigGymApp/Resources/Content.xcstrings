        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過密は誤タップを生む。下部に下ろすものは1〜2個に決める。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过于拥挤会造成误点。决定往底部放的，只留一两个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過於擁擠會造成誤點。決定往底部放的，只留一兩個。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теснота ведёт к ошибочным нажатиям. Ограничьте то, что уходит вниз, одним-двумя элементами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apretar causa toques erróneos. Limita lo que va abajo a una o dos cosas."
          }
        }
      }
    },
