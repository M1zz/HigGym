        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçus d'avis réglés sur une plage de 2...4 lignes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprime di recensioni impostate su un intervallo di 2...4 righe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévias de avaliações definidas num intervalo de 2...4 linhas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอย่างรีวิวที่ตั้งช่วง 2...4 บรรทัด"
          }
        },
        "vi": {
