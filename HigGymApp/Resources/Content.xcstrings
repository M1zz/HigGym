          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กัดกร่อนความไว้วางใจ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bào mòn niềm tin"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oslabuje důvěru"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slider tilliden ned"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φθείρει την εμπιστοσύνη"
          }
        }
      }
    },
    "신호와 동작을 일치시킨다. 만질 수 있으면 어둡게 하지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the signal match the behavior. If it can be touched, don't dim it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the signal match the behaviour. If it can be touched, don't dim it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインと動作を一致させる。触れるなら暗くしない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让信号和动作一致。能操作的话，就不要压暗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓訊號和動作一致。能操作的話，就不要壓暗。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте так, чтобы сигнал совпадал с поведением. Если можно трогать, не затемняйте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz que la señal coincida con el comportamiento. Si se puede tocar, no lo atenúes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Signal zum Verhalten passen. Kann man es berühren, dunkle es nicht ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites correspondre le signal au comportement. Si on peut le toucher, ne l'assombrissez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai combaciare il segnale con il comportamento. Se si può toccare, non oscurarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o sinal combinar com o comportamento. Se pode ser tocado, não escureça."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้สัญญาณตรงกับพฤติกรรม ถ้าแตะได้ อย่าหรี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm cho tín hiệu khớp với hành vi. Nếu chạm được, đừng làm tối."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udělejte signál shodný s chováním. Pokud se na to dá sáhnout, neztmavujte to."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få signalet til at passe til adfærden. Hvis det kan røres, så dæmp det ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε το σήμα να ταιριάζει με τη συμπεριφορά. Αν μπορεί να αγγιχτεί, μην το σκιάζεις."
          }
        }
      }
    },
    "실기기에서 스크롤 방향 전환 시 접힘/펼침 애니메이션을 확인하세요. 스크롤이 짧은 화면에는 부적합합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a real device, check the collapse and expand animations as the scroll direction changes. It's a poor fit for screens with little scrolling."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On a real device, check the collapse and expand animations as the scroll direction changes. It's a poor fit for screens with little scrolling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実機で、スクロールの向きが変わるときの折りたたみ・展開のアニメーションを確認してください。スクロールの短い画面には向きません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在真机上确认滚动方向切换时的折叠/展开动画。不适合滚动很短的界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在真機上確認滾動方向切換時的摺疊/展開動畫。不適合滾動很短的介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте на настоящем устройстве анимации сворачивания и разворачивания при смене направления прокрутки. Плохо подходит для экранов с малой прокруткой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba en un dispositivo real las animaciones de colapso y expansión al cambiar la dirección del desplazamiento. Encaja mal en pantallas con poco desplazamiento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe auf einem echten Gerät die Zusammenklapp- und Erweiterungsanimationen bei wechselnder Scrollrichtung. Für Bildschirme mit wenig Scrollen passt es schlecht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un vrai appareil, vérifiez les animations de repli et de déploiement quand la direction de défilement change. Cela convient mal aux écrans qui défilent peu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un dispositivo reale, controlla le animazioni di compressione ed espansione al cambiare della direzione di scorrimento. È poco adatto alle schermate con poco scorrimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Num dispositivo real, confira as animações de recolher e expandir conforme a direção da rolagem muda. É uma má escolha para telas com pouca rolagem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนอุปกรณ์จริง ตรวจแอนิเมชันยุบและขยายเมื่อทิศทางการเลื่อนเปลี่ยน ไม่เหมาะกับหน้าจอที่เลื่อนน้อย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên thiết bị thật, hãy kiểm tra hoạt ảnh thu và mở khi hướng cuộn đổi. Nó không hợp với màn hình ít cuộn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na skutečném zařízení ověřte animace sbalení a rozbalení při změně směru posouvání. Špatně se hodí pro obrazovky s málem posouvání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek på en rigtig enhed sammenfoldnings- og udvidelsesanimationerne, når scrollretningen skifter. Det passer dårligt til skærme med lidt scrolling."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε πραγματική συσκευή, έλεγξε τις κινήσεις σύμπτυξης και επέκτασης καθώς αλλάζει η κατεύθυνση κύλισης. Ταιριάζει άσχημα σε οθόνες με λίγη κύλιση."
          }
        }
      }
    },
