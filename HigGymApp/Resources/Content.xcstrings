          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременный показ системной панели навигации и пользовательского заголовка"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar a la vez la barra de navegación del sistema y un encabezado personalizado"
          }
        },
        "de": {
          "stringUnit": {
