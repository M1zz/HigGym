          }
        }
      }
    },
    "제목이 잘리는데 아이템 수를 줄이지 않고 글자만 억지로 축소": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title gets clipped, but instead of reducing the number of items, the text is forcibly shrunk"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The title gets clipped, but instead of reducing the number of items, the text is forcibly shrunk"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルが切れているのに、アイテムの数を減らさず文字だけを無理に縮小"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题被截断了，不减少项目数，只硬缩小文字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題被截斷了，不減少項目數，只硬縮小文字"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок обрезается, но вместо сокращения числа элементов текст принудительно сжимают"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título se recorta, pero en lugar de reducir el número de elementos, se encoge el texto a la fuerza"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel wird abgeschnitten, aber statt die Zahl der Elemente zu verringern, wird der Text zwangsweise verkleinert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre est coupé, mais au lieu de réduire le nombre d'éléments, le texte est rétréci de force"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo viene tagliato, ma invece di ridurre il numero di elementi, il testo viene rimpicciolito a forza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título é cortado, mas em vez de reduzir o número de itens, o texto é encolhido à força"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องถูกตัด แต่แทนที่จะลดจำนวนรายการ กลับบังคับย่อข้อความ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề bị cắt, nhưng thay vì giảm số mục, chữ bị ép co lại"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadpis se ořezává, ale místo snížení počtu položek se text násilně zmenší"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlen bliver klippet, men i stedet for at reducere antallet af elementer bliver teksten tvangsskrumpet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο τίτλος κόβεται, αλλά αντί να μειώσεις τα στοιχεία, το κείμενο σμικρύνεται με το ζόρι"
          }
        }
      }
    },
    "제목이 잘리면 이름이 잘못된 것이다. 화면 이름은 만들 때 한 번, 가장 좁은 기기에서 한 번 더 읽어 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a title gets truncated, the name is wrong. Read each screen name once when you create it, and once more on the narrowest device."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If a title gets truncated, the name is wrong. Read each screen name once when you create it, and once more on the narrowest device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルが切れるなら、名前が間違っている。画面の名前は、作るときに一度、いちばん狭いデバイスでもう一度読んでみる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题被截断，就是名字有问题。界面的名字，在做的时候读一遍，再在最窄的设备上读一遍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題被截斷，就是名字有問題。介面的名字，在做的時候讀一遍，再在最窄的裝置上讀一遍。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если заголовок усекается, название неверно. Прочитайте название каждого экрана при создании один раз и ещё раз на самом узком устройстве."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un título se trunca, el nombre está mal. Lee el nombre de cada pantalla una vez al crearla y otra vez en el dispositivo más estrecho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird ein Titel abgeschnitten, ist der Name falsch. Lies jeden Bildschirmnamen einmal beim Erstellen und noch einmal auf dem schmalsten Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un titre est tronqué, c'est que le nom est mauvais. Lisez chaque nom d'écran une fois en le créant, et une fois de plus sur l'appareil le plus étroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un titolo viene troncato, il nome è sbagliato. Leggi il nome di ogni schermata una volta quando lo crei e un'altra sul dispositivo più stretto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um título é truncado, o nome está errado. Leia o nome de cada tela uma vez quando a criar e outra vez no dispositivo mais estreito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าชื่อเรื่องถูกตัด ชื่อก็ผิด อ่านชื่อหน้าจอแต่ละอันหนึ่งครั้งเมื่อสร้าง และอีกครั้งบนอุปกรณ์ที่แคบที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu tiêu đề bị cắt thì tên sai. Hãy đọc mỗi tên màn hình một lần khi tạo, và một lần nữa trên thiết bị hẹp nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se nadpis ořezává, název je špatný. Přečtěte si každý název obrazovky jednou při vytváření a ještě jednou na nejužším zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis en titel bliver afkortet, er navnet forkert. Læs hvert skærmnavn én gang, når du opretter det, og en gang til på den smalleste enhed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν ένας τίτλος περικόπτεται, το όνομα είναι λάθος. Διάβασε το όνομα κάθε οθόνης μία φορά όταν το δημιουργείς, και ξανά στην πιο στενή συσκευή."
          }
        }
      }
    },
