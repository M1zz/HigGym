        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tail varsayılandır ve çoğu cümle için iyi çalışır."
          }
        }
      }
    },
    "textSelection(.enabled), 읽기 전용 텍스트를 **길게 눌러 선택·복사**할 수 있게 허용.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled) lets people **press and hold to select and copy** read-only text."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled) lets people **press and hold to select and copy** read-only text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled)。読み取り専用のテキストを**長押しして選択・コピー**できるようにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
