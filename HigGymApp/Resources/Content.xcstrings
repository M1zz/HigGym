            "state": "translated",
            "value": "De aanwijzing verbergen dat een sheet kan uitvouwen (de grabber)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrycie wskazówki, że arkusz można rozwinąć (uchwyt)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att dölja ledtråden att ett ark kan expandera (greppet)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sayfanın genişleyebileceğini gösteren ipucunu (tutamacı) gizlemek"
          }
        }
      }
