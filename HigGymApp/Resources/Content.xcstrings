          }
        }
      }
    },
    "시각적 대응물이 없는 텍스트 행에서 전체화면 zoom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen zoom from a text row with no visual counterpart"
          }
        },
        "en-GB": {
