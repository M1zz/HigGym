        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft en pantallas donde importan las secciones, como tablas y cuadrículas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft auf Bildschirmen, auf denen Abschnitte zählen, wie Tabellen und Raster"
