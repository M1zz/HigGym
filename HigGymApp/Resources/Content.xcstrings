      }
    },
    "검색은 중요하니 최상위 자리를 줬는데 채울 내용은 준비하지 못했다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search matters, so you gave it a top-level slot, but you didn't prepare anything to fill it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Search matters, so you gave it a top-level slot, but you didn't prepare anything to fill it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索は重要なのでトップレベルの場所を与えたが、中身は用意できなかった。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "觉得搜索很重要，所以给了最顶层的位置，却没准备好可填的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覺得搜尋很重要，所以給了最頂層的位置，卻沒準備好可填的內容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск важен, поэтому вы дали ему слот верхнего уровня, но ничем его не наполнили."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda importa, así que le diste un sitio de nivel superior, pero no preparaste nada para llenarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche ist wichtig, also hast du ihr einen Platz auf oberster Ebene gegeben, aber nichts vorbereitet, um ihn zu füllen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche compte, donc vous lui avez donné un emplacement de premier niveau, mais vous n'avez rien préparé pour le remplir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca conta, quindi le hai dato uno slot di primo livello, ma non hai preparato nulla per riempirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca importa, então você lhe deu um lugar de nível superior, mas não preparou nada para preenchê-lo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาสำคัญ คุณจึงให้ช่องระดับบนสุด แต่ไม่ได้เตรียมอะไรมาเติม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm quan trọng nên bạn cho nó một ô cấp cao nhất, nhưng không chuẩn bị gì để lấp vào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání je důležité, tak jste mu dali slot nejvyšší úrovně, ale nepřipravili jste nic, čím ho vyplnit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgning er vigtig, så du gav den en plads på øverste niveau, men du forberedte ikke noget til at fylde den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση μετράει, οπότε της έδωσες θέση ανώτερου επιπέδου, αλλά δεν ετοίμασες τίποτα για να τη γεμίσεις."
          }
        }
      }
    },
    "검색은 중요한 기능이니 최상위 자리를 주고 싶다. 탭으로 두면 어디서든 한 번에 닿는다. 검색 결과 화면은 만들었으니, 검색 전 화면은 검색창만 있으면 된다고 여기기 쉽다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search is an important feature, so you want to give it a top-level spot. As a tab, it's one tap away from anywhere. You've built the results screen, so it's easy to think the pre-search screen only needs a search field."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Search is an important feature, so you want to give it a top-level spot. As a tab, it's one tap away from anywhere. You've built the results screen, so it's easy to think the pre-search screen only needs a search field."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索は重要な機能なので、トップレベルの場所を与えたい。タブにすればどこからでも一度で届く。検索結果画面は作ったので、検索前の画面は検索フィールドさえあればいいと考えがちだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索是重要功能，想给它最顶层的位置。放成标签，无论在哪里一点就到。搜索结果界面做好了，搜索前的界面就只要有个搜索框，容易这样想。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋是重要功能，想給它最頂層的位置。放成標籤，無論在哪裡一點就到。搜尋結果介面做好了，搜尋前的介面就只要有個搜尋框，容易這樣想。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск - важная функция, поэтому хочется дать ему место верхнего уровня. Как вкладка, он в одном нажатии от любого места. Экран результатов вы уже сделали, поэтому легко решить, что экрану до поиска нужно только поле поиска."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda es una función importante, así que quieres darle un sitio de nivel superior. Como pestaña, está a un toque desde cualquier lugar. Has construido la pantalla de resultados, así que es fácil pensar que la pantalla previa a la búsqueda solo necesita un campo de búsqueda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche ist eine wichtige Funktion, also willst du ihr einen Platz auf oberster Ebene geben. Als Tab ist sie von überall einen Tipp entfernt. Du hast den Ergebnisbildschirm gebaut, also denkt man leicht, der Bildschirm vor der Suche brauche nur ein Suchfeld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche est une fonction importante, donc vous voulez lui donner un emplacement de premier niveau. Comme onglet, elle est à un toucher de partout. Vous avez construit l'écran de résultats, donc on pense facilement que l'écran d'avant-recherche n'a besoin que d'un champ de recherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca è una funzione importante, quindi vuoi darle un posto di primo livello. Come scheda, è a un tocco da ovunque. Hai costruito la schermata dei risultati, quindi è facile pensare che la schermata pre-ricerca abbia bisogno solo di un campo di ricerca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca é uma funcionalidade importante, então você quer lhe dar um lugar de nível superior. Como aba, fica a um toque de qualquer lugar. Você construiu a tela de resultados, então é fácil achar que a tela pré-busca só precisa de um campo de busca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาเป็นฟีเจอร์สำคัญ คุณจึงอยากให้ตำแหน่งระดับบนสุด ในรูปแท็บ มันห่างแค่แตะเดียวจากทุกที่ คุณสร้างหน้าจอผลลัพธ์แล้ว จึงคิดง่าย ๆ ว่าหน้าจอก่อนค้นหาต้องการแค่ช่องค้นหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm là tính năng quan trọng, nên bạn muốn cho nó vị trí cấp cao nhất. Là một tab, nó cách bất cứ đâu đúng một lần chạm. Bạn đã xây màn hình kết quả, nên dễ nghĩ rằng màn hình trước khi tìm chỉ cần một ô tìm kiếm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání je důležitá funkce, takže mu chcete dát místo nejvyšší úrovně. Jako karta je odkudkoli na jedno klepnutí. Postavili jste obrazovku s výsledky, takže je snadné si myslet, že obrazovka před hledáním potřebuje jen vyhledávací pole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgning er en vigtig funktion, så du vil give den en plads på øverste niveau. Som fane er den ét tryk væk fra hvor som helst. Du har bygget resultatskærmen, så det er let at tro, at skærmen før søgning kun behøver et søgefelt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση είναι σημαντική λειτουργία, οπότε θέλεις να της δώσεις θέση ανώτερου επιπέδου. Ως καρτέλα, απέχει ένα πάτημα από παντού. Έχεις φτιάξει την οθόνη αποτελεσμάτων, οπότε είναι εύκολο να νομίζεις ότι η οθόνη πριν την αναζήτηση χρειάζεται μόνο ένα πεδίο αναζήτησης."
          }
        }
      }
    },
    "검색을 **일반 탭 중 하나**로 배치, 다른 탭과 동급의 섹션.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search placed as **one of the regular tabs**, a section on equal footing with the others."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Search placed as **one of the regular tabs**, a section on equal footing with the others."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索を**通常のタブのひとつ**として配置。ほかのタブと同格のセクション。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把搜索作为**普通标签之一**，是与其他标签同级的分区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把搜尋作為**普通標籤之一**，是與其他標籤同級的分割槽。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск, размещённый как **одна из обычных вкладок**, раздел на равных с остальными."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Búsqueda colocada como **una de las pestañas normales**, una sección en pie de igualdad con las demás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche als **einer der normalen Tabs** platziert, ein gleichrangiger Bereich neben den anderen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche placée comme **un des onglets ordinaires**, une section de même rang que les autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca collocata come **una delle schede normali**, una sezione alla pari delle altre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca colocada como **uma das abas comuns**, uma seção em pé de igualdade com as outras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาวางเป็น**หนึ่งในแท็บปกติ** ส่วนที่มีฐานะเท่ากับอื่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm đặt làm **một trong các tab thông thường**, một mục ngang hàng với các mục khác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání umístěné jako **jedna z běžných karet**, sekce na rovnocenném základě s ostatními."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgning placeret som **en af de almindelige faner**, en sektion på lige fod med de andre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζήτηση τοποθετημένη ως **μία από τις κανονικές καρτέλες**, μια ενότητα ισότιμη με τις άλλες."
          }
        }
      }
    },
    "검색을 **자주 쓰는** 화면의 표준 선택. iOS 26에서 새로 만들 화면이라면 사실상 1순위 후보.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The standard choice for screens where search is **used often**. For a new screen built on iOS 26, it is effectively the first candidate."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The standard choice for screens where search is **used often**. For a new screen built on iOS 26, it is effectively the first candidate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索を**よく使う**画面の標準的な選択。iOS 26で新しく作る画面なら、事実上の第一候補。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是**经常使用**搜索的界面的标准选择。在 iOS 26 上新做的界面，实际上是第一候选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是**經常使用**搜尋的介面的標準選擇。在 iOS 26 上新做的介面，實際上是第一候選。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартный выбор для экранов, где поиск **используют часто**. Для нового экрана на iOS 26 это фактически первый кандидат."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción estándar para pantallas donde la búsqueda **se usa a menudo**. Para una pantalla nueva construida en iOS 26, es en la práctica el primer candidato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardwahl für Bildschirme, auf denen die Suche **häufig genutzt** wird. Für einen neuen, auf iOS 26 gebauten Bildschirm ist es praktisch der erste Kandidat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le choix standard pour les écrans où la recherche est **souvent utilisée**. Pour un nouvel écran construit sur iOS 26, c'est en pratique le premier candidat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scelta standard per le schermate in cui la ricerca è **usata spesso**. Per una nuova schermata costruita su iOS 26, è di fatto la prima candidata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escolha padrão para telas em que a busca é **muito usada**. Para uma nova tela construída no iOS 26, é na prática a primeira candidata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลือกมาตรฐานสำหรับหน้าจอที่การค้นหา**ใช้บ่อย** สำหรับหน้าจอใหม่ที่สร้างบน iOS 26 มันคือผู้สมัครแรกโดยปริยาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn chuẩn cho màn hình mà tìm kiếm **được dùng thường xuyên**. Với màn hình mới xây trên iOS 26, nó thực tế là ứng viên đầu tiên."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardní volba pro obrazovky, kde se hledání **používá často**. Pro novou obrazovku postavenou na iOS 26 je to prakticky první kandidát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardvalget til skærme, hvor søgning **bruges ofte**. Til en ny skærm bygget på iOS 26 er det reelt den første kandidat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τυπική επιλογή για οθόνες όπου η αναζήτηση **χρησιμοποιείται συχνά**. Για μια νέα οθόνη χτισμένη στο iOS 26, είναι ουσιαστικά ο πρώτος υποψήφιος."
          }
        }
      }
    },
    "검색을 강조하고 싶다. 툴바에서 가장 강한 자리는 중앙이다. 제목은 탭바에도 적혀 있으니 없어도 될 것 같다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You want to emphasize search. The strongest spot in the toolbar is the center. The title is already written on the tab bar, so it seems you can do without it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You want to emphasise search. The strongest spot in the toolbar is the centre. The title is already written on the tab bar, so it seems you can do without it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索を強調したい。ツールバーでいちばん強い場所は中央だ。タイトルはタブバーにも書かれているのだから、なくてもよさそうに思える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想强调搜索。工具栏里最强的位置是中间。标题在标签栏里也写着，没有似乎也行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想強調搜尋。工具列裡最強的位置是中間。標題在標籤列裡也寫著，沒有似乎也行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы хотите выделить поиск. Самое сильное место на панели инструментов - центр. Заголовок и так написан на панели вкладок, так что вроде можно обойтись без него."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quieres enfatizar la búsqueda. El sitio más fuerte de la barra de herramientas es el centro. El título ya está escrito en la barra de pestañas, así que parece que puedes prescindir de él."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du willst die Suche hervorheben. Der stärkste Platz in der Symbolleiste ist die Mitte. Der Titel steht schon auf der Tab-Leiste, also scheint es, dass man ohne ihn auskommt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voulez mettre la recherche en valeur. L'emplacement le plus fort de la barre d'outils est le centre. Le titre est déjà écrit sur la barre d'onglets, donc il semble qu'on puisse s'en passer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi enfatizzare la ricerca. Il punto più forte della barra degli strumenti è il centro. Il titolo è già scritto sulla barra delle schede, quindi sembra che se ne possa fare a meno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você quer enfatizar a busca. O lugar mais forte da barra de ferramentas é o centro. O título já está escrito na barra de abas, então parece que dá para dispensá-lo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยากเน้นการค้นหา ตำแหน่งที่แรงที่สุดในแถบเครื่องมือคือกึ่งกลาง ชื่อเรื่องเขียนอยู่บนแถบแท็บแล้ว จึงดูเหมือนไม่ต้องมีก็ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn nhấn mạnh tìm kiếm. Vị trí mạnh nhất trên thanh công cụ là chính giữa. Tiêu đề đã có trên thanh tab, nên có vẻ bỏ đi cũng được."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete zdůraznit hledání. Nejsilnějším místem v panelu nástrojů je střed. Nadpis je už napsán na panelu karet, takže se zdá, že se bez něj obejdete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil fremhæve søgning. Den stærkeste plads i værktøjslinjen er midten. Titlen står allerede på fanelinjen, så det ser ud til, at du kan undvære den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις να τονίσεις την αναζήτηση. Η πιο δυνατή θέση στη γραμμή εργαλείων είναι το κέντρο. Ο τίτλος είναι ήδη γραμμένος στη γραμμή καρτελών, οπότε φαίνεται ότι μπορείς να τον παραλείψεις."
          }
        }
      }
    },
    "검색을 강조하고 싶어 가장 강한 자리에 놓는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You want to emphasize search, so you put it in the strongest spot."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You want to emphasise search, so you put it in the strongest spot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索を強調したくて、いちばん強い場所に置く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想强调搜索，所以放在最强的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想強調搜尋，所以放在最強的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы хотите выделить поиск, поэтому ставите его на самое сильное место."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quieres enfatizar la búsqueda, así que la pones en el sitio más fuerte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du willst die Suche hervorheben und setzt sie deshalb an den stärksten Platz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voulez mettre la recherche en valeur, donc vous la mettez à l'emplacement le plus fort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi enfatizzare la ricerca, quindi la metti nel punto più forte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você quer enfatizar a busca, então a coloca no lugar mais forte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยากเน้นการค้นหา จึงวางไว้ในตำแหน่งที่แรงที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn nhấn mạnh tìm kiếm nên đặt nó vào vị trí mạnh nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete zdůraznit hledání, tak ho dáte na nejsilnější místo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil fremhæve søgning, så du lagde den på den stærkeste plads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις να τονίσεις την αναζήτηση, οπότε τη βάζεις στην πιο δυνατή θέση."
          }
        }
      }
    },
    "검색을 거의 안 쓰는 화면에 검색 필드를 상시 노출": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A search field always on display on a screen where search is barely used"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A search field always on display on a screen where search is barely used"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索をほとんど使わない画面に、検索フィールドを常に表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在几乎不用搜索的界面里常驻显示搜索框"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在幾乎不用搜尋的介面裡常駐顯示搜尋框"
