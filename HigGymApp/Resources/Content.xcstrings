    "타이틀 자리에 검색창+버튼까지 넣은 미니 대시보드(자리 남용)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mini dashboard with a search field and buttons crammed into the title slot (abusing the slot)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A mini dashboard with a search field and buttons crammed into the title slot (abusing the slot)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの位置に検索フィールドとボタンまで入れたミニダッシュボード（位置の乱用）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在标题位置连搜索框 + 按钮都放进去，做成迷你仪表盘（滥用位置）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在標題位置連搜尋框 + 按鈕都放進去，做成迷你儀表盤（濫用位置）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мини-панель показателей с полем поиска и кнопками, втиснутыми в слот заголовка (злоупотребление слотом)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un minipanel con un campo de búsqueda y botones apretados en el sitio del título (abuso del sitio)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Mini-Dashboard mit Suchfeld und Buttons, in den Titelplatz gequetscht (Missbrauch des Platzes)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mini-tableau de bord avec un champ de recherche et des boutons entassés dans l'emplacement du titre (détournement de l'emplacement)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mini dashboard con un campo di ricerca e pulsanti ammassati nello slot del titolo (abuso dello slot)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mini dashboard com campo de busca e botões espremidos no lugar do título (abuso do lugar)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แดชบอร์ดขนาดเล็กที่ยัดช่องค้นหาและปุ่มในช่องชื่อเรื่อง (ใช้ช่องผิด)"
          }
        },
        "vi": {
