        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字被蓋住了，但透明的一邊更好看，所以就保留了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить текст похороненным, потому что прозрачный вариант красивее"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar el texto enterrado porque la versión transparente es más bonita"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text vergraben lassen, weil die transparente Variante hübscher aussieht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser du texte enseveli parce que la version transparente est plus jolie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciare il testo sepolto perché la versione trasparente è più bella"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar o texto enterrado porque a versão transparente é mais bonita"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปล่อยข้อความจมเพราะเวอร์ชันโปร่งใสดูสวยกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để văn bản bị chôn vì bản trong suốt trông đẹp hơn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechat text pohřbený, protože průhledná verze vypadá hezčí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lade tekst være begravet, fordi den gennemsigtige version ser pænere ud"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήνοντας κείμενο θαμμένο επειδή η διαφανής έκδοση φαίνεται πιο όμορφη"
          }
        }
      }
    },
    "글자가 묻히는데도 “투명이 예뻐서” 유지(가독성>미학 역전)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping it transparent \"because it looks nice\" even though the text is buried (legibility > aesthetics, reversed)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping it transparent \"because it looks nice\" even though the text is buried (legibility > aesthetics, reversed)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字が埋もれているのに「透明のほうがきれいだから」と維持（読みやすさ > 美しさの逆転）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
