          "stringUnit": {
            "state": "translated",
            "value": "Hodnota a formát šly do jednoho řetězce, takže kulturní pravidla rozhodla sama aplikace"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værdi og format kom ind i én streng, så appen selv afgjorde de kulturelle regler"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τιμή και η μορφή μπήκαν σε μία συμβολοσειρά, οπότε η εφαρμογή αποφάσισε μόνη της τους πολιτισμικούς κανόνες"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvo ja muoto menivät yhteen merkkijonoon, joten sovellus päätti kulttuurisäännöt itse"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nilai dan format masuk ke satu string, sehingga aplikasi memutuskan sendiri aturan budayanya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdi og format havnet i én streng, så appen bestemte de kulturelle reglene selv"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarde en opmaak gingen in één tekenreeks, dus de app besliste zelf de culturele regels"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartość i format trafiły do jednego ciągu, więc aplikacja sama zdecydowała o regułach kulturowych"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Värde och format lades i en sträng, så appen avgjorde de kulturella reglerna själv"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değer ve biçim tek bir stringe girdi, bu yüzden uygulama kültürel kurallara kendisi karar verdi"
          }
        }
      }
    },
    "값은 Measurement로 들고 표기는 로케일에 맡긴다. 마일권 사용자에게 km를 강요하지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the value as a Measurement and leave the formatting to the locale. Don't force kilometers on people who think in miles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the value as a Measurement and leave the formatting to the locale. Don't force kilometres on people who think in miles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はMeasurementで持ち、表記はロケールに任せる。マイル圏のユーザーにkmを押しつけない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值用 Measurement 保存，写法交给区域设置。不强迫使用英里的用户看公里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值用 Measurement 儲存，寫法交給區域設定。不強迫使用英里的使用者看公里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храните значение как Measurement, а запись оставьте региону. Не навязывайте километры тем, кто мыслит милями."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el valor como Measurement y deja el formato a la configuración regional. No impongas kilómetros a quienes piensan en millas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte den Wert als Measurement und überlasse die Formatierung der Region. Zwinge Menschen, die in Meilen denken, keine Kilometer auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez la valeur comme Measurement et laissez le formatage à la région. N'imposez pas les kilomètres à ceux qui pensent en miles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva il valore come Measurement e lascia la formattazione alla regione. Non imporre i chilometri a chi ragiona in miglia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o valor como Measurement e deixe a formatação para a região. Não imponha quilômetros a quem pensa em milhas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บค่าเป็น Measurement และปล่อยการจัดรูปแบบให้ภาษาและภูมิภาค อย่าบังคับกิโลเมตรกับคนที่คิดเป็นไมล์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ giá trị dưới dạng Measurement và để định dạng cho ngôn ngữ và vùng. Đừng ép ki-lô-mét với người nghĩ bằng dặm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte vzdálenost jako Measurement a formátování nechte na lokalitě. Nevnucujte kilometry lidem, kteří myslí v mílích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold værdien som en Measurement, og overlad formateringen til landestandarden. Tving ikke kilometer ned over folk, der tænker i miles."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα την τιμή ως Measurement και άφησε τη μορφοποίηση στη γλώσσα και περιοχή. Μην επιβάλλεις χιλιόμετρα σε ανθρώπους που σκέφτονται σε μίλια."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytä arvo Measurementina ja jätä muotoilu kieliasetukselle. Älä pakota kilometrejä ihmisille, jotka ajattelevat maileissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan jarak sebagai Measurement dan serahkan format kepada locale. Jangan paksakan kilometer pada orang yang berpikir dalam mil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Behold verdien som en Measurement og overlat formateringen til locale. Ikke tving kilometer på folk som tenker i miles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de afstand als een Measurement en laat de opmaak aan de locale over. Dwing geen kilometers op aan mensen die in mijlen denken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj wartość jako Measurement i zostaw formatowanie ustawieniom regionalnym. Nie narzucaj kilometrów ludziom, którzy myślą w milach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåll värdet som en Measurement och överlåt formateringen åt språkområdet. Tvinga inte kilometer på folk som tänker i miles."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değeri bir Measurement olarak tut ve biçimlendirmeyi yerel ayara bırak. Mil düşünen insanlara kilometre dayatma."
          }
        }
      }
    },
    "값은 앱이, 표기는 로케일이": {
      "extractionState": "manual",
      "localizations": {
