          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projetar e conferir a prioridade do que se dobra primeiro num dispositivo estreito"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกแบบและตรวจลำดับความสำคัญของสิ่งที่พับก่อนบนอุปกรณ์แคบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết kế và kiểm tra thứ tự ưu tiên của cái gập trước trên thiết bị hẹp"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navržení a ověření priority toho, co se sbalí první, na úzkém zařízení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At designe og tjekke prioriteten for, hvad der foldes først, på en smal enhed"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιασμός και έλεγχος της προτεραιότητας του τι διπλώνεται πρώτο σε στενή συσκευή"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen prioriteetin suunnittelu ja tarkistus, mikä taittuu ensin kapealla laitteella"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merancang dan memeriksa prioritas apa yang terlipat lebih dulu di perangkat sempit"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å designe og sjekke prioriteten for hva som foldes først på en smal enhet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prioriteit van wat het eerst inklapt ontwerpen en controleren op een smal apparaat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektowanie i sprawdzanie priorytetu tego, co zwija się pierwsze, na wąskim urządzeniu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att designa och kontrollera prioriteten för vad som viks först på en smal enhet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar bir cihazda neyin önce katlanacağının önceliğini tasarlamak ve kontrol etmek"
