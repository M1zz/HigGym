            "state": "translated",
            "value": "**การยัดฟีเจอร์ที่ไม่เกี่ยวข้องกันไว้ในแคปซูลเดียว** (ฝ่าฝืน 1.1.3)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nhét các tính năng không liên quan vào một capsule** (vi phạm 1.1.3)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nacpání nesouvisejících funkcí do jedné kapsle** (porušuje 1.1.3)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**At proppe urelaterede funktioner ind i én kapsel** (bryder 1.1.3)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Στριμώξιμο άσχετων λειτουργιών σε μία κάψουλα** (παραβιάζει το 1.1.3)"
          }
        }
      }
    },
    "**금액·타이머를 기본 .tail로 자르기** (2.1.3 위반)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Truncating amounts and timers with the default .tail** (violates 2.1.3)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Truncating amounts and timers with the default .tail** (violates 2.1.3)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**金額やタイマーをデフォルトの.tailで切る** (2.1.3違反)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**把金额、计时器按默认的 .tail 截断**（违反 2.1.3）"
          }
        },
        "zh-Hant": {
