        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft trên màn hình mà các phần quan trọng, như bảng và lưới"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft na obrazovkách, kde záleží na sekcích, jako tabulky a mřížky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft på skærme, hvor sektioner betyder noget, som tabeller og gitre"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft σε οθόνες όπου μετράνε οι ενότητες, όπως πίνακες και πλέγματα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft näkymissä, joissa osiot ovat tärkeitä, kuten taulukoissa ja ruudukoissa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft pada layar yang bagiannya penting, seperti tabel dan grid"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft på skjermer der seksjoner betyr noe, som tabeller og rutenett"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacht op schermen waar secties tellen, zoals tabellen en rasters"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miękkie na ekranach, na których liczą się sekcje, jak tabele i siatki"
          }
        },
        "sv": {
