            "value": "°C/°F deixados para o ajuste do sistema"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "°C/°F ปล่อยให้การตั้งค่าของระบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "°C/°F để theo cài đặt hệ thống"
          }
        },
        "cs": {
