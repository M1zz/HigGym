            "value": "Pensare che riempire tutti e quattro gli slot completi il design"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Achar que preencher os quatro lugares completa o design"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คิดว่าการเติมทั้งสี่ช่องทำให้การออกแบบสมบูรณ์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghĩ rằng lấp đủ bốn ô thì thiết kế hoàn chỉnh"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Myšlenka, že vyplnění všech čtyř slotů dělá design kompletní"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At tro, at fyldning af alle fire pladser gør designet komplet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σκέψη ότι το γέμισμα και των τεσσάρων θέσεων κάνει τον σχεδιασμό πλήρη"
          }
        }
      }
    },
    "노트 목록": {
