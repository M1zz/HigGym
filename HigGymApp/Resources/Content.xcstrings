          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At proppe en lang formular ind i medium og skabe dobbelt scroll inde i arket"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στρίμωγμα μιας μακριάς φόρμας σε medium, δημιουργώντας διπλή κύλιση μέσα στο φύλλο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitkän lomakkeen ahtaaminen mediumiin, mikä luo kaksinkertaisen vierityksen arkin sisälle"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjejalkan formulir panjang ke medium, menciptakan gulir ganda di dalam lembar"
          }
        },
        "nb": {
          "stringUnit": {
