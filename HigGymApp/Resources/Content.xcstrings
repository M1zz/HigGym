            "value": "膠囊過於擁擠引發誤點"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переполненная капсула, провоцирующая промахи"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cápsula abarrotada que invita a tocar por error"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine überfüllte Kapsel, die zu Fehltippern einlädt"
          }
        },
        "fr": {
          "stringUnit": {
