            "state": "translated",
            "value": "Tanpa geser untuk menutup"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sveip for å lukke"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen veeg om te sluiten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak przesunięcia, by zamknąć"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget svep för att avfärda"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapatmak için kaydırma yok"
          }
        }
      }
    },
    "스와이프가 안 되므로 **완료/취소 버튼이 유일한 출구**, 닫기 수단을 빼먹으면 사용자가 갇힙니다. 반드시 확인하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiping doesn't work, so **the Done/Cancel buttons are the only way out**. Forget a way to close it and people are trapped. Always check this."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiping doesn't work, so **the Done/Cancel buttons are the only way out**. Forget a way to close it and people are trapped. Always check this."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプが効かないので、**完了／キャンセルボタンが唯一の出口**です。閉じる手段を入れ忘れると、ユーザーは閉じ込められます。必ず確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为不能滑动，**完成/取消按钮就是唯一的出口**，漏掉关闭手段，用户就被困住了。请务必确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為不能滑動，**完成/取消按鈕就是唯一的出口**，漏掉關閉手段，使用者就被困住了。請務必確認。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахивание не работает, поэтому **кнопки «Готово/Отмена» - единственный выход**. Забудьте про способ закрытия, и люди окажутся в ловушке. Обязательно проверьте это."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar no funciona, así que **los botones Listo/Cancelar son la única salida**. Olvida una forma de cerrarla y la gente queda atrapada. Compruébalo siempre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischen funktioniert nicht, daher sind **die Buttons Fertig/Abbrechen der einzige Ausgang**. Vergisst man einen Weg zum Schließen, sind Menschen gefangen. Prüfe das immer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le balayage ne fonctionne pas, donc **les boutons OK/Annuler sont la seule issue**. Oubliez un moyen de fermer et les gens sont piégés. Vérifiez toujours cela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scorrimento non funziona, quindi **i pulsanti Fine/Annulla sono l'unica via d'uscita**. Dimentica un modo per chiuderlo e le persone restano intrappolate. Controlla sempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O deslize não funciona, então **os botões Concluir/Cancelar são a única saída**. Esqueça um jeito de fechar e as pessoas ficam presas. Confira sempre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปัดไม่ทำงาน ดังนั้น**ปุ่มเสร็จสิ้น/ยกเลิกคือทางออกเดียว** ลืมวิธีปิด คนก็ถูกขัง ตรวจเสมอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt không dùng được, nên **nút Xong/Hủy là lối thoát duy nhất**. Quên cách đóng là người ta bị kẹt. Luôn kiểm tra điều này."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetí nefunguje, takže **tlačítka Hotovo/Zrušit jsou jediná cesta ven**. Zapomeňte způsob zavření a lidé jsou uvězněni. Vždy to zkontrolujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryg virker ikke, så **knapperne Færdig/Annuller er den eneste vej ud**. Glem en måde at lukke den på, og folk er fanget. Tjek altid dette."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σύρσιμο δεν λειτουργεί, οπότε **τα κουμπιά Τέλος/Ακύρωση είναι η μόνη διέξοδος**. Ξέχασε έναν τρόπο να το κλείσεις και οι άνθρωποι είναι παγιδευμένοι. Έλεγχε το πάντα αυτό."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyhkäisy ei toimi, joten **Valmis/Peruuta-painikkeet ovat ainoa tie ulos**. Unohda tapa sulkea se, ja ihmiset jäävät ansaan. Tarkista tämä aina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Geser tidak bekerja, jadi **tombol Selesai/Batal adalah satu-satunya jalan keluar**. Lupa menyediakan cara menutup dan orang terjebak. Selalu periksa ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip fungerer ikke, så **Ferdig/Avbryt-knappene er den eneste veien ut**. Glem en måte å lukke det på, og folk er fanget. Sjekk alltid dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegen werkt niet, dus **de knoppen Klaar/Annuleer zijn de enige uitweg**. Vergeet een manier om te sluiten en mensen zitten klem. Controleer dit altijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesunięcie nie działa, więc **przyciski Gotowe/Anuluj są jedynym wyjściem**. Zapomnij o sposobie zamknięcia, a ludzie są uwięzieni. Zawsze to sprawdzaj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svepet fungerar inte, så **knapparna Klar/Avbryt är den enda vägen ut**. Glöm ett sätt att stänga det och folk är fångade. Kontrollera alltid detta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırma çalışmıyor, bu yüzden **Bitti/İptal düğmeleri tek çıkış yoludur**. Kapatmanın bir yolunu unutursan insanlar kapana kısılır. Bunu her zaman kontrol et."
          }
        }
      }
    },
    "스와이프도 안 되니 탈출구가 없음": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaves no way out"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaves no way out"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプも効かず、逃げ道がない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
