    "**medium ↔ large** 단계 전환, 그랩바가 “더 있다”는 신호": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stepping between **medium ↔ large**, with the grabber signaling \"there's more\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stepping between **medium ↔ large**, with the grabber signaling \"there's more\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**medium ↔ large**の段階の切り替え。グラバーが「まだ続きがある」というサイン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
