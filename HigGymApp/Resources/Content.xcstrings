          }
        }
      }
    },
    "미디어·콘텐츠 대형 앱에서 하단에 **이동(탭)·검색·전역 상태(액세서리)**를 모두 담아야 할 때.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a large media or content app must fit **navigation (tabs), search and global state (accessory)** all into the bottom."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a large media or content app must fit **navigation (tabs), search and global state (accessory)** all into the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大規模なメディア・コンテンツアプリで、下部に**移動（タブ）・検索・グローバルな状態（アクセサリ**）をすべて収める必要があるとき。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在媒体 · 内容类大型应用里，底部需要同时容纳**导航（标签）· 搜索 · 全局状态（附件）**时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在媒體 · 內容類大型應用程式裡，底部需要同時容納**導覽（標籤）· 搜尋 · 全域性狀態（附件）**時。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда большому медиа- или контентному приложению нужно вместить внизу **навигацию (вкладки), поиск и глобальное состояние (accessory)**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una gran app de medios o de contenido tiene que meter **navegación (pestañas), búsqueda y estado global (accesorio)** todo abajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine große Medien- oder Inhalts-App **Navigation (Tabs), Suche und globalen Zustand (Accessory)** alles unten unterbringen muss."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une grande app de médias ou de contenu doit faire tenir **la navigation (onglets), la recherche et l'état global (accessoire)** tous en bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una grande app multimediale o di contenuti deve far stare in basso **navigazione (schede), ricerca e stato globale (accessorio)**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um grande app de mídia ou de conteúdo precisa fazer caber embaixo **navegação (abas), busca e estado global (acessório)**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อแอปสื่อหรือเนื้อหาขนาดใหญ่ต้องใส่**การนำทาง (แท็บ) การค้นหา และสถานะส่วนกลาง (อุปกรณ์เสริม)** ทั้งหมดไว้ด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một app media hoặc nội dung lớn phải nhét **điều hướng (tab), tìm kiếm và trạng thái toàn cục (phụ kiện)** vào cả phần dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když velká mediální nebo obsahová aplikace musí do spodní části vtěsnat **navigaci (karty), hledání a globální stav (příslušenství)**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en stor medie- eller indholdsapp skal passe **navigation (faner), søgning og global tilstand (tilbehør)** alt sammen ind i bunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν μια μεγάλη εφαρμογή πολυμέσων ή περιεχομένου πρέπει να χωρέσει **πλοήγηση (καρτέλες), αναζήτηση και καθολική κατάσταση (εξάρτημα)** όλα στο κάτω μέρος."
          }
        }
      }
    },
    "미리보기 → 확장 편집의 단계 전환": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stepping from a preview to expanded editing"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stepping from a preview to expanded editing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー→拡張した編集への段階の切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览 → 展开编辑的阶段切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽 → 展開編輯的階段切換"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаговый переход от предпросмотра к развёрнутому редактированию"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasar de una vista previa a la edición expandida"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schritt von einer Vorschau zur erweiterten Bearbeitung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer d'un aperçu à l'édition étendue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passare da un'anteprima alla modifica espansa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passar de uma prévia para a edição expandida"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก้าวจากตัวอย่างไปสู่การแก้ไขแบบขยาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bước từ bản xem trước sang chỉnh sửa mở rộng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přechod od náhledu k rozšířené úpravě"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At gå fra en forhåndsvisning til udvidet redigering"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετάβαση από προεπισκόπηση σε ανεπτυγμένη επεξεργασία"
          }
        }
      }
    },
    "바 높이는 하나씩이 아니라 상하 합계로 본다. 작은 기기에서 남은 콘텐츠 영역을 확인한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Judge bar height by the combined total of top and bottom, not one bar at a time. Check how much content area remains on a small device."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Judge bar height by the combined total of top and bottom, not one bar at a time. Check how much content area remains on a small device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの高さは1本ずつではなく、上下の合計で見る。小さなデバイスで残るコンテンツ領域を確かめる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栏的高度不要一个一个看，而要看上下合计。在小设备上确认剩下的内容区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列的高度不要一個一個看，而要看上下合計。在小裝置上確認剩下的內容區域。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценивайте высоту панелей по суммарному итогу верха и низа, а не по одной панели. Проверьте, сколько области контента остаётся на маленьком устройстве."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juzga la altura de las barras por el total combinado de arriba y abajo, no barra por barra. Comprueba cuánta área de contenido queda en un dispositivo pequeño."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beurteile die Leistenhöhe nach der Gesamtsumme von oben und unten, nicht Leiste für Leiste. Prüfe, wie viel Inhaltsbereich auf einem kleinen Gerät übrig bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jugez la hauteur des barres selon le total cumulé du haut et du bas, pas barre par barre. Vérifiez quelle zone de contenu reste sur un petit appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giudica l'altezza delle barre dal totale combinato di alto e basso, non una barra alla volta. Controlla quanta area di contenuto resta su un dispositivo piccolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Julgue a altura das barras pelo total combinado de topo e parte de baixo, não uma barra de cada vez. Confira quanta área de conteúdo resta num dispositivo pequeno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัดสินความสูงของแถบจากผลรวมของด้านบนและด้านล่าง ไม่ใช่ทีละแถบ ตรวจว่าเหลือพื้นที่เนื้อหาเท่าไรบนอุปกรณ์เล็ก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh giá chiều cao thanh theo tổng của trên và dưới gộp lại, không từng thanh một. Kiểm tra còn lại bao nhiêu vùng nội dung trên thiết bị nhỏ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výšku panelů posuzujte podle celkového součtu nahoře a dole, ne po jednom panelu. Zkontrolujte, kolik plochy obsahu zůstává na malém zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedøm bjælkehøjden efter den samlede sum af top og bund, ikke én bjælke ad gangen. Tjek, hvor meget indholdsområde der er tilbage på en lille enhed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρίνε το ύψος της γραμμής με το συνδυασμένο σύνολο πάνω και κάτω, όχι μία γραμμή τη φορά. Έλεγξε πόση περιοχή περιεχομένου απομένει σε μικρή συσκευή."
          }
        }
      }
    },
    "바 뒤로 **사진·영상·고대비 그래픽**처럼 복잡한 콘텐츠가 지나가는 화면. soft/hard의 반투명으로는 컨트롤 글자가 묻힐 때의 최종 수단.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screens where busy content like **photos, video, or high-contrast graphics** passes behind the bar. The last resort when the translucency of soft or hard buries the control labels."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Screens where busy content like **photos, video, or high-contrast graphics** passes behind the bar. The last resort when the translucency of soft or hard buries the control labels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの後ろを**写真・動画・高コントラストのグラフィック**のような複雑なコンテンツが通る画面。soft/hardの半透明ではコントロールの文字が埋もれてしまうときの最終手段。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**照片、视频、高对比图形**这类复杂内容从栏后经过的界面。soft/hard 的半透明挡不住控件文字被淹没时的最终手段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**照片、影片、高對比圖形**這類複雜內容從列後經過的介面。soft/hard 的半透明擋不住控制元件文字被淹沒時的最終手段。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экраны, где за панелью проходит сложный контент вроде **фото, видео или контрастной графики**. Последнее средство, когда полупрозрачность soft или hard хоронит подписи элементов управления."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantallas donde pasa por detrás de la barra contenido cargado como **fotos, vídeo o gráficos de alto contraste**. El último recurso cuando la translucidez de soft o hard entierra las etiquetas de los controles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirme, auf denen unruhiger Inhalt wie **Fotos, Video oder kontrastreiche Grafiken** hinter der Leiste vorbeizieht. Der letzte Ausweg, wenn die Transparenz von soft oder hard die Beschriftungen der Steuerelemente begräbt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les écrans où un contenu chargé comme **des photos, des vidéos ou des graphiques à fort contraste** passe derrière la barre. Le dernier recours quand la translucidité de soft ou hard enterre les libellés des contrôles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermate in cui contenuti intensi come **foto, video o grafica ad alto contrasto** passano dietro la barra. L'ultima risorsa quando la traslucenza di soft o hard seppellisce le etichette dei controlli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Telas em que conteúdo intenso como **fotos, vídeo ou gráficos de alto contraste** passa atrás da barra. O último recurso quando a translucidez de soft ou hard enterra os rótulos dos controles."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอที่เนื้อหาวุ่นวายอย่าง**รูปถ่าย วิดีโอ หรือกราฟิกคอนทราสต์สูง**ผ่านด้านหลังแถบ ทางสุดท้ายเมื่อความโปร่งแสงของ soft หรือ hard กลบป้ายตัวควบคุม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình mà nội dung rối như **ảnh, video hay đồ họa tương phản cao** đi qua phía sau thanh. Phương sách cuối khi độ trong của soft hay hard chôn mất nhãn điều khiển."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovky, kde za panelem prochází rušný obsah jako **fotky, video nebo grafika s vysokým kontrastem**. Poslední možnost, když průsvitnost soft nebo hard pohřbí popisky ovladačů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærme, hvor travlt indhold som **fotos, video eller grafik med høj kontrast** passerer bag bjælken. Sidste udvej, når softs eller hards gennemsigtighed begraver kontrolmærkaterne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οθόνες όπου φορτωμένο περιεχόμενο όπως **φωτογραφίες, βίντεο ή γραφικά υψηλής αντίθεσης** περνά πίσω από τη γραμμή. Η έσχατη λύση όταν η διαφάνεια του soft ή του hard θάβει τις ετικέτες ελέγχων."
          }
        }
      }
    },
    "바 하나하나는 이유가 있다. 필터는 자주 쓰고, 배너는 상태를 알려야 하고, 결제 버튼은 늘 보여야 한다. 기능이 하나 늘 때마다 가장 눈에 띄는 자리인 바에 한 줄을 더한다. 각각 따로 검토하면 모두 합리적이고, 큰 화면 시안에서는 공간도 넉넉해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bar has a reason. Filters get used often, the banner has to report status, and the checkout button must always be visible. Every time a feature is added, you add another row to the bar, the most noticeable spot. Reviewed one by one, each is reasonable, and in a large-screen mockup there seems to be plenty of room."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bar has a reason. Filters get used often, the banner has to report status, and the checkout button must always be visible. Every time a feature is added, you add another row to the bar, the most noticeable spot. Reviewed one by one, each is reasonable, and in a large-screen mockup there seems to be plenty of room."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのバーにも理由がある。フィルタはよく使うし、バナーは状態を知らせなければならないし、決済ボタンは常に見えていなければならない。機能が1つ増えるたびに、いちばん目立つ場所であるバーに1行足す。1つずつ検討すればどれも妥当で、大きな画面のカンプではスペースも十分に見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个栏都有它的理由。筛选常用，横幅要告知状态，支付按钮要始终可见。每多一个功能，就往最显眼的位置（栏）再加一行。单独审视，每一条都合理，在大屏幕的设计稿上空间也显得很充裕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個列都有它的理由。篩選常用，橫幅要告知狀態，付款按鈕要始終可見。每多一個功能，就往最顯眼的位置（列）再加一行。單獨審視，每一條都合理，在大螢幕的設計稿上空間也顯得很充裕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой панели есть причина. Фильтры используют часто, баннер должен сообщать состояние, а кнопка оплаты должна быть видна всегда. Каждый раз, когда добавляется функция, в панель, самое заметное место, добавляется строка. По отдельности каждая разумна, а на макете для большого экрана места вроде хватает с запасом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada barra tiene su motivo. Los filtros se usan a menudo, el banner tiene que informar del estado, y el botón de pago debe estar siempre visible. Cada vez que se añade una función, se añade otra fila a la barra, el sitio más llamativo. Revisadas una a una, cada una es razonable, y en una maqueta de pantalla grande parece que hay espacio de sobra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Leiste hat einen Grund. Filter werden oft genutzt, das Banner muss den Status melden, und der Bezahlen-Button muss immer sichtbar sein. Bei jeder neuen Funktion fügst du der Leiste, dem auffälligsten Platz, eine weitere Zeile hinzu. Einzeln geprüft ist jede vernünftig, und in einem Mockup auf großem Bildschirm scheint reichlich Platz zu sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque barre a une raison. Les filtres sont souvent utilisés, la bannière doit signaler l'état et le bouton de paiement doit toujours être visible. Chaque fois qu'une fonction est ajoutée, vous ajoutez une rangée à la barre, l'endroit le plus remarquable. Examinée une par une, chacune est raisonnable, et dans une maquette de grand écran il semble y avoir largement de la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni barra ha una ragione. I filtri si usano spesso, il banner deve riportare lo stato e il pulsante di pagamento deve essere sempre visibile. Ogni volta che si aggiunge una funzione, si aggiunge una riga alla barra, il punto più in vista. Esaminata una per una, ognuna è ragionevole, e in un mockup a schermo grande sembra esserci spazio in abbondanza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada barra tem uma razão. Os filtros são muito usados, o banner precisa informar o status e o botão de finalizar a compra precisa estar sempre visível. Toda vez que uma funcionalidade é adicionada, você acrescenta mais uma linha à barra, o ponto mais notável. Revistas uma a uma, cada uma é razoável, e num mockup de tela grande parece haver espaço de sobra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละแถบมีเหตุผล ตัวกรองถูกใช้บ่อย แบนเนอร์ต้องรายงานสถานะ และปุ่มชำระเงินต้องมองเห็นเสมอ ทุกครั้งที่เพิ่มฟีเจอร์ คุณเพิ่มอีกแถวให้แถบ ตำแหน่งที่สะดุดตาที่สุด ตรวจทีละอัน แต่ละอันสมเหตุสมผล และในม็อกอัปหน้าจอใหญ่ดูเหมือนมีที่เหลือเฟือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi thanh đều có lý do. Bộ lọc dùng thường xuyên, banner phải báo trạng thái, và nút thanh toán phải luôn thấy. Mỗi lần thêm tính năng, bạn thêm một hàng vào thanh, chỗ dễ thấy nhất. Xét từng cái, cái nào cũng hợp lý, và trong mockup màn hình lớn có vẻ còn dư chỗ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý panel má důvod. Filtry se používají často, banner musí hlásit stav a tlačítko platby musí být vždy vidět. Pokaždé, když se přidá funkce, přidáte řádek do panelu, na nejnápadnější místo. Posuzováno po jednom je každé rozumné a v mockupu na velké obrazovce se zdá, že místa je dost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver bjælke har en grund. Filtre bruges ofte, banneret skal rapportere status, og betalingsknappen skal altid være synlig. Hver gang der tilføjes en funktion, tilføjer du endnu en række til bjælken, det mest iøjnefaldende sted. Gennemgået én for én er hver rimelig, og i et mockup på en stor skærm ser der ud til at være rigeligt med plads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε γραμμή έχει λόγο. Τα φίλτρα χρησιμοποιούνται συχνά, το banner πρέπει να αναφέρει κατάσταση, και το κουμπί ταμείου πρέπει να είναι πάντα ορατό. Κάθε φορά που προστίθεται μια λειτουργία, προσθέτεις άλλη μία γραμμή στη γραμμή, το πιο ορατό σημείο. Ελεγμένη μία προς μία, κάθε μία είναι λογική, και σε ένα μοντέλο μεγάλης οθόνης φαίνεται ότι υπάρχει άφθονος χώρος."
          }
        }
      }
    },
    "바는 하나씩 평가하면 안 되는 것이었다. 바의 비용은 **합계**로 치른다. 상단 바와 하단 바와 툴바가 겹치면 콘텐츠 영역이 급격히 줄고, 작은 기기에서 그 줄어든 폭이 가장 크게 드러난다. 바들이 자리를 지키는 동안 화면의 주인인 콘텐츠가 밀려났다. 상하 바 합계가 화면의 큰 몫을 차지하기 시작하면 콘텐츠는 압사한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bars were never something to evaluate one at a time. You pay for bars **in total**. When top bars, bottom bars, and toolbars pile up, the content area shrinks fast, and on small devices that shrinkage shows the most. While the bars held their ground, the content, the real owner of the screen, got pushed out. Once the combined top and bottom bars start taking a big share of the screen, the content gets crushed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bars were never something to evaluate one at a time. You pay for bars **in total**. When top bars, bottom bars, and toolbars pile up, the content area shrinks fast, and on small devices that shrinkage shows the most. While the bars held their ground, the content, the real owner of the screen, got pushed out. Once the combined top and bottom bars start taking a big share of the screen, the content gets crushed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーは1本ずつ評価してはいけないものだった。バーのコストは**合計**で支払う。上部のバー、下部のバー、ツールバーが重なると、コンテンツ領域は急激に狭まり、小さなデバイスほどその減り方がはっきり表れる。バーたちが場所を守っているあいだに、画面の主役であるコンテンツが押し出された。上下のバーの合計が画面の大きな割合を占めはじめると、コンテンツは押しつぶされる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "栏是不能一个一个评价的。栏的成本要按**合计**来付。顶栏、底栏和工具栏一叠加，内容区域急剧缩小，在小设备上，缩小的幅度最明显。栏们各守其位的时候，界面的主角（内容）被挤走了。上下栏的合计开始占据界面的大块时，内容就被压垮了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列是不能一個一個評價的。列的成本要按**合計**來付。頂列、底列和工具列一疊加，內容區域急劇縮小，在小裝置上，縮小的幅度最明顯。列們各守其位的時候，介面的主角（內容）被擠走了。上下列的合計開始佔據介面的大塊時，內容就被壓垮了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панели нельзя было оценивать по одной. Панели оплачиваются **в сумме**. Когда накладываются верхние панели, нижние и панели инструментов, область контента быстро сжимается, а на маленьких устройствах это сжатие заметнее всего. Пока панели держали свои места, контент, настоящий хозяин экрана, был вытеснен. Когда суммарные верхние и нижние панели начинают занимать большую долю экрана, контент раздавлен."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras nunca fueron algo que evaluar una a una. Pagas las barras **en total**. Cuando se acumulan barras superiores, inferiores y de herramientas, el área de contenido se encoge rápido, y en dispositivos pequeños esa reducción se nota más. Mientras las barras mantenían su posición, el contenido, el verdadero dueño de la pantalla, fue empujado fuera. Cuando las barras superior e inferior combinadas empiezan a ocupar una gran parte de la pantalla, el contenido queda aplastado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leisten waren nie etwas, das man einzeln bewertet. Du zahlst für Leisten **insgesamt**. Häufen sich obere Leisten, untere Leisten und Symbolleisten, schrumpft der Inhaltsbereich schnell, und auf kleinen Geräten sieht man das Schrumpfen am deutlichsten. Während die Leisten ihre Stellung hielten, wurde der Inhalt, der wahre Besitzer des Bildschirms, hinausgedrängt. Sobald die oberen und unteren Leisten zusammen einen großen Anteil des Bildschirms beanspruchen, wird der Inhalt erdrückt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les barres n'ont jamais été quelque chose à évaluer une par une. Vous payez les barres **au total**. Quand barres du haut, barres du bas et barres d'outils s'accumulent, la zone de contenu rétrécit vite, et sur les petits appareils ce rétrécissement se voit le plus. Pendant que les barres tenaient bon, le contenu, vrai propriétaire de l'écran, a été repoussé. Dès que les barres du haut et du bas réunies prennent une grande part de l'écran, le contenu est écrasé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le barre non andavano mai valutate una alla volta. Le barre le paghi **nel totale**. Quando barre in alto, barre in basso e barre degli strumenti si accumulano, l'area del contenuto si riduce in fretta, e sui dispositivi piccoli quella riduzione si vede di più. Mentre le barre tenevano la posizione, il contenuto, il vero proprietario della schermata, veniva spinto fuori. Una volta che le barre combinate di alto e basso iniziano a prendere una grossa quota dello schermo, il contenuto viene schiacciato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As barras nunca foram algo a avaliar uma de cada vez. Você paga as barras **no total**. Quando barras superiores, barras inferiores e barras de ferramentas se acumulam, a área de conteúdo encolhe depressa, e em dispositivos pequenos esse encolhimento aparece mais. Enquanto as barras seguravam a posição, o conteúdo, o verdadeiro dono da tela, era empurrado para fora. Quando as barras superiores e inferiores combinadas começam a tomar uma grande fatia da tela, o conteúdo é esmagado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบไม่เคยควรถูกประเมินทีละอัน คุณจ่ายสำหรับแถบ**ในภาพรวม** เมื่อแถบด้านบน แถบด้านล่าง และแถบเครื่องมือกองรวมกัน พื้นที่เนื้อหาหดเร็ว และบนอุปกรณ์เล็กการหดนั้นเห็นชัดที่สุด ขณะที่แถบยืนหยัด เนื้อหา เจ้าของหน้าจอตัวจริง ถูกดันออก เมื่อแถบด้านบนและล่างรวมกันเริ่มกินสัดส่วนใหญ่ของหน้าจอ เนื้อหาก็ถูกบี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thanh không bao giờ nên được đánh giá từng cái một. Bạn trả giá cho thanh **theo tổng**. Khi thanh trên, thanh dưới và thanh công cụ chồng chất, vùng nội dung co rất nhanh, và trên thiết bị nhỏ sự co đó lộ rõ nhất. Trong khi các thanh giữ vững vị trí, nội dung, chủ nhân thật của màn hình, bị đẩy ra. Một khi thanh trên và dưới gộp lại chiếm phần lớn màn hình, nội dung bị nghiền nát."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panely nikdy neměly být posuzovány po jednom. Za panely platíte **v součtu**. Když se nahromadí horní panely, dolní panely a panely nástrojů, plocha obsahu rychle klesá a na malých zařízeních je to zmenšení vidět nejvíc. Zatímco panely držely svou pozici, obsah, skutečný vlastník obrazovky, byl vytlačen. Jakmile společné horní a dolní panely začnou zabírat velký podíl obrazovky, obsah se rozdrtí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bjælker var aldrig noget, man skulle vurdere én ad gangen. Du betaler for bjælker **i alt**. Når øverste bjælker, nederste bjælker og værktøjslinjer hobes op, skrumper indholdsområdet hurtigt, og på små enheder viser den skrumpning sig mest. Mens bjælkerne holdt stand, blev indholdet, skærmens rigtige ejer, skubbet ud. Når de samlede øverste og nederste bjælker begynder at tage en stor andel af skærmen, bliver indholdet knust."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι γραμμές δεν ήταν ποτέ κάτι που αξιολογείται μία τη φορά. Πληρώνεις για τις γραμμές **συνολικά**. Όταν οι πάνω γραμμές, οι κάτω γραμμές και οι γραμμές εργαλείων στοιβάζονται, η περιοχή περιεχομένου μικραίνει γρήγορα, και σε μικρές συσκευές αυτή η μείωση φαίνεται περισσότερο. Ενώ οι γραμμές κρατούσαν τη θέση τους, το περιεχόμενο, ο πραγματικός ιδιοκτήτης της οθόνης, σπρώχτηκε έξω. Μόλις οι συνδυασμένες πάνω και κάτω γραμμές αρχίσουν να παίρνουν μεγάλο μερίδιο της οθόνης, το περιεχόμενο συνθλίβεται."
          }
        }
      }
    },
    "바마다 필요한 것을 담다 보니 높이가 계속 자란다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bar gets whatever it needs, and the height keeps growing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Each bar gets whatever it needs, and the height keeps growing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーごとに必要なものを入れていくうちに、高さがどんどん増えていく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个栏都装进自己需要的东西，高度就一直在长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個列都裝進自己需要的東西，高度就一直在長。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая панель получает всё, что ей нужно, и высота продолжает расти."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada barra recibe lo que necesita, y la altura sigue creciendo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Leiste bekommt, was sie braucht, und die Höhe wächst immer weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque barre obtient ce dont elle a besoin, et la hauteur ne cesse de croître."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni barra ottiene ciò di cui ha bisogno, e l'altezza continua a crescere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada barra recebe o que precisa, e a altura continua crescendo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละแถบได้สิ่งที่ต้องการ และความสูงก็โตขึ้นเรื่อย ๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi thanh có được thứ nó cần, và chiều cao cứ lớn dần."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý panel dostane, co potřebuje, a výška stále roste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver bjælke får, hvad den har brug for, og højden bliver ved med at vokse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε γραμμή παίρνει ό,τι χρειάζεται, και το ύψος συνεχίζει να μεγαλώνει."
          }
        }
      }
    },
    "바에 한 줄을 더할 때 그 줄만 보지 않는다. **남는 콘텐츠 영역**을 작은 화면에서 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add a row to a bar, don't look at that row alone. Look at **the content area that's left** on a small screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you add a row to a bar, don't look at that row alone. Look at **the content area that's left** on a small screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーに1行足すときは、その行だけを見ない。小さな画面で**残るコンテンツ領域**を見る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给栏加一行时，不要只看那一行。要在小屏幕上看**剩下的内容区域**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給列加一行時，不要只看那一行。要在小螢幕上看**剩下的內容區域**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляя строку в панель, не смотрите на неё одну. Посмотрите на **область контента, которая остаётся**, на маленьком экране."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando añadas una fila a una barra, no mires esa fila sola. Mira **el área de contenido que queda** en una pantalla pequeña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügst du einer Leiste eine Zeile hinzu, betrachte nicht diese Zeile allein. Betrachte **den Inhaltsbereich, der übrig bleibt**, auf einem kleinen Bildschirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous ajoutez une rangée à une barre, ne regardez pas cette rangée seule. Regardez **la zone de contenu qui reste** sur un petit écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aggiungi una riga a una barra, non guardare quella riga da sola. Guarda **l'area di contenuto che resta** su uno schermo piccolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você acrescenta uma linha a uma barra, não olhe só aquela linha. Olhe **a área de conteúdo que resta** numa tela pequena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณเพิ่มแถวให้แถบ อย่ามองแถวนั้นอย่างเดียว ให้มอง**พื้นที่เนื้อหาที่เหลือ**บนหน้าจอเล็ก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn thêm một hàng vào thanh, đừng chỉ nhìn hàng đó. Hãy nhìn **vùng nội dung còn lại** trên màn hình nhỏ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přidáváte řádek do panelu, nedívejte se na ten řádek samostatně. Podívejte se na **zbývající plochu obsahu** na malé obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du tilføjer en række til en bjælke, så se ikke på den række alene. Se på **det indholdsområde, der er tilbage** på en lille skærm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν προσθέτεις μια γραμμή σε μια γραμμή, μην κοιτάς εκείνη τη γραμμή μόνη της. Κοίτα **την περιοχή περιεχομένου που απομένει** σε μικρή οθόνη."
          }
        }
      }
    },
    "바의 배경을 시스템 material로 바꾼다. 뒤의 사진이 은은하게 비쳐 콘텐츠가 바 밑으로 이어지고, 바는 \"콘텐츠 위에 떠 있는 판\"이라는 깊이 관계를 형태로 말한다. 뒤가 복잡할수록 두꺼운 material을 골라 아이콘이 흔들리지 않게 한다. 밝기 보정은 시스템이 배경에 맞춰 한다. 앱의 5.2.1 Leading, Top Alignment, with Material 예제에서 세로 바 뒤로 콘텐츠가 흐르는 모습을 볼 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the bar's background to a system material. The photo behind shows through softly, so the content continues under the bar, and the bar's form expresses the depth relationship of \"a panel floating above the content.\" The busier the background, the thicker the material you choose, so the icons don't waver. The system adjusts brightness to match the background. In the app's 5.2.1 Leading, Top Alignment, with Material example, you can see content flowing behind a vertical bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the bar's background to a system material. The photo behind shows through softly, so the content continues under the bar, and the bar's form expresses the depth relationship of \"a panel floating above the content.\" The busier the background, the thicker the material you choose, so the icons don't waver. The system adjusts brightness to match the background. In the app's 5.2.1 Leading, Top Alignment, with Material example, you can see content flowing behind a vertical bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの背景をシステムのmaterialに変える。背後の写真がほんのり透けてコンテンツがバーの下へつながり、バーは「コンテンツの上に浮いている板」という奥行きの関係を形で語る。背後が複雑なほど厚いmaterialを選び、アイコンが揺れないようにする。明るさの補正は、システムが背景に合わせて行う。アプリの5.2.1 Leading, Top Alignment, with Materialの例で、縦のバーの背後をコンテンツが流れる様子を見られる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把栏的背景换成系统 material。后面的照片隐约透出，内容延伸到栏下方，栏用形态说出“浮在内容之上的底板”这层纵深关系。背后越复杂，就选越厚的 material，让图标不晃。亮度校正由系统按背景来做。在应用的 5.2.1 Leading, Top Alignment, with Material 示例里，可以看到内容在竖向栏后面流动的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把列的背景換成系統 material。後面的照片隱約透出，內容延伸到列下方，列用形態說出「浮在內容之上的底板」這層縱深關係。背後越複雜，就選越厚的 material，讓圖示不晃。亮度校正由系統按背景來做。在應用程式的 5.2.1 Leading, Top Alignment, with Material 示例裡，可以看到內容在豎向列後面流動的樣子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смените фон панели на системный материал. Фотография позади слабо просвечивает, поэтому контент продолжается под панелью, а форма панели выражает глубину «плиты, парящей над контентом». Чем сложнее фон, тем толще выбирайте материал, чтобы значки не колебались. Яркость система подстраивает под фон. В примере 5.2.1 Leading, Top Alignment, with Material видно, как контент течёт позади вертикальной панели."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el fondo de la barra a un material del sistema. La foto de detrás se transparenta con suavidad, así que el contenido continúa bajo la barra, y la forma de la barra expresa la relación de profundidad de «un panel flotando sobre el contenido». Cuanto más cargado el fondo, más grueso el material que eliges, para que los iconos no vacilen. El sistema ajusta el brillo para igualarlo con el fondo. En el ejemplo 5.2.1 Leading, Top Alignment, with Material de la app puedes ver el contenido fluyendo por detrás de una barra vertical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle den Hintergrund der Leiste auf ein System-Material um. Das Foto dahinter scheint sanft durch, sodass der Inhalt unter der Leiste weiterläuft, und die Form der Leiste drückt die Tiefenbeziehung „ein Panel, das über dem Inhalt schwebt“ aus. Je unruhiger der Hintergrund, desto dicker das Material, damit die Symbole nicht wanken. Das System stellt die Helligkeit passend zum Hintergrund ein. Im Beispiel 5.2.1 Leading, Top Alignment, with Material der App siehst du Inhalt, der hinter einer vertikalen Leiste vorbeifließt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez le fond de la barre à un matériau système. La photo derrière transparaît en douceur, donc le contenu continue sous la barre, et la forme de la barre exprime la relation de profondeur d'« un panneau flottant au-dessus du contenu ». Plus l'arrière-plan est chargé, plus le matériau choisi est épais, pour que les icônes ne vacillent pas. Le système ajuste la luminosité à l'arrière-plan. Dans l'exemple 5.2.1 Leading, Top Alignment, with Material de l'app, vous voyez le contenu défiler derrière une barre verticale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa lo sfondo della barra a un materiale di sistema. La foto dietro traspare dolcemente, quindi il contenuto continua sotto la barra, e la forma della barra esprime la relazione di profondità di «un pannello che fluttua sopra il contenuto». Più lo sfondo è carico, più spesso è il materiale che scegli, così le icone non ondeggiano. Il sistema regola la luminosità per adattarsi allo sfondo. Nell'esempio 5.2.1 Leading, allineamento in alto, con materiale dell'app puoi vedere il contenuto scorrere dietro una barra verticale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque o fundo da barra por um material do sistema. A foto atrás transparece suavemente, então o conteúdo continua sob a barra, e a forma da barra expressa a relação de profundidade de «um painel flutuando sobre o conteúdo». Quanto mais carregado o fundo, mais grosso o material que você escolhe, para os ícones não vacilarem. O sistema ajusta o brilho ao fundo. No exemplo 5.2.1 Leading, alinhamento ao topo, com material do app, você vê o conteúdo fluindo por trás de uma barra vertical."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนพื้นหลังของแถบเป็นวัสดุของระบบ รูปถ่ายด้านหลังมองทะลุอย่างนุ่มนวล เนื้อหาจึงต่อเนื่องใต้แถบ และรูปทรงของแถบแสดงความสัมพันธ์เชิงความลึกของ \"แผงที่ลอยเหนือเนื้อหา\" ยิ่งพื้นหลังวุ่นวาย ก็เลือกวัสดุที่หนาขึ้น ไอคอนจะไม่สั่นไหว ระบบปรับความสว่างให้เข้ากับพื้นหลัง ในตัวอย่าง 5.2.1 Leading, Top Alignment, with Material ของแอป คุณเห็นเนื้อหาไหลอยู่ด้านหลังแถบแนวตั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển nền thanh sang vật liệu hệ thống. Ảnh phía sau lộ ra nhẹ nhàng, nên nội dung tiếp tục dưới thanh, và hình thức của thanh biểu đạt quan hệ chiều sâu của \"một bảng nổi trên nội dung.\" Nền càng rối thì chọn vật liệu càng dày, để biểu tượng không chập chờn. Hệ thống điều chỉnh độ sáng theo nền. Trong ví dụ 5.2.1 Leading, Top Alignment, with Material của app, bạn thấy nội dung chảy phía sau một thanh dọc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepněte pozadí panelu na systémový materiál. Fotka za ním jemně prosvítá, takže obsah pokračuje pod panelem, a forma panelu vyjadřuje vztah hloubky „panel vznášející se nad obsahem“. Čím rušnější pozadí, tím tlustší materiál zvolíte, aby ikony neblikaly. Systém upravuje jas podle pozadí. V příkladu 5.2.1 Leading, Top Alignment, with Material aplikace vidíte obsah plynoucí za svislým panelem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift bjælkens baggrund til et systemmateriale. Fotoet bagved skinner blødt igennem, så indholdet fortsætter under bjælken, og bjælkens form udtrykker dybderelationen »et panel, der svæver over indholdet.« Jo mere urolig baggrunden er, jo tykkere materiale vælger du, så ikonerne ikke vakler. Systemet justerer lysstyrken, så den passer til baggrunden. I appens eksempel 5.2.1 Leading, topjusteret, med materiale kan du se indhold flyde bag en lodret bjælke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε το φόντο της γραμμής σε υλικό συστήματος. Η φωτογραφία πίσω διαφαίνεται απαλά, οπότε το περιεχόμενο συνεχίζει κάτω από τη γραμμή, και η μορφή της γραμμής εκφράζει τη σχέση βάθους «ένα πάνελ που επιπλέει πάνω από το περιεχόμενο». Όσο πιο φορτωμένο το φόντο, τόσο παχύτερο υλικό διαλέγεις, ώστε τα εικονίδια να μην κλονίζονται. Το σύστημα ρυθμίζει τη φωτεινότητα ώστε να ταιριάζει στο φόντο. Στο παράδειγμα 5.2.1 Leading, πάνω στοίχιση, με υλικό της εφαρμογής, μπορείς να δεις περιεχόμενο να ρέει πίσω από μια κάθετη γραμμή."
          }
        }
      }
    },
    "바의 배경을 정할 때 묻는다. \"뒤의 콘텐츠가 이 바를 지나 **이어져 보이는가, 잘려 보이는가**?\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When choosing a bar's background, ask: \"Does the content behind look **continuous through this bar, or cut off**?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When choosing a bar's background, ask: \"Does the content behind look **continuous through this bar, or cut off**?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーの背景を決めるときに問う。「背後のコンテンツは、このバーを通って**つながって見えるか、切れて見えるか**」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定栏的背景时先问：“后面的内容经过这个栏，是**看起来延续，还是看起来被切断**？”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定列的背景時先問：「後面的內容經過這個列，是**看起來延續，還是看起來被切斷**？」"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирая фон панели, спросите: «Выглядит ли контент позади **продолжающимся сквозь эту панель или обрезанным**?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al elegir el fondo de una barra, pregunta: «¿Se ve el contenido de detrás **continuo a través de esta barra, o cortado**?»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage bei der Wahl des Leistenhintergrunds: „Wirkt der Inhalt dahinter **durch diese Leiste hindurch fortlaufend oder abgeschnitten**?“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En choisissant le fond d'une barre, demandez : « Le contenu derrière paraît-il **continu à travers cette barre, ou coupé** ? »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando scegli lo sfondo di una barra, chiediti: «Il contenuto dietro appare **continuo attraverso questa barra, o tagliato**?»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao escolher o fundo de uma barra, pergunte: «O conteúdo atrás parece **contínuo através desta barra, ou cortado**?»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเลือกพื้นหลังของแถบ ให้ถาม: \"เนื้อหาด้านหลังดู**ต่อเนื่องผ่านแถบนี้ หรือถูกตัดขาด**\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi chọn nền cho thanh, hãy hỏi: \"Nội dung phía sau trông **liên tục qua thanh này, hay bị cắt?**\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při volbě pozadí panelu se zeptejte: „Vypadá obsah za ním **souvislý skrz tento panel, nebo odříznutý**?“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du vælger en bjælkes baggrund, så spørg: »Ser indholdet bagved **sammenhængende ud gennem denne bjælke, eller skåret af**?«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν διαλέγεις το φόντο μιας γραμμής, ρώτα: «Φαίνεται το περιεχόμενο πίσω **συνεχές μέσα από αυτή τη γραμμή, ή κομμένο**;»"
          }
        }
      }
    },
    "반높이를 쓴 이유가 소멸": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defeats the purpose of half height"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Defeats the purpose of half height"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分の高さにした理由が消える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用半屏高度的理由消失了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用半螢幕高度的理由消失了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сводит на нет смысл половинной высоты"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anula el sentido de la media altura"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfehlt den Sinn der halben Höhe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Va à l'encontre du but de la mi-hauteur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanifica lo scopo della mezza altezza"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai contra o propósito da meia altura"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำลายจุดประสงค์ของครึ่งความสูง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm hỏng mục đích của nửa chiều cao"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Maří smysl poloviční výšky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Underminerer meningen med halv højde"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακυρώνει τον σκοπό του μισού ύψους"
          }
        }
      }
    },
    "반투명 바는 뒤의 사진이 비쳐 지저분해 보인다. 아이콘이 알록달록한 배경 위에서 흔들리는 것 같다. 단색으로 채우면 판이 또렷하고 아이콘 대비도 한 번에 정할 수 있다. 시안의 기본 배경에서는 단색이 가장 깔끔해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A translucent bar lets the photo behind show through and looks messy. The icons seem to waver over a colorful background. Fill it with a solid color, and the panel looks crisp and you can set the icon contrast once and be done. On the mockup's default background, a solid color looks cleanest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A translucent bar lets the photo behind show through and looks messy. The icons seem to waver over a colourful background. Fill it with a solid colour, and the panel looks crisp and you can set the icon contrast once and be done. On the mockup's default background, a solid colour looks cleanest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明のバーは背後の写真が透けて、ごちゃごちゃして見える。カラフルな背景の上でアイコンが揺れているように感じる。単色で塗れば板がくっきりして、アイコンのコントラストも一度で決められる。カンプのデフォルトの背景では、単色がいちばんすっきり見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明的栏会透出后面的照片，显得杂乱。图标在花花绿绿的背景上好像在晃。填成纯色，底板清晰，图标对比度也能一次定下来。在设计稿的默认背景上，纯色看起来最干净。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明的列會透出後面的照片，顯得雜亂。圖示在花花綠綠的背景上好像在晃。填成純色，底板清晰，圖示對比度也能一次定下來。在設計稿的預設背景上，純色看起來最乾淨。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полупрозрачная панель пропускает фотографию позади и выглядит неопрятно. Значки, кажется, колеблются на пёстром фоне. Залейте сплошным цветом, и панель получится чёткой, а контраст значков можно задать один раз и забыть. На стандартном фоне макета сплошной цвет выглядит чище всего."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra translúcida deja ver la foto de detrás y se ve desordenada. Los iconos parecen vacilar sobre un fondo colorido. Rellénala con un color sólido y el panel se ve nítido y puedes fijar el contraste de los iconos una vez y olvidarte. Sobre el fondo por defecto de la maqueta, un color sólido es lo que queda más limpio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine durchscheinende Leiste lässt das Foto dahinter durchscheinen und wirkt unruhig. Die Symbole scheinen über einem bunten Hintergrund zu wanken. Füllt man sie mit einer Vollfarbe, wirkt das Panel klar, und man stellt den Symbolkontrast einmal ein und ist fertig. Auf dem Standardhintergrund des Mockups sieht eine Vollfarbe am saubersten aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre translucide laisse transparaître la photo derrière et paraît brouillonne. Les icônes semblent vaciller sur un arrière-plan coloré. Remplissez-la d'une couleur unie, et le panneau paraît net et vous réglez le contraste des icônes une fois pour toutes. Sur l'arrière-plan par défaut de la maquette, une couleur unie paraît la plus propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra traslucida lascia trasparire la foto dietro e sembra disordinata. Le icone sembrano ondeggiare su uno sfondo colorato. Riempila con un colore pieno e il pannello sembra nitido e puoi fissare il contrasto delle icone una volta per tutte. Sullo sfondo predefinito del mockup, un colore pieno sembra il più pulito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra translúcida deixa a foto atrás transparecer e fica bagunçada. Os ícones parecem vacilar sobre um fundo colorido. Preencha com uma cor sólida e o painel fica nítido e você define o contraste dos ícones uma vez e pronto. No fundo padrão do mockup, uma cor sólida fica a mais limpa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบโปร่งแสงให้รูปถ่ายด้านหลังมองทะลุและดูรก ไอคอนดูสั่นไหวเหนือพื้นหลังหลากสี เติมด้วยสีทึบ แผงก็ดูคมชัดและคุณตั้งความตัดกันของไอคอนครั้งเดียวจบ บนพื้นหลังเริ่มต้นของม็อกอัป สีทึบดูสะอาดที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh trong suốt để ảnh phía sau lộ ra và trông lộn xộn. Các biểu tượng như chập chờn trên nền nhiều màu. Lấp bằng màu đặc, bảng trông gọn và bạn đặt độ tương phản biểu tượng một lần là xong. Trên nền mặc định của mockup, màu đặc trông sạch nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průsvitný panel nechává prosvítat fotku za ním a vypadá chaoticky. Ikony se na barevném pozadí zdají kolísat. Vyplňte ho jednolitou barvou a panel vypadá ostře a kontrast ikon nastavíte jednou a máte hotovo. Na výchozím pozadí mockupu vypadá jednolitá barva nejčistěji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En gennemsigtig bjælke lader fotoet bagved skinne igennem og ser rodet ud. Ikonerne ser ud til at vakle over en farverig baggrund. Fyld den med en ensfarvet farve, og panelet ser skarpt ud, og du kan sætte ikonkontrasten én gang for alle. På mockuppets standardbaggrund ser en ensfarvet flade renest ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ημιδιαφανής γραμμή αφήνει τη φωτογραφία πίσω να διαφαίνεται και φαίνεται ακατάστατη. Τα εικονίδια φαίνονται να κλονίζονται πάνω από ένα πολύχρωμο φόντο. Γέμισέ την με συμπαγές χρώμα, και το πάνελ φαίνεται καθαρό και μπορείς να ορίσεις την αντίθεση των εικονιδίων μία φορά και τελείωσες. Στο προεπιλεγμένο φόντο του μοντέλου, το συμπαγές χρώμα φαίνεται καθαρότερο."
          }
        }
      }
    },
    "반투명은 뒤가 비쳐 지저분해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translucency lets the background show through and looks messy."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Translucency lets the background show through and looks messy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明は背景が透けて、ごちゃごちゃして見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明会透出后面，显得杂乱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明會透出後面，顯得雜亂。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полупрозрачность пропускает фон и выглядит неопрятно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La translucidez deja ver el fondo y se ve desordenado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparenz lässt den Hintergrund durchscheinen und wirkt unruhig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La translucidité laisse transparaître l'arrière-plan et paraît brouillonne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traslucenza lascia trasparire lo sfondo e sembra disordinata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A translucidez deixa o fundo transparecer e fica bagunçada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความโปร่งแสงให้พื้นหลังมองทะลุและดูรก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong suốt để nền lộ ra và trông lộn xộn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průsvitnost nechává prosvítat pozadí a vypadá chaoticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemsigtighed lader baggrunden skinne igennem og ser rodet ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαφάνεια αφήνει το φόντο να διαφαίνεται και φαίνεται ακατάστατη."
          }
        }
      }
    },
    "반투명을 숫자로 적고 싶어질 때 묻는다. **\"이 값은 어떤 배경 위에서 뽑았나?\"** 배경이 바뀌는 곳이라면 색이 아니라 재질을 쓴다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you feel like writing translucency down as a number, ask: **\"What background did I pick this value from?\"** Where the background changes, use a material, not a color."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you feel like writing translucency down as a number, ask: **\"What background did I pick this value from?\"** Where the background changes, use a material, not a colour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半透明を数値で書きたくなったときに問う。**「この値は、どの背景の上で拾ったのか**」背景が変わる場所なら、色ではなくマテリアルを使う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想把半透明写成数字时先问：**“这个值是在什么背景上取的？”**背景会变的地方，用材质而不是颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想把半透明寫成數字時先問：**「這個值是在什麼背景上取的？」**背景會變的地方，用材質而不是顏色。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда хочется записать полупрозрачность числом, спросите: **«С какого фона я взял это значение?»** Там, где фон меняется, используйте материал, а не цвет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te apetezca escribir una translucidez como un número, pregunta: **«¿De qué fondo saqué este valor?»** Donde el fondo cambia, usa un material, no un color."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du Lust, Transparenz als Zahl aufzuschreiben, frage: **„Von welchem Hintergrund habe ich diesen Wert genommen?“** Wo sich der Hintergrund ändert, nutze ein Material, keine Farbe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous avez envie de noter la translucidité sous forme de nombre, demandez : **« De quel arrière-plan ai-je prélevé cette valeur ? »** Là où l'arrière-plan change, utilisez un matériau, pas une couleur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ti viene voglia di scrivere la traslucenza come numero, chiediti: **«Da quale sfondo ho preso questo valore?»** Dove lo sfondo cambia, usa un materiale, non un colore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sentir vontade de escrever a translucidez como um número, pergunte: **«De que fundo tirei esse valor?»** Onde o fundo muda, use um material, não uma cor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อรู้สึกอยากเขียนความโปร่งแสงเป็นตัวเลข ให้ถาม: **\"ฉันเลือกค่านี้จากพื้นหลังอะไร\"** ที่ที่พื้นหลังเปลี่ยน ให้ใช้วัสดุ ไม่ใช่สี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn muốn ghi độ trong suốt thành một con số, hãy hỏi: **\"Tôi đã chọn giá trị này từ nền nào?\"** Nơi nền thay đổi, hãy dùng vật liệu, không dùng màu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když máte chuť zapsat průsvitnost jako číslo, zeptejte se: **„Z jakého pozadí jsem tuto hodnotu vybral?“** Tam, kde se pozadí mění, použijte materiál, ne barvu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du får lyst til at skrive gennemsigtighed ned som et tal, så spørg: **»Fra hvilken baggrund valgte jeg denne værdi?«** Hvor baggrunden ændres, så brug et materiale, ikke en farve."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν σου έρχεται να γράψεις τη διαφάνεια ως αριθμό, ρώτα: **«Από ποιο φόντο διάλεξα αυτή την τιμή;»** Όπου αλλάζει το φόντο, χρησιμοποίησε υλικό, όχι χρώμα."
          }
        }
      }
    },
    "발견 불가": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody discovers it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody discovers it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つけられない"
          }
        },
        "zh-Hans": {
