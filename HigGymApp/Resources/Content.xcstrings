          "stringUnit": {
            "state": "translated",
            "value": "明明是点按卡片打开的详情，却用 standard"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明明是輕點卡片開啟的詳情，卻用 standard"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование standard для подробностей, открытых нажатием на карточку"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar standard para un detalle que se abre al tocar una tarjeta"
          }
        }
      }
    },
    "카드를 탭해 여는 상세인데 기본 전환을 쓴다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the default transition for a detail view opened by tapping a card"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the default transition for a detail view opened by tapping a card"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードをタップして開く詳細にデフォルトのトランジションを使う"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
