    "핵심 2개(공유·편집)만 노출하고 내보내기·인쇄·버전 기록은 overflow로": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the two essentials (Share, Edit) are shown, with Export, Print, and Version History in overflow"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the two essentials (Share, Edit) are shown, with Export, Print, and Version History in overflow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "核となる2つ（共有・編集）だけを見せ、書き出し・プリント・バージョン履歴はoverflowへ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只露出核心 2 个（分享 · 编辑），导出 · 打印 · 版本记录放进 overflow"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只露出核心 2 個（分享 · 編輯），匯出 · 列印 · 版本記錄放進 overflow"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны только два главных (Поделиться, Править), а «Экспорт», «Печать» и «История версий» уходят в переполнение"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran las dos esenciales (Compartir, Editar), con Exportar, Imprimir e Historial de versiones en el desbordamiento"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die zwei Wesentlichen (Teilen, Bearbeiten) werden gezeigt, mit Exportieren, Drucken und Versionsverlauf im Überlauf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les deux éléments essentiels (Partager, Modifier) sont affichés, avec Exporter, Imprimer et Historique des versions dans le débordement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono mostrati solo i due essenziali (Condividi, Modifica), con Esporta, Stampa e Cronologia delle versioni nell'overflow"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São mostrados só os dois essenciais (Compartilhar, Editar), com Exportar, Imprimir e Histórico de versões no overflow"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเฉพาะสองอย่างที่จำเป็น (แชร์ แก้ไข) โดยส่งออก พิมพ์ และประวัติเวอร์ชันอยู่ในส่วนเกิน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ hiện hai thứ thiết yếu (Chia sẻ, Sửa), còn Xuất, In và Lịch sử phiên bản ở phần tràn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazeny jsou jen dvě nezbytnosti (Sdílet, Upravit), s Exportovat, Tisk a Historie verzí v přetečení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun de to væsentlige (Del, Rediger) vises, med Eksportér, Udskriv og Versionshistorik i overløb"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζονται μόνο τα δύο ουσιώδη (Κοινοποίηση, Επεξεργασία), με Εξαγωγή, Εκτύπωση και Ιστορικό εκδόσεων στην υπερχείλιση"
          }
        }
      }
    },
    "핵심 목적지 하나를 부각": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlights one key destination"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlights one key destination"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中心的な行き先をひとつ際立たせる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "突出一个核心目的地"
          }
        },
        "zh-Hant": {
