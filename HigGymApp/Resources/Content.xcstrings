        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den mest upprepade åtgärden på den skärmen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O ekrandaki en çok tekrarlanan eylem"
          }
        }
      }
    },
    "그때는 왜 그게 맞아 보였나": {
      "extractionState": "manual",
