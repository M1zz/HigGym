            "state": "translated",
            "value": "Một **huy hiệu chữ ngắn** thay cho số (.badge(\"MỚI\")), cho thông báo trạng thái."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Krátký textový odznak** místo čísla (.badge(\"NOVÉ\")), pro stavová oznámení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En **kort tekstbadge** i stedet for et tal (.badge(\"NEW\")), til statusmeddelelser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα **σύντομο σήμα κειμένου** αντί για αριθμό (.badge(\"NEW\")), για ειδοποιήσεις κατάστασης."
          }
        }
      }
    },
