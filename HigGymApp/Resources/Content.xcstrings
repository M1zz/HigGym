          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho các thiết bị có nhiều không gian ngang"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro zařízení s dostatkem vodorovného místa"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til enheder med masser af vandret plads"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για συσκευές με άφθονο οριζόντιο χώρο"
          }
        }
      }
    },
    "가로 폭이 좁으면 세로 바는 콘텐츠를 잠식한다. 좌우 동시 사용은 특히 금물.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the width is narrow, vertical bars eat into the content. Using both sides at once is especially off-limits."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the width is narrow, vertical bars eat into the content. Using both sides at once is especially off-limits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横幅が狭いと、縦のバーはコンテンツを食いつぶす。左右を同時に使うのは特に禁物だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横向宽度窄时，竖向栏会侵蚀内容。尤其不要左右同时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "橫向寬度窄時，豎向列會侵蝕內容。尤其不要左右同時使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ширина узка, вертикальные панели съедают контент. Особенно нельзя использовать обе стороны одновременно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el ancho es estrecho, las barras verticales se comen el contenido. Usar ambos lados a la vez está especialmente prohibido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist die Breite schmal, fressen vertikale Leisten in den Inhalt. Beide Seiten gleichzeitig zu nutzen ist besonders tabu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la largeur est étroite, les barres verticales mordent sur le contenu. Utiliser les deux côtés à la fois est particulièrement proscrit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la larghezza è stretta, le barre verticali mangiano il contenuto. Usare entrambi i lati insieme è particolarmente da evitare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a largura é estreita, as barras verticais comem o conteúdo. Usar os dois lados ao mesmo tempo é especialmente proibido."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อความกว้างแคบ แถบแนวตั้งกินเนื้อหา การใช้ทั้งสองข้างพร้อมกันยิ่งห้ามเด็ดขาด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi độ rộng hẹp, thanh dọc ăn vào nội dung. Dùng cả hai bên cùng lúc đặc biệt không được."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je šířka úzká, svislé panely ukusují z obsahu. Použití obou stran najednou je obzvlášť zakázáno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når bredden er smal, æder lodrette bjælker ind på indholdet. At bruge begge sider på én gang er især forbudt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το πλάτος είναι στενό, οι κάθετες γραμμές τρώνε το περιεχόμενο. Η χρήση και των δύο πλευρών ταυτόχρονα απαγορεύεται ειδικά."
          }
        }
      }
    },
    "가로 화면·iPad에서 **세로 도구 막대**가 필요할 때, 그리기 앱의 도구 팔레트, 세로 탭 스트립, 문서 뷰어의 페이지 도구.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When landscape screens or iPad need a **vertical tool strip**: a drawing app's tool palette, a vertical tab strip, page tools in a document viewer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When landscape screens or iPad need a **vertical tool strip**: a drawing app's tool palette, a vertical tab strip, page tools in a document viewer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横向きの画面やiPadで**縦のツールバー**が必要なとき。お絵かきアプリのツールパレット、縦のタブストリップ、ドキュメントビューアのページツールなど。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在横屏、iPad 上需要**竖向工具栏**时：绘图应用的工具调色板、竖向标签条、文档阅读器的页面工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在橫向螢幕、iPad 上需要**豎向工具列**時：繪圖應用程式的工具調色盤、豎向標籤條、文件閱讀器的頁面工具。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда в альбомной ориентации или на iPad нужна **вертикальная полоса инструментов**: палитра инструментов приложения для рисования, вертикальная лента вкладок, инструменты страниц в просмотре документов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando las pantallas en horizontal o el iPad necesitan una **franja vertical de herramientas**: la paleta de herramientas de una app de dibujo, una franja vertical de pestañas, herramientas de página en un visor de documentos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Querformat oder iPad **eine vertikale Werkzeugleiste** brauchen: die Werkzeugpalette einer Zeichen-App, eine vertikale Tab-Leiste, Seitenwerkzeuge in einem Dokumentbetrachter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand le paysage ou l'iPad ont besoin d'une **bande d'outils verticale** : la palette d'outils d'une app de dessin, une bande d'onglets verticale, les outils de page dans un lecteur de documents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando gli schermi in orizzontale o l'iPad richiedono una **fascia verticale di strumenti**: la tavolozza di un'app di disegno, una fascia verticale di schede, gli strumenti di pagina in un visualizzatore di documenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando telas em paisagem ou o iPad precisam de uma **faixa vertical de ferramentas**: a paleta de ferramentas de um app de desenho, uma faixa vertical de abas, ferramentas de página num visualizador de documentos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อหน้าจอแนวนอนหรือ iPad ต้องการ**แถบเครื่องมือแนวตั้ง**: จานเครื่องมือของแอปวาดภาพ แถบแท็บแนวตั้ง เครื่องมือหน้าในตัวดูเอกสาร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi màn hình ngang hoặc iPad cần một **dải công cụ dọc**: bảng công cụ của app vẽ, dải tab dọc, công cụ trang trong trình xem tài liệu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když obrazovky na šířku nebo iPad potřebují **svislý pruh nástrojů**: paleta nástrojů kreslicí aplikace, svislý pruh karet, nástroje stránky v prohlížeči dokumentů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når landskabsskærme eller iPad har brug for en **lodret værktøjsstribe**: en tegneapps værktøjspalet, en lodret fanestribe, sideværktøjer i en dokumentfremviser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν οι οριζόντιες οθόνες ή το iPad χρειάζονται μια **κάθετη λωρίδα εργαλείων**: η παλέτα εργαλείων μιας εφαρμογής σχεδίασης, μια κάθετη λωρίδα καρτελών, εργαλεία σελίδας σε προβολέα εγγράφων."
          }
        }
      }
    },
    "가사를 스크롤하는 동안에도 재생 컨트롤 유지": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping playback controls while scrolling through lyrics"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping playback controls while scrolling through lyrics"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞をスクロールしている間も再生コントロールを残す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动歌词期间也保持播放控件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動歌詞期間也保持播放控制元件"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять элементы воспроизведения даже при прокрутке текста песни"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener los controles de reproducción mientras se desplaza por la letra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabesteuerung behalten, während man durch Songtexte scrollt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder les commandes de lecture en faisant défiler les paroles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere i controlli di riproduzione mentre scorri i testi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter os controles de reprodução enquanto rola a letra"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คงปุ่มควบคุมการเล่นไว้ขณะเลื่อนดูเนื้อเพลง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ các nút điều khiển phát trong khi cuộn qua lời bài hát"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechání ovládání přehrávání při posouvání textu písně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At beholde afspilningskontroller, mens man scroller gennem sangtekster"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατήρηση των ελέγχων αναπαραγωγής ενώ κυλάς τους στίχους"
          }
        }
      }
    },
    "가장 눈에 띄는 분리 자리라 핵심 액션을 두고 싶다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the most eye-catching standalone spot, so you want your key action there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the most eye-catching standalone spot, so you want your key action there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も目立つ独立した場所なので、中心となるアクションを置きたい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是最显眼的分离位置，所以想放核心操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是最顯眼的分離位置，所以想放核心操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это самое заметное отдельное место, поэтому хочется поставить сюда ключевое действие."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el sitio independiente que más llama la atención, así que quieres tu acción clave ahí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist die auffälligste freistehende Stelle, also willst du dort deine Schlüsselaktion haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'emplacement isolé le plus accrocheur, donc vous voulez y mettre votre action clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il punto autonomo più appariscente, quindi vuoi metterci la tua azione chiave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o ponto avulso mais chamativo, então você quer ali a sua ação-chave."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นตำแหน่งเดี่ยวที่สะดุดตาที่สุด คุณจึงอยากวางการกระทำหลักไว้ตรงนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là vị trí đứng một mình bắt mắt nhất, nên bạn muốn hành động chính của mình ở đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to nejnápadnější samostatné místo, takže tam chcete svou klíčovou akci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er den mest iøjnefaldende enkeltstående plads, så du vil have din hovedhandling der."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι το πιο εντυπωσιακό αυτόνομο σημείο, οπότε θέλεις εκεί την κύρια ενέργειά σου."
          }
        }
      }
    },
    "가장 자주 쓰는 **저장**이 선언 순서 탓에 overflow로 접힘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Save**, the most-used action, folded into overflow because of declaration order"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Save**, the most-used action, folded into overflow because of declaration order"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最もよく使う**保存**が、宣言順のせいでoverflowに折りたたまれている"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最常用的**存储**因声明顺序被折叠进了 overflow"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最常用的**儲存**因宣告順序被摺疊進了 overflow"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Сохранить**, самое частое действие, свёрнуто в переполнение из-за порядка объявления"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Guardar**, la acción más usada, plegada en el desbordamiento por el orden de declaración"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sichern**, die am häufigsten genutzte Aktion, wegen der Deklarationsreihenfolge in den Überlauf gefaltet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Enregistrer**, l'action la plus utilisée, repliée dans le débordement à cause de l'ordre de déclaration"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Salva**, l'azione più usata, ripiegata nell'overflow a causa dell'ordine di dichiarazione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Salvar**, a ação mais usada, dobrado no overflow por causa da ordem de declaração"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**บันทึก** การกระทำที่ใช้มากที่สุด ถูกพับเข้าเมนูส่วนเกินเพราะลำดับการประกาศ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Lưu**, hành động dùng nhiều nhất, bị gập vào mục tràn do thứ tự khai báo"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Uložit**, nejpoužívanější akce, sbaleno do přetečení kvůli pořadí deklarace"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gem**, den mest brugte handling, foldet ind i overløb på grund af deklarationsrækkefølgen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η **Αποθήκευση**, η πιο χρησιμοποιούμενη ενέργεια, διπλωμένη στο υπερχείλισμα λόγω της σειράς δήλωσης"
          }
        }
      }
    },
    "가장 자주 쓰는 액션을 상단 구석에 두고 하단은 비운다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the most frequent action in a top corner and leaving the bottom empty"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the most frequent action in a top corner and leaving the bottom empty"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばんよく使うアクションを上の隅に置き、下部を空けておく"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把最常用的操作放在顶部角落，底部留空"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把最常用的操作放在頂部角落，底部留空"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставить самое частое действие в верхний угол, а низ оставить пустым"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner la acción más frecuente en una esquina superior y dejar vacía la parte inferior"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die häufigste Aktion in eine obere Ecke setzen und die untere leer lassen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre l'action la plus fréquente dans un coin du haut et laisser le bas vide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettere l'azione più frequente in un angolo in alto e lasciare vuoto il basso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pôr a ação mais frequente num canto superior e deixar a parte de baixo vazia"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางการกระทำที่ใช้บ่อยที่สุดไว้มุมบนและปล่อยด้านล่างว่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt hành động thường xuyên nhất ở một góc trên và để trống phía dưới"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dát nejčastější akci do horního rohu a nechat spodek prázdný"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lægge den hyppigste handling i et øverste hjørne og lade bunden stå tom"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθέτηση της πιο συχνής ενέργειας σε πάνω γωνία και άδειο κάτω μέρος"
          }
        }
      }
    },
    "가장 작은 기기에서 한 번 연다. 겹침과 잘림은 거기서만 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it once on the smallest device. Overlap and truncation only show up there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it once on the smallest device. Overlap and truncation only show up there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も小さい端末で一度開く。重なりや切り詰めはそこでしか見えない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最小的设备上打开一次。重叠和截断只有在那里才看得到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最小的裝置上開啟一次。重疊和截斷只有在那裡才看得到。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте один раз на самом маленьком устройстве. Наложения и обрезка проявляются только там."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrelo una vez en el dispositivo más pequeño. Los solapamientos y truncamientos solo aparecen ahí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne es einmal auf dem kleinsten Gerät. Überlappungen und Abschneiden zeigen sich nur dort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez-le une fois sur le plus petit appareil. Les chevauchements et les troncatures n'apparaissent que là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprila una volta sul dispositivo più piccolo. Sovrapposizioni e troncamenti si vedono solo lì."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma vez no menor dispositivo. Sobreposição e truncamento só aparecem lá."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดบนอุปกรณ์เล็กที่สุดสักครั้ง การทับซ้อนและการตัดโผล่ที่นั่นเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở nó một lần trên thiết bị nhỏ nhất. Sự chồng chéo và cắt bớt chỉ lộ ra ở đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete to jednou na nejmenším zařízení. Překryvy a ořezy se ukážou jen tam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn den én gang på den mindste enhed. Overlap og afkortning viser sig kun der."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξέ το μία φορά στη μικρότερη συσκευή. Η επικάλυψη και η περικοπή εμφανίζονται μόνο εκεί."
          }
        }
      }
    },
    "가장 작은 기기와 큰 글씨 설정을 검증 목록에 넣는다. 거기서 잘리는 것을 보고 무엇을 줄이고 무엇을 남길지 정한다. 액세서리는 인라인 크기에서 핵심만 남기고, 시트는 고정 px 대신 `.fraction` 이나 내용 크기에 맞춘 detent 를 쓴다. 필요하면 하단 요소 하나를 포기한다. 앱의 3.5.3 풀 구성 예제를 작은 시뮬레이터에서 열어 보면 무엇이 먼저 밀리는지 바로 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the smallest device and large text settings to your test checklist. Look at what gets truncated there and decide what to shrink and what to keep. Keep only the essentials in the accessory at its inline size, and for sheets, use `.fraction` or a detent sized to the content instead of fixed pixels. If needed, give up one bottom element. Open the app's 3.5.3 full-setup example in a small simulator and you'll see right away what gets pushed out first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the smallest device and large text settings to your test checklist. Look at what gets truncated there and decide what to shrink and what to keep. Keep only the essentials in the accessory at its inline size, and for sheets, use `.fraction` or a detent sized to the content instead of fixed pixels. If needed, give up one bottom element. Open the app's 3.5.3 full-setup example in a small simulator and you'll see right away what gets pushed out first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も小さい端末と大きい文字の設定を検証リストに入れる。そこで切れるものを見て、何を縮め何を残すかを決める。アクセサリはインラインのサイズで核心だけを残し、シートは固定 px の代わりに `.fraction` やコンテンツのサイズに合わせた detent を使う。必要なら下部の要素をひとつあきらめる。アプリの 3.5.3 のフル構成の例を小さいシミュレータで開くと、何が真っ先に押し出されるかがすぐにわかる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把最小的设备和大字号设置放进验证清单。看着在那里被截断的东西，决定缩什么、留什么。附件在内联尺寸下只留核心，弹层不用固定 px，而用 `.fraction` 或随内容大小的 detent。必要时放弃一个底部元素。在小模拟器上打开应用的 3.5.3 完整配置示例，就能直接看到什么先被挤掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把最小的裝置和大字號設定放進驗證清單。看著在那裡被截斷的東西，決定縮什麼、留什麼。附件在內聯尺寸下只留核心，工作表不用固定 px，而用 `.fraction` 或隨內容大小的 detent。必要時放棄一個底部元素。在小模擬器上開啟應用程式的 3.5.3 完整配置示例，就能直接看到什麼先被擠掉。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте самое маленькое устройство и настройки крупного текста в список проверки. Посмотрите, что там обрезается, и решите, что уменьшить, а что оставить. В accessory в inline-размере оставьте только самое необходимое, а для шторок вместо фиксированных пикселей берите `.fraction` или detent по размеру контента. При необходимости откажитесь от одного нижнего элемента. Откройте пример 3.5.3 с полной конфигурацией в маленьком симуляторе, и сразу увидите, что вытесняется первым."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el dispositivo más pequeño y los ajustes de texto grande a tu lista de pruebas. Mira qué se trunca ahí y decide qué reducir y qué conservar. Deja solo lo esencial en el accesorio en su tamaño inline, y para las hojas usa `.fraction` o un detent ajustado al contenido en lugar de píxeles fijos. Si hace falta, renuncia a un elemento inferior. Abre el ejemplo de configuración completa 3.5.3 de la app en un simulador pequeño y verás enseguida qué se expulsa primero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm das kleinste Gerät und große Texteinstellungen in deine Testcheckliste auf. Sieh, was dort abgeschnitten wird, und entscheide, was schrumpft und was bleibt. Behalte im Accessory in seiner Inline-Größe nur das Wesentliche, und nutze bei Sheets `.fraction` oder einen am Inhalt bemessenen Detent statt fester Pixel. Falls nötig, gib ein unteres Element auf. Öffne das vollständige Setup-Beispiel 3.5.3 der App in einem kleinen Simulator, und du siehst sofort, was zuerst herausgedrückt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le plus petit appareil et les grands réglages de texte à votre liste de tests. Regardez ce qui y est tronqué et décidez quoi réduire et quoi garder. Ne gardez que l'essentiel dans l'accessoire à sa taille inline, et pour les feuilles, utilisez `.fraction` ou un detent dimensionné sur le contenu au lieu de pixels fixes. Si nécessaire, renoncez à un élément du bas. Ouvrez l'exemple de configuration complète 3.5.3 de l'app dans un petit simulateur et vous verrez tout de suite ce qui est repoussé en premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il dispositivo più piccolo e le impostazioni di testo grande alla tua lista di test. Guarda cosa viene troncato lì e decidi cosa rimpicciolire e cosa tenere. Nell'accessorio, alla sua dimensione inline, tieni solo l'essenziale e per i fogli usa `.fraction` o un detent dimensionato sul contenuto invece di pixel fissi. Se serve, rinuncia a un elemento in basso. Apri l'esempio 3.5.3 Configurazione completa dell'app in un simulatore piccolo e vedrai subito che cosa viene spinto fuori per primo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acrescente o menor dispositivo e os ajustes de texto grande à sua checklist de testes. Veja o que é truncado ali e decida o que encolher e o que manter. No acessório, no tamanho inline, mantenha só o essencial e, para folhas, use `.fraction` ou um detent dimensionado pelo conteúdo em vez de pixels fixos. Se preciso, abra mão de um elemento inferior. Abra o exemplo 3.5.3 Configuração completa do app num simulador pequeno e você verá na hora o que é empurrado para fora primeiro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มอุปกรณ์เล็กที่สุดและการตั้งค่าตัวอักษรใหญ่ลงในเช็กลิสต์ทดสอบ ดูว่าอะไรถูกตัดที่นั่นและตัดสินว่าจะย่ออะไรและเก็บอะไร เก็บเฉพาะสิ่งจำเป็นไว้ในอุปกรณ์เสริมที่ขนาด inline และสำหรับชีต ใช้ `.fraction` หรือ detent ที่ขนาดตามเนื้อหาแทนพิกเซลตายตัว ถ้าจำเป็น สละองค์ประกอบด้านล่างหนึ่งอย่าง เปิดตัวอย่างการตั้งค่าเต็มรูปแบบ 3.5.3 ของแอปในซิมูเลเตอร์เล็ก แล้วคุณจะเห็นทันทีว่าอะไรถูกดันออกก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thiết bị nhỏ nhất và cài đặt chữ lớn vào danh sách kiểm tra của bạn. Xem cái gì bị cắt ở đó và quyết định thu nhỏ gì, giữ gì. Chỉ giữ những thứ thiết yếu trong phụ kiện ở kích thước inline, và với sheet, dùng `.fraction` hoặc detent theo kích thước nội dung thay vì pixel cố định. Nếu cần, bỏ một phần tử ở dưới. Mở ví dụ cấu hình đầy đủ 3.5.3 của app trong simulator nhỏ và bạn sẽ thấy ngay cái gì bị đẩy ra trước."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte do kontrolního seznamu nejmenší zařízení a nastavení velkého textu. Podívejte se, co se tam ořízne, a rozhodněte, co zmenšit a co ponechat. V příslušenství v inline velikosti nechte jen nezbytné a u sheetů použijte `.fraction` nebo detent přizpůsobený obsahu místo pevných pixelů. V případě potřeby se vzdejte jednoho spodního prvku. Otevřete příklad plného nastavení 3.5.3 v malém simulátoru a hned uvidíte, co se vytlačí první."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj den mindste enhed og store tekstindstillinger til din testtjekliste. Se, hvad der bliver afkortet der, og beslut, hvad der skal skrumpe, og hvad der skal bevares. Behold kun det væsentlige i tilbehøret i dets inline-størrelse, og for ark, brug `.fraction` eller en detent tilpasset indholdet i stedet for faste pixels. Om nødvendigt opgiv ét nederste element. Åbn appens fulde opsætningseksempel 3.5.3 i en lille simulator, og du ser med det samme, hvad der skubbes ud først."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε τη μικρότερη συσκευή και τις ρυθμίσεις μεγάλου κειμένου στη λίστα ελέγχων σου. Δες τι περικόπτεται εκεί και αποφάσισε τι θα σμικρυνθεί και τι θα μείνει. Κράτα μόνο τα απαραίτητα στο εξάρτημα στο inline μέγεθός του, και για φύλλα, χρησιμοποίησε `.fraction` ή ένα detent μεγέθους ανάλογου του περιεχομένου αντί για σταθερά pixels. Αν χρειαστεί, παράτησε ένα κάτω στοιχείο. Άνοιξε το πλήρες παράδειγμα 3.5.3 της εφαρμογής σε μικρό προσομοιωτή και θα δεις αμέσως τι σπρώχνεται έξω πρώτο."
          }
        }
      }
    },
    "가장 잘 보이는 자리이니 가장 중요한 버튼을 두는 게 맞다고 생각한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the most visible spot, so it seems right to put the most important button there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the most visible spot, so it seems right to put the most important button there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばんよく見える場所だから、いちばん大事なボタンを置くのが正しいと考える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是最显眼的位置，所以觉得把最重要的按钮放在这里是对的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是最顯眼的位置，所以覺得把最重要的按鈕放在這裡是對的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это самое видное место, поэтому кажется верным поставить сюда самую важную кнопку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el sitio más visible, así que parece correcto poner ahí el botón más importante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist die sichtbarste Stelle, also scheint es richtig, den wichtigsten Button dorthin zu setzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'emplacement le plus visible, donc il semble juste d'y mettre le bouton le plus important."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il punto più visibile, quindi sembra giusto metterci il pulsante più importante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o ponto mais visível, então parece certo pôr ali o botão mais importante."
