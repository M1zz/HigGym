    "사용자가 화면을 보며 손으로 옮겨 적고 있다면 그건 기능이 빠진 것이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If users are copying something by hand while looking at the screen, a feature is missing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If users are copying something by hand while looking at the screen, a feature is missing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーが画面を見ながら手で書き写しているなら、それは機能が欠けているということだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果用户一边看着界面一边手抄，说明缺了一个功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果使用者一邊看著介面一邊手抄，說明缺了一個功能。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если пользователи что-то переписывают вручную, глядя на экран, значит, не хватает функции."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los usuarios copian algo a mano mirando la pantalla, falta una función."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren Nutzer etwas von Hand ab, während sie auf den Bildschirm schauen, fehlt eine Funktion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les utilisateurs recopient quelque chose à la main en regardant l'écran, il manque une fonction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se gli utenti ricopiano qualcosa a mano guardando lo schermo, manca una funzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os usuários estão copiando algo à mão olhando a tela, falta uma funcionalidade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าผู้ใช้คัดลอกบางอย่างด้วยมือขณะมองหน้าจอ แสดงว่าขาดฟีเจอร์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu người dùng vừa nhìn màn hình vừa chép tay, nghĩa là thiếu một tính năng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud uživatelé něco opisují ručně při pohledu na obrazovku, chybí funkce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis brugerne kopierer noget i hånden, mens de kigger på skærmen, mangler der en funktion."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν οι χρήστες αντιγράφουν κάτι με το χέρι κοιτάζοντας την οθόνη, λείπει μια λειτουργία."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käyttäjät kopioivat jotain käsin näyttöä katsoessaan, ominaisuus puuttuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika pengguna menyalin sesuatu secara manual sambil melihat layar, ada fitur yang hilang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis brukere kopierer noe for hånd mens de ser på skjermen, mangler det en funksjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als gebruikers iets met de hand overschrijven terwijl ze naar het scherm kijken, ontbreekt er een functie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli użytkownicy przepisują coś ręcznie, patrząc na ekran, brakuje funkcji."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om användare kopierar något för hand medan de tittar på skärmen saknas en funktion."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcılar ekrana bakarak bir şeyi elle kopyalıyorsa bir özellik eksiktir."
          }
        }
      }
    },
    "사용자는 조직도를 모른다. 사용자의 목적으로 나눈다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Users don't know your org chart. Divide by what users are trying to do."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Users don't know your org chart. Divide by what users are trying to do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーは組織図を知らない。ユーザーの目的で分ける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户不了解组织架构。按用户的目的来划分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者不了解組織架構。按使用者的目的來劃分。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользователи не знают вашу оргструктуру. Делите по тому, что пользователи пытаются сделать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los usuarios no conocen tu organigrama. Divide por lo que los usuarios intentan hacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzer kennen dein Organigramm nicht. Teile danach auf, was Nutzer erreichen wollen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les utilisateurs ne connaissent pas votre organigramme. Divisez selon ce que les utilisateurs essaient de faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli utenti non conoscono il tuo organigramma. Dividi in base a ciò che gli utenti cercano di fare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os usuários não conhecem o seu organograma. Divida pelo que os usuários estão tentando fazer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใช้ไม่รู้จักผังองค์กรของคุณ แบ่งตามสิ่งที่ผู้ใช้พยายามทำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người dùng không biết sơ đồ tổ chức của bạn. Hãy chia theo điều người dùng đang cố làm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatelé neznají váš organizační diagram. Dělte podle toho, co se uživatelé snaží udělat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brugerne kender ikke dit organisationsdiagram. Del efter det, brugerne prøver at gøre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι χρήστες δεν ξέρουν το οργανόγραμμά σου. Χώρισε με βάση αυτό που προσπαθούν να κάνουν οι χρήστες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjät eivät tunne organisaatiokaavioasi. Jaa sen mukaan, mitä käyttäjät yrittävät tehdä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna tidak tahu bagan organisasimu. Bagilah menurut apa yang ingin dilakukan pengguna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukere kjenner ikke organisasjonskartet ditt. Del etter hva brukerne prøver å gjøre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikers kennen je organisatieschema niet. Verdeel op wat gebruikers proberen te doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użytkownicy nie znają twojego schematu organizacyjnego. Dziel według tego, co użytkownicy próbują zrobić."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användare känner inte till din organisationsschema. Dela upp efter vad användare försöker göra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcılar organizasyon şemanı bilmez. Kullanıcıların yapmaya çalıştığı şeye göre böl."
          }
        }
      }
    },
    "사용자는 조직도를 모른다. 탭바는 **사용자의 목적으로 본 앱의 지도**여야 하는데, 조직도를 옮기면 만드는 쪽의 사정이 지도가 된다. 사용자의 한 가지 목적이 여러 부서에 걸쳐 있으면 탭 여러 개로 쪼개지고, 사용자는 앱의 내부 구조를 배워야만 원하는 걸 찾을 수 있다.\n\n탭 개수도 목적과 상관없이 부서 수를 따라가게 된다. 3~5칸 범위를 넘어가기 쉬운 것도 그래서다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Users don't know your org chart. A tab bar should be **a map of the app seen through the user's goals**, but when you copy the org chart, the builder's internal circumstances become the map. When one user goal spans several departments, it gets split across several tabs, and users can only find what they want after learning the app's internal structure.\n\nThe number of tabs also ends up following the number of departments, regardless of goals. That is also why it so easily goes beyond the 3 to 5 range."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Users don't know your org chart. A tab bar should be **a map of the app seen through the user's goals**, but when you copy the org chart, the builder's internal circumstances become the map. When one user goal spans several departments, it gets split across several tabs, and users can only find what they want after learning the app's internal structure.\n\nThe number of tabs also ends up following the number of departments, regardless of goals. That is also why it so easily goes beyond the 3 to 5 range."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーは組織図を知らない。タブバーは**ユーザーの目的から見たアプリの地図**であるべきなのに、組織図をそのまま写すと、作る側の事情が地図になってしまう。ユーザーのひとつの目的が複数の部署にまたがれば、それは複数のタブに分断され、ユーザーはアプリの内部構造を覚えなければ目当てのものにたどり着けない。\n\nタブの数も、目的とは関係なく部署の数に引きずられる。3〜5個の範囲を超えやすいのもそのためだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户不了解组织架构。标签栏应该是**以用户目的呈现的应用地图**，把组织架构搬过来，做的一方的情况就成了地图。用户的一个目的横跨多个部门，就会被拆成多个标签，用户必须学会应用的内部结构才能找到想要的。\n\n标签数量也会与目的无关，而是跟着部门数量走。容易超出 3 到 5 格的范围，也是这个原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者不了解組織架構。標籤列應該是**以使用者目的呈現的應用程式地圖**，把組織架構搬過來，做的一方的情況就成了地圖。使用者的一個目的橫跨多個部門，就會被拆成多個標籤，使用者必須學會應用程式的內部結構才能找到想要的。\n\n標籤數量也會與目的無關，而是跟著部門數量走。容易超出 3 到 5 格的範圍，也是這個原因。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользователи не знают вашу оргструктуру. Панель вкладок должна быть **картой приложения через цели пользователя**, но когда вы копируете оргструктуру, картой становятся внутренние обстоятельства создателя. Когда одна цель пользователя охватывает несколько отделов, она разбивается на несколько вкладок, и пользователи могут найти нужное, лишь изучив внутреннее устройство приложения.\n\nЧисло вкладок тоже начинает следовать числу отделов, независимо от целей. Поэтому оно так легко выходит за пределы диапазона от 3 до 5."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los usuarios no conocen tu organigrama. Una barra de pestañas debería ser **un mapa de la app visto a través de los objetivos del usuario**, pero cuando copias el organigrama, las circunstancias internas de quien la construye se convierten en el mapa. Cuando un objetivo del usuario abarca varios departamentos, se reparte en varias pestañas, y los usuarios solo pueden encontrar lo que quieren tras aprender la estructura interna de la app.\n\nEl número de pestañas también acaba siguiendo el número de departamentos, sin importar los objetivos. Por eso se sale tan fácilmente del rango de 3 a 5."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzer kennen dein Organigramm nicht. Eine Tab-Leiste sollte **eine Karte der App aus Sicht der Nutzerziele** sein, aber kopiert man das Organigramm, werden die internen Umstände der Entwickler zur Karte. Erstreckt sich ein Nutzerziel über mehrere Abteilungen, wird es auf mehrere Tabs verteilt, und Nutzer finden, was sie wollen, erst, nachdem sie die interne Struktur der App gelernt haben.\n\nAuch die Zahl der Tabs folgt dann unabhängig von den Zielen der Zahl der Abteilungen. Deshalb sprengt sie so leicht den Bereich von 3 bis 5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les utilisateurs ne connaissent pas votre organigramme. Une barre d'onglets devrait être **une carte de l'app vue à travers les objectifs de l'utilisateur**, mais quand vous copiez l'organigramme, les circonstances internes des concepteurs deviennent la carte. Quand un objectif d'utilisateur recoupe plusieurs services, il est réparti sur plusieurs onglets, et les utilisateurs ne trouvent ce qu'ils veulent qu'après avoir appris la structure interne de l'app.\n\nLe nombre d'onglets finit aussi par suivre le nombre de services, indépendamment des objectifs. C'est aussi pourquoi il dépasse si facilement la plage de 3 à 5."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli utenti non conoscono il tuo organigramma. Una barra delle schede dovrebbe essere **una mappa dell'app vista attraverso gli obiettivi dell'utente**, ma quando copi l'organigramma, le circostanze interne di chi costruisce diventano la mappa. Quando un obiettivo dell'utente attraversa più reparti, viene diviso su più schede, e gli utenti possono trovare ciò che vogliono solo dopo aver imparato la struttura interna dell'app.\n\nAnche il numero di schede finisce per seguire il numero di reparti, a prescindere dagli obiettivi. Per questo supera così facilmente l'intervallo da 3 a 5."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os usuários não conhecem o seu organograma. Uma barra de abas deveria ser **um mapa do app visto pelos objetivos do usuário**, mas quando você copia o organograma, as circunstâncias internas de quem constrói viram o mapa. Quando um objetivo do usuário atravessa vários departamentos, ele é dividido em várias abas, e os usuários só acham o que querem depois de aprender a estrutura interna do app.\n\nO número de abas também acaba seguindo o número de departamentos, independentemente dos objetivos. É também por isso que passa com tanta facilidade da faixa de 3 a 5."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใช้ไม่รู้จักผังองค์กรของคุณ แถบแท็บควรเป็น**แผนที่ของแอปที่มองผ่านเป้าหมายของผู้ใช้** แต่เมื่อคุณคัดลอกผังองค์กร สถานการณ์ภายในของผู้สร้างกลายเป็นแผนที่ เมื่อเป้าหมายของผู้ใช้หนึ่งอย่างข้ามหลายแผนก มันถูกแยกไปหลายแท็บ และผู้ใช้หาสิ่งที่ต้องการเจอได้ก็ต่อเมื่อเรียนรู้โครงสร้างภายในของแอปแล้วเท่านั้น\n\nจำนวนแท็บก็ลงเอยตามจำนวนแผนกโดยไม่คำนึงถึงเป้าหมาย นั่นก็เป็นเหตุผลที่มันเกินช่วง 3 ถึง 5 ได้ง่าย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người dùng không biết sơ đồ tổ chức của bạn. Thanh tab nên là **bản đồ của app nhìn qua mục tiêu của người dùng**, nhưng khi bạn chép sơ đồ tổ chức, hoàn cảnh nội bộ của người xây thành bản đồ. Khi một mục tiêu của người dùng trải qua nhiều phòng ban, nó bị chia ra nhiều tab, và người dùng chỉ tìm được thứ mình muốn sau khi học cấu trúc nội bộ của app.\n\nSố tab cũng đi theo số phòng ban, bất kể mục tiêu. Đó cũng là lý do nó dễ vượt phạm vi 3 đến 5."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatelé neznají váš organizační diagram. Panel karet by měl být **mapou aplikace viděnou přes cíle uživatele**, ale když zkopírujete organizační diagram, mapou se stanou vnitřní poměry tvůrce. Když jeden cíl uživatele zasahuje několik oddělení, je rozdělen na několik karet a uživatelé najdou, co chtějí, až poté, co se naučí vnitřní strukturu aplikace.\n\nPočet karet také nakonec sleduje počet oddělení bez ohledu na cíle. Proto také tak snadno přesáhne rozsah 3 až 5."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brugerne kender ikke dit organisationsdiagram. En fanelinje bør være **et kort over appen set gennem brugerens mål**, men når du kopierer organisationsdiagrammet, bliver bygherrens interne forhold til kortet. Når ét brugermål spænder over flere afdelinger, bliver det splittet over flere faner, og brugerne kan først finde det, de vil have, efter at have lært appens interne struktur.\n\nAntallet af faner ender også med at følge antallet af afdelinger, uanset mål. Det er også derfor, det så let overskrider intervallet 3 til 5."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι χρήστες δεν ξέρουν το οργανόγραμμά σου. Μια γραμμή καρτελών πρέπει να είναι **ένας χάρτης της εφαρμογής όπως φαίνεται μέσα από τους στόχους του χρήστη**, αλλά όταν αντιγράφεις το οργανόγραμμα, οι εσωτερικές συνθήκες αυτού που τη φτιάχνει γίνονται ο χάρτης. Όταν ένας στόχος χρήστη εκτείνεται σε πολλά τμήματα, χωρίζεται σε πολλές καρτέλες, και οι χρήστες μπορούν να βρουν ό,τι θέλουν μόνο αφού μάθουν την εσωτερική δομή της εφαρμογής.\n\nΟ αριθμός των καρτελών καταλήγει επίσης να ακολουθεί τον αριθμό των τμημάτων, ανεξαρτήτως στόχων. Γι' αυτό υπερβαίνει τόσο εύκολα το εύρος 3 έως 5."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjät eivät tunne organisaatiokaavioasi. Välilehtipalkin pitäisi olla **kartta sovelluksesta käyttäjän tavoitteiden läpi nähtynä**, mutta kun kopioit organisaatiokaavion, rakentajan sisäiset olosuhteet muuttuvat kartaksi. Kun yksi käyttäjän tavoite ulottuu usean osaston yli, se pilkkoutuu usealle välilehdelle, ja käyttäjät löytävät haluamansa vasta opittuaan sovelluksen sisäisen rakenteen.\n\nVälilehtien määrä päätyy myös seuraamaan osastojen määrää tavoitteista riippumatta. Siksi se ylittää niin helposti 3-5 välin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna tidak tahu bagan organisasimu. Bilah tab seharusnya **peta aplikasi yang dilihat lewat tujuan pengguna**, tetapi saat kamu menyalin bagan organisasi, keadaan internal pembuat menjadi peta. Saat satu tujuan pengguna melintasi beberapa departemen, ia terpecah ke beberapa tab, dan pengguna baru menemukan yang diinginkan setelah mempelajari struktur internal aplikasi.\n\nJumlah tab juga akhirnya mengikuti jumlah departemen, terlepas dari tujuan. Itu pula sebabnya ia begitu mudah melampaui rentang 3 sampai 5."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukere kjenner ikke organisasjonskartet ditt. En fanelinje bør være **et kart over appen sett gjennom brukerens mål**, men når du kopierer organisasjonskartet, blir byggerens interne forhold kartet. Når ett brukermål spenner over flere avdelinger, deles det opp over flere faner, og brukerne kan bare finne det de vil ha etter å ha lært appens interne struktur.\n\nAntall faner ender også opp med å følge antall avdelinger, uavhengig av mål. Det er også derfor det så lett går utover området 3 til 5."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikers kennen je organisatieschema niet. Een tabbalk hoort **een kaart van de app te zijn gezien door de doelen van de gebruiker**, maar als je het organisatieschema kopieert, worden de interne omstandigheden van de bouwer de kaart. Als één gebruikersdoel meerdere afdelingen overspant, wordt het over meerdere tabbladen verdeeld, en gebruikers kunnen pas vinden wat ze willen nadat ze de interne structuur van de app hebben geleerd.\n\nHet aantal tabbladen volgt ook het aantal afdelingen, ongeacht doelen. Daarom gaat het ook zo makkelijk voorbij het bereik van 3 tot 5."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użytkownicy nie znają twojego schematu organizacyjnego. Pasek kart powinien być **mapą aplikacji widzianą przez cele użytkownika**, ale gdy kopiujesz schemat organizacyjny, wewnętrzne okoliczności twórcy stają się mapą. Gdy jeden cel użytkownika obejmuje kilka działów, zostaje rozbity na kilka kart, a użytkownicy mogą znaleźć to, czego chcą, dopiero po poznaniu wewnętrznej struktury aplikacji.\n\nLiczba kart także podąża za liczbą działów, bez względu na cele. Dlatego tak łatwo wykracza poza zakres od 3 do 5."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användare känner inte till ditt organisationsschema. Ett flikfält bör vara **en karta över appen sedd genom användarens mål**, men när du kopierar organisationsschemat blir byggarens interna förhållanden kartan. När ett användarmål sträcker sig över flera avdelningar delas det upp över flera flikar, och användare kan hitta det de vill ha först efter att ha lärt sig appens interna struktur.\n\nAntalet flikar kommer också att följa antalet avdelningar, oavsett mål. Det är också därför det så lätt går utanför intervallet 3 till 5."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcılar organizasyon şemanı bilmez. Sekme çubuğu **kullanıcının hedefleri üzerinden görülen uygulamanın bir haritası** olmalıdır, ama organizasyon şemasını kopyaladığında yapıcının iç koşulları harita olur. Tek bir kullanıcı hedefi birkaç departmana yayıldığında birkaç sekmeye bölünür ve kullanıcılar istediklerini ancak uygulamanın iç yapısını öğrendikten sonra bulabilir.\n\nSekme sayısı da hedeflerden bağımsız olarak departman sayısını izler. 3 ile 5 aralığını bu kadar kolay aşmasının nedeni de budur."
          }
        }
      }
    },
    "사용자를 가두지 않는 것이 친절이라고 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You believe not trapping the user is the kind thing to do."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You believe not trapping the user is the kind thing to do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーを閉じ込めないことが親切だと考える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认为不困住用户就是体贴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "認為不困住使用者就是體貼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы считаете, что не запирать пользователя - это по-доброму."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crees que no atrapar al usuario es lo amable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du glaubst, den Nutzer nicht einzusperren sei das Freundliche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous croyez que ne pas piéger l'utilisateur est la chose bienveillante à faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Credi che non intrappolare l'utente sia la cosa gentile da fare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você acredita que não prender o usuário é a coisa gentil a fazer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเชื่อว่าการไม่ขังผู้ใช้คือความใจดี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn tin rằng không giam người dùng là điều tử tế."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Věříte, že neuvěznit uživatele je laskavé."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tror, at det er venligt ikke at fange brugeren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πιστεύεις ότι το να μην παγιδεύεις τον χρήστη είναι το ευγενικό."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uskot, että käyttäjän ansaan jättämättä jättäminen on ystävällistä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu percaya tidak menjebak pengguna adalah hal yang baik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tror at å ikke fange brukeren er det snille å gjøre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gelooft dat de gebruiker niet klemzetten de vriendelijke keuze is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wierzysz, że niewiązanie użytkownika to życzliwy wybór."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tror att det är snällt att inte fånga användaren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcıyı kapana kıstırmamanın nezaket olduğuna inanırsın."
          }
        }
      }
    },
    "사용자를 가두지 않는 것이 친절이라는 생각이 있다. 결제 중에도 배송지나 쿠폰을 확인하러 갈 수 있어야 할 것 같고, 탭바를 숨기면 출구가 뒤로가기 하나뿐이 되니 갑갑해 보인다. 탭바를 항상 보이게 두는 것이 기본값이라 그대로 두면 된다고 여기기 쉽다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's an idea that not trapping users is a kindness. It feels like people should be able to check their shipping address or coupons even mid-checkout, and hiding the tab bar leaves Back as the only exit, which looks confining. Since keeping the tab bar always visible is the default, it's easy to think you can just leave it as is."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There's an idea that not trapping users is a kindness. It feels like people should be able to check their shipping address or coupons even mid-checkout, and hiding the tab bar leaves Back as the only exit, which looks confining. Since keeping the tab bar always visible is the default, it's easy to think you can just leave it as is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーを閉じ込めないのが親切だという考えがある。決済中でも配送先やクーポンを確認しに行けるべきに思えるし、タブバーを隠すと出口が「戻る」ひとつだけになって窮屈に見える。タブバーを常に表示するのがデフォルトなので、そのままにしておけばいいと思いがちだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一种想法认为不困住用户就是体贴。支付过程中也应该能去查看收货地址或优惠券，隐藏标签栏会让出口只剩返回一个，显得憋闷。始终显示标签栏是默认值，容易觉得放着不动就行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一種想法認為不困住使用者就是體貼。付款過程中也應該能去檢視收貨地址或優惠券，隱藏標籤列會讓出口只剩返回一個，顯得憋悶。始終顯示標籤列是預設值，容易覺得放著不動就行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть мнение, что не запирать пользователей - доброта. Кажется, что люди должны иметь возможность проверить адрес доставки или купоны даже посреди оплаты, а скрытие панели вкладок оставляет «Назад» единственным выходом, что выглядит стесняющим. Поскольку всегда видимая панель вкладок - значение по умолчанию, легко подумать, что можно оставить как есть."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una idea de que no atrapar a los usuarios es una amabilidad. Parece que la gente debería poder comprobar su dirección de envío o sus cupones incluso a mitad del pago, y ocultar la barra de pestañas deja Atrás como única salida, lo que parece constrictivo. Como mantener la barra de pestañas siempre visible es el valor por defecto, es fácil pensar que puedes dejarlo como está."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt die Vorstellung, Nutzer nicht einzusperren sei eine Freundlichkeit. Es fühlt sich an, als müssten Menschen selbst mitten im Bezahlvorgang ihre Lieferadresse oder Gutscheine prüfen können, und das Ausblenden der Tab-Leiste lässt Zurück als einzigen Ausgang, was einengend wirkt. Da die immer sichtbare Tab-Leiste der Standard ist, denkt man leicht, man könne es einfach so lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il existe l'idée que ne pas piéger les utilisateurs est une gentillesse. On a l'impression que les gens devraient pouvoir vérifier leur adresse de livraison ou leurs coupons même en plein paiement, et masquer la barre d'onglets laisse Retour comme unique sortie, ce qui paraît enfermant. Comme garder la barre d'onglets toujours visible est le réglage par défaut, on pense facilement qu'on peut simplement le laisser tel quel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è l'idea che non intrappolare gli utenti sia una gentilezza. Sembra che le persone debbano poter controllare l'indirizzo di spedizione o i coupon anche a metà pagamento, e nascondere la barra delle schede lascia Indietro come unica uscita, il che sembra costrittivo. Poiché tenere la barra delle schede sempre visibile è il predefinito, è facile pensare di poterla lasciare così."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma ideia de que não prender os usuários é uma gentileza. Parece que as pessoas deveriam poder conferir o endereço de entrega ou os cupons mesmo no meio da finalização de compra, e esconder a barra de abas deixa o Voltar como única saída, o que parece confinante. Como manter a barra de abas sempre visível é o padrão, é fácil achar que dá para deixar como está."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแนวคิดว่าการไม่ขังผู้ใช้คือความกรุณา รู้สึกว่าคนควรตรวจที่อยู่จัดส่งหรือคูปองได้แม้กลางการชำระเงิน และการซ่อนแถบแท็บเหลือย้อนกลับเป็นทางออกเดียวดูอึดอัด เพราะการให้แถบแท็บมองเห็นตลอดเป็นค่าเริ่มต้น จึงคิดง่าย ๆ ว่าปล่อยไว้ตามเดิมได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có quan niệm rằng không giam người dùng là sự tử tế. Có cảm giác người ta nên kiểm tra được địa chỉ giao hàng hay mã giảm giá ngay cả giữa lúc thanh toán, và ẩn thanh tab chỉ để Quay lại làm lối thoát duy nhất thì trông bó buộc. Vì thanh tab luôn hiển thị là mặc định, dễ nghĩ cứ để vậy là được."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Existuje představa, že neuvěznit uživatele je laskavost. Zdá se, že by lidé měli mít možnost zkontrolovat doručovací adresu nebo kupóny i uprostřed platby, a skrytí panelu karet nechává Zpět jako jediný východ, což vypadá svazujícím způsobem. Protože ponechání panelu karet vždy viditelného je výchozí, snadno si myslíte, že to můžete nechat být."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er en idé om, at det er en venlighed ikke at fange brugere. Det føles, som om folk bør kunne tjekke deres leveringsadresse eller kuponer selv midt i betalingen, og at skjule fanelinjen efterlader Tilbage som eneste udgang, hvilket ser indskrænkende ud. Da en altid synlig fanelinje er standarden, er det let at tro, at man bare kan lade det være."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει η ιδέα ότι το να μην παγιδεύεις τους χρήστες είναι ευγένεια. Νιώθεις ότι οι άνθρωποι πρέπει να μπορούν να ελέγχουν τη διεύθυνση αποστολής ή τα κουπόνια τους ακόμα και στη μέση του ταμείου, και ότι η απόκρυψη της γραμμής καρτελών αφήνει το Πίσω ως μοναδική έξοδο, κάτι που φαίνεται περιοριστικό. Εφόσον η πάντα ορατή γραμμή καρτελών είναι η προεπιλογή, είναι εύκολο να νομίσεις ότι μπορείς απλώς να την αφήσεις ως έχει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "On ajatus, että käyttäjien ansaan jättämättä jättäminen on ystävällisyyttä. Tuntuu, että ihmisten pitäisi voida tarkistaa toimitusosoitteensa tai kuponkinsa kesken kassankin, ja välilehtipalkin piilottaminen jättää Takaisin-toiminnon ainoaksi ulospääsyksi, mikä näyttää rajoittavalta. Koska välilehtipalkin pitäminen aina näkyvissä on oletus, on helppo ajatella, että voit jättää sen sellaiseksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada anggapan bahwa tidak menjebak pengguna adalah kebaikan. Rasanya orang harus bisa memeriksa alamat pengiriman atau kupon bahkan di tengah checkout, dan menyembunyikan bilah tab menyisakan Kembali sebagai satu-satunya jalan keluar, yang tampak mengurung. Karena bilah tab yang selalu terlihat adalah bawaan, mudah mengira kamu bisa membiarkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes en idé om at å ikke fange brukere er en vennlighet. Det føles som om folk bør kunne sjekke leveringsadressen eller kuponger selv midt i kassen, og å skjule fanelinjen etterlater Tilbake som eneste utgang, noe som ser innestengende ut. Siden det å la fanelinjen være alltid synlig er standarden, er det lett å tro at du bare kan la det stå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een idee dat gebruikers niet klemzetten een vriendelijkheid is. Het voelt alsof mensen hun bezorgadres of coupons zelfs midden in het afrekenen moeten kunnen controleren, en de tabbalk verbergen laat Terug als enige uitgang, wat beperkend oogt. Omdat de tabbalk altijd zichtbaar houden de standaard is, is het makkelijk te denken dat je het gewoon kunt laten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istnieje pogląd, że niewiązanie użytkowników jest życzliwością. Wydaje się, że ludzie powinni móc sprawdzić adres dostawy lub kupony nawet w trakcie płatności, a ukrycie paska kart zostawia Wstecz jako jedyne wyjście, co wygląda na ograniczające. Skoro zawsze widoczny pasek kart to ustawienie domyślne, łatwo pomyśleć, że można po prostu zostawić jak jest."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns en idé att det är en vänlighet att inte fånga användare. Det känns som att folk borde kunna kontrollera sin leveransadress eller sina kuponger även mitt i kassan, och att dölja flikfältet lämnar Tillbaka som enda utgång, vilket ser instängande ut. Eftersom det är standard att flikfältet alltid är synligt är det lätt att tro att du bara kan lämna det som det är."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcıları kapana kıstırmamanın bir nezaket olduğu düşüncesi vardır. İnsanların ödeme sırasında bile teslimat adreslerini ya da kuponlarını kontrol edebilmesi gerektiği hissi verir ve sekme çubuğunu gizlemek Geri'yi tek çıkış yolu bırakır, bu da sıkıştırıcı görünür. Sekme çubuğunu her zaman görünür tutmak varsayılan olduğu için olduğu gibi bırakabileceğini düşünmek kolaydır."
          }
        }
      }
    },
    "사전·주소록처럼 검색이 상시 필요한 화면": {
      "extractionState": "manual",
      "localizations": {
        "en": {
