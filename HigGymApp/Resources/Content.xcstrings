    "**삭제** 같은 파괴적 액션을 가장 누르기 쉬운 하단에 단독 배치": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A destructive action like **Delete** placed alone at the bottom, the easiest spot to tap"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A destructive action like **Delete** placed alone at the bottom, the easiest spot to tap"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**削除**のような破壊的なアクションを、最も押しやすい下部に単独で配置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把**删除**这类破坏性操作单独放在最容易点到的底部"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把**刪除**這類破壞性操作單獨放在最容易點到的底部"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрушительное действие вроде **«Удалить»**, поставленное в одиночку внизу, в самом удобном для нажатия месте"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una acción destructiva como **Eliminar** colocada sola abajo, el sitio más fácil de tocar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine destruktive Aktion wie **Löschen** allein unten platziert, an der am leichtesten antippbaren Stelle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une action destructive comme **Supprimer** placée seule en bas, à l'endroit le plus facile à toucher"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'azione distruttiva come **Elimina** messa da sola in basso, nel punto più facile da toccare"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ação destrutiva como **Excluir** posta sozinha embaixo, o ponto mais fácil de tocar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำที่ทำลายข้อมูลอย่าง**ลบ**วางลำพังที่ด้านล่าง ตำแหน่งที่แตะง่ายที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một hành động phá hủy như **Xóa** đặt một mình ở dưới, chỗ dễ chạm nhất"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Destruktivní akce jako **Smazat** umístěná samostatně dole, na nejsnáze klepnutelném místě"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En destruktiv handling som **Slet** placeret alene i bunden, den nemmeste plads at trykke på"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια καταστροφική ενέργεια όπως η **Διαγραφή** τοποθετημένη μόνη της κάτω, στο πιο εύκολο σημείο για πάτημα"
          }
        }
      }
    },
    "**삭제**를 의도적으로 overflow 안에 둠(오조작 방지)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Delete** deliberately kept inside overflow (prevents accidental taps)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Delete** deliberately kept inside overflow (prevents accidental taps)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**削除**を意図的にoverflowの中に置く（誤操作の防止）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
