        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled on reference text such as terms and addresses"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "規約や住所など、参照用のテキストで有効にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对条款、地址等参考用文本允许"
