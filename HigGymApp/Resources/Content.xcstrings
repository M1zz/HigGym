            "state": "translated",
            "value": "ชื่อเรื่องที่ด้านบนของชีตโมดัล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề ở đầu một sheet modal"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadpis nahoře v modálním sheetu"
          }
        },
        "da": {
          "stringUnit": {
