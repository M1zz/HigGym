          }
        }
      }
    },
    ".height(250) · .fraction(0.3), 시스템 2단이 아닌 **커스텀 높이**의 detent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".height(250) · .fraction(0.3): a detent at a **custom height** instead of the two system steps."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": ".height(250) · .fraction(0.3): a detent at a **custom height** instead of the two system steps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".height(250) · .fraction(0.3)。システムの2段階ではない**カスタムの高さ**のデタント。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ".height(250) · .fraction(0.3)，不是系统两档，而是**自定义高度**的 detent。"
          }
        },
        "zh-Hant": {
