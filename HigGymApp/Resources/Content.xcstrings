            "value": "Bỏ tiêu đề khỏi màn hình danh sách thông thường và giao giữa cho tìm kiếm"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranění nadpisu z běžné obrazovky se seznamem a přenechání středu hledání"
          }
        },
        "da": {
          "stringUnit": {
