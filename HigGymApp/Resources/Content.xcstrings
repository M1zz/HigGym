          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikovat to na celou obrazovku najednou je pohodlné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At anvende det på hele skærmen på én gang er bekvemt."
