    "검색 필드와 액션 버튼을 **같은 캡슐**에 묶음(입력과 액션 혼합)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search field and an action button bound into **the same capsule** (mixing input and action)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The search field and an action button bound into **the same capsule** (mixing input and action)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索フィールドとアクションボタンを**同じカプセル**にまとめている（入力とアクションの混在）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把搜索框和操作按钮放进**同一个胶囊**（输入与操作混合）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把搜尋框和操作按鈕放進**同一個膠囊**（輸入與操作混合）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле поиска и кнопка действия объединены в **одну капсулу** (смешение ввода и действия)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El campo de búsqueda y un botón de acción unidos en **la misma cápsula** (mezclando entrada y acción)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Suchfeld und ein Aktions-Button in **dieselbe Kapsel** gebunden (Eingabe und Aktion vermischt)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le champ de recherche et un bouton d'action liés dans **la même capsule** (mélange de saisie et d'action)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il campo di ricerca e un pulsante di azione uniti nella **stessa capsula** (mescolare input e azione)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O campo de busca e um botão de ação reunidos **na mesma cápsula** (misturando entrada e ação)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่องค้นหากับปุ่มการกระทำผูกใน**แคปซูลเดียวกัน** (ปนอินพุตกับการกระทำ)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ô tìm kiếm và nút hành động gộp vào **cùng một capsule** (trộn nhập liệu với hành động)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávací pole a tlačítko akce svázané do **stejné kapsle** (míchání vstupu a akce)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgefeltet og en handlingsknap bundet sammen i **samme kapsel** (blanding af input og handling)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πεδίο αναζήτησης και ένα κουμπί ενέργειας δεμένα στην **ίδια κάψουλα** (ανάμειξη εισαγωγής και ενέργειας)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakukenttä ja toimintopainike sidottuna **samaan kapseliin** (syötön ja toiminnon sekoitus)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolom pencarian dan tombol aksi disatukan dalam **kapsul yang sama** (mencampur input dan aksi)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søkefeltet og en handlingsknapp bundet sammen i **samme kapsel** (blander inndata og handling)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zoekveld en een actieknop samengebracht in **dezelfde capsule** (invoer en actie door elkaar)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pole wyszukiwania i przycisk akcji związane w **tej samej kapsule** (mieszanie wprowadzania i akcji)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökfältet och en åtgärdsknapp ihopbundna i **samma kapsel** (blandar inmatning och åtgärd)"
