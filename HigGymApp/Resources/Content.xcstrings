            "value": "[.medium, .large]: khai báo **nhiều** detent và để người ta kéo giữa các bậc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "[.medium, .large]: deklarujte **více** detentů a nechte lidi táhnout mezi kroky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "[.medium, .large]: erklær **flere** detents, og lad folk trække mellem trinnene."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "[.medium, .large]: δήλωσε **πολλαπλά** detents και άσε τους ανθρώπους να σύρουν ανάμεσα στα βήματα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "[.medium, .large]: julista **useita** detenttejä ja anna ihmisten vetää portaiden välillä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "[.medium, .large]: deklarasikan **beberapa** detent dan biarkan orang menyeret di antara langkah-langkahnya."
          }
        },
        "nb": {
