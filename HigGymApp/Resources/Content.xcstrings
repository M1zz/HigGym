          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povýšit hledání typu filtr zužující seznam na kartu (.searchable je správná struktura)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At løfte filtersøgning, der indsnævrer en liste, op til en fane (.searchable er den rigtige struktur)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαγωγή αναζήτησης τύπου φίλτρου που στενεύει μια λίστα σε καρτέλα (το .searchable είναι η σωστή δομή)"
          }
        }
      }
