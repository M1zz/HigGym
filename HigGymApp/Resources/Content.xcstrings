    "경계가 정보인 화면에서는 hard로 어디까지가 콘텐츠인지 분명히 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On screens where the boundary is information, use hard to make clear where the content ends."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On screens where the boundary is information, use hard to make clear where the content ends."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "境界が情報である画面では、hard でどこまでがコンテンツかをはっきりさせる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在边界就是信息的界面里，用 hard 把内容到哪里为止说清楚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在邊界就是資訊的介面裡，用 hard 把內容到哪裡為止說清楚。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экранах, где граница - информация, используйте hard, чтобы ясно показать, где контент заканчивается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pantallas donde el límite es información, usa hard para dejar claro dónde termina el contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze auf Bildschirmen, auf denen die Grenze Information ist, hard, um klarzumachen, wo der Inhalt endet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur les écrans où la limite est de l'information, utilisez hard pour bien montrer où le contenu s'arrête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelle schermate in cui il confine è informazione, usa hard per chiarire dove finisce il contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em telas em que a fronteira é informação, use hard para deixar claro onde o conteúdo termina."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้าจอที่ขอบเขตคือข้อมูล ใช้ hard เพื่อทำให้ชัดว่าเนื้อหาจบที่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình mà ranh giới là thông tin, dùng hard để rõ nội dung kết thúc ở đâu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na obrazovkách, kde je hranice informací, použijte hard, aby bylo jasné, kde obsah končí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På skærme, hvor grænsen er information, brug hard for at gøre klart, hvor indholdet slutter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε οθόνες όπου το όριο είναι πληροφορία, χρησιμοποίησε hard για να γίνει σαφές πού τελειώνει το περιεχόμενο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkymissä, joissa raja on tietoa, käytä hardia tehdäksesi selväksi, mihin sisältö päättyy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada layar yang batasnya adalah informasi, pakai hard untuk memperjelas di mana konten berakhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På skjermer der grensen er informasjon, bruk hard for å gjøre det klart hvor innholdet slutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik op schermen waar de grens informatie is hard om duidelijk te maken waar de inhoud eindigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ekranach, na których granica jest informacją, użyj hard, by jasno pokazać, gdzie kończy się treść."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På skärmar där gränsen är information, använd hard för att göra klart var innehållet slutar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırın bilgi olduğu ekranlarda içeriğin nerede bittiğini netleştirmek için hard kullan."
          }
        }
      }
    },
    "경계가 중요한 입력창 위에 soft 유지": {
      "extractionState": "manual",
      "localizations": {
