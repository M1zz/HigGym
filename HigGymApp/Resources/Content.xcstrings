        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A top bar so tall it eats into the content area"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部のバーが高すぎて、コンテンツ領域を侵食する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
