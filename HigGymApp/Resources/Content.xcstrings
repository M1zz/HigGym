    },
    "자주 쓰는 액션이니 도달성 기준을 그대로 적용한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a frequently used action, so you apply the reach criterion as is."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a frequently used action, so you apply the reach criterion as is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使うアクションだから、届きやすさの基準をそのまま当てはめる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是常用操作，所以直接套用可触达标准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是常用操作，所以直接套用可觸達標準。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это часто используемое действие, поэтому вы применяете критерий досягаемости как есть."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una acción de uso frecuente, así que aplicas el criterio de alcance tal cual."
          }
        }
      }
    },
    "작성 기능을 가장 잘 보이는 자리에 두고 싶어 탭 모양을 빌린다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You want compose in the most visible spot, so you borrow the shape of a tab."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You want compose in the most visible spot, so you borrow the shape of a tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成機能を最も目立つ場所に置きたくて、タブの形を借りる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想把撰写功能放在最显眼的位置，于是借用标签的外形。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想把撰寫功能放在最顯眼的位置，於是借用標籤的外形。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы хотите поставить создание в самое заметное место, поэтому заимствуете форму вкладки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quieres redactar en el sitio más visible, así que tomas prestada la forma de una pestaña."
          }
        }
      }
    },
    "작성 내용 유실 위험": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Risks losing entered data"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Risks losing entered data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容が失われるおそれがある"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写内容丢失的风险"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫內容丟失的風險"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рискует потерей введённых данных"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriesga perder los datos introducidos"
          }
        }
      }
    },
    "작성 내용이 날아가는 이탈은 친절이 아니다. 진행 중에는 탭바를 숨긴다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Letting people leave and lose what they were writing isn't kind. Hide the tab bar while a flow is in progress."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Letting people leave and lose what they were writing isn't kind. Hide the tab bar while a flow is in progress."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書いた内容が消える離脱は親切ではない。進行中はタブバーを隠す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让撰写内容丢掉的退出不是体贴。进行中要隐藏标签栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓撰寫內容丟掉的退出不是體貼。進行中要隱藏標籤列。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволить людям уйти и потерять написанное - недоброжелательно. Скрывайте панель вкладок, пока идёт процесс."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar que la gente se vaya y pierda lo que escribía no es amable. Oculta la barra de pestañas mientras un flujo está en curso."
          }
        }
      }
    },
    "작성 버튼과 텍스트 행은 표준 전환으로 되돌린다. 아래에서 올라오는 모션은 \"임시 레이어가 위에 쌓인다\"는 뜻이라 출처를 주장하지 않는다. zoom은 카드와 썸네일에만 남긴다. 이제 zoom이 보이면 그것은 언제나 \"방금 누른 그것\"이라는 뜻이 된다. 앱의 4.3.2 Zoom Sheet 예제에서 카드가 시트로 확대되는 모습을 보고, 작성 버튼에 같은 효과를 상상해 보면 어색함이 분명해진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert the compose button and text rows to the standard transition. Motion that rises from the bottom means \"a temporary layer stacks on top,\" so it claims no source. Keep zoom only for cards and thumbnails. Now whenever zoom appears, it always means \"the thing you just tapped.\" Watch a card zoom into a sheet in the app's 4.3.2 Zoom Sheet example, then imagine the same effect on a compose button, and the awkwardness becomes obvious."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert the compose button and text rows to the standard transition. Motion that rises from the bottom means \"a temporary layer stacks on top,\" so it claims no source. Keep zoom only for cards and thumbnails. Now whenever zoom appears, it always means \"the thing you just tapped.\" Watch a card zoom into a sheet in the app's 4.3.2 Zoom Sheet example, then imagine the same effect on a compose button, and the awkwardness becomes obvious."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成ボタンとテキストの行は標準のトランジションに戻す。下から上がってくるモーションは「一時的なレイヤーが上に重なる」という意味なので、出どころを主張しない。zoomはカードとサムネールにだけ残す。これでzoomが見えたら、それはいつでも「今タップしたもの」という意味になる。アプリの4.3.2 Zoom Sheetの例でカードがシートに拡大する様子を見て、同じ効果を作成ボタンにかけたところを想像してみると、違和感がはっきりする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把撰写按钮和文本行改回标准转场。从下方升起的动效意味着“临时图层叠在上面”，不会主张来源。zoom 只留给卡片和缩略图。这样一来，只要看到 zoom，就总是代表“刚才点的就是它”。在应用的 4.3.2 Zoom Sheet 示例里看卡片放大成弹层的样子，再想象撰写按钮用同样的效果，别扭就很明显了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把撰寫按鈕和文字行改回標準轉場。從下方升起的動效意味著「臨時圖層疊在上面」，不會主張來源。zoom 只留給卡片和縮圖。這樣一來，只要看到 zoom，就總是代表「剛才點的就是它」。在應用程式的 4.3.2 Zoom Sheet 示例裡看卡片放大成工作表的樣子，再想象撰寫按鈕用同樣的效果，彆扭就很明顯了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верните кнопке создания и текстовым строкам стандартный переход. Движение, поднимающееся снизу, означает «временный слой ложится сверху», поэтому оно не заявляет об источнике. Оставьте zoom только для карточек и миниатюр. Тогда каждое появление zoom всегда будет значить «то, что вы только что нажали». Посмотрите в примере приложения 4.3.2 Zoom Sheet, как карточка раскрывается в шторку, а затем представьте тот же эффект на кнопке создания, и неловкость станет очевидной."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devuelve el botón de redactar y las filas de texto a la transición estándar. El movimiento que sube desde abajo significa «una capa temporal se apila encima», así que no reclama ningún origen. Deja zoom solo para tarjetas y miniaturas. Así, cuando aparezca zoom, siempre significará «aquello que acabas de tocar». Mira una tarjeta ampliarse en una hoja en el ejemplo 4.3.2 Zoom Sheet de la app, luego imagina el mismo efecto en un botón de redactar, y la torpeza se vuelve evidente."
          }
        }
      }
    },
    "작성 버튼을 목록 화면의 툴바로 옮긴다. 분리 캡슐 자리에는 검색을 돌려놓거나, 강조할 목적지가 정말 있다면 `.prominent` 로 그 목적지를 둔다. 탭바는 다시 장소만 말하고, 작성은 작성이 필요한 화면에서 버튼으로 만난다. 앱의 3.4.2 With Search Role 예제와 3.4.4 Prominent Role 예제를 함께 보면 그 자리가 무엇을 위한 자리인지 분명해진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the compose button to the list screen's toolbar. Return search to the separate capsule spot, or if there really is a destination to highlight, put that destination there with `.prominent`. The tab bar goes back to speaking only of places, and people find compose as a button on the screens where they need it. Look at the app's 3.4.2 With Search Role and 3.4.4 Prominent Role examples together, and it becomes clear what that spot is for."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the compose button to the list screen's toolbar. Return search to the separate capsule spot, or if there really is a destination to highlight, put that destination there with `.prominent`. The tab bar goes back to speaking only of places, and people find compose as a button on the screens where they need it. Look at the app's 3.4.2 With Search Role and 3.4.4 Prominent Role examples together, and it becomes clear what that spot is for."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成ボタンをリスト画面のツールバーに移す。分離されたカプセルの場所には検索を戻すか、本当に強調すべき目的地があるなら `.prominent` でその目的地を置く。タブバーは再び場所だけを語り、作成は作成が必要な画面でボタンとして出会う。アプリの 3.4.2 With Search Role の例と 3.4.4 Prominent Role の例を一緒に見ると、その場所が何のためにあるのかがはっきりする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把撰写按钮移到列表界面的工具栏。分离胶囊的位置要么把搜索放回去，要么在确实有需要强调的目的地时，用 `.prominent` 放那个目的地。标签栏重新只说地点，撰写则在需要撰写的界面里以按钮的形式遇到。把应用的 3.4.2 With Search Role 示例和 3.4.4 Prominent Role 示例放在一起看，就能看清那个位置是为什么而设的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把撰寫按鈕移到列表介面的工具列。分離膠囊的位置要麼把搜尋放回去，要麼在確實有需要強調的目的地時，用 `.prominent` 放那個目的地。標籤列重新只說地點，撰寫則在需要撰寫的介面裡以按鈕的形式遇到。把應用程式的 3.4.2 With Search Role 示例和 3.4.4 Prominent Role 示例放在一起看，就能看清那個位置是為什麼而設的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесите кнопку создания на панель инструментов экрана со списком. Верните поиск на место отдельной капсулы или, если действительно есть место назначения, которое нужно выделить, поместите его туда с `.prominent`. Панель вкладок снова говорит только о местах, а создание люди находят кнопкой на тех экранах, где оно нужно. Посмотрите вместе примеры приложения 3.4.2 With Search Role и 3.4.4 Prominent Role, и станет ясно, для чего это место."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el botón de redactar a la barra de herramientas de la pantalla de lista. Devuelve la búsqueda al sitio de la cápsula separada o, si de verdad hay un destino que destacar, pon ahí ese destino con `.prominent`. La barra de pestañas vuelve a hablar solo de lugares, y la gente encuentra redactar como un botón en las pantallas donde lo necesita. Mira juntos los ejemplos 3.4.2 With Search Role y 3.4.4 Prominent Role de la app y quedará claro para qué sirve ese sitio."
          }
        }
      }
    },
    "작성 중 데이터가 있는 시트라면 아래로 스와이프 닫기로 인한 손실 주의interactiveDismissDisabled + 확인 다이얼로그를 고려하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the sheet holds data being entered, watch out for losing it to swipe-to-dismiss. Consider interactiveDismissDisabled plus a confirmation dialog."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If the sheet holds data being entered, watch out for losing it to swipe-to-dismiss. Consider interactiveDismissDisabled plus a confirmation dialog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中のデータがあるシートなら、下へのスワイプで閉じてしまうことによる消失に注意。interactiveDismissDisabled＋確認ダイアログを検討してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果弹层里有正在撰写的数据，请注意向下轻扫关闭造成的损失：考虑 interactiveDismissDisabled + 确认对话框。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果工作表裡有正在撰寫的資料，請注意向下輕掃關閉造成的損失：考慮 interactiveDismissDisabled + 確認對話方塊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если в шторке вводятся данные, остерегайтесь их потери при закрытии смахиванием. Рассмотрите interactiveDismissDisabled вместе с диалогом подтверждения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la hoja contiene datos que se están introduciendo, cuidado con perderlos por el descarte deslizando. Plantéate interactiveDismissDisabled más un diálogo de confirmación."
          }
        }
      }
    },
    "작성 화면이 전체 화면으로 열린다. 위에도 아래에도 버튼이 없다. 쓰는 사람은 시트를 닫던 습관대로 아래로 쓸어내린다. 아무 일도 없다. 좌우로 밀어 보고 가장자리를 눌러 본다. 멈춘 게 아니라 **나갈 길이 없는** 화면이다. 남은 방법은 앱을 끄는 것뿐이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compose screen opens full screen. There are no buttons at the top or the bottom. Out of habit from closing sheets, the user swipes down. Nothing happens. They try swiping sideways and tapping the edges. The screen hasn't frozen: it simply has **no way out**. The only option left is to quit the app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The compose screen opens full screen. There are no buttons at the top or the bottom. Out of habit from closing sheets, the user swipes down. Nothing happens. They try swiping sideways and tapping the edges. The screen hasn't frozen: it simply has **no way out**. The only option left is to quit the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成画面がフルスクリーンで開く。上にも下にもボタンがない。ユーザーはシートを閉じるときの癖で下へスワイプする。何も起きない。左右にスワイプしてみたり、端をタップしてみたりする。固まったのではなく、**出口がない**画面なのだ。残された手段はアプリを終了することだけだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写界面以全屏打开。上面和下面都没有按钮。使用者按关闭弹层的习惯向下轻扫。毫无反应。左右推，点边缘。这不是卡住了，而是**没有出路**的界面。剩下的办法只有强退应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫介面以全螢幕開啟。上面和下面都沒有按鈕。使用者按關閉工作表的習慣向下輕掃。毫無反應。左右推，點邊緣。這不是卡住了，而是**沒有出路**的介面。剩下的辦法只有強退應用程式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран создания открывается на весь экран. Ни сверху, ни снизу кнопок нет. По привычке закрывать шторки пользователь смахивает вниз. Ничего не происходит. Пробует смахнуть вбок и нажимать на края. Экран не завис: у него просто **нет выхода**. Остаётся лишь выйти из приложения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla de redactar se abre a pantalla completa. No hay botones ni arriba ni abajo. Por costumbre de cerrar hojas, el usuario desliza hacia abajo. No pasa nada. Prueba a deslizar hacia los lados y a tocar los bordes. La pantalla no se ha congelado: simplemente **no tiene salida**. La única opción que queda es cerrar la app."
          }
        }
      }
    },
    "작성은 몰입이 필요하니 전체 화면으로 덮는다. 시트를 쓰던 감각으로 닫기는 스와이프가 해 주리라 여긴다. 개발 중에는 앱을 다시 실행하며 확인하니 화면을 닫아 볼 일이 드물다. 여는 코드만 쓰고 닫는 코드는 나중으로 미룬다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing needs focus, so you cover the whole screen. Used to sheets, you assume a swipe will take care of closing. During development you check things by relaunching the app, so you rarely need to close the screen. You write the code that opens it and put off the code that closes it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing needs focus, so you cover the whole screen. Used to sheets, you assume a swipe will take care of closing. During development you check things by relaunching the app, so you rarely need to close the screen. You write the code that opens it and put off the code that closes it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成には没入が必要だからと、画面全体を覆う。シートに慣れた感覚で、閉じるのはスワイプがやってくれると思い込む。開発中はアプリを再起動して確認するので、画面を閉じてみる機会はあまりない。開くコードだけ書いて、閉じるコードは後回しにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写需要沉浸，所以用全屏盖住。凭用弹层的感觉，觉得关闭交给滑动就行。开发时是重新运行应用来确认的，很少有机会关闭界面。只写了打开的代码，关闭的代码推到以后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫需要沉浸，所以用全螢幕蓋住。憑用工作表的感覺，覺得關閉交給滑動就行。開發時是重新執行應用程式來確認的，很少有機會關閉介面。只寫了開啟的程式碼，關閉的程式碼推到以後。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для письма нужна сосредоточенность, поэтому вы закрываете весь экран. Привыкнув к шторкам, вы полагаете, что с закрытием справится смахивание. Во время разработки вы проверяете всё перезапуском приложения, так что закрывать экран почти не требуется. Вы пишете код открытия, а код закрытия откладываете."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribir necesita concentración, así que cubres toda la pantalla. Acostumbrado a las hojas, supones que un deslizamiento se encargará de cerrar. Durante el desarrollo compruebas las cosas relanzando la app, así que rara vez necesitas cerrar la pantalla. Escribes el código que la abre y pospones el que la cierra."
          }
        }
      }
    },
    "작성이 가장 중요한 기능이고, 탭바는 가장 잘 보이고 가장 누르기 쉬운 자리다. 탭 모양을 빌리면 버튼을 따로 만들 필요 없이 그 자리를 쓸 수 있다. 다른 앱에서도 본 적 있는 배치라 관습처럼 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Composing is the most important feature, and the tab bar is the most visible and easiest-to-tap spot. Borrowing a tab's shape lets you use that spot without building a separate button. It's a layout you've seen in other apps too, so it looks like a convention."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Composing is the most important feature, and the tab bar is the most visible and easiest-to-tap spot. Borrowing a tab's shape lets you use that spot without building a separate button. It's a layout you've seen in other apps too, so it looks like a convention."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成は最も重要な機能で、タブバーは最も目立ち、最もタップしやすい場所だ。タブの形を借りれば、別にボタンを作らなくてもその場所を使える。ほかのアプリでも見たことのある配置なので、慣習のように見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写是最重要的功能，而标签栏是最显眼、最容易点到的位置。借标签的外形，就不用另做按钮，直接用那个位置。在别的应用里也见过这种布局，看起来像是惯例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫是最重要的功能，而標籤列是最顯眼、最容易點到的位置。借標籤的外形，就不用另做按鈕，直接用那個位置。在別的應用程式裡也見過這種佈局，看起來像是慣例。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создание - важнейшая функция, а панель вкладок - самое заметное и удобное для нажатия место. Заимствовав форму вкладки, можно использовать это место, не строя отдельной кнопки. Такую раскладку вы видели и в других приложениях, так что она выглядит как соглашение."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactar es la función más importante, y la barra de pestañas es el sitio más visible y fácil de tocar. Tomar prestada la forma de una pestaña te permite usar ese sitio sin construir un botón aparte. Es un diseño que has visto en otras apps, así que parece una convención."
          }
        }
      }
    },
    "작업/기록처럼 대등한 두 축": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two equal axes, such as work and history"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Two equal axes, such as work and history"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業と記録のように対等な2つの軸"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像工作/记录这样平级的两条轴"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像工作/記錄這樣平級的兩條軸"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две равные оси, такие как работа и история"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos ejes iguales, como trabajo e historial"
          }
        }
      }
    },
    "작은 화면(SE급)에서 겹침·잘림 검증 없이 풀 구성 강행": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcing the full setup without checking for overlap and clipping on small (SE-class) screens"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcing the full setup without checking for overlap and clipping on small (SE-class) screens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さい画面（SEクラス）での重なりや切れを確認せず、フル構成を押し通す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在小屏幕（SE 级）上不验证重叠 · 截断，就强推完整配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在小螢幕（SE 級）上不驗證重疊 · 截斷，就強推完整配置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принудительное применение полной конфигурации без проверки наложений и обрезки на маленьких (класса SE) экранах"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar la configuración completa sin comprobar solapamientos y recortes en pantallas pequeñas (clase SE)"
          }
        }
      }
    },
    "작은 화면에서 검증하지 않고 풀 구성을 밀어붙인다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushing the full setup without testing on small screens"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushing the full setup without testing on small screens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さい画面で確かめずにフル構成を押し通す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不在小屏幕上验证，就强推完整配置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不在小螢幕上驗證，就強推完整配置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продавливание полной конфигурации без проверки на маленьких экранах"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imponer la configuración completa sin probar en pantallas pequeñas"
          }
        }
      }
    },
    "작은 화면에서 넘침": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overflows on small screens"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Overflows on small screens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さい画面ではみ出す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在小屏幕上溢出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在小螢幕上溢位"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переполняется на маленьких экранах"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desborda en pantallas pequeñas"
          }
        }
      }
    },
    "작은 화면에서는 넘치고 큰 화면에서는 뜬다. fraction이나 시스템 2단으로.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It overflows on small screens and leaves gaps on large ones. Use fraction or the system's two steps."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It overflows on small screens and leaves gaps on large ones. Use fraction or the system's two steps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さい画面ではあふれ、大きい画面では空きができる。fraction かシステムの2段階で。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在小屏幕上溢出，在大屏幕上悬空。用 fraction 或系统两档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在小螢幕上溢位，在大螢幕上懸空。用 fraction 或系統兩檔。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На маленьких экранах переполняется, а на больших оставляет пустоты. Используйте fraction или две системные ступени."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desborda en pantallas pequeñas y deja huecos en las grandes. Usa fraction o los dos escalones del sistema."
          }
        }
      }
    },
    "잔액 칸에 `minimumScaleFactor(0.3)`이 걸려 있다. 금액이 커지면 숫자가 원래의 3분의 1 크기까지 줄어 칸에 들어간다. 다 보이긴 하지만, 쉼표와 자릿수를 읽으려면 화면에 눈을 가까이 대야 한다. 같은 줄의 라벨보다 금액이 더 작다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance field has `minimumScaleFactor(0.3)` applied. As the amount grows, the digits shrink to as little as a third of their original size to fit. Everything is visible, but you have to bring your eyes close to the screen to read the commas and digits. The amount ends up smaller than the label on the same line."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The balance field has `minimumScaleFactor(0.3)` applied. As the amount grows, the digits shrink to as little as a third of their original size to fit. Everything is visible, but you have to bring your eyes close to the screen to read the commas and digits. The amount ends up smaller than the label on the same line."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高の欄に `minimumScaleFactor(0.3)` がかかっている。金額が大きくなると、数字は元の3分の1のサイズまで縮んで欄に収まる。すべて見えてはいるが、カンマや桁を読むには画面に目を近づけなければならない。同じ行のラベルより金額のほうが小さい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额格子上加了 `minimumScaleFactor(0.3)`。金额一变大，数字就缩到原来的三分之一才塞进格子。虽然看得见，但要读逗号和位数，得把眼睛凑到屏幕跟前。金额比同一行的标签还小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額格子上加了 `minimumScaleFactor(0.3)`。金額一變大，數字就縮到原來的三分之一才塞進格子。雖然看得見，但要讀逗號和位數，得把眼睛湊到螢幕跟前。金額比同一行的標籤還小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К полю баланса применён `minimumScaleFactor(0.3)`. По мере роста суммы цифры сжимаются до трети исходного размера, чтобы поместиться. Всё видно, но чтобы прочесть разделители и цифры, приходится подносить глаза к экрану. Сумма оказывается мельче подписи в той же строке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El campo de saldo tiene aplicado `minimumScaleFactor(0.3)`. A medida que crece el importe, las cifras se encogen hasta un tercio de su tamaño original para caber. Todo es visible, pero tienes que acercar los ojos a la pantalla para leer las comas y las cifras. El importe acaba más pequeño que la etiqueta de la misma línea."
          }
        }
      }
    },
    "잘 동작하던 배치를 다른 화면에 옮기기 전에 묻는다. \"그 배치가 기대던 조건이 저 화면에도 있나?\" 조건이 다르면 배치도 달라야 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before moving a layout that worked well to another screen, ask: \"Do the conditions it relied on exist on that screen too?\" If the conditions differ, the layout should too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before moving a layout that worked well to another screen, ask: \"Do the conditions it relied on exist on that screen too?\" If the conditions differ, the layout should too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまく機能していた配置を別の画面に移す前に問う。「その配置が頼っていた条件は、あの画面にもあるか？」条件が違えば、配置も違うべきだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把运行良好的布局搬到别的界面之前，先问：“那个布局所依赖的条件，那个界面里也有吗？”条件不同，布局也该不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把執行良好的佈局搬到別的介面之前，先問：「那個佈局所依賴的條件，那個介面裡也有嗎？」條件不同，佈局也該不同。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем переносить хорошо работавший макет на другой экран, спросите: «Существуют ли условия, на которые он опирался, и на том экране?» Если условия другие, макет тоже должен быть другим."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de trasladar a otra pantalla un diseño que funcionaba bien, pregunta: «¿Existen también en esa pantalla las condiciones en las que se apoyaba?» Si las condiciones difieren, el diseño también debe diferir."
          }
        }
      }
    },
    "잘리거나 겹침": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipped or overlapping"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipped or overlapping"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切れたり重なったりする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被截断或重叠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被截斷或重疊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезано или перекрывается"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortado o solapado"
          }
        }
      }
    },
    "잘리는 것보다는 작게라도 다 보이는 게 낫다. 금액은 잘리면 안 된다는 원칙을 지켰으니 옳은 선택처럼 보인다. 어떤 금액이 와도 칸에 들어가니 레이아웃도 안전하다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Better to show everything, even small, than to cut it off. It honors the principle that amounts must never be truncated, so it looks like the right call. Any amount fits in the field, so the layout is safe too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Better to show everything, even small, than to cut it off. It honors the principle that amounts must never be truncated, so it looks like the right call. Any amount fits in the field, so the layout is safe too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り詰められるよりは、小さくてもすべて見えるほうがよい。金額は切り詰めてはいけないという原則を守ったので、正しい選択に見える。どんな金額でも欄に収まるので、レイアウトも安全だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比起被截断，小一点也全部看得见更好。金额不能被截断这条原则守住了，看起来是正确的选择。无论来多大的金额都装得进格子，布局也安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比起被截斷，小一點也全部看得見更好。金額不能被截斷這條原則守住了，看起來是正確的選擇。無論來多大的金額都裝得進格子，佈局也安全。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучше показать всё, пусть мелко, чем обрезать. Это соблюдает принцип, что суммы нельзя усекать, поэтому кажется верным решением. Любая сумма помещается в поле, так что и макет безопасен."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejor mostrarlo todo, aunque pequeño, que cortarlo. Respeta el principio de que los importes nunca deben truncarse, así que parece la decisión correcta. Cualquier importe cabe en el campo, así que el diseño también es seguro."
          }
        }
      }
    },
    "잘리는 것보다는 작게라도 다 보이는 게 낫다고 판단한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide it's better to show everything, even small, than to cut it off."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide it's better to show everything, even small, than to cut it off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り詰められるよりは、小さくてもすべて見えるほうがよいと判断する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认为比起被截断，小一点也全部看得见更好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "認為比起被截斷，小一點也全部看得見更好。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы решаете, что лучше показать всё, пусть мелко, чем обрезать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decides que es mejor mostrarlo todo, aunque pequeño, que cortarlo."
          }
        }
      }
    },
    "잘린 값에서 이어지는 길을 하나 만든다. 셀을 누르면 상세로 가거나, 더보기로 펼치거나, 전체를 보여 주는 도움말을 띄운다. 목록 높이는 그대로 고르고, 결정하는 순간에는 전체를 볼 수 있다. 주소가 늘 두 줄이면 들어간다면 애초에 줄 수를 늘리는 편이 낫다. 2.1.1 예제에서 lineLimit이 어디서 끊는지 보고, 끊긴 뒤에 무엇이 있었는지 떠올려 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create one path that leads on from the truncated value. Tapping the cell can open a detail view, expand it with a \"more\" option, or show a tooltip with the full text. The list heights stay even, and at the moment of decision, people can see everything. If the address always fits in two lines, it's better to raise the line count in the first place. In the 2.1.1 example, see where lineLimit cuts off, and think about what came after the cut."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Create one path that leads on from the truncated value. Tapping the cell can open a detail view, expand it with a \"more\" option, or show a tooltip with the full text. The list heights stay even, and at the moment of decision, people can see everything. If the address always fits in two lines, it's better to raise the line count in the first place. In the 2.1.1 example, see where lineLimit cuts off, and think about what came after the cut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切れた値から先へつながる道をひとつ作る。セルを押すと詳細へ行くか、「もっと見る」で展開するか、全体を見せるヘルプを表示する。リストの高さはそろったまま、判断する瞬間には全体が見られる。住所が2行あれば必ず収まるなら、最初から行数を増やすほうがよい。2.1.1 の例で lineLimit がどこで切るかを見て、切れたあとに何があったのかを思い浮かべてみよう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为被截断的值开一条后续的路。点按单元格进入详情，用“查看更多”展开，或弹出显示全文的提示。列表高度保持一致，而做决定的那一刻能看到全文。如果地址总是两行就放得下，那一开始增加行数更好。在 2.1.1 示例里看 lineLimit 在哪里截断，再想想截断之后原本有什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為被截斷的值開一條後續的路。輕點單元格進入詳情，用「檢視更多」展開，或彈出顯示全文的提示。列表高度保持一致，而做決定的那一刻能看到全文。如果地址總是兩行就放得下，那一開始增加行數更好。在 2.1.1 示例裡看 lineLimit 在哪裡截斷，再想想截斷之後原本有什麼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте один путь, ведущий дальше от усечённого значения. Нажатие на ячейку может открыть подробности, раскрыть её по «ещё» или показать подсказку с полным текстом. Высоты списка остаются ровными, а в момент решения люди видят всё. Если адрес всегда помещается в две строки, лучше сразу увеличить число строк. В примере 2.1.1 посмотрите, где lineLimit обрезает, и подумайте, что последовало за обрезкой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un camino que lleve más allá del valor truncado. Tocar la celda puede abrir una vista de detalle, expandirla con una opción «más» o mostrar una ayuda con el texto completo. Las alturas de la lista se mantienen parejas, y en el momento de decidir, la gente puede verlo todo. Si la dirección siempre cabe en dos líneas, es mejor subir el número de líneas desde el principio. En el ejemplo 2.1.1, mira dónde corta lineLimit y piensa qué vino después del corte."
          }
        }
      }
    },
    "잘린 값이 주소·금액처럼 결정에 쓰이면, 더보기·상세·툴팁 중 하나는 반드시 만든다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the truncated value is something people base decisions on, like an address or an amount, always provide at least one of: a \"more\" option, a detail view, or a tooltip."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If the truncated value is something people base decisions on, like an address or an amount, always provide at least one of: a \"more\" option, a detail view, or a tooltip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切れた値が住所や金額のように判断に使われるものなら、「もっと見る」・詳細・ツールチップのどれかひとつは必ず作る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被截断的值如果用于做决定，比如地址、金额，就必须做出“查看更多”、详情、提示中的一种。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被截斷的值如果用於做決定，比如地址、金額，就必須做出「檢視更多」、詳情、提示中的一種。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если усечённое значение - то, на чём люди основывают решения, как адрес или сумма, всегда предоставляйте хотя бы одно: «ещё», экран подробностей или подсказку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el valor truncado es algo en lo que la gente basa decisiones, como una dirección o un importe, ofrece siempre al menos una de estas cosas: una opción «más», una vista de detalle o una ayuda."
          }
        }
      }
    },
    "잘림 모드를 고를 때 먼저 찾는다. \"이 텍스트에서 구분에 쓰이는 부분은 어디인가?\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When choosing a truncation mode, first ask: \"Which part of this text is used to tell items apart?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When choosing a truncation mode, first ask: \"Which part of this text is used to tell items apart?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り詰めモードを選ぶときは、まずこれを探す。「このテキストで区別に使われているのはどの部分か?」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选截断模式时先找：“这段文字里，用来区分的部分在哪里？”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選截斷模式時先找：「這段文字裡，用來區分的部分在哪裡？」"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирая режим усечения, сначала спросите: «По какой части этого текста различают элементы?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al elegir un modo de truncamiento, pregunta primero: «¿Qué parte de este texto se usa para distinguir los elementos?»"
          }
        }
      }
    },
    "잘림이 자주 일어나는 텍스트라면 truncation 모드를 고르기 전에 \"애초에 이 폭·줄 수가 맞는가\"를 먼저 의심하세요. 잘림은 최후의 안전장치지 레이아웃 설계 수단이 아닙니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a piece of text gets truncated often, before picking a truncation mode, first question \"is this width and line count right in the first place?\" Truncation is a last-resort safeguard, not a layout design tool."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If a piece of text gets truncated often, before picking a truncation mode, first question \"is this width and line count right in the first place?\" Truncation is a last-resort safeguard, not a layout design tool."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り詰めがよく起きるテキストなら、truncationモードを選ぶ前に「そもそもこの幅・行数で合っているのか」をまず疑ってください。切り詰めは最後の安全装置であって、レイアウト設計の手段ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是经常发生截断的文本，在选 truncation 模式之前，先怀疑“这个宽度、行数本身对不对”。截断是最后的安全装置，不是布局设计的手段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是經常發生截斷的文字，在選 truncation 模式之前，先懷疑「這個寬度、行數本身對不對」。截斷是最後的安全裝置，不是佈局設計的手段。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если фрагмент текста часто усекается, прежде чем выбирать режим усечения, сначала усомнитесь: «а верны ли вообще эта ширина и число строк?» Усечение - последняя страховка, а не инструмент проектирования макета."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un texto se trunca a menudo, antes de elegir un modo de truncamiento, cuestiona primero «¿son correctos de entrada este ancho y este número de líneas?» El truncamiento es una salvaguarda de último recurso, no una herramienta de diseño."
          }
        }
      }
    },
    "잡동사니를 하나씩 풀어 집을 정한다. 쿠폰은 결제와 가까운 탭 안으로, 공지와 이벤트는 홈의 한 구역으로, 설정과 앱 정보는 프로필 화면 안으로 내린다. \"더보기\" 칸이 사라지면 탭바는 넷이 되고, 남은 이름은 모두 목적지를 말한다. 앱의 3.2.3 4 Tabs 예제가 이런 표준 구성을 보여 준다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untangle the catch-all one item at a time and give each a home. Move coupons into the tab closest to checkout, announcements and events into a section of Home, and settings and app info into the Profile screen. Once the \"More\" slot is gone, the tab bar has four tabs, and every remaining name says where it leads. The app's 3.2.3 4 Tabs example shows this standard setup."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Untangle the catch-all one item at a time and give each a home. Move coupons into the tab closest to checkout, announcements and events into a section of Home, and settings and app info into the Profile screen. Once the \"More\" slot is gone, the tab bar has four tabs, and every remaining name says where it leads. The app's 3.2.3 4 Tabs example shows this standard setup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寄せ集めを1つずつほどいて、居場所を決める。クーポンは決済に近いタブの中へ、お知らせとイベントはホームの1区画へ、設定とアプリ情報はプロフィール画面の中へ移す。「その他」の枠がなくなるとタブバーは4つになり、残った名前はすべて行き先を語る。アプリの3.2.3 4 Tabsの例が、こうした標準の構成を見せてくれる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把杂物一个个解开，定好归宿。优惠券放进离支付近的标签里，公告和活动放进首页的一个区域，设置和应用信息下放到个人资料界面里。“更多”这一格消失后，标签栏变成四个，剩下的名称都在说目的地。应用的 3.2.3 4 Tabs 示例展示了这样的标准配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把雜物一個個解開，定好歸宿。優惠券放進離付款近的標籤裡，公告和活動放進首頁的一個區域，設定和應用程式資訊下放到個人資料介面裡。「更多」這一格消失後，標籤列變成四個，剩下的名稱都在說目的地。應用程式的 3.2.3 4 Tabs 示例展示了這樣的標準配置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распутайте универсальную вкладку по одному элементу и найдите каждому дом. Купоны перенесите во вкладку, ближайшую к оформлению заказа, объявления и события в раздел «Главной», а настройки и сведения о приложении на экран профиля. Когда места «Ещё» не станет, в панели вкладок останется четыре вкладки, и каждое оставшееся название говорит, куда оно ведёт. Пример приложения 3.2.3 4 Tabs показывает эту стандартную конфигурацию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenreda el cajón de sastre elemento a elemento y dale un hogar a cada uno. Pasa los cupones a la pestaña más cercana al pago, los anuncios y eventos a una sección de Inicio, y los ajustes y la información de la app a la pantalla de Perfil. Una vez desaparece el hueco «Más», la barra de pestañas tiene cuatro pestañas, y cada nombre restante dice adónde lleva. El ejemplo 3.2.3 4 Tabs de la app muestra esta configuración estándar."
          }
        }
      }
    },
    "장바구니 합계 + 결제 버튼 바": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cart total + checkout button bar"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A cart total + checkout button bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カートの合計＋決済ボタンのバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购物车合计 + 支付按钮栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購物車合計 + 付款按鈕列"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель с итогом корзины + кнопкой оформления"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra con el total del carrito + botón de pago"
          }
        }
      }
    },
    "장바구니 화면에서 결제를 누르면 절반 높이 시트가 올라온다. 딤이 없어서 뒤의 장바구니가 그대로 보이고, 수량을 바꾸거나 쿠폰을 누를 수도 있다. 시트에는 열던 순간의 금액이 적혀 있다. 뒤에서 수량을 바꾼 뒤 시트의 결제 버튼을 누르면, 눈앞의 금액과 실제로 결제될 대상이 같은지 쓰는 사람은 알 길이 없다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping Checkout on the cart screen brings up a half-height sheet. There's no dim, so the cart behind it stays fully visible, and you can change quantities or tap coupons. The sheet shows the total from the moment it opened. If you change a quantity in the background and then tap the sheet's Pay button, there's no way to know whether the amount in front of you matches what will actually be charged."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping Checkout on the cart screen brings up a half-height sheet. There's no dim, so the cart behind it stays fully visible, and you can change quantities or tap coupons. The sheet shows the total from the moment it opened. If you change a quantity in the background and then tap the sheet's Pay button, there's no way to know whether the amount in front of you matches what will actually be charged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カート画面で決済をタップすると、半分の高さのシートが上がってくる。ディムがないので後ろのカートがそのまま見え、数量を変えたりクーポンをタップしたりもできる。シートには開いた瞬間の金額が書かれている。後ろで数量を変えてからシートの支払いボタンを押すと、目の前の金額と実際に決済される対象が同じかどうか、使う人には知る術がない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在购物车界面点支付，半屏高度的弹层升起。没有压暗，后面的购物车原样可见，还能改数量、点优惠券。弹层里写着打开那一刻的金额。在后面改了数量，再点弹层里的支付按钮，使用者无从知道眼前的金额和实际要付款的对象是否一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在購物車介面點付款，半螢幕高度的工作表升起。沒有壓暗，後面的購物車原樣可見，還能改數量、點優惠券。工作表裡寫著開啟那一刻的金額。在後面改了數量，再點工作表裡的付款按鈕，使用者無從知道眼前的金額和實際要付款的物件是否一致。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие «Оформить» на экране корзины вызывает шторку половинной высоты. Затемнения нет, поэтому корзина позади остаётся полностью видна, и можно менять количество или нажимать на купоны. Шторка показывает итог с самого открытия. Если изменить количество на фоне, а затем нажать кнопку «Оплатить» в шторке, невозможно понять, совпадает ли сумма перед вами с той, что будет списана."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tocar Pagar en la pantalla del carrito aparece una hoja de media altura. No hay atenuación, así que el carrito de detrás sigue totalmente visible, y puedes cambiar cantidades o tocar cupones. La hoja muestra el total desde el momento en que se abrió. Si cambias una cantidad en segundo plano y luego tocas el botón Pagar de la hoja, no hay forma de saber si el importe que tienes delante coincide con el que se cobrará realmente."
          }
        }
      }
    },
    "재료 위 글자에 고정 회색을 지정한다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assigning a fixed gray to text on a material"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Assigning a fixed grey to text on a material"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マテリアルの上の文字に固定のグレーを指定する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给 material 上的文字指定固定灰色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給 material 上的文字指定固定灰色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначение фиксированного серого тексту на материале"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asignar un gris fijo al texto sobre un material"
          }
        }
      }
    },
    "재료 위에 재료를 겹친다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacking materials on top of materials"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacking materials on top of materials"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マテリアルの上にマテリアルを重ねる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 material 上叠 material"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 material 上疊 material"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наложение материалов друг на друга"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apilar materiales sobre materiales"
          }
        }
      }
    },
    "재료를 쓰면 뒤 콘텐츠의 흐름이 이어진다. 단색은 화면을 둘로 자른다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a material, the content behind keeps flowing. A solid color cuts the screen in two."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With a material, the content behind keeps flowing. A solid colour cuts the screen in two."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マテリアルを使えば、背後のコンテンツの流れがつながる。単色は画面を2つに切り分ける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用材质的话，后面内容的流动是连续的。纯色则把界面切成两半。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用材質的話，後面內容的流動是連續的。純色則把介面切成兩半。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С материалом содержимое позади продолжает течь. Сплошной цвет режет экран надвое."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un material, el contenido de detrás sigue fluyendo. Un color sólido corta la pantalla en dos."
          }
        }
      }
    },
    "재생 대기열 패널 .height(250)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A playback queue panel at .height(250)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A playback queue panel at .height(250)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生キューのパネルを.height(250)で"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放队列面板 .height(250)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放佇列面板 .height(250)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель очереди воспроизведения с .height(250)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panel de cola de reproducción con .height(250)"
          }
        }
      }
    },
    "재생 대기열 패널이 `.height(250)` 짜리 시트로 올라온다. 시안을 그린 화면에서는 버튼 줄이 딱 맞게 들어간다. 작은 화면에서 열면 마지막 줄이 시트 아래로 잘려 스크롤해야 보이고, 큰 글씨 설정을 켜면 라벨이 두 줄로 늘어나 더 잘린다. 큰 화면에서는 반대로 버튼 아래가 비어 \"뭔가 더 있나\" 싶은 공백이 남는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Up Next queue panel slides up as a `.height(250)` sheet. On the screen the mockup was drawn for, the rows of buttons fit perfectly. Open it on a small screen and the last row is cut off below the sheet, visible only by scrolling, and turn on a large text setting and the labels wrap to two lines and get cut off even more. On a large screen, conversely, the space below the buttons sits empty, leaving a gap that makes you wonder \"Is there something more?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Up Next queue panel slides up as a `.height(250)` sheet. On the screen the mockup was drawn for, the rows of buttons fit perfectly. Open it on a small screen and the last row is cut off below the sheet, visible only by scrolling, and turn on a large text setting and the labels wrap to two lines and get cut off even more. On a large screen, conversely, the space below the buttons sits empty, leaving a gap that makes you wonder \"Is there something more?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生キューのパネルが `.height(250)` のシートで上がってくる。デザインカンプを描いた画面では、ボタンの列がぴったり収まる。小さい画面で開くと最後の列がシートの下で切れてスクロールしないと見えず、大きい文字の設定をオンにするとラベルが2行に伸びてさらに切れる。大きい画面では逆にボタンの下が空き、「まだ何かあるのか」と思わせる空白が残る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放队列面板以 `.height(250)` 的弹层升起。在画设计稿的那个屏幕上，按钮行刚好放得下。在小屏幕上打开，最后一行被截在弹层下面，要滚动才能看到；打开大字号设置，标签变成两行，被截得更多。在大屏幕上则相反，按钮下面空着，留下“还有别的吗？”的空白。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放佇列面板以 `.height(250)` 的工作表升起。在畫設計稿的那個螢幕上，按鈕行剛好放得下。在小螢幕上開啟，最後一行被截在工作表下面，要滾動才能看到；開啟大字號設定，標籤變成兩行，被截得更多。在大螢幕上則相反，按鈕下面空著，留下「還有別的嗎？」的空白。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель очереди «Далее» выезжает шторкой `.height(250)`. На экране, под который рисовали макет, ряды кнопок помещаются идеально. Откройте её на маленьком экране, и последний ряд обрезан под шторкой и виден только при прокрутке; включите крупный текст, и подписи переносятся на две строки и обрезаются ещё сильнее. На большом экране, наоборот, место под кнопками пустует, оставляя пробел, из-за которого думаешь: «Есть ли там что-то ещё?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panel de cola «A continuación» sube como una hoja `.height(250)`. En la pantalla para la que se dibujó la maqueta, las filas de botones caben perfectamente. Ábrelo en una pantalla pequeña y la última fila se corta bajo la hoja, visible solo al desplazar, y activa un ajuste de texto grande y las etiquetas saltan a dos líneas y se cortan aún más. En una pantalla grande, al contrario, el espacio bajo los botones queda vacío, dejando un hueco que hace preguntarse «¿hay algo más?»"
          }
        }
      }
    },
    "재생 컨트롤 바": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A playback control bar"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A playback control bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生コントロールのバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放控制栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放控制列"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель управления воспроизведением"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra de control de reproducción"
          }
        }
      }
    },
    "재생 화면 하단에 커스텀 컨트롤 바가 있다. 바가 화면 맨 아래 끝까지 내려와 있고, 다음 곡 버튼이 홈 인디케이터 바로 위에 걸쳐 있다. 버튼을 누르려던 엄지가 조금만 위로 쓸려도 홈 화면으로 나가거나 앱 전환이 열린다. 반대로 앱을 나가려고 쓸어올리면 버튼이 눌린다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A playback screen has a custom control bar at the bottom. The bar extends all the way to the bottom edge of the screen, and the Next Track button sits right on top of the Home indicator. If the thumb reaching for the button slides up even slightly, it goes to the Home Screen or opens the app switcher. Conversely, swipe up to leave the app, and the button gets pressed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A playback screen has a custom control bar at the bottom. The bar extends all the way to the bottom edge of the screen, and the Next Track button sits right on top of the Home indicator. If the thumb reaching for the button slides up even slightly, it goes to the Home Screen or opens the app switcher. Conversely, swipe up to leave the app, and the button gets pressed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生画面の下部にカスタムのコントロールバーがある。バーは画面のいちばん下の端まで下りていて、次の曲のボタンがホームインジケータのすぐ上にかかっている。ボタンを押そうとした親指が少し上に滑っただけで、ホーム画面に戻ったりアプリスイッチャーが開いたりする。逆にアプリを出ようとして上にスワイプすると、ボタンが押される。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放界面底部有自定义控制栏。栏一直落到屏幕最底端，下一首按钮正好压在主屏幕指示条上方。想点按钮的拇指稍微往上一滑，就退到主屏幕或打开应用切换。反过来，想上滑退出应用，又会点到按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放介面底部有自定義控制列。列一直落到螢幕最底端，下一首按鈕正好壓在主螢幕指示條上方。想輕點鈕的拇指稍微往上一滑，就退到主螢幕或開啟應用程式切換。反過來，想上滑退出應用程式，又會點到按鈕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внизу экрана воспроизведения стоит пользовательская панель управления. Панель тянется до самого нижнего края экрана, а кнопка «Следующий трек» лежит прямо на индикаторе «Домой». Если большой палец, тянущийся к кнопке, хоть немного соскользнёт вверх, он уйдёт на Домашний экран или откроет переключатель приложений. И наоборот, смахнёте вверх, чтобы выйти из приложения, и кнопка нажмётся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pantalla de reproducción tiene una barra de control personalizada abajo. La barra llega hasta el borde inferior de la pantalla, y el botón de siguiente pista queda justo sobre el indicador de inicio. Si el pulgar que busca el botón se desliza hacia arriba aunque sea un poco, va a la pantalla de inicio o abre el selector de apps. Y a la inversa, desliza hacia arriba para salir de la app y se pulsa el botón."
          }
        }
      }
    },
    "재생·검색처럼 만국 공통으로 읽히는 아이콘일 때": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the icons read the same everywhere, like play or search"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the icons read the same everywhere, like play or search"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生や検索のように、世界中で共通に読めるアイコンのとき"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像播放、搜索这样全球通用的图标时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像播放、搜尋這樣全球通用的圖示時"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда значки везде читаются одинаково, как воспроизведение или поиск"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando los iconos se leen igual en todas partes, como reproducir o buscar"
          }
        }
      }
    },
    "저널 앱": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A journal app"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A journal app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナルアプリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日记应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日記應用程式"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение-дневник"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app de diario"
          }
        }
      }
    },
    "저장을 앞으로 보내고, 별표·깃발·프린트를 뒤로 돌린다. 아이템 수는 그대로다. 좁은 기기에서는 여전히 무언가 접히지만, 접히는 것이 어쩌다 쓰는 것으로 바뀐다. iOS 27에서는 `visibilityPriority(_:)` 로 공간이 좁을 때 남길 아이템을 직접 지정할 수 있고, `ToolbarOverflowMenu` 로 메뉴 구성도 다룰 수 있다. 1.1.7 Trailing Overflowing Cluster 예제에서 어떤 아이템이 ⋯ 안으로 들어가는지 확인해 보라.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Save to the front and push Favorite, Flag and Print to the back. The number of items stays the same. On narrow devices something still folds away, but now it's something you rarely use. In iOS 27, `visibilityPriority(_:)` lets you specify directly which items stay when space is tight, and `ToolbarOverflowMenu` lets you control how the menu is composed. Check which items go into ⋯ in the 1.1.7 Trailing Overflowing Cluster example."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Save to the front and push Favourite, Flag and Print to the back. The number of items stays the same. On narrow devices something still folds away, but now it's something you rarely use. In iOS 27, `visibilityPriority(_:)` lets you specify directly which items stay when space is tight, and `ToolbarOverflowMenu` lets you control how the menu is composed. Check which items go into ⋯ in the 1.1.7 Trailing Overflowing Cluster example."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存を前に出し、スター・フラグ・プリントを後ろに回す。アイテムの数はそのままだ。幅の狭いデバイスでは相変わらず何かが折りたたまれるが、折りたたまれるのがたまに使うものに変わる。iOS 27では`visibilityPriority(_:)`でスペースが狭いときに残すアイテムを直接指定でき、`ToolbarOverflowMenu`でメニューの構成も扱える。1.1.7 Trailing Overflowing Clusterの例で、どのアイテムが⋯の中に入るか確かめてみよう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把存储提前，星标 · 旗标 · 打印往后放。项目数量不变。在窄设备上仍然会折叠些什么，但被折叠的变成了偶尔才用的。在 iOS 27 中，可以用 `visibilityPriority(_:)` 直接指定空间变窄时要保留的项目，也可以用 `ToolbarOverflowMenu` 处理菜单构成。在 1.1.7 Trailing Overflowing Cluster 示例里，确认哪些项目进了 ⋯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把儲存提前，星標 · 旗標 · 列印往後放。項目數量不變。在窄裝置上仍然會摺疊些什麼，但被摺疊的變成了偶爾才用的。在 iOS 27 中，可以用 `visibilityPriority(_:)` 直接指定空間變窄時要保留的項目，也可以用 `ToolbarOverflowMenu` 處理選單構成。在 1.1.7 Trailing Overflowing Cluster 示例裡，確認哪些項目進了 ⋯。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместите «Сохранить» вперёд, а «Избранное», «Флажок» и «Печать» назад. Число элементов остаётся прежним. На узких устройствах что-то всё равно сворачивается, но теперь это то, чем пользуются редко. В iOS 27 `visibilityPriority(_:)` позволяет напрямую указать, какие элементы остаются, когда места мало, а `ToolbarOverflowMenu` даёт управлять составом меню. Посмотрите в примере 1.1.7 Trailing Overflowing Cluster, какие элементы уходят в ⋯."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa Guardar al principio y manda Favorito, Marcar e Imprimir al final. El número de elementos sigue igual. En dispositivos estrechos algo se sigue plegando, pero ahora es algo que usas poco. En iOS 27, `visibilityPriority(_:)` te permite indicar directamente qué elementos se quedan cuando falta espacio, y `ToolbarOverflowMenu` te permite controlar cómo se compone el menú. Comprueba qué elementos van a ⋯ en el ejemplo 1.1.7 Trailing Overflowing Cluster."
          }
        }
      }
    },
    "적용 전, 잘려서 정보 파괴": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before: truncated, information lost"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before: truncated, information lost"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用前：切れて情報が壊れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用前，被截断而信息损毁"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式前，被截斷而資訊損毀"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До: усечено, информация потеряна"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes: truncado, información perdida"
          }
        }
      }
    },
    "적용 후, 줄여서 전부 표시": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After: shrunk, everything shown"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "After: shrunk, everything shown"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用後：縮めて全部表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用后，缩小而全部显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式後，縮小而全部顯示"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После: уменьшено, показано всё"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después: reducido, todo visible"
          }
        }
      }
    },
    "전체 화면 뷰어로 들어가면 `.toolbar(.hidden, for: .tabBar)` 로 탭바를 숨긴다. 탭바가 차지하던 자리는 사진에 돌아가고, 뷰어에서 뒤로 나오면 원래 목록과 탭바가 그대로 돌아온다. 앱의 3.3.1 Always Visible 예제에서 기본 동작을 보고, 3.3.2 Hidden on Detail Views 예제와 비교하면 차이가 분명하다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When entering the full-screen viewer, hide the tab bar with `.toolbar(.hidden, for: .tabBar)`. The space the tab bar took goes back to the photo, and when you go back out of the viewer, the original list and tab bar return as they were. See the default behavior in the app's 3.3.1 Always Visible example, then compare it with the 3.3.2 Hidden on Detail Views example, and the difference is clear."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When entering the full-screen viewer, hide the tab bar with `.toolbar(.hidden, for: .tabBar)`. The space the tab bar took goes back to the photo, and when you go back out of the viewer, the original list and tab bar return as they were. See the default behaviour in the app's 3.3.1 Always Visible example, then compare it with the 3.3.2 Hidden on Detail Views example, and the difference is clear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンのビューアに入ったら `.toolbar(.hidden, for: .tabBar)` でタブバーを隠す。タブバーが占めていた場所は写真に戻り、ビューアから戻ると元のリストとタブバーがそのまま戻ってくる。アプリの 3.3.1 Always Visible の例でデフォルトの動作を確かめ、3.3.2 Hidden on Detail Views の例と比べると違いがはっきりする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入全屏查看器后，用 `.toolbar(.hidden, for: .tabBar)` 隐藏标签栏。标签栏占的位置还给了照片，从查看器返回时，原来的列表和标签栏也原样回来。先看应用的 3.3.1 Always Visible 示例里的默认行为，再与 3.3.2 Hidden on Detail Views 示例比较，差别就很清楚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入全螢幕檢視器後，用 `.toolbar(.hidden, for: .tabBar)` 隱藏標籤列。標籤列佔的位置還給了照片，從檢視器返回時，原來的列表和標籤列也原樣回來。先看應用程式的 3.3.1 Always Visible 示例裡的預設行為，再與 3.3.2 Hidden on Detail Views 示例比較，差別就很清楚。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При входе в полноэкранный просмотрщик скройте панель вкладок через `.toolbar(.hidden, for: .tabBar)`. Место, которое занимала панель вкладок, возвращается фото, а когда вы выходите из просмотрщика, исходный список и панель вкладок возвращаются как были. Посмотрите поведение по умолчанию в примере приложения 3.3.1 Always Visible, затем сравните с 3.3.2 Hidden on Detail Views, и разница ясна."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al entrar en el visor a pantalla completa, oculta la barra de pestañas con `.toolbar(.hidden, for: .tabBar)`. El espacio que ocupaba la barra de pestañas vuelve a la foto, y cuando sales del visor, la lista original y la barra de pestañas regresan como estaban. Mira el comportamiento por defecto en el ejemplo 3.3.1 Always Visible de la app y luego compáralo con el ejemplo 3.3.2 Hidden on Detail Views, y la diferencia es clara."
          }
        }
      }
    },
    "전체 화면 커버는 **무게가 가장 무거운 모달**이다. 온보딩이나 로그인처럼 끝내거나 명시적으로 나가야 하는 흐름, 화면 전부가 콘텐츠인 영상 재생을 위해 시스템이 따로 떼어 둔 형식이다. 질문 하나를 위해 그 무게를 쓰면 화면 대부분은 빈 공간이 되고, 판단에 필요한 맥락(지우려는 항목)은 가려진다. 강조하려던 것이 오히려 흐려졌다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover is **the heaviest modal there is**. It's a format the system sets aside for flows you have to finish or explicitly exit, like onboarding or sign-in, and for video playback where the whole screen is content. Use that weight for a single question and most of the screen becomes empty space, while the context needed to decide (the item being deleted) gets hidden. What was meant to stand out ends up blurred."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover is **the heaviest modal there is**. It's a format the system sets aside for flows you have to finish or explicitly exit, like onboarding or sign-in, and for video playback where the whole screen is content. Use that weight for a single question and most of the screen becomes empty space, while the context needed to decide (the item being deleted) gets hidden. What was meant to stand out ends up blurred."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーは**最も重いモーダル**だ。オンボーディングやログインのように完了するか明示的に抜けなければならないフローや、画面のすべてがコンテンツである動画再生のために、システムが別に取っておいた形式だ。質問ひとつのためにその重さを使うと、画面の大部分は空白になり、判断に必要な文脈（削除しようとしている項目）は隠れてしまう。強調するつもりのものが、かえってぼやけた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏覆盖是**分量最重的模态**。系统把它单独分出来，是为引导、登录这类必须完成或明确退出的流程，以及整个界面都是内容的视频播放。为了一个问题动用这个分量，界面大部分是空白，判断所需的上下文（要删的项目）反而被遮住。本想强调的东西反倒模糊了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕覆蓋是**分量最重的模態**。系統把它單獨分出來，是為引導、登入這類必須完成或明確退出的流程，以及整個介面都是內容的影片播放。為了一個問題動用這個分量，介面大部分是空白，判斷所需的上下文（要刪的項目）反而被遮住。本想強調的東西反倒模糊了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноэкранное покрытие - **самое тяжёлое модальное окно из существующих**. Это формат, который система отводит для процессов, которые нужно завершить или явно покинуть, вроде онбординга или входа, и для воспроизведения видео, где содержимое - весь экран. Потратите этот вес на один вопрос, и большая часть экрана пустеет, а контекст, нужный для решения (удаляемый элемент), оказывается скрыт. То, что должно было выделяться, размывается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cubierta a pantalla completa es **el modal más pesado que existe**. Es un formato que el sistema reserva para flujos que hay que terminar o abandonar explícitamente, como la bienvenida o el inicio de sesión, y para la reproducción de vídeo donde toda la pantalla es contenido. Gasta ese peso en una sola pregunta y la mayor parte de la pantalla se queda en espacio vacío, mientras el contexto necesario para decidir (el elemento que se elimina) queda oculto. Lo que debía destacar acaba difuminado."
          }
        }
      }
    },
    "전체 화면 커버는 스와이프로 닫히지 않는다. 출구를 직접 만든다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe. Build the exit yourself."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe. Build the exit yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーはスワイプでは閉じない。出口は自分で作る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏覆盖不能用滑动关闭。出口要自己做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕覆蓋不能用滑動關閉。出口要自己做。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноэкранное покрытие не закрывается смахиванием. Выход постройте сами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cubierta a pantalla completa no se cierra deslizando. Construye tú mismo la salida."
          }
        }
      }
    },
    "전체 화면을 덮는 코드를 쓸 때는 그 자리에서 닫기 버튼까지 함께 쓴다. 여는 코드보다 **닫는 코드를 먼저** 쓴다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you write the code that covers the full screen, write the close button right there with it. Write **the closing code first**, before the opening code."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you write the code that covers the full screen, write the close button right there with it. Write **the closing code first**, before the opening code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面全体を覆うコードを書くときは、その場で閉じるボタンまで一緒に書く。開くコードより**閉じるコードを先に**書く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写覆盖整个屏幕的代码时，在那个位置把关闭按钮一并写出来。**先写关闭的代码，再写打开的代码。**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫覆蓋整個螢幕的程式碼時，在那個位置把關閉按鈕一併寫出來。**先寫關閉的程式碼，再寫開啟的程式碼。**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда пишете код, закрывающий весь экран, сразу же пишите там и кнопку закрытия. Пишите **сначала код закрытия**, до кода открытия."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando escribas el código que cubre toda la pantalla, escribe ahí mismo el botón de cierre. Escribe **primero el código de cierre**, antes que el de apertura."
          }
        }
      }
    },
    "전체화면 미디어 뷰어에서까지 유지": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping it even in a full-screen media viewer"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping it even in a full-screen media viewer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンのメディアビューアでも表示したまま"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连全屏媒体查看器也保留"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連全螢幕媒體檢視器也保留"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение даже в полноэкранном просмотрщике медиа"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerla incluso en un visor de medios a pantalla completa"
          }
        }
      }
    },
    "전체화면 미디어 뷰어에서도 탭바를 유지한다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping the tab bar in a full-screen media viewer"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping the tab bar in a full-screen media viewer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンのメディアビューアでもタブバーを表示したままにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连全屏媒体查看器也保留标签栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連全螢幕媒體檢視器也保留標籤列"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение панели вкладок в полноэкранном просмотрщике медиа"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la barra de pestañas en un visor de medios a pantalla completa"
          }
        }
      }
    },
    "전환마다 복원 동작 필요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every switch needs a restore"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Every switch needs a restore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えのたびに元に戻す操作が必要になる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次转场都需要恢复动作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次轉場都需要恢復動作"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждому переключателю нужно восстановление"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo cambio necesita una restauración"
          }
        }
      }
    },
    "전환은 **“이 화면이 어디서 왔는가”에 대한 답**입니다, 출처가 의미 없으면 standard(아래에서), 탭한 요소가 곧 열리는 내용이면 zoom(그 자리에서 확대).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transition is **the answer to “where did this screen come from?”** If the origin carries no meaning, use standard (from the bottom); if the tapped element is itself what opens, use zoom (expanding in place)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A transition is **the answer to “where did this screen come from?”** If the origin carries no meaning, use standard (from the bottom); if the tapped element is itself what opens, use zoom (expanding in place)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジションは「**この画面はどこから来たのか」への答え**です。出どころに意味がなければstandard（下から）、タップした要素がそのまま開く内容ならzoom（その場で拡大）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转场是**对“这个界面从哪里来”的回答**：来源没有意义就用 standard（从下方），被点按的元素就是要打开的内容，则用 zoom（就地放大）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉場是**對「這個介面從哪裡來」的回答**：來源沒有意義就用 standard（從下方），被輕點的元素就是要開啟的內容，則用 zoom（就地放大）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход - это **ответ на вопрос «откуда взялся этот экран?»**. Если источник ничего не значит, используйте стандартный (снизу); если сам нажатый элемент и есть то, что открывается, используйте zoom (раскрытие на месте)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transición es **la respuesta a «¿de dónde vino esta pantalla?»** Si el origen no tiene significado, usa standard (desde abajo); si el propio elemento tocado es lo que se abre, usa zoom (expandiéndose en su sitio)."
          }
        }
      }
    },
    "전환을 검토할 때 여는 쪽만큼 **닫는 쪽을 한 번 더** 본다. 끝난 자리가 시작한 자리와 같은지.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When reviewing a transition, look at **the closing side one more time**, just as carefully as the opening. Does it end where it started?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When reviewing a transition, look at **the closing side one more time**, just as carefully as the opening. Does it end where it started?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジションを見直すときは、開く側と同じくらい**閉じる側をもう一度**見る。終わった場所が始まった場所と同じかどうか。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审视转场时，除了打开一侧，**再看一遍关闭一侧**。结束的位置是不是和开始的位置一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審視轉場時，除了開啟一側，**再看一遍關閉一側**。結束的位置是不是和開始的位置一樣。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяя переход, **ещё раз взгляните на закрывающую сторону**, так же внимательно, как на открывающую. Заканчивается ли он там, где начался?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al revisar una transición, mira **el lado del cierre una vez más**, con el mismo cuidado que la apertura. ¿Termina donde empezó?"
          }
        }
      }
    },
    "전환을 고르기 전에 묻는다. **\"이 화면은 어디서 왔는가?\"** 답이 화면 위의 특정 요소라면 그 요소에서 열리게 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before choosing a transition, ask: **\"Where did this screen come from?\"** If the answer is a specific element on screen, make it open from that element."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before choosing a transition, ask: **\"Where did this screen come from?\"** If the answer is a specific element on screen, make it open from that element."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジションを選ぶ前に問う。**「この画面はどこから来たのか**」答えが画面上の特定の要素なら、その要素から開くようにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选转场之前先问：**“这个界面是从哪里来的？”**答案是界面上的某个特定元素，就让它从那个元素打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選轉場之前先問：**「這個介面是從哪裡來的？」**答案是介面上的某個特定元素，就讓它從那個元素開啟。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирая переход, спросите: **«Откуда взялся этот экран?»** Если ответ - определённый элемент на экране, пусть он открывается из этого элемента."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de elegir una transición, pregunta: **«¿De dónde vino esta pantalla?»** Si la respuesta es un elemento concreto de la pantalla, haz que se abra desde ese elemento."
          }
        }
      }
    },
    "전환을 만들 때 관심은 여는 순간에 쏠린다. 확대로 열리는 모습을 몇 번이고 다듬는다. 닫는 쪽은 한 번 보고 넘어가는 순간이라 기본 동작이나 간단한 사라짐으로 둬도 충분해 보인다. 확대 애니메이션을 직접 구현하다 보니 되돌아가는 경로까지는 손이 가지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When building a transition, attention goes to the moment it opens. You polish the zoom-in again and again. Closing is a moment people glance at and move past, so a default behavior or a simple fade seems good enough. Having built the zoom animation by hand, you never get around to the return path."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When building a transition, attention goes to the moment it opens. You polish the zoom-in again and again. Closing is a moment people glance at and move past, so a default behaviour or a simple fade seems good enough. Having built the zoom animation by hand, you never get around to the return path."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジションを作るとき、関心は開く瞬間に集中する。拡大して開く様子を何度も磨き上げる。閉じる側は一度見て通り過ぎる瞬間なので、デフォルトの動作や単純に消えるだけで十分に思える。拡大アニメーションを自前で実装しているうちに、戻る経路にまでは手が回らない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做转场时，注意力集中在打开的那一刻。放大打开的样子被反复打磨。关闭一侧只是看一眼就过去的瞬间，用默认行为或简单的消失似乎就够了。自己实现放大动画，就顾不上返回的路径了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做轉場時，注意力集中在開啟的那一刻。放大開啟的樣子被反覆打磨。關閉一側只是看一眼就過去的瞬間，用預設行為或簡單的消失似乎就夠了。自己實作放大動畫，就顧不上返回的路徑了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы строите переход, внимание уходит на момент открытия. Вы снова и снова шлифуете увеличение. Закрытие - момент, на который люди бросают взгляд и идут дальше, поэтому поведение по умолчанию или простое затухание кажется достаточным. Сделав анимацию zoom вручную, вы так и не добираетесь до обратного пути."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al construir una transición, la atención va al momento en que se abre. Pules el zoom de entrada una y otra vez. Cerrar es un momento al que la gente echa un vistazo y pasa de largo, así que un comportamiento por defecto o un simple fundido parece suficiente. Habiendo construido a mano la animación de zoom, nunca llegas al camino de vuelta."
          }
        }
      }
    },
    "절반 높이 시트 안에 입력 칸이 열 개 넘는 폼이 들어 있다. 폼을 스크롤하려고 손가락을 올리면 시트가 커지고, 내리면 폼 대신 시트가 닫히려 한다. 입력 칸을 누르면 키보드가 올라오면서 시트가 갑자기 커진다. 사용자는 지금 움직이는 것이 폼인지 시트인지 매번 확인해야 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A half-height sheet contains a form with more than ten input fields. When you swipe up to scroll the form, the sheet grows; when you swipe down, the sheet tries to close instead of the form scrolling. Tapping an input field brings up the keyboard and the sheet suddenly expands. Users have to check every time whether what's moving is the form or the sheet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A half-height sheet contains a form with more than ten input fields. When you swipe up to scroll the form, the sheet grows; when you swipe down, the sheet tries to close instead of the form scrolling. Tapping an input field brings up the keyboard and the sheet suddenly expands. Users have to check every time whether what's moving is the form or the sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分の高さのシートの中に、入力欄が10個を超えるフォームが入っている。フォームをスクロールしようと指を上げるとシートが大きくなり、下げるとフォームではなくシートが閉じようとする。入力欄をタップするとキーボードが上がってきて、シートが急に大きくなる。ユーザーは今動いているのがフォームなのかシートなのかを毎回確かめなければならない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半屏高度的弹层里装着一个有十几个输入框的表单。想滚动表单而把手指向上，弹层变大；向下，弹层而不是表单想要关闭。点输入框，键盘升起，弹层突然变大。用户每次都得确认，现在在动的是表单还是弹层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半螢幕高度的工作表裡裝著一個有十幾個輸入框的表單。想滾動表單而把手指向上，工作表變大；向下，工作表而不是表單想要關閉。點輸入框，鍵盤升起，工作表突然變大。使用者每次都得確認，現在在動的是表單還是工作表。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В шторке половинной высоты форма с более чем десятью полями ввода. Когда вы смахиваете вверх, чтобы прокрутить форму, шторка вырастает; когда смахиваете вниз, шторка пытается закрыться вместо прокрутки формы. Нажатие на поле ввода вызывает клавиатуру, и шторка внезапно разворачивается. Пользователям каждый раз приходится проверять, что движется: форма или шторка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja de media altura contiene un formulario con más de diez campos de entrada. Cuando deslizas hacia arriba para desplazar el formulario, la hoja crece; cuando deslizas hacia abajo, la hoja intenta cerrarse en lugar de desplazarse el formulario. Al tocar un campo de entrada aparece el teclado y la hoja se expande de repente. Los usuarios tienen que comprobar cada vez si lo que se mueve es el formulario o la hoja."
          }
        }
      }
    },
    "절반 높이는 **“원본과의 대화”** 은유, 화면을 나눠 가짐으로써 시트가 배경 콘텐츠에 대한 것임을 형태로 말합니다. 지도 앱이 만든 패턴을 시스템 detent로 표준화한 것.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half height is the metaphor of **\"a conversation with the original.\"** By sharing the screen, the sheet's shape itself says it's about the content behind it. It turns a pattern the Maps app pioneered into a standard system detent."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Half height is the metaphor of **\"a conversation with the original.\"** By sharing the screen, the sheet's shape itself says it's about the content behind it. It turns a pattern the Maps app pioneered into a standard system detent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分の高さは「**元の画面との対話**」の比喩。画面を分け合うことで、シートが背後のコンテンツについてのものだと形で語ります。マップアプリが生んだパターンを、システムのデタントとして標準化したもの。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半屏高度是**“与原件对话”**的隐喻：通过平分屏幕，用形态说明这个弹层是关于背景内容的。这是把地图应用创造的模式，标准化成了系统 detent。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半螢幕高度是**「與原件對話」**的隱喻：透過平分螢幕，用形態說明這個工作表是關於背景內容的。這是把地圖應用程式創造的模式，標準化成了系統 detent。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Половинная высота - метафора **«разговора с оригиналом»**. Делясь экраном, сама форма шторки говорит, что речь о содержимом позади. Это превращает паттерн, который впервые применили Карты, в стандартный системный detent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La media altura es la metáfora de **«una conversación con el original».** Al compartir la pantalla, la propia forma de la hoja dice que trata del contenido de detrás. Convierte un patrón que abrió la app Mapas en un detent estándar del sistema."
          }
        }
      }
    },
    "절반 높이로 충분한 옵션·공유류 시트": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Option and share sheets where half height is enough"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Option and share sheets where half height is enough"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分の高さで足りるオプションや共有のシート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半屏高度就够的选项、分享类弹层"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "半螢幕高度就夠的選項、分享類工作表"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шторки с опциями и «Поделиться», где достаточно половины высоты"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hojas de opciones y de compartir donde basta con la media altura"
          }
        }
      }
    },
    "절반 이하로 줄여야 들어간다면 축소가 아니라 설계 문제. 폭을 늘리거나 표기를 줄이는(1,234,000 → 1.2M) 게 정답": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it only fits at less than half size, that's a design problem, not a scaling one. The right answer is to widen the space or shorten the notation (1,234,000 → 1.2M)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If it only fits at less than half size, that's a design problem, not a scaling one. The right answer is to widen the space or shorten the notation (1,234,000 → 1.2M)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分以下に縮めないと収まらないなら、それは縮小ではなく設計の問題。幅を広げるか、表記を短くする（1,234,000 → 1.2M）のが正解"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果必须缩小到一半以下才放得下，那不是缩小而是设计问题。增加宽度或缩短写法（1,234,000 → 1.2M）才是正解"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果必須縮小到一半以下才放得下，那不是縮小而是設計問題。增加寬度或縮短寫法（1,234,000 → 1.2M）才是正解"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если оно помещается лишь при размере меньше половины, это проблема дизайна, а не масштабирования. Верный ответ - расширить место или сократить запись (1 234 000 → 1,2 млн)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si solo cabe a menos de la mitad de tamaño, eso es un problema de diseño, no de escalado. La respuesta correcta es ampliar el espacio o acortar la notación (1.234.000 → 1,2 M)"
          }
        }
      }
    },
    "절반 이하로 줄여야 들어간다면 축소가 아니라 설계 문제다. 폭을 늘리거나 표기를 줄인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If text has to shrink to less than half to fit, that's not a scaling problem but a design problem. Widen the space or shorten the notation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If text has to shrink to less than half to fit, that's not a scaling problem but a design problem. Widen the space or shorten the notation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分以下に縮めないと収まらないなら、それは縮小ではなく設計の問題だ。幅を広げるか、表記を短くする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果必须缩小到一半以下才放得下，那不是缩小而是设计问题。增加宽度或缩短写法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果必須縮小到一半以下才放得下，那不是縮小而是設計問題。增加寬度或縮短寫法。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если для вмещения текст приходится сжимать меньше чем вдвое, это не проблема масштабирования, а проблема дизайна. Расширьте место или сократите запись."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el texto tiene que encogerse a menos de la mitad para caber, no es un problema de escalado sino de diseño. Amplía el espacio o acorta la notación."
          }
        }
      }
    },
    "접근성 큰 글씨 설정에서 1줄 고정+축소가 겹쳐 사실상 판독 불가": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At large accessibility text sizes, a fixed single line plus scaling combine to make the text practically unreadable"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "At large accessibility text sizes, a fixed single line plus scaling combine to make the text practically unreadable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの大きな文字サイズで、1行固定と縮小が重なり事実上読めない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在无障碍大字号设置下，1 行固定 + 缩小叠加，实际上无法辨认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在無障礙大字號設定下，1 行固定 + 縮小疊加，實際上無法辨認"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При крупных размерах текста для универсального доступа фиксированная одна строка вместе с масштабированием делают текст практически нечитаемым"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tamaños grandes de texto de accesibilidad, una sola línea fija más el escalado se combinan para dejar el texto prácticamente ilegible"
          }
        }
      }
    },
    "접기는 시스템이 최소 터치 크기를 지키는 방식이다. 막을 대상이 아니다. **무엇이 접혀도 되는지를 먼저 정하고**, 그 답을 순서로 적는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folding is how the system protects the minimum touch size. It's not something to prevent. **Decide first what's OK to fold away**, then write that answer as the order."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Folding is how the system protects the minimum touch size. It's not something to prevent. **Decide first what's OK to fold away**, then write that answer as the order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみは、システムが最小タッチサイズを守るための方法だ。防ぐべきものではない。**何が折りたたまれてもいいかを先に決め**、その答えを順番として書く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠是系统守住最小触控尺寸的方式，不是该阻止的对象。**先定下什么可以被折叠**，再把答案写成顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊是系統守住最小觸控尺寸的方式，不是該阻止的物件。**先定下什麼可以被摺疊**，再把答案寫成順序。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сворачивание - способ, которым система защищает минимальный размер касания. Его не нужно предотвращать. **Сначала решите, что можно свернуть**, затем запишите этот ответ порядком."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plegar es la forma en que el sistema protege el tamaño táctil mínimo. No es algo que haya que impedir. **Decide primero qué no importa plegar**, y luego escribe esa respuesta como el orden."
          }
        }
      }
    },
    "접히면 잘림": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It gets clipped when collapsed"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It gets clipped when collapsed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたむと切れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一折叠就被截断"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一折疊就被截斷"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезается при сворачивании"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recorta al colapsar"
          }
        }
      }
    },
    "접히면 탭바 자리로 ↓": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves into the tab bar's spot when collapsed ↓"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves into the tab bar's spot when collapsed ↓"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたむとタブバーの位置へ↓"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠时落到标签栏的位置 ↓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊時落到標籤列的位置 ↓"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сворачивании переходит на место панели вкладок ↓"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa al sitio de la barra de pestañas al colapsar ↓"
          }
        }
      }
    },
    "접힌 곳에서도 길을 잃는다. 두 단계를 넘으면 화면으로 꺼낸다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People get lost even in collapsed places. Past two levels, bring it out onto a screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "People get lost even in collapsed places. Past two levels, bring it out onto a screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれた場所でも道に迷う。2段階を超えたら、画面に出す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠起来的地方也会迷路。超过两层，就拿出来做成界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊起來的地方也會迷路。超過兩層，就拿出來做成介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди теряются даже в свёрнутых местах. Глубже двух уровней выносите это на экран."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La gente se pierde incluso en los sitios plegados. Pasados dos niveles, llévalo a una pantalla."
          }
        }
      }
    },
    "접힘(탭바)과 잔류(검색)의 역할 분리, 소비 중에는 이동이 덜 필요하지만 **검색은 소비 중에 오히려 촉발**되기 때문. 두 API가 직교로 설계되어 조합이 자연스럽게 성립합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A split of roles between collapsing (tab bar) and staying (search): while consuming, you need to navigate less, but **search is actually triggered by consuming**. The two APIs are designed to be orthogonal, so combining them just works."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A split of roles between collapsing (tab bar) and staying (search): while consuming, you need to navigate less, but **search is actually triggered by consuming**. The two APIs are designed to be orthogonal, so combining them just works."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみ（タブバー）と残留（検索）の役割分担。消費中は移動の必要が減るが、**検索はむしろ消費中にこそ生まれる**から。2つのAPIは直交するように設計されているので、組み合わせが自然に成り立ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠（标签栏）与保留（搜索）的角色分离：阅读期间不太需要导航，但**搜索反而是在阅读期间被触发的**。两个 API 被设计成正交，所以组合自然成立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊（標籤列）與保留（搜尋）的角色分離：閱讀期間不太需要導覽，但**搜尋反而是在閱讀期間被觸發的**。兩個 API 被設計成正交，所以組合自然成立。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделение ролей между сворачиваемым (панель вкладок) и остающимся (поиск): пока вы потребляете, навигировать нужно меньше, но **поиск как раз запускается потреблением**. Два API задуманы ортогональными, поэтому их сочетание просто работает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reparto de funciones entre colapsar (barra de pestañas) y quedarse (búsqueda): al consumir, necesitas navegar menos, pero **la búsqueda se dispara justo al consumir**. Las dos API están diseñadas para ser ortogonales, así que combinarlas simplemente funciona."
          }
        }
      }
    },
    "접힘/복원만 어수선": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The collapsing and restoring is just clutter"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The collapsing and restoring is just clutter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみと復元が煩わしいだけ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有折叠 / 恢复让人觉得杂乱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有摺疊 / 恢復讓人覺得雜亂"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сворачивание и восстановление - лишь помеха"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El colapso y la restauración son solo desorden"
          }
        }
      }
    },
    "접힘·복원이 반복되면 동작만 남고 이득이 없다. 긴 읽기 화면에만 켠다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If collapsing and restoring keep repeating, all that's left is motion with no benefit. Turn it on only for long reading screens."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If collapsing and restoring keep repeating, all that's left is motion with no benefit. Turn it on only for long reading screens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみと復元が繰り返されると、動きだけが残って得るものがない。長く読む画面にだけオンにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠、恢复反复发生，就只剩动作而没有收益。只在长阅读界面里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊、恢復反覆發生，就只剩動作而沒有收益。只在長閱讀介面裡開啟。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сворачивание и восстановление повторяются снова и снова, остаётся только движение без пользы. Включайте его только на экранах длинного чтения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el colapso y la restauración se repiten sin parar, solo queda movimiento sin beneficio. Actívalo solo para pantallas de lectura larga."
          }
        }
      }
    },
    "정렬 기준과 방향은 서브메뉴 하나 안에 Picker로 넣어 현재 값에 체크가 보이게 한다. 한 번 열면 지금 무엇으로 정렬돼 있는지 보이고 바로 바꿀 수 있다. 나머지 보기 옵션이 계속 늘어난다면 메뉴에서 꺼내 시트나 화면으로 승격한다. 메뉴에는 관련 액션끼리 섹션으로 나눈 한두 단계만 남는다. 앱의 7.1.1 Menu Configurations 예제에서 서브메뉴와 Picker가 들어간 메뉴를 열어 볼 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the sort key and direction in a single submenu as a Picker, so the current value shows a checkmark. Open it once, and you can see what it's currently sorted by and change it right away. If the other view options keep growing, take them out of the menu and promote them to a sheet or a screen. The menu keeps only one or two levels, with related actions grouped into sections. In the app's 7.1.1 Menu Configurations example, you can open a menu that contains a submenu and a Picker."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the sort key and direction in a single submenu as a Picker, so the current value shows a checkmark. Open it once, and you can see what it's currently sorted by and change it right away. If the other view options keep growing, take them out of the menu and promote them to a sheet or a screen. The menu keeps only one or two levels, with related actions grouped into sections. In the app's 7.1.1 Menu Configurations example, you can open a menu that contains a submenu and a Picker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替えの基準と方向は、1つのサブメニューの中にPickerとして入れ、現在の値にチェックが付くようにする。一度開けば、今何で並んでいるかが見えて、すぐに変えられる。ほかの表示オプションが増え続けるなら、メニューから出してシートや画面に格上げする。メニューには、関連するアクションをセクションで分けた1〜2段だけが残る。アプリの7.1.1 Menu Configurationsの例で、サブメニューとPickerが入ったメニューを開いてみられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序依据和方向放进一个子菜单里的 Picker，让当前值上能看到勾选。打开一次，就能看到现在按什么排序，并能立刻更改。其余显示选项如果不断增加，就从菜单里拿出来，升格成弹层或界面。菜单里只留按相关操作分区的一两层。在应用的 7.1.1 Menu Configurations 示例里，可以打开带子菜单和 Picker 的菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排序依據和方向放進一個子選單裡的 Picker，讓當前值上能看到勾選。開啟一次，就能看到現在按什麼排序，並能立刻更改。其餘顯示選項如果不斷增加，就從選單裡拿出來，升格成工作表或介面。選單裡只留按相關操作分割槽的一兩層。在應用程式的 7.1.1 Menu Configurations 示例裡，可以開啟帶子選單和 Picker 的選單。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите ключ и направление сортировки в одно подменю как Picker, чтобы текущее значение отмечалось галочкой. Откройте его один раз, и увидите, как отсортировано сейчас, и сразу сможете изменить. Если остальные параметры вида продолжают расти, вынесите их из меню и поднимите до шторки или экрана. В меню остаётся один-два уровня, связанные действия сгруппированы в секции. В примере приложения 7.1.1 Menu Configurations можно открыть меню с подменю и Picker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon la clave y la dirección de ordenación en un único submenú como un Picker, para que el valor actual muestre una marca de verificación. Ábrelo una vez y verás por qué criterio está ordenado ahora y podrás cambiarlo enseguida. Si las demás opciones de vista siguen creciendo, sácalas del menú y asciéndelas a una hoja o a una pantalla. El menú se queda con uno o dos niveles, con las acciones relacionadas agrupadas en secciones. En el ejemplo 7.1.1 Menu Configurations de la app puedes abrir un menú que contiene un submenú y un Picker."
          }
        }
      }
    },
    "정렬 기준을 Picker로 넣어 현재 값에 체크 표시": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sort criterion added as a Picker, with a checkmark on the current value"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sort criterion added as a Picker, with a checkmark on the current value"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替えの基準をPickerで入れ、現在の値にチェックマーク"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把排序依据做成 Picker，在当前值上打勾"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把排序依據做成 Picker，在當前值上打勾"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Критерий сортировки, добавленный как Picker, с галочкой на текущем значении"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un criterio de ordenación añadido como Picker, con una marca de verificación en el valor actual"
          }
        }
      }
    },
    "정렬·공유·설정·삭제를 한 유리 캡슐에 붙이면 사용자는 \"한 세트\"로 읽음. 묶음이 거짓 정보가 되어 인지 부담 증가": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach Sort, Share, Settings and Delete to one glass capsule and users read them as \"one set.\" The grouping becomes false information and adds cognitive load"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach Sort, Share, Settings and Delete to one glass capsule and users read them as \"one set.\" The grouping becomes false information and adds cognitive load"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替え・共有・設定・削除をひとつのガラスカプセルにまとめると、ユーザーは「ひとつのセット」として読む。まとまりが偽の情報になり、認知負荷が増える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把排序 · 分享 · 设置 · 删除贴进同一个玻璃胶囊，用户会读成“一组”。分组成了假信息，认知负担增加"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把排序 · 分享 · 設定 · 刪除貼進同一個玻璃膠囊，使用者會讀成「一組」。分組成了假資訊，認知負擔增加"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикрепите «Сортировку», «Поделиться», «Настройки» и «Удалить» к одной стеклянной капсуле, и пользователи прочтут их как «один набор». Группировка превращается в ложную информацию и добавляет когнитивную нагрузку"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Une Ordenar, Compartir, Ajustes y Eliminar a una cápsula de cristal y los usuarios los leerán como «un conjunto». La agrupación se convierte en información falsa y añade carga cognitiva"
          }
        }
      }
    },
    "정보 구조상 6개가 불가피할 때 시스템의 자동 축약을 수용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting the system's automatic condensing when six is truly unavoidable in the information architecture"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting the system's automatic condensing when six is truly unavoidable in the information architecture"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報構造上6個が避けられないとき、システムによる自動の集約を受け入れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息结构上 6 个不可避免时，接受系统的自动缩减"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資訊結構上 6 個不可避免時，接受系統的自動縮減"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согласие с автоматическим сжатием системой, когда шесть элементов действительно неизбежны в информационной архитектуре"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar el plegado automático del sistema cuando seis es realmente inevitable en la arquitectura de la información"
          }
        }
      }
    },
    "정작 필요한 끝이 잘림": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The very part you need gets cut"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The very part you need gets cut"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肝心の末尾が切れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真正需要的末尾被截掉了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "真正需要的末尾被截掉了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезается именно то, что нужно"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se corta justo la parte que necesitas"
          }
        }
      }
    },
    "정중앙은 가장 잘 보이는 자리다. 가장 잘 보이는 자리에 가장 누르게 하고 싶은 버튼을 두는 것은 당연해 보인다. 제목은 이전 화면에서 이미 봤으니 없어도 될 것 같다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The center is the most visible spot. Putting the button you most want people to tap in the most visible spot seems obvious. The title was already shown on the previous screen, so dropping it seems fine."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The centre is the most visible spot. Putting the button you most want people to tap in the most visible spot seems obvious. The title was already shown on the previous screen, so dropping it seems fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "真ん中はいちばんよく見える場所だ。いちばんよく見える場所に、いちばん押してほしいボタンを置くのは当然に思える。タイトルは前の画面ですでに見たから、なくてもよさそうだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正中间是最显眼的位置。把最想让人点的按钮放在最显眼的位置，似乎理所当然。标题在上一个界面已经看过了，没有也行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正中間是最顯眼的位置。把最想讓人點的按鈕放在最顯眼的位置，似乎理所當然。標題在上一個介面已經看過了，沒有也行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Центр - самое заметное место. Поставить в самое заметное место кнопку, которую больше всего хочется заставить нажимать, кажется очевидным. Заголовок уже был показан на предыдущем экране, так что убрать его кажется нормальным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro es el sitio más visible. Poner el botón que más quieres que la gente toque en el sitio más visible parece obvio. El título ya se mostró en la pantalla anterior, así que quitarlo parece bien."
          }
        }
      }
    },
    "정확한 숫자를 보여 주는 편이 정직해 보인다. 99+로 접으면 뭔가를 숨기는 것 같고, 128개와 1,280개는 다른 이야기처럼 느껴진다. 테스트 데이터가 한 자리 수였다면 긴 숫자가 어떻게 보이는지 볼 기회도 없었을 것이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the exact number feels more honest. Collapsing it to 99+ feels like hiding something, and 128 versus 1,280 feels like a different story. If the test data had single-digit counts, there was never a chance to see how a long number looks."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the exact number feels more honest. Collapsing it to 99+ feels like hiding something, and 128 versus 1,280 feels like a different story. If the test data had single-digit counts, there was never a chance to see how a long number looks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確な数字を見せるほうが誠実に見える。99+にまとめると何かを隠しているようだし、128件と1,280件は別の話のように感じられる。テストデータが1桁だったなら、長い数字がどう見えるかを確かめる機会もなかっただろう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示精确的数字，看起来更诚实。折成 99+ 好像在隐瞒什么，128 个和 1,280 个像是不同的故事。如果测试数据只是个位数，就连看长数字什么样的机会都没有。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示精確的數字，看起來更誠實。折成 99+ 好像在隱瞞什麼，128 個和 1,280 個像是不同的故事。如果測試資料只是個位數，就連看長數字什麼樣的機會都沒有。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показ точного числа кажется честнее. Свернуть до 99+ похоже на сокрытие чего-то, а 128 и 1 280 кажутся разными историями. Если в тестовых данных были однозначные числа, возможности увидеть, как выглядит длинное число, не было вовсе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar el número exacto parece más honesto. Colapsarlo a 99+ parece ocultar algo, y 128 frente a 1.280 parecen historias distintas. Si los datos de prueba tenían recuentos de una cifra, nunca hubo ocasión de ver cómo se ve un número largo."
          }
        }
      }
    },
    "정확한 숫자를 알려주는 게 정직해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the exact number feels honest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the exact number feels honest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確な数字を知らせるのが誠実に見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉人精确的数字，看起来更诚实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴人精確的數字，看起來更誠實。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показ точного числа кажется честным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar el número exacto parece honesto."
          }
        }
      }
    },
    "제목": {
      "extractionState": "manual",
      "localizations": {
