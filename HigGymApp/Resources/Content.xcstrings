          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ขนาดชื่อเรื่องเดียวกันทุกหน้าจอโดยไม่คำนึงถึงความลึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng cùng cỡ tiêu đề trên mọi màn hình bất kể độ sâu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stejná velikost nadpisu na každé obrazovce bez ohledu na hloubku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At bruge samme titelstørrelse på alle skærme uanset dybde"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήση του ίδιου μεγέθους τίτλου σε κάθε οθόνη ανεξαρτήτως βάθους"
          }
        }
      }
    },
    "깔끔함을 위해 무언가를 지우기 전에 묻는다. \"이건 장식인가, 정보인가?\" 지웠을 때 사용자가 모르게 되는 것이 있다면 정보다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before removing something for the sake of cleanliness, ask: \"Is this decoration or information?\" If removing it leaves people not knowing something, it's information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before removing something for the sake of cleanliness, ask: \"Is this decoration or information?\" If removing it leaves people not knowing something, it's information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すっきりさせるために何かを消す前に問う。「これは飾りか、情報か？」 消したときにユーザーが分からなくなることがあるなら、それは情報だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了整洁要删什么之前先问：“这是装饰，还是信息？”删掉之后用户会有不知道的事，那就是信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了整潔要刪什麼之前先問：「這是裝飾，還是資訊？」刪掉之後使用者會有不知道的事，那就是資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем что-то убирать ради аккуратности, спросите: «Это украшение или информация?» Если после удаления люди чего-то не знают, это информация."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de quitar algo por limpieza, pregunta: «¿Esto es decoración o información?» Si quitarlo deja a la gente sin saber algo, es información."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du etwas der Sauberkeit halber entfernst, frage: „Ist das Dekoration oder Information?“ Wüssten Menschen nach dem Entfernen etwas nicht mehr, ist es Information."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de retirer quelque chose par souci de propreté, demandez : « Est-ce de la décoration ou de l'information ? » Si le retirer laisse les gens sans savoir quelque chose, c'est de l'information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di togliere qualcosa per pulizia, chiediti: «È decorazione o informazione?» Se toglierlo lascia le persone senza sapere qualcosa, è informazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de remover algo por limpeza, pergunte: «Isto é decoração ou informação?» Se removê-lo deixa as pessoas sem saber algo, é informação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนเอาอะไรออกเพื่อความเรียบร้อย ให้ถาม: \"นี่คือการตกแต่งหรือข้อมูล\" ถ้าเอาออกแล้วคนไม่รู้บางอย่าง มันคือข้อมูล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi bỏ thứ gì cho gọn, hãy hỏi: \"Đây là trang trí hay thông tin?\" Nếu bỏ đi khiến người ta không biết điều gì đó, nó là thông tin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než něco odstraníte kvůli čistotě, zeptejte se: „Je to dekorace, nebo informace?“ Pokud odstranění nechá lidi nevědět o něčem, je to informace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du fjerner noget for renhedens skyld, så spørg: »Er det dekoration eller information?« Hvis det at fjerne det efterlader folk uden at vide noget, er det information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν αφαιρέσεις κάτι για χάρη της καθαρότητας, ρώτα: «Είναι διακόσμηση ή πληροφορία;» Αν η αφαίρεσή του αφήνει τους ανθρώπους χωρίς να γνωρίζουν κάτι, είναι πληροφορία."
          }
        }
      }
    },
    "끈 상태로 다크모드·가로모드·큰 글씨 설정까지 확인하세요. 한 조건에서만 확인하고 끄면 다른 조건에서 깨지기 쉽습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With it off, check dark mode, landscape, and large text settings too. If you check under only one condition before turning it off, it can easily break under another."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With it off, check dark mode, landscape, and large text settings too. If you check under only one condition before turning it off, it can easily break under another."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにした状態で、ダークモード・横向き・大きな文字の設定まで確認してください。ひとつの条件だけで確かめてオフにすると、別の条件で崩れやすくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭状态下，连深色模式、横屏、大字号设置也一并确认。只在一个条件下确认就关掉，在其他条件下很容易失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉狀態下，連深色模式、橫向螢幕、大字號設定也一併確認。只在一個條件下確認就關掉，在其他條件下很容易失效。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключая, проверьте также тёмную тему, альбомную ориентацию и настройки крупного текста. Если проверить только при одном условии и выключить, при другом легко сломается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el efecto desactivado, comprueba también el modo oscuro, la orientación horizontal y los ajustes de texto grande. Si compruebas solo una condición antes de desactivarlo, puede romperse fácilmente bajo otra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe mit ausgeschaltetem Effekt auch Dunkelmodus, Querformat und große Texteinstellungen. Prüfst du vor dem Ausschalten nur unter einer Bedingung, kann es unter einer anderen leicht brechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois désactivé, vérifiez aussi le mode sombre, le paysage et les grands réglages de texte. Si vous ne vérifiez que sous une condition avant de le désactiver, cela peut facilement casser sous une autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l'effetto disattivato, controlla anche Modalità Scura, orizzontale e impostazioni di testo grande. Se controlli in una sola condizione prima di disattivarlo, può facilmente rompersi in un'altra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com ele desligado, confira também o Modo Escuro, a paisagem e os ajustes de texto grande. Se você confere numa só condição antes de desligar, pode quebrar facilmente em outra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิดมัน ให้ตรวจโหมดมืด แนวนอน และการตั้งค่าตัวอักษรใหญ่ด้วย ถ้าตรวจภายใต้เงื่อนไขเดียวก่อนปิด มันพังภายใต้เงื่อนไขอื่นได้ง่าย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt đi, hãy kiểm tra cả chế độ tối, chế độ ngang và cỡ chữ lớn. Nếu chỉ kiểm tra dưới một điều kiện trước khi tắt, rất dễ hỏng ở điều kiện khác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S vypnutým zkontrolujte také tmavý režim, režim na šířku a nastavení velkého textu. Pokud před vypnutím zkontrolujete jen jednu podmínku, snadno se rozbije při jiné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når den er slået fra, tjek også mørk tilstand, landskab og store tekstindstillinger. Hvis du kun tjekker under én betingelse, før du slår den fra, kan den let gå i stykker under en anden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με αυτό απενεργοποιημένο, έλεγξε και τη σκοτεινή εμφάνιση, τον οριζόντιο προσανατολισμό και τις ρυθμίσεις μεγάλου κειμένου. Αν ελέγξεις υπό μία μόνο συνθήκη πριν το απενεργοποιήσεις, μπορεί εύκολα να σπάσει υπό άλλη."
          }
        }
      }
    },
    "끌 수 있다는 사실을 아무도 모르면 그 detent는 없는 것이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If nobody knows it can be dragged, that detent might as well not exist."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If nobody knows it can be dragged, that detent might as well not exist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグできることを誰も知らなければ、その detent は存在しないのと同じだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没人知道可以拖动的话，那个 detent 就等于不存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒人知道可以拖動的話，那個 detent 就等於不存在。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если никто не знает, что это можно потянуть, то такого detent словно и нет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si nadie sabe que se puede arrastrar, ese detent es como si no existiera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiß niemand, dass man ziehen kann, könnte dieser Detent genauso gut nicht existieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si personne ne sait qu'on peut le faire glisser, ce detent pourrait aussi bien ne pas exister."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nessuno sa che si può trascinare, quel detent potrebbe anche non esistere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ninguém sabe que dá para arrastar, esse detent bem poderia não existir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าไม่มีใครรู้ว่าลากได้ detent นั้นก็เหมือนไม่มีอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không ai biết có thể kéo, detent đó coi như không tồn tại."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud nikdo neví, že jde táhnout, ten detent může klidně neexistovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis ingen ved, at den kan trækkes, kunne den detent lige så godt ikke findes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν κανείς δεν ξέρει ότι μπορεί να συρθεί, αυτό το detent θα μπορούσε εξίσου να μην υπάρχει."
          }
        }
      }
    },
    "끝자리가 구분자인 값에 tail 자르기를 쓴다": {
