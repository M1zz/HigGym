        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esconder a pista de que uma folha pode se expandir (a alça)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนสัญญาณที่บอกว่าชีตขยายได้ (grabber)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giấu tín hiệu cho thấy sheet có thể mở rộng (grabber)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrytí náznaku, že sheet lze rozbalit (grabber)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At skjule signalet om, at et ark kan udvides (grabberen)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόκρυψη της ένδειξης ότι ένα φύλλο μπορεί να επεκταθεί (το grabber)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vihjeen piilottaminen siitä, että arkki voi laajentua (grabber)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyembunyikan petunjuk bahwa lembar bisa meluas (grabber)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å skjule signalet om at et ark kan utvides (grabberen)"
          }
        },
        "nl": {
