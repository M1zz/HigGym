        }
      }
    },
    "vibrancy는 배경을 섞어 스스로 대비를 맞춘다. 고정 색은 어느 배경에선가 반드시 깨진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy blends in the background to set its own contrast. A fixed color is bound to break on some background."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy blends in the background to set its own contrast. A fixed colour is bound to break on some background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "vibrancyは背景を混ぜて、自らコントラストを合わせる。固定の色は、どこかの背景で必ず崩れる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "vibrancy 混合背景，自己调整对比度。固定颜色一定会在某个背景上失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "vibrancy 混合背景，自己調整對比度。固定顏色一定會在某個背景上失效。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy подмешивает фон и сам настраивает контраст. Фиксированный цвет непременно сломается на каком-нибудь фоне."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy mezcla el fondo para fijar su propio contraste. Un color fijo está condenado a fallar sobre algún fondo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy mischt den Hintergrund ein und stellt damit ihren eigenen Kontrast ein. Eine feste Farbe bricht zwangsläufig auf irgendeinem Hintergrund."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vibrancy mélange l'arrière-plan pour régler son propre contraste. Une couleur fixe est condamnée à casser sur un arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vibrancy mescola lo sfondo per fissare il proprio contrasto. Un colore fisso è destinato a rompersi su qualche sfondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vibrancy mistura o fundo para definir o próprio contraste. Uma cor fixa está fadada a quebrar em algum fundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy ผสมพื้นหลังเพื่อกำหนดความตัดกันของตัวเอง สีตายตัวต้องพังบนพื้นหลังใดพื้นหลังหนึ่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy hòa nền để đặt độ tương phản riêng. Một màu cố định chắc chắn vỡ trên nền nào đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy se prolíná s pozadím a nastavuje si vlastní kontrast. Pevná barva se na nějakém pozadí určitě rozbije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy blander baggrunden ind for at sætte sin egen kontrast. En fast farve går uvægerligt i stykker på en eller anden baggrund."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το vibrancy ανακατεύει το φόντο για να ορίσει τη δική του αντίθεση. Ένα σταθερό χρώμα είναι καταδικασμένο να σπάσει σε κάποιο φόντο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy sekoittaa taustan asettaakseen oman kontrastinsa. Kiinteä väri rikkoutuu varmasti jollain taustalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy memadukan latar untuk menetapkan kontrasnya sendiri. Warna tetap pasti rusak di sebagian latar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy blander inn bakgrunnen for å sette sin egen kontrast. En fast farge vil uunngåelig svikte på en eller annen bakgrunn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy mengt de achtergrond erdoor om zijn eigen contrast in te stellen. Een vaste kleur breekt onvermijdelijk op een of andere achtergrond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy wtapia tło, by ustawić własny kontrast. Stały kolor musi zawieść na jakimś tle."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy blandar in bakgrunden för att sätta sin egen kontrast. En fast färg går garanterat sönder på någon bakgrund."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrancy kendi kontrastını ayarlamak için arka planı karıştırır. Sabit bir renk bir arka planda mutlaka bozulur."
          }
        }
      }
    },
