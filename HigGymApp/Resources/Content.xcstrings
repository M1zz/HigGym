        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาชื่อเรื่องออกจากหน้าจอรายการธรรมดาและยกกึ่งกลางให้การค้นหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ tiêu đề khỏi màn hình danh sách thông thường và giao giữa cho tìm kiếm"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranění nadpisu z běžné obrazovky se seznamem a přenechání středu hledání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At fjerne titlen fra en almindelig listeskærm og give midten til søgning"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση του τίτλου από μια συνηθισμένη οθόνη λίστας και παραχώρηση του κέντρου στην αναζήτηση"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsikon poistaminen tavallisesta luettelonäkymästä ja keskikohdan antaminen haulle"
