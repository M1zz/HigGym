    "**아이콘만**, 의미가 보편적일 때만 허용되는 미니멀형": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Icon only**, a minimal form allowed only when the meaning is universal"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Icon only**, a minimal form allowed only when the meaning is universal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**アイコンのみ**。意味が普遍的なときだけ許されるミニマルな形"
          }
        },
        "zh-Hans": {
          "stringUnit": {
