            "state": "translated",
            "value": "Un detent personnalisé ajusté à **la hauteur naturelle du contenu**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un detent personalizzato adattato all'**altezza naturale del contenuto**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
