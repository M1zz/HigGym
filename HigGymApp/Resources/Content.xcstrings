          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นตอนที่ต้องทำให้เสร็จ เช่นการชำระเงินหรือการเซ็น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luồng phải hoàn tất, như thanh toán hay ký"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toky, které se musejí dokončit, jako platba nebo podpis"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flow, der skal fuldføres, som betaling eller underskrift"
          }
        },
        "el": {
