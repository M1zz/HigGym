            "value": "**Uma cor de fundo opaca numa view personalizada sobre uma barra de ferramentas de vidro** (viola 1.1.8)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**สีพื้นหลังทึบบน view ที่กำหนดเองเหนือแถบเครื่องมือกระจก** (ฝ่าฝืน 1.1.8)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Một màu nền đặc trên view tùy chỉnh đặt trên thanh công cụ kính** (vi phạm 1.1.8)"
          }
        },
        "cs": {
          "stringUnit": {
