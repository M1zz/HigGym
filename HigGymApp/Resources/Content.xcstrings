            "value": "**認証コードや住所にtextSelection(.enabled)** (2.1.5)"
          }
        }
      }
    },
    "**작성·업로드** 버튼을 prominent 탭으로 위장": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
