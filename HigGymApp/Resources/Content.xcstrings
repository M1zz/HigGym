          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка поиска выдвижной панели **закреплена даже при прокрутке** (.always)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de búsqueda en cajón **fijada incluso al desplazar** (.always)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suchleiste der Schublade **auch beim Scrollen fixiert** (.always)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre de recherche du tiroir **fixée même pendant le défilement** (.always)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra di ricerca nel cassetto **fissata anche durante lo scorrimento** (.always)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de busca da gaveta **fixada mesmo ao rolar** (.always)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบค้นหาแบบลิ้นชัก**ตรึงแม้ขณะเลื่อน** (.always)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tìm kiếm ngăn kéo **ghim ngay cả khi cuộn** (.always)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávací pole v zásuvce **připnuté i při posouvání** (.always)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuffens søgebjælke **fastgjort selv under scroll** (.always)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή αναζήτησης συρταριού **καρφιτσωμένη ακόμα και κατά την κύλιση** (.always)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatikon hakupalkki **kiinnitettynä vieritettäessäkin** (.always)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah pencarian laci **disematkan bahkan saat menggulir** (.always)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuffsøkefeltet **festet selv ved rulling** (.always)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zoekbalk in de lade **vastgezet, ook tijdens het scrollen** (.always)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasek wyszukiwania w szufladzie **przypięty nawet podczas przewijania** (.always)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuffens sökfält **fastnålat även vid scrollning** (.always)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekmece arama çubuğu kaydırırken bile **sabitlenmiş** (.always)"
          }
        }
      }
    },
