    "material 위 텍스트**vibrancy가 배경색을 끌어와** 대비와 통합감을 동시에": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text on a material: **vibrancy pulls in the background color** for both contrast and cohesion"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Text on a material: **vibrancy pulls in the background colour** for both contrast and cohesion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "material上のテキスト。**vibrancyが背景色を取り込み**、コントラストと一体感を両立"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "material 上的文字**vibrancy 会引入背景色**，同时获得对比度和整体感"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "material 上的文字**vibrancy 會引入背景色**，同時獲得對比度和整體感"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст на материале: **vibrancy подтягивает цвет фона** и для контраста, и для целостности"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto sobre un material: **vibrancy absorbe el color del fondo** para lograr contraste y cohesión"
          }
        },
        "de": {
          "stringUnit": {
