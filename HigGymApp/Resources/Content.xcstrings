    "서랍 검색과 하단 검색을 동시에 제공(자리 중복)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawer search and bottom search offered at the same time (duplicate slots)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawer search and bottom search offered at the same time (duplicate slots)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き出しの検索と下部の検索を同時に提供（位置の重複）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时提供抽屉搜索和底部搜索（位置重复）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時提供抽屜搜尋和底部搜尋（位置重複）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременное предложение поиска в выдвижной панели и нижнего поиска (дублирование мест)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Búsqueda en cajón y búsqueda inferior ofrecidas a la vez (sitios duplicados)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schubladensuche und untere Suche gleichzeitig angeboten (doppelte Plätze)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche en tiroir et recherche du bas proposées en même temps (emplacements en double)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca nel cassetto e ricerca in basso offerte insieme (slot duplicati)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca na gaveta e busca embaixo oferecidas ao mesmo tempo (lugares duplicados)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสนอการค้นหาแบบลิ้นชักและการค้นหาด้านล่างพร้อมกัน (ช่องซ้ำ)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm ngăn kéo và tìm kiếm dưới cùng được cung cấp cùng lúc (ô trùng lặp)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání v zásuvce a spodní hledání nabízené současně (zdvojené sloty)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuffesøgning og nederste søgning tilbudt samtidig (duplikerede pladser)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναζήτηση συρταριού και κάτω αναζήτηση προσφερόμενες ταυτόχρονα (διπλές θέσεις)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatikkohaku ja alahaku tarjottuna samanaikaisesti (päällekkäiset paikat)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian laci dan pencarian bawah ditawarkan bersamaan (slot ganda)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skuffsøk og bunnsøk tilbudt samtidig (doble plasser)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade-zoeken en onderste zoeken tegelijk aanbieden (dubbele plekken)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie w szufladzie i dolne wyszukiwanie oferowane jednocześnie (zdublowane miejsca)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
