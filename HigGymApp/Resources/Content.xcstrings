        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Telas de dashboard e de player em que os filtros ou o status no topo e os controles embaixo precisam **ficar na tela ao mesmo tempo**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอแดชบอร์ดและเพลเยอร์ที่ตัวกรองหรือสถานะด้านบนและตัวควบคุมด้านล่างต้อง**อยู่บนหน้าจอพร้อมกัน**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình bảng điều khiển và trình phát mà bộ lọc hoặc trạng thái ở trên và điều khiển ở dưới phải **ở trên màn hình cùng lúc**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovky dashboardu a přehrávače, kde filtry nebo stav nahoře a ovladače dole musejí **zůstat na obrazovce současně**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dashboard- og afspillerskærme, hvor filtre eller status øverst og kontroller nederst skal **forblive på skærmen samtidig**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οθόνες dashboard και αναπαραγωγής όπου φίλτρα ή κατάσταση πάνω και έλεγχοι κάτω πρέπει να **μένουν στην οθόνη ταυτόχρονα**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kojelauta- ja soitinnäkymät, joissa suodattimet tai tila ylhäällä ja säätimet alhaalla täytyy **pysyä näytöllä samanaikaisesti**."
