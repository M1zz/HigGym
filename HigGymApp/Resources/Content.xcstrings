        }
      }
    },
    "검색을 거의 안 쓰는데 minimize로라도 상시 배치(searchable 자체가 불필요)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search is barely used but stays on screen, even if minimized (searchable itself is unnecessary)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Search is barely used but stays on screen, even if minimised (searchable itself is unnecessary)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索をほとんど使わないのに、minimizeであっても常に配置（searchable自体が不要）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几乎不用搜索，却以 minimize 的方式也常驻（searchable 本身就不需要）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幾乎不用搜尋，卻以 minimize 的方式也常駐（searchable 本身就不需要）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиском почти не пользуются, но он остаётся на экране, пусть и свёрнутым (сам searchable не нужен)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda apenas se usa pero sigue en pantalla, aunque esté minimizada (el propio searchable es innecesario)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche wird kaum genutzt, bleibt aber auf dem Bildschirm, selbst minimiert (searchable selbst ist unnötig)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche est à peine utilisée mais reste à l'écran, même réduite (searchable lui-même est inutile)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca si usa appena ma resta sullo schermo, anche se ridotta (searchable stesso è superfluo)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca mal é usada mas continua na tela, mesmo minimizada (o próprio searchable é desnecessário)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การค้นหาแทบไม่ถูกใช้แต่ยังอยู่บนหน้าจอ แม้ย่อแล้ว (ไม่จำเป็นต้องมี searchable เลย)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm hầu như không dùng mà vẫn nằm trên màn hình, dù đã thu nhỏ (bản thân searchable là không cần)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání se skoro nepoužívá, ale zůstává na obrazovce, i když je minimalizované (samotné searchable je zbytečné)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgning bruges næsten ikke, men bliver på skærmen, selv minimeret (searchable i sig selv er unødvendig)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση σχεδόν δεν χρησιμοποιείται αλλά μένει στην οθόνη, ακόμα και ελαχιστοποιημένη (το searchable από μόνο του είναι περιττό)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakua käytetään tuskin lainkaan, mutta se pysyy näytöllä, vaikka se olisi minimoitu (searchable itsessään on tarpeeton)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
