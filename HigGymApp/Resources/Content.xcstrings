          "stringUnit": {
            "state": "translated",
            "value": "用**简短文字角标**代替数字（.badge(\"NEW\")），状态型提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用**簡短文字標記**代替數字（.badge(\"NEW\")），狀態型提示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Короткий текстовый бейдж** вместо числа (.badge(\"NEW\")), для уведомлений о состоянии."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una **insignia de texto corto** en lugar de un número (.badge(\"NUEVO\")), para avisos de estado."
