          "stringUnit": {
            "state": "translated",
            "value": "系統兩檔就夠了，卻執著於畫素微調"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одержимость пиксельной подгонкой, когда хватило бы двух системных ступеней"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsesionarse con retoques a nivel de píxel cuando bastarían los dos escalones del sistema"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Pixelkorrekturen versessen sein, obwohl die zwei Systemstufen genügt hätten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'obstiner sur des retouches au pixel près alors que les deux crans du système suffiraient"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ossessionarsi su ritocchi a livello di pixel quando bastavano i due passi di sistema"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obcecar-se com ajustes em nível de pixel quando bastavam os dois passos do sistema"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมกมุ่นกับการปรับระดับพิกเซลทั้งที่สองขั้นของระบบก็พอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ám ảnh chỉnh từng pixel khi hai bậc hệ thống là đủ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posedlost úpravami na úrovni pixelů, když by stačily dva kroky systému"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At gå op i pixelnøjagtige justeringer, når de to systemtrin ville række"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμμονή με ρυθμίσεις επιπέδου pixel όταν τα δύο βήματα συστήματος θα αρκούσαν"
          }
        }
      }
    },
    "시스템 검색바를 다른 툴바 아이템들과 **한 툴바 체계 안에 통합**, 자리 확보·분리·축소를 조합.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system search bar **integrated into one toolbar system** with the other toolbar items, combining slot reservation, separation, and minimization."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system search bar **integrated into one toolbar system** with the other toolbar items, combining slot reservation, separation, and minimisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの検索バーをほかのツールバーアイテムと**ひとつのツールバー体系の中に統合**。位置の確保・分離・縮小を組み合わせる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把系统搜索栏与其他工具栏项目**整合进同一套工具栏体系**，组合了留位 · 分离 · 缩小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把系統搜尋列與其他工具列項目**整合進同一套工具列體系**，組合了留位 · 分離 · 縮小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная строка поиска, **интегрированная в одну систему панели инструментов** с остальными элементами панели, сочетающая резервирование места, разделение и минимизацию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de búsqueda del sistema **integrada en un único sistema de barra de herramientas** con los demás elementos de la barra, combinando reserva de hueco, separación y minimización."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die System-Suchleiste, **in ein Symbolleistensystem integriert** mit den anderen Symbolleistenelementen, kombiniert Platzreservierung, Trennung und Minimierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre de recherche système **intégrée dans un seul système de barre d'outils** avec les autres éléments de la barre d'outils, combinant réservation d'emplacement, séparation et réduction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra di ricerca di sistema **integrata in un unico sistema di barra degli strumenti** con gli altri elementi, che combina riserva dello slot, separazione e minimizzazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de busca do sistema **integrada num único sistema de barra de ferramentas** com os outros itens, combinando reserva do lugar, separação e minimização."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบค้นหาของระบบที่**รวมเข้าระบบแถบเครื่องมือเดียว**กับรายการแถบเครื่องมืออื่น รวมการสำรองช่อง การแยก และการย่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tìm kiếm hệ thống **tích hợp vào một hệ thống thanh công cụ duy nhất** cùng các mục khác, kết hợp giữ ô, phân tách và thu gọn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systémové vyhledávací pole **integrované do jednoho systému panelu nástrojů** s ostatními položkami panelu nástrojů, kombinující rezervaci slotu, oddělení a minimalizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemets søgebjælke **integreret i ét værktøjslinjesystem** med de andre værktøjslinjeelementer, der kombinerer pladsreservation, adskillelse og minimering."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή αναζήτησης του συστήματος **ενσωματωμένη σε ένα σύστημα γραμμής εργαλείων** με τα άλλα στοιχεία γραμμής εργαλείων, συνδυάζοντας δέσμευση θέσης, διαχωρισμό και ελαχιστοποίηση."
          }
        }
      }
    },
    "시스템 규약 이탈": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaks the system convention"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaks the system convention"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのお約束から外れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏离系统约定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偏離系統約定"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарушает системное соглашение"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompe la convención del sistema"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricht die Systemkonvention"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brise la convention système"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompe la convenzione di sistema"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quebra a convenção do sistema"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำลายธรรมเนียมของระบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phá vỡ quy ước hệ thống"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porušuje systémovou konvenci"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bryder systemkonventionen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραβιάζει τη σύμβαση συστήματος"
          }
        }
      }
    },
    "시스템 내비게이션 바를 쓰지 않는 화면에서 **자체 헤더**가 필요할 때, 브랜드 디자인이 강한 앱, 특수 레이아웃의 홈 화면.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a screen that doesn't use the system navigation bar needs **its own header**: apps with a strong brand design, home screens with special layouts."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a screen that doesn't use the system navigation bar needs **its own header**: apps with a strong brand design, home screens with special layouts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーを使わない画面で**独自のヘッダー**が必要なとき。ブランドデザインの強いアプリ、特殊なレイアウトのホーム画面など。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不使用系统导航栏的界面里需要**自有标题区**时：品牌设计很强的应用、特殊布局的首页。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在不使用系統導覽列的介面裡需要**自有標題區**時：品牌設計很強的應用程式、特殊佈局的首頁。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда экрану, не использующему системную панель навигации, нужен **собственный заголовок**: приложения с сильным дизайном бренда, главные экраны со специальной раскладкой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una pantalla que no usa la barra de navegación del sistema necesita **su propio encabezado**: apps con un fuerte diseño de marca, pantallas de inicio con un diseño especial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Bildschirm, der die System-Navigationsleiste nicht nutzt, **einen eigenen Header** braucht: Apps mit starkem Markendesign, Startbildschirme mit besonderem Layout."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un écran qui n'utilise pas la barre de navigation système a besoin de **son propre en-tête** : apps à forte identité graphique, écrans d'accueil à la disposition particulière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una schermata che non usa la barra di navigazione di sistema ha bisogno di **una propria intestazione**: app con un forte design di marchio, schermate home con layout speciali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma tela que não usa a barra de navegação do sistema precisa de **um cabeçalho próprio**: apps com forte design de marca, telas iniciais com layouts especiais."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อหน้าจอที่ไม่ใช้แถบนำทางของระบบต้องการ**ส่วนหัวของตัวเอง**: แอปที่ดีไซน์แบรนด์เข้มแข็ง หน้าแรกที่มีเลย์เอาต์พิเศษ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một màn hình không dùng thanh điều hướng hệ thống cần **header riêng**: app có thiết kế thương hiệu mạnh, màn hình chủ có bố cục đặc biệt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když obrazovka, která nepoužívá systémový navigační panel, potřebuje **vlastní hlavičku**: aplikace se silným designem značky, domovské obrazovky se zvláštním rozvržením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en skærm, der ikke bruger systemets navigationsbjælke, har brug for **sin egen header**: apps med et stærkt branddesign, hjemmeskærme med særlige layouts."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν μια οθόνη που δεν χρησιμοποιεί τη γραμμή πλοήγησης συστήματος χρειάζεται **τη δική της κεφαλίδα**: εφαρμογές με ισχυρό σχεδιασμό brand, αρχικές οθόνες με ειδικές διατάξεις."
          }
        }
      }
    },
    "시스템 내비바는 Dynamic Type 대응과 스크롤 시 제목 축소를 **공짜로** 해 주고 있었다. `safeAreaBar`로 옮기면 인셋과 가장자리 효과는 시스템이 대지만 그 공짜 기능은 따라오지 않는다. 고정 크기 헤더는 글자가 변한다는 사실을 계산에 넣지 않은 레이아웃이다. 잘림이 안전장치가 아니라 기본 결과가 됐다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system navigation bar was handling Dynamic Type and shrinking the title on scroll **for free**. Move to `safeAreaBar`, and the system still supplies the inset and edge effect, but those free features don't come along. A fixed-size header is a layout that never accounted for text changing size. Truncation became the default outcome instead of a safety net."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The system navigation bar was handling Dynamic Type and shrinking the title on scroll **for free**. Move to `safeAreaBar`, and the system still supplies the inset and edge effect, but those free features don't come along. A fixed-size header is a layout that never accounted for text changing size. Truncation became the default outcome instead of a safety net."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーは、Dynamic Typeへの対応とスクロール時のタイトル縮小を**タダで**やってくれていた。`safeAreaBar`に移すと、インセットとエッジエフェクトはシステムが用意してくれるが、そのタダの機能はついてこない。固定サイズのヘッダは、文字が変わるという事実を計算に入れていないレイアウトだ。切り詰めが安全装置ではなく、当たり前の結果になってしまった。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统导航栏本来**免费**提供了 Dynamic Type 适配和滚动时标题缩小。换成 `safeAreaBar` 后，内边距和边缘效果系统会给，但那些免费功能不会跟来。固定尺寸的标题区，是没把文字会变化这件事算进去的布局。截断不再是安全装置，而成了默认结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統導覽列本來**免費**提供了 Dynamic Type 適配和滾動時標題縮小。換成 `safeAreaBar` 後，內邊距和邊緣效果系統會給，但那些免費功能不會跟來。固定尺寸的標題區，是沒把文字會變化這件事算進去的佈局。截斷不再是安全裝置，而成了預設結果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная панель навигации **бесплатно** справлялась с Dynamic Type и сжатием заголовка при прокрутке. Перейдёте на `safeAreaBar`, и система всё ещё даёт отступ и эффект края, но эти бесплатные возможности не следуют. Заголовок фиксированного размера - это макет, который не учёл, что текст меняет размер. Обрезка стала результатом по умолчанию, а не страховкой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de navegación del sistema se ocupaba **gratis** de Dynamic Type y de reducir el título al desplazar. Pasa a `safeAreaBar` y el sistema sigue aportando el margen y el efecto de borde, pero esas funciones gratuitas no vienen incluidas. Un encabezado de tamaño fijo es un diseño que nunca tuvo en cuenta que el texto cambia de tamaño. El truncamiento pasó a ser el resultado por defecto en lugar de una red de seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die System-Navigationsleiste kümmerte sich **gratis** um Dynamic Type und das Schrumpfen des Titels beim Scrollen. Wechselst du zu `safeAreaBar`, liefert das System weiter Einzug und Kanteneffekt, aber diese Gratisfunktionen kommen nicht mit. Ein Header fester Größe ist ein Layout, das nie berücksichtigt hat, dass sich Text in der Größe ändert. Abschneiden wurde zum Standardergebnis statt zum Sicherheitsnetz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre de navigation système gérait Dynamic Type et le rétrécissement du titre au défilement **gratuitement**. Passez à `safeAreaBar`, et le système fournit toujours le décalage et l'effet de bord, mais ces fonctions gratuites ne viennent pas avec. Un en-tête de taille fixe est une mise en page qui n'a jamais tenu compte du changement de taille du texte. La troncature est devenue le résultat par défaut au lieu d'un filet de sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra di navigazione di sistema gestiva **gratis** Dynamic Type e la riduzione del titolo allo scorrimento. Passa a `safeAreaBar` e il sistema fornisce ancora lo spostamento e l'effetto sul bordo, ma quelle funzioni gratuite non arrivano con sé. Un'intestazione di dimensione fissa è un layout che non ha mai considerato che il testo cambi dimensione. Il troncamento è diventato l'esito predefinito invece di una rete di sicurezza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de navegação do sistema cuidava **de graça** do Dynamic Type e do encolher do título ao rolar. Passe para `safeAreaBar` e o sistema ainda fornece o recuo e o efeito de borda, mas essas funções gratuitas não vêm junto. Um cabeçalho de tamanho fixo é um layout que nunca considerou que o texto muda de tamanho. O truncamento virou o resultado padrão em vez de uma rede de segurança."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบนำทางของระบบจัดการ Dynamic Type และการหดชื่อเรื่องเมื่อเลื่อน**ให้ฟรี** ย้ายไป `safeAreaBar` ระบบยังให้การเว้นระยะและเอฟเฟกต์ขอบ แต่ฟีเจอร์ฟรีเหล่านั้นไม่มาด้วย ส่วนหัวขนาดตายตัวเป็นเลย์เอาต์ที่ไม่เคยคำนึงว่าข้อความเปลี่ยนขนาดได้ การตัดกลายเป็นผลลัพธ์เริ่มต้นแทนที่จะเป็นตาข่ายนิรภัย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh điều hướng hệ thống đã xử lý Dynamic Type và thu nhỏ tiêu đề khi cuộn **miễn phí**. Chuyển sang `safeAreaBar`, hệ thống vẫn cấp phần đệm và hiệu ứng cạnh, nhưng các tính năng miễn phí kia không đi kèm. Header kích thước cố định là bố cục chưa từng tính đến việc chữ đổi cỡ. Cắt trở thành kết cục mặc định thay vì lưới an toàn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systémový navigační panel **zdarma** zajišťoval Dynamic Type a zmenšování nadpisu při posouvání. Přejděte na `safeAreaBar` a systém stále dodá odsazení a okrajový efekt, ale tyto bezplatné funkce nepřijdou s ním. Hlavička pevné velikosti je rozvržení, které nikdy nepočítalo se změnou velikosti textu. Ořez se stal výchozím výsledkem místo pojistky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemets navigationsbjælke håndterede Dynamic Type og skrumpede titlen ved scroll **gratis**. Flyt til `safeAreaBar`, og systemet leverer stadig indrykningen og kanteffekten, men de gratis funktioner følger ikke med. En header i fast størrelse er et layout, der aldrig tog højde for, at tekst ændrer størrelse. Afkortning blev standardresultatet i stedet for et sikkerhedsnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή πλοήγησης του συστήματος χειριζόταν το Dynamic Type και τη σμίκρυνση του τίτλου στην κύλιση **δωρεάν**. Μετακινήσου στο `safeAreaBar`, και το σύστημα εξακολουθεί να παρέχει την εσοχή και το εφέ άκρης, αλλά αυτές οι δωρεάν λειτουργίες δεν έρχονται μαζί. Μια κεφαλίδα σταθερού μεγέθους είναι μια διάταξη που δεν έλαβε ποτέ υπόψη ότι το κείμενο αλλάζει μέγεθος. Η περικοπή έγινε το προεπιλεγμένο αποτέλεσμα αντί για δίχτυ ασφαλείας."
          }
        }
      }
    },
    "시스템 내비바로 돌아가고 상단 아이템 수를 줄인다. 일부는 하단 툴바로, 드문 것은 ⋯ 안으로 보낸다. 남는 것 중 무엇이 먼저 접힐지 순서를 설계한다. 버튼은 제 크기를 되찾고, 회전과 큰 글씨는 시스템이 다시 맡는다. 1.2.4 Inline with 5 Toolbar Items 예제를 열어 시스템이 제목과 아이템 사이에서 공간을 어떻게 나누는지 직접 보라.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to the system navigation bar and reduce the number of top items. Move some to the bottom toolbar and send rarely used ones into ⋯. Design the order in which the remaining ones fold. The buttons get their proper size back, and the system takes over rotation and larger text again. Open the 1.2.4 Inline with 5 Toolbar Items example and see for yourself how the system divides space between the title and the items."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Go back to the system navigation bar and reduce the number of top items. Move some to the bottom toolbar and send rarely used ones into ⋯. Design the order in which the remaining ones fold. The buttons get their proper size back, and the system takes over rotation and larger text again. Open the 1.2.4 Inline with 5 Toolbar Items example and see for yourself how the system divides space between the title and the items."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーに戻し、上部のアイテム数を減らす。一部は下部のツールバーへ、まれにしか使わないものは ⋯ の中へ送る。残ったもののうち、どれから先に折りたたまれるかの順番を設計する。ボタンは本来のサイズを取り戻し、回転や大きな文字は再びシステムが引き受ける。1.2.4 Inline with 5 Toolbar Items の例を開いて、システムがタイトルとアイテムの間でスペースをどう分けるかを自分の目で見てみよう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到系统导航栏，并减少顶部项目数量。一部分移到底部工具栏，少用的放进 ⋯。剩下的东西里，设计好哪个先被折叠的顺序。按钮恢复了本来的大小，旋转和大字号重新交给系统。打开 1.2.4 Inline with 5 Toolbar Items 示例，亲眼看系统是如何在标题与项目之间分配空间的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到系統導覽列，並減少頂部項目數量。一部分移到底部工具列，少用的放進 ⋯。剩下的東西里，設計好哪個先被摺疊的順序。按鈕恢復了本來的大小，旋轉和大字號重新交給系統。開啟 1.2.4 Inline with 5 Toolbar Items 示例，親眼看系統是如何在標題與項目之間分配空間的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь к системной панели навигации и сократите число верхних элементов. Часть перенесите в нижнюю панель инструментов, а редко используемые отправьте в ⋯. Продумайте порядок, в котором оставшиеся сворачиваются. Кнопки возвращают себе нужный размер, а поворот и крупный текст снова берёт на себя система. Откройте пример 1.2.4 Inline with 5 Toolbar Items и посмотрите сами, как система делит место между заголовком и элементами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a la barra de navegación del sistema y reduce el número de elementos de arriba. Pasa algunos a la barra de herramientas inferior y manda los poco usados a ⋯. Diseña el orden en que se pliegan los restantes. Los botones recuperan su tamaño adecuado, y el sistema vuelve a encargarse de la rotación y del texto más grande. Abre el ejemplo 1.2.4 Inline with 5 Toolbar Items y comprueba tú mismo cómo reparte el sistema el espacio entre el título y los elementos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehre zur System-Navigationsleiste zurück und verringere die Zahl der oberen Elemente. Verschiebe einige in die untere Symbolleiste und schicke selten genutzte nach ⋯. Gestalte die Reihenfolge, in der die übrigen sich falten. Die Buttons bekommen ihre richtige Größe zurück, und das System übernimmt Drehung und größeren Text wieder. Öffne das Beispiel 1.2.4 Inline with 5 Toolbar Items und sieh selbst, wie das System den Platz zwischen Titel und Elementen aufteilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez à la barre de navigation système et réduisez le nombre d'éléments du haut. Déplacez-en certains dans la barre d'outils du bas et envoyez les rarement utilisés dans ⋯. Concevez l'ordre dans lequel les autres se replient. Les boutons retrouvent leur taille correcte, et le système reprend en charge la rotation et le texte plus grand. Ouvrez l'exemple 1.2.4 Inline with 5 Toolbar Items et voyez par vous-même comment le système répartit l'espace entre le titre et les éléments."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna alla barra di navigazione di sistema e riduci il numero di elementi in alto. Sposta alcuni nella barra degli strumenti in basso e manda quelli usati di rado in ⋯. Progetta l'ordine in cui si ripiegano i rimanenti. I pulsanti riprendono la loro dimensione giusta e il sistema si riprende rotazione e testo più grande. Apri l'esempio 1.2.4 Inline con 5 elementi della barra degli strumenti e guarda di persona come il sistema divide lo spazio tra il titolo e gli elementi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte à barra de navegação do sistema e reduza o número de itens do topo. Mova alguns para a barra de ferramentas inferior e mande os pouco usados para ⋯. Projete a ordem em que os restantes se dobram. Os botões recuperam o tamanho certo, e o sistema reassume rotação e texto maior. Abra o exemplo 1.2.4 Inline com 5 itens da barra de ferramentas e veja você mesmo como o sistema divide o espaço entre o título e os itens."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับไปใช้แถบนำทางของระบบและลดจำนวนรายการด้านบน ย้ายบางส่วนไปแถบเครื่องมือล่าง และส่งรายการที่ใช้น้อยเข้า ⋯ ออกแบบลำดับที่ที่เหลือจะพับ ปุ่มกลับมามีขนาดที่เหมาะสม และระบบรับช่วงการหมุนกับตัวอักษรใหญ่อีกครั้ง เปิดตัวอย่าง 1.2.4 Inline with 5 Toolbar Items แล้วดูด้วยตัวเองว่าระบบแบ่งพื้นที่ระหว่างชื่อเรื่องกับรายการอย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quay về thanh điều hướng hệ thống và giảm số mục phía trên. Chuyển bớt xuống thanh công cụ dưới và đưa mục ít dùng vào ⋯. Thiết kế thứ tự gập của các mục còn lại. Nút lấy lại kích thước đúng, và hệ thống lại đảm nhận xoay màn hình và chữ lớn. Mở ví dụ 1.2.4 Inline with 5 Toolbar Items và tự xem hệ thống chia không gian giữa tiêu đề và các mục thế nào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraťte se k systémovému navigačnímu panelu a snižte počet horních položek. Některé přesuňte do spodního panelu nástrojů a zřídka používané pošlete do ⋯. Navrhněte pořadí, v jakém se zbylé sbalují. Tlačítka získají zpět správnou velikost a systém zase převezme rotaci a větší text. Otevřete příklad 1.2.4 Inline with 5 Toolbar Items a sami uvidíte, jak systém dělí místo mezi nadpis a položky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå tilbage til systemets navigationsbjælke, og reducer antallet af øverste elementer. Flyt nogle til den nederste værktøjslinje, og send sjældent brugte ind i ⋯. Design rækkefølgen, de resterende folder i. Knapperne får deres rette størrelse tilbage, og systemet overtager igen rotation og større tekst. Åbn eksempel 1.2.4 Inline med 5 værktøjslinjeelementer og se selv, hvordan systemet fordeler plads mellem titlen og elementerne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γύρνα στη γραμμή πλοήγησης του συστήματος και μείωσε τον αριθμό των πάνω στοιχείων. Μετάφερε μερικά στην κάτω γραμμή εργαλείων και στείλε τα σπάνια χρησιμοποιούμενα στο ⋯. Σχεδίασε τη σειρά με την οποία διπλώνουν τα υπόλοιπα. Τα κουμπιά παίρνουν πίσω το σωστό μέγεθός τους, και το σύστημα αναλαμβάνει ξανά την περιστροφή και το μεγαλύτερο κείμενο. Άνοιξε το παράδειγμα 1.2.4 Inline με 5 στοιχεία γραμμής εργαλείων και δες μόνος σου πώς το σύστημα μοιράζει τον χώρο ανάμεσα στον τίτλο και τα στοιχεία."
          }
        }
      }
    },
    "시스템 내비바로는 안 되는 **상단 상시 UI**, 필터 칩 줄, 동기화 상태 배너, 커스텀 헤더처럼 콘텐츠 위에 늘 떠 있어야 하는 것.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Persistent top UI** the system navigation bar can't provide, things that must always float above the content: a row of filter chips, a sync status banner, a custom header."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Persistent top UI** the system navigation bar can't provide, things that must always float above the content: a row of filter chips, a sync status banner, a custom header."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーでは実現できない**上部の常設UI**。フィルタチップの列、同期状態のバナー、カスタムヘッダーのように、常にコンテンツの上に浮かんでいるべきもの。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统导航栏做不到的**顶部常驻 UI**：筛选标签行、同步状态横幅、自定义标题区这类必须始终浮在内容之上的东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統導覽列做不到的**頂部常駐 UI**：篩選標籤行、同步狀態橫幅、自定義標題區這類必須始終浮在內容之上的東西。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Постоянный верхний интерфейс**, который системная панель навигации дать не может, то, что должно всегда парить над контентом: ряд чипов-фильтров, баннер состояния синхронизации, пользовательский заголовок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Interfaz superior permanente** que la barra de navegación del sistema no puede ofrecer, cosas que deben flotar siempre sobre el contenido: una fila de chips de filtro, un banner de estado de sincronización, un encabezado personalizado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dauerhafte obere UI**, die die System-Navigationsleiste nicht liefern kann, Dinge, die immer über dem Inhalt schweben müssen: eine Reihe von Filter-Chips, ein Sync-Statusbanner, ein eigener Header."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une **interface permanente du haut** que la barre de navigation système ne peut fournir, des choses qui doivent toujours flotter au-dessus du contenu : une rangée de puces de filtre, une bannière d'état de synchronisation, un en-tête personnalisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**UI persistente in alto** che la barra di navigazione di sistema non può fornire, cose che devono fluttuare sempre sopra il contenuto: una riga di chip di filtro, un banner di stato della sincronizzazione, un'intestazione personalizzata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Interface persistente no topo** que a barra de navegação do sistema não pode fornecer, coisas que precisam flutuar sempre sobre o conteúdo: uma linha de chips de filtro, um banner de status de sincronização, um cabeçalho personalizado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**UI ด้านบนแบบถาวร**ที่แถบนำทางของระบบให้ไม่ได้ สิ่งที่ต้องลอยเหนือเนื้อหาเสมอ: แถวชิปตัวกรอง แบนเนอร์สถานะซิงค์ ส่วนหัวที่กำหนดเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**UI thường trực phía trên** mà thanh điều hướng hệ thống không cung cấp được, những thứ phải luôn nổi trên nội dung: một hàng chip lọc, banner trạng thái đồng bộ, header tùy chỉnh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trvalé horní UI**, které systémový navigační panel nenabídne, věci, které musejí vždy plavat nad obsahem: řada filtračních čipů, banner stavu synchronizace, vlastní hlavička."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vedvarende øverste brugerflade**, som systemets navigationsbjælke ikke kan levere, ting der altid skal svæve over indholdet: en række filterchips, et synkroniseringsstatusbanner, en brugerdefineret header."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Μόνιμη πάνω διεπαφή** που η γραμμή πλοήγησης συστήματος δεν μπορεί να παρέχει, πράγματα που πρέπει να επιπλέουν πάντα πάνω από το περιεχόμενο: μια σειρά chips φίλτρων, ένα banner κατάστασης συγχρονισμού, μια προσαρμοσμένη κεφαλίδα."
          }
        }
      }
    },
    "시스템 내비바를 버리면 제목 배치·인셋·가장자리 효과를 전부 직접 구현해야 했습니다, safeAreaBar는 그 **인프라(인셋+효과)는 시스템이 대고, 내용만 앱이 채우는** 절충안. 완전 커스텀과 시스템 동작 사이의 중간 지대.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropping the system navigation bar used to mean building title placement, insets and edge effects all yourself. safeAreaBar is the compromise where **the system provides the infrastructure (inset + effects) and the app supplies only the content**. A middle ground between fully custom and system behavior."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropping the system navigation bar used to mean building title placement, insets and edge effects all yourself. safeAreaBar is the compromise where **the system provides the infrastructure (inset + effects) and the app supplies only the content**. A middle ground between fully custom and system behaviour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーを捨てると、タイトルの配置・インセット・エッジエフェクトをすべて自前で実装する必要がありました。safeAreaBarは、その**インフラ（インセット＋エフェクト）はシステムが用意し、中身だけをアプリが埋める**折衷案。完全なカスタムとシステムの動作の中間地帯。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抛开系统导航栏，标题布局 · 内边距 · 边缘效果就得全部自己实现。safeAreaBar 是**基础设施（内边距 + 效果）由系统提供，只有内容由应用填充**的折中方案。是完全自定义与系统行为之间的中间地带。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拋開系統導覽列，標題佈局 · 內邊距 · 邊緣效果就得全部自己實作。safeAreaBar 是**基礎設施（內邊距 + 效果）由系統提供，只有內容由應用程式填充**的折中方案。是完全自定義與系統行為之間的中間地帶。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказ от системной панели навигации раньше означал самостоятельную реализацию расположения заголовка, отступов и эффектов края. safeAreaBar - компромисс, где **инфраструктуру (отступ + эффекты) даёт система, а содержимое - только приложение**. Середина между полностью пользовательским и системным поведением."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prescindir de la barra de navegación del sistema solía significar construir tú mismo la colocación del título, los márgenes y los efectos de borde. safeAreaBar es el compromiso en el que **el sistema aporta la infraestructura (margen + efectos) y la app aporta solo el contenido**. Un término medio entre lo totalmente personalizado y el comportamiento del sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die System-Navigationsleiste zu verzichten hieß früher, Titelplatzierung, Einzüge und Kanteneffekte alles selbst zu bauen. safeAreaBar ist der Kompromiss, bei dem **das System die Infrastruktur (Einzug + Effekte) liefert und die App nur den Inhalt**. Ein Mittelweg zwischen vollständig eigen und Systemverhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se passer de la barre de navigation système voulait dire construire soi-même le placement du titre, les décalages et les effets de bord. safeAreaBar est le compromis où **le système fournit l'infrastructure (décalage + effets) et l'app ne fournit que le contenu**. Un juste milieu entre le tout sur mesure et le comportement système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rinunciare alla barra di navigazione di sistema significava costruire da soli collocazione del titolo, spostamenti ed effetti sul bordo. safeAreaBar è il compromesso in cui **il sistema fornisce l'infrastruttura (spostamento + effetti) e l'app fornisce solo il contenuto**. Un terreno di mezzo tra il tutto personalizzato e il comportamento di sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir mão da barra de navegação do sistema antes significava construir sozinho a colocação do título, os recuos e os efeitos de borda. safeAreaBar é o meio-termo em que **o sistema fornece a infraestrutura (recuo + efeitos) e o app fornece só o conteúdo**. Um terreno intermediário entre o totalmente personalizado e o comportamento do sistema."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การทิ้งแถบนำทางของระบบเคยหมายถึงต้องสร้างการวางชื่อเรื่อง การเว้นระยะ และเอฟเฟกต์ขอบเองทั้งหมด safeAreaBar คือการประนีประนอมที่ **ระบบจัดหาโครงสร้างพื้นฐาน (การเว้นระยะ + เอฟเฟกต์) และแอปให้เฉพาะเนื้อหา** ทางสายกลางระหว่างกำหนดเองเต็มที่กับพฤติกรรมของระบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ thanh điều hướng hệ thống từng nghĩa là tự dựng vị trí tiêu đề, phần đệm và hiệu ứng cạnh. safeAreaBar là sự dung hòa nơi **hệ thống cung cấp hạ tầng (đệm + hiệu ứng) và app chỉ đưa nội dung**. Một điểm giữa tùy chỉnh hoàn toàn và hành vi hệ thống."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypustit systémový navigační panel dřív znamenalo postavit umístění nadpisu, odsazení a okrajové efekty celé sami. safeAreaBar je kompromis, kde **systém poskytuje infrastrukturu (odsazení + efekty) a aplikace dodá jen obsah**. Střední cesta mezi plně vlastním a systémovým chováním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At droppe systemets navigationsbjælke betød før, at du selv skulle bygge titelplacering, indrykninger og kanteffekter. safeAreaBar er kompromiset, hvor **systemet leverer infrastrukturen (indrykning + effekter), og appen kun leverer indholdet**. En mellemvej mellem fuldt brugerdefineret og systemadfærd."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγκατάλειψη της γραμμής πλοήγησης συστήματος σήμαινε παλιά ότι έχτιζες μόνος σου την τοποθέτηση τίτλου, τις εσοχές και τα εφέ άκρης. Το safeAreaBar είναι ο συμβιβασμός όπου **το σύστημα παρέχει την υποδομή (εσοχή + εφέ) και η εφαρμογή παρέχει μόνο το περιεχόμενο**. Μια μέση λύση ανάμεσα σε πλήρως προσαρμοσμένο και συμπεριφορά συστήματος."
          }
        }
      }
    },
    "시스템 내비바에 넣으면 셋만 남고 둘이 ⋯ 안으로 접힌다. 접힌 것은 안 보이니 안 쓰일 것 같다. 커스텀으로 만들면 다섯을 다 보여 줄 수 있고, 평상시 모습을 흉내 내는 건 어렵지 않다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put them in the system navigation bar and only three remain, with two folded into ⋯. Anything folded away is out of sight, so it seems like it won't get used. A custom bar can show all five, and mimicking the usual look isn't hard."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put them in the system navigation bar and only three remain, with two folded into ⋯. Anything folded away is out of sight, so it seems like it won't get used. A custom bar can show all five, and mimicking the usual look isn't hard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーに入れると3つだけが残り、2つは ⋯ の中に折りたたまれる。折りたたまれたものは見えないから、使われなさそうに思える。カスタムで作れば5つとも見せられるし、普段の見た目を真似るのは難しくない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放进系统导航栏的话，只剩三个，两个被折叠进 ⋯。被折叠的看不见，似乎就不会被用。自定义的话，五个都能显示，模仿平常的样子也不难。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放進系統導覽列的話，只剩三個，兩個被摺疊進 ⋯。被摺疊的看不見，似乎就不會被用。自定義的話，五個都能顯示，模仿平常的樣子也不難。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положите их в системную панель навигации, и останутся только три, а два свернутся в ⋯. Свёрнутое вне поля зрения, поэтому кажется, что им не станут пользоваться. Пользовательская панель может показать все пять, а подражать привычному виду нетрудно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponlos en la barra de navegación del sistema y solo quedan tres, con dos plegados en ⋯. Lo plegado queda fuera de la vista, así que parece que no se usará. Una barra personalizada puede mostrar los cinco, e imitar el aspecto habitual no es difícil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt du sie in die System-Navigationsleiste, bleiben nur drei, und zwei werden in ⋯ gefaltet. Was weggefaltet ist, ist außer Sicht, also scheint es nicht genutzt zu werden. Eine eigene Leiste kann alle fünf zeigen, und das übliche Aussehen nachzuahmen ist nicht schwer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez-les dans la barre de navigation système et il n'en reste que trois, avec deux repliés dans ⋯. Ce qui est replié est hors de vue, donc il semble qu'il ne sera pas utilisé. Une barre personnalisée peut montrer les cinq, et imiter l'aspect habituel n'est pas difficile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettili nella barra di navigazione di sistema e ne restano solo tre, con due ripiegati in ⋯. Quello che è ripiegato è fuori vista, quindi sembra che non verrà usato. Una barra personalizzata può mostrarne cinque, e imitare l'aspetto abituale non è difficile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponha-os na barra de navegação do sistema e restam só três, com dois dobrados em ⋯. O que é dobrado fica fora de vista, então parece que não será usado. Uma barra personalizada pode mostrar os cinco, e imitar o visual de sempre não é difícil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ในแถบนำทางของระบบแล้วเหลือแค่สาม โดยสองถูกพับเข้า ⋯ อะไรที่พับไปพ้นสายตา จึงดูเหมือนจะไม่ถูกใช้ แถบที่กำหนดเองแสดงได้ทั้งห้า และการเลียนแบบรูปลักษณ์ปกติไม่ยาก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa vào thanh điều hướng hệ thống thì chỉ còn ba, hai cái gập vào ⋯. Cái bị gập thì khuất mắt, nên có vẻ sẽ không được dùng. Thanh tùy chỉnh hiện được cả năm, và bắt chước vẻ thông thường không khó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte je do systémového navigačního panelu a zůstanou jen tři, dvě sbalená do ⋯. Cokoli sbaleného je z dohledu, takže se zdá, že se to používat nebude. Vlastní panel může ukázat všech pět a napodobit obvyklý vzhled není těžké."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg dem i systemets navigationsbjælke, og kun tre bliver tilbage, med to foldet ind i ⋯. Alt, der er foldet væk, er ude af syne, så det ser ud til, at det ikke vil blive brugt. En brugerdefineret bjælke kan vise alle fem, og at efterligne det sædvanlige udseende er ikke svært."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλ' τα στη γραμμή πλοήγησης συστήματος και απομένουν μόνο τρία, με δύο διπλωμένα στο ⋯. Ό,τι διπλώνεται είναι εκτός θέας, οπότε φαίνεται ότι δεν θα χρησιμοποιηθεί. Μια προσαρμοσμένη γραμμή μπορεί να δείξει και τα πέντε, και η μίμηση της συνηθισμένης όψης δεν είναι δύσκολη."
          }
        }
      }
    },
    "시스템 내비바와 커스텀 타이틀 바를 동시에": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the system navigation bar and a custom title bar at the same time"
