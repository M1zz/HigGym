        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールの短い画面にこの組み合わせを適用"
          }
        }
      }
    },
    "스크롤하면 버튼 글자가 사진과 뒤섞임": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Button labels blend into the photos as you scroll"
