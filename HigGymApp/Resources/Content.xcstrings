    },
    "위: 취소/저장, 중앙: 편집 모드, 하단: 세부 도구": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel/Save at the top, edit mode in the center, detailed tools at the bottom"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel/Save at the top, edit mode in the centre, detailed tools at the bottom"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上：キャンセル/保存、中央：編集モード、下：細かいツール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上：取消/存储，中：编辑模式，底部：细节工具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上：取消/儲存，中：編輯模式，底部：細節工具"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отмена/Сохранить» сверху, режим редактирования по центру, подробные инструменты снизу"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar/Guardar arriba, modo de edición en el centro, herramientas detalladas abajo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
