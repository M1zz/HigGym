          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil fremhæve søgning, så du lagde den på den stærkeste plads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις να τονίσεις την αναζήτηση, οπότε τη βάζεις στην πιο δυνατή θέση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluat korostaa hakua, joten laitat sen vahvimpaan paikkaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu ingin menekankan pencarian, jadi kamu menaruhnya di tempat terkuat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil fremheve søk, så du setter det på den sterkeste plassen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wilt zoeken benadrukken, dus je zet het op de sterkste plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcesz podkreślić wyszukiwanie, więc umieszczasz je w najmocniejszym miejscu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vill betona sökningen, så du lägger den på den starkaste platsen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aramayı vurgulamak istiyorsun, bu yüzden en güçlü yere koyuyorsun."
          }
        }
      }
    },
    "검색을 거의 안 쓰는 화면에 검색 필드를 상시 노출": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A search field always on display on a screen where search is barely used"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A search field always on display on a screen where search is barely used"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索をほとんど使わない画面に、検索フィールドを常に表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
