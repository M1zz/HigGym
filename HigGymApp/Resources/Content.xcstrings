        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρυμμένη στη λεπτομέρεια"
          }
        }
      }
    },
    "상시 노출되는 자리라 정보를 더 담고 싶다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's always visible, so you want it to hold more information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's always visible, so you want it to hold more information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に表示される場所なので、もっと情報を載せたい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是常驻显示的位置，想多放一些信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是常駐顯示的位置，想多放一些資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она всегда видна, поэтому хочется, чтобы она несла больше информации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre está visible, así que quieres que contenga más información."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ist immer sichtbar, also soll sie mehr Information tragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est toujours visible, donc vous voulez qu'elle porte plus d'informations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È sempre visibile, quindi vuoi che contenga più informazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está sempre visível, então você quer que guarde mais informação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มองเห็นตลอด คุณจึงอยากให้มันถือข้อมูลมากขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó luôn hiển thị, nên bạn muốn nó chứa nhiều thông tin hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je vždy viditelný, takže chcete, aby držel víc informací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er altid synlig, så du vil have den til at rumme mere information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι πάντα ορατή, οπότε θέλεις να κρατά περισσότερη πληροφορία."
          }
        }
      }
    },
    "상시 노출되는 자리라 캠페인을 확실히 보여줄 수 있을 것 같다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a spot that's always visible, so it seems like a sure way to showcase campaigns."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a spot that's always visible, so it seems like a sure way to showcase campaigns."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に表示される場所なので、キャンペーンを確実に見せられそうだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是常驻显示的位置，似乎能确实展示活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是常駐顯示的位置，似乎能確實展示活動。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это место всегда на виду, поэтому кажется надёжным способом показать акции."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un sitio siempre visible, así que parece una forma segura de exhibir campañas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein immer sichtbarer Platz, also scheint er ein sicherer Weg, Kampagnen zu präsentieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un emplacement toujours visible, donc il paraît un moyen sûr de mettre en vitrine des campagnes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un posto sempre visibile, quindi sembra un modo sicuro per mettere in mostra le campagne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um lugar sempre visível, então parece uma forma segura de pôr campanhas em vitrine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นตำแหน่งที่มองเห็นตลอด จึงดูเหมือนวิธีแน่นอนในการโชว์แคมเปญ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là chỗ luôn hiển thị, nên có vẻ là cách chắc chắn để trưng chiến dịch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to místo, které je vždy vidět, takže se zdá jistým způsobem, jak vystavit kampaně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en plads, der altid er synlig, så den virker som en sikker måde at fremvise kampagner på."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι ένα σημείο που είναι πάντα ορατό, οπότε φαίνεται σίγουρος τρόπος να προβάλεις καμπάνιες."
          }
        }
      }
    },
    "상위 뷰의 선택 허용을 걷어 내고, 주문번호와 주소처럼 옮겨 쓸 값에만 건다. 버튼은 다시 버튼으로만 동작하고, 길게 눌러 선택되는 텍스트는 그 자체로 \"가져가도 되는 값\"이라는 표시가 된다. 2.1.5 예제에서 선택이 허용된 텍스트가 어떻게 동작하는지 확인할 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the selection setting from the parent view and apply it only to values people will copy, like the order number and the address. Buttons go back to acting only as buttons, and text that can be selected with a long press becomes, by itself, a marker that says \"this is a value you can take.\" The 2.1.5 example shows how selectable text behaves."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the selection setting from the parent view and apply it only to values people will copy, like the order number and the address. Buttons go back to acting only as buttons, and text that can be selected with a long press becomes, by itself, a marker that says \"this is a value you can take.\" The 2.1.5 example shows how selectable text behaves."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "親ビューの選択許可を取り除き、注文番号や住所のように書き写す値にだけかける。ボタンは再びボタンとしてだけ動作し、長押しで選択できるテキストは、それ自体が「持ち出してよい値」という目印になる。選択が許可されたテキストがどう動作するかは、2.1.5の例で確かめられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉上层视图的选择许可，只加在订单号、地址这类需要抄写的值上。按钮还是只当按钮用，可长按选中的文字，本身就成了“可以拿走的值”的标记。在 2.1.5 示例里可以确认允许选择的文字是怎么运作的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉上層檢視的選擇許可，只加在訂單號、地址這類需要抄寫的值上。按鈕還是隻當按鈕用，可長按選中的文字，本身就成了「可以拿走的值」的標記。在 2.1.5 示例裡可以確認允許選擇的文字是怎麼運作的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите разрешение выделения с родительского представления и применяйте его только к значениям, которые люди будут копировать, вроде номера заказа и адреса. Кнопки снова работают только как кнопки, а текст, выделяемый долгим нажатием, сам становится маркером «это значение, которое можно забрать». Пример 2.1.5 показывает, как ведёт себя выделяемый текст."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita el ajuste de selección de la vista padre y aplícalo solo a los valores que la gente copiará, como el número de pedido y la dirección. Los botones vuelven a actuar solo como botones, y el texto que se puede seleccionar con una pulsación larga pasa a ser, por sí solo, una marca que dice «este es un valor que te puedes llevar». El ejemplo 2.1.5 muestra cómo se comporta el texto seleccionable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne die Auswahleinstellung von der übergeordneten Ansicht und wende sie nur auf Werte an, die Menschen kopieren werden, wie Bestellnummer und Adresse. Buttons agieren wieder nur als Buttons, und Text, der sich per langem Drücken auswählen lässt, wird allein dadurch zu einer Markierung, die sagt „das ist ein Wert, den du mitnehmen kannst“. Das Beispiel 2.1.5 zeigt, wie auswählbarer Text sich verhält."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez le réglage de sélection de la vue parente et n'appliquez-le qu'aux valeurs que les gens copieront, comme le numéro de commande et l'adresse. Les boutons redeviennent de simples boutons, et le texte sélectionnable par appui long devient, à lui seul, un repère qui dit « c'est une valeur que vous pouvez emporter ». L'exemple 2.1.5 montre comment se comporte un texte sélectionnable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli l'impostazione di selezione dalla vista genitore e applicala solo ai valori che le persone copieranno, come il numero d'ordine e l'indirizzo. I pulsanti tornano ad agire solo come pulsanti, e il testo selezionabile con una pressione prolungata diventa, da solo, un segnale che dice «questo è un valore che puoi portare via». L'esempio 2.1.5 mostra come si comporta il testo selezionabile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova o ajuste de seleção da view pai e aplique-o apenas aos valores que as pessoas copiarão, como o número do pedido e o endereço. Os botões voltam a agir só como botões, e o texto selecionável com pressão prolongada passa a ser, por si só, uma marca que diz «este é um valor que você pode levar». O exemplo 2.1.5 mostra como o texto selecionável se comporta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาการตั้งค่าการเลือกออกจาก view แม่ และใช้เฉพาะกับค่าที่คนจะคัดลอก เช่นเลขคำสั่งซื้อและที่อยู่ ปุ่มกลับไปทำหน้าที่เป็นปุ่มอย่างเดียว และข้อความที่เลือกได้ด้วยการกดค้างกลายเป็นเครื่องหมายในตัวเองที่บอกว่า \"นี่คือค่าที่คุณหยิบไปได้\" ตัวอย่าง 2.1.5 แสดงว่าข้อความที่เลือกได้ทำงานอย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ thiết lập chọn khỏi view cha và chỉ áp cho các giá trị người ta sẽ sao chép, như mã đơn hàng và địa chỉ. Nút lại chỉ làm nút, và văn bản chọn được bằng nhấn giữ tự nó trở thành dấu hiệu nói \"đây là giá trị bạn có thể mang đi.\" Ví dụ 2.1.5 cho thấy văn bản chọn được hoạt động ra sao."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeberte nastavení výběru z nadřazeného view a použijte ho jen na hodnoty, které lidé zkopírují, jako číslo objednávky a adresa. Tlačítka se vrátí k tomu, že fungují jen jako tlačítka, a text, který lze vybrat dlouhým stiskem, se sám stane značkou, která říká „toto je hodnota, kterou můžete vzít s sebou“. Příklad 2.1.5 ukazuje, jak se vybíratelný text chová."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern markeringsindstillingen fra den overordnede visning, og anvend den kun på værdier, folk vil kopiere, som ordrenummeret og adressen. Knapper går tilbage til kun at virke som knapper, og tekst, der kan markeres med et langt tryk, bliver i sig selv en markør, der siger »dette er en værdi, du kan tage med.« Eksempel 2.1.5 viser, hvordan markérbar tekst opfører sig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεσε τη ρύθμιση επιλογής από την ανώτερη προβολή και εφάρμοσέ την μόνο σε τιμές που θα αντιγράψουν οι άνθρωποι, όπως ο αριθμός παραγγελίας και η διεύθυνση. Τα κουμπιά γυρίζουν να δρουν μόνο ως κουμπιά, και το κείμενο που μπορεί να επιλεγεί με παρατεταμένο πάτημα γίνεται, από μόνο του, δείκτης που λέει «αυτή είναι μια τιμή που μπορείς να πάρεις». Το παράδειγμα 2.1.5 δείχνει πώς συμπεριφέρεται το επιλέξιμο κείμενο."
          }
        }
      }
    },
    "상품 목록 화면 위에 검색창, 필터 칩 줄, 동기화 배너가 겹겹이 쌓여 있다. 아래에는 합계와 결제 버튼 바, 그 밑에 툴바가 있다. 작은 화면에서 열면 가운데 남은 띠에 상품이 한두 개 겨우 보인다. 목록을 보러 온 사람은 목록보다 바를 더 많이 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above a product list, a search field, a row of filter chips, and a sync banner are stacked layer upon layer. At the bottom there's a bar with the total and a checkout button, and a toolbar below that. Open it on a small screen, and the strip left in the middle barely shows one or two products. Someone who came to browse the list sees more bars than list."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Above a product list, a search field, a row of filter chips, and a sync banner are stacked layer upon layer. At the bottom there's a bar with the total and a checkout button, and a toolbar below that. Open it on a small screen, and the strip left in the middle barely shows one or two products. Someone who came to browse the list sees more bars than list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "商品リスト画面の上に、検索フィールド、フィルタチップの列、同期のバナーが何層にも重なっている。下には合計と決済ボタンのバー、さらにその下にツールバーがある。小さな画面で開くと、真ん中に残った帯に商品がやっと1つか2つ見えるだけだ。リストを見に来た人が、リストよりもバーを多く見ることになる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商品列表界面上方层层叠叠地堆着搜索框、筛选标签行、同步横幅。下面是合计和支付按钮栏，再下面是工具栏。在小屏幕上打开，中间剩下的那条带子里，勉强能看到一两件商品。来看列表的人，看栏比看列表还多。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商品列表介面上方層層疊疊地堆著搜尋框、篩選標籤行、同步橫幅。下面是合計和付款按鈕列，再下面是工具列。在小螢幕上開啟，中間剩下的那條帶子裡，勉強能看到一兩件商品。來看列表的人，看列比看列表還多。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Над списком товаров слой за слоем наложены поле поиска, ряд чипов-фильтров и баннер синхронизации. Внизу панель с итогом и кнопкой оплаты, а под ней панель инструментов. Откройте на маленьком экране, и в оставшейся посередине полосе едва виден один-два товара. Тот, кто пришёл посмотреть список, видит больше панелей, чем списка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre una lista de productos hay apilados, capa sobre capa, un campo de búsqueda, una fila de chips de filtro y un banner de sincronización. Abajo hay una barra con el total y un botón de pago, y una barra de herramientas debajo. Ábrelo en una pantalla pequeña y la franja que queda en medio apenas muestra uno o dos productos. Quien vino a recorrer la lista ve más barras que lista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über einer Produktliste sind ein Suchfeld, eine Reihe von Filter-Chips und ein Sync-Banner Schicht um Schicht gestapelt. Unten gibt es eine Leiste mit Summe und Bezahlen-Button und darunter eine Symbolleiste. Öffnet man es auf einem kleinen Bildschirm, zeigt der in der Mitte verbleibende Streifen kaum ein oder zwei Produkte. Wer die Liste durchstöbern wollte, sieht mehr Leisten als Liste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-dessus d'une liste de produits, un champ de recherche, une rangée de puces de filtre et une bannière de synchronisation sont empilés couche après couche. En bas, il y a une barre avec le total et un bouton de paiement, et une barre d'outils en dessous. Ouvrez-le sur un petit écran, et la bande qui reste au milieu montre à peine un ou deux produits. Quelqu'un venu parcourir la liste voit plus de barres que de liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopra un elenco di prodotti sono impilati strato su strato un campo di ricerca, una riga di chip di filtro e un banner di sincronizzazione. In basso c'è una barra con il totale e un pulsante di pagamento, e una barra degli strumenti sotto. Aprila su uno schermo piccolo e la fascia rimasta al centro mostra a malapena uno o due prodotti. Chi è venuto a sfogliare l'elenco vede più barre che elenco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acima de uma lista de produtos, um campo de busca, uma linha de chips de filtro e um banner de sincronização estão empilhados camada sobre camada. Embaixo há uma barra com o total e um botão de finalizar a compra, e uma barra de ferramentas abaixo dela. Abra numa tela pequena e a faixa que sobra no meio mal mostra um ou dois produtos. Quem veio para navegar pela lista vê mais barras do que lista."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหนือรายการสินค้า ช่องค้นหา แถวชิปตัวกรอง และแบนเนอร์ซิงค์ซ้อนกันชั้นแล้วชั้นเล่า ด้านล่างมีแถบที่มียอดรวมและปุ่มชำระเงิน และแถบเครื่องมืออยู่ใต้นั้น เปิดบนหน้าจอเล็ก แถบที่เหลือตรงกลางแสดงสินค้าแทบไม่ถึงหนึ่งหรือสองชิ้น คนที่มาเรียกดูรายการเห็นแถบมากกว่ารายการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phía trên danh sách sản phẩm, một ô tìm kiếm, một hàng chip lọc và một banner đồng bộ chồng lớp lên lớp. Ở dưới có thanh với tổng tiền và nút thanh toán, và một thanh công cụ bên dưới nữa. Mở trên màn hình nhỏ, dải còn lại ở giữa chỉ vừa lộ một hai sản phẩm. Người đến để duyệt danh sách thấy thanh nhiều hơn danh sách."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad seznamem produktů je vrstva na vrstvě vyhledávací pole, řada filtračních čipů a banner synchronizace. Dole je panel s celkem a tlačítkem platby a pod ním panel nástrojů. Otevřete to na malé obrazovce a pruh, který zůstane uprostřed, sotva ukáže jeden nebo dva produkty. Kdo přišel procházet seznam, vidí víc panelů než seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Over en produktliste er et søgefelt, en række filterchips og et synkroniseringsbanner stablet lag på lag. I bunden er der en bjælke med totalen og en betalingsknap og en værktøjslinje under den. Åbn den på en lille skærm, og strimlen, der er tilbage i midten, viser knap et eller to produkter. Den, der kom for at gennemse listen, ser flere bjælker end liste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάνω από μια λίστα προϊόντων, ένα πεδίο αναζήτησης, μια σειρά chips φίλτρων και ένα banner συγχρονισμού είναι στοιβαγμένα στρώμα στο στρώμα. Κάτω υπάρχει μια γραμμή με το σύνολο και ένα κουμπί ταμείου, και μια γραμμή εργαλείων από κάτω. Άνοιξέ το σε μικρή οθόνη, και η λωρίδα που απομένει στη μέση δείχνει μετά βίας ένα ή δύο προϊόντα. Όποιος ήρθε να περιηγηθεί στη λίστα βλέπει περισσότερες γραμμές παρά λίστα."
          }
        }
      }
    },
    "상하 바 합계가 화면의 40%를 점유": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top and bottom bars together taking up 40% of the screen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Top and bottom bars together taking up 40% of the screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下のバーが合わせて画面の40%を占める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下栏合计占了屏幕的 40%"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下列合計佔了螢幕的 40%"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верхняя и нижняя панели вместе занимают 40 % экрана"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras superior e inferior juntas ocupan el 40 % de la pantalla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obere und untere Leisten zusammen nehmen 40 % des Bildschirms ein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les barres du haut et du bas ensemble occupant 40 % de l'écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre in alto e in basso insieme che occupano il 40% dello schermo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Barras superior e inferior juntas ocupando 40% da tela"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบด้านบนและด้านล่างรวมกันกินหน้าจอ 40%"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh trên và dưới gộp lại chiếm 40% màn hình"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Horní a dolní panely dohromady zabírají 40 % obrazovky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øverste og nederste bjælker tilsammen optager 40 % af skærmen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πάνω και κάτω γραμμές μαζί καταλαμβάνουν το 40% της οθόνης"
          }
        }
      }
    },
    "새 글을 탭에서 빼고 목록 화면 툴바의 버튼으로 옮긴다. 누르면 시트가 뜨는 것은 같지만, 이제 버튼 모양이 그 동작을 정직하게 말한다. 탭바에는 목적지만 남아 어느 탭을 눌러도 그 탭의 화면에 머문다. 앱의 3.4.4 Prominent Role 예제에서 강조된 탭이 장소로 쓰이는 모습을 보면 차이가 선명하다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take New Post out of the tabs and move it to a button in the list screen's toolbar. Tapping it still opens a sheet, but now the button's shape honestly says what it does. Only destinations remain in the tab bar, so whichever tab you tap, you stay on that tab's screen. Look at the app's 3.4.4 Prominent Role example, where the highlighted tab is used as a place, and the difference is sharp."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Take New Post out of the tabs and move it to a button in the list screen's toolbar. Tapping it still opens a sheet, but now the button's shape honestly says what it does. Only destinations remain in the tab bar, so whichever tab you tap, you stay on that tab's screen. Look at the app's 3.4.4 Prominent Role example, where the highlighted tab is used as a place, and the difference is sharp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規投稿をタブから外し、リスト画面のツールバーのボタンに移す。タップするとシートが出るのは同じだが、今度はボタンの形がその動作を正直に伝える。タブバーには目的地だけが残り、どのタブをタップしてもそのタブの画面にとどまる。アプリの 3.4.4 Prominent Role の例で、強調されたタブが場所として使われる様子を見ると違いが鮮明になる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把新帖从标签里撤下，移到列表界面工具栏的按钮里。点按后弹出弹层是一样的，但现在按钮的外形诚实地说出了这个动作。标签栏只剩目的地，点哪个标签都停留在那个标签的界面。在应用的 3.4.4 Prominent Role 示例里看被强调的标签作为地点使用的样子，差别很清楚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把新帖從標籤裡撤下，移到列表介面工具列的按鈕裡。輕點後彈出工作表是一樣的，但現在按鈕的外形誠實地說出了這個動作。標籤列只剩目的地，點哪個標籤都停留在那個標籤的介面。在應用程式的 3.4.4 Prominent Role 示例裡看被強調的標籤作為地點使用的樣子，差別很清楚。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите «Новую запись» из вкладок и перенесите её в кнопку на панели инструментов экрана списка. Нажатие по-прежнему открывает шторку, но теперь форма кнопки честно говорит, что она делает. В панели вкладок остаются только места назначения, поэтому какую бы вкладку вы ни нажали, вы остаётесь на экране этой вкладки. Посмотрите пример 3.4.4 Prominent Role, где подчёркнутая вкладка используется как место, и разница резкая."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saca Nueva publicación de las pestañas y llévala a un botón en la barra de herramientas de la pantalla de lista. Al tocarlo sigue abriendo una hoja, pero ahora la forma del botón dice con honestidad lo que hace. En la barra de pestañas solo quedan destinos, así que toques la pestaña que toques, te quedas en la pantalla de esa pestaña. Mira el ejemplo 3.4.4 Prominent Role de la app, donde la pestaña destacada se usa como un lugar, y la diferencia es nítida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm Neuer Beitrag aus den Tabs und verschiebe ihn in einen Button in der Symbolleiste des Listenbildschirms. Antippen öffnet weiterhin ein Sheet, aber nun sagt die Form des Buttons ehrlich, was er tut. In der Tab-Leiste bleiben nur Ziele, sodass du bei jedem angetippten Tab auf dem Bildschirm dieses Tabs bleibst. Sieh dir das Beispiel 3.4.4 Prominent Role der App an, in dem der hervorgehobene Tab als Ort genutzt wird, und der Unterschied ist scharf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez Nouvelle publication des onglets et déplacez-la vers un bouton dans la barre d'outils de l'écran de liste. Le toucher ouvre toujours une feuille, mais maintenant la forme du bouton dit honnêtement ce qu'il fait. Il ne reste que des destinations dans la barre d'onglets, donc quel que soit l'onglet touché, vous restez sur l'écran de cet onglet. Regardez l'exemple 3.4.4 Prominent Role de l'app, où l'onglet mis en avant est utilisé comme un lieu, et la différence est nette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Togli Nuovo post dalle schede e spostalo in un pulsante nella barra degli strumenti della schermata a elenco. Toccandolo si apre comunque un foglio, ma ora la forma del pulsante dice onestamente che cosa fa. Nella barra delle schede restano solo le destinazioni, quindi qualunque scheda tocchi, resti sulla schermata di quella scheda. Guarda l'esempio 3.4.4 Ruolo prominent dell'app, in cui la scheda evidenziata è usata come luogo, e la differenza è netta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire Nova publicação das abas e mova para um botão na barra de ferramentas da tela de lista. Tocar nele ainda abre uma folha, mas agora a forma do botão diz com honestidade o que ele faz. Na barra de abas restam só destinos, então qualquer aba em que você toque, você fica na tela daquela aba. Veja o exemplo 3.4.4 Papel prominent do app, em que a aba destacada é usada como lugar, e a diferença é nítida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาโพสต์ใหม่ออกจากแท็บและย้ายไปเป็นปุ่มในแถบเครื่องมือของหน้ารายการ แตะแล้วยังเปิดชีต แต่ตอนนี้รูปทรงของปุ่มบอกตรง ๆ ว่ามันทำอะไร เหลือแต่จุดหมายปลายทางในแถบแท็บ ไม่ว่าแตะแท็บไหน คุณก็อยู่ที่หน้าจอของแท็บนั้น ดูตัวอย่าง 3.4.4 Prominent Role ของแอปที่แท็บที่เน้นถูกใช้เป็นสถานที่ ความต่างก็ชัด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa Bài đăng mới ra khỏi các tab và chuyển thành nút trong thanh công cụ của màn hình danh sách. Chạm vẫn mở sheet, nhưng giờ hình dạng nút nói thật điều nó làm. Thanh tab chỉ còn các điểm đến, nên chạm tab nào bạn cũng ở lại màn hình của tab đó. Xem ví dụ 3.4.4 Prominent Role của app, nơi tab nổi bật được dùng như một nơi chốn, và sự khác biệt rất rõ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyjměte Nový příspěvek z karet a přesuňte ho na tlačítko v panelu nástrojů obrazovky se seznamem. Klepnutí stále otevře sheet, ale teď tvar tlačítka upřímně říká, co dělá. V panelu karet zůstávají jen cíle, takže ať klepnete na kteroukoli kartu, zůstanete na obrazovce té karty. Podívejte se na příklad 3.4.4 Prominent Role aplikace, kde se zvýrazněná karta používá jako místo, a rozdíl je ostrý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag Nyt opslag ud af fanerne, og flyt det til en knap i listeskærmens værktøjslinje. Et tryk åbner stadig et ark, men nu siger knappens form ærligt, hvad den gør. Kun destinationer er tilbage i fanelinjen, så uanset hvilken fane du trykker på, bliver du på den fanes skærm. Se appens eksempel 3.4.4 Fremhævet rolle, hvor den fremhævede fane bruges som et sted, så er forskellen skarp."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βγάλε τη Νέα ανάρτηση από τις καρτέλες και μετάφερέ την σε κουμπί στη γραμμή εργαλείων της οθόνης λίστας. Το πάτημά της ανοίγει ακόμα ένα φύλλο, αλλά τώρα το σχήμα του κουμπιού λέει ειλικρινά τι κάνει. Μόνο προορισμοί απομένουν στη γραμμή καρτελών, οπότε όποια καρτέλα κι αν πατήσεις, μένεις στην οθόνη εκείνης της καρτέλας. Δες το παράδειγμα 3.4.4 Prominent Role της εφαρμογής, όπου η προβεβλημένη καρτέλα χρησιμοποιείται ως μέρος, και η διαφορά είναι έντονη."
          }
        }
      }
    },
    "새 배치로 옮기면서 예전 것을 지우지 못했다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you moved to the new placement, you couldn't bring yourself to remove the old one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you moved to the new placement, you couldn't bring yourself to remove the old one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい配置に移すときに、以前のものを消しきれなかった。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到新布局时，没把旧的删掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移到新佈局時，沒把舊的刪掉。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдя на новое расположение, вы не смогли решиться убрать старое."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando pasaste a la nueva colocación, no te atreviste a quitar la antigua."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als du zur neuen Platzierung gewechselt bist, konntest du dich nicht überwinden, die alte zu entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous êtes passé au nouveau placement, vous n'avez pas pu vous résoudre à retirer l'ancien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sei passato alla nuova collocazione, non te la sei sentita di togliere la vecchia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você passou para a nova posição, não teve coragem de remover a antiga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อย้ายไปการวางใหม่ คุณทำใจเอาอันเก่าออกไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi chuyển sang vị trí mới, bạn không nỡ bỏ vị trí cũ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když jste přešli na nové umístění, nedokázali jste se přimět odstranit staré."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Da du flyttede til den nye placering, kunne du ikke få dig selv til at fjerne den gamle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν μετακινήθηκες στη νέα θέση, δεν μπορούσες να πείσεις τον εαυτό σου να αφαιρέσεις την παλιά."
          }
        }
      }
    },
    "새 이름을 붙일 때 아이콘과 라벨 중 어느 쪽이 \"이미 아는 것\"인지 짚는다. 둘 다 새롭다면 하나를 양보한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you give something a new name, pin down which of the icon and the label is \"already familiar.\" If both are new, give one of them up."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you give something a new name, pin down which of the icon and the label is \"already familiar.\" If both are new, give one of them up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい名前を付けるときは、アイコンとラベルのどちらが「すでに知っているもの」かを確かめる。両方が新しいなら、どちらかを譲る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起新名字时，先指出图标和标签哪一个是“已经知道的”。两个都是新的，就让出一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "起新名字時，先指出圖示和標籤哪一個是「已經知道的」。兩個都是新的，就讓出一個。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Давая новое название, определите, что из значка и подписи «уже знакомо». Если оба новые, откажитесь от одного."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando le des un nombre nuevo a algo, fija cuál de los dos, el icono o la etiqueta, es «ya conocido». Si ambos son nuevos, renuncia a uno de ellos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibst du etwas einen neuen Namen, lege fest, was von Symbol und Beschriftung „bereits vertraut“ ist. Sind beide neu, gib eines davon auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous donnez un nouveau nom à quelque chose, précisez lequel de l'icône et du libellé est « déjà familier ». Si les deux sont nouveaux, renoncez à l'un des deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dai a qualcosa un nuovo nome, stabilisci quale tra l'icona e l'etichetta è «già familiare». Se entrambe sono nuove, rinuncia a una delle due."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você dá um novo nome a algo, defina qual entre o ícone e o rótulo «já é familiar». Se ambos são novos, abra mão de um deles."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อตั้งชื่อใหม่ ให้ระบุว่าไอคอนกับป้ายชื่ออันไหน \"คุ้นเคยอยู่แล้ว\" ถ้าทั้งสองใหม่ ให้สละหนึ่งอัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đặt tên mới cho thứ gì, hãy xác định giữa biểu tượng và nhãn, cái nào \"đã quen thuộc.\" Nếu cả hai đều mới, hãy bỏ một."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když něčemu dáváte nový název, ujasněte si, co z ikony a popisku je „už známé“. Pokud jsou oba nové, vzdejte se jednoho z nich."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du giver noget et nyt navn, så afgør, hvilken af ikonet og etiketten der »allerede er velkendt.« Hvis begge er nye, så opgiv den ene."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν δίνεις σε κάτι νέο όνομα, ξεκαθάρισε ποιο από το εικονίδιο και την ετικέτα είναι «ήδη οικείο». Αν και τα δύο είναι νέα, παράτησε το ένα."
          }
        }
      }
    },
    "새 이벤트 작성처럼 입력이 많은 폼 시트": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An input-heavy form sheet, such as creating a new event"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An input-heavy form sheet, such as creating a new event"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規イベントの作成のように、入力の多いフォームのシート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像新建活动这样输入很多的表单弹层"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像新建活動這樣輸入很多的表單工作表"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма-шторка с большим количеством ввода, например создание нового события"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja de formulario cargada de entradas, como crear un evento nuevo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein eingabelastiges Formular-Sheet, etwa zum Anlegen eines neuen Termins"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une feuille de formulaire riche en saisie, comme la création d'un nouvel événement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un foglio con modulo ricco di input, come la creazione di un nuovo evento"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma folha de formulário carregada de entrada, como criar um novo evento"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีตฟอร์มที่เน้นการกรอก เช่นการสร้างกิจกรรมใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một sheet biểu mẫu nặng nhập liệu, như tạo sự kiện mới"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet s formulářem náročným na zadávání, například vytvoření nové události"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et inputtungt formularark, som oprettelse af en ny begivenhed"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα φύλλο φόρμας με πολλή εισαγωγή, όπως η δημιουργία νέας εκδήλωσης"
          }
        }
      }
    },
    "새 화면을 만들 때 효과를 고르지 않는다. 정해 둔 문장에 대입한다. 문장이 답하지 못하는 화면이 나오면 그때 문장을 고친다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you build a new screen, don't pick an effect. Run it through the sentence you settled on. If a screen comes along that the sentence can't answer, that's when you revise the sentence."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you build a new screen, don't pick an effect. Run it through the sentence you settled on. If a screen comes along that the sentence can't answer, that's when you revise the sentence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい画面を作るときは、エフェクトを選ばない。決めておいたひと文に当てはめる。ひと文が答えられない画面が出てきたら、そのときにひと文を直す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做新界面时不去挑效果，而是代入已定的那句话。遇到句子回答不了的界面，再去改句子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做新介面時不去挑效果，而是代入已定的那句話。遇到句子回答不了的介面，再去改句子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делая новый экран, не выбирайте эффект. Прогоните его через ту фразу, на которой остановились. Если попадётся экран, на который фраза не отвечает, тогда пересматривайте фразу."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando construyas una pantalla nueva, no elijas un efecto. Pásala por la frase que fijaste. Si llega una pantalla que la frase no puede responder, ese es el momento de revisar la frase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle beim Bau eines neuen Bildschirms keinen Effekt aus. Lass ihn durch den Satz laufen, auf den du dich festgelegt hast. Kommt ein Bildschirm, den der Satz nicht beantworten kann, ist das der Moment, den Satz zu überarbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous construisez un nouvel écran, ne choisissez pas un effet. Passez-le au crible de la phrase que vous avez arrêtée. Si un écran arrive auquel la phrase ne peut répondre, c'est le moment de réviser la phrase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando costruisci una nuova schermata, non scegliere un effetto. Passala attraverso la frase che hai fissato. Se arriva una schermata a cui la frase non sa rispondere, è allora che rivedi la frase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você constrói uma tela nova, não escolha um efeito. Passe-a pela frase que definiu. Se aparece uma tela que a frase não sabe responder, é aí que você revisa a frase."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อสร้างหน้าจอใหม่ อย่าเลือกเอฟเฟกต์ ให้ลองผ่านประโยคที่ตกลงไว้ ถ้ามีหน้าจอที่ประโยคตอบไม่ได้ นั่นคือตอนที่แก้ประโยค"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi xây màn hình mới, đừng chọn hiệu ứng. Hãy đem nó qua câu bạn đã chốt. Nếu có màn hình mà câu đó không trả lời được, đó là lúc sửa câu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když stavíte novou obrazovku, nevybírejte efekt. Proveďte ji větou, kterou jste ustálili. Pokud přijde obrazovka, na kterou věta neodpoví, je to chvíle, kdy větu revidujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du bygger en ny skærm, så vælg ikke en effekt. Kør den gennem den sætning, du nåede frem til. Hvis der kommer en skærm, som sætningen ikke kan besvare, er det da, du reviderer sætningen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν φτιάχνεις νέα οθόνη, μην διαλέγεις εφέ. Πέρασέ την από την πρόταση στην οποία κατέληξες. Αν εμφανιστεί μια οθόνη που η πρόταση δεν μπορεί να απαντήσει, τότε αναθεωρείς την πρόταση."
          }
        }
      }
    },
    "새 화면의 액션을 배치하기 전에 \"이걸 몇 번 누르는가\"를 먼저 적는다. 그 답이 높이를 정한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before laying out the actions on a new screen, first write down \"how many times is this tapped?\" That answer decides the height."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before laying out the actions on a new screen, first write down \"how many times is this tapped?\" That answer decides the height."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい画面のアクションを配置する前に、まず「これを何回押すか」を書き出す。その答えが高さを決める。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布置新界面的操作之前，先写下“这个要点几次”。这个答案决定高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佈置新介面的操作之前，先寫下「這個要點幾次」。這個答案決定高度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем раскладывать действия на новом экране, сначала запишите «сколько раз это нажимают?» Этот ответ определяет высоту."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de colocar las acciones de una pantalla nueva, anota primero «¿cuántas veces se toca esto?». Esa respuesta decide la altura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du die Aktionen auf einem neuen Bildschirm anordnest, schreibe zuerst auf: „Wie oft wird das angetippt?“ Diese Antwort entscheidet die Höhe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de disposer les actions d'un nouvel écran, écrivez d'abord « combien de fois cela est-il touché ? » Cette réponse décide de la hauteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di disporre le azioni su una nuova schermata, scrivi prima «quante volte viene toccato questo?» Quella risposta decide l'altezza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de dispor as ações numa tela nova, anote primeiro «quantas vezes isto é tocado?» Essa resposta decide a altura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนวางการกระทำบนหน้าจอใหม่ ให้เขียนก่อนว่า \"สิ่งนี้ถูกแตะกี่ครั้ง\" คำตอบนั้นตัดสินความสูง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi bố trí hành động trên màn hình mới, hãy viết trước \"cái này được chạm bao nhiêu lần?\" Câu trả lời đó quyết định chiều cao."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než rozvrhnete akce na nové obrazovce, nejdřív si napište „kolikrát se na to klepne?“ Ta odpověď určuje výšku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du lægger handlingerne ud på en ny skærm, så skriv først ned »hvor mange gange bliver dette trykket på?« Det svar afgør højden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν διατάξεις τις ενέργειες σε νέα οθόνη, γράψε πρώτα «πόσες φορές πατιέται αυτό;» Η απάντηση αποφασίζει το ύψος."
          }
        }
      }
    },
    "새로 만든 기능은 눈에 띄는 자리에 두고 싶다. 설정 안에 넣으면 아무도 못 찾을 것 같고, 탭바는 언제나 보이는 가장 확실한 자리다. 탭이 하나 늘면 앱 구조도 풍성해 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You want a new feature to sit somewhere prominent. Put it in Settings and it seems nobody will find it, while the tab bar is the surest spot, always visible. One more tab also makes the app's structure look richer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You want a new feature to sit somewhere prominent. Put it in Settings and it seems nobody will find it, while the tab bar is the surest spot, always visible. One more tab also makes the app's structure look richer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく作った機能は目立つ場所に置きたい。設定の中に入れたら誰にも見つけてもらえない気がするし、タブバーは常に見えるいちばん確実な場所だ。タブが1つ増えれば、アプリの構造も豊かに見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新做的功能想放在显眼的位置。放进设置里似乎没人能找到，而标签栏始终可见，是最稳妥的位置。多一个标签，应用结构也显得丰富。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新做的功能想放在顯眼的位置。放進設定裡似乎沒人能找到，而標籤列始終可見，是最穩妥的位置。多一個標籤，應用程式結構也顯得豐富。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новую функцию хочется поставить на видное место. Положите её в «Настройки», и, кажется, никто не найдёт, а панель вкладок - самое надёжное, всегда видимое место. Ещё одна вкладка к тому же делает структуру приложения богаче."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quieres que una función nueva esté en un sitio destacado. Ponla en Ajustes y parece que nadie la encontrará, mientras que la barra de pestañas es el sitio más seguro, siempre visible. Una pestaña más también hace que la estructura de la app parezca más rica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du willst eine neue Funktion an einem auffälligen Platz. Setzt du sie in die Einstellungen, findet sie scheinbar niemand, während die Tab-Leiste, immer sichtbar, der sicherste Platz ist. Ein Tab mehr lässt die Struktur der App auch reicher wirken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voulez qu'une nouvelle fonction se trouve à un endroit en vue. Mettez-la dans Réglages et il semble que personne ne la trouvera, alors que la barre d'onglets, toujours visible, est l'endroit le plus sûr. Un onglet de plus fait aussi paraître la structure de l'app plus riche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi che una nuova funzione stia in un punto in evidenza. Mettila nelle Impostazioni e sembra che nessuno la troverà, mentre la barra delle schede è il punto più sicuro, sempre visibile. Una scheda in più fa anche sembrare più ricca la struttura dell'app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você quer que uma funcionalidade nova fique em algum lugar de destaque. Ponha em Ajustes e parece que ninguém vai achar, enquanto a barra de abas é o lugar mais seguro, sempre visível. Mais uma aba também faz a estrutura do app parecer mais rica."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยากให้ฟีเจอร์ใหม่อยู่ที่ที่เด่น วางในการตั้งค่าแล้วดูเหมือนไม่มีใครเจอ ขณะที่แถบแท็บเป็นที่แน่นอนที่สุด มองเห็นตลอด อีกหนึ่งแท็บยังทำให้โครงสร้างของแอปดูร่ำรวยขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn tính năng mới nằm ở chỗ nổi bật. Đặt vào Cài đặt có vẻ không ai tìm thấy, trong khi thanh tab là chỗ chắc chắn nhất, luôn hiển thị. Thêm một tab cũng làm cấu trúc app trông phong phú hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete, aby nová funkce seděla na nápadném místě. Dát ji do Nastavení vypadá, že ji nikdo nenajde, zatímco panel karet je nejjistější místo, vždy viditelné. Jedna karta navíc také nechá strukturu aplikace vypadat bohatěji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil have en ny funktion til at sidde et fremtrædende sted. Læg den i Indstillinger, og det ser ud til, at ingen finder den, mens fanelinjen er det sikreste sted, altid synlig. Én fane mere får også appens struktur til at se rigere ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις μια νέα λειτουργία να κάθεται κάπου προβεβλημένα. Βάλ' την στις Ρυθμίσεις και φαίνεται ότι κανείς δεν θα τη βρει, ενώ η γραμμή καρτελών είναι το σιγουρότερο σημείο, πάντα ορατή. Μία καρτέλα ακόμα κάνει και τη δομή της εφαρμογής να φαίνεται πλουσιότερη."
          }
        }
      }
    },
    "새로 만든 기능이라 눈에 띄는 자리에 두고 싶다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a new feature, so you want it somewhere prominent."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a new feature, so you want it somewhere prominent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく作った機能なので、目立つ場所に置きたい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是新做的功能，所以想放在显眼的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是新做的功能，所以想放在顯眼的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это новая функция, поэтому хочется поставить её на видное место."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una función nueva, así que quieres que esté en un sitio destacado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist eine neue Funktion, also willst du sie an einem auffälligen Platz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est une nouvelle fonction, donc vous la voulez à un endroit en vue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una funzione nuova, quindi la vuoi in un punto in evidenza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É uma funcionalidade nova, então você a quer em algum lugar de destaque."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นฟีเจอร์ใหม่ คุณจึงอยากให้อยู่ที่ที่เด่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là tính năng mới nên bạn muốn nó ở chỗ nổi bật."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to nová funkce, takže ji chcete na nápadném místě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en ny funktion, så du vil have den et fremtrædende sted."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι νέα λειτουργία, οπότε τη θέλεις κάπου προβεβλημένα."
          }
        }
      }
    },
    "새로 생긴 동작을 켜기 전에 **\"이 화면에서 사용자는 읽는가, 옮겨 다니는가\"**를 먼저 묻는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before turning on a new behavior, first ask: **\"On this screen, is the user reading or moving around?\"**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before turning on a new behaviour, first ask: **\"On this screen, is the user reading or moving around?\"**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しくできた動作をオンにする前に、まず「**この画面でユーザーは読んでいるのか、移動しているのか**」を問う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开新出现的行为之前，先问**“在这个界面里，用户是在阅读，还是在来回移动？”**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟新出現的行為之前，先問**「在這個介面裡，使用者是在閱讀，還是在來回移動？」**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем включать новое поведение, сначала спросите: **«На этом экране пользователь читает или перемещается?»**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de activar un comportamiento nuevo, pregunta primero: **«En esta pantalla, ¿el usuario está leyendo o moviéndose?»**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage, bevor du ein neues Verhalten einschaltest, zuerst: **„Liest der Nutzer auf diesem Bildschirm oder bewegt er sich?“**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'activer un nouveau comportement, demandez d'abord : **« Sur cet écran, l'utilisateur lit-il ou se déplace-t-il ? »**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di attivare un nuovo comportamento, chiediti: **«In questa schermata, l'utente sta leggendo o si sta spostando?»**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de ativar um novo comportamento, pergunte primeiro: **«Nesta tela, o usuário está lendo ou circulando?»**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนเปิดพฤติกรรมใหม่ ให้ถามก่อน: **\"บนหน้าจอนี้ ผู้ใช้กำลังอ่านหรือเคลื่อนที่\"**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi bật một hành vi mới, hãy hỏi trước: **\"Trên màn hình này, người dùng đang đọc hay đang di chuyển?\"**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než zapnete nové chování, nejdřív se zeptejte: **„Čte uživatel na této obrazovce, nebo se pohybuje?“**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du slår en ny adfærd til, så spørg først: **»På denne skærm, læser brugeren, eller bevæger vedkommende sig rundt?«**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν ενεργοποιήσεις μια νέα συμπεριφορά, ρώτα πρώτα: **«Σε αυτή την οθόνη, ο χρήστης διαβάζει ή μετακινείται;»**"
          }
        }
      }
    },
    "새로 생긴 동작이라 일단 전 화면에 켜 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
