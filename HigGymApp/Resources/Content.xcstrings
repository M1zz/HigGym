            "value": "**Troncare importi e timer con il .tail predefinito** (viola 2.1.3)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Truncar valores monetários e cronômetros com o .tail padrão** (viola 2.1.3)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**การตัดจำนวนเงินและตัวจับเวลาด้วย .tail ค่าเริ่มต้น** (ฝ่าฝืน 2.1.3)"
          }
        },
        "vi": {
