        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่องค้นหาที่แสดงตลอดบนหน้าจอที่แทบไม่ใช้การค้นหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ô tìm kiếm luôn hiển thị trên màn hình hầu như không dùng tìm kiếm"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávací pole vždy zobrazené na obrazovce, kde se hledání skoro nepoužívá"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et søgefelt, der altid vises på en skærm, hvor søgning næsten ikke bruges"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα πεδίο αναζήτησης πάντα εμφανές σε οθόνη όπου η αναζήτηση σχεδόν δεν χρησιμοποιείται"
          }
        }
      }
    },
    "검색을 거의 안 쓰는데 minimize로라도 상시 배치(searchable 자체가 불필요)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search is barely used but stays on screen, even if minimized (searchable itself is unnecessary)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Search is barely used but stays on screen, even if minimised (searchable itself is unnecessary)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索をほとんど使わないのに、minimizeであっても常に配置（searchable自体が不要）"
