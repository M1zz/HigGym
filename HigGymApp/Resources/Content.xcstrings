    "커스텀 헤더를 넣으면서 시스템 제목을 끄는 것을 잊는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While adding a custom header, you forget to turn off the system title."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "While adding a custom header, you forget to turn off the system title."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムヘッダを入れるときに、システムのタイトルを消すのを忘れる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加了自定义标题区，却忘了把系统标题关掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加了自定義標題區，卻忘了把系統標題關掉。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляя пользовательскую шапку, вы забываете отключить системный заголовок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al añadir un encabezado personalizado, olvidas desactivar el título del sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Hinzufügen eines eigenen Headers vergisst du, den Systemtitel auszuschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ajoutant un en-tête personnalisé, vous oubliez de désactiver le titre système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre aggiungi un'intestazione personalizzata, ti dimentichi di disattivare il titolo di sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao acrescentar um cabeçalho personalizado, você esquece de desligar o título do sistema."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะเพิ่มส่วนหัวที่กำหนดเอง คุณลืมปิดชื่อเรื่องของระบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong lúc thêm header tùy chỉnh, bạn quên tắt tiêu đề hệ thống."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při přidávání vlastní hlavičky zapomenete vypnout systémový nadpis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens du tilføjer en brugerdefineret header, glemmer du at slå systemtitlen fra."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενώ προσθέτεις μια προσαρμοσμένη κεφαλίδα, ξεχνάς να απενεργοποιήσεις τον τίτλο του συστήματος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukautettua otsikkoa lisätessäsi unohdat kytkeä pois järjestelmän otsikon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat menambahkan header kustom, kamu lupa mematikan judul sistem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens du legger til en egendefinert header, glemmer du å slå av systemtittelen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terwijl je een aangepaste kop toevoegt, vergeet je de systeemtitel uit te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodając własny nagłówek, zapominasz wyłączyć tytuł systemowy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du lägger till ett eget rubrikfält glömmer du att stänga av systemrubriken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel bir başlık eklerken sistem başlığını kapatmayı unutursun."
          }
        }
      }
    },
    "커스텀과 시스템의 역할 분담": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom and system share the roles"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom and system share the roles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムとシステムの役割分担"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义与系统的角色分工"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自定義與系統的角色分工"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Роли делят пользовательское и системное"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo personalizado y lo del sistema se reparten las funciones"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigenes und System teilen sich die Rollen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le personnalisé et le système se partagent les rôles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizzato e di sistema si dividono i ruoli"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalizado e de sistema dividem os papéis"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ของกำหนดเองกับของระบบแบ่งบทบาทกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy chỉnh và hệ thống chia sẻ vai trò"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní a systémový prvek sdílejí role"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brugerdefineret og system deler rollerne"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ρόλοι μοιράζονται ανάμεσα σε προσαρμοσμένο και σύστημα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukautettu ja järjestelmä jakavat roolit"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustom dan sistem berbagi peran"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Egendefinert og system deler rollene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepast en systeem delen de rollen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własny i systemowy dzielą role"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eget och system delar rollerna"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel ve sistem rolleri paylaşır"
          }
        }
      }
    },
    "커스텀이어도 \"제목처럼\" 행동해야 합니다, 여기에 버튼·입력 필드를 넣는 건 자리의 문법 위반.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when custom, it has to behave \"like a title.\" Putting buttons or input fields here breaks the slot's grammar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when custom, it has to behave \"like a title.\" Putting buttons or input fields here breaks the slot's grammar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムでも「タイトルらしく」振る舞わなければなりません。ここにボタンや入力フィールドを入れるのは、この位置の文法に違反します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使是自定义，也要“像标题一样”行事：在这里放按钮、输入框，违反了位置的语法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使是自定義，也要「像標題一樣」行事：在這裡放按鈕、輸入框，違反了位置的語法。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже будучи своим, он должен вести себя «как заголовок». Кнопки или поля ввода здесь нарушают грамматику слота."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso siendo personalizado, tiene que comportarse «como un título». Poner aquí botones o campos de entrada rompe la gramática del sitio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch wenn es eigen ist, muss es sich „wie ein Titel“ verhalten. Buttons oder Eingabefelder hierhin zu setzen, bricht die Grammatik des Platzes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même personnalisé, il doit se comporter « comme un titre ». Y mettre des boutons ou des champs de saisie brise la grammaire de l'emplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche quando è personalizzato, deve comportarsi «come un titolo». Mettere qui pulsanti o campi di input rompe la grammatica dello slot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo personalizado, precisa se comportar «como um título». Pôr botões ou campos de entrada aqui quebra a gramática do lugar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้เป็นแบบกำหนดเอง มันต้องทำงาน \"เหมือนชื่อเรื่อง\" การวางปุ่มหรือช่องกรอกที่นี่ทำลายไวยากรณ์ของช่อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay cả khi tùy chỉnh, nó phải cư xử \"như một tiêu đề.\" Đặt nút hay ô nhập liệu ở đây phá ngữ pháp của ô."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I když je vlastní, musí se chovat „jako nadpis“. Dát sem tlačítka nebo vstupní pole porušuje gramatiku slotu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv når den er brugerdefineret, skal den opføre sig »som en titel.« Knapper eller inputfelter her bryder pladsens grammatik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμα κι όταν είναι προσαρμοσμένο, πρέπει να συμπεριφέρεται «σαν τίτλος». Το να βάλεις εδώ κουμπιά ή πεδία εισαγωγής σπάει τη γραμματική της θέσης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikka se olisi mukautettu, sen täytyy käyttäytyä ”kuin otsikko”. Painikkeiden tai syöttökenttien laittaminen tähän rikkoo paikan kieliopin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahkan saat kustom, ia harus berperilaku \"seperti judul.\" Menaruh tombol atau kolom input di sini merusak tata bahasa slot."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv når den er egendefinert, må den oppføre seg «som en tittel». Å sette knapper eller inndatafelt her bryter plassens grammatikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfs als het aangepast is, moet het zich gedragen \"als een titel\". Knoppen of invoervelden hier plaatsen breekt de grammatica van de plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawet własny musi zachowywać się „jak tytuł”. Umieszczenie tu przycisków lub pól wprowadzania łamie gramatykę tego miejsca."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Även när den är egen måste den bete sig ”som en rubrik”. Att lägga knappar eller inmatningsfält här bryter platsens grammatik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel olsa bile “bir başlık gibi” davranmalı. Oraya düğmeler ya da giriş alanları koymak yuvanın gramerini bozar."
          }
        }
      }
    },
    "컴포넌트에 material을 줄 때 묻는다. \"이것이 놓일 자리 **밑에 이미 material이 있는가?**\" 있다면 주지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When giving a component a material, ask: \"**Is there already a material underneath** the spot where this will sit?\" If there is, don't add one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When giving a component a material, ask: \"**Is there already a material underneath** the spot where this will sit?\" If there is, don't add one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンポーネントにmaterialを与えるときに問う。「これが置かれる場所の**下に、すでにmaterialがあるか**」あるなら与えない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给组件加 material 时先问：“这个组件要放的位置**下面已经有 material 了吗？**”有的话，就不加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給元件加 material 時先問：「這個元件要放的位置**下面已經有 material 了嗎？**」有的話，就不加。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Давая компоненту материал, спросите: «**Есть ли уже материал под** местом, куда это ляжет?» Если есть, не добавляйте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al dar un material a un componente, pregunta: «**¿Hay ya un material debajo** del sitio donde va a ir esto?» Si lo hay, no añadas otro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage, wenn du einer Komponente ein Material gibst: „**Gibt es unter dem Platz, an dem sie sitzt, schon ein Material?**“ Wenn ja, füge keines hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En donnant un matériau à un composant, demandez : « **Y a-t-il déjà un matériau en dessous** de l'endroit où il se posera ? » Si oui, n'en ajoutez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando dai un materiale a un componente, chiediti: «**C'è già un materiale sotto** il punto dove andrà?» Se c'è, non aggiungerne uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao dar um material a um componente, pergunte: «**Já existe um material por baixo** do ponto onde isto vai ficar?» Se existe, não acrescente um."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อให้วัสดุกับคอมโพเนนต์ ให้ถาม: \"**มีวัสดุอยู่ใต้**ตำแหน่งที่มันจะอยู่แล้วหรือยัง\" ถ้ามี อย่าเพิ่ม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi gán vật liệu cho một thành phần, hãy hỏi: \"**Bên dưới chỗ này đã có vật liệu chưa?**\" Nếu có, đừng thêm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když dáváte komponentě materiál, zeptejte se: „**Je pod místem**, kam to půjde, už materiál?“ Pokud ano, nepřidávejte další."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du giver en komponent et materiale, så spørg: »**Er der allerede et materiale under** den plads, hvor dette skal sidde?« Hvis der er, så læg ikke et til."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν δίνεις υλικό σε ένα στοιχείο, ρώτα: «**Υπάρχει ήδη υλικό από κάτω** στο σημείο όπου θα κάτσει;» Αν υπάρχει, μην προσθέσεις άλλο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun annat komponentille materiaalin, kysy: ”**Onko paikan alla jo materiaalia**, johon tämä istuu?” Jos on, älä lisää toista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat memberi material pada komponen, tanyakan: \"**Apakah sudah ada material di bawah** tempat ini?\" Jika sudah, jangan tambahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du gir en komponent et material, spør: «**Er det allerede et material under** stedet dette skal sitte?» Hvis det er det, ikke legg til et."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag als je een component een materiaal geeft: \"**Zit er al een materiaal onder** de plek waar dit komt?\" Zo ja, voeg er dan geen toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dając komponentowi materiał, zapytaj: „**Czy pod miejscem, w którym to stanie, jest już materiał?**” Jeśli jest, nie dodawaj kolejnego."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du ger en komponent ett material, fråga: ”**Finns det redan ett material under** platsen där den här ska sitta?” Om det gör det, lägg inte till ett."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bileşene malzeme verirken sor: “Bunun duracağı yerin **altında zaten bir malzeme var mı**?” Varsa bir tane daha ekleme."
          }
        }
      }
    },
    "콘텐츠 길이가 들쭉날쭉해도 **셀·카드 높이는 균일해야 할 때**. 한 줄짜리 리뷰와 네 줄짜리 리뷰가 섞인 그리드에서, 짧은 텍스트에도 3줄 높이를 예약해 카드 크기를 통일하는 패턴.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When content length varies wildly but **cell and card heights must stay uniform**. In a grid that mixes one-line and four-line reviews, this pattern reserves three lines of height even for short text so every card is the same size."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When content length varies wildly but **cell and card heights must stay uniform**. In a grid that mixes one-line and four-line reviews, this pattern reserves three lines of height even for short text so every card is the same size."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの長さがばらばらでも、**セルやカードの高さは均一であるべき**とき。1行のレビューと4行のレビューが混ざったグリッドで、短いテキストにも3行分の高さを確保してカードのサイズをそろえるパターン。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当内容长短参差，**单元格、卡片高度却必须一致**时。在混有一行评价和四行评价的网格里，即使文字很短也预留 3 行高度来统一卡片大小的模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當內容長短參差，**單元格、卡片高度卻必須一致**時。在混有一行評價和四行評價的網格里，即使文字很短也預留 3 行高度來統一卡片大小的模式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда длина содержимого сильно различается, но **высоты ячеек и карточек должны оставаться одинаковыми**. В сетке, где смешаны однострочные и четырёхстрочные отзывы, этот паттерн резервирует высоту трёх строк даже для короткого текста, чтобы все карточки были одного размера."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la longitud del contenido varía mucho pero **las alturas de celdas y tarjetas deben mantenerse uniformes**. En una cuadrícula que mezcla reseñas de una y de cuatro líneas, este patrón reserva la altura de tres líneas incluso para texto corto, para que todas las tarjetas tengan el mismo tamaño."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Inhaltslänge stark variiert, aber **Zellen- und Kartenhöhen einheitlich bleiben müssen**. In einem Raster, das einzeilige und vierzeilige Rezensionen mischt, reserviert dieses Muster selbst für kurzen Text die Höhe von drei Zeilen, sodass jede Karte gleich groß ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la longueur du contenu varie beaucoup mais que **les hauteurs de cellules et de cartes doivent rester uniformes**. Dans une grille qui mélange des avis d'une ligne et de quatre lignes, ce motif réserve la hauteur de trois lignes même pour un texte court afin que chaque carte ait la même taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la lunghezza del contenuto varia moltissimo ma **le altezze di celle e schede devono restare uniformi**. In una griglia che mescola recensioni di una riga e di quattro righe, questo schema riserva l'altezza di tre righe anche per il testo breve così ogni scheda ha la stessa dimensione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o comprimento do conteúdo varia muito mas **as alturas de células e cartões precisam ficar uniformes**. Numa grade que mistura avaliações de uma e de quatro linhas, este padrão reserva a altura de três linhas até para texto curto, para todo cartão ter o mesmo tamanho."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อความยาวเนื้อหาแกว่งมากแต่**ความสูงเซลล์และการ์ดต้องสม่ำเสมอ** ในกริดที่ผสมรีวิวหนึ่งบรรทัดกับสี่บรรทัด รูปแบบนี้สำรองความสูงสามบรรทัดแม้กับข้อความสั้น ทุกการ์ดจึงขนาดเท่ากัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi độ dài nội dung dao động mạnh nhưng **chiều cao ô và thẻ phải đồng đều**. Trong lưới trộn đánh giá một dòng và bốn dòng, mẫu này giữ chiều cao ba dòng ngay cả cho văn bản ngắn để mọi thẻ cùng cỡ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se délka obsahu hodně liší, ale **výšky buněk a karet musejí zůstat jednotné**. V mřížce, která míchá jednořádkové a čtyřřádkové recenze, tento vzor rezervuje výšku tří řádků i pro krátký text, aby byla každá karta stejně velká."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når indholdets længde varierer voldsomt, men **celle- og korthøjder skal forblive ensartede**. I et gitter, der blander anmeldelser på én linje og fire linjer, reserverer dette mønster tre linjers højde selv til kort tekst, så hvert kort har samme størrelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν το μήκος του περιεχομένου ποικίλλει πολύ αλλά **τα ύψη κελιών και καρτών πρέπει να μένουν ομοιόμορφα**. Σε ένα πλέγμα που ανακατεύει κριτικές μιας και τεσσάρων γραμμών, αυτό το μοτίβο δεσμεύει ύψος τριών γραμμών ακόμα και για σύντομο κείμενο, ώστε κάθε κάρτα να έχει το ίδιο μέγεθος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun sisällön pituus vaihtelee rajusti mutta **solujen ja korttien korkeuksien täytyy pysyä tasaisina**. Ruudukossa, joka sekoittaa yhden ja neljän rivin arvosteluja, tämä malli varaa kolmen rivin korkeuden myös lyhyelle tekstille, jotta jokainen kortti on yhtä suuri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat panjang konten sangat bervariasi tetapi **tinggi sel dan kartu harus tetap seragam**. Di grid yang mencampur ulasan satu baris dan empat baris, pola ini menyisihkan tinggi tiga baris bahkan untuk teks pendek sehingga setiap kartu berukuran sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når innholdslengden varierer vilt, men **celle- og korthøyder må forbli jevne**. I et rutenett som blander enlinjes og firelinjes anmeldelser reserverer dette mønsteret tre linjers høyde selv for kort tekst slik at hvert kort har samme størrelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer de inhoudslengte enorm varieert maar **cel- en kaarthoogtes uniform moeten blijven**. In een raster dat reviews van één regel en van vier regels mengt, reserveert dit patroon drie regels hoogte, zelfs voor korte tekst, zodat elke kaart even groot is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy długość treści mocno się różni, ale **wysokości komórek i kart muszą pozostać jednakowe**. W siatce mieszającej opinie jednowierszowe i czterowierszowe ten wzorzec rezerwuje wysokość trzech wierszy nawet dla krótkiego tekstu, więc każda karta ma ten sam rozmiar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När innehållslängden varierar kraftigt men **cell- och korthöjder måste förbli enhetliga**. I ett rutnät som blandar enradiga och fyrradiga recensioner reserverar det här mönstret tre raders höjd även för kort text så att varje kort är lika stort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerik uzunluğu çok değiştiğinde ama **hücre ve kart yükseklikleri eşit kalmalıysa**. Tek satırlık ve dört satırlık yorumların karıştığı bir ızgarada bu kalıp kısa metin için bile üç satırlık yükseklik ayırır, böylece her kart aynı boyutta olur."
          }
        }
      }
    },
    "콘텐츠 끝이 자동 인셋": {
      "extractionState": "manual",
