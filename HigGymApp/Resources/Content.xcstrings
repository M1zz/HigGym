          "stringUnit": {
            "state": "translated",
            "value": "Blijft op één regel, ook als de lengte verandert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaje w jednym wierszu nawet przy zmianie długości"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stannar på en rad även när längden ändras"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzunluk değişse bile tek satırda kalır"
          }
        }
      }
    },
