        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε τις ενέργειες πάνω στο ίδιο το αντικείμενο"
          }
        }
      }
    },
    "대상이 화면에 보이는데 액션은 떨어진 버튼에 둔다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the action on a separate button when its target is visible on screen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the action on a separate button when its target is visible on screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象が画面に見えているのに、アクションを離れたボタンに置く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对象在屏幕上看得见，操作却放在远处的按钮里"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "物件在螢幕上看得見，操作卻放在遠處的按鈕裡"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещение действия на отдельной кнопке, когда его объект виден на экране"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner la acción en un botón aparte cuando su objetivo es visible en pantalla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion auf einen separaten Button setzen, obwohl ihr Ziel auf dem Bildschirm sichtbar ist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre l'action sur un bouton séparé alors que sa cible est visible à l'écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettere l'azione su un pulsante separato quando il suo bersaglio è visibile sullo schermo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pôr a ação num botão separado quando o alvo está visível na tela"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางการกระทำบนปุ่มแยกทั้งที่เป้าหมายมองเห็นบนหน้าจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt hành động ở một nút riêng khi đối tượng của nó đang hiện trên màn hình"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dát akci na samostatné tlačítko, když je její cíl viditelný na obrazovce"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lægge handlingen på en separat knap, når dens mål er synligt på skærmen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθέτηση της ενέργειας σε ξεχωριστό κουμπί όταν ο στόχος της είναι ορατός στην οθόνη"
          }
        }
      }
    },
    "대형 제목의 크기감을 유지하되 **내비바 안(inline 위치)에 고정**. 스크롤로 밀려나지 않음. iOS 26 신규.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the presence of a large title but **pins it inside the navigation bar (the inline position)**. Scrolling does not push it away. New in iOS 26."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the presence of a large title but **pins it inside the navigation bar (the inline position)**. Scrolling does not push it away. New in iOS 26."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きいタイトルの存在感を保ちつつ、**ナビゲーションバーの中（inlineの位置）に固定**。スクロールで押し出されない。iOS 26の新機能。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持大标题的大小感，同时**固定在导航栏内（inline 位置）**。不会被滚动顶走。iOS 26 新增。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持大標題的大小感，同時**固定在導覽列內（inline 位置）**。不會被滾動頂走。iOS 26 新增。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет заметность крупного заголовка, но **закрепляет его внутри панели навигации (в inline-положении)**. Прокрутка его не уносит. Новинка iOS 26."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la presencia de un título grande pero **lo fija dentro de la barra de navegación (la posición inline)**. El desplazamiento no lo aparta. Novedad de iOS 26."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält die Präsenz eines Large-Titels, **fixiert ihn aber in der Navigationsleiste (die Inline-Position)**. Scrollen schiebt ihn nicht weg. Neu in iOS 26."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde la présence d'un grand titre mais **l'épingle dans la barre de navigation (la position inline)**. Le défilement ne le repousse pas. Nouveauté d'iOS 26."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la presenza di un titolo grande ma lo **fissa dentro la barra di navigazione (la posizione inline)**. Lo scorrimento non lo spinge via. Novità di iOS 26."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a presença de um título grande mas **o fixa dentro da barra de navegação (a posição inline)**. A rolagem não o empurra para longe. Novidade do iOS 26."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คงตัวตนของชื่อเรื่องขนาดใหญ่ไว้ แต่**ตรึงไว้ในแถบนำทาง (ตำแหน่ง inline)** การเลื่อนไม่ผลักมันออก ใหม่ใน iOS 26"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ sự hiện diện của tiêu đề lớn nhưng **ghim nó trong thanh điều hướng (vị trí inline)**. Cuộn không đẩy nó đi. Mới trong iOS 26."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachovává přítomnost velkého nadpisu, ale **připíná ho uvnitř navigačního panelu (pozice inline)**. Posouvání ho neodsune. Novinka v iOS 26."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevarer den store titels tilstedeværelse men **fastgør den inde i navigationsbjælken (inline-positionen)**. Scroll skubber den ikke væk. Nyt i iOS 26."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατά την παρουσία ενός μεγάλου τίτλου αλλά **τον καρφιτσώνει μέσα στη γραμμή πλοήγησης (η inline θέση)**. Η κύλιση δεν τον διώχνει. Νέο στο iOS 26."
          }
        }
      }
    },
    "대형 타이틀 자리에 **로고·아바타 등 커스텀 뷰**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**A custom view, such as a logo or avatar,** in the large title slot"
