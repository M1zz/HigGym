          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementet **udvider sig til at fylde skærmen**, fotofremviser-mønstret"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το στοιχείο **επεκτείνεται για να γεμίσει την οθόνη**, το μοτίβο προβολέα φωτογραφιών"
          }
        }
      }
    },
    "요소를 다 켜고 위계 설계는 없음": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning on every element with no thought to hierarchy"
