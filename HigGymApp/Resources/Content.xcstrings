        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca giriş ekranındaki logo yeter. Diğer her ekran nerede olduğunu söylemeli."
          }
        }
      }
    },
    "로컬라이즈로 길이가 널뛰는 버튼 라벨의 안전장치": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A safeguard for button labels whose length swings wildly with localization"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A safeguard for button labels whose length swings wildly with localisation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカライズで長さが大きく変わるボタンラベルの安全装置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应对本地化后长度忽长忽短的按钮标签的安全装置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應對本地化後長度忽長忽短的按鈕標籤的安全裝置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страховка для подписей кнопок, длина которых сильно скачет при локализации"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una salvaguarda para etiquetas de botones cuya longitud oscila mucho con la localización"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Absicherung für Button-Beschriftungen, deren Länge je nach Lokalisierung stark schwankt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une protection pour les libellés de boutons dont la longueur varie fortement avec la localisation"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una salvaguardia per le etichette dei pulsanti la cui lunghezza oscilla molto con la localizzazione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma salvaguarda para rótulos de botões cujo comprimento oscila muito com a localização"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
