            "value": "Miniatura de foto → visor a pantalla completa"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto-Vorschau → Vollbild-Betrachter"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vignette de photo → visualiseur plein écran"
          }
        },
        "it": {
          "stringUnit": {
