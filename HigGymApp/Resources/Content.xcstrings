    "좋았던 설정을 다른 텍스트로 옮길 때, 그 설정이 좋았던 이유가 여기서도 참인지 먼저 확인한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you carry a setting that worked over to other text, first check whether the reason it worked still holds there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you carry a setting that worked over to other text, first check whether the reason it worked still holds there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいった設定をほかのテキストに持ち込むときは、その設定がうまくいった理由がここでも成り立つかを先に確かめる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把好用的设置搬到别的文字上时，先确认那个设置好用的理由在这里是否依然成立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把好用的設定搬到別的文字上時，先確認那個設定好用的理由在這裡是否依然成立。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда переносите настройку, которая работала, на другой текст, сначала проверьте, действует ли там причина, по которой она работала."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando traslades a otro texto un ajuste que funcionaba, comprueba primero si el motivo por el que funcionaba sigue valiendo allí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überträgst du eine Einstellung, die funktionierte, auf anderen Text, prüfe zuerst, ob der Grund, warum sie funktionierte, dort noch gilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous reportez un réglage qui fonctionnait sur un autre texte, vérifiez d'abord si la raison pour laquelle il fonctionnait vaut encore là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando porti un'impostazione che funzionava su altro testo, controlla prima se il motivo per cui funzionava vale ancora lì."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você leva um ajuste que funcionou para outro texto, confira primeiro se o motivo pelo qual funcionava ainda vale ali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อนำการตั้งค่าที่ใช้ได้ไปใช้กับข้อความอื่น ให้ตรวจก่อนว่าเหตุผลที่มันใช้ได้ยังคงอยู่ที่นั่นไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn mang một thiết lập từng chạy tốt sang văn bản khác, hãy kiểm tra trước xem lý do nó chạy tốt có còn đúng ở đó không."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přenášíte nastavení, které fungovalo, na jiný text, nejdřív ověřte, zda důvod, proč fungovalo, stále platí i tam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du tager en indstilling, der virkede, med over til anden tekst, så tjek først, om grunden til, at den virkede, stadig gælder der."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν μεταφέρεις μια ρύθμιση που δούλευε σε άλλο κείμενο, έλεγξε πρώτα αν ισχύει ακόμα εκεί ο λόγος που δούλευε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun siirrät toimineen asetuksen muuhun tekstiin, tarkista ensin, pätevätkö sen toimimisen syyt edelleen siellä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat membawa pengaturan yang berhasil ke teks lain, periksa dulu apakah alasan ia berhasil masih berlaku di sana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du tar med en innstilling som fungerte til annen tekst, sjekk først om grunnen til at den fungerte fortsatt holder der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een instelling die werkte overneemt voor andere tekst, controleer dan eerst of de reden dat hij werkte daar nog geldt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy przenosisz ustawienie, które działało, na inny tekst, najpierw sprawdź, czy powód, dla którego działało, nadal tam obowiązuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du tar med en inställning som fungerade till annan text, kontrollera först om skälet till att den fungerade fortfarande gäller där."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşe yarayan bir ayarı başka metne taşıdığında önce işe yarama nedeninin orada hâlâ geçerli olup olmadığını kontrol et."
          }
        }
      }
    },
    "좌우 가장자리 바를 동시에 사용": {
