    "관련 액션끼리 섹션을 나누고, **삭제는 맨 아래 분리 + 빨강**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Related actions grouped into sections, with **Delete set apart at the very bottom in red**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Related actions grouped into sections, with **Delete set apart at the very bottom in red**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連するアクションごとにセクションを分け、**削除はいちばん下に分離して赤**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相关操作按分区划分，**删除放最底部分隔 + 红色**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相關操作按分割槽劃分，**刪除放最底部分隔 + 紅色**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связанные действия сгруппированы в разделы, а **«Удалить» вынесено в самый низ красным**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acciones relacionadas agrupadas en secciones, con **Eliminar separado al final del todo en rojo**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammengehörige Aktionen in Abschnitten gruppiert, mit **Löschen ganz unten rot abgesetzt**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des actions liées regroupées en sections, avec **Supprimer mis à part tout en bas en rouge**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azioni correlate raggruppate in sezioni, con **Elimina staccato in fondo in rosso**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações relacionadas agrupadas em seções, com **Excluir separado no fim, em vermelho**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
