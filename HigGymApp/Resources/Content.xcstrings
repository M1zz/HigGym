            "value": "Un sélecteur d'affichage de calendrier (Jour/Semaine/Mois) + un bouton **Aujourd'hui** à droite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un selettore di vista del calendario (Giorno/Settimana/Mese) + un pulsante **Oggi** a destra"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um seletor de visualização do calendário (Dia/Semana/Mês) + um botão **Hoje** à direita"
          }
        },
        "th": {
