        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Haut et bas à la fois**, tous deux unifiés avec un fondu soft"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Alto e basso insieme**, entrambi unificati con una dissolvenza morbida"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Topo e parte de baixo ao mesmo tempo**, ambos unificados com uma dissolvência soft"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ทั้งด้านบนและด้านล่างพร้อมกัน** รวมเป็นหนึ่งด้วยการจางแบบ soft"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Cả trên lẫn dưới cùng lúc**, thống nhất bằng hiệu ứng mờ soft"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nahoře i dole najednou**, obojí sjednoceno měkkým mizením"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Top og bund på én gang**, begge forenet med en blød udtoning"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Πάνω και κάτω ταυτόχρονα**, και τα δύο ενοποιημένα με απαλό σβήσιμο"
          }
        }
      }
    },
    "**상·하단 동시에** safe area bar + soft 효과 + 툴바 아이템, 수직 방향 풀 구성.": {
      "extractionState": "manual",
      "localizations": {
