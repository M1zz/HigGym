    },
    "액세서리에 탭 전환 버튼을 넣음": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting tab-switching buttons in the accessory"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting tab-switching buttons in the accessory"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセサリにタブ切り替えボタンを入れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在附件里放切换标签的按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在附件裡放切換標籤的按鈕"
