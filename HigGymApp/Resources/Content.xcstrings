          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhãn bị cắt và vùng chạm bị thu nhỏ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oříznuté popisky a zmenšené dotykové plochy"
          }
        },
        "da": {
