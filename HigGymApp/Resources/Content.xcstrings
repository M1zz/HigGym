    "첫 번째 콘텐츠가 바에 가려지지 않는지(자동 인셋), 스크롤 시 콘텐츠가 바 밑으로 지나갈 때의 가독성을 확인하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the first piece of content isn't hidden behind the bar (automatic inset), and check legibility as content passes under the bar while scrolling."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the first piece of content isn't hidden behind the bar (automatic inset), and check legibility as content passes under the bar while scrolling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のコンテンツがバーに隠れないか（自動インセット）、スクロール時にコンテンツがバーの下を通るときの読みやすさを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认第一项内容是否被栏遮住（自动内边距），以及滚动时内容从栏下经过的可读性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認第一項內容是否被列遮住（自動內邊距），以及滾動時內容從列下經過的可讀性。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, что первый фрагмент содержимого не спрятан за панелью (автоматический отступ), и проверьте читаемость, пока содержимое проходит под панелью при прокрутке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que el primer fragmento de contenido no queda oculto tras la barra (margen automático), y comprueba la legibilidad mientras el contenido pasa bajo la barra al desplazar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe, dass das erste Inhaltsstück nicht hinter der Leiste verborgen ist (automatischer Einzug), und prüfe die Lesbarkeit, während Inhalt beim Scrollen unter der Leiste vorbeizieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le premier élément de contenu n'est pas caché derrière la barre (décalage automatique), et vérifiez la lisibilité quand le contenu passe sous la barre en défilant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che il primo contenuto non sia nascosto dietro la barra (spostamento automatico), e controlla la leggibilità mentre il contenuto passa sotto la barra scorrendo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira se o primeiro conteúdo não está escondido atrás da barra (recuo automático) e confira a legibilidade enquanto o conteúdo passa sob a barra ao rolar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจว่าเนื้อหาชิ้นแรกไม่ถูกซ่อนหลังแถบ (การเว้นระยะอัตโนมัติ) และตรวจความอ่านออกเมื่อเนื้อหาผ่านใต้แถบขณะเลื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra phần nội dung đầu tiên không bị giấu sau thanh (phần đệm tự động), và kiểm tra khả năng đọc khi nội dung đi dưới thanh lúc cuộn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřte, že první kus obsahu není skrytý za panelem (automatické odsazení), a zkontrolujte čitelnost, když obsah při posouvání prochází pod panelem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek, at det første stykke indhold ikke er skjult bag bjælken (automatisk indrykning), og tjek læseligheden, mens indhold passerer under bjælken under scroll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε ότι το πρώτο κομμάτι περιεχομένου δεν κρύβεται πίσω από τη γραμμή (αυτόματη εσοχή), και έλεγξε την αναγνωσιμότητα καθώς το περιεχόμενο περνά κάτω από τη γραμμή στην κύλιση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista, ettei ensimmäinen sisältökappale piiloudu palkin taakse (automaattinen sisennys), ja tarkista luettavuus sisällön kulkiessa palkin alta vieritettäessä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan konten pertama tidak tersembunyi di balik bilah (inset otomatis), dan periksa keterbacaan saat konten lewat di bawah bilah selagi menggulir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk at det første innholdet ikke er skjult bak linjen (automatisk innrykk), og sjekk lesbarhet mens innhold passerer under linjen under rulling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer dat het eerste stuk inhoud niet achter de balk verborgen zit (automatische inset), en controleer de leesbaarheid terwijl inhoud tijdens het scrollen onder de balk langs gaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy pierwszy kawałek treści nie jest ukryty za paskiem (automatyczny margines), i sprawdź czytelność, gdy treść przechodzi pod paskiem podczas przewijania."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera att det första innehållsstycket inte är dolt bakom fältet (automatisk indragning), och kontrollera läsbarheten när innehållet passerar under fältet medan du scrollar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk içeriğin çubuğun arkasında gizlenmediğini (otomatik girinti) kontrol et ve kaydırırken içerik çubuğun altından geçerken okunabilirliği kontrol et."
          }
        }
      }
    },
    "첫 시안에는 완료 하나뿐이었다. 화면을 띄워 보면 오른쪽 위가 휑하다. 캡슐 하나만 떠 있는 게 미완성처럼 보이고, 왼쪽 뒤로가기와 무게가 맞지 않아 보인다. 마침 공유와 별표는 \"있으면 좋은\" 기능이다. 넣으면 자리도 채우고 기능도 늘어나니 두 번 이득처럼 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first mockup had only Done. Put it on screen and the top right looks empty. A single floating capsule looks unfinished and seems out of balance with the Back button on the left. As it happens, Share and Favorite are \"nice to have\" features. Adding them fills the space and adds features, so it looks like a win-win."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The first mockup had only Done. Put it on screen and the top right looks empty. A single floating capsule looks unfinished and seems out of balance with the Back button on the left. As it happens, Share and Favourite are \"nice to have\" features. Adding them fills the space and adds features, so it looks like a win-win."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のデザイン案には完了しかなかった。画面に出してみると、右上がスカスカだ。カプセルがひとつだけ浮かんでいるのは未完成に見えるし、左の戻るボタンと重さが釣り合っていないように見える。ちょうど共有とスターは「あると便利」な機能だ。入れれば場所も埋まり機能も増えるので、一石二鳥に見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最初的设计稿只有完成一个。打开界面一看，右上角空荡荡的。只浮着一个胶囊，像没做完，和左边返回按钮的分量也不匹配。恰好分享和星标是“有了更好”的功能。放进去，位置填上了，功能也多了，看起来一举两得。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最初的設計稿只有完成一個。開啟介面一看，右上角空蕩蕩的。只浮著一個膠囊，像沒做完，和左邊返回按鈕的分量也不匹配。恰好分享和星標是「有了更好」的功能。放進去，位置填上了，功能也多了，看起來一舉兩得。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В первом макете было только «Готово». Поставьте на экран, и верх справа выглядит пустым. Одинокая парящая капсула выглядит незаконченной и неуравновешенной рядом с кнопкой «Назад» слева. Так уж вышло, что «Поделиться» и «В избранное» - функции «было бы неплохо». Добавьте их, и место заполнено, и функций прибавилось, так что выглядит беспроигрышно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera maqueta solo tenía Listo. Ponlo en pantalla y la parte superior derecha parece vacía. Una sola cápsula flotante parece inacabada y desequilibrada frente al botón Atrás de la izquierda. Da la casualidad de que Compartir y Favorito son funciones «que estaría bien tener». Añadirlas llena el espacio y suma funciones, así que parece ganar por todas partes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das erste Mockup hatte nur Fertig. Setzt man es auf den Bildschirm, wirkt die obere rechte Ecke leer. Eine einzelne schwebende Kapsel wirkt unfertig und scheint aus dem Gleichgewicht mit dem Zurück-Button links. Zufällig sind Teilen und Favorit „nice to have“-Funktionen. Sie hinzuzufügen füllt den Platz und fügt Funktionen hinzu, also wirkt es wie eine Win-win-Situation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première maquette n'avait que OK. Mettez-le à l'écran et le haut à droite paraît vide. Une seule capsule flottante paraît inachevée et semble déséquilibrée par rapport au bouton Retour à gauche. Il se trouve que Partager et Favori sont des fonctions « agréables à avoir ». Les ajouter remplit l'espace et ajoute des fonctions, donc cela ressemble à un gagnant-gagnant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo mockup aveva solo Fine. Mettilo sullo schermo e l'alto a destra sembra vuoto. Una singola capsula fluttuante sembra non finita e fuori equilibrio rispetto al pulsante Indietro a sinistra. Per caso, Condividi e Preferito sono funzioni «utili da avere». Aggiungerle riempie lo spazio e aggiunge funzioni, quindi sembra una vittoria su due fronti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro mockup tinha só Concluir. Ponha na tela e o canto superior direito parece vazio. Uma única cápsula flutuante parece inacabada e fora de equilíbrio com o botão Voltar à esquerda. Por acaso, Compartilhar e Favorito são funcionalidades «boas de ter». Acrescentá-las preenche o espaço e soma funcionalidades, então parece uma vitória dupla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ม็อกอัปแรกมีแค่เสร็จสิ้น ใส่บนหน้าจอแล้วขวาบนดูว่าง แคปซูลลอยเดียวดูไม่เสร็จและดูไม่สมดุลกับปุ่มย้อนกลับทางซ้าย บังเอิญแชร์และรายการโปรดเป็นฟีเจอร์ \"มีก็ดี\" การเพิ่มมันเติมพื้นที่และเพิ่มฟีเจอร์ จึงดูเหมือนได้ทั้งสองทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mockup đầu chỉ có Xong. Đặt lên màn hình, góc trên bên phải trông trống. Một capsule nổi đơn độc trông chưa hoàn chỉnh và có vẻ lệch cân với nút Quay lại bên trái. Tình cờ, Chia sẻ và Yêu thích là tính năng \"có thì tốt.\" Thêm chúng lấp chỗ trống và thêm tính năng, nên trông như đôi bên cùng có lợi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První mockup měl jen Hotovo. Dejte to na obrazovku a vpravo nahoře vypadá prázdně. Jediná plovoucí kapsle vypadá nedokončeně a zdá se nevyvážená vůči tlačítku Zpět vlevo. Shodou okolností jsou Sdílet a Oblíbené funkce „příjemné mít“. Jejich přidání vyplní místo a přidá funkce, takže vypadá jako výhra pro obě strany."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det første mockup havde kun Færdig. Sæt det på skærmen, og øverste højre hjørne ser tomt ud. En enkelt flydende kapsel ser uafsluttet ud og virker ude af balance med Tilbage-knappen til venstre. Som det sker, er Del og Favorit »rare at have«-funktioner. At tilføje dem fylder pladsen og tilføjer funktioner, så det ser ud som en win-win."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πρώτο mockup είχε μόνο Τέλος. Βάλ' το στην οθόνη και το πάνω δεξιά φαίνεται άδειο. Μία μόνη πλωτή κάψουλα φαίνεται ημιτελής και ανισόρροπη δίπλα στο κουμπί Πίσω αριστερά. Τυχαίνει η Κοινοποίηση και το Αγαπημένο να είναι λειτουργίες «ωραίο να υπάρχουν». Η προσθήκη τους γεμίζει τον χώρο και προσθέτει λειτουργίες, οπότε μοιάζει win-win."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäisessä luonnoksessa oli vain Valmis. Laita se näytölle, ja oikea yläkulma näyttää tyhjältä. Yksittäinen kelluva kapseli näyttää keskeneräiseltä ja epätasapainossa vasemman Takaisin-painikkeen kanssa. Kuten käy, Jaa ja Suosikki ovat ”kiva olla” -ominaisuuksia. Niiden lisääminen täyttää tilan ja lisää ominaisuuksia, joten se näyttää win-winiltä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mockup pertama hanya punya Selesai. Taruh di layar dan kanan atas tampak kosong. Satu kapsul mengambang tampak belum selesai dan tampak tak seimbang dengan tombol Kembali di kiri. Kebetulan, Bagikan dan Favorit adalah fitur \"bagus kalau ada.\" Menambahkannya mengisi ruang dan menambah fitur, jadi tampak menguntungkan semua pihak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det første utkastet hadde bare Ferdig. Sett det på skjermen, og øvre høyre ser tomt ut. En enkelt flytende kapsel ser uferdig ut og virker ubalansert i forhold til Tilbake-knappen til venstre. Tilfeldigvis er Del og Favoritt «fint å ha»-funksjoner. Å legge dem til fyller plassen og legger til funksjoner, så det ser ut som en vinn-vinn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste mockup had alleen Klaar. Zet het op het scherm en rechtsboven lijkt leeg. Eén zwevende capsule ziet er onaf uit en lijkt uit balans met de knop Terug links. Toevallig zijn Deel en Favoriet \"leuk om te hebben\". Ze toevoegen vult de ruimte en voegt functies toe, dus het lijkt een win-win."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsza makieta miała tylko Gotowe. Umieść to na ekranie, a prawy górny róg wygląda pusto. Jedna unosząca się kapsuła wygląda na niedokończoną i na niezrównoważoną względem przycisku Wstecz po lewej. Tak się składa, że Udostępnij i Ulubione to funkcje „miło mieć”. Ich dodanie wypełnia miejsce i dodaje funkcje, więc wygląda to na korzyść z obu stron."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den första skissen hade bara Klar. Lägg den på skärmen och det övre högra hörnet ser tomt ut. En enda svävande kapsel ser ofärdig ut och verkar obalanserad mot Tillbaka-knappen till vänster. Det råkar vara så att Dela och Favorit är ”trevligt att ha”-funktioner. Att lägga till dem fyller utrymmet och lägger till funktioner, så det ser ut som en vinn-vinn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk maket yalnızca Bitti'ydi. Ekrana koy, sağ üst boş görünüyor. Tek bir yüzen kapsül bitmemiş görünür ve soldaki Geri düğmesiyle dengesiz durur. Tesadüfen Paylaş ve Favori “olsa iyi olur” özellikler. Onları eklemek boşluğu doldurur ve özellik ekler, bu yüzden herkes için kazançlı gibi görünür."
          }
        }
      }
    },
    "첫 화면부터 대화가 아래로 밀림": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation gets pushed down from the very first screen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation gets pushed down from the very first screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の画面から会話が下に押しやられる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从第一屏起对话就被顶下去"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從第一個畫面起對話就被頂下去"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переписка сдвигается вниз с самого первого экрана"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversación se empuja hacia abajo desde la primera pantalla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Unterhaltung wird schon vom allerersten Bildschirm an nach unten gedrückt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation est repoussée vers le bas dès le tout premier écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversazione viene spinta in basso fin dalla prima schermata"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa é empurrada para baixo desde a primeira tela"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บทสนทนาถูกดันลงตั้งแต่หน้าจอแรก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện bị đẩy xuống ngay từ màn hình đầu tiên"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Konverzace je tlačena dolů už od první obrazovky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalen bliver skubbet ned fra allerførste skærm"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συζήτηση σπρώχνεται κάτω από την πρώτη κιόλας οθόνη"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskustelu työntyy alas jo ensimmäisestä näkymästä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percakapan terdorong turun sejak layar pertama"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalen blir skjøvet ned fra helt første skjerm"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gesprek wordt vanaf het allereerste scherm omlaag geduwd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowa jest spychana w dół już od pierwszego ekranu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalet trycks ner redan från första skärmen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşma ilk ekrandan itibaren aşağı itilir"
          }
        }
      }
    },
    "첫 화면부터 콘텐츠가 밀린다면 inline로 내린다. 기본값도 선택이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If content gets pushed down on the very first screen, switch to inline. A default is still a choice."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If content gets pushed down on the very first screen, switch to inline. A default is still a choice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の画面からコンテンツが押し下げられるなら、inline に下げる。デフォルトも選択のひとつだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果从第一屏起内容就被顶下去，就降为 inline。保持默认值也是一种选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果從第一個畫面起內容就被頂下去，就降為 inline。保持預設值也是一種選擇。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если содержимое сдвигается вниз уже на первом экране, переключитесь на inline. Значение по умолчанию - тоже выбор."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el contenido se empuja hacia abajo en la primera pantalla, cambia a inline. Un valor por defecto sigue siendo una elección."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird Inhalt schon auf dem allerersten Bildschirm nach unten gedrückt, wechsle zu Inline. Ein Standard ist trotzdem eine Entscheidung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le contenu est repoussé vers le bas dès le tout premier écran, passez à inline. Un réglage par défaut reste un choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il contenuto viene spinto in basso fin dalla prima schermata, passa a inline. Un predefinito è comunque una scelta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o conteúdo é empurrado para baixo desde a primeira tela, passe para inline. Um padrão ainda é uma escolha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าเนื้อหาถูกดันลงตั้งแต่หน้าจอแรก ให้เปลี่ยนเป็น inline ค่าเริ่มต้นก็ยังเป็นทางเลือก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu nội dung bị đẩy xuống ngay từ màn hình đầu tiên, hãy chuyển sang inline. Mặc định vẫn là một lựa chọn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je obsah tlačen dolů už na první obrazovce, přepněte na inline. Výchozí je také volba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis indhold bliver skubbet ned på allerførste skærm, så skift til inline. En standard er stadig et valg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν το περιεχόμενο σπρώχνεται κάτω ήδη στην πρώτη οθόνη, πέρνα σε inline. Μια προεπιλογή είναι κι αυτή επιλογή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sisältö työntyy alas jo ensimmäisessä näkymässä, vaihda inlineen. Oletus on silti valinta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika konten terdorong turun sejak layar pertama, ganti ke inline. Bawaan tetap sebuah pilihan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis innhold blir skjøvet ned allerede på første skjerm, bytt til inline. En standard er fortsatt et valg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als inhoud al op het allereerste scherm omlaag wordt geduwd, schakel dan over op inline. Een standaard is nog steeds een keuze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli treść jest spychana w dół już na pierwszym ekranie, przełącz na inline. Ustawienie domyślne to wciąż wybór."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om innehållet trycks ner redan på första skärmen, byt till inline. En standard är fortfarande ett val."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerik ilk ekranda aşağı itiliyorsa inline'a geç. Varsayılan da bir seçimdir."
          }
        }
      }
    },
    "최대 제한(2.1.1)만으로는 **\"짧은 콘텐츠가 레이아웃을 무너뜨리는\" 문제**를 못 막음, 그리드에서 카드 높이가 제각각이면 시각적 정렬이 깨짐. 텍스트가 아니라 **텍스트가 차지하는 공간**을 계약으로 만들어, 콘텐츠와 레이아웃을 분리한 것.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A maximum alone (2.1.1) can't prevent **the problem of \"short content breaking the layout\"**: when card heights vary in a grid, the visual alignment falls apart. This makes **the space the text takes up**, rather than the text itself, the contract, separating content from layout."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A maximum alone (2.1.1) can't prevent **the problem of \"short content breaking the layout\"**: when card heights vary in a grid, the visual alignment falls apart. This makes **the space the text takes up**, rather than the text itself, the contract, separating content from layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大の制限（2.1.1）だけでは「**短いコンテンツがレイアウトを崩す」問題**を防げない。グリッドでカードの高さがばらばらだと、視覚的な整列が崩れる。テキストではなく**テキストが占めるスペース**を契約にすることで、コンテンツとレイアウトを切り離したもの。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光靠最大限制（2.1.1）挡不住**“短内容破坏布局”的问题**：网格里卡片高度参差不齐，视觉对齐就破了。把**文字所占的空间**而不是文字本身变成约定，使内容和布局分离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "光靠最大限制（2.1.1）擋不住**「短內容破壞佈局」的問題**：網格里卡片高度參差不齊，視覺對齊就破了。把**文字所佔的空間**而不是文字本身變成約定，使內容和佈局分離。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один только максимум (2.1.1) не предотвращает **проблему «короткое содержимое ломает макет»**: когда высоты карточек в сетке различаются, визуальное выравнивание рассыпается. Это делает договором **место, которое занимает текст**, а не сам текст, разделяя содержимое и макет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un máximo por sí solo (2.1.1) no puede evitar **el problema de que «el contenido corto rompa el diseño»**: cuando las alturas de las tarjetas varían en una cuadrícula, la alineación visual se desmorona. Esto hace que el contrato sea **el espacio que ocupa el texto**, y no el texto en sí, separando contenido y diseño."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Maximum allein (2.1.1) kann **das Problem „kurzer Inhalt bricht das Layout“** nicht verhindern: Variieren die Kartenhöhen in einem Raster, zerfällt die visuelle Ausrichtung. Das macht **den Platz, den der Text einnimmt**, statt des Textes selbst zum Vertrag und trennt Inhalt von Layout."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un maximum seul (2.1.1) ne peut pas empêcher **le problème du « contenu court qui casse la mise en page »** : quand les hauteurs de cartes varient dans une grille, l'alignement visuel s'effondre. Cela fait de **l'espace que prend le texte**, plutôt que du texte lui-même, le contrat, séparant le contenu de la mise en page."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un massimo da solo (2.1.1) non può impedire **il problema del «contenuto breve che rompe il layout»**: quando le altezze delle schede variano in una griglia, l'allineamento visivo si sfalda. Questo fa diventare il contratto **lo spazio che il testo occupa**, anziché il testo stesso, separando contenuto e layout."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um máximo (2.1.1) não consegue evitar **o problema do «conteúdo curto quebrando o layout»**: quando as alturas dos cartões variam numa grade, o alinhamento visual se desfaz. Isto faz do contrato **o espaço que o texto ocupa**, e não o texto em si, separando conteúdo de layout."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าสูงสุดอย่างเดียว (2.1.1) ป้องกัน**ปัญหา \"เนื้อหาสั้นทำลายเลย์เอาต์\"** ไม่ได้: เมื่อความสูงการ์ดต่างกันในกริด การจัดแนวทางภาพพัง นี่ทำให้ **พื้นที่ที่ข้อความกิน** ไม่ใช่ตัวข้อความ เป็นสัญญา โดยแยกเนื้อหาออกจากเลย์เอาต์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ số tối đa (2.1.1) không ngăn được **vấn đề \"nội dung ngắn làm vỡ bố cục\"**: khi chiều cao thẻ khác nhau trong lưới, sự thẳng hàng thị giác sụp đổ. Điều này biến **chỗ mà văn bản chiếm**, thay vì bản thân văn bản, thành hợp đồng, tách nội dung khỏi bố cục."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Samotné maximum (2.1.1) nedokáže zabránit **problému „krátký obsah rozbíjí rozvržení“**: když se výšky karet v mřížce liší, vizuální zarovnání se rozpadne. Tím se smlouvou stane **místo, které text zabírá**, spíše než samotný text, a obsah se oddělí od rozvržení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et maksimum alene (2.1.1) kan ikke forhindre **problemet med, at »kort indhold bryder layoutet«**: når kortenes højder varierer i et gitter, falder den visuelle justering fra hinanden. Det gør **den plads, teksten optager,** frem for selve teksten til kontrakten og adskiller indhold fra layout."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μέγιστο μόνο του (2.1.1) δεν μπορεί να αποτρέψει **το πρόβλημα του «σύντομου περιεχομένου που σπάει τη διάταξη»**: όταν τα ύψη των καρτών διαφέρουν σε ένα πλέγμα, η οπτική ευθυγράμμιση καταρρέει. Έτσι **ο χώρος που παίρνει το κείμενο**, και όχι το ίδιο το κείμενο, γίνεται το συμβόλαιο, χωρίζοντας το περιεχόμενο από τη διάταξη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelkkä maksimi (2.1.1) ei voi estää **”lyhyt sisältö rikkoo asettelun” -ongelmaa**: kun korttien korkeudet vaihtelevat ruudukossa, visuaalinen linjaus hajoaa. Tämä tekee sopimukseksi **tekstin vaatiman tilan** eikä itse tekstin, erottaen sisällön asettelusta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksimum saja (2.1.1) tidak bisa mencegah **masalah \"konten pendek merusak tata letak\"**: saat tinggi kartu bervariasi di grid, keselarasan visual runtuh. Ini menjadikan **ruang yang dipakai teks**, bukan teks itu sendiri, sebagai kontrak, memisahkan konten dari tata letak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et maksimum alene (2.1.1) kan ikke hindre **problemet med «kort innhold som ødelegger layouten»**: når korthøyder varierer i et rutenett, faller den visuelle justeringen fra hverandre. Dette gjør **plassen teksten tar opp**, heller enn teksten selv, til kontrakten, og skiller innhold fra layout."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een maximum (2.1.1) kan **het probleem van \"korte inhoud die de layout breekt\"** niet voorkomen: als kaarthoogtes in een raster variëren, valt de visuele uitlijning uiteen. Dit maakt **de ruimte die de tekst inneemt**, in plaats van de tekst zelf, het contract, en scheidt inhoud van layout."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo maksimum (2.1.1) nie zapobiegnie **problemowi „krótka treść psuje układ”**: gdy wysokości kart w siatce się różnią, wyrównanie wizualne się sypie. Dlatego umową staje się **miejsce zajmowane przez tekst**, a nie sam tekst, co oddziela treść od układu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Enbart ett maximum (2.1.1) kan inte förhindra **problemet ”kort innehåll bryter layouten”**: när kortens höjder varierar i ett rutnät faller den visuella uppställningen sönder. Därför blir det **utrymmet som texten tar**, snarare än själva texten, som är avtalet, vilket skiljer innehåll från layout."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek başına bir üst sınır (2.1.1) **“kısa içeriğin düzeni bozması” sorununu** önleyemez: kart yükseklikleri bir ızgarada değiştiğinde görsel hizalama dağılır. Bu, metnin kendisini değil **metnin kapladığı alanı** sözleşme yapar ve içeriği düzenden ayırır."
          }
        }
      }
    },
    "최상위 영역이 3~5개로 정리되는 **대부분의 앱**. 고민 없이 쓸 수 있는 안전 범위.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Most apps**, whose top-level areas boil down to three to five. A safe range you can use without second-guessing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Most apps**, whose top-level areas boil down to three to five. A safe range you can use without second-guessing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最上位の領域が3〜5個に整理できる**ほとんどのアプリ**。迷わず使える安全な範囲。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶层区域整理为 3 到 5 个的**大多数应用**。无需犹豫就能使用的安全范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂層區域整理為 3 到 5 個的**大多數應用程式**。無需猶豫就能使用的安全範圍。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Большинство приложений**, у которых области верхнего уровня сводятся к трём-пяти. Безопасный диапазон, которым можно пользоваться, не сомневаясь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**La mayoría de las apps**, cuyas áreas de nivel superior se reducen a entre tres y cinco. Un rango seguro que puedes usar sin dudar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Die meisten Apps**, deren Bereiche auf oberster Ebene auf drei bis fünf hinauslaufen. Ein sicherer Bereich, den du ohne Zweifel nutzen kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**La plupart des apps**, dont les zones de premier niveau se ramènent à trois à cinq. Une plage sûre que vous pouvez utiliser sans hésiter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**La maggior parte delle app**, le cui aree di primo livello si riducono a tre-cinque. Un intervallo sicuro che puoi usare senza ripensarci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**A maioria dos apps**, cujas áreas de nível superior se resumem a três a cinco. Uma faixa segura que você pode usar sem pensar duas vezes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**แอปส่วนใหญ่** ที่ส่วนระดับบนสุดสรุปลงที่สามถึงห้า ช่วงปลอดภัยที่ใช้ได้โดยไม่ต้องลังเล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hầu hết app**, có các vùng cấp cao nhất quy về ba đến năm. Một phạm vi an toàn bạn dùng được mà không phải nghi ngờ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Většina aplikací**, jejichž oblasti nejvyšší úrovně se redukují na tři až pět. Bezpečný rozsah, který můžete používat bez zbytečného váhání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**De fleste apps**, hvis områder på øverste niveau koger ned til tre til fem. Et sikkert interval, du kan bruge uden at tvivle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Οι περισσότερες εφαρμογές**, των οποίων οι περιοχές ανώτατου επιπέδου καταλήγουν σε τρεις έως πέντε. Ένα ασφαλές εύρος που μπορείς να χρησιμοποιείς χωρίς δεύτερες σκέψεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Useimmat sovellukset**, joiden ylätason alueet tiivistyvät kolmeen-viiteen. Turvallinen väli, jota voit käyttää kahdesti miettimättä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kebanyakan aplikasi**, yang area tingkat atasnya mengerucut menjadi tiga sampai lima. Rentang aman yang bisa dipakai tanpa ragu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**De fleste apper**, hvis toppnivåområder koker ned til tre til fem. Et trygt område du kan bruke uten å nøle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**De meeste apps**, waarvan de gebieden op het hoogste niveau neerkomen op drie tot vijf. Een veilig bereik dat je zonder twijfel kunt gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Większość aplikacji**, w których obszary najwyższego poziomu sprowadzają się do trzech do pięciu. Bezpieczny zakres, nad którym nie trzeba się zastanawiać."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**De flesta appar**, vars områden på högsta nivå kokar ner till tre till fem. Ett säkert intervall som du kan använda utan att tveka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst düzey alanları üç ile beşe inen **çoğu uygulama**. İkinci kez düşünmeden kullanabileceğin güvenli bir aralık."
          }
        }
      }
    },
