            "state": "translated",
            "value": "Quebra a metáfora espacial"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำลายอุปมาเชิงพื้นที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phá vỡ ẩn dụ không gian"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porušuje prostorovou metaforu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bryder den rumlige metafor"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραβιάζει τη χωρική μεταφορά"
          }
        }
      }
    },
    "공간은 계약, 텍스트는 가변": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space is a contract, text is variable"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Space is a contract, text is variable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースは契約、テキストは可変"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间是约定，文字是可变的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空間是約定，文字是可變的"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пространство - договорённость, текст - переменная"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio es un contrato, el texto es variable"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platz ist ein Vertrag, Text ist variabel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace est un contrat, le texte est variable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio è un contratto, il testo è variabile"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço é um contrato, o texto é variável"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่คือสัญญา ส่วนข้อความเปลี่ยนแปลงได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gian là hợp đồng, văn bản là biến số"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostor je smlouva, text je proměnná"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Plads er en kontrakt, tekst er variabel"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο χώρος είναι συμβόλαιο, το κείμενο είναι μεταβλητό"
          }
        }
      }
    },
    "공간은 유한한데 텍스트 길이는 예측 불가. 잘림·축소·예약 중 무엇을 쓸지는 **그 텍스트가 \"문장\"인지 \"값\"인지**가 정한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space is finite, but text length is unpredictable. Whether to truncate, scale or reserve space depends on **whether the text is a \"sentence\" or a \"value.\"**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Space is finite, but text length is unpredictable. Whether to truncate, scale or reserve space depends on **whether the text is a \"sentence\" or a \"value.\"**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースには限りがあるが、テキストの長さは予測できない。切り詰め・縮小・確保のどれを使うかは、**そのテキストが「文」か「値」か**で決まる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间有限，文字长度无法预测。用截断、缩小还是预留，由**那段文字是“句子”还是“数值”**决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空間有限，文字長度無法預測。用截斷、縮小還是預留，由**那段文字是「句子」還是「數值」**決定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место конечно, а длина текста непредсказуема. Обрезать, масштабировать или резервировать, зависит от того, **«предложение» это или «значение»**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio es finito, pero la longitud del texto es impredecible. Truncar, escalar o reservar espacio depende de **si el texto es una «frase» o un «valor»**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platz ist endlich, aber die Textlänge ist unvorhersehbar. Ob man abschneidet, skaliert oder Platz reserviert, hängt davon ab, **ob der Text ein „Satz“ oder ein „Wert“ ist.**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace est fini, mais la longueur du texte est imprévisible. Tronquer, mettre à l'échelle ou réserver de l'espace dépend de **savoir si le texte est une « phrase » ou une « valeur »**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio è finito, ma la lunghezza del testo è imprevedibile. Se troncare, scalare o riservare spazio dipende da **se il testo è una «frase» o un «valore».**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço é finito, mas o comprimento do texto é imprevisível. Truncar, escalar ou reservar espaço depende de **o texto ser uma «frase» ou um «valor»**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่มีจำกัด แต่ความยาวข้อความคาดเดาไม่ได้ การตัด ปรับขนาด หรือสำรองพื้นที่ขึ้นอยู่กับ**ว่าข้อความเป็น \"ประโยค\" หรือ \"ค่า\"**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gian hữu hạn, nhưng độ dài văn bản thì khó đoán. Cắt, co hay giữ chỗ tùy **văn bản là một \"câu\" hay một \"giá trị.\"**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostor je konečný, ale délka textu je nepředvídatelná. Zda ořezat, škálovat nebo rezervovat místo, závisí na tom, **zda je text „věta“, nebo „hodnota“.**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pladsen er begrænset, men tekstlængden er uforudsigelig. Om du skal afkorte, skalere eller reservere plads afhænger af, **om teksten er en »sætning« eller en »værdi«.**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο χώρος είναι πεπερασμένος, αλλά το μήκος του κειμένου είναι απρόβλεπτο. Το αν θα περικόψεις, θα κλιμακώσεις ή θα δεσμεύσεις χώρο εξαρτάται από το **αν το κείμενο είναι «πρόταση» ή «τιμή».**"
          }
        }
      }
    },
    "공간을 아끼려고 묶고 싶을 때, 그 묶음이 말하는 내용이 사실인지 먼저 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you're tempted to group things to save space, first check whether what the grouping says is true."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you're tempted to group things to save space, first check whether what the grouping says is true."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを節約するためにまとめたくなったら、そのまとまりが伝える内容が事実かどうかを先に確かめる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了省空间想把东西归成一组时，先看这个分组所说的内容是否属实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了省空間想把東西歸成一組時，先看這個分組所說的內容是否屬實。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда хочется сгруппировать, чтобы сэкономить место, сначала проверьте, правду ли говорит эта группировка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te tiente agrupar cosas para ahorrar espacio, comprueba primero si lo que dice la agrupación es verdad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du versucht bist, Dinge zu gruppieren, um Platz zu sparen, prüfe zuerst, ob wahr ist, was die Gruppierung aussagt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous êtes tenté de regrouper pour gagner de la place, vérifiez d'abord que ce que dit le regroupement est vrai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sei tentato di raggruppare per risparmiare spazio, controlla prima se ciò che il raggruppamento dice è vero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você for tentado a agrupar para economizar espaço, confira primeiro se o que o agrupamento diz é verdade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อถูกล่อให้จัดกลุ่มเพื่อประหยัดพื้นที่ ให้ตรวจก่อนว่าสิ่งที่การจัดกลุ่มบอกเป็นความจริงหรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bị cám dỗ gom nhóm để tiết kiệm chỗ, trước hết hãy kiểm tra điều việc gom nhóm nói ra có đúng không."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když vás láká seskupit věci, abyste ušetřili místo, nejdřív zkontrolujte, zda je to, co seskupení říká, pravda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du er fristet til at gruppere ting for at spare plads, så tjek først, om det, grupperingen siger, er sandt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν σε δελεάζει να ομαδοποιήσεις πράγματα για εξοικονόμηση χώρου, έλεγξε πρώτα αν είναι αληθές αυτό που λέει η ομαδοποίηση."
          }
        }
      }
    },
    "공간을 예약할 때 묻는다. \"이 빈 공간은 누구와 줄을 맞추려는가?\" 맞출 이웃이 없으면 예약할 이유도 없다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you reserve space, ask: \"Who is this empty space trying to line up with?\" If there's no neighbor to line up with, there's no reason to reserve it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you reserve space, ask: \"Who is this empty space trying to line up with?\" If there's no neighbour to line up with, there's no reason to reserve it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースを確保するときは問う。「この空白は誰と並びをそろえようとしているのか?」そろえる相手がいなければ、確保する理由もない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预留空间时先问：“这块空白是要和谁对齐？”没有要对齐的邻居，就没有预留的理由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預留空間時先問：「這塊空白是要和誰對齊？」沒有要對齊的鄰居，就沒有預留的理由。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервируя место, спросите: «С кем это пустое место пытается выровняться?» Если выравниваться не с кем, причин резервировать нет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando reserves espacio, pregunta: «¿Con quién intenta alinearse este espacio vacío?» Si no hay vecino con quien alinearse, no hay motivo para reservarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage beim Reservieren von Platz: „Mit wem soll dieser leere Platz fluchten?“ Gibt es keinen Nachbarn zum Ausrichten, gibt es keinen Grund zum Reservieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous réservez de l'espace, demandez : « Avec quoi cet espace vide cherche-t-il à s'aligner ? » S'il n'y a pas de voisin avec qui s'aligner, il n'y a aucune raison de réserver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando riservi spazio, chiediti: «Con chi cerca di allinearsi questo spazio vuoto?» Se non c'è un vicino con cui allinearsi, non c'è motivo di riservarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você reserva espaço, pergunte: «Com quem esse espaço vazio está tentando se alinhar?» Se não há vizinho com quem se alinhar, não há motivo para reservar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณสำรองพื้นที่ ให้ถามว่า \"พื้นที่ว่างนี้พยายามเรียงแนวกับใคร\" ถ้าไม่มีข้างเคียงให้เรียงแนว ก็ไม่มีเหตุผลต้องสำรอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi giữ chỗ, hãy hỏi: \"Khoảng trống này đang cố thẳng hàng với cái gì?\" Nếu không có hàng xóm nào để thẳng hàng thì không có lý do để giữ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když rezervujete místo, zeptejte se: „S čím se má toto prázdné místo zarovnat?“ Pokud není souseda, se kterým zarovnat, není důvod rezervovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du reserverer plads, så spørg: »Hvem forsøger denne tomme plads at flugte med?« Hvis der ikke er nogen nabo at flugte med, er der ingen grund til at reservere den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν δεσμεύεις χώρο, ρώτα: «Με ποιον προσπαθεί να ευθυγραμμιστεί αυτός ο κενός χώρος;» Αν δεν υπάρχει γείτονας για ευθυγράμμιση, δεν υπάρχει λόγος να τον δεσμεύσεις."
          }
        }
      }
    },
    "공간이 극도로 좁은 보조 바에서 제한적으로": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparingly, on a secondary bar where space is extremely tight"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparingly, on a secondary bar where space is extremely tight"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースが極端に狭い補助的なバーで、限定的に"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在空间极其狭窄的辅助栏里有限使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在空間極其狹窄的輔助列裡有限使用"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Умеренно, на вторичной панели, где места крайне мало"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con moderación, en una barra secundaria donde el espacio es extremadamente escaso"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparsam, auf einer Nebenleiste, wo der Platz extrem knapp ist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec parcimonie, sur une barre secondaire où la place est extrêmement comptée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con parsimonia, in una barra secondaria dove lo spazio è estremamente limitato"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com parcimônia, numa barra secundária em que o espaço é extremamente apertado"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้อย่างประหยัดบนแถบรองที่พื้นที่คับแคบมาก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dè dặt, trên thanh phụ nơi chỗ cực kỳ chật"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Střídmě, na vedlejším panelu, kde je místa extrémně málo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparsomt, på en sekundær bjælke hvor pladsen er ekstremt trang"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με φειδώ, σε δευτερεύουσα γραμμή όπου ο χώρος είναι εξαιρετικά στενός"
          }
        }
      }
    },
    "공유는 화면의 정체성이 아니라 부가 액션. 위계상 가장 강한 중앙 자리에 두면 제목까지 사라지면서 \"이 화면이 무엇인지\"를 말할 장치가 없어짐": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing is a secondary action, not the identity of the screen. Put it in the strongest slot in the hierarchy and the title disappears too, leaving nothing to say \"what this screen is\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing is a secondary action, not the identity of the screen. Put it in the strongest slot in the hierarchy and the title disappears too, leaving nothing to say \"what this screen is\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有は画面のアイデンティティではなく付随的なアクション。階層上もっとも強い中央の場所に置くとタイトルまで消え、「この画面が何か」を伝える手段がなくなる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享不是界面的身份，而是附加操作。放在层级上最强的中央位置，标题也会消失，就没有东西能说明“这个界面是什么”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享不是介面的身份，而是附加操作。放在層級上最強的中央位置，標題也會消失，就沒有東西能說明「這個介面是什麼」"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Поделиться» - вторичное действие, а не идентичность экрана. Поставьте его в самый сильный слот иерархии, и заголовок тоже исчезнет, и нечем будет сказать, «что это за экран»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir es una acción secundaria, no la identidad de la pantalla. Ponlo en el sitio más fuerte de la jerarquía y el título también desaparece, sin nada que diga «qué es esta pantalla»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen ist eine Nebenaktion, nicht die Identität des Bildschirms. Setzt man es an den stärksten Platz der Hierarchie, verschwindet auch der Titel, und nichts sagt mehr, „was dieser Bildschirm ist“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager est une action secondaire, pas l'identité de l'écran. Placez-le à l'emplacement le plus fort de la hiérarchie et le titre disparaît aussi, ne laissant plus rien pour dire « ce qu'est cet écran »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividere è un'azione secondaria, non l'identità della schermata. Mettilo nello slot più forte della gerarchia e anche il titolo sparisce, senza lasciare nulla che dica «che cos'è questa schermata»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhar é uma ação secundária, não a identidade da tela. Ponha no lugar mais forte da hierarquia e o título também desaparece, sem sobrar nada que diga «o que é esta tela»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์เป็นการกระทำรอง ไม่ใช่ตัวตนของหน้าจอ วางในช่องที่แรงที่สุดในลำดับชั้น ชื่อเรื่องก็หายไปด้วย ไม่เหลืออะไรบอกว่า \"หน้าจอนี้คืออะไร\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ là hành động phụ, không phải danh tính của màn hình. Đặt nó vào vị trí mạnh nhất trong thứ bậc thì tiêu đề cũng biến mất, không còn gì nói \"màn hình này là gì\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílení je vedlejší akce, ne identita obrazovky. Dejte ho na nejsilnější slot v hierarchii a zmizí i nadpis a nezůstane nic, co by říkalo „co je tato obrazovka“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deling er en sekundær handling, ikke skærmens identitet. Læg den på den stærkeste plads i hierarkiet, og titlen forsvinder også, så intet fortæller, »hvad denne skærm er«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κοινοποίηση είναι δευτερεύουσα ενέργεια, όχι η ταυτότητα της οθόνης. Βάλ' την στην πιο δυνατή θέση της ιεραρχίας και χάνεται κι ο τίτλος, μη αφήνοντας τίποτα να λέει «τι είναι αυτή η οθόνη»"
          }
        }
      }
    },
    "공유를 한 자리에만 둔다. 어느 자리인지는 빈도가 정한다. 자주 반복해서 누르는 액션이면 하단, 가끔 쓰는 부가 액션이면 상단 trailing이다. 공유가 빠진 자리는 억지로 채우지 않는다. 1.1.3 Leading and Trailing Clusters 예제를 열어 보면 두 캡슐 사이의 빈 공간이 \"서로 다른 일\"을 말한다. 같은 기능이 양쪽에 있으면 그 신호가 거짓이 된다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Share in just one place. Frequency decides which: the bottom if it's an action people tap again and again, the top trailing slot if it's an occasional secondary action. Don't force something into the slot Share left behind. Open the 1.1.3 Leading and Trailing Clusters example and you'll see the empty space between the two capsules saying these are \"different jobs.\" If the same feature is on both sides, that signal becomes a lie."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Share in just one place. Frequency decides which: the bottom if it's an action people tap again and again, the top trailing slot if it's an occasional secondary action. Don't force something into the slot Share left behind. Open the 1.1.3 Leading and Trailing Clusters example and you'll see the empty space between the two capsules saying these are \"different jobs.\" If the same feature is on both sides, that signal becomes a lie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有は1か所だけに置く。どの場所かは頻度が決める。繰り返し押すアクションなら下部、たまに使う付随的なアクションなら上部のtrailingだ。共有が抜けた場所を無理に埋めない。1.1.3 Leading and Trailing Clustersの例を開くと、2つのカプセルの間の余白が「別々の仕事」を語っている。同じ機能が両側にあれば、そのシグナルは嘘になる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享只放一处。放哪里由频率决定：经常、反复点按的操作放底部，偶尔使用的附加操作放顶部 trailing。分享让出的位置不要硬填。打开 1.1.3 Leading and Trailing Clusters 示例，两个胶囊之间的空白在说“不同的事”。同一个功能出现在两边，这个信号就成了假的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享只放一處。放哪裡由頻率決定：經常、反覆輕點的操作放底部，偶爾使用的附加操作放頂部 trailing。分享讓出的位置不要硬填。開啟 1.1.3 Leading and Trailing Clusters 示例，兩個膠囊之間的空白在說「不同的事」。同一個功能出現在兩邊，這個訊號就成了假的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте «Поделиться» только в одном месте. Какое именно, решает частота: внизу, если люди нажимают его снова и снова, или вверху trailing, если это редкое вторичное действие. Не заполняйте силой место, которое «Поделиться» оставило. Откройте пример 1.1.3 Leading and Trailing Clusters, и вы увидите, что пустое место между двумя капсулами говорит «разные задачи». Если одна и та же функция есть с обеих сторон, этот сигнал становится ложью."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon Compartir en un solo sitio. La frecuencia decide cuál: abajo si es una acción que la gente toca una y otra vez, el sitio trailing de arriba si es una acción secundaria ocasional. No fuerces algo en el sitio que dejó Compartir. Abre el ejemplo 1.1.3 Leading and Trailing Clusters y verás el espacio vacío entre las dos cápsulas diciendo que son «trabajos distintos». Si la misma función está en ambos lados, esa señal se vuelve mentira."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze Teilen nur an eine Stelle. Die Häufigkeit entscheidet welche: unten, wenn es eine Aktion ist, die man immer wieder antippt, am oberen trailing-Platz, wenn es eine gelegentliche Nebenaktion ist. Dränge nichts in den Platz, den Teilen hinterlassen hat. Öffne das Beispiel 1.1.3 Leading and Trailing Clusters, und du siehst, wie der leere Raum zwischen den beiden Kapseln sagt, dass dies „verschiedene Aufgaben“ sind. Liegt dieselbe Funktion auf beiden Seiten, wird dieses Signal zur Lüge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez Partager à un seul endroit. La fréquence décide lequel : le bas si c'est une action que les gens touchent encore et encore, l'emplacement trailing du haut si c'est une action secondaire occasionnelle. Ne forcez pas quelque chose dans l'emplacement que Partager a laissé. Ouvrez l'exemple 1.1.3 Leading and Trailing Clusters et vous verrez que l'espace vide entre les deux capsules dit que ce sont des « tâches différentes ». Si la même fonction est des deux côtés, ce signal devient un mensonge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti Condividi in un solo posto. Decide la frequenza: in basso se è un'azione che le persone toccano di continuo, nello slot trailing in alto se è un'azione secondaria occasionale. Non forzare qualcosa nello slot lasciato da Condividi. Apri l'esempio 1.1.3 Gruppi leading e trailing e vedrai lo spazio vuoto tra le due capsule che dice che sono «compiti diversi». Se la stessa funzione sta su entrambi i lati, quel segnale diventa una bugia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponha Compartilhar em um só lugar. A frequência decide qual: embaixo se for uma ação que as pessoas tocam várias vezes, no lugar trailing do topo se for uma ação secundária ocasional. Não force algo no lugar que Compartilhar deixou. Abra o exemplo 1.1.3 Grupos leading e trailing e você verá o espaço vazio entre as duas cápsulas dizendo que são «trabalhos diferentes». Se a mesma funcionalidade está dos dois lados, esse sinal vira mentira."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่แชร์ที่เดียว ความถี่ตัดสินว่าที่ไหน: ด้านล่างถ้าเป็นการกระทำที่คนแตะซ้ำแล้วซ้ำอีก ช่อง trailing ด้านบนถ้าเป็นการกระทำรองนาน ๆ ครั้ง อย่าฝืนใส่สิ่งอื่นในช่องที่แชร์ทิ้งไว้ เปิดตัวอย่าง 1.1.3 Leading and Trailing Clusters แล้วคุณจะเห็นช่องว่างระหว่างสองแคปซูลบอกว่าเป็น \"งานคนละอย่าง\" ถ้าฟีเจอร์เดียวกันอยู่ทั้งสองฝั่ง สัญญาณนั้นก็กลายเป็นเรื่องโกหก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt Chia sẻ ở đúng một nơi. Tần suất quyết định nơi nào: dưới cùng nếu là hành động người ta chạm đi chạm lại, ô trailing phía trên nếu là hành động phụ thỉnh thoảng. Đừng ép thứ gì vào ô Chia sẻ để lại. Mở ví dụ 1.1.3 Leading and Trailing Clusters và bạn sẽ thấy khoảng trống giữa hai capsule nói rằng đây là những \"việc khác nhau.\" Nếu cùng tính năng ở cả hai bên, tín hiệu đó thành lời nói dối."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte Sdílet jen na jedno místo. O místě rozhoduje frekvence: dole, pokud je to akce, na kterou lidé klepají znovu a znovu, slot vpravo nahoře, pokud jde o občasnou vedlejší akci. Nenuťte nic do slotu, který Sdílet opustilo. Otevřete příklad 1.1.3 Leading and Trailing Clusters a uvidíte, že prázdné místo mezi dvěma kapslemi říká, že jde o „různé úkoly“. Pokud je stejná funkce na obou stranách, ten signál se stane lží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg Del på kun ét sted. Hyppigheden afgør hvilket: bunden, hvis det er en handling, folk trykker på igen og igen, øverste trailing-plads, hvis det er en sjælden sekundær handling. Tving ikke noget ind på den plads, Del forlod. Åbn eksempel 1.1.3 Leading- og trailing-klynger, og du vil se den tomme plads mellem de to kapsler sige, at det er »forskellige opgaver.« Hvis den samme funktion er på begge sider, bliver det signal en løgn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε την Κοινοποίηση σε ένα μόνο σημείο. Η συχνότητα αποφασίζει ποιο: κάτω αν είναι ενέργεια που οι άνθρωποι πατούν ξανά και ξανά, στην πάνω trailing θέση αν είναι περιστασιακή δευτερεύουσα ενέργεια. Μη βάζεις με το ζόρι κάτι στη θέση που άφησε η Κοινοποίηση. Άνοιξε το παράδειγμα 1.1.3 Leading και trailing ομάδες και θα δεις τον κενό χώρο ανάμεσα στις δύο κάψουλες να λέει ότι είναι «διαφορετικές δουλειές». Αν η ίδια λειτουργία είναι και στις δύο πλευρές, αυτό το σήμα γίνεται ψέμα."
          }
        }
      }
    },
    "공지 상세 화면의 본문 문단에 `minimumScaleFactor`가 걸려 있다. 짧은 공지는 큰 글자로, 긴 공지는 작은 글자로 보인다. 같은 앱 안에서 본문 크기가 화면마다 다르다. 긴 공지일수록 가장 읽기 힘든 크기가 된다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The body paragraph on an announcement detail screen has `minimumScaleFactor` applied. Short announcements appear in large text, long ones in small text. Within the same app, the body text size differs from screen to screen. The longer the announcement, the harder its text size is to read."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The body paragraph on an announcement detail screen has `minimumScaleFactor` applied. Short announcements appear in large text, long ones in small text. Within the same app, the body text size differs from screen to screen. The longer the announcement, the harder its text size is to read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お知らせ詳細画面の本文段落に `minimumScaleFactor` がかかっている。短いお知らせは大きな文字で、長いお知らせは小さな文字で表示される。同じアプリの中で、本文のサイズが画面ごとに違う。長いお知らせほど、いちばん読みにくいサイズになる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公告详情界面的正文段落加了 `minimumScaleFactor`。短公告显示大字，长公告显示小字。同一个应用里，各个界面的正文大小不同。越长的公告，反而是最难读的大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公告詳情介面的正文段落加了 `minimumScaleFactor`。短公告顯示大字，長公告顯示小字。同一個應用程式裡，各個介面的正文大小不同。越長的公告，反而是最難讀的大小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К абзацу основного текста на экране подробностей объявления применён `minimumScaleFactor`. Короткие объявления показаны крупным текстом, длинные - мелким. В одном приложении размер основного текста отличается от экрана к экрану. Чем длиннее объявление, тем труднее прочитать размер его текста."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El párrafo del cuerpo de una pantalla de detalle de un anuncio tiene aplicado `minimumScaleFactor`. Los anuncios cortos salen en texto grande, los largos en texto pequeño. Dentro de la misma app, el tamaño del texto del cuerpo difiere de una pantalla a otra. Cuanto más largo el anuncio, más difícil es leer su tamaño de texto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den Fließtext eines Ankündigungs-Detailbildschirms ist `minimumScaleFactor` angewendet. Kurze Ankündigungen erscheinen in großem Text, lange in kleinem. Innerhalb derselben App unterscheidet sich die Textgröße des Fließtextes von Bildschirm zu Bildschirm. Je länger die Ankündigung, desto schwerer lesbar ist ihre Textgröße."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paragraphe du corps sur un écran de détail d'annonce a `minimumScaleFactor` appliqué. Les annonces courtes apparaissent en grand texte, les longues en petit texte. Dans la même app, la taille du texte du corps diffère d'un écran à l'autre. Plus l'annonce est longue, plus la taille de son texte est difficile à lire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al paragrafo del corpo in una schermata di dettaglio di un annuncio è applicato `minimumScaleFactor`. Gli annunci brevi appaiono in testo grande, quelli lunghi in testo piccolo. Nella stessa app, la dimensione del testo del corpo cambia da schermata a schermata. Più lungo è l'annuncio, più è difficile da leggere la dimensione del suo testo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No parágrafo do corpo de uma tela de detalhe de aviso, `minimumScaleFactor` está aplicado. Avisos curtos aparecem em texto grande, longos em texto pequeno. No mesmo app, o tamanho do texto do corpo muda de tela para tela. Quanto mais longo o aviso, mais difícil de ler é o tamanho do texto dele."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย่อหน้าเนื้อความบนหน้ารายละเอียดประกาศใช้ `minimumScaleFactor` ประกาศสั้นแสดงเป็นตัวอักษรใหญ่ ประกาศยาวเป็นตัวอักษรเล็ก ภายในแอปเดียวกัน ขนาดตัวอักษรของเนื้อความต่างกันไปแต่ละหน้าจอ ยิ่งประกาศยาว ขนาดตัวอักษรก็ยิ่งอ่านยาก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đoạn nội dung trên màn hình chi tiết thông báo được áp `minimumScaleFactor`. Thông báo ngắn hiện chữ lớn, thông báo dài hiện chữ nhỏ. Trong cùng một app, cỡ chữ nội dung khác nhau giữa các màn hình. Thông báo càng dài, cỡ chữ càng khó đọc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstavec textu na detailní obrazovce oznámení má použit `minimumScaleFactor`. Krátká oznámení se zobrazují velkým písmem, dlouhá malým. V rámci téže aplikace se velikost textu liší od obrazovky k obrazovce. Čím delší oznámení, tím hůř se čte jeho velikost textu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brødteksten på en meddelelsesdetaljeskærm har `minimumScaleFactor` anvendt. Korte meddelelser vises i stor tekst, lange i lille tekst. Inden for samme app er brødtekstens størrelse forskellig fra skærm til skærm. Jo længere meddelelsen er, jo sværere er dens tekststørrelse at læse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η παράγραφος κειμένου σε μια οθόνη λεπτομερειών ανακοίνωσης έχει εφαρμοσμένο `minimumScaleFactor`. Οι σύντομες ανακοινώσεις εμφανίζονται με μεγάλο κείμενο, οι μακριές με μικρό. Μέσα στην ίδια εφαρμογή, το μέγεθος του κειμένου διαφέρει από οθόνη σε οθόνη. Όσο μακρύτερη η ανακοίνωση, τόσο δυσκολότερο να διαβαστεί το μέγεθος του κειμένου της."
          }
        }
      }
    },
    "과밀은 오탭을 만든다. 하단에 내려보낼 것은 한두 개로 정한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crowding causes mis-taps. Limit what goes to the bottom to one or two things."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Crowding causes mis-taps. Limit what goes to the bottom to one or two things."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過密は誤タップを生む。下部に下ろすものは1〜2個に決める。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过于拥挤会造成误点。决定往底部放的，只留一两个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過於擁擠會造成誤點。決定往底部放的，只留一兩個。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теснота ведёт к ошибочным нажатиям. Ограничьте то, что уходит вниз, одним-двумя элементами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apretar causa toques erróneos. Limita lo que va abajo a una o dos cosas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedränge verursacht Fehltipper. Beschränke, was nach unten kommt, auf eins oder zwei Dinge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encombrement provoque des faux touchers. Limitez ce qui va en bas à une ou deux choses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'affollamento causa tocchi sbagliati. Limita a una o due cose ciò che va in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aglomeração causa toques errados. Limite o que vai para a parte de baixo a uma ou duas coisas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความแออัดทำให้แตะพลาด จำกัดสิ่งที่ไปอยู่ด้านล่างให้เหลือหนึ่งหรือสองอย่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chen chúc gây chạm nhầm. Giới hạn thứ đặt ở dưới cùng một hai cái."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přeplněnost způsobuje klepnutí omylem. Omezte to, co jde dolů, na jednu nebo dvě věci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trængsel forårsager fejltryk. Begræns det, der kommer i bunden, til en eller to ting."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το στρίμωγμα προκαλεί κατά λάθος πατήματα. Περιόρισε ό,τι πάει κάτω σε ένα ή δύο πράγματα."
          }
        }
      }
    },
