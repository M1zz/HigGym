            "value": "iPadin automaattisen ylä-trailing-sijoituksen hyväksyminen sellaisenaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerima begitu saja penempatan trailing atas otomatis di iPad"
          }
        },
        "nb": {
          "stringUnit": {
