        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บังคับการตั้งค่าเต็มรูปแบบโดยไม่ตรวจการทับซ้อนและการตัดบนหน้าจอเล็ก (ระดับ SE)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ép bộ đầy đủ mà không kiểm tra chồng chéo và bị cắt trên màn hình nhỏ (cỡ SE)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vynucení plného nastavení bez kontroly překryvů a ořezů na malých obrazovkách (třída SE)"
