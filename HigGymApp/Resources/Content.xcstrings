            "state": "translated",
            "value": "Επιλογή ενεργοποιημένη σε ετικέτες κουμπιών"
          }
        }
      }
    },
    "버튼 라벨에까지 텍스트 선택을 허용한다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowing text selection even on button labels"
          }
        },
        "en-GB": {
