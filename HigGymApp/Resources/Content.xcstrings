        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ตัวควบคุมแบบเซกเมนต์ \"แผนที่/รายการ\" ใน principal** (1.1.5)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bộ điều khiển phân đoạn \"Bản đồ/Danh sách\" trong principal** (1.1.5)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Segmentový ovladač „Mapa/Seznam“ v principal** (1.1.5)"
          }
        },
        "da": {
