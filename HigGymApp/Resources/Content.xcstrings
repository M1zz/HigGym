        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled) lar folk **trykke og holde for å markere og kopiere** skrivebeskyttet tekst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "textSelection(.enabled) laat mensen **ingedrukt houden om** alleen-lezen tekst **te selecteren en te kopiëren**."
          }
