            "value": "Le critère"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il criterio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O critério"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกณฑ์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu chí"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritérium"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kriteriet"
          }
        },
        "el": {
