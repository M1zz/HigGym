    "iPad에서 상단 trailing 자동 배치를 그대로 수용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting the automatic top trailing placement on iPad as is"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting the automatic top trailing placement on iPad as is"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadでの上部trailingへの自動配置をそのまま受け入れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 上直接接受顶部 trailing 自动布局"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 上直接接受頂部 trailing 自動佈局"
          }
        },
        "ru": {
