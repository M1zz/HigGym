          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกการค้นหาแบบตัวกรองที่ทำให้รายการแคบลงขึ้นเป็นแท็บ (.searchable คือโครงสร้างที่ถูก)"
