    "커머스의 **장바구니** 탭 강조": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emphasizing the **Cart** tab in a shopping app"
          }
        },
        "en-GB": {
          "stringUnit": {
