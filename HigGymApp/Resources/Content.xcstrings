        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the default, and you think transitions are a matter of taste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトだし、トランジションは好みの問題だと考える。"
