            "state": "translated",
            "value": "Et komplisert tolinjes kontrollpanel"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ingewikkeld bedieningspaneel van twee regels"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skomplikowany dwuwierszowy panel sterowania"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En komplicerad tvåradig kontrollpanel"
