    "글자가 묻히는데 투명한 쪽이 예뻐서 그대로 둔다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving text buried because the transparent version looks prettier"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving text buried because the transparent version looks prettier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字が埋もれているのに、透明なほうがきれいだからそのままにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字被盖住了，但透明的一边更好看，所以就保留了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字被蓋住了，但透明的一邊更好看，所以就保留了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить текст похороненным, потому что прозрачный вариант красивее"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar el texto enterrado porque la versión transparente es más bonita"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text vergraben lassen, weil die transparente Variante hübscher aussieht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisser du texte enseveli parce que la version transparente est plus jolie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciare il testo sepolto perché la versione trasparente è più bella"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar o texto enterrado porque a versão transparente é mais bonita"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปล่อยข้อความจมเพราะเวอร์ชันโปร่งใสดูสวยกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để văn bản bị chôn vì bản trong suốt trông đẹp hơn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechat text pohřbený, protože průhledná verze vypadá hezčí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lade tekst være begravet, fordi den gennemsigtige version ser pænere ud"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήνοντας κείμενο θαμμένο επειδή η διαφανής έκδοση φαίνεται πιο όμορφη"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstin jättäminen hautaan, koska läpinäkyvä versio näyttää kauniimmalta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membiarkan teks terkubur karena versi transparan tampak lebih cantik"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å la teksten bli begravd fordi den gjennomsiktige versjonen ser penere ut"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst begraven laten omdat de transparante versie mooier is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostawianie tekstu zakopanego, bo przezroczysta wersja wygląda ładniej"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att låta text vara begravd för att den genomskinliga versionen ser snyggare ut"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saydam sürüm daha güzel göründüğü için metnin gömülü kalması"
          }
        }
      }
    },
    "글자가 묻히는데도 “투명이 예뻐서” 유지(가독성>미학 역전)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping it transparent \"because it looks nice\" even though the text is buried (legibility > aesthetics, reversed)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping it transparent \"because it looks nice\" even though the text is buried (legibility > aesthetics, reversed)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字が埋もれているのに「透明のほうがきれいだから」と維持（読みやすさ > 美しさの逆転）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字被盖住了，却以“透明更好看”为由保留（可读性 > 美观 被颠倒）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字被蓋住了，卻以「透明更好看」為由保留（可讀性 > 美觀 被顛倒）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять прозрачность «потому что красиво», хотя текст похоронен (читаемость > эстетика, наоборот)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerlo transparente «porque se ve bien» aunque el texto quede enterrado (legibilidad > estética, al revés)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transparent lassen, „weil es gut aussieht“, obwohl der Text vergraben ist (Lesbarkeit > Ästhetik, umgekehrt)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder la transparence « parce que c'est joli » alors que le texte est enseveli (lisibilité > esthétique, inversée)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenerlo trasparente «perché è bello» anche se il testo è sepolto (leggibilità > estetica, invertito)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantê-lo transparente «porque fica bonito» mesmo com o texto enterrado (legibilidade > estética, invertido)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คงความโปร่งใส \"เพราะดูดี\" แม้ข้อความจม (ความอ่านออก > ความสวยงาม กลับด้าน)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ trong suốt \"vì trông đẹp\" dù văn bản bị chôn (dễ đọc > thẩm mỹ, bị đảo ngược)"
