            "value": "A shopping list view with a filter bar on top and an action bar below"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上にフィルタバー、下にアクションバーを置いたショッピングアプリの一覧"
          }
        },
        "zh-Hans": {
