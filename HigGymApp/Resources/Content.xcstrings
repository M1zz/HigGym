            "state": "translated",
            "value": "Ένα φύλλο πλήρους ύψους για επιλογή ανάμεσα σε δύο στοιχεία"
          }
        }
      }
    },
    "항목 두 개짜리 선택지에 전체 높이 시트를 쓴다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using a full-height sheet for a two-option choice"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Using a full-height sheet for a two-option choice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択肢が2つだけなのに全画面の高さのシートを使う"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为只有两个项目的选择使用全高弹层"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為只有兩個項目的選擇使用全高工作表"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование шторки на всю высоту для выбора из двух вариантов"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar una hoja de altura completa para una elección de dos opciones"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sheet in voller Höhe für eine Wahl zwischen zwei Optionen nutzen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser une feuille pleine hauteur pour un choix entre deux options"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usare un foglio a tutta altezza per una scelta tra due opzioni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar uma folha de altura total para uma escolha de duas opções"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ชีตเต็มความสูงสำหรับการเลือกสองตัวเลือก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng sheet toàn chiều cao cho lựa chọn hai phương án"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použití sheetu v plné výšce pro volbu ze dvou možností"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At bruge et ark i fuld højde til et valg mellem to muligheder"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήση φύλλου πλήρους ύψους για επιλογή δύο επιλογών"
          }
        }
      }
    },
    "항목 순서를 기능 흐름대로 정리하다 보니 중간에 놓인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorting the items by workflow just happens to land it in the middle."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorting the items by workflow just happens to land it in the middle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目の順番を機能の流れどおりに整理していたら、真ん中に置かれる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按功能流程整理项目顺序，结果被放在了中间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按功能流程整理項目順序，結果被放在了中間。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сортировка элементов по рабочему процессу, из-за чего он случайно оказывается посередине."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar los elementos por flujo de trabajo hace que justo caiga en el medio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Elemente nach Arbeitsablauf zu sortieren, landet es zufällig in der Mitte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trier les éléments selon le déroulement le fait atterrir par hasard au milieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinare gli elementi secondo il flusso di lavoro fa solo capitare questo in mezzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar os itens pelo fluxo de trabalho só faz isto cair no meio por acaso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเรียงรายการตามเวิร์กโฟลว์ทำให้มันบังเอิญไปอยู่ตรงกลาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp các mục theo quy trình làm việc khiến nó tình cờ rơi vào giữa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seřazení položek podle pracovního postupu je prostě umístí doprostřed."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At sortere elementerne efter arbejdsgang får den bare til at lande i midten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ταξινόμηση των στοιχείων ανά ροή εργασίας τυχαίνει να το φέρνει στη μέση."
          }
        }
      }
    },
    "항목을 하나씩 넘겨 보는 상세 화면의 하단 툴바에 휴지통 하나만 떠 있다. 이 화면에서 엄지는 계속 하단을 지나간다. 넘기고, 쥐고, 고쳐 잡는다. 그 길목 한가운데에 되돌릴 수 없는 버튼이 혼자 놓여 있다. 잘못 닿으면 방금 보던 것이 사라진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lone trash can floats in the bottom toolbar of a detail screen where you page through items one by one. On this screen, your thumb keeps passing over the bottom: swiping, gripping, adjusting your hold. Right in the middle of that path sits an irreversible button, all by itself. Brush it by mistake and what you were just looking at disappears."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A lone trash can floats in the bottom toolbar of a detail screen where you page through items one by one. On this screen, your thumb keeps passing over the bottom: swiping, gripping, adjusting your hold. Right in the middle of that path sits an irreversible button, all by itself. Brush it by mistake and what you were just looking at disappears."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を1つずつめくって見る詳細画面の下部ツールバーに、ゴミ箱がひとつだけ浮かんでいる。この画面では親指がずっと下部を通る。めくり、握り、持ち直す。その通り道の真ん中に、取り消せないボタンがぽつんと置かれている。誤って触れれば、いま見ていたものが消える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐项翻看的详情界面底部工具栏里只浮着一个垃圾桶。在这个界面里，拇指不停地经过底部：翻页、握持、调整握姿。在这条路的正中间，孤零零地放着一个无法撤销的按钮。一旦碰错，刚才看的东西就没了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐項翻看的詳情介面底部工具列裡只浮著一個垃圾桶。在這個介面裡，拇指不停地經過底部：翻頁、握持、調整握姿。在這條路的正中間，孤零零地放著一個無法撤銷的按鈕。一旦碰錯，剛才看的東西就沒了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одинокая корзина парит на нижней панели инструментов экрана подробностей, где вы листаете элементы по одному. На этом экране большой палец постоянно проходит по низу: смахивает, держит, поправляет хват. Прямо посередине этого пути в одиночестве стоит необратимая кнопка. Заденьте её по ошибке, и то, на что вы только что смотрели, исчезнет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una papelera solitaria flota en la barra de herramientas inferior de una pantalla de detalle donde pasas elementos de uno en uno. En esta pantalla, tu pulgar pasa continuamente por la parte inferior: deslizando, agarrando, ajustando el agarre. Justo en medio de ese camino hay un botón irreversible, completamente solo. Rózalo por error y lo que acabas de mirar desaparece."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der unteren Symbolleiste eines Detailbildschirms, auf dem man Element für Element blättert, schwebt ein einsamer Papierkorb. Auf diesem Bildschirm läuft dein Daumen ständig über den unteren Rand: beim Wischen, Greifen, Umgreifen. Genau auf diesem Weg sitzt ganz allein ein unumkehrbarer Button. Streift man ihn versehentlich, verschwindet, was man gerade ansah."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une corbeille solitaire flotte dans la barre d'outils du bas d'un écran de détail où l'on feuillette les éléments un par un. Sur cet écran, votre pouce passe sans cesse sur le bas : en balayant, en tenant, en rajustant la prise. Juste au milieu de ce parcours se trouve un bouton irréversible, tout seul. Effleurez-le par erreur et ce que vous regardiez disparaît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solitario cestino fluttua nella barra degli strumenti in basso di una schermata di dettaglio in cui scorri gli elementi uno per uno. In questa schermata il pollice passa di continuo sul fondo: scorrendo, afferrando, aggiustando la presa. Proprio in mezzo a quel percorso c'è un pulsante irreversibile, tutto solo. Sfioralo per sbaglio e ciò che stavi guardando sparisce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma lixeira solitária flutua na barra de ferramentas inferior de uma tela de detalhe em que você passa item por item. Nesta tela, o polegar fica passando sobre a parte de baixo: deslizando, segurando, reajustando a pegada. Bem no meio desse caminho está um botão irreversível, sozinho. Roce-o por engano e aquilo que você acabava de ver some."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถังขยะอันเดียวลอยอยู่ในแถบเครื่องมือล่างของหน้ารายละเอียดที่คุณเปิดดูทีละรายการ บนหน้าจอนี้ นิ้วโป้งผ่านด้านล่างตลอด: ปัด จับ ปรับการจับ ตรงกลางทางนั้นมีปุ่มที่ย้อนกลับไม่ได้ลำพัง เฉียดโดยพลาด สิ่งที่คุณเพิ่งดูอยู่ก็หายไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thùng rác đơn độc nổi trong thanh công cụ dưới của màn hình chi tiết nơi bạn lật qua từng mục. Trên màn hình này, ngón cái liên tục lướt qua phần dưới: vuốt, cầm, chỉnh tư thế. Ngay giữa đường đó là một nút không thể hoàn tác, đứng một mình. Quệt nhầm một lần và thứ bạn vừa xem biến mất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Osamocený koš plave ve spodním panelu nástrojů detailní obrazovky, kde listujete po jedné položce. Na této obrazovce palec pořád přejíždí spodek: přejíždí, drží, upravuje úchop. Přímo uprostřed té cesty sedí nevratné tlačítko, úplně samo. Zavadíte o něj omylem a to, na co jste se právě dívali, zmizí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En enlig papirkurv svæver i den nederste værktøjslinje på en detaljeskærm, hvor du blader gennem elementer ét ad gangen. På denne skærm passerer din tommelfinger hele tiden bunden: ved at stryge, gribe, justere grebet. Lige midt i den sti sidder en uigenkaldelig knap, helt alene. Strejf den ved en fejl, og det, du lige kiggede på, forsvinder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας μοναχικός κάδος επιπλέει στην κάτω γραμμή εργαλείων μιας οθόνης λεπτομερειών όπου ξεφυλλίζεις στοιχεία ένα ένα. Σε αυτή την οθόνη, ο αντίχειράς σου περνά συνεχώς πάνω από το κάτω μέρος: σύρσιμο, πιάσιμο, προσαρμογή του πιασίματος. Ακριβώς στη μέση αυτής της διαδρομής κάθεται ένα μη αναστρέψιμο κουμπί, μόνο του. Αγγίξ' το κατά λάθος και αυτό που μόλις έβλεπες εξαφανίζεται."
          }
        }
      }
    },
    "항목이 여남은 개뿐인 설정형 목록 화면이다. 그런데 검색 필드가 늘 떠 있다. 목록은 한눈에 다 들어오는데, 검색 필드가 세로 한 줄을 차지하고 있다. 찾을 것이 별로 없는 화면에서 찾기 도구가 가장 눈에 띈다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a settings-style list screen with only a dozen or so items. Yet a search field is always on display. The whole list fits in a single glance, but the search field still takes up a row of vertical space. On a screen with little to search for, the search tool is the most prominent thing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a settings-style list screen with only a dozen or so items. Yet a search field is always on display. The whole list fits in a single glance, but the search field still takes up a row of vertical space. On a screen with little to search for, the search tool is the most prominent thing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目が十数個しかない設定タイプのリスト画面だ。なのに検索フィールドが常に表示されている。リストはひと目で全部見渡せるのに、検索フィールドが縦に1行を占めている。探すものがほとんどない画面で、探す道具がいちばん目立っている。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是只有十几项的设置型列表界面。可是搜索框一直浮着。列表一眼就能看完，搜索框却占着纵向一行。在几乎没什么可找的界面里，查找工具反而最显眼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是隻有十幾項的設定型列表介面。可是搜尋框一直浮著。列表一眼就能看完，搜尋框卻佔著縱向一行。在幾乎沒什麼可找的介面裡，查詢工具反而最顯眼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это экран-список в стиле настроек всего с дюжиной пунктов. Но поле поиска выставлено постоянно. Весь список умещается в один взгляд, а поле поиска всё равно занимает ряд вертикального места. На экране, где искать почти нечего, инструмент поиска - самое заметное."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una pantalla de lista tipo ajustes con apenas una docena de elementos. Sin embargo, hay un campo de búsqueda siempre expuesto. Toda la lista cabe de un vistazo, pero el campo de búsqueda sigue ocupando una fila de espacio vertical. En una pantalla con poco que buscar, la herramienta de búsqueda es lo más destacado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein Listenbildschirm im Einstellungsstil mit nur etwa einem Dutzend Elementen. Doch ein Suchfeld ist dauerhaft angezeigt. Die ganze Liste passt auf einen Blick, aber das Suchfeld belegt trotzdem eine Zeile vertikalen Platz. Auf einem Bildschirm mit wenig zu Suchendem ist das Suchwerkzeug das Auffälligste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un écran de liste de type réglages avec seulement une douzaine d'éléments. Pourtant un champ de recherche est affiché en permanence. Toute la liste tient d'un coup d'œil, mais le champ de recherche occupe quand même une ligne d'espace vertical. Sur un écran où il y a peu à chercher, l'outil de recherche est ce qu'il y a de plus en vue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una schermata a elenco in stile impostazioni con solo una dozzina di elementi. Eppure un campo di ricerca è sempre in mostra. L'intero elenco ci sta in un solo colpo d'occhio, ma il campo di ricerca occupa comunque una riga di spazio verticale. In una schermata con poco da cercare, lo strumento di ricerca è la cosa più appariscente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma tela de lista em estilo ajustes com só uma dúzia de itens. Mesmo assim, um campo de busca está sempre à mostra. A lista inteira cabe num relance, mas o campo de busca ainda ocupa uma linha de espaço vertical. Numa tela com pouco a buscar, a ferramenta de busca é a coisa mais proeminente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือหน้ารายการแบบการตั้งค่าที่มีรายการแค่ประมาณสิบกว่า แต่ช่องค้นหาแสดงตลอด ทั้งรายการพอดีในพริบตา แต่ช่องค้นหายังกินพื้นที่แนวตั้งหนึ่งแถว บนหน้าจอที่มีอะไรให้ค้นหาน้อย เครื่องมือค้นหาเป็นสิ่งที่เด่นที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là màn hình danh sách kiểu cài đặt chỉ có chừng chục mục. Vậy mà ô tìm kiếm luôn hiển thị. Cả danh sách vừa trong một cái nhìn, nhưng ô tìm kiếm vẫn chiếm một hàng chiều dọc. Trên màn hình có ít thứ để tìm, công cụ tìm kiếm lại là thứ nổi bật nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je obrazovka seznamu ve stylu nastavení s jen tuctem položek. Přesto je vyhledávací pole neustále zobrazeno. Celý seznam se vejde do jediného pohledu, ale vyhledávací pole stále zabírá řádek svislého místa. Na obrazovce, kde je málo co hledat, je nástroj hledání nejnápadnější věcí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en listeskærm i indstillingsstil med kun et dusin elementer. Alligevel vises et søgefelt hele tiden. Hele listen passer på et blik, men søgefeltet optager stadig en række lodret plads. På en skærm med lidt at søge i er søgeværktøjet det mest fremtrædende."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι μια οθόνη λίστας τύπου ρυθμίσεων με μόνο μια δεκαριά στοιχεία. Κι όμως ένα πεδίο αναζήτησης εμφανίζεται πάντα. Ολόκληρη η λίστα χωρά με μια ματιά, αλλά το πεδίο αναζήτησης πιάνει παρ' όλα αυτά μια σειρά κάθετου χώρου. Σε οθόνη με λίγα πράγματα προς αναζήτηση, το εργαλείο αναζήτησης είναι το πιο προεξέχον πράγμα."
          }
        }
      }
    },
    "항상 보이는 만큼 하단 툴바 액션과 공간을 경쟁합니다. 탭바가 있는 화면에선 하단 액션을 절제하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because it's always visible, it competes with bottom toolbar actions for space. Keep bottom actions to a minimum on screens with a tab bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because it's always visible, it competes with bottom toolbar actions for space. Keep bottom actions to a minimum on screens with a tab bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に見えている分、下部ツールバーのアクションと場所を取り合います。タブバーのある画面では、下部のアクションを控えめにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为始终可见，它会和底部工具栏的操作争夺空间。在有标签栏的界面里，要克制底部操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為始終可見，它會和底部工具列的操作爭奪空間。在有標籤列的介面裡，要剋制底部操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поскольку он всегда виден, он конкурирует за место с действиями нижней панели инструментов. На экранах с панелью вкладок сводите нижние действия к минимуму."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como está siempre visible, compite por el espacio con las acciones de la barra de herramientas inferior. Mantén las acciones inferiores al mínimo en pantallas con barra de pestañas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil sie immer sichtbar ist, konkurriert sie mit Aktionen der unteren Symbolleiste um Platz. Halte untere Aktionen auf Bildschirmen mit Tab-Leiste auf ein Minimum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce qu'elle est toujours visible, elle se dispute l'espace avec les actions de la barre d'outils du bas. Réduisez au minimum les actions du bas sur les écrans avec barre d'onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiché è sempre visibile, compete con le azioni della barra degli strumenti in basso per lo spazio. Tieni al minimo le azioni in basso nelle schermate con una barra delle schede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por estar sempre visível, compete com as ações da barra de ferramentas inferior por espaço. Mantenha ao mínimo as ações inferiores em telas com barra de abas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพราะมองเห็นตลอด มันแย่งพื้นที่กับการกระทำของแถบเครื่องมือล่าง คงการกระทำด้านล่างให้น้อยที่สุดบนหน้าจอที่มีแถบแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì luôn hiển thị, nó tranh chỗ với hành động thanh công cụ dưới. Giữ hành động ở dưới ở mức tối thiểu trên màn hình có thanh tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože je vždy viditelný, soupeří o místo s akcemi spodního panelu nástrojů. Na obrazovkách s panelem karet držte spodní akce na minimu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi den altid er synlig, konkurrerer den med nederste værktøjslinjehandlinger om plads. Hold nederste handlinger på et minimum på skærme med en fanelinje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επειδή είναι πάντα ορατό, ανταγωνίζεται τις ενέργειες της κάτω γραμμής εργαλείων για χώρο. Κράτα τις κάτω ενέργειες στο ελάχιστο σε οθόνες με γραμμή καρτελών."
          }
        }
      }
    },
    "항상 보이는 자리에 무엇을 더할 때는 **\"이게 필요 없는 순간에도 이 높이를 치를 만한가\"**를 묻는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When adding something to an always-visible spot, ask **\"Is it worth paying for this height even in the moments when it isn't needed?\"**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When adding something to an always-visible spot, ask **\"Is it worth paying for this height even in the moments when it isn't needed?\"**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に見える場所に何かを加えるときは、**「必要ない瞬間にも、この高さを払う価値があるか**」を問う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "往始终可见的位置加东西时，要问**“在不需要它的时刻，也值得付这个高度吗”**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往始終可見的位置加東西時，要問**「在不需要它的時刻，也值得付這個高度嗎」**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляя что-то в место, всегда видимое, спросите: **«Стоит ли платить за эту высоту даже в моменты, когда это не нужно?»**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al añadir algo a un sitio siempre visible, pregunta **«¿Merece la pena pagar esta altura incluso en los momentos en que no hace falta?»**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage beim Hinzufügen von etwas an einem immer sichtbaren Platz: **„Lohnt es sich, diese Höhe auch in den Momenten zu bezahlen, in denen sie nicht gebraucht wird?“**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En ajoutant quelque chose à un emplacement toujours visible, demandez **« Cela vaut-il la peine de payer cette hauteur même aux moments où ce n'est pas nécessaire ? »**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando aggiungi qualcosa a un posto sempre visibile, chiediti **«Vale la pena pagare questa altezza anche nei momenti in cui non serve?»**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao acrescentar algo a um lugar sempre visível, pergunte **«Vale a pena pagar esta altura até nos momentos em que não é necessária?»**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเพิ่มอะไรในตำแหน่งที่มองเห็นตลอด ให้ถาม**\"คุ้มไหมที่จะจ่ายความสูงนี้แม้ในจังหวะที่ไม่ต้องการ\"**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thêm gì vào một chỗ luôn hiển thị, hãy hỏi **\"Có đáng trả chiều cao này ngay cả những lúc không cần không?\"**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přidáváte něco na vždy viditelné místo, zeptejte se **„Vyplatí se platit za tuto výšku i ve chvílích, kdy není potřeba?“**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du tilføjer noget til en altid synlig plads, så spørg **»Er det værd at betale for denne højde selv i de øjeblikke, hvor der ikke er brug for den?«**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν προσθέτεις κάτι σε πάντα ορατό σημείο, ρώτα **«Αξίζει να πληρώνω αυτό το ύψος ακόμα και στις στιγμές που δεν χρειάζεται;»**"
          }
        }
      }
    },
