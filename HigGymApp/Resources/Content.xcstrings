          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty + role hledání + příslušenství + minimalizace: **plné nastavení spodního systému**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
