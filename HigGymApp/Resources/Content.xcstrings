    "좁은 기기에서 무엇이 먼저 접힐지 우선순위를 설계하고 확인": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Designing and checking the priority of what folds first on a narrow device"
          }
        },
        "en-GB": {
          "stringUnit": {
