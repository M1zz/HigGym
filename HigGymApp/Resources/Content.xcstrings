            "value": "Using the same title size on every screen regardless of depth"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "階層の深さに関係なく、すべての画面で同じタイトルサイズを使う"
          }
        },
        "zh-Hans": {
