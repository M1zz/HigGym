        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題**下方的抽屜**，滾動時摺疊的傳統位置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Выдвижная часть под** заголовком, традиционное место, сворачивающееся при прокрутке"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**El cajón bajo** el título, el sitio tradicional que se colapsa al desplazar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Die Schublade unter** dem Titel, der traditionelle Platz, der beim Scrollen zusammenklappt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Le tiroir sous** le titre, l'emplacement traditionnel qui se replie au défilement"
