          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會摺疊，所以自己做的話就能全部顯示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система сворачивает, поэтому если сделать самому, можно показать всё."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema los pliega, así que construyéndolo tú mismo puedes mostrarlo todo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System faltet sie weg, also kannst du alles zeigen, wenn du es selbst baust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système les replie, donc en le construisant vous-même vous pouvez tout montrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sistema li ripiega, quindi costruendolo tu puoi mostrare tutto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema os dobra, então construindo você mesmo dá para mostrar tudo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบพับมัน การสร้างเองจึงให้คุณแสดงทุกอย่างได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống gập chúng đi, nên tự dựng thì hiện được tất cả."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systém je sbalí, takže když to postavíte sami, můžete ukázat všechno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet folder dem væk, så hvis du bygger det selv, kan du vise alt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το σύστημα τα διπλώνει, οπότε αν το φτιάξεις μόνος σου, μπορείς να δείξεις τα πάντα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmä taittaa ne pois, joten rakentamalla itse voit näyttää kaiken."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem melipatnya, jadi membangun sendiri memungkinkanmu menampilkan semuanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet folder dem bort, så å bygge det selv lar deg vise alt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het systeem klapt ze weg, dus als je het zelf bouwt kun je alles tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "System je zwija, więc zbudowanie tego samemu pozwala pokazać wszystko."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet viker undan dem, så om du bygger det själv kan du visa allt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem onları katlar, bu yüzden kendin kurarsan hepsini gösterebilirsin."
          }
        }
      }
    },
    "시스템이 정해둔 trailing 자리에 둔다. 사용자는 이미 그 자리를 찾을 줄 안다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put it in the trailing slot the system defines. Users already know to look there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put it in the trailing slot the system defines. Users already know to look there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが決めたtrailingの場所に置く。ユーザーはすでにその場所を探せる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放在系统定好的 trailing 位置。用户已经知道去那个位置找。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放在系統定好的 trailing 位置。使用者已經知道去那個位置找。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте в слот trailing, который определяет система. Пользователи уже знают, что смотреть там."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponlo en el sitio trailing que define el sistema. Los usuarios ya saben que deben mirar ahí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze es in den vom System definierten trailing-Platz. Nutzer wissen bereits, dort nachzusehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez-le dans l'emplacement trailing défini par le système. Les utilisateurs savent déjà y regarder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettilo nello slot trailing che il sistema definisce. Gli utenti sanno già di guardare lì."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponha no lugar trailing que o sistema define. Os usuários já sabem olhar ali."
