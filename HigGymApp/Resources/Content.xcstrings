        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 a descendu la recherche vers le pouce. Suivez le placement du système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 ha spostato la ricerca in basso, verso il pollice. Segui la collocazione del sistema."
