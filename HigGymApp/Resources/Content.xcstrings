          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พลาดง่าย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dễ bị bỏ sót"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snadno přehlédnutelné"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Let at overse"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εύκολο να το χάσεις"
          }
        }
      }
    },
    "누를 수 있다는 사실은 스스로 말해야 한다. 아무도 누르지 않는 기능은 없는 기능이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something tappable has to say so on its own. A feature nobody taps might as well not exist."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Something tappable has to say so on its own. A feature nobody taps might as well not exist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押せるという事実は、それ自身が伝えなければならない。誰も押さない機能は、ない機能と同じだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "能点按这件事，要自己说出来。没人点的功能等于没有功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "能輕點這件事，要自己說出來。沒人點的功能等於沒有功能。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, на что можно нажать, должно сказать об этом само. Функции, которую никто не нажимает, словно и нет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo que se puede tocar tiene que decirlo por sí solo. Una función que nadie toca es como si no existiera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas Antippbares muss das von selbst sagen. Eine Funktion, die niemand antippt, könnte genauso gut nicht existieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose de touchable doit le dire de lui-même. Une fonction que personne ne touche pourrait aussi bien ne pas exister."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa di toccabile deve dirlo da solo. Una funzione che nessuno tocca potrebbe anche non esistere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo tocável precisa dizer isso por si só. Uma funcionalidade que ninguém toca bem poderia não existir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่แตะได้ต้องบอกด้วยตัวเอง ฟีเจอร์ที่ไม่มีใครแตะก็เหมือนไม่มีอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thứ gì chạm được phải tự nói điều đó. Một tính năng không ai chạm cũng như không tồn tại."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To, na co lze klepnout, to musí říct samo. Funkce, na kterou nikdo neklepe, může klidně neexistovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget, man kan trykke på, må sige det selv. En funktion, ingen trykker på, kunne lige så godt ikke findes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτι που πατιέται πρέπει να το λέει από μόνο του. Μια λειτουργία που κανείς δεν πατά θα μπορούσε εξίσου να μην υπάρχει."
          }
        }
      }
    },
    "눈과 엄지가 늘 지나가는 자리라 노출이 잘 될 것 같다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes and thumbs pass by it all the time, so it seems like great exposure."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes and thumbs pass by it all the time, so it seems like great exposure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目も親指も常に通る場所なので、よく露出できそうに思える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那是眼睛和拇指总会经过的位置，所以曝光应该会很好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那是眼睛和拇指總會經過的位置，所以曝光應該會很好。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глаза и большие пальцы проходят здесь постоянно, так что кажется, что заметность отличная."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ojos y los pulgares pasan por ahí todo el rato, así que parece una exposición estupenda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Augen und Daumen streifen sie ständig, also scheint sie hervorragend sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les yeux et les pouces y passent tout le temps, donc cela paraît une excellente exposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Occhi e pollici ci passano sempre, quindi sembra un'ottima esposizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhos e polegares passam por ali o tempo todo, então parece ótima exposição."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สายตาและนิ้วโป้งผ่านมันตลอดเวลา จึงดูเหมือนการเปิดเผยที่ยอดเยี่ยม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mắt và ngón cái luôn lướt qua đó, nên có vẻ là chỗ lộ diện tuyệt vời."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oči a palce kolem toho procházejí pořád, takže to vypadá jako skvělá expozice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øjne og tommelfingre passerer den hele tiden, så det ser ud til at give fantastisk eksponering."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μάτια και οι αντίχειρες περνούν από εκεί συνέχεια, οπότε φαίνεται εξαιρετική έκθεση."
          }
        }
      }
    },
    "눌렀던 것과 열린 것이 **같은 것임을 모션으로 증명**하는 장치, 공간적 연속성이 유지되어 “어디서 왔는지”를 설명할 필요가 없습니다. standard는 출처 정보를 버리므로, 출처가 의미 있으면 zoom이 정답.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device that **proves through motion that what you tapped and what opened are the same thing**. Spatial continuity is preserved, so there's no need to explain \"where this came from.\" Standard throws away the origin, so when the origin matters, zoom is the answer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A device that **proves through motion that what you tapped and what opened are the same thing**. Spatial continuity is preserved, so there's no need to explain \"where this came from.\" Standard throws away the origin, so when the origin matters, zoom is the answer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したものと開いたものが**同じものであることを動きで証明する**装置。空間的な連続性が保たれるので、「どこから来たのか」を説明する必要がありません。standardは出どころの情報を捨てるので、出どころに意味があるならzoomが正解。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是**用动效证明“点按的和打开的是同一个东西”**的装置，空间连续性得以保持，不必再解释“从哪里来”。standard 会丢掉来源信息，所以来源有意义时，zoom 才是正解。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是**用動效證明「輕點的和開啟的是同一個東西」**的裝置，空間連續性得以保持，不必再解釋「從哪裡來」。standard 會丟掉來源資訊，所以來源有意義時，zoom 才是正解。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средство, **доказывающее движением, что нажатое и открытое - одно и то же**. Пространственная непрерывность сохраняется, поэтому не нужно объяснять, «откуда это взялось». Standard выбрасывает источник, так что когда источник важен, правильный ответ - zoom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recurso que **demuestra con el movimiento que lo que tocaste y lo que se abrió son lo mismo**. Se conserva la continuidad espacial, así que no hace falta explicar «de dónde viene». Standard descarta el origen, así que cuando el origen importa, la respuesta es zoom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Mittel, das **durch Bewegung beweist, dass das Angetippte und das Geöffnete dasselbe sind**. Die räumliche Kontinuität bleibt erhalten, sodass man nicht erklären muss, „woher das kam“. Standard wirft den Ursprung weg, also ist Zoom die Antwort, wenn der Ursprung zählt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositif qui **prouve par le mouvement que ce que vous avez touché et ce qui s'est ouvert sont la même chose**. La continuité spatiale est préservée, donc inutile d'expliquer « d'où cela vient ». Standard jette l'origine, donc quand l'origine compte, zoom est la réponse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo che **dimostra con il movimento che ciò che hai toccato e ciò che si è aperto sono la stessa cosa**. La continuità spaziale si conserva, quindi non serve spiegare «da dove viene questo». Lo standard butta via l'origine, quindi quando l'origine conta, la risposta è lo zoom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dispositivo que **comprova pelo movimento que o que você tocou e o que abriu são a mesma coisa**. A continuidade espacial é preservada, então não é preciso explicar «de onde isto veio». O padrão joga fora a origem, então, quando a origem importa, a resposta é zoom."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลไกที่**พิสูจน์ผ่านการเคลื่อนไหวว่าสิ่งที่คุณแตะกับสิ่งที่เปิดขึ้นคือสิ่งเดียวกัน** ความต่อเนื่องเชิงพื้นที่คงอยู่ จึงไม่ต้องอธิบายว่า \"มาจากไหน\" Standard ทิ้งต้นทาง ดังนั้นเมื่อต้นทางสำคัญ zoom คือคำตอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cơ chế **chứng minh qua chuyển động rằng thứ bạn chạm và thứ vừa mở là một**. Tính liên tục không gian được giữ, nên không cần giải thích \"nó đến từ đâu.\" Standard bỏ nguồn gốc đi, nên khi nguồn gốc quan trọng, zoom là câu trả lời."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroj, který **pohybem dokazuje, že to, na co jste klepli, a to, co se otevřelo, je totéž**. Prostorová návaznost je zachována, takže není třeba vysvětlovat „odkud to přišlo“. Standard zahodí původ, takže když na původu záleží, odpovědí je zoom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En mekanisme, der **gennem bevægelse beviser, at det, du trykkede på, og det, der åbnede, er det samme**. Den rumlige kontinuitet bevares, så der er ingen grund til at forklare, »hvor dette kom fra.« Standard kasserer oprindelsen, så når oprindelsen betyder noget, er zoom svaret."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας μηχανισμός που **αποδεικνύει μέσω κίνησης ότι αυτό που πάτησες και αυτό που άνοιξε είναι το ίδιο πράγμα**. Η χωρική συνέχεια διατηρείται, οπότε δεν χρειάζεται να εξηγήσεις «από πού ήρθε αυτό». Το standard πετά την προέλευση, οπότε όταν η προέλευση μετράει, το zoom είναι η απάντηση."
          }
        }
      }
    },
    "늘 보이는 자리에 무언가를 모으고 싶어질 때 묻는다. \"이 자리는 스크롤하면 어떻게 되지?\" 물러나는 자리라면 늘 필요한 것은 거기 두지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you're tempted to gather things in an always-visible spot, ask: \"What happens to this spot when I scroll?\" If it steps back, don't put things that are always needed there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When you're tempted to gather things in an always-visible spot, ask: \"What happens to this spot when I scroll?\" If it steps back, don't put things that are always needed there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に見える場所に何かを集めたくなったら問う。「この場所はスクロールするとどうなる？」 引いていく場所なら、常に必要なものはそこに置かない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想把东西聚到总是可见的位置时，先问：“这个位置在滚动时会怎样？”如果是会退后的位置，就不要把始终需要的东西放在那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想把東西聚到總是可見的位置時，先問：「這個位置在滾動時會怎樣？」如果是會退後的位置，就不要把始終需要的東西放在那裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда хочется собрать что-то в постоянно видимом месте, спросите: «Что случается с этим местом при прокрутке?» Если оно отступает, не кладите туда то, что нужно всегда."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te tiente reunir cosas en un sitio siempre visible, pregunta: «¿Qué le pasa a este sitio cuando desplazo?» Si retrocede, no pongas ahí lo que siempre se necesita."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du versucht bist, Dinge an einem immer sichtbaren Ort zu sammeln, frage: „Was passiert mit diesem Ort, wenn ich scrolle?“ Tritt er zurück, setze dort nichts hin, was immer gebraucht wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous êtes tenté de rassembler des choses à un endroit toujours visible, demandez : « Que devient cet endroit quand je fais défiler ? » S'il s'efface, n'y mettez pas ce dont on a toujours besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando sei tentato di raccogliere cose in un posto sempre visibile, chiediti: «Che cosa succede a questo posto quando scorro?» Se si fa da parte, non metterci cose che servono sempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você for tentado a reunir coisas num lugar sempre visível, pergunte: «O que acontece com este lugar quando eu rolo?» Se ele recua, não ponha ali coisas de que sempre se precisa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อถูกล่อให้รวบรวมสิ่งต่าง ๆ ในตำแหน่งที่แสดงตลอด ให้ถาม: \"ตำแหน่งนี้เกิดอะไรขึ้นเมื่อฉันเลื่อน\" ถ้ามันถอยออก อย่าวางสิ่งที่ต้องใช้ตลอดไว้ตรงนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bị cám dỗ gom thứ vào một chỗ luôn hiển thị, hãy hỏi: \"Chỗ này sẽ ra sao khi tôi cuộn?\" Nếu nó lùi lại, đừng đặt vào đó thứ luôn cần."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když vás láká shromáždit věci na vždy viditelném místě, zeptejte se: „Co se stane s tímto místem, když posunu?“ Pokud ustoupí, nedávejte tam věci, které jsou potřeba pořád."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du er fristet til at samle ting på en altid synlig plads, så spørg: »Hvad sker der med denne plads, når jeg scroller?« Hvis den træder tilbage, så læg ikke ting der, som altid er brug for."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν σε δελεάζει να συγκεντρώσεις πράγματα σε ένα πάντα ορατό σημείο, ρώτα: «Τι συμβαίνει σε αυτό το σημείο όταν κυλάω;» Αν υποχωρεί, μη βάζεις εκεί πράγματα που χρειάζονται πάντα."
          }
        }
      }
    },
    "다른 배경·다크모드에서 깨짐": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaks on other backgrounds and in Dark Mode"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Breaks on other backgrounds and in Dark Mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの背景やダークモードで崩れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他背景、深色模式下失效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在其他背景、深色模式下失效"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ломается на других фонах и в тёмной теме"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falla sobre otros fondos y en modo oscuro"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricht auf anderen Hintergründen und im Dunkelmodus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casse sur d'autres arrière-plans et en mode sombre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rompe su altri sfondi e in Modalità Scura"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quebra em outros fundos e no Modo Escuro"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พังบนพื้นหลังอื่นและในโหมดมืด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏng trên nền khác và trong Chế độ tối"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozbije se na jiných pozadích a v tmavém režimu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Går i stykker på andre baggrunde og i mørk tilstand"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σπάει σε άλλα φόντα και στη Σκοτεινή εμφάνιση"
          }
        }
      }
    },
    "다른 텍스트와 같은 규칙을 적용하면 일관돼 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying the same rule as other text looks consistent."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying the same rule as other text looks consistent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのテキストと同じルールを当てはめれば、一貫して見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用与其他文字相同的规则，看起来就一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式與其他文字相同的規則，看起來就一致。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применение того же правила, что к остальному тексту, выглядит последовательно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar la misma regla que a los demás textos parece coherente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Regel wie bei anderem Text anzuwenden wirkt konsistent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer la même règle que pour les autres textes paraît cohérent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicare la stessa regola degli altri testi sembra coerente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar a mesma regra dos outros textos parece consistente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้กฎเดียวกับข้อความอื่นดูสอดคล้อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp cùng quy tắc như văn bản khác trông nhất quán."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použití stejného pravidla jako u jiného textu vypadá konzistentně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At anvende samme regel som anden tekst ser ensartet ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή του ίδιου κανόνα με το άλλο κείμενο φαίνεται συνεπής."
          }
        }
      }
    },
    "다른 텍스트와 같은 규칙을 적용하면 일관돼 보인다. \"넘치면 tail로 자른다\"는 한 가지 규칙이 앱 전체에 깔끔하게 적용된다. 기본값이니 따로 정할 것도 없다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying the same rule as other text looks consistent. A single rule, \"if it overflows, truncate the tail,\" applies cleanly across the whole app. It's the default, so there's nothing extra to decide."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying the same rule as other text looks consistent. A single rule, \"if it overflows, truncate the tail,\" applies cleanly across the whole app. It's the default, so there's nothing extra to decide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのテキストと同じルールを当てはめれば、一貫して見える。「あふれたらtailで切り詰める」という1つのルールが、アプリ全体にすっきりと適用される。デフォルトなので、別に決めることもない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用与其他文字相同的规则，看起来就一致。“溢出就用 tail 截断”这一条规则干净地铺满整个应用。它是默认值，也无需另行决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式與其他文字相同的規則，看起來就一致。「溢位就用 tail 截斷」這一條規則乾淨地鋪滿整個應用程式。它是預設值，也無需另行決定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применение того же правила, что к остальному тексту, выглядит последовательно. Единственное правило «если переполняется, обрезай хвост» аккуратно применяется во всём приложении. Это значение по умолчанию, так что ничего дополнительно решать не нужно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar la misma regla que a los demás textos parece coherente. Una sola regla, «si desborda, trunca el final», se aplica limpiamente a toda la app. Es el valor por defecto, así que no hay nada extra que decidir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselbe Regel wie bei anderem Text anzuwenden wirkt konsistent. Eine einzige Regel, „läuft es über, schneide das Ende ab“, gilt sauber in der ganzen App. Es ist der Standard, also gibt es nichts Zusätzliches zu entscheiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer la même règle que pour les autres textes paraît cohérent. Une seule règle, « si ça déborde, tronquez la fin », s'applique proprement dans toute l'app. C'est le réglage par défaut, donc il n'y a rien de plus à décider."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicare la stessa regola degli altri testi sembra coerente. Un'unica regola, «se trabocca, tronca la coda», si applica in modo pulito a tutta l'app. È il predefinito, quindi non c'è nulla in più da decidere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar a mesma regra dos outros textos parece consistente. Uma única regra, «se transborda, trunque o fim», se aplica com limpeza ao app inteiro. É o padrão, então não há nada extra a decidir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้กฎเดียวกับข้อความอื่นดูสอดคล้อง กฎเดียว \"ถ้าล้น ให้ตัดท้าย\" ใช้ได้เรียบร้อยทั่วทั้งแอป เป็นค่าเริ่มต้น จึงไม่มีอะไรเพิ่มให้ตัดสินใจ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp cùng quy tắc như văn bản khác trông nhất quán. Một quy tắc duy nhất, \"tràn thì cắt đuôi\", áp gọn trên toàn app. Đó là mặc định nên không có gì thêm để quyết định."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použití stejného pravidla jako u jiného textu vypadá konzistentně. Jediné pravidlo „když přetéká, ořízni konec“ se čistě aplikuje v celé aplikaci. Je to výchozí, takže není o čem navíc rozhodovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At anvende samme regel som anden tekst ser ensartet ud. Én regel, »hvis det løber over, afkort enden«, gælder rent i hele appen. Det er standarden, så der er intet ekstra at beslutte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή του ίδιου κανόνα με το άλλο κείμενο φαίνεται συνεπής. Ένας μόνο κανόνας, «αν υπερχειλίζει, περίκοψε το τέλος», εφαρμόζεται καθαρά σε ολόκληρη την εφαρμογή. Είναι η προεπιλογή, οπότε δεν υπάρχει τίποτα επιπλέον να αποφασίσεις."
          }
        }
      }
    },
    "다른 플랫폼과 자리를 맞추기 전에, 이 플랫폼의 시스템 배치가 무엇을 풀려고 바뀌었는지 먼저 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before matching another platform's placement, first look at what problem this platform's system placement changed to solve."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before matching another platform's placement, first look at what problem this platform's system placement changed to solve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのプラットフォームと位置をそろえる前に、このプラットフォームのシステムの配置が何を解決するために変わったのかを先に見る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与其他平台对齐位置之前，先看这个平台的系统布局是为解决什么而改变的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與其他平臺對齊位置之前，先看這個平臺的系統佈局是為解決什麼而改變的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем выравнивать расположение по другой платформе, сначала посмотрите, какую проблему решало изменение системного расположения на этой платформе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de copiar la colocación de otra plataforma, mira primero qué problema cambió a resolver la colocación del sistema de esta plataforma."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du die Platzierung einer anderen Plattform übernimmst, sieh zuerst, welches Problem die Systemplatzierung dieser Plattform lösen sollte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de reproduire le placement d'une autre plateforme, regardez d'abord quel problème le placement système de cette plateforme-ci a changé pour résoudre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di imitare la collocazione di un'altra piattaforma, guarda prima quale problema ha cambiato per risolvere la collocazione di sistema di questa piattaforma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de copiar a colocação de outra plataforma, veja primeiro que problema a colocação de sistema desta plataforma mudou para resolver."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนจะจับคู่ตำแหน่งของแพลตฟอร์มอื่น ให้ดูก่อนว่าการวางของระบบแพลตฟอร์มนี้เปลี่ยนไปเพื่อแก้ปัญหาอะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi khớp vị trí của nền tảng khác, trước hết hãy xem vị trí hệ thống của nền tảng này được đổi để giải quyết vấn đề gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než se přizpůsobíte umístění jiné platformy, nejdřív se podívejte, jaký problém systémové umístění této platformy změnilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du matcher en anden platforms placering, så se først på, hvilket problem denne platforms systemplacering ændrede sig for at løse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν ταιριάξεις την τοποθέτηση μιας άλλης πλατφόρμας, δες πρώτα ποιο πρόβλημα άλλαξε η τοποθέτηση συστήματος αυτής της πλατφόρμας για να λύσει."
          }
        }
      }
    },
    "단계마다 레이아웃이 확 바뀜": {
      "extractionState": "manual",
