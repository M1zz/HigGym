    "제목 **아래 서랍**, 스크롤하면 접히는 전통 위치": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**The drawer below** the title, the traditional spot that collapses as you scroll"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**The drawer below** the title, the traditional spot that collapses as you scroll"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの**下の引き出し**。スクロールすると折りたたまれる従来の位置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题**下方的抽屉**，滚动时折叠的传统位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題**下方的抽屜**，滾動時摺疊的傳統位置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Выдвижная часть под** заголовком, традиционное место, сворачивающееся при прокрутке"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**El cajón bajo** el título, el sitio tradicional que se colapsa al desplazar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Die Schublade unter** dem Titel, der traditionelle Platz, der beim Scrollen zusammenklappt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Le tiroir sous** le titre, l'emplacement traditionnel qui se replie au défilement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Il cassetto sotto** il titolo, il posto tradizionale che si comprime con lo scorrimento"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**A gaveta abaixo** do título, o lugar tradicional que recolhe ao rolar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ลิ้นชักใต้**ชื่อเรื่อง ตำแหน่งดั้งเดิมที่ยุบเมื่อเลื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ngăn kéo bên dưới** tiêu đề, vị trí truyền thống thu lại khi cuộn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Zásuvka pod** nadpisem, tradiční místo, které se při posouvání sbaluje"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Skuffen under** titlen, den traditionelle plads, der folder sammen, mens du scroller"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Το συρτάρι κάτω** από τον τίτλο, το παραδοσιακό σημείο που συμπτύσσεται καθώς κυλάς"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Otsikon alapuolella oleva laatikko**, perinteinen paikka, joka tiivistyy vieritettäessä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Laci di bawah** judul, tempat tradisional yang menciut saat digulir"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Skuffen under** tittelen, det tradisjonelle stedet som kollapser når du ruller"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**De lade onder** de titel, de traditionele plek die inklapt als je scrolt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Szuflada pod** tytułem, tradycyjne miejsce, które zwija się przy przewijaniu"
          }
        },
        "sv": {
          "stringUnit": {
