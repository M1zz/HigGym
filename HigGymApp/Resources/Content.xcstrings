        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to nejdůležitější potvrzující akce, takže jí dáte nejlepší místo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er den vigtigste bekræftende handling, så du giver den den bedste plads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι η πιο σημαντική ενέργεια επιβεβαίωσης, οπότε της δίνεις την καλύτερη θέση."
          }
        }
      }
    },
    "가장자리 바를 불투명 단색으로 채운다": {
      "extractionState": "manual",
      "localizations": {
