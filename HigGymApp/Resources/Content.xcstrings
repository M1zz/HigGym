    "펼친 상태만 디자인하고 접힘은 시스템이 알아서 할 거라 생각한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You design only the expanded state and assume the system will take care of the collapsed one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You design only the expanded state and assume the system will take care of the collapsed one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "展開した状態だけをデザインし、折りたたみはシステムがうまくやってくれると思う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只设计展开状态，觉得折叠系统会自己处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只設計展開狀態，覺得摺疊系統會自己處理。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы проектируете только развёрнутое состояние и полагаете, что со свёрнутым справится система."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseñas solo el estado expandido y supones que el sistema se ocupará del colapsado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gestaltest nur den erweiterten Zustand und nimmst an, dass sich das System um den zusammengeklappten kümmert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne concevez que l'état déployé et supposez que le système s'occupera de l'état replié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progetti solo lo stato espanso e presumi che il sistema si occuperà di quello compresso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você projeta só o estado expandido e presume que o sistema cuidará do recolhido."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออกแบบเฉพาะสถานะขยายและสมมติว่าระบบจะจัดการสถานะยุบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chỉ thiết kế trạng thái mở rộng và cho rằng hệ thống sẽ lo trạng thái thu gọn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navrhujete jen rozbalený stav a předpokládáte, že sbalený obstará systém."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du designer kun den udvidede tilstand og antager, at systemet tager sig af den sammenfoldede."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάζεις μόνο την επεκτεταμένη κατάσταση και υποθέτεις ότι το σύστημα θα φροντίσει τη συμπτυγμένη."
          }
        }
      }
    },
    "평소엔 **돋보기 버튼으로 접힘**, 탭하면 검색바로 확장": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normally **collapsed into a magnifying glass button**, expanding into a search bar when tapped"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Normally **collapsed into a magnifying glass button**, expanding into a search bar when tapped"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段は**虫めがねボタンに折りたたまれ**、タップすると検索バーに広がる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平时**折叠成放大镜按钮**，点按后展开成搜索栏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平時**摺疊成放大鏡按鈕**，輕點後展開成搜尋列"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно **свёрнут в кнопку-лупу**, раскрываясь в строку поиска при нажатии"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente **colapsada en un botón de lupa**, expandiéndose en una barra de búsqueda al tocar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalerweise **zu einem Lupen-Button zusammengeklappt**, der sich beim Antippen zu einer Suchleiste erweitert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalement **replié en bouton loupe**, se déployant en barre de recherche au toucher"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente **compressa in un pulsante a lente**, si espande in una barra di ricerca quando viene toccata"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente **recolhida num botão de lupa**, expandindo-se numa barra de busca quando tocada"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปกติ**ยุบเป็นปุ่มแว่นขยาย** ขยายเป็นแถบค้นหาเมื่อแตะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bình thường **thu thành nút kính lúp**, mở rộng thành thanh tìm kiếm khi chạm"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Normálně **sbaleno do tlačítka lupy**, po klepnutí se rozbalí do vyhledávacího pole"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalt **foldet sammen til en forstørrelsesglasknap**, der udvides til en søgebjælke, når der trykkes"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανονικά **συμπτυγμένη σε κουμπί μεγεθυντικού φακού**, που επεκτείνεται σε γραμμή αναζήτησης όταν πατηθεί"
          }
        }
      }
    },
    "폭이 모자라면 시스템은 아이템을 overflow 메뉴로 접는다. 무엇이 접힐지는 **선언 순서와 우선순위**가 정한다. 그러니 순서를 적는 순간 \"무엇을 포기할지\"도 함께 적은 셈이다. 우선순위를 정한 적이 없다고 생각했지만 코드가 이미 정해 버렸다.\n\n게다가 접히는 지점은 기기 폭·글자 크기·언어에 따라 달라진다. 한 기기에서 멀쩡하면 문제를 만나지 못한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When there isn't enough width, the system folds items into the overflow menu. What gets folded is decided by **declaration order and priority**. So the moment you write the order, you're also writing down \"what to give up.\" You thought you never set priorities, but the code already did it for you.\n\nWhat's more, where folding starts depends on device width, text size and language. If it looks fine on one device, you'll never run into the problem."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When there isn't enough width, the system folds items into the overflow menu. What gets folded is decided by **declaration order and priority**. So the moment you write the order, you're also writing down \"what to give up.\" You thought you never set priorities, but the code already did it for you.\n\nWhat's more, where folding starts depends on device width, text size and language. If it looks fine on one device, you'll never run into the problem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅が足りないと、システムはアイテムをoverflowメニューに折りたたむ。何が折りたたまれるかは**宣言の順番と優先順位**が決める。だから順番を書いた瞬間に、「何をあきらめるか」も一緒に書いたことになる。優先順位を決めたことはないと思っていても、コードがすでに決めてしまっている。\n\nしかも、折りたたまれる境目はデバイスの幅・文字サイズ・言語によって変わる。ひとつのデバイスで問題がなければ、この問題に出会うことはない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽度不够时，系统会把项目折叠进 overflow 菜单。什么被折叠，由**声明顺序和优先级**决定。所以写下顺序的那一刻，也就同时写下了“放弃什么”。以为自己没定过优先级，但代码已经替你定了。\n\n而且折叠的位置会随设备宽度、字号、语言而变。在一台设备上没问题，就遇不到问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寬度不夠時，系統會把項目摺疊進 overflow 選單。什麼被摺疊，由**宣告順序和優先順序**決定。所以寫下順序的那一刻，也就同時寫下了「放棄什麼」。以為自己沒定過優先順序，但程式碼已經替你定了。\n\n而且摺疊的位置會隨裝置寬度、字號、語言而變。在一臺裝置上沒問題，就遇不到問題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ширины не хватает, система сворачивает элементы в меню переполнения. Что именно свернётся, решают **порядок объявления и приоритет**. Значит, в тот миг, когда вы пишете порядок, вы записываете и «чем жертвовать». Вам казалось, что вы приоритеты не задавали, но код уже сделал это за вас.\n\nК тому же то, где начинается сворачивание, зависит от ширины устройства, размера текста и языка. Если на одном устройстве всё выглядит нормально, вы никогда не столкнётесь с проблемой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando no hay ancho suficiente, el sistema pliega los elementos en el menú de desbordamiento. Lo que se pliega lo deciden **el orden de declaración y la prioridad**. Así que en el momento en que escribes el orden, también estás anotando «a qué renunciar». Pensabas que nunca fijaste prioridades, pero el código ya lo hizo por ti.\n\nAdemás, dónde empieza el plegado depende del ancho del dispositivo, el tamaño del texto y el idioma. Si en un dispositivo se ve bien, nunca te toparás con el problema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reicht die Breite nicht, faltet das System Elemente ins Überlaufmenü. Was gefaltet wird, entscheiden **Deklarationsreihenfolge und Priorität**. Sobald du die Reihenfolge schreibst, schreibst du also auch auf, „worauf wir verzichten“. Du dachtest, du hättest nie Prioritäten gesetzt, aber der Code hat es schon für dich getan.\n\nZudem hängt es von Gerätebreite, Textgröße und Sprache ab, wo das Falten beginnt. Sieht es auf einem Gerät gut aus, stößt du nie auf das Problem."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la largeur manque, le système replie les éléments dans le menu de débordement. Ce qui est replié est décidé par **l'ordre de déclaration et la priorité**. Donc au moment où vous écrivez l'ordre, vous écrivez aussi « à quoi renoncer ». Vous pensiez n'avoir jamais fixé de priorités, mais le code l'a déjà fait pour vous.\n\nDe plus, l'endroit où le repli commence dépend de la largeur de l'appareil, de la taille du texte et de la langue. Si cela paraît correct sur un appareil, vous ne rencontrerez jamais le problème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la larghezza non basta, il sistema ripiega gli elementi nel menu di overflow. Cosa viene ripiegato lo decidono **ordine di dichiarazione e priorità**. Quindi nel momento in cui scrivi l'ordine, scrivi anche «a che cosa rinunciare». Pensavi di non aver mai fissato priorità, ma il codice l'ha già fatto per te.\n\nIn più, dove inizia il ripiegamento dipende da larghezza del dispositivo, dimensione del testo e lingua. Se su un dispositivo sembra a posto, non incontrerai mai il problema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando não há largura suficiente, o sistema dobra os itens no menu de overflow. O que é dobrado é decidido pela **ordem de declaração e pela prioridade**. Então, no instante em que você escreve a ordem, também está anotando «a que renunciar». Você achava que nunca definiu prioridades, mas o código já fez isso por você.\n\nAlém disso, onde a dobra começa depende da largura do dispositivo, do tamanho do texto e do idioma. Se parece bom num dispositivo, você nunca esbarra no problema."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อความกว้างไม่พอ ระบบพับรายการเข้าเมนูส่วนเกิน อะไรถูกพับถูกตัดสินโดย**ลำดับการประกาศและลำดับความสำคัญ** ดังนั้นทันทีที่เขียนลำดับ คุณก็กำลังเขียน \"สิ่งที่สละ\" ไว้ด้วย คุณคิดว่าไม่เคยตั้งลำดับความสำคัญ แต่โค้ดทำให้คุณแล้ว\n\nยิ่งกว่านั้น จุดที่การพับเริ่มขึ้นกับความกว้างอุปกรณ์ ขนาดตัวอักษร และภาษา ถ้าดูดีบนอุปกรณ์เดียว คุณจะไม่เจอปัญหาเลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi không đủ chiều rộng, hệ thống gập các mục vào menu tràn. Cái gì bị gập do **thứ tự khai báo và mức ưu tiên** quyết định. Nên khoảnh khắc bạn viết thứ tự, bạn cũng đang ghi \"bỏ gì.\" Bạn nghĩ mình chưa bao giờ đặt ưu tiên, nhưng mã đã làm điều đó thay bạn.\n\nHơn nữa, chỗ bắt đầu gập phụ thuộc chiều rộng thiết bị, cỡ chữ và ngôn ngữ. Nếu trông ổn trên một thiết bị, bạn sẽ không bao giờ gặp vấn đề."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když není dost šířky, systém sbalí položky do nabídky přetečení. Co se sbalí, rozhoduje **pořadí deklarace a priorita**. Takže ve chvíli, kdy napíšete pořadí, zapisujete i „čeho se vzdát“. Mysleli jste, že jste nikdy nenastavili priority, ale kód to už udělal za vás.\n\nNavíc to, kde sbalení začíná, závisí na šířce zařízení, velikosti textu a jazyku. Pokud vypadá dobře na jednom zařízení, nikdy na problém nenarazíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når der ikke er bredde nok, folder systemet elementer ind i overløbsmenuen. Hvad der foldes, afgøres af **deklarationsrækkefølge og prioritet**. Så i det øjeblik du skriver rækkefølgen, skriver du også ned, »hvad vi opgiver.« Du troede, du aldrig satte prioriteter, men koden gjorde det allerede for dig.\n\nOg hvor sammenfoldningen begynder, afhænger af enhedens bredde, tekststørrelse og sprog. Hvis det ser fint ud på én enhed, løber du aldrig ind i problemet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν δεν υπάρχει αρκετό πλάτος, το σύστημα διπλώνει στοιχεία στο μενού υπερχείλισης. Το τι διπλώνεται το αποφασίζει **η σειρά δήλωσης και η προτεραιότητα**. Οπότε τη στιγμή που γράφεις τη σειρά, γράφεις και «τι θα θυσιάσεις». Νόμιζες ότι δεν όρισες ποτέ προτεραιότητες, αλλά ο κώδικας το έκανε ήδη για σένα.\n\nΕπιπλέον, το πού αρχίζει η αναδίπλωση εξαρτάται από το πλάτος της συσκευής, το μέγεθος κειμένου και τη γλώσσα. Αν φαίνεται εντάξει σε μία συσκευή, δεν θα συναντήσεις ποτέ το πρόβλημα."
          }
        }
      }
    },
    "폭이 좁은 화면에서는 세로 바를 쓰지 않는다. 자주 쓰는 도구 몇 개는 하단 바로 옮겨 엄지 근처에 두고, 나머지는 메뉴로 접는다. 캔버스는 화면 폭을 다 쓰게 되고 도구는 필요할 때 손 닿는 곳에 있다. 세로 팔레트는 폭이 넉넉한 iPad에서만 남긴다. 좌우 양쪽에 동시에 바를 두는 배치는 어느 기기에서든 다시 따져 본다. 앱의 5.2.1 Leading 예제에서 세로 팔레트가 어울리는 조건을 확인할 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't use vertical bars on narrow screens. Move a few frequently used tools to a bottom bar near the thumb, and collapse the rest into a menu. The canvas gets the full screen width, and the tools are within reach when needed. Keep the vertical palette only on iPad, where there's plenty of width. Reconsider any layout with bars on both the left and right at once, on any device. In the app's 5.2.1 Leading example, you can see the conditions where a vertical palette fits."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't use vertical bars on narrow screens. Move a few frequently used tools to a bottom bar near the thumb, and collapse the rest into a menu. The canvas gets the full screen width, and the tools are within reach when needed. Keep the vertical palette only on iPad, where there's plenty of width. Reconsider any layout with bars on both the left and right at once, on any device. In the app's 5.2.1 Leading example, you can see the conditions where a vertical palette fits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅の狭い画面では縦のバーを使わない。よく使うツールをいくつか下部のバーに移して親指の近くに置き、残りはメニューに折りたたむ。キャンバスは画面の幅をすべて使えるようになり、ツールは必要なときに手の届く場所にある。縦のパレットは幅に余裕のあるiPadでだけ残す。左右両側に同時にバーを置く配置は、どのデバイスであっても改めて検討する。アプリの5.2.1 Leadingの例で、縦のパレットが似合う条件を確かめられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽度窄的界面不用竖向栏。把常用的几个工具移到底部栏，靠近拇指，其余折叠进菜单。画布用满屏幕宽度，工具在需要时触手可及。竖向调色板只留给宽度宽裕的 iPad。左右两侧同时放栏的布局，在任何设备上都要重新斟酌。在应用的 5.2.1 Leading 示例里，可以确认竖向调色板适合的条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寬度窄的介面不用豎向列。把常用的幾個工具移到底部列，靠近拇指，其餘摺疊進選單。畫布用滿螢幕寬度，工具在需要時觸手可及。豎向調色盤只留給寬度寬裕的 iPad。左右兩側同時放列的佈局，在任何裝置上都要重新斟酌。在應用程式的 5.2.1 Leading 示例裡，可以確認豎向調色盤適合的條件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не используйте вертикальные панели на узких экранах. Перенесите несколько частых инструментов на нижнюю панель у большого пальца, а остальные сверните в меню. Холст получает всю ширину экрана, а инструменты под рукой, когда нужны. Вертикальную палитру оставьте только на iPad, где хватает ширины. Пересмотрите любой макет с панелями одновременно слева и справа на любом устройстве. В примере приложения 5.2.1 Leading видны условия, при которых вертикальная палитра подходит."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No uses barras verticales en pantallas estrechas. Pasa unas pocas herramientas de uso frecuente a una barra inferior cerca del pulgar y pliega el resto en un menú. El lienzo recibe todo el ancho de la pantalla, y las herramientas están al alcance cuando hacen falta. Deja la paleta vertical solo en iPad, donde hay ancho de sobra. Reconsidera cualquier diseño con barras a la izquierda y a la derecha a la vez, en cualquier dispositivo. En el ejemplo 5.2.1 Leading de la app puedes ver las condiciones en que encaja una paleta vertical."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze keine vertikalen Leisten auf schmalen Bildschirmen. Verschiebe ein paar häufig genutzte Werkzeuge in eine untere Leiste nahe am Daumen und klappe den Rest in ein Menü. Die Leinwand bekommt die volle Bildschirmbreite, und die Werkzeuge sind bei Bedarf in Reichweite. Behalte die vertikale Palette nur auf dem iPad, wo reichlich Breite vorhanden ist. Überdenke auf jedem Gerät jedes Layout mit Leisten gleichzeitig links und rechts. Im Beispiel 5.2.1 Leading der App siehst du die Bedingungen, unter denen eine vertikale Palette passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'utilisez pas de barres verticales sur les écrans étroits. Déplacez quelques outils fréquents dans une barre du bas près du pouce, et repliez le reste dans un menu. Le canevas reçoit toute la largeur de l'écran, et les outils sont à portée quand il le faut. Ne gardez la palette verticale que sur iPad, où la largeur abonde. Reconsidérez toute disposition avec des barres à la fois à gauche et à droite, sur n'importe quel appareil. Dans l'exemple 5.2.1 Leading de l'app, vous voyez les conditions où une palette verticale convient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non usare barre verticali su schermi stretti. Sposta alcuni strumenti usati spesso in una barra in basso vicino al pollice e comprimi il resto in un menu. La tela ottiene tutta la larghezza dello schermo e gli strumenti sono a portata quando servono. Tieni la tavolozza verticale solo su iPad, dove c'è tanta larghezza. Riconsidera su qualsiasi dispositivo ogni layout con barre sia a sinistra sia a destra insieme. Nell'esempio 5.2.1 Leading dell'app puoi vedere le condizioni in cui una tavolozza verticale si adatta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não use barras verticais em telas estreitas. Mova algumas ferramentas muito usadas para uma barra inferior perto do polegar e recolha o resto num menu. O canvas ganha a largura total da tela e as ferramentas ficam ao alcance quando necessário. Mantenha a paleta vertical só no iPad, onde há bastante largura. Reconsidere, em qualquer dispositivo, qualquer layout com barras à esquerda e à direita ao mesmo tempo. No exemplo 5.2.1 Leading do app, você vê as condições em que uma paleta vertical se encaixa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าใช้แถบแนวตั้งบนหน้าจอแคบ ย้ายเครื่องมือที่ใช้บ่อยไม่กี่อันไปแถบล่างใกล้นิ้วโป้ง และยุบที่เหลือเข้าเมนู แคนวาสได้ความกว้างหน้าจอเต็ม และเครื่องมืออยู่ในระยะเอื้อมเมื่อต้องการ คงจานแนวตั้งไว้เฉพาะ iPad ที่ความกว้างเหลือเฟือ ทบทวนเลย์เอาต์ใด ๆ ที่มีแถบทั้งซ้ายและขวาพร้อมกันบนอุปกรณ์ใดก็ตาม ในตัวอย่าง 5.2.1 Leading ของแอป คุณเห็นเงื่อนไขที่จานแนวตั้งเหมาะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng dùng thanh dọc trên màn hình hẹp. Chuyển vài công cụ dùng thường xuyên xuống thanh dưới gần ngón cái, và thu phần còn lại vào menu. Canvas có trọn chiều rộng màn hình, và công cụ trong tầm với khi cần. Chỉ giữ bảng dọc trên iPad, nơi dư chiều rộng. Hãy xem lại mọi bố cục có thanh ở cả trái lẫn phải cùng lúc, trên bất kỳ thiết bị nào. Trong ví dụ 5.2.1 Leading của app, bạn thấy điều kiện để bảng dọc hợp."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepoužívejte svislé panely na úzkých obrazovkách. Přesuňte několik často používaných nástrojů do spodního panelu u palce a zbytek sbalte do nabídky. Plátno dostane plnou šířku obrazovky a nástroje jsou v dosahu, když jsou potřeba. Svislou paletu ponechte jen na iPadu, kde je dost šířky. Přehodnoťte každé rozvržení s panely vlevo i vpravo najednou, na jakémkoli zařízení. V příkladu 5.2.1 Leading aplikace vidíte podmínky, kdy svislá paleta sedí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug ikke lodrette bjælker på smalle skærme. Flyt nogle få hyppigt brugte værktøjer til en nederste bjælke nær tommelfingeren, og fold resten sammen i en menu. Lærredet får hele skærmbredden, og værktøjerne er inden for rækkevidde, når der er brug for dem. Behold kun den lodrette palet på iPad, hvor der er masser af bredde. Gentænk ethvert layout med bjælker både til venstre og højre på én gang, på enhver enhed. I appens eksempel 5.2.1 Leading kan du se de betingelser, hvor en lodret palet passer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην χρησιμοποιείς κάθετες γραμμές σε στενές οθόνες. Μετάφερε μερικά συχνά χρησιμοποιούμενα εργαλεία σε κάτω γραμμή κοντά στον αντίχειρα, και σύμπτυξε τα υπόλοιπα σε μενού. Ο καμβάς παίρνει ολόκληρο το πλάτος της οθόνης, και τα εργαλεία είναι σε απόσταση αφής όταν χρειάζονται. Κράτα την κάθετη παλέτα μόνο στο iPad, όπου υπάρχει άφθονο πλάτος. Ξανασκέψου κάθε διάταξη με γραμμές ταυτόχρονα αριστερά και δεξιά, σε οποιαδήποτε συσκευή. Στο παράδειγμα 5.2.1 Leading της εφαρμογής, μπορείς να δεις τις συνθήκες όπου ταιριάζει μια κάθετη παλέτα."
          }
        }
      }
    },
    "폴더 제목 탭 → 이름 변경·복제·태그": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the folder title → Rename, Duplicate, Tags"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the folder title → Rename, Duplicate, Tags"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダのタイトルをタップ → 名称変更・複製・タグ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按文件夹标题 → 重命名 · 复制 · 标签"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點資料夾標題 → 重新命名 · 複製 · 標籤"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажать на заголовок папки → «Переименовать», «Дублировать», «Теги»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el título de la carpeta → Renombrar, Duplicar, Etiquetas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnertitel antippen → Umbenennen, Duplizieren, Tags"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le titre du dossier → Renommer, Dupliquer, Tags"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il titolo della cartella → Rinomina, Duplica, Etichette"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no título da pasta → Renomear, Duplicar, Etiquetas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะชื่อโฟลเดอร์ → เปลี่ยนชื่อ ทำซ้ำ แท็ก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm tiêu đề thư mục → Đổi tên, Nhân đôi, Thẻ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutí na nadpis složky → Přejmenovat, Duplikovat, Štítky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på mappetitlen → Omdøb, Duplikér, Tags"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτημα στον τίτλο φακέλου → Μετονομασία, Διπλασιασμός, Ετικέτες"
          }
        }
      }
    },
    "폴더 화면의 제목이 평범한 글자처럼 보인다. 사실은 탭하면 폴더를 전환하는 메뉴가 열린다. 그런데 그렇다는 표시가 어디에도 없다. 폴더를 바꾸려는 사람은 제목을 읽기만 하고 지나가, 툴바에서 그런 버튼을 찾는다. 기능은 있지만 화면은 그 기능이 없다고 말하고 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title on a folder screen looks like plain text. In fact, tapping it opens a menu for switching folders. But nothing on screen says so. People who want to switch folders just read the title and move on, looking for such a button in the toolbar. The feature exists, but the screen is telling people it doesn't."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The title on a folder screen looks like plain text. In fact, tapping it opens a menu for switching folders. But nothing on screen says so. People who want to switch folders just read the title and move on, looking for such a button in the toolbar. The feature exists, but the screen is telling people it doesn't."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ画面のタイトルが、普通の文字のように見える。実はタップするとフォルダを切り替えるメニューが開く。なのに、そうだと示すものがどこにもない。フォルダを変えたい人はタイトルを読むだけで通り過ぎ、ツールバーでそういうボタンを探す。機能はあるのに、画面はその機能がないと言っている。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹界面的标题看起来像普通文字。其实点按会打开切换文件夹的菜单。可是哪里都没有标记表明这一点。想换文件夹的人只是读了标题就走过，去工具栏里找那样的按钮。功能是有的，界面却在说没有这个功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料夾介面的標題看起來像普通文字。其實輕點會開啟切換資料夾的選單。可是哪裡都沒有標記表明這一點。想換資料夾的人只是讀了標題就走過，去工具列裡找那樣的按鈕。功能是有的，介面卻在說沒有這個功能。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок на экране папки выглядит простым текстом. На деле нажатие открывает меню переключения папок. Но на экране об этом ничего не сказано. Люди, желающие сменить папку, просто читают заголовок и идут дальше, ища такую кнопку на панели инструментов. Функция есть, а экран говорит людям, что её нет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título de una pantalla de carpeta parece texto simple. En realidad, al tocarlo se abre un menú para cambiar de carpeta. Pero nada en pantalla lo dice. Quienes quieren cambiar de carpeta simplemente leen el título y siguen, buscando ese botón en la barra de herramientas. La función existe, pero la pantalla dice a la gente que no."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel auf einem Ordnerbildschirm sieht wie schlichter Text aus. Tatsächlich öffnet Antippen ein Menü zum Wechseln der Ordner. Aber nichts auf dem Bildschirm sagt das. Wer Ordner wechseln will, liest nur den Titel und geht weiter, um in der Symbolleiste nach einem solchen Button zu suchen. Die Funktion existiert, aber der Bildschirm sagt den Leuten, dass es sie nicht gibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre d'un écran de dossier ressemble à du texte simple. En fait, le toucher ouvre un menu pour changer de dossier. Mais rien à l'écran ne le dit. Les gens qui veulent changer de dossier lisent simplement le titre et passent à autre chose, cherchant un tel bouton dans la barre d'outils. La fonction existe, mais l'écran dit aux gens qu'elle n'existe pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo in una schermata di cartella sembra testo semplice. In realtà, toccandolo si apre un menu per cambiare cartella. Ma nulla sullo schermo lo dice. Chi vuole cambiare cartella legge il titolo e va oltre, cercando un pulsante simile nella barra degli strumenti. La funzione c'è, ma la schermata dice alle persone che non c'è."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título numa tela de pasta parece texto simples. Na verdade, tocar nele abre um menu para trocar de pasta. Mas nada na tela diz isso. Quem quer trocar de pasta lê o título e segue adiante, procurando um botão assim na barra de ferramentas. A funcionalidade existe, mas a tela está dizendo às pessoas que não."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องบนหน้าจอโฟลเดอร์ดูเหมือนข้อความธรรมดา ที่จริงการแตะเปิดเมนูสลับโฟลเดอร์ แต่ไม่มีอะไรบนหน้าจอบอก คนที่อยากสลับโฟลเดอร์อ่านชื่อเรื่องแล้วผ่านไป มองหาปุ่มแบบนั้นในแถบเครื่องมือ ฟีเจอร์มีอยู่ แต่หน้าจอบอกคนว่าไม่มี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề trên màn hình thư mục trông như chữ thường. Thực ra chạm vào mở menu chuyển thư mục. Nhưng không gì trên màn hình nói vậy. Người muốn chuyển thư mục chỉ đọc tiêu đề rồi đi tiếp, tìm nút đó trong thanh công cụ. Tính năng có đó, nhưng màn hình lại bảo người ta rằng không có."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadpis na obrazovce složky vypadá jako prostý text. Ve skutečnosti klepnutí na něj otevře nabídku pro přepínání složek. Ale nic na obrazovce to neříká. Lidé, kteří chtějí přepnout složky, nadpis jen přečtou a jdou dál a takové tlačítko hledají v panelu nástrojů. Funkce existuje, ale obrazovka lidem říká, že ne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlen på en mappeskærm ligner almindelig tekst. Faktisk åbner et tryk på den en menu til at skifte mappe. Men intet på skærmen siger det. Folk, der vil skifte mappe, læser bare titlen og går videre, mens de leder efter sådan en knap i værktøjslinjen. Funktionen findes, men skærmen fortæller folk, at den ikke gør."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο τίτλος σε μια οθόνη φακέλου μοιάζει με απλό κείμενο. Στην πραγματικότητα, το πάτημά του ανοίγει ένα μενού για εναλλαγή φακέλων. Αλλά τίποτα στην οθόνη δεν το λέει. Όσοι θέλουν να αλλάξουν φάκελο διαβάζουν τον τίτλο και προχωρούν, ψάχνοντας ένα τέτοιο κουμπί στη γραμμή εργαλείων. Η λειτουργία υπάρχει, αλλά η οθόνη λέει στους ανθρώπους ότι δεν υπάρχει."
          }
        }
      }
    },
    "표·그리드처럼 구획이 중요한 화면에 soft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft on screens where sections matter, like tables and grids"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft on screens where sections matter, like tables and grids"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表やグリッドのように区切りが重要な画面にsoft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表格、网格这类分区重要的界面里用 soft"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在表格、網格這類分割槽重要的介面裡用 soft"
