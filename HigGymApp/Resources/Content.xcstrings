    "6개가 필요해 보이면 대개 둘은 같은 개념입니다, 통합을 먼저, 추가는 마지막에.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you seem to need six, two of them are usually the same concept. Merge first, add last."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you seem to need six, two of them are usually the same concept. Merge first, add last."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6個必要に見えるときは、たいてい2つは同じ概念です。まず統合し、追加は最後に。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看起来需要 6 个时，通常其中两个是同一个概念：先合并，最后才新增。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看起來需要 6 個時，通常其中兩個是同一個概念：先合併，最後才新增。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если кажется, что нужно шесть, то два из них обычно одно и то же понятие. Сначала объединяйте, добавляйте в последнюю очередь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si parece que necesitas seis, dos de ellos suelen ser el mismo concepto. Fusiona primero, añade al final."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du sechs zu brauchen scheinst, sind zwei davon meist dasselbe Konzept. Erst zusammenführen, zuletzt hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous semblez en avoir besoin de six, deux d'entre eux sont généralement le même concept. Fusionnez d'abord, ajoutez en dernier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ti sembra di averne bisogno di sei, due di solito sono lo stesso concetto. Prima unisci, aggiungi per ultimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se parece que você precisa de seis, duas delas costumam ser o mesmo conceito. Una primeiro, adicione por último."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าดูเหมือนต้องมีหก สองอันมักเป็นแนวคิดเดียวกัน รวมก่อน เพิ่มทีหลังสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu có vẻ cần sáu, thường hai trong số đó là cùng một khái niệm. Gộp trước, thêm sau cùng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se zdá, že potřebujete šest, dva z nich jsou obvykle stejný koncept. Nejdřív sloučit, přidat až naposled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du synes at have brug for seks, er to af dem som regel det samme begreb. Slå sammen først, tilføj til sidst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν φαίνεται να χρειάζεσαι έξι, δύο από αυτά είναι συνήθως η ίδια έννοια. Συγχώνευσε πρώτα, πρόσθεσε τελευταία."
          }
        }
      }
    },
    "Apple이 방향을 일부 수정했습니다, iOS 27 베타에선 뮤직·팟캐스트 등 **자체 앱들의 스크롤 축소 동작을 제거**하고 탭바를 항상 노출하는 쪽으로 회귀 중(\"복원에 탭 한 번을 더 쓰게 하는 건 우아한 애니메이션보다 나쁘다\"는 피드백 반영). API 자체는 유지되지만, 새로 만드는 앱이라면 minimize 채택을 더 보수적으로 판단하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple has partly changed course. In the iOS 27 betas, it is **removing the scroll-to-minimize behavior from its own apps** like Music and Podcasts and moving back to an always-visible tab bar (reflecting feedback that \"making people spend an extra tap to bring it back is worse than a graceful animation\"). The API itself remains, but if you're building a new app, be more conservative about adopting minimize."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple has partly changed course. In the iOS 27 betas, it is **removing the scroll-to-minimise behaviour from its own apps** like Music and Podcasts and moving back to an always-visible tab bar (reflecting feedback that \"making people spend an extra tap to bring it back is worse than a graceful animation\"). The API itself remains, but if you're building a new app, be more conservative about adopting minimise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleは方向を一部修正しました。iOS 27ベータでは、ミュージックやPodcastなど**自社アプリのスクロール縮小の動作を取り除き**、タブバーを常に表示する方向に戻しつつあります（「元に戻すためにもう1回タップさせるのは、優雅なアニメーションより悪い」というフィードバックを反映）。API自体は残りますが、新しく作るアプリならminimizeの採用はより慎重に判断してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 对方向做了部分修正：在 iOS 27 测试版中，“音乐”“播客”等**自家应用去掉了滚动缩小行为**，转而回到始终显示标签栏（采纳了“为了恢复多点一次比优雅的动画更糟”的反馈）。API 本身保留，但如果是新做的应用，请更保守地判断是否采用 minimize。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 對方向做了部分修正：在 iOS 27 測試版中，「音樂」「播客」等**自家應用程式去掉了滾動縮小行為**，轉而回到始終顯示標籤列（採納了「為了恢復多點一次比優雅的動畫更糟」的反饋）。API 本身保留，但如果是新做的應用程式，請更保守地判斷是否採用 minimize。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple частично изменила курс. В бета-версиях iOS 27 она **убирает поведение сворачивания при прокрутке из собственных приложений** вроде «Музыки» и «Подкастов» и возвращается к всегда видимой панели вкладок (учтён отзыв, что «заставлять людей тратить лишнее нажатие на возврат хуже изящной анимации»). Сам API остаётся, но если вы делаете новое приложение, отнеситесь к minimize осторожнее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ha cambiado parcialmente de rumbo. En las betas de iOS 27, está **quitando el comportamiento de minimizar al desplazar de sus propias apps** como Música y Podcasts y volviendo a una barra de pestañas siempre visible (reflejando la opinión de que «obligar a gastar un toque extra para recuperarla es peor que una animación elegante»). La API sigue ahí, pero si estás creando una app nueva, sé más conservador al adoptar minimize."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat teilweise den Kurs geändert. In den iOS-27-Betas **entfernt es das Zusammenklappen beim Scrollen aus eigenen Apps** wie Musik und Podcasts und kehrt zu einer immer sichtbaren Tab-Leiste zurück (als Reaktion auf die Rückmeldung, dass „Menschen einen zusätzlichen Tipp zum Zurückholen aufwenden zu lassen schlimmer ist als eine elegante Animation“). Die API selbst bleibt, aber wenn du eine neue App baust, sei bei der Einführung von minimize zurückhaltender."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple a en partie changé de cap. Dans les bêtas d'iOS 27, elle **retire la réduction au défilement de ses propres apps** comme Musique et Podcasts et revient à une barre d'onglets toujours visible (en réponse au retour selon lequel « faire dépenser un toucher de plus pour la ramener est pire qu'une animation élégante »). L'API elle-même reste, mais si vous créez une nouvelle app, soyez plus prudent quant à l'adoption de minimize."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ha in parte cambiato rotta. Nelle beta di iOS 27 sta **togliendo il comportamento di riduzione allo scorrimento dalle sue stesse app** come Musica e Podcast e tornando a una barra delle schede sempre visibile (riflettendo il feedback che «far spendere un tocco in più per riportarla è peggio di un'animazione elegante»). L'API resta, ma se stai costruendo una nuova app, sii più prudente nell'adottare minimize."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple mudou parcialmente de rumo. Nos betas do iOS 27, ela está **removendo o comportamento de minimizar ao rolar dos seus próprios apps**, como Música e Podcasts, e voltando a uma barra de abas sempre visível (refletindo o feedback de que «fazer as pessoas gastarem um toque extra para trazê-la de volta é pior que uma animação elegante»). A API em si permanece, mas, se você está criando um app novo, seja mais conservador ao adotar minimize."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple เปลี่ยนแนวทางไปบางส่วน ใน iOS 27 เบตา มัน**เอาพฤติกรรมเลื่อนเพื่อย่อออกจากแอปของตัวเอง** เช่น Music และ Podcasts และกลับไปใช้แถบแท็บที่มองเห็นตลอด (สะท้อนความเห็นที่ว่า \"การให้คนเสียอีกหนึ่งการแตะเพื่อเรียกกลับมาแย่กว่าแอนิเมชันที่สง่างาม\") ตัว API ยังอยู่ แต่ถ้าคุณสร้างแอปใหม่ ให้ระมัดระวังมากขึ้นในการนำ minimize มาใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple đã đổi hướng một phần. Trong các bản beta iOS 27, họ **gỡ hành vi thu nhỏ khi cuộn khỏi các app của chính mình** như Nhạc và Podcast và quay lại thanh tab luôn hiển thị (phản ánh ý kiến rằng \"bắt người ta tốn thêm một lần chạm để gọi nó lại còn tệ hơn một hoạt ảnh duyên dáng\"). Bản thân API vẫn còn, nhưng nếu bạn xây một app mới, hãy thận trọng hơn khi áp dụng minimize."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple částečně změnil kurz. V betách iOS 27 **odstraňuje chování minimalizace při posouvání ze svých vlastních aplikací** jako Hudba a Podcasty a vrací se k vždy viditelnému panelu karet (což odráží zpětnou vazbu, že „nutit lidi k dalšímu klepnutí, aby ho vrátili, je horší než půvabná animace“). Samotné API zůstává, ale pokud stavíte novou aplikaci, buďte při zavádění minimalizace konzervativnější."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple har delvist ændret kurs. I iOS 27-betaerne **fjerner de scroll-for-at-minimere-adfærden fra deres egne apps** som Musik og Podcasts og går tilbage til en altid synlig fanelinje (som afspejler feedback om, at »at lade folk bruge et ekstra tryk på at få den tilbage er værre end en elegant animation«). Selve API'et består, men hvis du bygger en ny app, så vær mere konservativ med at tage minimering i brug."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Apple άλλαξε εν μέρει πορεία. Στις betas του iOS 27, **αφαιρεί τη συμπεριφορά ελαχιστοποίησης στην κύλιση από τις δικές της εφαρμογές** όπως Μουσική και Podcasts και επιστρέφει σε πάντα ορατή γραμμή καρτελών (αντανακλώντας τα σχόλια ότι «το να κάνεις τους ανθρώπους να ξοδεύουν ένα επιπλέον πάτημα για να την επαναφέρουν είναι χειρότερο από μια κομψή κίνηση»). Το ίδιο το API παραμένει, αλλά αν φτιάχνεις νέα εφαρμογή, να είσαι πιο συντηρητικός στην υιοθέτηση της ελαχιστοποίησης."
          }
        }
      }
    },
    "Dynamic Type 최대에서 한 번 열어본다. 두 장치를 겹치면 남는 건 첫 어절뿐이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it once at the largest Dynamic Type size. Stack the two safeguards and all that survives is the first word."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it once at the largest Dynamic Type size. Stack the two safeguards and all that survives is the first word."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Typeを最大にして一度開いてみる。2つの仕組みを重ねると、残るのは最初の一語だけだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dynamic Type 最大时打开看一次。两种机制叠在一起，剩下的只有第一个词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dynamic Type 最大時開啟看一次。兩種機制疊在一起，剩下的只有第一個詞。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте один раз при максимальном размере Dynamic Type. Если наложить две страховки, остаётся только первое слово."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ábrelo una vez con el mayor tamaño de Dynamic Type. Apila las dos salvaguardas y lo único que sobrevive es la primera palabra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne es einmal mit der größten Dynamic-Type-Größe. Stapelt man die zwei Absicherungen, bleibt nur das erste Wort übrig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez-le une fois à la plus grande taille Dynamic Type. Empilez les deux protections et il ne reste que le premier mot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprila una volta alla massima dimensione di Dynamic Type. Sovrapponi le due salvaguardie e ciò che sopravvive è solo la prima parola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma vez no maior tamanho de Dynamic Type. Empilhe as duas salvaguardas e o que sobrevive é só a primeira palavra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดดูสักครั้งที่ขนาด Dynamic Type ใหญ่สุด ซ้อนสองตัวป้องกัน แล้วสิ่งที่เหลืออยู่คือคำแรก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở nó một lần ở cỡ Dynamic Type lớn nhất. Chồng hai lớp bảo vệ và thứ còn sống sót chỉ là từ đầu tiên."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete to jednou při největší velikosti Dynamic Type. Naskládejte obě pojistky a přežije jen první slovo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn den én gang ved den største Dynamic Type-størrelse. Stabl de to sikkerhedsforanstaltninger, og det eneste, der overlever, er det første ord."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξέ το μία φορά στο μεγαλύτερο μέγεθος Dynamic Type. Στοίβαξε τα δύο μέτρα ασφαλείας και το μόνο που επιβιώνει είναι η πρώτη λέξη."
          }
        }
      }
    },
    "Dynamic Type 큰 글씨 설정에서는 같은 문장도 더 많은 줄을 차지합니다. lineLimit을 정할 땐 접근성 글자 크기에서 핵심 정보가 살아남는지 확인하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With large Dynamic Type settings, the same sentence takes up more lines. When choosing a lineLimit, check that the key information survives at accessibility text sizes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With large Dynamic Type settings, the same sentence takes up more lines. When choosing a lineLimit, check that the key information survives at accessibility text sizes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Type（文字サイズ）を大きくした設定では、同じ文でもより多くの行を占めます。lineLimitを決めるときは、アクセシビリティの文字サイズでも重要な情報が残るか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dynamic Type 大字号设置下，同一句话会占更多行。确定 lineLimit 时，要确认在无障碍字号下核心信息还留得住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dynamic Type 大字號設定下，同一句話會佔更多行。確定 lineLimit 時，要確認在無障礙字號下核心資訊還留得住。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При крупных настройках Dynamic Type то же предложение занимает больше строк. Выбирая lineLimit, проверьте, что ключевая информация выживает при размерах текста универсального доступа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con ajustes grandes de Dynamic Type, la misma frase ocupa más líneas. Al elegir un lineLimit, comprueba que la información clave sobrevive con tamaños de texto de accesibilidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei großen Dynamic-Type-Einstellungen belegt derselbe Satz mehr Zeilen. Prüfe bei der Wahl eines lineLimit, dass die Kerninformation bei Textgrößen der Bedienungshilfen erhalten bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec de grands réglages Dynamic Type, la même phrase occupe plus de lignes. En choisissant un lineLimit, vérifiez que l'information clé survit aux tailles de texte d'accessibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Dynamic Type grande, la stessa frase occupa più righe. Quando scegli un lineLimit, verifica che l'informazione chiave sopravviva alle dimensioni di testo di accessibilità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com Dynamic Type grande, a mesma frase ocupa mais linhas. Ao escolher um lineLimit, confira se a informação-chave sobrevive nos tamanhos de texto de acessibilidade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อตั้ง Dynamic Type ใหญ่ ประโยคเดียวกันกินหลายบรรทัดขึ้น เมื่อเลือก lineLimit ให้ตรวจว่าข้อมูลสำคัญรอดที่ขนาดตัวอักษรสำหรับการช่วยการเข้าถึง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với cài đặt Dynamic Type lớn, cùng một câu chiếm nhiều dòng hơn. Khi chọn lineLimit, hãy kiểm tra thông tin chính còn sống sót ở cỡ chữ trợ năng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při velkých nastaveních Dynamic Type zabírá stejná věta víc řádků. Při volbě lineLimit ověřte, že klíčová informace přežije i ve velikostech textu přístupnosti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med store Dynamic Type-indstillinger fylder den samme sætning flere linjer. Når du vælger en lineLimit, så tjek, at nøgleinformationen overlever ved tekststørrelser til tilgængelighed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με μεγάλες ρυθμίσεις Dynamic Type, η ίδια πρόταση πιάνει περισσότερες γραμμές. Όταν διαλέγεις ένα lineLimit, έλεγξε ότι η βασική πληροφορία επιβιώνει σε μεγέθη κειμένου προσβασιμότητας."
          }
        }
      }
    },
    "Inline Large는 제목과 버튼의 상대 위치가 고정돼야 하는 화면, 예를 들어 스크롤 출렁임 없이 존재감이 필요한 대시보드 홈에만 쓴다. 나머지 루트는 Large, 상세는 Inline으로 돌린다. 읽는 화면에서는 제목이 다시 물러나고, 깊이는 다시 크기로 전해진다. 1.2.2 Inline Large 예제를 열어 1.2.1 Large와 번갈아 스크롤해 보라. 새 모드라 가이드가 얇으니 실기기에서 비교해 보고 정하는 편이 안전하다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Inline Large only on screens where the title and buttons must keep fixed positions relative to each other, such as a dashboard home that needs presence without the bounce of scrolling. Set the other root screens back to Large and the detail screens to Inline. On reading screens the title steps back again, and depth is once more conveyed by size. Open the 1.2.2 Inline Large example and scroll it alternately with 1.2.1 Large. Since it's a new mode with thin guidance, it's safer to compare on a real device before deciding."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Inline Large only on screens where the title and buttons must keep fixed positions relative to each other, such as a dashboard home that needs presence without the bounce of scrolling. Set the other root screens back to Large and the detail screens to Inline. On reading screens the title steps back again, and depth is once more conveyed by size. Open the 1.2.2 Inline Large example and scroll it alternately with 1.2.1 Large. Since it's a new mode with thin guidance, it's safer to compare on a real device before deciding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Large は、タイトルとボタンの相対位置を固定する必要がある画面、たとえばスクロールの揺れなしに存在感が要るダッシュボードのホームにだけ使う。それ以外のルートは Large に、詳細は Inline に戻す。読む画面ではタイトルが再び引き、深さは再びサイズで伝わる。1.2.2 Inline Large の例を開き、1.2.1 Large と交互にスクロールしてみよう。新しいモードでガイドがまだ手薄なので、実機で比べてから決めるほうが安全だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Large 只用在标题与按钮的相对位置需要固定的界面，比如需要存在感、又不能随滚动晃动的仪表盘首页。其余的根界面用 Large，详情用 Inline。读的界面里标题会再次退后，深度又靠大小来传达。打开 1.2.2 Inline Large 示例，与 1.2.1 Large 交替滚动对比看看。它是新模式，指南还很薄，最好在真机上比较之后再定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Large 只用在標題與按鈕的相對位置需要固定的介面，比如需要存在感、又不能隨滾動晃動的儀表盤首頁。其餘的根介面用 Large，詳情用 Inline。讀的介面裡標題會再次退後，深度又靠大小來傳達。開啟 1.2.2 Inline Large 示例，與 1.2.1 Large 交替滾動對比看看。它是新模式，指南還很薄，最好在真機上比較之後再定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Large используйте только на экранах, где заголовок и кнопки должны сохранять фиксированное взаимное положение, например на домашнем экране панели показателей, которому нужна заметность без прыжков при прокрутке. Остальные корневые экраны верните на Large, а экраны подробностей на Inline. На экранах чтения заголовок снова отступает, а глубина опять передаётся размером. Откройте пример 1.2.2 Inline Large и прокручивайте его поочерёдно с 1.2.1 Large. Это новый режим с небогатыми рекомендациями, поэтому безопаснее сравнить на настоящем устройстве, прежде чем решать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Inline Large solo en pantallas donde el título y los botones deben mantener posiciones fijas entre sí, como una pantalla de inicio de panel que necesita presencia sin el rebote del desplazamiento. Vuelve a poner el resto de pantallas raíz en Large y las de detalle en Inline. En las pantallas de lectura el título vuelve a retroceder, y la profundidad vuelve a transmitirse con el tamaño. Abre el ejemplo 1.2.2 Inline Large y desplázalo alternando con 1.2.1 Large. Como es un modo nuevo con poca orientación, es más seguro compararlo en un dispositivo real antes de decidir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Inline Large nur auf Bildschirmen, auf denen Titel und Buttons feste Positionen zueinander behalten müssen, etwa auf einem Dashboard-Start, der Präsenz ohne das Wippen des Scrollens braucht. Stelle die anderen Wurzelbildschirme wieder auf Large und die Detailbildschirme auf Inline. Auf Leseschirmen tritt der Titel wieder zurück, und die Tiefe wird wieder durch die Größe vermittelt. Öffne das Beispiel 1.2.2 Inline Large und scrolle es abwechselnd mit 1.2.1 Large. Da es ein neuer Modus mit dünner Anleitung ist, ist es sicherer, vor der Entscheidung auf einem echten Gerät zu vergleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'utilisez Inline Large que sur les écrans où le titre et les boutons doivent garder des positions fixes l'un par rapport à l'autre, comme un accueil de tableau de bord qui a besoin de présence sans le rebond du défilement. Remettez les autres écrans racines en Large et les écrans de détail en Inline. Sur les écrans de lecture, le titre s'efface à nouveau, et la profondeur est de nouveau transmise par la taille. Ouvrez l'exemple 1.2.2 Inline Large et faites-le défiler en alternance avec 1.2.1 Large. Comme c'est un nouveau mode aux indications minces, il est plus sûr de comparer sur un vrai appareil avant de décider."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Inline Large solo nelle schermate in cui titolo e pulsanti devono mantenere posizioni fisse l'uno rispetto all'altro, come una home di dashboard che ha bisogno di presenza senza il rimbalzo dello scorrimento. Rimetti le altre schermate radice su Large e quelle di dettaglio su Inline. Nelle schermate di lettura il titolo si fa di nuovo da parte e la profondità è di nuovo comunicata dalla dimensione. Apri l'esempio 1.2.2 Inline Large e scorri alternandolo con 1.2.1 Large. Essendo una modalità nuova con indicazioni scarse, è più sicuro confrontare su un dispositivo reale prima di decidere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Inline Large só em telas em que o título e os botões precisam manter posições fixas um em relação ao outro, como uma home de dashboard que precisa de presença sem o balanço da rolagem. Volte as outras telas raiz para Large e as telas de detalhe para Inline. Nas telas de leitura o título recua de novo, e a profundidade volta a ser transmitida pelo tamanho. Abra o exemplo 1.2.2 Inline Large e role alternando com 1.2.1 Large. Por ser um modo novo com orientação escassa, é mais seguro comparar num dispositivo real antes de decidir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ Inline Large เฉพาะหน้าจอที่ชื่อเรื่องและปุ่มต้องคงตำแหน่งสัมพัทธ์กัน เช่นหน้าแรกแดชบอร์ดที่ต้องมีตัวตนโดยไม่มีการเด้งจากการเลื่อน ตั้งหน้าจอรากอื่นกลับเป็น Large และหน้ารายละเอียดเป็น Inline บนหน้าจออ่าน ชื่อเรื่องถอยอีกครั้ง และความลึกถูกสื่อด้วยขนาดอีกครั้ง เปิดตัวอย่าง 1.2.2 Inline Large แล้วเลื่อนสลับกับ 1.2.1 Large เนื่องจากเป็นโหมดใหม่ที่คำแนะนำยังน้อย การเปรียบเทียบบนอุปกรณ์จริงก่อนตัดสินใจจึงปลอดภัยกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng Inline Large trên các màn hình mà tiêu đề và nút phải giữ vị trí cố định tương đối với nhau, như màn hình chủ dạng dashboard cần sự hiện diện mà không có độ nảy của cuộn. Đặt các màn hình gốc khác về Large và các màn hình chi tiết về Inline. Trên các màn hình đọc, tiêu đề lại lùi lại, và chiều sâu lại được truyền đạt bằng kích thước. Mở ví dụ 1.2.2 Inline Large và cuộn xen kẽ với 1.2.1 Large. Vì đây là chế độ mới với hướng dẫn còn ít, an toàn hơn là so sánh trên thiết bị thật trước khi quyết định."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Inline Large používejte jen na obrazovkách, kde nadpis a tlačítka musejí držet pevné vzájemné pozice, jako úvodní obrazovka dashboardu, která potřebuje přítomnost bez poskakování při posouvání. Ostatní kořenové obrazovky nastavte zpět na Large a detailní na Inline. Na čtecích obrazovkách nadpis opět ustupuje a hloubka je znovu vyjádřena velikostí. Otevřete příklad 1.2.2 Inline Large a posouvejte ho střídavě s 1.2.1 Large. Protože jde o nový režim s řídkým návodem, je bezpečnější porovnat na skutečném zařízení, než se rozhodnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug Inline Large kun på skærme, hvor titlen og knapperne skal bevare faste positioner i forhold til hinanden, som en dashboard-hjemmeskærm, der skal have tilstedeværelse uden scrollens spring. Sæt de andre rodskærme tilbage til Large og detaljeskærmene til Inline. På læseskærme træder titlen igen tilbage, og dybde formidles igen af størrelsen. Åbn eksempel 1.2.2 Inline Large og scroll det vekslende med 1.2.1 Large. Da det er en ny tilstand med sparsom vejledning, er det sikrere at sammenligne på en rigtig enhed, før du beslutter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε το Inline Large μόνο σε οθόνες όπου ο τίτλος και τα κουμπιά πρέπει να διατηρούν σταθερές θέσεις μεταξύ τους, όπως μια αρχική οθόνη dashboard που χρειάζεται παρουσία χωρίς το αναπήδημα της κύλισης. Θέσε τις υπόλοιπες αρχικές οθόνες ξανά σε Large και τις οθόνες λεπτομερειών σε Inline. Στις οθόνες ανάγνωσης ο τίτλος υποχωρεί ξανά και το βάθος μεταφέρεται πάλι με το μέγεθος. Άνοιξε το παράδειγμα 1.2.2 Inline Large και κύλισέ το εναλλάξ με το 1.2.1 Large. Εφόσον είναι νέα λειτουργία με λιγοστές οδηγίες, είναι ασφαλέστερο να συγκρίνεις σε πραγματική συσκευή πριν αποφασίσεις."
          }
        }
      }
    },
    "Large 루트에서 push된 화면이 Inline이면, 크기 변화 자체가 \"한 단계 들어왔다\"는 내비게이션 신호가 됩니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a screen pushed from a Large root uses Inline, the change in size itself becomes a navigation signal: \"you've gone one level deeper.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a screen pushed from a Large root uses Inline, the change in size itself becomes a navigation signal: \"you've gone one level deeper.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeのルートからpushされた画面がInlineなら、大きさの変化そのものが「一段階入った」というナビゲーションのサインになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Large 根界面 push 进来的界面如果是 Inline，大小变化本身就成了“进了一层”的导航信号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Large 根介面 push 進來的介面如果是 Inline，大小變化本身就成了「進了一層」的導覽訊號。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если экран, открытый через push из корня с Large, использует Inline, само изменение размера становится навигационным сигналом: «вы зашли на уровень глубже»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una pantalla abierta desde una raíz Large usa Inline, el cambio de tamaño en sí se convierte en una señal de navegación: «has entrado un nivel más»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt ein von einer Large-Wurzel per Push geöffneter Bildschirm Inline, wird die Größenänderung selbst zum Navigationssignal: „Du bist eine Ebene tiefer gegangen.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un écran ouvert par push depuis une racine Large utilise Inline, le changement de taille devient lui-même un signal de navigation : « vous êtes descendu d'un niveau »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una schermata messa in pila da una radice Large usa Inline, il cambio di dimensione stesso diventa un segnale di navigazione: «sei sceso di un livello»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma tela empilhada a partir de uma raiz Large usa Inline, a própria mudança de tamanho vira um sinal de navegação: «você desceu um nível»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อหน้าจอที่ถูก push จากราก Large ใช้ Inline การเปลี่ยนขนาดเองกลายเป็นสัญญาณการนำทาง: \"คุณลงลึกไปอีกหนึ่งระดับแล้ว\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi một màn hình được push từ gốc Large dùng Inline, chính sự thay đổi kích thước trở thành tín hiệu điều hướng: \"bạn đã vào sâu thêm một cấp.\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když obrazovka pushnutá z kořene Large používá Inline, změna velikosti se sama stává navigačním signálem: „jste o úroveň hlouběji“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en skærm, der skubbes på fra en Large-rod, bruger Inline, bliver selve størrelsesændringen et navigationssignal: »du er gået ét niveau dybere.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν μια οθόνη που σπρώχνεται από Large ρίζα χρησιμοποιεί Inline, η ίδια η αλλαγή μεγέθους γίνεται σήμα πλοήγησης: «πήγες ένα επίπεδο βαθύτερα»."
          }
        }
      }
    },
    "Large 제목이 스크롤에 따라 줄어드는 건 장식 애니메이션이 아니다. \"진입할 땐 방향감이 필요하니 크게, 읽기 시작하면 콘텐츠가 중요하니 물러난다\"를 제목에 적용한 동작이다. 그 축소가 곧 **\"이제 콘텐츠를 보는 중\"이라는 신호**다.\n\n전 화면을 Inline Large로 고정하면 그 신호가 사라진다. 게다가 깊은 상세 화면에 큰 제목을 두면 위계가 과장된다. 움직임 하나를 없애려다 물러남과 깊이 신호를 함께 잃었다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Large title shrinking as you scroll isn't a decorative animation. It's the title acting out a rule: \"When you arrive you need orientation, so be big; once reading starts the content matters, so step back.\" That shrink is itself **the signal that says \"you're looking at content now.\"**\n\nLock every screen to Inline Large and that signal disappears. On top of that, putting a large title on deep detail screens exaggerates the hierarchy. In trying to remove one motion, you lost both the stepping back and the depth signal."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A Large title shrinking as you scroll isn't a decorative animation. It's the title acting out a rule: \"When you arrive you need orientation, so be big; once reading starts the content matters, so step back.\" That shrink is itself **the signal that says \"you're looking at content now.\"**\n\nLock every screen to Inline Large and that signal disappears. On top of that, putting a large title on deep detail screens exaggerates the hierarchy. In trying to remove one motion, you lost both the stepping back and the depth signal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Large タイトルがスクロールに合わせて縮むのは、装飾のアニメーションではない。「入るときは方向感覚が必要だから大きく、読み始めたらコンテンツが大事だから引く」をタイトルに適用した動作だ。その縮小がそのまま「**いまはコンテンツを見ている最中」というシグナル**になっている。\n\n全画面を Inline Large に固定すると、そのシグナルが消える。しかも深い詳細画面に大きいタイトルを置くと、階層が誇張される。動きをひとつ消そうとして、引くことと深さのシグナルを両方失った。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 标题随滚动缩小，不是装饰动画。它把“进入时需要方向感所以大，开始阅读后内容重要所以退后”应用在了标题上。那个缩小本身就是**“现在正在看内容”的信号**。\n\n把所有界面都固定为 Inline Large，这个信号就没了。而且在很深的详情界面放大标题，层级会被夸大。想去掉一个动效，却把退后和深度的信号一并丢了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 標題隨滾動縮小，不是裝飾動畫。它把「進入時需要方向感所以大，開始閱讀後內容重要所以退後」應用程式在了標題上。那個縮小本身就是**「現在正在看內容」的訊號**。\n\n把所有介面都固定為 Inline Large，這個訊號就沒了。而且在很深的詳情介面放大標題，層級會被誇大。想去掉一個動效，卻把退後和深度的訊號一併丟了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшение Large-заголовка при прокрутке - не декоративная анимация. Это заголовок, разыгрывающий правило: «при входе нужна ориентация, поэтому будь крупным; когда начинается чтение, важен контент, поэтому отступи». Само это уменьшение - **сигнал «вы смотрите контент»**.\n\nЗафиксируйте на всех экранах Inline Large, и этот сигнал исчезает. Вдобавок крупный заголовок на глубоких экранах подробностей преувеличивает иерархию. Стремясь убрать одно движение, вы потеряли и отступление, и сигнал глубины."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un título Large que se encoge al desplazar no es una animación decorativa. Es el título representando una regla: «Al llegar necesitas orientación, así que sé grande; cuando empieza la lectura importa el contenido, así que retrocede». Esa reducción es en sí **la señal que dice «ahora estás viendo contenido»**.\n\nBloquea todas las pantallas en Inline Large y esa señal desaparece. Además, poner un título grande en pantallas de detalle profundas exagera la jerarquía. Al intentar quitar un movimiento, perdiste tanto el retroceso como la señal de profundidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Large-Titel, der beim Scrollen schrumpft, ist keine dekorative Animation. Es ist der Titel, der eine Regel vorführt: „Beim Ankommen brauchst du Orientierung, also sei groß; sobald das Lesen beginnt, zählt der Inhalt, also tritt zurück.“ Dieses Schrumpfen ist selbst **das Signal, das sagt: „Du siehst jetzt Inhalt an.“**\n\nStellt man jeden Bildschirm auf Inline Large fest, verschwindet dieses Signal. Zudem übertreibt ein großer Titel auf tiefen Detailbildschirmen die Hierarchie. Beim Versuch, eine Bewegung zu entfernen, hast du sowohl das Zurücktreten als auch das Tiefensignal verloren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grand titre qui rétrécit au défilement n'est pas une animation décorative. C'est le titre qui joue une règle : « À l'arrivée vous avez besoin de vous orienter, donc soyez grand ; une fois la lecture commencée, c'est le contenu qui compte, donc effacez-vous. » Ce rétrécissement est lui-même **le signal qui dit « vous regardez du contenu maintenant ».**\n\nFixez chaque écran sur Inline Large et ce signal disparaît. De plus, mettre un grand titre sur des écrans de détail profonds exagère la hiérarchie. En essayant de supprimer un mouvement, vous avez perdu à la fois l'effacement et le signal de profondeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un titolo Large che si rimpicciolisce mentre scorri non è un'animazione decorativa. È il titolo che mette in scena una regola: «Quando arrivi hai bisogno di orientamento, quindi sii grande; quando inizia la lettura conta il contenuto, quindi fatti da parte». Quel rimpicciolirsi è esso stesso **il segnale che dice «ora stai guardando il contenuto»**.\n\nBlocca ogni schermata su Inline Large e quel segnale sparisce. In più, mettere un titolo grande nelle schermate di dettaglio profonde esagera la gerarchia. Cercando di togliere un movimento, hai perso sia il farsi da parte sia il segnale di profondità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um título Large que encolhe ao rolar não é uma animação decorativa. É o título encenando uma regra: «Quando você chega precisa de orientação, então seja grande; quando a leitura começa o conteúdo importa, então recue.» Esse encolher é, em si, **o sinal que diz «agora você está vendo conteúdo».**\n\nTrave todas as telas em Inline Large e esse sinal some. Além disso, pôr um título grande em telas de detalhe profundas exagera a hierarquia. Ao tentar remover um movimento, você perdeu tanto o recuar quanto o sinal de profundidade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่อง Large ที่หดเมื่อเลื่อนไม่ใช่แอนิเมชันตกแต่ง แต่เป็นชื่อเรื่องที่แสดงกฎ: \"ตอนมาถึงต้องการรู้ทิศทาง จึงใหญ่ พอเริ่มอ่าน เนื้อหาสำคัญ จึงถอย\" การหดนั้นเองคือ**สัญญาณที่บอกว่า \"ตอนนี้คุณกำลังดูเนื้อหา\"**\n\nล็อกทุกหน้าจอเป็น Inline Large แล้วสัญญาณนั้นก็หาย ยิ่งกว่านั้น การวางชื่อเรื่องใหญ่บนหน้ารายละเอียดที่ลึกทำให้ลำดับชั้นเกินจริง ในการพยายามเอาการเคลื่อนไหวหนึ่งอย่างออก คุณเสียทั้งการถอยออกและสัญญาณความลึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề Large thu nhỏ khi bạn cuộn không phải là hoạt ảnh trang trí. Đó là tiêu đề diễn một quy tắc: \"Khi bạn đến cần định hướng, nên to; khi bắt đầu đọc thì nội dung quan trọng, nên lùi lại.\" Chính sự thu nhỏ đó là **tín hiệu nói \"bây giờ bạn đang xem nội dung.\"**\n\nKhóa mọi màn hình ở Inline Large và tín hiệu đó biến mất. Hơn nữa, đặt tiêu đề lớn trên các màn hình chi tiết sâu làm thứ bậc bị phóng đại. Khi cố gỡ một chuyển động, bạn mất cả sự lùi lại lẫn tín hiệu chiều sâu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velký nadpis zmenšující se při posouvání není dekorativní animace. Je to nadpis, který předvádí pravidlo: „Když přijdete, potřebujete orientaci, tak buď velký; jakmile začne čtení, záleží na obsahu, tak ustup.“ Toto zmenšení je samo o sobě **signálem, že „teď se díváte na obsah“.**\n\nZamkněte každou obrazovku na Inline Large a ten signál zmizí. Navíc velký nadpis na hlubokých detailních obrazovkách zveličuje hierarchii. Ve snaze odstranit jeden pohyb jste ztratili jak ustupování, tak signál hloubky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En Large-titel, der skrumper, mens du scroller, er ikke en dekorativ animation. Det er titlen, der spiller en regel ud: »Når du ankommer, har du brug for orientering, så vær stor; når læsningen begynder, betyder indholdet noget, så træd tilbage.« Den skrumpning er selv **signalet, der siger »nu ser du på indhold.«**\n\nLås hver skærm til Inline Large, og det signal forsvinder. Oven i købet overdriver en stor titel på dybe detaljeskærme hierarkiet. I forsøget på at fjerne én bevægelse mistede du både tilbagetrækningen og dybdesignalet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας Large τίτλος που μικραίνει καθώς κυλάς δεν είναι διακοσμητική κίνηση. Είναι ο τίτλος που παίζει έναν κανόνα: «Όταν φτάνεις χρειάζεσαι προσανατολισμό, γι' αυτό γίνε μεγάλος· μόλις αρχίσει η ανάγνωση το περιεχόμενο μετράει, γι' αυτό υποχώρησε». Αυτό το μάκρυνμα-μίκρυνμα είναι από μόνο του **το σήμα που λέει «τώρα βλέπεις περιεχόμενο»**.\n\nΚλείδωσε κάθε οθόνη σε Inline Large και αυτό το σήμα εξαφανίζεται. Επιπλέον, ο μεγάλος τίτλος σε βαθιές οθόνες λεπτομερειών υπερβάλλει την ιεραρχία. Προσπαθώντας να αφαιρέσεις μία κίνηση, έχασες και την υποχώρηση και το σήμα βάθους."
          }
        }
      }
    },
    "Large 제목이 큰 이유는 진입 순간의 **방향감**이다. \"내가 어디에 있는지\"를 크게 알려 주는 게 콘텐츠보다 중요한 루트 화면을 위한 모양이다. 대화 화면은 그렇지 않다. 누구와의 대화인지 알고 들어왔고, 들어오는 순간부터 콘텐츠가 주인공이다.\n\n기본값을 그대로 둔 것도 결정이다. 결정했다는 자각 없이 한 결정이라 이 화면에 맞는지 묻지 않았을 뿐이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Large title is big for the sake of **orientation** at the moment you arrive. It's a shape meant for root screens, where telling people \"where you are\" in a big way matters more than the content. A chat screen isn't like that. You already knew who you were talking to when you tapped in, and from the moment you arrive, the content is the star.\n\nLeaving the default alone is also a decision. It's just a decision made without realizing you were making one, so you never asked whether it fit this screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A Large title is big for the sake of **orientation** at the moment you arrive. It's a shape meant for root screens, where telling people \"where you are\" in a big way matters more than the content. A chat screen isn't like that. You already knew who you were talking to when you tapped in, and from the moment you arrive, the content is the star.\n\nLeaving the default alone is also a decision. It's just a decision made without realising you were making one, so you never asked whether it fit this screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Large タイトルが大きいのは、入った瞬間の**方向感覚**のためだ。「自分がどこにいるか」を大きく伝えることがコンテンツより大事なルート画面のための形である。チャット画面はそうではない。誰との会話かを分かったうえで入ってきており、入った瞬間からコンテンツが主役だ。\n\nデフォルトをそのままにしたのも決定だ。決めたという自覚のないまま下した決定だったから、この画面に合っているかを問わなかっただけである。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 标题之所以大，是为了进入时的**方向感**。它是为根界面设计的，在这些界面里，大声告诉用户“我在哪里”比内容更重要。对话界面不是这样。用户知道是和谁的对话才进来的，从进来那一刻起内容就是主角。\n\n保留默认值也是一种决定。只是在没意识到做了决定的情况下做的，所以没问过它适不适合这个界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 標題之所以大，是為了進入時的**方向感**。它是為根介面設計的，在這些介面裡，大聲告訴使用者「我在哪裡」比內容更重要。對話介面不是這樣。使用者知道是和誰的對話才進來的，從進來那一刻起內容就是主角。\n\n保留預設值也是一種決定。只是在沒意識到做了決定的情況下做的，所以沒問過它適不適合這個介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Large-заголовок крупный ради **ориентации** в момент входа. Это форма для корневых экранов, где сообщить людям «где вы» крупно важнее контента. Экран переписки не такой. Вы уже знали, с кем говорите, когда зашли, и с самого начала контент - главный.\n\nОставить значение по умолчанию - тоже решение. Просто оно принято без осознания, что вы его принимаете, поэтому вы так и не спросили, подходит ли оно этому экрану."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un título Large es grande por la **orientación** en el momento en que llegas. Es una forma pensada para pantallas raíz, donde decir a la gente «dónde estás» a lo grande importa más que el contenido. Una pantalla de chat no es así. Ya sabías con quién hablabas cuando entraste, y desde el momento en que llegas, el contenido es el protagonista.\n\nDejar el valor por defecto también es una decisión. Solo que se toma sin darse cuenta de que se está tomando, y por eso nunca te preguntaste si encajaba en esta pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Large-Titel ist groß wegen der **Orientierung** im Moment des Ankommens. Es ist eine Form für Wurzelbildschirme, wo es wichtiger ist, Menschen groß zu sagen, „wo sie sind“, als der Inhalt. Ein Chat-Bildschirm ist nicht so. Du wusstest bereits, mit wem du sprichst, als du hineingetippt hast, und vom Moment des Ankommens an ist der Inhalt der Star.\n\nDen Standard zu belassen ist ebenfalls eine Entscheidung. Nur eine, die getroffen wird, ohne zu merken, dass man sie trifft, sodass du nie gefragt hast, ob sie zu diesem Bildschirm passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grand titre est grand pour **l'orientation** au moment où vous arrivez. C'est une forme pensée pour les écrans racines, où dire aux gens « où ils sont » en grand compte plus que le contenu. Un écran de discussion n'est pas ainsi. Vous saviez déjà à qui vous parliez en entrant, et dès l'arrivée, le contenu est la vedette.\n\nLaisser le réglage par défaut est aussi une décision. Simplement une décision prise sans s'apercevoir qu'on la prend, si bien que vous ne vous êtes jamais demandé si elle convenait à cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un titolo Large è grande per amore dell'**orientamento** nel momento in cui arrivi. È una forma pensata per le schermate radice, dove dire alle persone «dove sei» in grande conta più del contenuto. Una schermata di chat non è così. Sapevi già con chi parlavi quando hai toccato per entrare, e dal momento in cui arrivi il contenuto è il protagonista.\n\nLasciare stare il predefinito è anch'essa una decisione. È solo una decisione presa senza accorgersi di prenderla, quindi non ti sei mai chiesto se andasse bene per questa schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um título Large é grande por causa da **orientação** no momento em que você chega. É uma forma pensada para telas raiz, onde dizer às pessoas «onde você está» em grande importa mais que o conteúdo. Uma tela de chat não é assim. Você já sabia com quem estava falando quando tocou para entrar, e a partir do momento em que chega, o conteúdo é a estrela.\n\nDeixar o padrão em paz também é uma decisão. É só uma decisão tomada sem perceber que se estava tomando uma, então você nunca perguntou se servia para esta tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่อง Large ใหญ่เพื่อ**การรู้ทิศทาง**ในจังหวะที่คุณมาถึง เป็นรูปทรงสำหรับหน้าจอราก ที่การบอกคนว่า \"คุณอยู่ที่ไหน\" อย่างใหญ่สำคัญกว่าเนื้อหา หน้าจอแชตไม่ใช่เช่นนั้น คุณรู้อยู่แล้วว่ากำลังคุยกับใครตอนแตะเข้ามา และตั้งแต่ตอนมาถึง เนื้อหาคือพระเอก\n\nการปล่อยค่าเริ่มต้นไว้ก็เป็นการตัดสินใจ เพียงแต่เป็นการตัดสินใจโดยไม่รู้ตัวว่ากำลังตัดสินใจ จึงไม่เคยถามว่าเหมาะกับหน้าจอนี้ไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề Large to là vì **định hướng** vào lúc bạn đến. Đó là hình dạng dành cho màn hình gốc, nơi nói cho người ta \"bạn đang ở đâu\" một cách lớn quan trọng hơn nội dung. Màn hình chat không như vậy. Bạn đã biết mình đang nói chuyện với ai khi chạm vào, và từ lúc đến, nội dung là ngôi sao.\n\nĐể nguyên mặc định cũng là một quyết định. Chỉ là một quyết định đưa ra mà không nhận ra mình đang quyết định, nên bạn chưa bao giờ hỏi nó có hợp màn hình này không."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velký nadpis je velký kvůli **orientaci** ve chvíli, kdy přijdete. Je to tvar určený pro kořenové obrazovky, kde je důležitější říct lidem „kde jste“ ve velkém než obsah. Obrazovka chatu taková není. Když jste klepli dovnitř, už jste věděli, s kým mluvíte, a od chvíle příchodu je hvězdou obsah.\n\nPonechání výchozího je také rozhodnutí. Je to jen rozhodnutí učiněné bez uvědomění, že ho děláte, takže jste se nikdy nezeptali, zda se hodí pro tuto obrazovku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En Large-titel er stor for **orienteringens** skyld i det øjeblik, du ankommer. Det er en form beregnet til rodskærme, hvor det at fortælle folk »hvor du er« stort betyder mere end indholdet. En chatskærm er ikke sådan. Du vidste allerede, hvem du talte med, da du trykkede ind, og fra det øjeblik du ankommer, er indholdet stjernen.\n\nAt lade standarden være er også en beslutning. Det er bare en beslutning truffet uden at opdage, at man traf en, så du aldrig spurgte, om den passede til denne skærm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας Large τίτλος είναι μεγάλος χάρη στον **προσανατολισμό** τη στιγμή που φτάνεις. Είναι μια μορφή φτιαγμένη για αρχικές οθόνες, όπου το να λες στους ανθρώπους «πού βρίσκεσαι» με μεγάλο τρόπο μετράει περισσότερο από το περιεχόμενο. Μια οθόνη συνομιλίας δεν είναι έτσι. Ήδη ήξερες με ποιον μιλούσες όταν πάτησες, και από τη στιγμή που φτάνεις, το περιεχόμενο είναι ο πρωταγωνιστής.\n\nΤο να αφήνεις την προεπιλογή είναι κι αυτό απόφαση. Απλώς απόφαση που παίρνεται χωρίς να καταλαβαίνεις ότι την παίρνεις, οπότε δεν ρώτησες ποτέ αν ταίριαζε σε αυτή την οθόνη."
          }
        }
      }
    },
    "Large(존재감 있지만 동적)와 Inline(안정적이지만 존재감 약함)의 **중간 지대가 비어 있었기 때문**에 추가된 절충안. 특히 유리 툴바에서 제목·아이템의 상대 위치가 고정되는 것이 시각적으로 안정적.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A compromise added because **the middle ground was empty** between Large (strong presence but dynamic) and Inline (stable but faint). On a glass toolbar in particular, keeping the relative positions of the title and items fixed looks visually steady."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A compromise added because **the middle ground was empty** between Large (strong presence but dynamic) and Inline (stable but faint). On a glass toolbar in particular, keeping the relative positions of the title and items fixed looks visually steady."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Large（存在感はあるが動的）とInline（安定しているが存在感が弱い）の**中間がぽっかり空いていた**ために追加された折衷案。特にガラスのツールバーでは、タイトルとアイテムの相対的な位置が固定されることで視覚的に安定する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Large（有存在感但会变动）与 Inline（稳定但存在感弱）之间的**中间地带是空的**，所以新增了这个折中方案。尤其是在玻璃工具栏上，标题与项目的相对位置固定，视觉上更稳定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Large（有存在感但會變動）與 Inline（穩定但存在感弱）之間的**中間地帶是空的**，所以新增了這個折中方案。尤其是在玻璃工具列上，標題與項目的相對位置固定，視覺上更穩定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компромисс, добавленный потому, что **середина между Large (сильное присутствие, но динамично) и Inline (стабильно, но бледно) была пуста**. На стеклянной панели инструментов особенно визуально устойчиво, когда взаимное положение заголовка и элементов зафиксировано."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compromiso añadido porque **faltaba un término medio** entre Large (mucha presencia pero dinámico) e Inline (estable pero tenue). En una barra de herramientas de cristal en particular, mantener fijas las posiciones relativas del título y los elementos se ve visualmente estable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kompromiss, hinzugefügt, weil **das Mittelfeld leer war** zwischen Large (starke Präsenz, aber dynamisch) und Inline (stabil, aber blass). Besonders auf einer gläsernen Symbolleiste wirkt es optisch ruhig, die relativen Positionen von Titel und Elementen festzuhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compromis ajouté parce que **le terrain intermédiaire était vide** entre Large (forte présence mais dynamique) et Inline (stable mais discret). Sur une barre d'outils en verre en particulier, fixer les positions relatives du titre et des éléments paraît visuellement stable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compromesso aggiunto perché **il terreno di mezzo era vuoto** tra Large (presenza forte ma dinamica) e Inline (stabile ma debole). In particolare su una barra degli strumenti di vetro, tenere fisse le posizioni relative di titolo ed elementi appare visivamente stabile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um meio-termo adicionado porque **o terreno do meio estava vazio** entre Large (presença forte mas dinâmica) e Inline (estável mas discreto). Numa barra de ferramentas de vidro em particular, manter fixas as posições relativas do título e dos itens parece visualmente firme."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประนีประนอมที่เพิ่มเข้ามาเพราะ**ช่วงกลางว่างเปล่า**ระหว่าง Large (มีตัวตนแรงแต่เคลื่อนไหว) กับ Inline (นิ่งแต่จาง) บนแถบเครื่องมือกระจกโดยเฉพาะ การคงตำแหน่งสัมพัทธ์ของชื่อเรื่องและรายการให้คงที่ดูนิ่งในสายตา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một sự dung hòa được thêm vào vì **khoảng giữa còn trống** giữa Large (hiện diện mạnh nhưng động) và Inline (ổn định nhưng mờ nhạt). Đặc biệt trên thanh công cụ kính, giữ vị trí tương đối của tiêu đề và các mục cố định trông ổn định về thị giác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompromis přidaný proto, že **střední cesta byla prázdná** mezi Large (silná přítomnost, ale dynamický) a Inline (stabilní, ale nevýrazný). Zvlášť na skleněném panelu nástrojů vypadá držení relativních pozic nadpisu a položek pevně vizuálně klidně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et kompromis tilføjet, fordi **mellemvejen var tom** mellem Large (stærk tilstedeværelse men dynamisk) og Inline (stabil men svag). Især på en glaslinje holder det titlens og elementernes relative positioner faste, hvilket ser visuelt roligt ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας συμβιβασμός που προστέθηκε επειδή **το ενδιάμεσο ήταν άδειο** ανάμεσα στο Large (ισχυρή παρουσία αλλά δυναμικό) και το Inline (σταθερό αλλά αχνό). Ειδικά σε γραμμή εργαλείων γυαλιού, η διατήρηση σταθερών των σχετικών θέσεων τίτλου και στοιχείων φαίνεται οπτικά σταθερή."
          }
        }
      }
    },
    "Large는 첫 화면 여백을 크게 차지하므로, 위쪽 콘텐츠가 즉시 보여야 하는 화면(채팅 등)엔 부적합.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large takes up a lot of room on the first screen, so it is a poor fit for screens where the top content must be visible right away (chat, for example)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Large takes up a lot of room on the first screen, so it is a poor fit for screens where the top content must be visible right away (chat, for example)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeは最初の画面の余白を大きく使うので、上のコンテンツがすぐ見えなければならない画面（チャットなど）には向かない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 在第一屏占用很大的空白，所以不适合需要立刻看到上方内容的界面（聊天等）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 在第一個畫面佔用很大的空白，所以不適合需要立刻看到上方內容的介面（聊天等）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Large занимает много места на первом экране, поэтому плохо подходит для экранов, где верхний контент должен быть виден сразу (например, чат)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Large ocupa mucho sitio en la primera pantalla, así que encaja mal en pantallas donde el contenido de arriba debe verse de inmediato (un chat, por ejemplo)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Large belegt auf dem ersten Bildschirm viel Platz, passt also schlecht zu Bildschirmen, auf denen der obere Inhalt sofort sichtbar sein muss (zum Beispiel Chat)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Large occupe beaucoup de place sur le premier écran, donc il convient mal aux écrans où le contenu du haut doit être visible tout de suite (une discussion, par exemple)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Large occupa molto spazio nella prima schermata, quindi si adatta male alle schermate in cui il contenuto in alto deve essere subito visibile (una chat, per esempio)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Large ocupa muito espaço na primeira tela, então é uma má escolha para telas em que o conteúdo do topo precisa estar visível de imediato (um chat, por exemplo)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Large กินพื้นที่มากบนหน้าจอแรก จึงไม่เหมาะกับหน้าจอที่เนื้อหาด้านบนต้องมองเห็นทันที (เช่นแชต)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Large chiếm nhiều chỗ ở màn hình đầu tiên, nên không hợp với các màn hình mà nội dung phía trên phải thấy ngay (ví dụ chat)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Large zabírá na první obrazovce hodně místa, takže se špatně hodí pro obrazovky, kde musí být horní obsah vidět hned (například chat)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Large fylder meget på den første skærm, så det passer dårligt til skærme, hvor det øverste indhold skal være synligt med det samme (chat, for eksempel)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Large παίρνει πολύ χώρο στην πρώτη οθόνη, οπότε ταιριάζει άσχημα σε οθόνες όπου το πάνω περιεχόμενο πρέπει να είναι ορατό αμέσως (π.χ. συνομιλία)."
          }
        }
      }
    },
    "Large의 축소 애니메이션이 싫다는 이유만으로 전 화면에 일괄 적용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied across every screen just because you dislike Large's collapse animation"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied across every screen just because you dislike Large's collapse animation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeの縮小アニメーションが嫌だという理由だけで、全画面に一括適用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只因为讨厌 Large 的缩小动画，就统一应用到所有界面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只因為討厭 Large 的縮小動畫，就統一應用到所有介面"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применили на всех экранах только потому, что не нравится анимация сворачивания Large"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado a todas las pantallas solo porque no te gusta la animación de colapso de Large"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jeden Bildschirm angewendet, nur weil du die Zusammenklapp-Animation von Large nicht magst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué à tous les écrans simplement parce que vous n'aimez pas l'animation de repli de Large"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicato a ogni schermata solo perché non ti piace l'animazione di compressione di Large"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado a todas as telas só porque você não gosta da animação de recolher do Large"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ทั่วทุกหน้าจอเพียงเพราะไม่ชอบแอนิเมชันยุบของ Large"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho mọi màn hình chỉ vì bạn không thích hoạt ảnh thu gọn của Large"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikováno na každou obrazovku jen proto, že se vám nelíbí animace sbalení Large"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anvendt på alle skærme blot fordi du ikke bryder dig om Larges sammenfoldningsanimation"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφαρμόστηκε σε κάθε οθόνη μόνο επειδή δεν σου αρέσει η κίνηση σύμπτυξης του Large"
          }
        }
      }
    },
    "Liquid Glass에서 **묶음 = 의미**. 같은 캡슐 안에 있으면 사용자는 \"이것들은 한 세트\"로 읽습니다. 왼쪽 묶음(도구 세트)과 오른쪽 단일(결정)이 분리돼 있어야 역할이 오독되지 않음.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Liquid Glass, **grouping = meaning**. People read items in the same capsule as \"one set.\" The left group (the toolset) and the single item on the right (the decision) have to stay separate so their roles are not misread."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In Liquid Glass, **grouping = meaning**. People read items in the same capsule as \"one set.\" The left group (the toolset) and the single item on the right (the decision) have to stay separate so their roles are not misread."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glassでは**まとまり = 意味**。同じカプセルに入っていると、ユーザーは「これはひとつのセット」と読み取ります。左のまとまり（ツールセット）と右の単独ボタン（決定）を分けておかないと、役割が誤読される。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Liquid Glass 中，**分组 = 含义**。在同一个胶囊里，用户会把它们读作“一组”。左侧一组（工具）和右侧单个（决定）分开，角色才不会被误读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Liquid Glass 中，**分組 = 含義**。在同一個膠囊裡，使用者會把它們讀作「一組」。左側一組（工具）和右側單個（決定）分開，角色才不會被誤讀。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Liquid Glass **группировка = смысл**. Люди читают элементы одной капсулы как «один набор». Левая группа (набор инструментов) и одиночный элемент справа (решение) должны оставаться раздельными, чтобы их роли не прочли неверно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Liquid Glass, **agrupar = significar**. La gente lee los elementos de la misma cápsula como «un conjunto». El grupo de la izquierda (el juego de herramientas) y el elemento único de la derecha (la decisión) tienen que seguir separados para que sus funciones no se malinterpreten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Liquid Glass heißt **Gruppierung = Bedeutung**. Menschen lesen Elemente in derselben Kapsel als „ein Set“. Die linke Gruppe (das Werkzeugset) und das einzelne Element rechts (die Entscheidung) müssen getrennt bleiben, damit ihre Rollen nicht missverstanden werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Liquid Glass, **regroupement = sens**. Les gens lisent les éléments d'une même capsule comme « un seul ensemble ». Le groupe de gauche (la boîte à outils) et l'élément unique à droite (la décision) doivent rester séparés pour que leurs rôles ne soient pas mal lus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Liquid Glass, **raggruppare = significato**. Le persone leggono gli elementi nella stessa capsula come «un insieme». Il gruppo di sinistra (gli strumenti) e l'unico elemento a destra (la decisione) devono restare separati perché i loro ruoli non vengano fraintesi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Liquid Glass, **agrupar = significado**. As pessoas leem os itens da mesma cápsula como «um conjunto». O grupo da esquerda (as ferramentas) e o item único da direita (a decisão) precisam ficar separados para que seus papéis não sejam mal interpretados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Liquid Glass **การจัดกลุ่ม = ความหมาย** คนอ่านรายการในแคปซูลเดียวกันว่า \"ชุดเดียว\" กลุ่มซ้าย (ชุดเครื่องมือ) และรายการเดี่ยวทางขวา (การตัดสินใจ) ต้องแยกกัน เพื่อไม่ให้บทบาทถูกอ่านผิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Liquid Glass, **nhóm = ý nghĩa**. Người ta đọc các mục trong cùng capsule là \"một bộ\". Nhóm bên trái (bộ công cụ) và mục đơn bên phải (quyết định) phải tách riêng để vai trò của chúng không bị đọc nhầm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Liquid Glass platí **seskupení = význam**. Lidé čtou položky ve stejné kapsli jako „jednu sadu“. Levá skupina (sada nástrojů) a jediná položka vpravo (rozhodnutí) musejí zůstat oddělené, aby se jejich role nepřečetly špatně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I Liquid Glass er **gruppering = betydning**. Folk læser elementer i samme kapsel som »ét sæt«. Den venstre gruppe (værktøjssættet) og det enkelte element til højre (beslutningen) må holdes adskilt, så deres roller ikke misforstås."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο Liquid Glass, **ομαδοποίηση = νόημα**. Οι άνθρωποι διαβάζουν τα στοιχεία στην ίδια κάψουλα ως «ένα σύνολο». Η αριστερή ομάδα (το σετ εργαλείων) και το μοναδικό στοιχείο στα δεξιά (η απόφαση) πρέπει να μένουν χωριστά ώστε να μη παρερμηνεύονται οι ρόλοι τους."
          }
        }
      }
    },
    "Liquid Glass에서 **한 캡슐 안에 있다는 것 자체가 정보**다. 사용자는 라벨을 하나씩 읽기 전에 묶음을 먼저 보고 \"이건 한 세트\"라고 읽는다. 그다음에는 그 안에서 가볍게 손을 뻗는다. 삭제를 보기 전환·정렬과 같은 캡슐에 넣으면 \"이 셋은 서로 바꿔 눌러도 괜찮은 도구\"라고 말하는 셈이 된다. 묶음이 거짓 정보가 된 것이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Liquid Glass, **being in the same capsule is itself information**. Before reading each label, users see the grouping and read it as \"one set.\" Then they reach into it casually. Put Delete in the same capsule as view switching and Sort, and you're saying \"these three are tools you can tap interchangeably.\" The grouping has become false information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In Liquid Glass, **being in the same capsule is itself information**. Before reading each label, users see the grouping and read it as \"one set.\" Then they reach into it casually. Put Delete in the same capsule as view switching and Sort, and you're saying \"these three are tools you can tap interchangeably.\" The grouping has become false information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glassでは、**ひとつのカプセルの中にあること自体が情報**だ。ユーザーはラベルをひとつずつ読む前にまとまりを見て、「これはひとつのセット」と読む。そしてその中では気軽に手を伸ばす。削除を表示切り替えや並べ替えと同じカプセルに入れると、「この3つは取り違えて押しても大丈夫なツール」と言っていることになる。まとまりが偽の情報になったのだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Liquid Glass 中，**处在同一个胶囊里本身就是信息**。用户在逐个读标签之前，先看到分组，读成“这是一组”。然后在其中轻松伸手。把删除和切换视图、排序放进同一个胶囊，等于在说“这三个是可以换着点的工具”。分组成了假信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Liquid Glass 中，**處在同一個膠囊裡本身就是資訊**。使用者在逐個讀標籤之前，先看到分組，讀成「這是一組」。然後在其中輕鬆伸手。把刪除和切換檢視、排序放進同一個膠囊，等於在說「這三個是可以換著點的工具」。分組成了假資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Liquid Glass **нахождение в одной капсуле само по себе информация**. Прежде чем читать каждую подпись, пользователи видят группировку и читают её как «один набор». Затем легко тянутся внутрь. Положите «Удалить» в одну капсулу со сменой вида и сортировкой, и вы говорите: «эти три - инструменты, которые можно нажимать вперемешку». Группировка стала ложной информацией."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Liquid Glass, **estar en la misma cápsula es en sí información**. Antes de leer cada etiqueta, los usuarios ven la agrupación y la leen como «un conjunto». Luego alargan la mano con naturalidad. Pon Eliminar en la misma cápsula que el cambio de vista y Ordenar, y estás diciendo «estas tres son herramientas que puedes tocar indistintamente». La agrupación se ha convertido en información falsa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Liquid Glass ist **in derselben Kapsel zu sein selbst Information**. Bevor Nutzer jede Beschriftung lesen, sehen sie die Gruppierung und lesen sie als „ein Set“. Dann greifen sie unbefangen hinein. Setzt man Löschen in dieselbe Kapsel wie Ansichtswechsel und Sortieren, sagt man: „Diese drei sind Werkzeuge, die man beliebig antippen kann.“ Die Gruppierung ist zu falscher Information geworden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Liquid Glass, **être dans la même capsule est en soi de l'information**. Avant de lire chaque libellé, les utilisateurs voient le regroupement et le lisent comme « un seul ensemble ». Puis ils y tendent la main sans méfiance. Mettez Supprimer dans la même capsule que le changement d'affichage et Trier, et vous dites : « ces trois-là sont des outils que vous pouvez toucher indifféremment. » Le regroupement est devenu une fausse information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Liquid Glass, **stare nella stessa capsula è già informazione**. Prima di leggere ogni etichetta, gli utenti vedono il raggruppamento e lo leggono come «un insieme». Poi ci arrivano con noncuranza. Metti Elimina nella stessa capsula del cambio di vista e di Ordina, e stai dicendo «questi tre sono strumenti che puoi toccare in modo intercambiabile». Il raggruppamento è diventato un'informazione falsa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Liquid Glass, **estar na mesma cápsula já é informação**. Antes de ler cada rótulo, os usuários veem o agrupamento e o leem como «um conjunto». Depois estendem a mão sem cerimônia. Ponha Excluir na mesma cápsula que a troca de visualização e Ordenar, e você está dizendo «estas três são ferramentas que você pode tocar de modo intercambiável». O agrupamento virou informação falsa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Liquid Glass **การอยู่ในแคปซูลเดียวกันเองคือข้อมูล** ก่อนอ่านแต่ละป้ายชื่อ ผู้ใช้เห็นการจัดกลุ่มและอ่านว่า \"ชุดเดียว\" แล้วเอื้อมเข้าไปอย่างสบาย ๆ ใส่ลบในแคปซูลเดียวกับการสลับมุมมองและเรียงลำดับ คุณกำลังบอกว่า \"ทั้งสามเป็นเครื่องมือที่แตะสลับกันได้\" การจัดกลุ่มกลายเป็นข้อมูลเท็จ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Liquid Glass, **cùng một capsule tự nó là thông tin**. Trước khi đọc từng nhãn, người dùng thấy cách nhóm và đọc nó là \"một bộ\". Rồi họ với vào đó một cách tùy tiện. Đặt Xóa vào cùng capsule với chuyển chế độ xem và Sắp xếp, bạn đang nói \"ba thứ này là công cụ chạm thay thế nhau được.\" Việc nhóm đã thành thông tin sai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V Liquid Glass je **být ve stejné kapsli samo o sobě informace**. Dřív než si uživatelé přečtou jednotlivé popisky, vidí seskupení a čtou ho jako „jednu sadu“. Pak do ní nedbale sáhnou. Dejte Smazat do stejné kapsle jako přepínání zobrazení a Seřadit a říkáte „tyto tři jsou nástroje, na které lze klepat zaměnitelně“. Seskupení se stalo nepravdivou informací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I Liquid Glass er **at være i samme kapsel i sig selv information**. Før de læser hver etiket, ser brugerne grupperingen og læser den som »ét sæt«. Så rækker de ud efter den uden at tænke. Læg Slet i samme kapsel som visningsskift og Sortér, og du siger: »disse tre er værktøjer, du kan trykke på i flæng.« Grupperingen er blevet falsk information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο Liquid Glass, **το να βρίσκεσαι στην ίδια κάψουλα είναι από μόνο του πληροφορία**. Πριν διαβάσουν κάθε ετικέτα, οι χρήστες βλέπουν την ομαδοποίηση και τη διαβάζουν ως «ένα σύνολο». Μετά απλώνουν το χέρι χωρίς σκέψη. Βάλε τη Διαγραφή στην ίδια κάψουλα με την εναλλαγή προβολής και την Ταξινόμηση και λες «αυτά τα τρία είναι εργαλεία που μπορείς να πατάς εναλλάξ». Η ομαδοποίηση έχει γίνει ψευδής πληροφορία."
          }
        }
      }
    },
    "Liquid Glass의 minimization 원칙을 탭바에 적용한 것**이동 장치는 이동할 때만 크면 됩니다**. 스크롤 방향으로 사용자 의도를 추론하며, 사라지는 게 아니라 접히는 것이라 위치 단서는 유지됨.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Liquid Glass minimization principle applied to the tab bar: **a navigation control only needs to be large while you're navigating**. It infers intent from the scroll direction, and because it collapses rather than disappears, the positional cue stays."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The Liquid Glass minimisation principle applied to the tab bar: **a navigation control only needs to be large while you're navigating**. It infers intent from the scroll direction, and because it collapses rather than disappears, the positional cue stays."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glassのminimizationの原則をタブバーに当てはめたもの。**移動のための装置は、移動するときだけ大きければいい**。スクロールの向きからユーザーの意図を推し量り、消えるのではなく折りたたまれるので、位置の手がかりは残る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Liquid Glass 的 minimization 原则用在标签栏上：**导航装置只需在移动时变大**。系统根据滚动方向推断用户意图，它不是消失而是折叠，所以位置线索得以保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Liquid Glass 的 minimization 原則用在標籤列上：**導覽裝置只需在移動時變大**。系統根據滾動方向推斷使用者意圖，它不是消失而是摺疊，所以位置線索得以保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принцип минимизации Liquid Glass, применённый к панели вкладок: **элементу навигации нужно быть крупным, только пока вы перемещаетесь**. Он определяет намерение по направлению прокрутки, а так как сворачивается, а не исчезает, подсказка о положении сохраняется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El principio de minimización de Liquid Glass aplicado a la barra de pestañas: **un control de navegación solo necesita ser grande mientras navegas**. Infiere la intención a partir de la dirección del desplazamiento, y como se colapsa en lugar de desaparecer, la pista de posición se mantiene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Minimierungsprinzip von Liquid Glass, auf die Tab-Leiste angewendet: **Ein Navigationselement muss nur groß sein, solange du navigierst**. Es erschließt die Absicht aus der Scrollrichtung, und weil es zusammenklappt statt zu verschwinden, bleibt der Positionshinweis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le principe de minimisation de Liquid Glass appliqué à la barre d'onglets : **un contrôle de navigation n'a besoin d'être grand que pendant que vous naviguez**. Il déduit l'intention de la direction du défilement, et comme il se replie au lieu de disparaître, le repère de position reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il principio di minimizzazione di Liquid Glass applicato alla barra delle schede: **un controllo di navigazione deve essere grande solo mentre navighi**. Deduce l'intenzione dalla direzione di scorrimento e, poiché si comprime invece di sparire, l'indizio di posizione resta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O princípio de minimização do Liquid Glass aplicado à barra de abas: **um controle de navegação só precisa ser grande enquanto você navega**. Ele infere a intenção pela direção da rolagem e, como recolhe em vez de sumir, a pista de posição permanece."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลักการย่อขนาดของ Liquid Glass ที่ใช้กับแถบแท็บ: **ตัวควบคุมการนำทางต้องใหญ่เฉพาะตอนที่กำลังนำทาง** มันอนุมานเจตนาจากทิศทางการเลื่อน และเพราะยุบแทนที่จะหายไป ตัวบอกตำแหน่งจึงยังอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguyên tắc thu nhỏ của Liquid Glass áp dụng cho thanh tab: **một điều khiển điều hướng chỉ cần to khi bạn đang điều hướng**. Nó suy ra ý định từ hướng cuộn, và vì nó thu gọn chứ không biến mất, tín hiệu vị trí vẫn còn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Princip minimalizace Liquid Glass aplikovaný na panel karet: **navigační ovladač musí být velký, jen když navigujete**. Odvozuje záměr ze směru posouvání, a protože se sbalí místo toho, aby zmizel, vodítko polohy zůstává."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass' minimeringsprincip anvendt på fanelinjen: **en navigationskontrol behøver kun at være stor, mens du navigerer**. Den udleder hensigten af scrollretningen, og fordi den folder sammen i stedet for at forsvinde, bliver positionsmærket."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αρχή ελαχιστοποίησης του Liquid Glass εφαρμοσμένη στη γραμμή καρτελών: **ένας έλεγχος πλοήγησης χρειάζεται να είναι μεγάλος μόνο όσο πλοηγείσαι**. Συμπεραίνει την πρόθεση από την κατεύθυνση κύλισης, και επειδή συμπτύσσεται αντί να εξαφανίζεται, το στοιχείο θέσης μένει."
          }
        }
      }
    },
    "Liquid Glass의 알려진 약점이 **\"복잡한 배경 위에서의 대비 부족\"**. 투명함(미학)과 가독성(접근성)이 충돌할 땐 가독성이 이긴다, 그래서 투명도를 포기하는 탈출구를 시스템이 공식 제공. 접근성 설정(투명도 감소)이 자동 적용되는 것과 같은 철학.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A known weakness of Liquid Glass is **\"not enough contrast over busy backgrounds.\"** When transparency (aesthetics) clashes with legibility (accessibility), legibility wins, so the system officially provides an escape hatch that gives up transparency. It is the same philosophy behind the automatic response to the Reduce Transparency setting."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A known weakness of Liquid Glass is **\"not enough contrast over busy backgrounds.\"** When transparency (aesthetics) clashes with legibility (accessibility), legibility wins, so the system officially provides an escape hatch that gives up transparency. It is the same philosophy behind the automatic response to the Reduce Transparency setting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glassの知られた弱点は「**複雑な背景の上でのコントラスト不足」**。透明感（美しさ）と読みやすさ（アクセシビリティ）がぶつかったときは読みやすさが勝つ。だから透明感を手放す逃げ道を、システムが公式に用意している。アクセシビリティ設定（透明度を下げる）が自動で適用されるのと同じ考え方。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 的已知弱点是**“在复杂背景上对比度不足”**。通透（美观）与可读性（无障碍）冲突时，可读性获胜，所以系统正式提供放弃通透的出路。与无障碍设置（降低透明度）自动生效是同一种理念。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 的已知弱點是**「在複雜背景上對比度不足」**。通透（美觀）與可讀性（無障礙）衝突時，可讀性獲勝，所以系統正式提供放棄通透的出路。與無障礙設定（降低透明度）自動生效是同一種理念。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Известная слабость Liquid Glass - **«недостаточный контраст на сложных фонах»**. Когда прозрачность (эстетика) конфликтует с читаемостью (универсальный доступ), побеждает читаемость, поэтому система официально предлагает выход с отказом от прозрачности. Это та же философия, по которой автоматически учитывается настройка «Уменьшение прозрачности»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto débil conocido de Liquid Glass es **«poco contraste sobre fondos cargados»**. Cuando la transparencia (estética) choca con la legibilidad (accesibilidad), gana la legibilidad, así que el sistema ofrece oficialmente una vía de escape que renuncia a la transparencia. Es la misma filosofía que hay detrás de la respuesta automática al ajuste Reducir transparencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine bekannte Schwäche von Liquid Glass ist **„zu wenig Kontrast über unruhigen Hintergründen“.** Kollidieren Transparenz (Ästhetik) und Lesbarkeit (Barrierefreiheit), gewinnt die Lesbarkeit, daher bietet das System offiziell einen Ausweg, der auf Transparenz verzichtet. Es ist dieselbe Philosophie hinter der automatischen Reaktion auf die Einstellung „Transparenz reduzieren“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une faiblesse connue de Liquid Glass est **« un contraste insuffisant sur les arrière-plans chargés ».** Quand la transparence (esthétique) entre en conflit avec la lisibilité (accessibilité), la lisibilité l'emporte, donc le système fournit officiellement une issue qui renonce à la transparence. C'est la même philosophie que la réaction automatique au réglage Réduire la transparence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una debolezza nota di Liquid Glass è **«contrasto insufficiente su sfondi carichi».** Quando la trasparenza (estetica) si scontra con la leggibilità (accessibilità), vince la leggibilità, quindi il sistema fornisce ufficialmente una via di fuga che rinuncia alla trasparenza. È la stessa filosofia dietro la risposta automatica all'impostazione Riduci trasparenza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma fraqueza conhecida do Liquid Glass é **«contraste insuficiente sobre fundos carregados».** Quando a transparência (estética) se choca com a legibilidade (acessibilidade), vence a legibilidade, então o sistema oferece oficialmente uma saída que abre mão da transparência. É a mesma filosofia por trás da resposta automática ao ajuste Reduzir Transparência."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จุดอ่อนที่รู้กันของ Liquid Glass คือ **\"ความตัดกันไม่พอบนพื้นหลังที่วุ่นวาย\"** เมื่อความโปร่งใส (ความสวยงาม) ชนกับความอ่านออก (การช่วยการเข้าถึง) ความอ่านออกชนะ ระบบจึงมีทางหนีอย่างเป็นทางการที่สละความโปร่งใส เป็นปรัชญาเดียวกับการตอบสนองอัตโนมัติต่อการตั้งค่าลดความโปร่งใส"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một điểm yếu đã biết của Liquid Glass là **\"không đủ tương phản trên nền rối.\"** Khi độ trong suốt (thẩm mỹ) va chạm với khả năng đọc (trợ năng), khả năng đọc thắng, nên hệ thống chính thức cung cấp một lối thoát từ bỏ độ trong suốt. Đó là cùng triết lý đằng sau phản hồi tự động với cài đặt Giảm độ trong suốt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Známou slabinou Liquid Glass je **„nedostatečný kontrast nad rušným pozadím.“** Když se střetne průhlednost (estetika) s čitelností (přístupnost), vítězí čitelnost, a proto systém oficiálně nabízí únikovou cestu, která se vzdává průhlednosti. Je to stejná filozofie, která stojí za automatickou reakcí na nastavení Omezit průhlednost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kendt svaghed ved Liquid Glass er **»for lidt kontrast over uroligt baggrunde.«** Når gennemsigtighed (æstetik) støder sammen med læselighed (tilgængelighed), vinder læseligheden, så systemet tilbyder officielt en nødudgang, der opgiver gennemsigtighed. Det er den samme filosofi bag den automatiske reaktion på indstillingen Reducer gennemsigtighed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γνωστή αδυναμία του Liquid Glass είναι η **«ανεπαρκής αντίθεση πάνω από φορτωμένα φόντα».** Όταν η διαφάνεια (αισθητική) συγκρούεται με την αναγνωσιμότητα (προσβασιμότητα), κερδίζει η αναγνωσιμότητα, οπότε το σύστημα παρέχει επίσημα μια διέξοδο που εγκαταλείπει τη διαφάνεια. Είναι η ίδια φιλοσοφία πίσω από την αυτόματη απόκριση στη ρύθμιση Μείωση διαφάνειας."
          }
        }
      }
    },
    "Liquid Glass의 알려진 약점이 **복잡한 배경 위에서의 대비 부족**이다. 투명함은 미학이고, 컨트롤이 읽히는 건 기능이다. 둘이 충돌하면 읽힘이 이긴다. 시스템이 hard 경계와 두꺼운 material 배경이라는 탈출구를 공식으로 두는 것도, 접근성 설정에 투명도 감소가 있는 것도 같은 이유다. 시안의 배경은 쓰는 사람의 배경이 아니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A known weakness of Liquid Glass is **insufficient contrast over busy backgrounds**. Transparency is aesthetics; readable controls are function. When the two clash, legibility wins. That's the same reason the system officially provides escape hatches like the hard boundary and thick material backgrounds, and why accessibility settings include Reduce Transparency. The mockup's background isn't the background people actually use."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A known weakness of Liquid Glass is **insufficient contrast over busy backgrounds**. Transparency is aesthetics; readable controls are function. When the two clash, legibility wins. That's the same reason the system officially provides escape hatches like the hard boundary and thick material backgrounds, and why accessibility settings include Reduce Transparency. The mockup's background isn't the background people actually use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass の知られた弱点が、**複雑な背景の上でのコントラスト不足**だ。透明感は美学であり、コントロールが読めることは機能だ。両者がぶつかれば、読みやすさが勝つ。システムが hard の境界と厚い material の背景という逃げ道を公式に用意しているのも、アクセシビリティ設定に「透明度を下げる」があるのも、同じ理由だ。カンプの背景は、使う人の背景ではない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 的已知弱点是**在复杂背景上对比度不足**。通透是美观，控件读得清是功能。两者冲突时，读得清获胜。系统正式提供 hard 边界和厚 material 背景这条出路，无障碍设置里有降低透明度，都是同一个原因。设计稿的背景不是使用者的背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 的已知弱點是**在複雜背景上對比度不足**。通透是美觀，控制元件讀得清是功能。兩者衝突時，讀得清獲勝。系統正式提供 hard 邊界和厚 material 背景這條出路，無障礙設定裡有降低透明度，都是同一個原因。設計稿的背景不是使用者的背景。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Известная слабость Liquid Glass - **недостаточный контраст на сложных фонах**. Прозрачность - эстетика, а читаемые элементы управления - функция. Когда они конфликтуют, побеждает читаемость. По той же причине система официально предоставляет выходы вроде жёсткой границы и фона из толстого материала, и по той же причине среди настроек универсального доступа есть «Уменьшение прозрачности». Фон макета - не тот фон, которым пользуются люди."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto débil conocido de Liquid Glass es **el contraste insuficiente sobre fondos cargados**. La transparencia es estética; los controles legibles son función. Cuando chocan, gana la legibilidad. Es la misma razón por la que el sistema ofrece oficialmente vías de escape como el límite hard y los fondos de material grueso, y por la que los ajustes de accesibilidad incluyen Reducir transparencia. El fondo de la maqueta no es el fondo que la gente usa de verdad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine bekannte Schwäche von Liquid Glass ist **unzureichender Kontrast über unruhigen Hintergründen**. Transparenz ist Ästhetik; lesbare Steuerelemente sind Funktion. Kollidieren beide, gewinnt die Lesbarkeit. Das ist derselbe Grund, aus dem das System offiziell Auswege wie die harte Grenze und dicke Materialhintergründe bietet und aus dem die Bedienungshilfen „Transparenz reduzieren“ enthalten. Der Hintergrund des Mockups ist nicht der Hintergrund, den Menschen tatsächlich nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une faiblesse connue de Liquid Glass est **un contraste insuffisant sur les arrière-plans chargés**. La transparence est de l'esthétique ; des contrôles lisibles sont de la fonction. Quand les deux s'opposent, la lisibilité l'emporte. C'est la même raison pour laquelle le système fournit officiellement des issues comme la limite hard et les fonds en matériau épais, et pour laquelle les réglages d'accessibilité incluent Réduire la transparence. L'arrière-plan de la maquette n'est pas l'arrière-plan que les gens utilisent réellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una debolezza nota di Liquid Glass è il **contrasto insufficiente su sfondi carichi**. La trasparenza è estetica; i controlli leggibili sono funzione. Quando le due si scontrano, vince la leggibilità. È lo stesso motivo per cui il sistema fornisce ufficialmente vie di fuga come il confine netto e gli sfondi in materiale spesso, e per cui le impostazioni di accessibilità includono Riduci trasparenza. Lo sfondo del mockup non è lo sfondo che le persone usano davvero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma fraqueza conhecida do Liquid Glass é o **contraste insuficiente sobre fundos carregados**. Transparência é estética; controles legíveis são função. Quando os dois se chocam, vence a legibilidade. É o mesmo motivo pelo qual o sistema oferece oficialmente saídas como a fronteira hard e fundos em material grosso, e pelo qual os ajustes de acessibilidade incluem Reduzir Transparência. O fundo do mockup não é o fundo que as pessoas realmente usam."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จุดอ่อนที่รู้กันของ Liquid Glass คือ**ความตัดกันไม่พอบนพื้นหลังที่วุ่นวาย** ความโปร่งใสคือความสวยงาม ตัวควบคุมที่อ่านออกคือฟังก์ชัน เมื่อสองอย่างชนกัน ความอ่านออกชนะ นั่นคือเหตุผลเดียวกับที่ระบบมีทางหนีอย่างเป็นทางการอย่างขอบเขต hard และพื้นหลังวัสดุแบบหนา และเหตุผลที่การตั้งค่าการช่วยการเข้าถึงมีลดความโปร่งใส พื้นหลังของม็อกอัปไม่ใช่พื้นหลังที่คนใช้จริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một điểm yếu đã biết của Liquid Glass là **không đủ tương phản trên nền rối**. Độ trong suốt là thẩm mỹ; điều khiển đọc được là chức năng. Khi hai thứ va chạm, khả năng đọc thắng. Đó là cùng lý do hệ thống chính thức cung cấp các lối thoát như ranh giới hard và nền vật liệu dày, và vì sao cài đặt trợ năng có Giảm độ trong suốt. Nền của mockup không phải nền người ta thật sự dùng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Známou slabinou Liquid Glass je **nedostatečný kontrast nad rušným pozadím**. Průhlednost je estetika; čitelné ovladače jsou funkce. Když se střetnou, vítězí čitelnost. Ze stejného důvodu systém oficiálně nabízí únikové cesty jako tvrdou hranici a pozadí z tlustého materiálu a proto nastavení přístupnosti obsahuje Omezit průhlednost. Pozadí mockupu není pozadí, které lidé skutečně používají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kendt svaghed ved Liquid Glass er **utilstrækkelig kontrast over urolige baggrunde**. Gennemsigtighed er æstetik; læselige kontroller er funktion. Når de to støder sammen, vinder læseligheden. Det er samme grund til, at systemet officielt tilbyder nødudgange som den hårde grænse og tykke materialebaggrunde, og til, at tilgængelighedsindstillingerne indeholder Reducer gennemsigtighed. Mockuppets baggrund er ikke den baggrund, folk faktisk bruger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια γνωστή αδυναμία του Liquid Glass είναι η **ανεπαρκής αντίθεση πάνω από φορτωμένα φόντα**. Η διαφάνεια είναι αισθητική· οι ευανάγνωστοι έλεγχοι είναι λειτουργία. Όταν οι δύο συγκρούονται, κερδίζει η αναγνωσιμότητα. Αυτός είναι ο ίδιος λόγος που το σύστημα παρέχει επίσημα διεξόδους όπως το σκληρό όριο και τα παχιά υλικά φόντου, και ο λόγος που οι ρυθμίσεις προσβασιμότητας περιλαμβάνουν Μείωση διαφάνειας. Το φόντο του μοντέλου δεν είναι το φόντο που χρησιμοποιούν πραγματικά οι άνθρωποι."
          }
        }
      }
    },
    "Liquid Glass의 투명함은 미학이고, 컨트롤이 읽히는 건 기능. **충돌 시 우선순위는 항상 가독성·접근성.**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transparency of Liquid Glass is aesthetics; readable controls are function. **When the two conflict, legibility and accessibility always come first.**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The transparency of Liquid Glass is aesthetics; readable controls are function. **When the two conflict, legibility and accessibility always come first.**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glassの透明感は美しさであり、コントロールが読めることは機能だ。**ぶつかったときの優先順位は常に可読性とアクセシビリティ。**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 的通透是美观，控件读得清是功能。**冲突时的优先级始终是可读性和无障碍。**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass 的通透是美觀，控制元件讀得清是功能。**衝突時的優先順序始終是可讀性和無障礙。**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прозрачность Liquid Glass - эстетика, а читаемые элементы управления - функция. **Когда они конфликтуют, первыми идут читаемость и универсальный доступ.**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transparencia de Liquid Glass es estética; los controles legibles son función. **Cuando ambas entran en conflicto, la legibilidad y la accesibilidad van siempre primero.**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transparenz von Liquid Glass ist Ästhetik; lesbare Steuerelemente sind Funktion. **Wenn beide in Konflikt geraten, gehen Lesbarkeit und Barrierefreiheit immer vor.**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transparence de Liquid Glass est de l'esthétique ; des contrôles lisibles sont de la fonction. **Quand les deux s'opposent, la lisibilité et l'accessibilité passent toujours en premier.**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trasparenza di Liquid Glass è estetica; i controlli leggibili sono funzione. **Quando i due sono in conflitto, leggibilità e accessibilità vengono sempre prima.**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transparência do Liquid Glass é estética; controles legíveis são função. **Quando os dois entram em conflito, legibilidade e acessibilidade vêm sempre primeiro.**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความโปร่งใสของ Liquid Glass คือความสวยงาม ตัวควบคุมที่อ่านออกคือฟังก์ชัน **เมื่อสองอย่างขัดกัน ความอ่านออกและการช่วยการเข้าถึงมาก่อนเสมอ**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ trong suốt của Liquid Glass là thẩm mỹ; điều khiển đọc được là chức năng. **Khi hai thứ xung đột, khả năng đọc và trợ năng luôn đi trước.**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Průhlednost Liquid Glass je estetika; čitelné ovladače jsou funkce. **Když jsou v konfliktu, čitelnost a přístupnost jdou vždy první.**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid Glass' gennemsigtighed er æstetik; læselige kontroller er funktion. **Når de to er i konflikt, kommer læselighed og tilgængelighed altid først.**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαφάνεια του Liquid Glass είναι αισθητική· οι ευανάγνωστοι έλεγχοι είναι λειτουργία. **Όταν οι δύο συγκρούονται, η αναγνωσιμότητα και η προσβασιμότητα προηγούνται πάντα.**"
          }
        }
      }
    },
    "Menu, 버튼을 탭하면 열리는 액션 목록. 아이콘·섹션(Divider)·서브메뉴·role(.destructive)·Toggle/Picker 포함까지 조합 가능.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu: a list of actions that opens when you tap a button. It can combine icons, sections (Divider), submenus, role(.destructive), and even embedded Toggles and Pickers."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu: a list of actions that opens when you tap a button. It can combine icons, sections (Divider), submenus, role(.destructive), and even embedded Toggles and Pickers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu。ボタンをタップすると開くアクションの一覧。アイコン、セクション（Divider）、サブメニュー、role(.destructive)、さらにToggleやPickerまで組み合わせられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu，点按按钮时展开的操作列表。图标、分区（Divider）、子菜单、role（.destructive）、Toggle/Picker 都可以组合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu，輕點按鈕時展開的操作列表。圖示、分割槽（Divider）、子選單、role（.destructive）、Toggle/Picker 都可以組合。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu: список действий, открывающийся по нажатию на кнопку. Может сочетать значки, разделы (Divider), подменю, role(.destructive) и даже встроенные Toggle и Picker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menú: una lista de acciones que se abre al tocar un botón. Puede combinar iconos, secciones (Divider), submenús, role(.destructive) e incluso Toggles y Pickers integrados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü: eine Liste von Aktionen, die sich beim Antippen eines Buttons öffnet. Sie kann Symbole, Abschnitte (Divider), Untermenüs, role(.destructive) und sogar eingebettete Toggles und Picker kombinieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu : une liste d'actions qui s'ouvre quand on touche un bouton. Elle peut combiner icônes, sections (Divider), sous-menus, role(.destructive), et même des Toggles et Pickers intégrés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu: un elenco di azioni che si apre toccando un pulsante. Può combinare icone, sezioni (Divider), sottomenu, role(.destructive) e persino Toggle e Picker incorporati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu: uma lista de ações que abre quando você toca num botão. Pode combinar ícones, seções (Divider), submenus, role(.destructive) e até Toggles e Pickers embutidos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมนู: รายการการกระทำที่เปิดเมื่อแตะปุ่ม รวมไอคอน ส่วน (Divider) เมนูย่อย role(.destructive) และแม้แต่ Toggle กับ Picker ที่ฝังอยู่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu: một danh sách hành động mở ra khi bạn chạm một nút. Nó có thể kết hợp biểu tượng, các phần (Divider), menu con, role(.destructive), và cả Toggle lẫn Picker nhúng vào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu: seznam akcí, který se otevře po klepnutí na tlačítko. Může kombinovat ikony, sekce (Divider), podnabídky, role(.destructive) a dokonce vložené Toggle a Picker."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu: en liste af handlinger, der åbner, når du trykker på en knap. Den kan kombinere ikoner, sektioner (Divider), undermenuer, role(.destructive) og endda indlejrede Toggles og Pickers."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu: μια λίστα ενεργειών που ανοίγει όταν πατάς ένα κουμπί. Μπορεί να συνδυάζει εικονίδια, ενότητες (Divider), υπομενού, role(.destructive), ακόμα και ενσωματωμένα Toggles και Pickers."
          }
        }
      }
    },
    "PDF 뷰어처럼 정말 5개 도구가 필요한 전문 화면에서 시스템의 공간 협상에 맡김": {
      "extractionState": "manual",
      "localizations": {
