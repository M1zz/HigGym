            "state": "translated",
            "value": "↑ Drag up for large"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ Drag up for large"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "↑ 引き上げるとlarge"
          }
