        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketika elemen kecil mengembang menjadi konten yang menguasai seluruh layar, seperti **thumbnail foto atau video → penampil layar penuh**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et lite element utvider seg til innhold som tar over hele skjermen, som **et bilde- eller videominiatyrbilde → en helskjermvisning**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer een klein element uitvouwt tot inhoud die het hele scherm overneemt, zoals **een foto- of videominiatuur → een viewer op volledig scherm**."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy mały element rozwija się do treści, która przejmuje cały ekran, jak **miniatura zdjęcia lub wideo → przeglądarka na pełnym ekranie**."
          }
        },
        "sv": {
