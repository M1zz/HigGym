    "강남역 3번 출구 앞": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In front of Gangnam Station Exit 3"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In front of Gangnam Station Exit 3"
          }
        },
        "ja": {
