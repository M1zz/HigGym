        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jediné tlačítko **Hotovo** vpravo nahoře na detailní obrazovce poznámky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En enkelt **Færdig**-knap øverst til højre på en notedetaljeskærm"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα μόνο κουμπί **Τέλος** πάνω δεξιά σε οθόνη λεπτομερειών σημείωσης"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi **Valmis**-painike muistiinpanon yksityiskohtanäkymän oikeassa yläkulmassa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
