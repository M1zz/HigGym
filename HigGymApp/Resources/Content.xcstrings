        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Filling an empty-looking slot with decorative buttons"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いて見える場所を飾りのボタンで埋める"
          }
        },
        "zh-Hans": {
