    "오류 코드·주문번호처럼 복사해 쓸 값에 허용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled on values people copy and use, like error codes and order numbers"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled on values people copy and use, like error codes and order numbers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーコードや注文番号のように、コピーして使う値で有効にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对错误码、订单号这类要复制来用的值允许"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對錯誤碼、訂單號這類要複製來用的值允許"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено для значений, которые люди копируют и используют, вроде кодов ошибок и номеров заказов"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado en valores que la gente copia y usa, como códigos de error y números de pedido"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Werten aktiviert, die Menschen kopieren und verwenden, wie Fehlercodes und Bestellnummern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé sur les valeurs que les gens copient et utilisent, comme les codes d'erreur et les numéros de commande"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilitata su valori che le persone copiano e usano, come codici di errore e numeri d'ordine"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilitada em valores que as pessoas copiam e usam, como códigos de erro e números de pedido"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดบนค่าที่คนคัดลอกไปใช้ เช่นรหัสข้อผิดพลาดและเลขคำสั่งซื้อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật trên các giá trị người ta sao chép và dùng, như mã lỗi và mã đơn hàng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povoleno u hodnot, které lidé kopírují a používají, jako chybové kódy a čísla objednávek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slået til på værdier, folk kopierer og bruger, som fejlkoder og ordrenumre"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιημένο σε τιμές που οι άνθρωποι αντιγράφουν και χρησιμοποιούν, όπως κωδικοί σφάλματος και αριθμοί παραγγελίας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytössä arvoilla, joita ihmiset kopioivat ja käyttävät, kuten virhekoodit ja tilausnumerot"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diaktifkan pada nilai yang disalin dan dipakai orang, seperti kode kesalahan dan nomor pesanan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivert på verdier folk kopierer og bruker, som feilkoder og ordrenumre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingeschakeld op waarden die mensen kopiëren en gebruiken, zoals foutcodes en bestelnummers"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączone na wartościach, które ludzie kopiują i używają, jak kody błędów i numery zamówień"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverat på värden som folk kopierar och använder, som felkoder och ordernummer"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hata kodları ve sipariş numaraları gibi insanların kopyalayıp kullandığı değerlerde açık"
          }
        }
      }
    },
    "오른손 엄지에 가려지는 위치에 핵심 버튼 배치": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting a key button where the right thumb covers it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting a key button where the right thumb covers it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右手の親指で隠れる位置に重要なボタンを置く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把核心按钮放在会被右手拇指遮住的位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把核心按鈕放在會被右手拇指遮住的位置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещение ключевой кнопки там, где её закрывает правый большой палец"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner un botón clave donde lo tapa el pulgar derecho"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Schlüssel-Button dorthin setzen, wo ihn der rechte Daumen verdeckt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre un bouton clé là où le pouce droit le recouvre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettere un pulsante chiave dove lo copre il pollice destro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pôr um botão-chave onde o polegar direito o cobre"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางปุ่มสำคัญไว้ที่ที่นิ้วโป้งขวาบัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt nút chính ở chỗ ngón cái phải che"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umístění klíčového tlačítka tam, kde ho zakrývá pravý palec"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At placere en vigtig knap, hvor den højre tommelfinger dækker den"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθέτηση ενός βασικού κουμπιού εκεί που το καλύπτει ο δεξιός αντίχειρας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tärkeän painikkeen laittaminen sinne, missä oikea peukalo peittää sen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menaruh tombol kunci di tempat yang tertutup ibu jari kanan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å sette en nøkkelknapp der høyre tommel dekker"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een belangrijke knop plaatsen waar de rechterduim hem bedekt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieszczenie kluczowego przycisku tam, gdzie zakrywa go prawy kciuk"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att placera en nyckelknapp där höger tumme täcker den"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önemli bir düğmeyi sağ başparmağın örttüğü yere koymak"
          }
        }
      }
    },
