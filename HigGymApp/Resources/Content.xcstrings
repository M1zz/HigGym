        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dividir em duas abas uma única tela que um controle segmentado poderia tratar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกหน้าจอเดียวที่ตัวควบคุมแบบเซกเมนต์จัดการได้เป็นสองแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tách một màn hình mà segmented control xử lý được thành hai tab"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdělení jediné obrazovky, kterou by zvládl segmentový ovladač, na dvě karty"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At dele en enkelt skærm, som en segmenteret kontrol kunne håndtere, i to faner"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαχωρισμός μιας οθόνης που ένας τμηματικός έλεγχος θα μπορούσε να χειριστεί σε δύο καρτέλες"
          }
        }
      }
    },
    "세그먼트로 충분한 화면을 억지로 두 탭으로 나눈다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcing a screen that a segmented control could handle into two tabs"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcing a screen that a segmented control could handle into two tabs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セグメントで十分な画面を無理に2つのタブに分ける"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把用分段控件就足够的界面，硬拆成两个标签"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把用分段控制元件就足夠的介面，硬拆成兩個標籤"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насильственное разбиение экрана, с которым справился бы сегментированный элемент, на две вкладки"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzar en dos pestañas una pantalla que un control segmentado podría resolver"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Bildschirm, den ein Segmented Control bewältigen könnte, in zwei Tabs zwingen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer en deux onglets un écran qu'un contrôle segmenté pourrait gérer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzare in due schede una schermata che un controllo segmentato potrebbe gestire"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forçar em duas abas uma tela que um controle segmentado poderia tratar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บังคับหน้าจอที่ตัวควบคุมแบบเซกเมนต์จัดการได้ให้เป็นสองแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ép màn hình mà segmented control xử lý được thành hai tab"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vynucení dvou karet pro obrazovku, kterou by zvládl segmentový ovladač"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At tvinge en skærm, som en segmenteret kontrol kunne håndtere, ind i to faner"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιβολή δύο καρτελών σε οθόνη που ένας τμηματικός έλεγχος θα μπορούσε να χειριστεί"
          }
        }
      }
    },
    "세로 목록에서는 예약을 빼고 최대 줄 수만 둔다. 셀이 내용만큼의 높이가 되고, 같은 화면에 더 많은 항목이 보인다. `reservesSpace`는 카드 그리드처럼 나란한 칸끼리 높이가 맞아야 하는 곳에만 쓴다. 2.1.4 예제에서 짧은 텍스트에도 같은 높이를 예약해 카드 정렬을 지키는 모습을 보면, 예약이 누구를 위한 것인지 분명해진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a vertical list, drop the reservation and set only a maximum line count. Each cell becomes as tall as its content, and more items fit on the same screen. Use `reservesSpace` only where side-by-side cells need matching heights, like a card grid. In the 2.1.4 example, seeing the same height reserved even for short text to keep cards aligned makes it clear who the reservation is for."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In a vertical list, drop the reservation and set only a maximum line count. Each cell becomes as tall as its content, and more items fit on the same screen. Use `reservesSpace` only where side-by-side cells need matching heights, like a card grid. In the 2.1.4 example, seeing the same height reserved even for short text to keep cards aligned makes it clear who the reservation is for."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦のリストでは確保を外し、最大行数だけを設定する。セルは内容に見合った高さになり、同じ画面により多くの項目が見える。`reservesSpace` は、カードグリッドのように並んだセルどうしの高さをそろえる必要がある場所でだけ使う。2.1.4の例で、短いテキストにも同じ高さを確保してカードの整列を保つ様子を見ると、確保が誰のためのものかがはっきりする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "竖向列表去掉预留，只设最大行数。单元格的高度随内容而定，同一个界面能看到更多项目。`reservesSpace` 只用在卡片网格这样并排的格子之间高度必须一致的地方。在 2.1.4 示例里看即使文字很短也预留相同高度、守住卡片对齐的样子，预留是为谁而设的就一目了然。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "豎向列表去掉預留，只設最大行數。單元格的高度隨內容而定，同一個介面能看到更多項目。`reservesSpace` 只用在卡片網格這樣並排的格子之間高度必須一致的地方。在 2.1.4 示例裡看即使文字很短也預留相同高度、守住卡片對齊的樣子，預留是為誰而設的就一目瞭然。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В вертикальном списке уберите резервирование и задайте только максимум строк. Каждая ячейка получает высоту по содержимому, и на том же экране помещается больше элементов. `reservesSpace` используйте только там, где соседним ячейкам нужны одинаковые высоты, как в сетке карточек. В примере 2.1.4 видно, что одинаковая высота резервируется даже для короткого текста, чтобы карточки выравнивались, и становится понятно, для кого это резервирование."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una lista vertical, quita la reserva y fija solo un máximo de líneas. Cada celda queda tan alta como su contenido, y caben más elementos en la misma pantalla. Usa `reservesSpace` solo donde las celdas lado a lado necesiten alturas iguales, como en una cuadrícula de tarjetas. En el ejemplo 2.1.4, ver reservada la misma altura incluso para texto corto con tal de alinear las tarjetas deja claro para quién es la reserva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass in einer vertikalen Liste die Reservierung weg und setze nur eine maximale Zeilenzahl. Jede Zelle wird so hoch wie ihr Inhalt, und auf denselben Bildschirm passen mehr Elemente. Nutze `reservesSpace` nur dort, wo nebeneinanderliegende Zellen gleiche Höhen brauchen, wie in einem Kartenraster. Im Beispiel 2.1.4 wird beim Anblick derselben reservierten Höhe selbst für kurzen Text, um Karten auszurichten, klar, für wen die Reservierung da ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans une liste verticale, abandonnez la réservation et fixez seulement un nombre maximal de lignes. Chaque cellule devient aussi haute que son contenu, et davantage d'éléments tiennent sur le même écran. N'utilisez `reservesSpace` que là où des cellules côte à côte ont besoin de hauteurs égales, comme une grille de cartes. Dans l'exemple 2.1.4, voir la même hauteur réservée même pour un texte court afin d'aligner les cartes montre bien à qui sert la réservation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In un elenco verticale, lascia perdere la riserva e imposta solo un numero massimo di righe. Ogni cella diventa alta quanto il suo contenuto e nella stessa schermata entrano più elementi. Usa `reservesSpace` solo dove celle affiancate hanno bisogno di altezze uguali, come in una griglia di schede. Nell'esempio 2.1.4, vedere riservata la stessa altezza anche per testo breve per tenere allineate le schede chiarisce per chi serve la riserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa lista vertical, abandone a reserva e defina só um número máximo de linhas. Cada célula fica tão alta quanto o seu conteúdo, e cabem mais itens na mesma tela. Use `reservesSpace` apenas onde células lado a lado precisam de alturas iguais, como numa grade de cartões. No exemplo 2.1.4, ver reservada a mesma altura até para texto curto para manter os cartões alinhados deixa claro para quem serve a reserva."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในรายการแนวตั้ง เลิกสำรองและตั้งแค่จำนวนบรรทัดสูงสุด แต่ละเซลล์สูงเท่าเนื้อหา และมีรายการมากขึ้นพอดีหน้าจอเดียวกัน ใช้ `reservesSpace` เฉพาะที่เซลล์ข้างกันต้องมีความสูงเท่ากัน เช่นกริดการ์ด ในตัวอย่าง 2.1.4 การเห็นความสูงเดียวกันถูกสำรองแม้กับข้อความสั้นเพื่อให้การ์ดเรียงแนว ทำให้ชัดว่าการสำรองมีไว้เพื่อใคร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong danh sách dọc, bỏ việc giữ chỗ và chỉ đặt số dòng tối đa. Mỗi ô cao đúng bằng nội dung, và vừa nhiều mục hơn trên cùng màn hình. Chỉ dùng `reservesSpace` nơi các ô cạnh nhau cần cùng chiều cao, như lưới thẻ. Trong ví dụ 2.1.4, thấy cùng một chiều cao được giữ cả cho văn bản ngắn để thẻ thẳng hàng sẽ rõ việc giữ chỗ là vì ai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve svislém seznamu zrušte rezervaci a nastavte jen maximální počet řádků. Každá buňka bude vysoká jen podle obsahu a na stejnou obrazovku se vejde víc položek. `reservesSpace` používejte jen tam, kde sousedící buňky potřebují shodné výšky, jako v mřížce karet. V příkladu 2.1.4 uvidíte, že se stejná výška rezervuje i pro krátký text, aby karty zůstaly zarovnané, a bude jasné, pro koho je rezervace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I en lodret liste, drop reservationen og sæt kun et maksimalt linjeantal. Hver celle bliver så høj som sit indhold, og flere elementer er der plads til på samme skærm. Brug `reservesSpace` kun, hvor celler side om side har brug for samme højde, som i et kortgitter. I eksempel 2.1.4 bliver det klart, hvem reservationen er til, når du ser den samme højde reserveret selv til kort tekst for at holde kortene på linje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε μια κάθετη λίστα, παράτησε τη δέσμευση και όρισε μόνο μέγιστο αριθμό γραμμών. Κάθε κελί γίνεται τόσο ψηλό όσο το περιεχόμενό του, και περισσότερα στοιχεία χωρούν στην ίδια οθόνη. Χρησιμοποίησε το `reservesSpace` μόνο εκεί που κελιά δίπλα-δίπλα χρειάζονται ίδια ύψη, όπως σε πλέγμα καρτών. Στο παράδειγμα 2.1.4, το να δεις το ίδιο ύψος δεσμευμένο ακόμα και για σύντομο κείμενο ώστε οι κάρτες να μένουν ευθυγραμμισμένες κάνει σαφές για ποιον είναι η δέσμευση."
          }
        }
      }
    },
    "세로 바는 **가로 공간이 넓은 기기**를 위한 것이다. 세로 바가 빼앗는 것은 폭이고, iPhone 세로 화면에서 폭은 가장 부족한 자원이다. API는 자리를 계산해 줄 뿐 그 자리를 써도 되는지는 판단하지 않는다. 좌우를 동시에 쓰면 양쪽에서 폭을 깎아 콘텐츠가 가장 크게 잠식된다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertical bars are for **devices with plenty of horizontal space**. What a vertical bar takes away is width, and on an iPhone in portrait, width is the scarcest resource. The API only calculates the space; it doesn't judge whether you should use that space. Use both sides at once, and you shave width from both edges, eating into the content the most."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertical bars are for **devices with plenty of horizontal space**. What a vertical bar takes away is width, and on an iPhone in portrait, width is the scarcest resource. The API only calculates the space; it doesn't judge whether you should use that space. Use both sides at once, and you shave width from both edges, eating into the content the most."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦のバーは**横のスペースが広いデバイス**のためのものだ。縦のバーが奪うのは幅で、縦向きのiPhoneでは幅こそがいちばん足りない資源だ。APIは場所を計算してくれるだけで、その場所を使っていいかどうかは判断しない。左右を同時に使うと両側から幅を削り、コンテンツをいちばん大きく食いつぶす。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "竖向栏是为**横向空间宽裕的设备**准备的。竖向栏夺走的是宽度，而在 iPhone 竖屏上，宽度是最稀缺的资源。API 只会替你算位置，不会判断是否可以用那个位置。左右同时使用，两边都在削减宽度，内容被侵蚀得最厉害。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "豎向列是為**橫向空間寬裕的裝置**準備的。豎向列奪走的是寬度，而在 iPhone 豎屏上，寬度是最稀缺的資源。API 只會替你算位置，不會判斷是否可以用那個位置。左右同時使用，兩邊都在削減寬度，內容被侵蝕得最厲害。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вертикальные панели - для **устройств с большим запасом ширины**. Вертикальная панель отнимает ширину, а на iPhone в портрете ширина - самый дефицитный ресурс. API лишь рассчитывает место, но не судит, стоит ли его использовать. Используйте обе стороны сразу, и вы срезаете ширину с обоих краёв, сильнее всего съедая контент."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras verticales son para **dispositivos con mucho espacio horizontal**. Lo que quita una barra vertical es ancho, y en un iPhone en vertical, el ancho es el recurso más escaso. La API solo calcula el espacio; no juzga si debes usarlo. Usa ambos lados a la vez y recortas ancho de ambos bordes, comiéndote el contenido más que nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertikale Leisten sind für **Geräte mit viel horizontalem Platz**. Was eine vertikale Leiste nimmt, ist Breite, und auf einem iPhone im Hochformat ist Breite die knappste Ressource. Die API berechnet nur den Platz; sie beurteilt nicht, ob du diesen Platz nutzen solltest. Nutzt du beide Seiten zugleich, schabst du Breite von beiden Rändern ab und frisst am stärksten in den Inhalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les barres verticales sont pour **les appareils qui ont beaucoup d'espace horizontal**. Ce qu'une barre verticale enlève, c'est de la largeur, et sur un iPhone en portrait, la largeur est la ressource la plus rare. L'API ne fait que calculer l'espace ; elle ne juge pas si vous devriez utiliser cet espace. Utilisez les deux côtés à la fois, et vous rognez la largeur des deux bords, mordant le plus sur le contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le barre verticali sono per **dispositivi con molto spazio orizzontale**. Ciò che una barra verticale toglie è la larghezza, e su un iPhone in verticale la larghezza è la risorsa più scarsa. L'API calcola solo lo spazio; non giudica se dovresti usarlo. Usa entrambi i lati insieme e togli larghezza a entrambi i bordi, mangiando il più possibile il contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As barras verticais são para **dispositivos com bastante espaço horizontal**. O que uma barra vertical tira é a largura, e num iPhone na vertical a largura é o recurso mais escasso. A API só calcula o espaço; não julga se você deve usá-lo. Use os dois lados ao mesmo tempo e você raspa largura das duas bordas, comendo o conteúdo ao máximo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแนวตั้งมีไว้สำหรับ**อุปกรณ์ที่มีพื้นที่แนวนอนเหลือเฟือ** สิ่งที่แถบแนวตั้งเอาไปคือความกว้าง และบน iPhone แนวตั้ง ความกว้างคือทรัพยากรที่หายากที่สุด API แค่คำนวณพื้นที่ ไม่ได้ตัดสินว่าคุณควรใช้พื้นที่นั้นไหม ใช้ทั้งสองข้างพร้อมกัน คุณเฉือนความกว้างจากทั้งสองขอบ กินเนื้อหามากที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh dọc dành cho **thiết bị có nhiều không gian ngang**. Thứ thanh dọc lấy đi là chiều rộng, và trên iPhone dọc, chiều rộng là tài nguyên khan hiếm nhất. API chỉ tính không gian; nó không phán xét bạn có nên dùng không gian đó. Dùng cả hai bên cùng lúc, bạn gọt chiều rộng ở cả hai mép, ăn vào nội dung nhiều nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svislé panely jsou pro **zařízení s dostatkem vodorovného místa**. Svislý panel bere šířku a na iPhonu na výšku je šířka nejvzácnějším zdrojem. API jen počítá prostor; neposuzuje, zda ho máte použít. Použijte obě strany najednou a ubíráte šířku z obou okrajů, čímž nejvíc ukusujete z obsahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lodrette bjælker er til **enheder med masser af vandret plads**. Det, en lodret bjælke tager væk, er bredde, og på en iPhone i portræt er bredde den knappeste ressource. API'et beregner kun pladsen; det bedømmer ikke, om du bør bruge den plads. Brug begge sider på én gang, og du barberer bredde af begge kanter og æder mest ind på indholdet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κάθετες γραμμές είναι για **συσκευές με άφθονο οριζόντιο χώρο**. Αυτό που αφαιρεί μια κάθετη γραμμή είναι πλάτος, και σε ένα iPhone σε portrait, το πλάτος είναι ο πιο σπάνιος πόρος. Το API μόνο υπολογίζει τον χώρο· δεν κρίνει αν πρέπει να χρησιμοποιήσεις αυτόν τον χώρο. Χρησιμοποίησε και τις δύο πλευρές ταυτόχρονα και ξυρίζεις πλάτος και από τις δύο άκρες, τρώγοντας περισσότερο το περιεχόμενο."
          }
        }
      }
    },
