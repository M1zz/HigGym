          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ่อนมันแล้วสร้างแถบแท็บหน้าตาเหมือนกันที่ด้านล่างใหม่ (ทำซ้ำสองครั้ง)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn nó rồi dựng lại thanh tab giả ở dưới (cài đặt trùng lặp)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrýt ho a pak dole znovu postavit podobný panel karet (duplicitní implementace)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At skjule den og så genopbygge en tilsvarende fanelinje i bunden (en duplikeret implementering)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόκρυψή της και μετά ανακατασκευή μιας ομοιώματος γραμμής καρτελών κάτω (διπλή υλοποίηση)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen piilottaminen ja sitten samannäköisen välilehtipalkin uudelleenrakentaminen alas (kaksoistoteutus)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyembunyikannya lalu membangun ulang bilah tab tiruan di bawah (implementasi ganda)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å skjule den og så bygge opp igjen en lignende fanelinje nederst (en duplikatimplementasjon)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hem verbergen en dan onderaan een tabbalk nabouwen die erop lijkt (een dubbele implementatie)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrycie go, a potem odbudowanie podobnego paska kart na dole (zdublowana implementacja)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att dölja det och sedan bygga om ett liknande flikfält längst ner (en dubblerad implementation)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizleyip sonra altta benzer bir sekme çubuğu yeniden kurmak (çift uygulama)"
          }
        }
      }
    },
    "숨겼다 나타날 때 레이아웃 점프가 없는지 확인하세요. 탭바 높이에 의존하는 하단 UI가 있으면 깨집니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure there's no layout jump when it hides and reappears. Any bottom UI that depends on the tab bar's height will break."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure there's no layout jump when it hides and reappears. Any bottom UI that depends on the tab bar's height will break."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠れて再び現れるときにレイアウトが跳ねないか確認してください。タブバーの高さに依存する下部のUIがあると崩れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认隐藏又出现时没有布局跳动。如果有依赖标签栏高度的底部 UI，就会出问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認隱藏又出現時沒有佈局跳動。如果有依賴標籤列高度的底部 UI，就會出問題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что при скрытии и появлении нет скачка макета. Любой нижний интерфейс, зависящий от высоты панели вкладок, сломается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que no hay salto de diseño al ocultarse y reaparecer. Toda interfaz inferior que dependa de la altura de la barra de pestañas se romperá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle sicher, dass es beim Ausblenden und Wiedererscheinen keinen Layoutsprung gibt. Jede untere UI, die von der Höhe der Tab-Leiste abhängt, bricht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous qu'il n'y a pas de saut de mise en page au masquage et à la réapparition. Toute interface du bas qui dépend de la hauteur de la barre d'onglets cassera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che non ci sia un salto di layout quando si nasconde e ricompare. Qualsiasi UI in basso che dipenda dall'altezza della barra delle schede si romperà."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Garanta que não haja salto de layout quando ela se oculta e reaparece. Qualquer interface inferior que dependa da altura da barra de abas vai quebrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจให้แน่ใจว่าไม่มีเลย์เอาต์กระโดดเมื่อซ่อนและปรากฏอีกครั้ง UI ด้านล่างที่พึ่งความสูงของแถบแท็บจะพัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảo đảm không có bố cục nhảy khi nó ẩn và hiện lại. Mọi UI phía dưới phụ thuộc chiều cao thanh tab sẽ hỏng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajistěte, aby při skrytí a opětovném zobrazení neskákalo rozvržení. Jakékoli spodní UI závislé na výšce panelu karet se rozbije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for, at der ikke er noget layoutspring, når den skjules og vises igen. Enhver nederste brugerflade, der afhænger af fanelinjens højde, vil gå i stykker."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βεβαιώσου ότι δεν υπάρχει πήδημα διάταξης όταν κρύβεται και ξαναεμφανίζεται. Κάθε κάτω διεπαφή που εξαρτάται από το ύψος της γραμμής καρτελών θα σπάσει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Varmista, ettei asettelu hyppää sen piiloutuessa ja ilmestyessä uudelleen. Mikä tahansa alaosan käyttöliittymä, joka nojaa välilehtipalkin korkeuteen, rikkoutuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan tidak ada lompatan tata letak saat ia bersembunyi dan muncul kembali. UI bawah apa pun yang bergantung pada tinggi bilah tab akan rusak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sørg for at det ikke er noe layouthopp når den skjules og dukker opp igjen. Alt UI nederst som er avhengig av fanelinjens høyde vil svikte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorg dat er geen layoutsprong is als hij verdwijnt en weer verschijnt. Elke onderste UI die van de hoogte van de tabbalk afhangt, zal breken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że nie ma skoku układu, gdy się ukrywa i pojawia ponownie. Każdy dolny interfejs zależny od wysokości paska kart się zepsuje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se till att det inte blir något layouthopp när det döljs och visas igen. Allt nedre gränssnitt som beror på flikfältets höjd går sönder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlenip yeniden göründüğünde düzen zıplaması olmadığından emin ol. Sekme çubuğunun yüksekliğine bağlı her alt arayüz bozulur."
          }
        }
      }
    },
    "숫자 대신 **짧은 텍스트 배지** (.badge(\"NEW\")), 상태형 알림.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **short text badge** instead of a number (.badge(\"NEW\")), for status notices."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **short text badge** instead of a number (.badge(\"NEW\")), for status notices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
