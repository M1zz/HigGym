          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikováno na aplikaci pro zprávy s častým přepínáním karet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anvendt på en besked-app med hyppigt faneskift"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφαρμοσμένο σε εφαρμογή μηνυμάτων με συχνή εναλλαγή καρτελών"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellettu viestisovellukseen, jossa välilehtiä vaihdetaan usein"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diterapkan pada aplikasi pesan dengan pergantian tab yang sering"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukt på en meldingsapp med hyppig fanebytte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegepast op een berichtenapp met frequent wisselen van tabblad"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastosowane w aplikacji do wiadomości, w której karty przełącza się często"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillämpat på en meddelandeapp med frekvent flikbyte"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık sekme değişen bir mesajlaşma uygulamasına uygulandı"
          }
        }
      }
    },
    "탭 전환이 잦은 앱(메신저 등)에선 오히려 방해입니다. 콘텐츠 소비형 화면에만 켜세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In apps where people switch tabs often (messaging apps, for example), it just gets in the way. Turn it on only for content-consumption screens."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In apps where people switch tabs often (messaging apps, for example), it just gets in the way. Turn it on only for content-consumption screens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを頻繁に切り替えるアプリ（メッセンジャーなど）では、かえって邪魔になります。コンテンツを消費する画面でだけ有効にしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在频繁切换标签的应用（聊天等）里反而是妨碍。只在内容消费型界面里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在頻繁切換標籤的應用程式（聊天等）裡反而是妨礙。只在內容消費型介面裡開啟。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В приложениях, где люди часто переключают вкладки (например, в мессенджерах), это только мешает. Включайте только для экранов потребления содержимого."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En apps donde la gente cambia de pestaña a menudo (apps de mensajería, por ejemplo), solo estorba. Actívalo únicamente en pantallas de consumo de contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Apps, in denen Menschen oft Tabs wechseln (zum Beispiel Messaging-Apps), steht es nur im Weg. Schalte es nur für Bildschirme ein, auf denen Inhalt konsumiert wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les apps où les gens changent souvent d'onglet (les apps de messagerie, par exemple), cela ne fait que gêner. N'activez cela que pour les écrans de consommation de contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelle app in cui le persone cambiano spesso scheda (per esempio le app di messaggistica), dà solo fastidio. Attivalo solo per le schermate di consumo dei contenuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em apps em que as pessoas trocam muito de aba (apps de mensagens, por exemplo), só atrapalha. Ative apenas para telas de consumo de conteúdo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในแอปที่คนสลับแท็บบ่อย (เช่นแอปข้อความ) มันแค่ขวาง เปิดเฉพาะหน้าจอที่อ่านเสพเนื้อหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong app mà người ta chuyển tab thường xuyên (ví dụ app nhắn tin), nó chỉ gây vướng. Chỉ bật cho màn hình tiêu thụ nội dung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V aplikacích, kde lidé často přepínají karty (například aplikace pro zprávy), to jen překáží. Zapněte to jen pro obrazovky konzumace obsahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I apps, hvor folk ofte skifter faner (besked-apps for eksempel), er det bare i vejen. Slå det kun til på indholdsforbrugsskærme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε εφαρμογές όπου οι άνθρωποι αλλάζουν συχνά καρτέλες (για παράδειγμα εφαρμογές μηνυμάτων), απλώς εμποδίζει. Ενεργοποίησέ το μόνο για οθόνες κατανάλωσης περιεχομένου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksissa, joissa ihmiset vaihtavat usein välilehteä (esimerkiksi viestisovellukset), se vain on tiellä. Kytke se päälle vain sisällönkulutusnäkymille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada aplikasi tempat orang sering berpindah tab (misalnya aplikasi pesan), ia hanya menghalangi. Nyalakan hanya untuk layar konsumsi konten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I apper der folk ofte bytter faner (meldingsapper, for eksempel) er det bare i veien. Slå det på bare for skjermer der innhold konsumeres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In apps waar mensen vaak van tabblad wisselen (berichtenapps bijvoorbeeld) zit het alleen maar in de weg. Zet het alleen aan voor schermen waar inhoud wordt geconsumeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W aplikacjach, w których ludzie często przełączają karty (na przykład w komunikatorach), po prostu przeszkadza. Włączaj tylko na ekranach konsumowania treści."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I appar där folk ofta byter flik (till exempel meddelandeappar) är det bara i vägen. Slå på det bara för skärmar för innehållskonsumtion."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanların sık sekme değiştirdiği uygulamalarda (örneğin mesajlaşma uygulamaları) yalnızca engel olur. Yalnızca içerik tüketme ekranları için aç."
          }
        }
      }
    },
    "탭 후보가 생기면 **\"석 달 뒤에도 이 탭이 같은 내용으로 있을까\"**를 묻는다. 아니라면 그건 구조가 아니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a tab candidate comes up, ask: **\"Will this tab still be here, with the same content, three months from now?\"** If not, it isn't structure."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a tab candidate comes up, ask: **\"Will this tab still be here, with the same content, three months from now?\"** If not, it isn't structure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブの候補が出てきたら、**「3か月後もこのタブは同じ内容でここにあるだろうか**」を問う。そうでないなら、それは構造ではない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现标签候选时，问：“**三个月后，这个标签还会是同样的内容吗**？”不是的话，它就不是结构。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出現標籤候選時，問：「**三個月後，這個標籤還會是同樣的內容嗎**？」不是的話，它就不是結構。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда появляется кандидат во вкладки, спросите: **«Будет ли эта вкладка здесь же, с тем же содержимым, через три месяца?»** Если нет, это не структура."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando surja una candidata a pestaña, pregunta: **«¿Seguirá esta pestaña aquí, con el mismo contenido, dentro de tres meses?»** Si no, no es estructura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage, wenn ein Tab-Kandidat auftaucht: **„Wird dieser Tab in drei Monaten noch hier sein, mit demselben Inhalt?“** Wenn nicht, ist es keine Struktur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un candidat à l'onglet se présente, demandez : **« Cet onglet sera-t-il encore là, avec le même contenu, dans trois mois ? »** Sinon, ce n'est pas de la structure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando salta fuori una candidata a scheda, chiediti: **«Questa scheda sarà ancora qui, con lo stesso contenuto, tra tre mesi?»** Se no, non è struttura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando surge uma candidata a aba, pergunte: **«Esta aba ainda estará aqui, com o mesmo conteúdo, daqui a três meses?»** Se não, não é estrutura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีผู้สมัครแท็บ ให้ถาม: **\"แท็บนี้จะยังอยู่ ด้วยเนื้อหาเดิม ในอีกสามเดือนไหม\"** ถ้าไม่ มันไม่ใช่โครงสร้าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có ứng viên tab, hãy hỏi: **\"Ba tháng nữa tab này có còn ở đây, với cùng nội dung không?\"** Nếu không, nó không phải cấu trúc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se objeví kandidát na kartu, zeptejte se: **„Bude tato karta za tři měsíce stále tady, se stejným obsahem?“** Pokud ne, není to struktura."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en fanekandidat dukker op, så spørg: **»Vil denne fane stadig være her, med det samme indhold, om tre måneder?«** Hvis ikke, er det ikke struktur."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν προκύπτει υποψήφια καρτέλα, ρώτα: **«Θα είναι αυτή η καρτέλα ακόμα εδώ, με το ίδιο περιεχόμενο, σε τρεις μήνες;»** Αν όχι, δεν είναι δομή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ehdolla on välilehti, kysy: **”Onko tämä välilehti edelleen täällä, samalla sisällöllä, kolmen kuukauden päästä?”** Jos ei, se ei ole rakenne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat kandidat tab muncul, tanyakan: **\"Apakah tab ini masih ada di sini, dengan konten yang sama, tiga bulan lagi?\"** Jika tidak, itu bukan struktur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en fanekandidat dukker opp, spør: **«Kommer denne fanen fortsatt til å være her, med samme innhold, om tre måneder?»** Hvis ikke, er det ikke struktur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag als er een tabkandidaat opkomt: **\"Is dit tabblad over drie maanden er nog, met dezelfde inhoud?\"** Zo niet, dan is het geen structuur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy pojawia się kandydat na kartę, zapytaj: **„Czy ta karta nadal będzie tu za trzy miesiące, z tą samą zawartością?”** Jeśli nie, to nie jest struktura."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När en flikkandidat dyker upp, fråga: **”Kommer den här fliken fortfarande att finnas här, med samma innehåll, om tre månader?”** Om inte är det inte struktur."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sekme adayı çıktığında sor: **“Bu sekme üç ay sonra hâlâ burada, aynı içerikle olacak mı?”** Olmayacaksa yapı değildir."
          }
        }
      }
    },
    "탭 후보가 생기면 그 탭의 **첫 화면**을 그려 본다. 그릴 것이 없으면 탭이 아니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a tab candidate comes up, sketch that tab's **first screen**. If there's nothing to sketch, it isn't a tab."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When a tab candidate comes up, sketch that tab's **first screen**. If there's nothing to sketch, it isn't a tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブの候補ができたら、そのタブの**最初の画面**を描いてみる。描くものがなければタブではない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现标签候选时，先画出那个标签的**第一屏**。画不出东西，就不是标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出現標籤候選時，先畫出那個標籤的**第一個畫面**。畫不出東西，就不是標籤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда появляется кандидат во вкладки, наметьте **первый экран** этой вкладки. Если рисовать нечего, это не вкладка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando surja una candidata a pestaña, esboza la **primera pantalla** de esa pestaña. Si no hay nada que esbozar, no es una pestaña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skizziere, wenn ein Tab-Kandidat auftaucht, den **ersten Bildschirm** dieses Tabs. Gibt es nichts zu skizzieren, ist es kein Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un candidat à l'onglet se présente, esquissez le **premier écran** de cet onglet. S'il n'y a rien à esquisser, ce n'est pas un onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando salta fuori una candidata a scheda, abbozza **la prima schermata** di quella scheda. Se non c'è nulla da abbozzare, non è una scheda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando surge uma candidata a aba, esboce **a primeira tela** dessa aba. Se não há nada para esboçar, não é uma aba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีผู้สมัครแท็บ ให้ร่าง**หน้าจอแรก**ของแท็บนั้น ถ้าไม่มีอะไรให้ร่าง มันไม่ใช่แท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi có ứng viên tab, hãy phác **màn hình đầu tiên** của tab đó. Nếu không có gì để phác, nó không phải tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se objeví kandidát na kartu, načrtněte **první obrazovku** té karty. Pokud není co načrtnout, není to karta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en fanekandidat dukker op, så skitsér den fanes **første skærm**. Hvis der ikke er noget at skitsere, er det ikke en fane."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν προκύπτει υποψήφια καρτέλα, σκιτσάρισε την **πρώτη οθόνη** της. Αν δεν έχεις τίποτα να σκιτσάρεις, δεν είναι καρτέλα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun ehdolla on välilehti, hahmottele sen välilehden **ensimmäinen näkymä**. Jos ei ole mitään hahmoteltavaa, se ei ole välilehti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat kandidat tab muncul, buat sketsa **layar pertama** tab itu. Jika tak ada yang bisa disketsa, itu bukan tab."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når en fanekandidat dukker opp, skisser den fanens **første skjerm**. Hvis det ikke er noe å skissere, er det ikke en fane."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schets als er een tabkandidaat opkomt het **eerste scherm** van dat tabblad. Als er niets te schetsen valt, is het geen tabblad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy pojawia się kandydat na kartę, naszkicuj **pierwszy ekran** tej karty. Jeśli nie ma czego szkicować, to nie jest karta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När en flikkandidat dyker upp, skissa den fliken **första skärm**. Om det inte finns något att skissa är det inte en flik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sekme adayı çıktığında o sekmenin **ilk ekranını** çiz. Çizilecek bir şey yoksa bir sekme değildir."
          }
        }
      }
    },
    "탭, 검색 역할, 액세서리, 최소화는 모두 시스템이 제공하는 좋은 기능이고, 조합해도 충돌하지 않도록 설계돼 있다. 하나씩 따져 보면 다 쓸 이유가 있다. 다 켜면 앱이 최신 시스템을 온전히 쓰는 것처럼 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs, the search role, the accessory, and minimizing are all good features the system provides, and they're designed not to conflict when combined. Considered one by one, each has a reason to be used. Turning them all on makes the app look like it's fully using the latest system."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs, the search role, the accessory, and minimising are all good features the system provides, and they're designed not to conflict when combined. Considered one by one, each has a reason to be used. Turning them all on makes the app look like it's fully using the latest system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブ、検索の役割、アクセサリ、最小化はどれもシステムが提供する良い機能で、組み合わせても衝突しないように設計されている。ひとつずつ考えれば、どれにも使う理由がある。全部オンにすれば、アプリが最新のシステムをフルに使っているように見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签、搜索 role、附件、最小化都是系统提供的好功能，也被设计成组合起来不冲突。逐个看，每个都有用它的理由。全部打开，应用似乎就完整地用上了最新系统。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤、搜尋 role、附件、最小化都是系統提供的好功能，也被設計成組合起來不衝突。逐個看，每個都有用它的理由。全部開啟，應用程式似乎就完整地用上了最新系統。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладки, роль поиска, accessory и минимизация - всё это хорошие возможности системы, и они задуманы так, чтобы не конфликтовать в сочетании. Если рассматривать по одной, у каждой есть причина для использования. Включите все, и приложение выглядит так, будто полностью использует новейшую систему."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas, el rol de búsqueda, el accesorio y la minimización son todas buenas funciones que ofrece el sistema, y están diseñadas para no chocar al combinarse. Consideradas una a una, cada una tiene un motivo para usarse. Activarlas todas hace que la app parezca aprovechar por completo el sistema más reciente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabs, die Suchrolle, das Accessory und das Minimieren sind alle gute Funktionen des Systems und so entworfen, dass sie sich in Kombination nicht stören. Einzeln betrachtet hat jede einen Grund zur Nutzung. Schaltet man alle ein, wirkt die App, als nutze sie das neueste System voll aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets, le rôle de recherche, l'accessoire et la réduction sont tous de bonnes fonctions fournies par le système, et ils sont conçus pour ne pas entrer en conflit une fois combinés. Considérés un par un, chacun a une raison d'être utilisé. Tous les activer donne à l'app l'air d'exploiter pleinement le système le plus récent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schede, ruolo search, accessorio e riduzione sono tutte ottime funzioni fornite dal sistema, e sono progettate per non entrare in conflitto quando combinate. Considerate una per una, ognuna ha un motivo per essere usata. Attivarle tutte fa sembrare che l'app sfrutti pienamente il sistema più recente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abas, papel search, acessório e minimização são todas ótimas funcionalidades que o sistema fornece, e foram projetadas para não entrar em conflito quando combinadas. Consideradas uma a uma, cada uma tem um motivo para ser usada. Ligar todas faz o app parecer que aproveita por completo o sistema mais recente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บ บทบาทค้นหา อุปกรณ์เสริม และการย่อ ล้วนเป็นฟีเจอร์ที่ดีที่ระบบให้ และออกแบบไม่ให้ชนกันเมื่อรวมกัน พิจารณาทีละอัน แต่ละอันมีเหตุผลที่จะใช้ เปิดทั้งหมดทำให้แอปดูเหมือนใช้ระบบล่าสุดเต็มที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab, vai trò tìm kiếm, phụ kiện và thu gọn đều là tính năng tốt mà hệ thống cung cấp, và chúng được thiết kế để không xung đột khi kết hợp. Xét từng cái, cái nào cũng có lý do để dùng. Bật hết lên khiến app trông như đang dùng trọn hệ thống mới nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty, role hledání, příslušenství a minimalizace jsou všechno dobré funkce, které systém poskytuje, a jsou navrženy tak, aby se při kombinaci nehádaly. Posuzováno po jednom má každá důvod k použití. Zapnout je všechny způsobí, že aplikace vypadá, jako by plně využívala nejnovější systém."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faner, søgerollen, tilbehøret og minimering er alle gode funktioner, systemet leverer, og de er designet til ikke at støde sammen, når de kombineres. Hver for sig har hver en grund til at blive brugt. At slå dem alle til får appen til at se ud, som om den udnytter det nyeste system fuldt ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καρτέλες, ο ρόλος αναζήτησης, το accessory και η ελαχιστοποίηση είναι όλα καλές λειτουργίες που παρέχει το σύστημα, και είναι σχεδιασμένες να μη συγκρούονται όταν συνδυάζονται. Εξεταζόμενη μία μία, η καθεμία έχει λόγο χρήσης. Αν τις ενεργοποιήσεις όλες, η εφαρμογή φαίνεται ότι αξιοποιεί πλήρως το πιο πρόσφατο σύστημα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välilehdet, hakuooli, accessory ja minimointi ovat kaikki hyviä järjestelmän tarjoamia ominaisuuksia, ja ne on suunniteltu niin, etteivät ne ole ristiriidassa yhdistettyinä. Yksi kerrallaan tarkasteltuna jokaisella on syynsä olla käytössä. Kaikkien kytkeminen päälle saa sovelluksen näyttämään siltä, että se hyödyntää täysin uusinta järjestelmää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab, role search, accessory, dan minimalisasi semuanya fitur bagus yang disediakan sistem, dan dirancang agar tidak berkonflik saat digabung. Dipertimbangkan satu per satu, masing-masing punya alasan untuk dipakai. Menyalakan semuanya membuat aplikasi tampak memakai sistem terbaru sepenuhnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Faner, search-rollen, accessoryen og minimering er alle gode funksjoner systemet tilbyr, og de er designet for ikke å komme i konflikt når de kombineres. Vurdert én etter én har hver en grunn til å brukes. Å slå dem alle på får appen til å se ut som den bruker det nyeste systemet fullt ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabbladen, de zoekrol, het accessoire en minimaliseren zijn allemaal goede functies die het systeem biedt, en ze zijn ontworpen om niet te botsen als ze worden gecombineerd. Een voor een bekeken heeft elk een reden om gebruikt te worden. Ze allemaal aanzetten laat de app eruitzien alsof hij het nieuwste systeem volledig benut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karty, rola wyszukiwania, akcesorium i minimalizowanie to dobre funkcje dostarczane przez system i zaprojektowane tak, by nie kolidowały po połączeniu. Rozważane pojedynczo, każda ma powód do użycia. Włączenie wszystkich sprawia, że aplikacja wygląda, jakby w pełni korzystała z najnowszego systemu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flikar, sökrollen, tillbehöret och minimering är alla bra funktioner som systemet tillhandahåller, och de är utformade för att inte krocka när de kombineras. Betraktade en och en har var och en ett skäl att användas. Att slå på alla får appen att se ut som att den fullt ut använder det senaste systemet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekmeler, arama rolü, aksesuar ve küçültmenin hepsi sistemin sağladığı iyi özelliklerdir ve birleştirildiklerinde çatışmayacak şekilde tasarlanmıştır. Tek tek ele alındığında her birinin kullanılması için bir neden vardır. Hepsini açmak uygulamanın en yeni sistemi tam anlamıyla kullandığı izlenimini verir."
          }
        }
      }
    },
    "탭·검색 캡슐·액세서리·최소화가 다 좋은 기능이라 전부 쓴다.": {
      "extractionState": "manual",
