        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Icono + **un título de una palabra**, la forma estándar de un elemento de pestaña"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol + **ein einwortiger Titel**, die Standardform eines Tab-Elements"
