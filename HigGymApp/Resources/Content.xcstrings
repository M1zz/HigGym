    "배경과 섞이지 않아 탁하고 죽은 색": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It never blends with the background, leaving a murky, lifeless color"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It never blends with the background, leaving a murky, lifeless colour"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景と混ざらず、濁った死んだ色"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不和背景混合，发浑、像死掉的颜色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不和背景混合，發渾、像死掉的顏色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не смешивается с фоном, оставляя мутный безжизненный цвет"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se mezcla con el fondo, dejando un color turbio y sin vida"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es vermischt sich nie mit dem Hintergrund und hinterlässt eine trübe, leblose Farbe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne se fond jamais avec l'arrière-plan, laissant une couleur trouble et sans vie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si fonde mai con lo sfondo, lasciando un colore torbido e senza vita"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se mistura com o fundo, deixando uma cor turva e sem vida"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันไม่เคยผสมกับพื้นหลัง เหลือสีขุ่นไร้ชีวิต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó không bao giờ hòa với nền, để lại một màu đục, vô hồn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdy se neslije s pozadím a zanechává kalnou, bezvládnou barvu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den blander sig aldrig med baggrunden og efterlader en mudret, livløs farve"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ανακατεύεται ποτέ με το φόντο, αφήνοντας ένα θολό, άψυχο χρώμα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei koskaan sekoitu taustaan, jättäen sameaan, elottoman värin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia tak pernah berpadu dengan latar, menyisakan warna kusam yang tak bernyawa"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den blander seg aldri med bakgrunnen og etterlater en sjusket, livløs farge"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vermengt nooit met de achtergrond en laat een troebele, levenloze kleur achter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie wtapia się w tło, zostawiając mętny, martwy kolor"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den blandar sig aldrig med bakgrunden och lämnar en grumlig, livlös färg"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planla hiç karışmaz, bulanık ve cansız bir renk bırakır"
          }
        }
      }
    },
    "배경을 어둡게 할지는 보기 좋음으로 정하지 않는다. 먼저 묻는다. \"지금 뒤를 만질 수 있나?\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't decide whether to dim the background based on looks. Ask first: \"Can the background be touched right now?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't decide whether to dim the background based on looks. Ask first: \"Can the background be touched right now?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景を暗くするかどうかは、見栄えで決めない。まず問う。「今、後ろに触れられるか？」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要不要把背景压暗，不凭好看来定。先问：“现在能操作后面吗？”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要不要把背景壓暗，不憑好看來定。先問：「現在能操作後面嗎？」"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решайте, затемнять ли фон, не по внешнему виду. Сначала спросите: «Можно ли сейчас трогать фон?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No decidas si atenuar el fondo según el aspecto. Pregunta primero: «¿Se puede tocar el fondo ahora mismo?»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheide nicht nach dem Aussehen, ob der Hintergrund abgedunkelt wird. Frage zuerst: „Kann der Hintergrund gerade berührt werden?“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne décidez pas d'assombrir l'arrière-plan d'après l'aspect. Demandez d'abord : « L'arrière-plan peut-il être touché en ce moment ? »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non decidere se oscurare lo sfondo in base all'aspetto. Chiediti prima: «Lo sfondo si può toccare adesso?»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não decida se escurece o fundo pela aparência. Pergunte primeiro: «O fundo pode ser tocado agora?»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าตัดสินว่าจะหรี่พื้นหลังจากหน้าตา ให้ถามก่อน: \"ตอนนี้แตะพื้นหลังได้ไหม\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng quyết định có làm tối nền theo vẻ ngoài. Hãy hỏi trước: \"Lúc này có chạm được nền không?\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nerozhodujte o ztmavení pozadí podle vzhledu. Zeptejte se nejdřív: „Dá se právě teď na pozadí sáhnout?“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beslut ikke om baggrunden skal dæmpes ud fra udseende. Spørg først: »Kan baggrunden røres lige nu?«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μην αποφασίζεις αν θα σκιάσεις το φόντο με βάση την εμφάνιση. Ρώτα πρώτα: «Μπορεί να αγγιχτεί το φόντο αυτή τη στιγμή;»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä päätä taustan himmentämisestä ulkonäön perusteella. Kysy ensin: ”Voiko taustaa koskea juuri nyt?”"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan memutuskan meredupkan latar berdasarkan tampilan. Tanyakan dulu: \"Bisakah latar disentuh sekarang?\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke avgjør om bakgrunnen skal dimmes ut fra utseende. Spør først: «Kan bakgrunnen røres akkurat nå?»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beslis niet op uiterlijk of de achtergrond wordt gedimd. Vraag eerst: \"Kan de achtergrond nu worden aangeraakt?\""
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie decyduj, czy przyciemnić tło, na podstawie wyglądu. Zapytaj najpierw: „Czy tło można teraz dotknąć?”"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avgör inte om bakgrunden ska tonas ner utifrån utseende. Fråga först: ”Går bakgrunden att röra just nu?”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planı karartıp karartmayacağına görünüşe bakarak karar verme. Önce sor: “Arka plana şu an dokunulabilir mi?”"
          }
        }
      }
    },
    "배경이 **확실히 단순·균일**해서 겹쳐도 가독성 문제가 없거나, 콘텐츠가 아예 바 뒤까지 도달하지 않는 레이아웃일 때만. **예외적 선택.**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when the background is **reliably simple and uniform**, so overlap causes no legibility problems, or when the layout never lets content reach behind the bar. **An exceptional choice.**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when the background is **reliably simple and uniform**, so overlap causes no legibility problems, or when the layout never lets content reach behind the bar. **An exceptional choice.**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が**確実にシンプルで均一**なので重なっても読みやすさに問題がないか、コンテンツがそもそもバーの後ろまで届かないレイアウトのときだけ。**例外的な選択。**"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当背景**确定简单、均匀**，叠在一起也没有可读性问题，或者内容根本不会到达栏后面的布局时。**例外选择。**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當背景**確定簡單、均勻**，疊在一起也沒有可讀性問題，或者內容根本不會到達列後面的佈局時。**例外選擇。**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только когда фон **заведомо прост и однороден**, так что наложение не вызывает проблем с читаемостью, или когда раскладка не допускает попадания контента за панель. **Исключительный выбор.**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuando el fondo es **sencillo y uniforme de forma fiable**, de modo que el solapamiento no causa problemas de legibilidad, o cuando el diseño nunca deja que el contenido llegue detrás de la barra. **Una elección excepcional.**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn der Hintergrund **verlässlich schlicht und gleichmäßig** ist, sodass Überlappung keine Lesbarkeitsprobleme verursacht, oder wenn das Layout Inhalt nie hinter die Leiste reichen lässt. **Eine Ausnahmewahl.**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement quand l'arrière-plan est **sûrement simple et uniforme**, si bien que le chevauchement ne pose aucun problème de lisibilité, ou quand la mise en page ne laisse jamais le contenu atteindre l'arrière de la barre. **Un choix exceptionnel.**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quando lo sfondo è **sicuramente semplice e uniforme**, così la sovrapposizione non crea problemi di leggibilità, o quando il layout non permette mai al contenuto di arrivare dietro la barra. **Una scelta eccezionale.**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quando o fundo é **sabidamente simples e uniforme**, de modo que a sobreposição não cause problemas de legibilidade, ou quando o layout nunca deixa o conteúdo chegar atrás da barra. **Uma escolha excepcional.**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเมื่อพื้นหลัง**เรียบและสม่ำเสมออย่างแน่นอน** การทับซ้อนจึงไม่ทำให้อ่านออกยาก หรือเมื่อเลย์เอาต์ไม่ให้เนื้อหาไปอยู่ด้านหลังแถบเลย **ตัวเลือกพิเศษ**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khi nền **chắc chắn đơn giản và đồng nhất**, nên chồng lấn không gây vấn đề dễ đọc, hoặc khi bố cục không bao giờ để nội dung chạm tới phía sau thanh. **Một lựa chọn ngoại lệ.**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen když je pozadí **spolehlivě jednoduché a jednotné**, takže překryv nezpůsobuje problémy s čitelností, nebo když rozvržení nikdy nenechá obsah dosáhnout za panel. **Výjimečná volba.**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun når baggrunden er **pålideligt enkel og ensartet**, så overlap ikke giver læselighedsproblemer, eller når layoutet aldrig lader indhold nå bag bjælken. **Et undtagelsesvalg.**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο όταν το φόντο είναι **αξιόπιστα απλό και ομοιόμορφο**, ώστε η επικάλυψη να μην προκαλεί προβλήματα αναγνωσιμότητας, ή όταν η διάταξη δεν αφήνει ποτέ το περιεχόμενο να φτάσει πίσω από τη γραμμή. **Μια εξαιρετική επιλογή.**"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain kun tausta on **luotettavasti yksinkertainen ja tasainen**, jolloin päällekkäisyys ei aiheuta luettavuusongelmia, tai kun asettelu ei koskaan päästä sisältöä palkin taakse. **Poikkeuksellinen valinta.**"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya saat latarnya **pasti sederhana dan seragam**, sehingga tumpang tindih tak menimbulkan masalah keterbacaan, atau saat tata letak tak pernah membiarkan konten sampai ke belakang bilah. **Pilihan yang luar biasa.**"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare når bakgrunnen er **pålitelig enkel og ensartet**, slik at overlapping ikke skaper lesbarhetsproblemer, eller når layouten aldri lar innhold nå bak linjen. **Et eksepsjonelt valg.**"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen wanneer de achtergrond **betrouwbaar eenvoudig en uniform** is, zodat overlap geen leesbaarheidsproblemen veroorzaakt, of wanneer de layout inhoud nooit achter de balk laat komen. **Een uitzonderlijke keuze.**"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko gdy tło jest **niezawodnie proste i jednolite**, więc nakładanie nie powoduje problemów z czytelnością, lub gdy układ nigdy nie pozwala treści sięgnąć za pasek. **Wyjątkowy wybór.**"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara när bakgrunden är **pålitligt enkel och enhetlig**, så överlappning inte orsakar läsbarhetsproblem, eller när layouten aldrig låter innehåll nå bakom fältet. **Ett undantagsval.**"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca arka plan **güvenilir biçimde sade ve tekdüze** olduğunda, böylece üst üste binme okunabilirlik sorunu yaratmıyorsa ya da düzen içeriğin çubuğun arkasına ulaşmasına hiç izin vermiyorsa. **İstisnai bir tercih.**"
          }
        }
      }
    },
    "배경이 비쳐도 판 유지": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a solid plane even as the background shows through"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a solid plane even as the background shows through"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が透けても面が保たれる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出时保持底板"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出時保持底板"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет сплошную плоскость, даже когда фон просвечивает"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene un plano sólido aunque el fondo se transparente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält eine feste Fläche, auch wenn der Hintergrund durchscheint"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde un plan uni même lorsque l'arrière-plan transparaît"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene un piano pieno anche mentre lo sfondo traspare"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém um plano sólido mesmo com o fundo transparecendo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คงพื้นผิวทึบไว้แม้พื้นหลังมองทะลุ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ một mặt phẳng đặc ngay cả khi nền lộ ra"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drží jednolitou plochu, i když pozadí prosvítá"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevarer en massiv flade, selv mens baggrunden skinner igennem"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διατηρεί ένα συμπαγές επίπεδο ακόμα και καθώς το φόντο διαφαίνεται"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilyttää yhtenäisen tason, vaikka tausta näkyy läpi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mempertahankan bidang solid meski latar terlihat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholder et massivt plan selv når bakgrunnen skinner gjennom"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt een effen vlak, ook als de achtergrond doorschemert"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymuje jednolitą płaszczyznę, nawet gdy tło prześwituje"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåller en massiv yta även medan bakgrunden lyser igenom"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan görünse bile düz bir yüzey korur"
          }
        }
      }
    },
    "배경이 비쳐서 안 읽히길래 색을 깔아 대비를 직접 확보한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background shows through and makes it hard to read, so you lay down a color to secure contrast yourself."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The background shows through and makes it hard to read, so you lay down a colour to secure contrast yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が透けて読みにくいので、色を敷いて自分でコントラストを確保する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出来读不清，于是铺上颜色，自己保证对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出來讀不清，於是鋪上顏色，自己保證對比度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон просвечивает и мешает читать, поэтому вы заливаете цвет, чтобы самому обеспечить контраст."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo se transparenta y dificulta la lectura, así que pones un color tú mismo para asegurar el contraste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrund scheint durch und erschwert das Lesen, also legst du selbst eine Farbe darüber, um Kontrast zu sichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arrière-plan transparaît et gêne la lecture, donc vous posez vous-même une couleur pour garantir le contraste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sfondo traspare e rende difficile la lettura, quindi stendi un colore per garantire da solo il contrasto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fundo transparece e dificulta a leitura, então você estende uma cor para garantir o contraste por conta própria."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นหลังมองทะลุและอ่านยาก คุณจึงวางสีเพื่อรักษาความตัดกันเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nền lộ ra khiến khó đọc, nên bạn phủ một màu để tự đảm bảo độ tương phản."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadí prosvítá a špatně se čte, tak položíte barvu, abyste si kontrast zajistili sami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrunden skinner igennem og gør det svært at læse, så du lægger en farve ned for selv at sikre kontrasten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φόντο διαφαίνεται και δυσκολεύει την ανάγνωση, οπότε στρώνεις ένα χρώμα για να εξασφαλίσεις μόνος σου την αντίθεση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tausta näkyy läpi ja tekee lukemisesta vaikeaa, joten laitat värin varmistaaksesi kontrastin itse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latar terlihat tembus dan menyulitkan membaca, jadi kamu menaruh warna untuk mengamankan kontras sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnen skinner gjennom og gjør det vanskelig å lese, så du legger på en farge for å sikre kontrast selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De achtergrond schemert door en maakt het moeilijk te lezen, dus je legt zelf een kleur neer om contrast te garanderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tło prześwituje i utrudnia czytanie, więc sam kładziesz kolor, by zapewnić kontrast."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunden lyser igenom och gör det svårt att läsa, så du lägger på en färg för att själv säkra kontrasten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan görünüyor ve okumayı zorlaştırıyor, bu yüzden kontrastı sağlamak için kendin bir renk serersin."
          }
        }
      }
    },
    "배경이 비쳐서 안 읽히니 색을 깔아 대비를 직접 확보하는 게 가장 빠르다. 눈앞의 화면에서는 문제가 바로 사라진다. 대비 문제를 스스로 해결했다고 느끼기 쉽다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background shows through and the text is hard to read, so laying down a color to secure contrast yourself is the quickest fix. On the screen in front of you, the problem vanishes immediately. It's easy to feel you've solved the contrast problem on your own."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The background shows through and the text is hard to read, so laying down a colour to secure contrast yourself is the quickest fix. On the screen in front of you, the problem vanishes immediately. It's easy to feel you've solved the contrast problem on your own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が透けて読めないのだから、色を敷いて自分でコントラストを確保するのがいちばん早い。目の前の画面では、問題がすぐに消える。コントラストの問題を自分で解決したと感じやすい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出来读不清，铺上颜色亲手保证对比度是最快的。眼前的界面里，问题立刻消失。很容易觉得自己解决了对比度问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景透出來讀不清，鋪上顏色親手保證對比度是最快的。眼前的介面裡，問題立刻消失。很容易覺得自己解決了對比度問題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон просвечивает, читать трудно, поэтому быстрее всего залить цвет и самому обеспечить контраст. На экране перед вами проблема исчезает сразу. Легко почувствовать, что вы решили проблему контраста самостоятельно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fondo se transparenta y el texto cuesta de leer, así que poner un color tú mismo para asegurar el contraste es el arreglo más rápido. En la pantalla que tienes delante, el problema desaparece al instante. Es fácil sentir que has resuelto el problema de contraste por tu cuenta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrund scheint durch und der Text ist schwer lesbar, also ist eine selbst darübergelegte Farbe zur Kontrastsicherung die schnellste Lösung. Auf dem Bildschirm vor dir verschwindet das Problem sofort. Man hat leicht das Gefühl, das Kontrastproblem allein gelöst zu haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arrière-plan transparaît et le texte est difficile à lire, donc poser vous-même une couleur pour garantir le contraste est la solution la plus rapide. Sur l'écran que vous avez devant vous, le problème disparaît aussitôt. On a facilement l'impression d'avoir résolu seul le problème de contraste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo sfondo traspare e il testo è difficile da leggere, quindi stendere un colore per garantire da soli il contrasto è il rimedio più rapido. Sulla schermata che hai davanti, il problema svanisce subito. È facile sentirsi di aver risolto da soli il problema del contrasto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fundo transparece e o texto fica difícil de ler, então estender uma cor para garantir o contraste por conta própria é o remédio mais rápido. Na tela que está à sua frente, o problema some de imediato. É fácil sentir que você resolveu sozinho o problema do contraste."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นหลังมองทะลุและข้อความอ่านยาก การวางสีเพื่อรักษาความตัดกันเองจึงเป็นวิธีแก้ที่เร็วที่สุด บนหน้าจอตรงหน้าคุณ ปัญหาหายไปทันที จึงรู้สึกได้ง่ายว่าคุณแก้ปัญหาความตัดกันได้เอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nền lộ ra và chữ khó đọc, nên tự phủ một màu để bảo đảm độ tương phản là cách sửa nhanh nhất. Trên màn hình trước mặt, vấn đề biến mất ngay. Dễ cảm thấy bạn đã tự giải quyết được bài toán tương phản."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadí prosvítá a text se špatně čte, takže položit barvu a zajistit kontrast sami je nejrychlejší oprava. Na obrazovce před vámi problém okamžitě zmizí. Snadno máte pocit, že jste problém kontrastu vyřešili sami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrunden skinner igennem, og teksten er svær at læse, så at lægge en farve ned for selv at sikre kontrasten er den hurtigste løsning. På skærmen foran dig forsvinder problemet med det samme. Det er let at føle, at du selv har løst kontrastproblemet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φόντο διαφαίνεται και το κείμενο είναι δύσκολο να διαβαστεί, οπότε το να στρώσεις ένα χρώμα για να εξασφαλίσεις μόνος σου την αντίθεση είναι η γρηγορότερη λύση. Στην οθόνη μπροστά σου, το πρόβλημα εξαφανίζεται αμέσως. Είναι εύκολο να νιώσεις ότι έλυσες μόνος σου το πρόβλημα αντίθεσης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tausta näkyy läpi ja teksti on vaikealukuista, joten värin laittaminen kontrastin varmistamiseksi itse on nopein korjaus. Edessäsi olevalla näytöllä ongelma häviää heti. On helppo tuntea ratkaisseensa kontrastiongelman yksin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latar terlihat tembus dan teks sulit dibaca, jadi menaruh warna untuk mengamankan kontras sendiri adalah perbaikan tercepat. Di layar di depanmu, masalahnya langsung hilang. Mudah merasa kamu sudah menyelesaikan masalah kontras sendirian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnen skinner gjennom og teksten er vanskelig å lese, så å legge på en farge for å sikre kontrast selv er den raskeste løsningen. På skjermen foran deg forsvinner problemet umiddelbart. Det er lett å føle at du har løst kontrastproblemet på egen hånd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De achtergrond schemert door en de tekst is moeilijk te lezen, dus zelf een kleur neerleggen om contrast te garanderen is de snelste oplossing. Op het scherm voor je verdwijnt het probleem meteen. Het is makkelijk te voelen dat je het contrastprobleem zelf hebt opgelost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tło prześwituje, a tekst trudno czytać, więc położenie koloru własnoręcznie dla zapewnienia kontrastu to najszybsza poprawka. Na ekranie przed tobą problem znika od razu. Łatwo poczuć, że rozwiązałeś problem kontrastu samodzielnie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunden lyser igenom och texten är svår att läsa, så att lägga på en färg för att själv säkra kontrasten är den snabbaste lösningen. På skärmen framför dig försvinner problemet direkt. Det är lätt att känna att du har löst kontrastproblemet på egen hand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan görünüyor ve metin zor okunuyor, bu yüzden kontrastı kendin sağlamak için bir renk serersin: en hızlı çözüm bu. Karşındaki ekranda sorun hemen kaybolur. Kontrast sorununu kendi başına çözdüğünü hissetmek kolaydır."
          }
        }
      }
    },
    "배경이 이미 어둡고 잔잔하면 soft로 충분하다. 방어는 필요한 곳에만.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the background is already dark and calm, soft is enough. Defend only where defense is needed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If the background is already dark and calm, soft is enough. Defend only where defence is needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景がすでに暗く穏やかなら、soft で十分だ。守りは必要な場所にだけ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景本来就暗而平静的话，soft 就够了。防护只放在需要的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景本來就暗而平靜的話，soft 就夠了。防護只放在需要的地方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если фон уже тёмный и спокойный, достаточно soft. Защищайте только там, где защита нужна."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el fondo ya es oscuro y tranquilo, soft basta. Defiende solo donde haga falta defensa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist der Hintergrund schon dunkel und ruhig, genügt soft. Verteidige nur dort, wo Verteidigung nötig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'arrière-plan est déjà sombre et calme, soft suffit. Ne défendez que là où une défense est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo sfondo è già scuro e calmo, soft basta. Difendi solo dove serve difendere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o fundo já é escuro e calmo, soft basta. Defenda só onde a defesa é necessária."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าพื้นหลังมืดและสงบอยู่แล้ว soft ก็พอ ป้องกันเฉพาะที่ต้องป้องกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu nền vốn tối và êm, soft là đủ. Chỉ bảo vệ nơi cần bảo vệ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je pozadí už tmavé a klidné, soft stačí. Braňte jen tam, kde je obrana potřeba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis baggrunden allerede er mørk og rolig, er soft nok. Forsvar kun, hvor der er brug for forsvar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν το φόντο είναι ήδη σκοτεινό και ήρεμο, το soft αρκεί. Προστάτευσε μόνο εκεί που χρειάζεται προστασία."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos tausta on jo tumma ja rauhallinen, soft riittää. Puolusta vain siellä, missä puolustusta tarvitaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika latarnya sudah gelap dan tenang, soft sudah cukup. Bela hanya di tempat yang butuh pembelaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis bakgrunnen allerede er mørk og rolig, er soft nok. Forsvar bare der forsvar trengs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de achtergrond al donker en rustig is, is zacht genoeg. Verdedig alleen waar verdediging nodig is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli tło jest już ciemne i spokojne, soft wystarczy. Broń tylko tam, gdzie obrona jest potrzebna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om bakgrunden redan är mörk och lugn räcker soft. Försvara bara där försvar behövs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan zaten koyu ve sakinse soft yeter. Yalnızca savunmanın gerektiği yerde savun."
          }
        }
      }
    },
    "배경이 확실히 균일한 단색 화면": {
