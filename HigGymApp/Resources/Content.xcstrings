          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้านล่างที่แออัด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần dưới quá tải"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přeplněný spodek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En overfyldt bund"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα υπερφορτωμένο κάτω μέρος"
          }
        }
      }
    },
    "하단 바 전체가 상시 세로 공간을 차지하지만 기여하는 건 버튼 하나. \"기여하지 않는 순간에도 화면을 점유\"하는 기준 위반": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole bottom bar permanently takes up vertical space, yet only one button contributes. A violation of the criterion: \"occupying the screen even in moments when it contributes nothing\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole bottom bar permanently takes up vertical space, yet only one button contributes. A violation of the criterion: \"occupying the screen even in moments when it contributes nothing\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバー全体が常に縦のスペースを占めるのに、貢献しているのはボタンひとつ。「貢献しない瞬間にも画面を占有する」という基準違反"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个底部栏常驻占用纵向空间，起作用的却只有一个按钮：违反“没有贡献的时刻也占用界面”的标准"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整個底部列常駐佔用縱向空間，起作用的卻只有一個按鈕：違反「沒有貢獻的時刻也佔用介面」的標準"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся нижняя панель постоянно занимает вертикальное место, а полезна только одна кнопка. Нарушение критерия: «занимает экран даже в моменты, когда ничего не даёт»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la barra inferior ocupa permanentemente espacio vertical, pero solo un botón aporta. Una violación del criterio: «ocupar la pantalla incluso en momentos en que no aporta nada»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ganze untere Leiste belegt dauerhaft vertikalen Platz, doch nur ein Button trägt bei. Ein Verstoß gegen das Kriterium: „den Bildschirm auch in Momenten belegen, in denen sie nichts beiträgt“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute la barre du bas occupe en permanence de l'espace vertical, pourtant un seul bouton contribue. Une violation du critère : « occuper l'écran même aux moments où elle n'apporte rien »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intera barra in basso occupa spazio verticale in permanenza, eppure contribuisce un solo pulsante. Una violazione del criterio: «occupare lo schermo anche nei momenti in cui non si contribuisce a nulla»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra inferior inteira ocupa espaço vertical permanentemente, mas só um botão contribui. Uma violação do critério: «ocupar a tela até nos momentos em que não contribui com nada»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งแถบล่างกินพื้นที่แนวตั้งถาวร แต่มีปุ่มเดียวที่ช่วยงาน ฝ่าฝืนเกณฑ์: \"กินหน้าจอแม้ในจังหวะที่ไม่ช่วยอะไร\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả thanh dưới chiếm vĩnh viễn chiều dọc, vậy mà chỉ có một nút đóng góp. Vi phạm tiêu chí: \"chiếm màn hình ngay cả những lúc không đóng góp gì\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý spodní panel trvale zabírá svislé místo, a přesto přispívá jen jedno tlačítko. Porušení kritéria: „zabírá obrazovku i ve chvílích, kdy nepřispívá ničím“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele den nederste bjælke optager permanent lodret plads, men kun én knap bidrager. En overtrædelse af kriteriet: »at optage skærmen selv i øjeblikke, hvor den intet bidrager med«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολόκληρη η κάτω γραμμή καταλαμβάνει μόνιμα κάθετο χώρο, ενώ συμβάλλει μόνο ένα κουμπί. Παραβίαση του κριτηρίου: «καταλαμβάνει την οθόνη ακόμα και στις στιγμές που δεν συμβάλλει σε τίποτα»"
          }
        }
      }
    },
    "하단 바는 단순 버튼 줄이 아니라 **\"현재 페이지의 콕핏\"**이라는 설계 관점. 자주 보는 정보와 자주 쓰는 조작을 엄지 근처 한 곳에 모으는 것, reachability를 정보에까지 확장한 것.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A design view in which the bottom bar is not just a row of buttons but **\"the cockpit of the current page.\"** It gathers the information you check often and the controls you use often in one place near the thumb, extending reachability to information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A design view in which the bottom bar is not just a row of buttons but **\"the cockpit of the current page.\"** It gathers the information you check often and the controls you use often in one place near the thumb, extending reachability to information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーは単なるボタンの列ではなく、**「今のページのコックピット**」だという設計の視点。よく見る情報とよく使う操作を親指の近くの一か所に集めること、つまりreachabilityを情報にまで広げたもの。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部栏不是简单的按钮行，而是**“当前页面的驾驶舱”**这一设计视角。把常看的信息和常用的操作汇集到拇指附近的一处，是把可触达性扩展到了信息上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "底部列不是簡單的按鈕行，而是**「當前頁面的駕駛艙」**這一設計視角。把常看的資訊和常用的操作匯集到拇指附近的一處，是把可觸達性擴充套件到了資訊上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взгляд на дизайн, при котором нижняя панель - не просто ряд кнопок, а **«кабина текущей страницы»**. Она собирает в одном месте у большого пальца информацию, которую проверяют часто, и элементы, которыми пользуются часто, распространяя досягаемость на информацию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una visión del diseño en la que la barra inferior no es solo una fila de botones sino **«la cabina de la página actual».** Reúne en un solo sitio cerca del pulgar la información que consultas a menudo y los controles que usas a menudo, ampliando el alcance a la información."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Designsicht, in der die untere Leiste nicht nur eine Reihe von Buttons ist, sondern **„das Cockpit der aktuellen Seite“.** Sie sammelt die oft geprüften Informationen und die oft genutzten Steuerelemente an einem Ort nahe am Daumen und dehnt die Erreichbarkeit auf Information aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vision du design où la barre du bas n'est pas seulement une rangée de boutons mais **« le cockpit de la page actuelle ».** Elle rassemble les informations que vous consultez souvent et les contrôles que vous utilisez souvent à un endroit près du pouce, étendant l'accessibilité à l'information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una visione del design in cui la barra in basso non è solo una riga di pulsanti ma **«la cabina di pilotaggio della pagina attuale».** Raccoglie in un posto vicino al pollice le informazioni che controlli spesso e i controlli che usi spesso, estendendo la raggiungibilità alle informazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma visão de design em que a barra inferior não é só uma fileira de botões mas **«a cabine de comando da página atual».** Reúne num lugar perto do polegar as informações que você confere muito e os controles que usa muito, estendendo o alcance à informação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุมมองการออกแบบที่แถบล่างไม่ใช่แค่แถวปุ่มแต่เป็น**\"ห้องนักบินของหน้าปัจจุบัน\"** มันรวบรวมข้อมูลที่ตรวจบ่อยและตัวควบคุมที่ใช้บ่อยไว้ที่เดียวใกล้นิ้วโป้ง ขยายการเอื้อมถึงไปยังข้อมูล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một quan điểm thiết kế coi thanh dưới không chỉ là hàng nút mà là **\"buồng lái của trang hiện tại.\"** Nó gom thông tin bạn kiểm tra thường xuyên và điều khiển bạn dùng thường xuyên vào một chỗ gần ngón cái, mở rộng khả năng với tới sang cả thông tin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Designový pohled, v němž spodní panel není jen řada tlačítek, ale **„kokpit aktuální stránky“.** Shromažďuje informace, které často kontrolujete, a ovladače, které často používáte, na jednom místě u palce a rozšiřuje dosah i na informace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et designsyn, hvor den nederste bjælke ikke blot er en række knapper men **»cockpittet på den aktuelle side.«** Det samler den information, du ofte tjekker, og de kontroller, du ofte bruger, ét sted nær tommelfingeren og udvider rækkevidden til information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια άποψη σχεδιασμού όπου η κάτω γραμμή δεν είναι απλώς μια σειρά κουμπιών αλλά **«το πιλοτήριο της τρέχουσας σελίδας».** Συγκεντρώνει τις πληροφορίες που ελέγχεις συχνά και τους ελέγχους που χρησιμοποιείς συχνά σε ένα σημείο κοντά στον αντίχειρα, επεκτείνοντας την προσβασιμότητα και στην πληροφορία."
          }
        }
      }
    },
    "하단 바는 조작을 위한 콕핏이다. 프로모션은 콘텐츠 흐름 안으로 넣는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bottom bar is a cockpit for controls. Put promotions inside the flow of content."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The bottom bar is a cockpit for controls. Put promotions inside the flow of content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーは操作のためのコックピットだ。プロモーションはコンテンツの流れの中に入れる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部栏是用来操作的驾驶舱。促销要放进内容流里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "底部列是用來操作的駕駛艙。促銷要放進內容流裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижняя панель - кабина для элементов управления. Акции размещайте внутри потока содержимого."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra inferior es una cabina de controles. Pon las promociones dentro del flujo del contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die untere Leiste ist ein Cockpit für Steuerelemente. Setze Aktionen in den Fluss des Inhalts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre du bas est un cockpit pour les contrôles. Mettez les promotions dans le fil du contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra in basso è una cabina di pilotaggio per i controlli. Metti le promozioni dentro il flusso del contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra inferior é uma cabine de comando para controles. Ponha as promoções dentro do fluxo de conteúdo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบล่างคือห้องนักบินของตัวควบคุม วางโปรโมชันในกระแสเนื้อหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh dưới là buồng lái của điều khiển. Đặt khuyến mãi trong dòng nội dung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spodní panel je kokpit ovladačů. Propagace dávejte do toku obsahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nederste bjælke er et cockpit for kontroller. Læg reklamer inde i indholdets flow."
