        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommendations and charts inside the search tab"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索タブの中におすすめやランキングのコンテンツ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
