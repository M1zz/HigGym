    "safeAreaBar로 얹으면 콘텐츠가 알아서 비켜난다. 그 자동 인셋이 이 API의 전부다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach it with safeAreaBar and the content moves out of the way on its own. That automatic inset is the whole point of this API."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach it with safeAreaBar and the content moves out of the way on its own. That automatic inset is the whole point of this API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "safeAreaBarで載せれば、コンテンツは自動でよけてくれる。その自動インセットこそがこのAPIのすべてだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 safeAreaBar 叠加，内容会自动让开。这个自动内边距就是这个 API 的全部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 safeAreaBar 疊加，內容會自動讓開。這個自動內邊距就是這個 API 的全部。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите через safeAreaBar, и контент сам отодвинется. Этот автоматический отступ и есть вся суть данного API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únela con safeAreaBar y el contenido se aparta solo. Ese margen automático es todo el sentido de esta API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hänge es mit safeAreaBar an, und der Inhalt weicht von selbst aus. Dieser automatische Einzug ist der ganze Sinn dieser API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachez-le avec safeAreaBar et le contenu s'écarte tout seul. Ce décalage automatique est tout l'intérêt de cette API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggancia con safeAreaBar e il contenuto si sposta da solo. Quello spostamento automatico è l'intero punto di questa API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe com safeAreaBar e o conteúdo sai do caminho sozinho. Esse recuo automático é todo o sentido desta API."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผูกด้วย safeAreaBar แล้วเนื้อหาจะเลี่ยงออกไปเอง การเว้นระยะอัตโนมัตินั้นคือประเด็นทั้งหมดของ API นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gắn bằng safeAreaBar và nội dung tự dời đi. Phần đệm tự động đó là toàn bộ ý nghĩa của API này."
          }
        },
        "cs": {
