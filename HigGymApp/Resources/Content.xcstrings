        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgning er appens kerne, men den sidder i en skuffe, der forsvinder ved scroll"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση είναι ο πυρήνας της εφαρμογής, κι όμως βρίσκεται σε συρτάρι που εξαφανίζεται στην κύλιση"
          }
        }
      }
    },
    "결제 바 + 도움말 버튼": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A checkout bar + a help button"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A checkout bar + a help button"
          }
        },
        "ja": {
          "stringUnit": {
