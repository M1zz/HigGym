          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Centro exacto (principal)**: el sitio del título lo ocupa el control que define la pantalla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Genau in der Mitte (principal)**: Die Titelstelle wird von dem Steuerelement übernommen, das den Bildschirm definiert"
