    "재료를 쓰면 뒤 콘텐츠의 흐름이 이어진다. 단색은 화면을 둘로 자른다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a material, the content behind keeps flowing. A solid color cuts the screen in two."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With a material, the content behind keeps flowing. A solid colour cuts the screen in two."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マテリアルを使えば、背後のコンテンツの流れがつながる。単色は画面を2つに切り分ける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用材质的话，后面内容的流动是连续的。纯色则把界面切成两半。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用材質的話，後面內容的流動是連續的。純色則把介面切成兩半。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С материалом содержимое позади продолжает течь. Сплошной цвет режет экран надвое."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un material, el contenido de detrás sigue fluyendo. Un color sólido corta la pantalla en dos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Material fließt der Inhalt dahinter weiter. Eine Vollfarbe schneidet den Bildschirm in zwei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un matériau, le contenu derrière continue de défiler. Une couleur unie coupe l'écran en deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un materiale, il contenuto dietro continua a scorrere. Un colore pieno taglia la schermata in due."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um material, o conteúdo atrás continua fluindo. Uma cor sólida corta a tela em duas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กับวัสดุ เนื้อหาด้านหลังยังไหลต่อ สีทึบตัดหน้าจอเป็นสอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với vật liệu, nội dung phía sau tiếp tục chảy. Màu đặc cắt màn hình làm đôi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S materiálem obsah vzadu dál plyne. Jednolitá barva rozřízne obrazovku na dvě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med et materiale bliver indholdet bagved ved med at flyde. En ensfarvet flade skærer skærmen over."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ένα υλικό, το περιεχόμενο πίσω συνεχίζει να ρέει. Ένα συμπαγές χρώμα κόβει την οθόνη στα δύο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Materiaalilla takana oleva sisältö jatkaa virtaamistaan. Yhtenäinen väri katkaisee näkymän kahtia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan material, konten di belakang terus mengalir. Warna solid membelah layar menjadi dua."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med et material fortsetter innholdet bak å flyte. En ensfarget farge kutter skjermen i to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een materiaal blijft de inhoud erachter stromen. Een effen kleur snijdt het scherm in tweeën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z materiałem treść z tyłu wciąż płynie. Jednolity kolor tnie ekran na dwoje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med ett material fortsätter innehållet bakom att flöda. En massiv färg skär skärmen i två."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir malzemeyle arkadaki içerik akmaya devam eder. Düz bir renk ekranı ikiye böler."
          }
        }
      }
    },
    "재생 대기열 패널 .height(250)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
