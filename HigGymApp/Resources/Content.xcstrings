            "value": "Quattro icone a contorno dall'aspetto simile allineate senza etichette"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro ícones de contorno de aparência parecida alinhados sem rótulos"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนเส้นขอบหน้าตาคล้ายกันสี่อันเรียงโดยไม่มีป้ายชื่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn biểu tượng viền trông giống nhau xếp hàng không có nhãn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtyři podobně vypadající obrysové ikony seřazené bez popisků"
          }
        },
        "da": {
          "stringUnit": {
