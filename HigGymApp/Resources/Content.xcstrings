        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft em telas em que as seções importam, como tabelas e grades"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft บนหน้าจอที่ส่วนต่าง ๆ สำคัญ เช่นตารางและกริด"
