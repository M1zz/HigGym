          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".fullScreenCover: закрывает **весь экран** и не закрывается смахиванием вниз."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
