    "아이템 우상단에 **빨간 숫자 배지** (.badge(3)), 미처리 항목 개수.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A **red numeric badge** at the item's top right (.badge(3)), showing the number of unhandled items."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A **red numeric badge** at the item's top right (.badge(3)), showing the number of unhandled items."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目の右上に**赤い数字のバッジ**（.badge(3)）。未処理の件数。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目右上角的**红色数字角标**（.badge(3)），未处理项目的数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目右上角的**紅色數字標記**（.badge(3)），未處理項目的數量。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Красный числовой бейдж** справа вверху элемента (.badge(3)), показывающий число необработанных элементов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una **insignia numérica roja** arriba a la derecha del elemento (.badge(3)), que muestra el número de elementos sin atender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein **rotes Zahlen-Badge** oben rechts am Element (.badge(3)), das die Zahl der unerledigten Punkte zeigt."
          }
