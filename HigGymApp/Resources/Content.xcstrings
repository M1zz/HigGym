            "state": "translated",
            "value": "Eine Aktion, also eine Form"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une action, donc une forme"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'azione, una forma"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ação, uma forma"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำเดียว รูปทรงเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một hành động, nên một hình"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna akce, tedy jeden tvar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én handling, så én form"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μία ενέργεια, άρα ένα σχήμα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi toiminto, yksi muoto"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu aksi, jadi satu bentuk"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én handling, så én form"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén actie, dus één vorm"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna akcja, więc jeden kształt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En åtgärd, en form"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek eylem, bu yüzden tek biçim"
          }
        }
      }
    },
    "액션이 하나뿐인데 공유·별표 같은 장식용 버튼을 억지로 추가해 캡슐을 채움": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is only one action, but decorative buttons like Share and Star are forced in to fill out the capsule"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There is only one action, but decorative buttons like Share and Star are forced in to fill out the capsule"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションはひとつなのに、共有やスターのような飾りのボタンを無理に足してカプセルを埋めている"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明明只有一个操作，却硬加分享 · 星标这样的装饰按钮来填满胶囊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明明只有一個操作，卻硬加分享 · 星標這樣的裝飾按鈕來填滿膠囊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие только одно, но чтобы заполнить капсулу, втиснуты декоративные кнопки вроде «Поделиться» и «Звезда»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hay una acción, pero se fuerzan botones decorativos como Compartir y Destacar para rellenar la cápsula"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nur eine Aktion, aber dekorative Buttons wie Teilen und Stern werden hineingezwängt, um die Kapsel zu füllen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a qu'une action, mais des boutons décoratifs comme Partager et Favori sont forcés pour remplir la capsule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è una sola azione, ma pulsanti decorativi come Condividi e Preferiti vengono infilati a forza per riempire la capsula"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há só uma ação, mas botões decorativos como Compartilhar e Favorito são enfiados à força para encher a cápsula"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการกระทำเดียว แต่ปุ่มตกแต่งอย่างแชร์และติดดาวถูกยัดเข้ามาเติมแคปซูล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có một hành động, nhưng các nút trang trí như Chia sẻ và Gắn sao bị ép vào để lấp đầy capsule"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tu jen jedna akce, ale dekorativní tlačítka jako Sdílet a Hvězdička jsou nasilu vložena, aby vyplnila kapsli"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er kun én handling, men dekorative knapper som Del og Stjerne er tvunget ind for at fylde kapslen ud"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει μόνο μία ενέργεια, αλλά διακοσμητικά κουμπιά όπως Κοινοποίηση και Αστέρι αναγκάζονται να μπουν για να γεμίσουν την κάψουλα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toimintoja on vain yksi, mutta koristepainikkeet, kuten Jaa ja Tähti, pakotetaan sisään kapselin täyttämiseksi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ada satu aksi, tetapi tombol dekoratif seperti Bagikan dan Bintang dipaksakan untuk mengisi kapsul"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er bare én handling, men dekorative knapper som Del og Stjerne presses inn for å fylle ut kapselen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is maar één actie, maar decoratieve knoppen zoals Deel en Ster worden erbij gedwongen om de capsule te vullen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest tylko jedna akcja, ale ozdobne przyciski jak Udostępnij i Gwiazdka są wciskane, by wypełnić kapsułę"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns bara en åtgärd, men dekorativa knappar som Dela och Stjärnmärk tvingas in för att fylla ut kapseln"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir eylem var, ama kapsülü doldurmak için Paylaş ve Yıldız gibi süs düğmeleri zorla ekleniyor"
          }
        }
      }
    },
    "앱 고유 개념(예: “무드”, “피드백”)을 아이콘만으로 표현": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App-specific concepts (e.g. \"Mood,\" \"Feedback\") expressed with an icon alone"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "App-specific concepts (e.g. \"Mood,\" \"Feedback\") expressed with an icon alone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ独自の概念（例：「ムード」「フィードバック」）をアイコンだけで表す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只用图标表达应用独有的概念（如“心情”“反馈”）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只用圖示表達應用程式獨有的概念（如「心情」「反饋」）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понятия, свойственные приложению (например, «Настроение», «Отзыв»), выраженные одним значком"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceptos propios de la app (p. ej., «Ánimo», «Comentarios») expresados solo con un icono"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Appspezifische Konzepte (z. B. „Stimmung“, „Feedback“) allein mit einem Symbol ausgedrückt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des concepts propres à l'app (p. ex. « Humeur », « Retour ») exprimés par une icône seule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concetti specifici dell'app (es. «Umore», «Feedback») espressi con la sola icona"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceitos específicos do app (por exemplo, «Humor», «Feedback») expressos só com um ícone"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนวคิดเฉพาะแอป (เช่น \"อารมณ์\" \"ความคิดเห็น\") ที่แสดงด้วยไอคอนอย่างเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khái niệm riêng của app (ví dụ \"Tâm trạng\", \"Phản hồi\") diễn đạt chỉ bằng biểu tượng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koncepty specifické pro aplikaci (např. „Nálada“, „Zpětná vazba“) vyjádřené jen ikonou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appspecifikke begreber (f.eks. »Humør«, »Feedback«) udtrykt med kun et ikon"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έννοιες ειδικές για την εφαρμογή (π.χ. «Διάθεση», «Σχόλια») εκφρασμένες μόνο με εικονίδιο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluskohtaiset käsitteet (esim. ”Mieliala”, ”Palaute”) ilmaistuna pelkällä kuvakkeella"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsep khas aplikasi (mis. \"Suasana Hati,\" \"Masukan\") diungkapkan dengan ikon saja"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appspesifikke konsepter (f.eks. «Humør», «Tilbakemelding») uttrykt med bare et ikon"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "App-specifieke concepten (bijv. \"Stemming\", \"Feedback\") uitgedrukt met alleen een icoon"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojęcia specyficzne dla aplikacji (np. „Nastrój”, „Opinia”) wyrażone samą ikoną"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appspecifika begrepp (t.ex. ”Humör”, ”Feedback”) uttryckta med enbart en ikon"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaya özgü kavramların (örn. “Ruh Hali”, “Geri Bildirim”) yalnızca bir simgeyle ifade edilmesi"
          }
        }
      }
    },
