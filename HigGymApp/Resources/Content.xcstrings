            "value": "不對應 inline 尺寸，直接沿用展開的佈局"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить развёрнутую раскладку как есть, без обработки inline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar el diseño expandido tal cual sin tratamiento inline"
          }
        },
        "de": {
