        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết kế và kiểm tra thứ tự ưu tiên của cái gập trước trên thiết bị hẹp"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navržení a ověření priority toho, co se sbalí první, na úzkém zařízení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At designe og tjekke prioriteten for, hvad der foldes først, på en smal enhed"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιασμός και έλεγχος της προτεραιότητας του τι διπλώνεται πρώτο σε στενή συσκευή"
          }
        }
      }
    },
    "좋아요!": {
