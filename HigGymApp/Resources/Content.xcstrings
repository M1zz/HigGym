            "value": "Søgefeltet og en handlingsknap bundet sammen i **samme kapsel** (blanding af input og handling)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πεδίο αναζήτησης και ένα κουμπί ενέργειας δεμένα στην **ίδια κάψουλα** (ανάμειξη εισαγωγής και ενέργειας)"
          }
        }
      }
    },
    "검색 필드와 액션 버튼을 같은 캡슐에 묶는다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grouping the search field and an action button in the same capsule"
          }
        },
        "en-GB": {
