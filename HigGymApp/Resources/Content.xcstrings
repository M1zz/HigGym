    "제목과 무관한 앱 전역 설정 메뉴를 제목에 연결": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app-wide settings menu, unrelated to the title, wired to the title"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An app-wide settings menu, unrelated to the title, wired to the title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルと無関係なアプリ全体の設定メニューをタイトルにつないでいる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把与标题无关的应用全局设置菜单连到标题上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把與標題無關的應用程式全域性設定選單連到標題上"
          }
        },
        "ru": {
          "stringUnit": {
