    "“미니멀해 보인다”는 이유로 전 화면 일괄 비활성화": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled across every screen because \"it looks more minimal\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabled across every screen because \"it looks more minimal\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ミニマルに見える」という理由で全画面一括で無効化"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以“看起来简约”为由，在所有界面统一关闭"
