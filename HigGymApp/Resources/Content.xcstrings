            "state": "translated",
            "value": "Covering everything for a task that needs the screen behind"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Covering everything for a task that needs the screen behind"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後ろの画面を見ながら行う作業を全部覆ってしまう"
          }
        }
      }
    },
    "뒤 화면을 참조하며 해야 하는 작업을 전부 덮어버림": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Covering everything when the task needs the screen behind for reference"
