    "성/이름 기준이 뒤죽박죽": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrambles whether it sorts by family or given name"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrambles whether it sorts by family or given name"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "姓/名どちらが基準なのかがめちゃくちゃになる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "姓/名的基准乱成一团"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "姓/名的基準亂成一團"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путаница с тем, по фамилии или по имени сортировать"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
