        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um **badge de texto curto** em vez de um número (.badge(\"NOVO\")), para avisos de status."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ป้ายข้อความสั้น** แทนตัวเลข (.badge(\"ใหม่\")) สำหรับประกาศสถานะ"
