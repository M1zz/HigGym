          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι νέα λειτουργία, οπότε τη θέλεις κάπου προβεβλημένα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on uusi ominaisuus, joten haluat sen johonkin näkyvään paikkaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini fitur baru, jadi kamu ingin di tempat yang menonjol."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en ny funksjon, så du vil ha den på et fremtredende sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is een nieuwe functie, dus je wilt hem ergens prominent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nowa funkcja, więc chcesz ją w widocznym miejscu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är en ny funktion, så du vill ha den någonstans framträdande."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir özellik, bu yüzden öne çıkan bir yerde olsun istersin."
          }
        }
      }
    },
    "새로 생긴 동작을 켜기 전에 **\"이 화면에서 사용자는 읽는가, 옮겨 다니는가\"**를 먼저 묻는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before turning on a new behavior, first ask: **\"On this screen, is the user reading or moving around?\"**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before turning on a new behaviour, first ask: **\"On this screen, is the user reading or moving around?\"**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しくできた動作をオンにする前に、まず「**この画面でユーザーは読んでいるのか、移動しているのか**」を問う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开新出现的行为之前，先问“**在这个界面里，用户是在阅读，还是在来回移动**？”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟新出現的行為之前，先問「**在這個介面裡，使用者是在閱讀，還是在來回移動**？」"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем включать новое поведение, сначала спросите: **«На этом экране пользователь читает или перемещается?»**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de activar un comportamiento nuevo, pregunta primero: **«En esta pantalla, ¿el usuario está leyendo o moviéndose?»**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage, bevor du ein neues Verhalten einschaltest, zuerst: **„Liest der Nutzer auf diesem Bildschirm oder bewegt er sich?“**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'activer un nouveau comportement, demandez d'abord : **« Sur cet écran, l'utilisateur lit-il ou se déplace-t-il ? »**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di attivare un nuovo comportamento, chiediti: **«In questa schermata, l'utente sta leggendo o si sta spostando?»**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de ativar um novo comportamento, pergunte primeiro: **«Nesta tela, o usuário está lendo ou circulando?»**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนเปิดพฤติกรรมใหม่ ให้ถามก่อน: **\"บนหน้าจอนี้ ผู้ใช้กำลังอ่านหรือเคลื่อนที่\"**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi bật một hành vi mới, hãy hỏi trước: **\"Trên màn hình này, người dùng đang đọc hay đang di chuyển?\"**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než zapnete nové chování, nejdřív se zeptejte: **„Čte uživatel na této obrazovce, nebo se pohybuje?“**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du slår en ny adfærd til, så spørg først: **»På denne skærm, læser brugeren, eller bevæger vedkommende sig rundt?«**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν ενεργοποιήσεις μια νέα συμπεριφορά, ρώτα πρώτα: **«Σε αυτή την οθόνη, ο χρήστης διαβάζει ή μετακινείται;»**"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennen kuin kytket uuden käytöksen päälle, kysy ensin: **”Onko käyttäjä tässä näkymässä lukemassa vai liikkumassa?”**"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum menyalakan perilaku baru, tanyakan dulu: **\"Di layar ini, apakah pengguna sedang membaca atau berpindah-pindah?\"**"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du slår på en ny oppførsel, spør først: **«På denne skjermen, leser brukeren eller beveger brukeren seg rundt?»**"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat je nieuw gedrag aanzet, vraag eerst: **\"Is de gebruiker op dit scherm aan het lezen of aan het rondgaan?\"**"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim włączysz nowe zachowanie, najpierw zapytaj: **„Czy na tym ekranie użytkownik czyta, czy porusza się po aplikacji?”**"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Innan du slår på ett nytt beteende, fråga först: **”På den här skärmen, läser användaren eller rör hen sig runt?”**"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir davranışı açmadan önce önce sor: **“Bu ekranda kullanıcı okuyor mu, yoksa dolaşıyor mu?”**"
          }
        }
      }
    },
    "새로 생긴 동작이라 일단 전 화면에 켜 본다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a new behavior, so you turn it on for every screen to start."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a new behaviour, so you turn it on for every screen to start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しくできた動作なので、とりあえず全画面でオンにしてみる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是新出现的行为，所以先在所有界面都打开试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是新出現的行為，所以先在所有介面都開啟試試。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это новое поведение, поэтому для начала включаете его на всех экранах."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un comportamiento nuevo, así que para empezar lo activas en todas las pantallas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein neues Verhalten, also schaltest du es zunächst für jeden Bildschirm ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un nouveau comportement, donc vous l'activez d'abord sur tous les écrans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un comportamento nuovo, quindi lo attivi per cominciare su ogni schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um comportamento novo, então você o liga para começar em todas as telas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นพฤติกรรมใหม่ คุณจึงเปิดมันกับทุกหน้าจอตั้งแต่แรก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là hành vi mới, nên ban đầu bạn bật nó cho mọi màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to nové chování, takže ho na začátku zapnete pro každou obrazovku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en ny adfærd, så du slår den til på alle skærme for at starte med."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι νέα συμπεριφορά, οπότε την ενεργοποιείς σε κάθε οθόνη για αρχή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on uusi käytös, joten kytket sen aluksi päälle jokaiseen näkymään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini perilaku baru, jadi kamu menyalakannya untuk semua layar sebagai permulaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en ny oppførsel, så du slår den på for alle skjermer som en start."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is nieuw gedrag, dus je zet het om te beginnen op elk scherm aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nowe zachowanie, więc na początek włączasz je na każdym ekranie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är ett nytt beteende, så du slår på det för varje skärm till att börja med."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir davranış, bu yüzden başlangıçta her ekranda açarsın."
          }
        }
      }
    },
