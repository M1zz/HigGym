            "state": "translated",
            "value": "ถูกตัดเมื่อยุบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bị cắt khi thu lại"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při sbalení se ořízne"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det bliver klippet, når det er sammenfoldet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κόβεται όταν συμπτύσσεται"
          }
        }
      }
    },
    "접히면 탭바 자리로 ↓": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves into the tab bar's spot when collapsed ↓"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves into the tab bar's spot when collapsed ↓"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたむとタブバーの位置へ↓"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠时落到标签栏的位置 ↓"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊時落到標籤列的位置 ↓"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сворачивании переходит на место панели вкладок ↓"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa al sitio de la barra de pestañas al colapsar ↓"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückt beim Zusammenklappen auf den Platz der Tab-Leiste ↓"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe à la place de la barre d'onglets quand elle est repliée ↓"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sposta nel posto della barra delle schede quando è compresso ↓"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa para o lugar da barra de abas quando recolhido ↓"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายไปอยู่ตำแหน่งของแถบแท็บเมื่อยุบ ↓"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển vào chỗ của thanh tab khi thu lại ↓"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při sbalení se přesune do místa panelu karet ↓"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytter ind på fanelinjens plads, når det er sammenfoldet ↓"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακινείται στη θέση της γραμμής καρτελών όταν συμπτύσσεται ↓"
          }
        }
      }
    },
    "접힌 곳에서도 길을 잃는다. 두 단계를 넘으면 화면으로 꺼낸다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People get lost even in collapsed places. Past two levels, bring it out onto a screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "People get lost even in collapsed places. Past two levels, bring it out onto a screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれた場所でも道に迷う。2段階を超えたら、画面に出す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠起来的地方也会迷路。超过两层，就拿出来做成界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊起來的地方也會迷路。超過兩層，就拿出來做成介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди теряются даже в свёрнутых местах. Глубже двух уровней выносите это на экран."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La gente se pierde incluso en los sitios plegados. Pasados dos niveles, llévalo a una pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen verlaufen sich selbst an zusammengeklappten Stellen. Ab zwei Ebenen bringe es auf einen Bildschirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gens se perdent même dans les endroits repliés. Au-delà de deux niveaux, sortez-le sur un écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le persone si perdono anche nei posti ripiegati. Oltre due livelli, portalo su una schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas se perdem até em lugares recolhidos. Além de dois níveis, leve para uma tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนหลงทางแม้ในที่ที่ยุบไว้ เกินสองระดับ ให้นำออกมาบนหน้าจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người ta lạc ngay cả ở những nơi đã thu gọn. Quá hai cấp, hãy đưa ra một màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé se ztratí i na sbalených místech. Za dvě úrovně vyneste na obrazovku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk farer vild selv i sammenfoldede steder. Ud over to niveauer, bring det ud på en skærm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι άνθρωποι χάνονται ακόμα και σε συμπτυγμένα σημεία. Πέρα από δύο επίπεδα, βγάλ' το σε οθόνη."
          }
        }
      }
    },
    "접힘(탭바)과 잔류(검색)의 역할 분리, 소비 중에는 이동이 덜 필요하지만 **검색은 소비 중에 오히려 촉발**되기 때문. 두 API가 직교로 설계되어 조합이 자연스럽게 성립합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A split of roles between collapsing (tab bar) and staying (search): while consuming, you need to navigate less, but **search is actually triggered by consuming**. The two APIs are designed to be orthogonal, so combining them just works."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A split of roles between collapsing (tab bar) and staying (search): while consuming, you need to navigate less, but **search is actually triggered by consuming**. The two APIs are designed to be orthogonal, so combining them just works."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみ（タブバー）と残留（検索）の役割分担。消費中は移動の必要が減るが、**検索はむしろ消費中にこそ生まれる**から。2つのAPIは直交するように設計されているので、組み合わせが自然に成り立ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠（标签栏）与保留（搜索）的角色分离：阅读期间不太需要导航，但**搜索反而是在阅读期间被触发的**。两个 API 被设计成正交，所以组合自然成立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊（標籤列）與保留（搜尋）的角色分離：閱讀期間不太需要導覽，但**搜尋反而是在閱讀期間被觸發的**。兩個 API 被設計成正交，所以組合自然成立。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделение ролей между сворачиваемым (панель вкладок) и остающимся (поиск): пока вы потребляете, навигировать нужно меньше, но **поиск как раз запускается потреблением**. Два API задуманы ортогональными, поэтому их сочетание просто работает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reparto de funciones entre colapsar (barra de pestañas) y quedarse (búsqueda): al consumir, necesitas navegar menos, pero **la búsqueda se dispara justo al consumir**. Las dos API están diseñadas para ser ortogonales, así que combinarlas simplemente funciona."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Rollenteilung zwischen Zusammenklappen (Tab-Leiste) und Bleiben (Suche): Beim Konsumieren muss man weniger navigieren, aber **die Suche wird gerade durch das Konsumieren ausgelöst**. Die beiden APIs sind orthogonal entworfen, sodass ihre Kombination einfach funktioniert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un partage des rôles entre se replier (barre d'onglets) et rester (recherche) : en consommant, on a moins besoin de naviguer, mais **la recherche est justement déclenchée par la consommation**. Les deux API sont conçues pour être orthogonales, donc leur combinaison fonctionne tout simplement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una divisione di ruoli tra comprimersi (barra delle schede) e restare (ricerca): mentre consumi, hai meno bisogno di navigare, ma **la ricerca è in realtà innescata dal consumare**. Le due API sono progettate per essere ortogonali, quindi combinarle funziona e basta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma divisão de papéis entre recolher (barra de abas) e ficar (busca): enquanto consome, você precisa navegar menos, mas **a busca é na verdade disparada pelo consumo**. As duas APIs são projetadas para serem ortogonais, então combiná-las simplesmente funciona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแบ่งบทบาทระหว่างยุบ (แถบแท็บ) กับอยู่ (การค้นหา): ขณะอ่านเสพ ต้องนำทางน้อยลง แต่ **การค้นหาถูกกระตุ้นจากการอ่านเสพจริง ๆ** สอง API ออกแบบให้ตั้งฉากกัน การรวมกันจึงใช้ได้เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một sự phân vai giữa thu lại (thanh tab) và ở lại (tìm kiếm): khi tiêu thụ, bạn cần điều hướng ít hơn, nhưng **tìm kiếm thực ra được kích hoạt bởi việc tiêu thụ**. Hai API được thiết kế trực giao, nên kết hợp chúng chạy ngay."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdělení rolí mezi sbalení (panel karet) a zůstání (hledání): při konzumaci potřebujete navigovat méně, ale **hledání se ve skutečnosti spouští konzumací**. Obě API jsou navržena ortogonálně, takže jejich kombinace prostě funguje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En rollefordeling mellem sammenfoldning (fanelinje) og at blive (søgning): mens du forbruger, har du mindre brug for at navigere, men **søgning udløses faktisk af forbrug**. De to API'er er designet til at være ortogonale, så at kombinere dem virker bare."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας διαχωρισμός ρόλων ανάμεσα στη σύμπτυξη (γραμμή καρτελών) και το μόνιμο στοιχείο (αναζήτηση): όσο καταναλώνεις, χρειάζεσαι λιγότερη πλοήγηση, αλλά **η αναζήτηση πυροδοτείται στην πραγματικότητα από την κατανάλωση**. Τα δύο API είναι σχεδιασμένα να είναι ορθογώνια, οπότε ο συνδυασμός τους δουλεύει απλά."
          }
        }
      }
    },
    "접힘/복원만 어수선": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The collapsing and restoring is just clutter"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The collapsing and restoring is just clutter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみと復元が煩わしいだけ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有折叠 / 恢复让人觉得杂乱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有摺疊 / 恢復讓人覺得雜亂"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сворачивание и восстановление - лишь помеха"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El colapso y la restauración son solo desorden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zusammenklappen und Wiederherstellen ist nur Unruhe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le repli et la restauration ne sont que du fouillis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimere e ripristinare è solo disordine"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recolher e o restaurar é só bagunça"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การยุบและคืนเป็นแค่ความรก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu lại rồi khôi phục chỉ là rườm rà"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbalování a obnovování je jen nepořádek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenfoldningen og gendannelsen er bare rod"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύμπτυξη και η επαναφορά είναι απλώς φασαρία"
          }
        }
      }
    },
    "접힘·복원이 반복되면 동작만 남고 이득이 없다. 긴 읽기 화면에만 켠다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If collapsing and restoring keep repeating, all that's left is motion with no benefit. Turn it on only for long reading screens."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If collapsing and restoring keep repeating, all that's left is motion with no benefit. Turn it on only for long reading screens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみと復元が繰り返されると、動きだけが残って得るものがない。長く読む画面にだけオンにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠、恢复反复发生，就只剩动作而没有收益。只在长阅读界面里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊、恢復反覆發生，就只剩動作而沒有收益。只在長閱讀介面裡開啟。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если сворачивание и восстановление повторяются снова и снова, остаётся только движение без пользы. Включайте его только на экранах длинного чтения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el colapso y la restauración se repiten sin parar, solo queda movimiento sin beneficio. Actívalo solo para pantallas de lectura larga."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholen sich Zusammenklappen und Wiederherstellen ständig, bleibt nur Bewegung ohne Nutzen. Schalte es nur für lange Leseschirme ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le repli et la restauration se répètent sans cesse, il ne reste que du mouvement sans bénéfice. N'activez cela que pour de longs écrans de lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se comprimere e ripristinare si ripetono di continuo, resta solo movimento senza alcun beneficio. Attivalo solo per le schermate di lettura lunga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recolher e restaurar ficam se repetindo, resta apenas movimento sem benefício. Ative só para telas de leitura longa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าการยุบและคืนซ้ำไปซ้ำมา เหลือแต่การเคลื่อนไหวที่ไม่มีประโยชน์ เปิดเฉพาะหน้าจออ่านยาว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu thu lại và khôi phục cứ lặp đi lặp lại, chỉ còn chuyển động mà không có lợi ích. Chỉ bật cho màn hình đọc dài."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud se sbalování a obnovování stále opakuje, zbývá jen pohyb bez užitku. Zapněte to jen pro dlouhé čtecí obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis sammenfoldning og gendannelse bliver ved med at gentage sig, er der kun bevægelse uden gavn tilbage. Slå det kun til på lange læseskærme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν η σύμπτυξη και η επαναφορά επαναλαμβάνονται συνέχεια, μένει μόνο κίνηση χωρίς όφελος. Ενεργοποίησέ το μόνο για μακριές οθόνες ανάγνωσης."
          }
        }
      }
    },
    "정렬 기준과 방향은 서브메뉴 하나 안에 Picker로 넣어 현재 값에 체크가 보이게 한다. 한 번 열면 지금 무엇으로 정렬돼 있는지 보이고 바로 바꿀 수 있다. 나머지 보기 옵션이 계속 늘어난다면 메뉴에서 꺼내 시트나 화면으로 승격한다. 메뉴에는 관련 액션끼리 섹션으로 나눈 한두 단계만 남는다. 앱의 7.1.1 Menu Configurations 예제에서 서브메뉴와 Picker가 들어간 메뉴를 열어 볼 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the sort key and direction in a single submenu as a Picker, so the current value shows a checkmark. Open it once, and you can see what it's currently sorted by and change it right away. If the other view options keep growing, take them out of the menu and promote them to a sheet or a screen. The menu keeps only one or two levels, with related actions grouped into sections. In the app's 7.1.1 Menu Configurations example, you can open a menu that contains a submenu and a Picker."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the sort key and direction in a single submenu as a Picker, so the current value shows a checkmark. Open it once, and you can see what it's currently sorted by and change it right away. If the other view options keep growing, take them out of the menu and promote them to a sheet or a screen. The menu keeps only one or two levels, with related actions grouped into sections. In the app's 7.1.1 Menu Configurations example, you can open a menu that contains a submenu and a Picker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替えの基準と方向は、1つのサブメニューの中にPickerとして入れ、現在の値にチェックが付くようにする。一度開けば、今何で並んでいるかが見えて、すぐに変えられる。ほかの表示オプションが増え続けるなら、メニューから出してシートや画面に格上げする。メニューには、関連するアクションをセクションで分けた1〜2段だけが残る。アプリの7.1.1 Menu Configurationsの例で、サブメニューとPickerが入ったメニューを開いてみられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序依据和方向放进一个子菜单里的 Picker，让当前值上能看到勾选。打开一次，就能看到现在按什么排序，并能立刻更改。其余显示选项如果不断增加，就从菜单里拿出来，升格成弹层或界面。菜单里只留按相关操作分区的一两层。在应用的 7.1.1 Menu Configurations 示例里，可以打开带子菜单和 Picker 的菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排序依據和方向放進一個子選單裡的 Picker，讓當前值上能看到勾選。開啟一次，就能看到現在按什麼排序，並能立刻更改。其餘顯示選項如果不斷增加，就從選單裡拿出來，升格成工作表或介面。選單裡只留按相關操作分割槽的一兩層。在應用程式的 7.1.1 Menu Configurations 示例裡，可以開啟帶子選單和 Picker 的選單。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместите ключ и направление сортировки в одно подменю как Picker, чтобы текущее значение отмечалось галочкой. Откройте его один раз, и увидите, как отсортировано сейчас, и сразу сможете изменить. Если остальные параметры вида продолжают расти, вынесите их из меню и поднимите до шторки или экрана. В меню остаётся один-два уровня, связанные действия сгруппированы в секции. В примере приложения 7.1.1 Menu Configurations можно открыть меню с подменю и Picker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon la clave y la dirección de ordenación en un único submenú como un Picker, para que el valor actual muestre una marca de verificación. Ábrelo una vez y verás por qué criterio está ordenado ahora y podrás cambiarlo enseguida. Si las demás opciones de vista siguen creciendo, sácalas del menú y asciéndelas a una hoja o a una pantalla. El menú se queda con uno o dos niveles, con las acciones relacionadas agrupadas en secciones. En el ejemplo 7.1.1 Menu Configurations de la app puedes abrir un menú que contiene un submenú y un Picker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze Sortierkriterium und -richtung als Picker in ein einziges Untermenü, sodass der aktuelle Wert ein Häkchen zeigt. Öffne es einmal, und du siehst, wonach gerade sortiert ist, und kannst es sofort ändern. Wachsen die übrigen Ansichtsoptionen weiter, nimm sie aus dem Menü und befördere sie zu einem Sheet oder Bildschirm. Das Menü behält nur eine oder zwei Ebenen, mit zusammengehörigen Aktionen in Abschnitten gruppiert. Im Beispiel 7.1.1 Menu Configurations der App kannst du ein Menü mit Untermenü und Picker öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez la clé et le sens du tri dans un seul sous-menu sous forme de Picker, pour que la valeur actuelle affiche une coche. Ouvrez-le une fois, et vous voyez selon quoi c'est trié et pouvez le changer aussitôt. Si les autres options d'affichage continuent de croître, sortez-les du menu et promouvez-les vers une feuille ou un écran. Le menu ne garde qu'un ou deux niveaux, avec les actions liées regroupées en sections. Dans l'exemple 7.1.1 Menu Configurations de l'app, vous pouvez ouvrir un menu qui contient un sous-menu et un Picker."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti la chiave e la direzione di ordinamento in un unico sottomenu come Picker, così il valore attuale mostra un segno di spunta. Aprilo una volta e vedi per che cosa è ordinato adesso e puoi cambiarlo subito. Se le altre opzioni di vista continuano a crescere, toglile dal menu e promuovile a foglio o a schermata. Il menu mantiene solo uno o due livelli, con le azioni correlate raggruppate in sezioni. Nell'esempio 7.1.1 Configurazioni del menu dell'app puoi aprire un menu che contiene un sottomenu e un Picker."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponha a chave e a direção de ordenação num único submenu como Picker, para o valor atual mostrar um sinal de verificação. Abra uma vez e você vê pelo que está ordenado agora e pode mudar na hora. Se as outras opções de visualização continuam crescendo, tire-as do menu e promova-as a uma folha ou tela. O menu mantém só um ou dois níveis, com as ações relacionadas agrupadas em seções. No exemplo 7.1.1 Configurações do menu do app, você pode abrir um menu que contém um submenu e um Picker."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่คีย์การเรียงและทิศทางในเมนูย่อยเดียวเป็น Picker เพื่อให้ค่าปัจจุบันมีเครื่องหมายถูก เปิดครั้งเดียว คุณก็เห็นว่าตอนนี้เรียงตามอะไรและเปลี่ยนได้ทันที ถ้าตัวเลือกมุมมองอื่นเพิ่มขึ้นเรื่อย ๆ ให้นำออกจากเมนูและยกเป็นชีตหรือหน้าจอ เมนูเก็บแค่หนึ่งหรือสองระดับ โดยจัดการกระทำที่เกี่ยวข้องเป็นส่วน ในตัวอย่าง 7.1.1 Menu Configurations ของแอป คุณเปิดเมนูที่มีเมนูย่อยและ Picker ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt khóa và chiều sắp xếp vào một menu con dưới dạng Picker, để giá trị hiện tại có dấu tích. Mở một lần là thấy hiện đang sắp xếp theo gì và đổi ngay được. Nếu các tùy chọn xem khác cứ tăng, lấy chúng ra khỏi menu và nâng lên sheet hay màn hình. Menu chỉ giữ một hai cấp, với các hành động liên quan gom thành phần. Trong ví dụ 7.1.1 Menu Configurations của app, bạn mở được menu có menu con và Picker."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte klíč a směr řazení do jediné podnabídky jako Picker, aby aktuální hodnota ukazovala zatržítko. Otevřete ji jednou a vidíte, podle čeho se právě řadí, a můžete to hned změnit. Pokud ostatní možnosti zobrazení pořád přibývají, vyjměte je z nabídky a povyšte na sheet nebo obrazovku. Nabídka drží jen jednu nebo dvě úrovně se souvisejícími akcemi seskupenými do sekcí. V příkladu 7.1.1 Menu Configurations aplikace otevřete nabídku obsahující podnabídku a Picker."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg sorteringsnøgle og retning i én undermenu som en Picker, så den aktuelle værdi viser et flueben. Åbn den én gang, og du kan se, hvad der aktuelt sorteres efter, og ændre det med det samme. Hvis de andre visningsmuligheder bliver ved med at vokse, så tag dem ud af menuen og løft dem til et ark eller en skærm. Menuen beholder kun ét eller to niveauer, med relaterede handlinger grupperet i sektioner. I appens eksempel 7.1.1 Menukonfigurationer kan du åbne en menu, der indeholder en undermenu og en Picker."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε το κλειδί και την κατεύθυνση ταξινόμησης σε ένα μόνο υπομενού ως Picker, ώστε η τρέχουσα τιμή να δείχνει σημάδι επιλογής. Άνοιξέ το μία φορά, και βλέπεις πώς είναι ταξινομημένο τώρα και το αλλάζεις αμέσως. Αν οι άλλες επιλογές προβολής συνεχίσουν να πολλαπλασιάζονται, βγάλ' τες από το μενού και προώθησέ τες σε φύλλο ή οθόνη. Το μενού κρατά μόνο ένα ή δύο επίπεδα, με τις σχετικές ενέργειες ομαδοποιημένες σε ενότητες. Στο παράδειγμα 7.1.1 Διαμορφώσεις μενού της εφαρμογής, μπορείς να ανοίξεις ένα μενού που περιέχει υπομενού και Picker."
          }
        }
      }
    },
    "정렬 기준을 Picker로 넣어 현재 값에 체크 표시": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sort criterion added as a Picker, with a checkmark on the current value"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sort criterion added as a Picker, with a checkmark on the current value"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替えの基準をPickerで入れ、現在の値にチェックマーク"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
