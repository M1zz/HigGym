        }
      }
    },
    "화면마다 soft/hard를 무원칙하게 섞어 일관성 상실": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft and hard mixed screen by screen with no rule, losing consistency"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Soft and hard mixed screen by screen with no rule, losing consistency"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面ごとにsoftとhardを無原則に混ぜ、一貫性を失っている"
          }
        },
        "zh-Hans": {
