        }
      }
    },
    "overflow를 피하려고 아이콘 7개를 우겨넣어 터치 타깃이 손가락보다 작아짐": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven icons crammed in to avoid overflow, leaving touch targets smaller than a finger"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven icons crammed in to avoid overflow, leaving touch targets smaller than a finger"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "overflowを避けようとアイコンを7つ詰め込み、タッチターゲットが指より小さくなっている"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为避免 overflow 硬塞进 7 个图标，触控目标比手指还小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為避免 overflow 硬塞進 7 個圖示，觸控目標比手指還小"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семь значков втиснуты, чтобы избежать переполнения, и области касания стали меньше пальца"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siete iconos apretados para evitar el desbordamiento, dejando los objetivos táctiles más pequeños que un dedo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieben hineingequetschte Symbole, um Überlauf zu vermeiden, mit Touch-Zielen kleiner als ein Finger"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sept icônes entassées pour éviter le débordement, laissant des cibles tactiles plus petites qu'un doigt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sette icone ammassate per evitare l'overflow, lasciando bersagli tattili più piccoli di un dito"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sete ícones espremidos para evitar o overflow, deixando alvos de toque menores que um dedo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยัดไอคอนเจ็ดอันเพื่อหลีกเลี่ยงการล้น ทำให้เป้าสัมผัสเล็กกว่านิ้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhét bảy biểu tượng để tránh tràn, khiến vùng chạm nhỏ hơn ngón tay"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedm ikon nacpaných, aby se zabránilo přetečení, takže dotykové plochy jsou menší než prst"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Syv ikoner proppet ind for at undgå overløb, så berøringsmålene bliver mindre end en finger"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφτά εικονίδια στριμωγμένα για να αποφευχθεί το υπερχείλισμα, αφήνοντας στόχους αφής μικρότερους από δάχτυλο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitsemän kuvaketta ahdettu ylivuodon välttämiseksi, jättäen kosketuskohteet sormea pienemmiksi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tujuh ikon dijejalkan untuk menghindari overflow, menyisakan target sentuh lebih kecil dari jari"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sju ikoner presset inn for å unngå overflyt, med berøringsmål mindre enn en finger"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeven iconen proppen om overflow te vermijden, waardoor aanraakdoelen kleiner worden dan een vinger"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Siedem ikon wciśniętych, by uniknąć przepełnienia, zostawiających cele dotyku mniejsze niż palec"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sju ikoner pressade in för att undvika överflöde, vilket lämnar tryckytor mindre än ett finger"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşmayı önlemek için sıkıştırılmış yedi simge, dokunma hedeflerini bir parmaktan küçük bırakır"
          }
        }
      }
    },
    "overflow를 피하려고 아이콘을 우겨넣어 터치 타깃을 줄인다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cramming in icons to avoid the overflow, shrinking the touch targets"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Cramming in icons to avoid the overflow, shrinking the touch targets"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "overflowを避けようとアイコンを詰め込み、タッチターゲットを小さくする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为避免 overflow 硬塞图标，压缩了触控目标"
