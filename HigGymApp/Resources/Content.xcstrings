          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'icona vaga e astratta abbinata a un'etichetta coniata e poco familiare"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ícone vago e abstrato combinado com um rótulo inventado e pouco familiar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนเลือนรางที่เป็นนามธรรมจับคู่กับป้ายชื่อที่ตั้งขึ้นเองซึ่งไม่คุ้นเคย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một biểu tượng mơ hồ, trừu tượng ghép với nhãn tự đặt lạ lẫm"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejasná, abstraktní ikona spárovaná s neznámým vymyšleným popiskem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et vagt, abstrakt ikon parret med en uvant opfundet etiket"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα ασαφές, αφηρημένο εικονίδιο ζευγαρωμένο με μια ανοίκεια επινοημένη ετικέτα"
          }
        }
      }
    },
    "의미론이 처리 방식을 정한다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Semantics decide the treatment"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Semantics decide the treatment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "扱い方は意味が決める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语义决定处理方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語義決定處理方式"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лечение определяется семантикой"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La semántica decide el tratamiento"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Semantik entscheidet die Behandlung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sémantique décide du traitement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La semantica decide il trattamento"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A semântica decide o tratamento"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความหมายตัดสินการจัดการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngữ nghĩa quyết định cách xử lý"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "O ošetření rozhoduje sémantika"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Semantik afgør behandlingen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σημασιολογία αποφασίζει την αντιμετώπιση"
          }
        }
      }
    },
    "이 기능이 존재하는 근본 이유: 툴바가 **반투명 유리로 콘텐츠 위에 떠 있기 때문에**, 그 밑을 지나가는 콘텐츠와 겹치면 컨트롤이 안 보일 수 있음. 가장자리 효과는 **가독성을 지키는 안전장치**라서 기본으로 켜져 있습니다. 선택 기준은 하나**\"바 뒤로 지나갈 콘텐츠가 얼마나 복잡한가.\"**": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why this feature exists at all: because the toolbar **floats above the content as translucent glass**, its controls can become hard to see when the content passing underneath overlaps them. The edge effect is **a safeguard for legibility**, which is why it is on by default. There is one criterion: **\"How busy is the content that will scroll behind the bar?\"**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Why this feature exists at all: because the toolbar **floats above the content as translucent glass**, its controls can become hard to see when the content passing underneath overlaps them. The edge effect is **a safeguard for legibility**, which is why it is on by default. There is one criterion: **\"How busy is the content that will scroll behind the bar?\"**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能が存在する根本的な理由：ツールバーは**半透明のガラスとしてコンテンツの上に浮いているため**、その下を通るコンテンツと重なるとコントロールが見えなくなることがある。エッジエフェクトは**読みやすさを守る安全装置**なので、デフォルトでオンになっています。選ぶ基準はひとつ、**「バーの後ろを通るコンテンツがどれだけ複雑か」**。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个功能存在的根本原因：工具栏是**以半透明玻璃浮在内容之上**的，所以与从下面经过的内容重叠时，控件可能看不见。边缘效果是**守住可读性的安全装置**，所以默认开启。选择标准只有一个：**“经过栏后面的内容有多复杂。”**"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個功能存在的根本原因：工具列是**以半透明玻璃浮在內容之上**的，所以與從下面經過的內容重疊時，控制元件可能看不見。邊緣效果是**守住可讀性的安全裝置**，所以預設開啟。選擇標準只有一個：**「經過列後面的內容有多複雜。」**"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачем эта функция вообще нужна: поскольку панель инструментов **парит над содержимым как полупрозрачное стекло**, её элементы могут стать плохо различимы, когда проходящее под ними содержимое накладывается на них. Эффект края - **страховка читаемости**, потому он и включён по умолчанию. Критерий один: **«Насколько пестрое содержимое будет прокручиваться за панелью?»**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por qué existe esta función: como la barra de herramientas **flota sobre el contenido como cristal translúcido**, sus controles pueden costar de ver cuando el contenido que pasa por debajo se solapa con ellos. El efecto de borde es **una salvaguarda de legibilidad**, por eso viene activado por defecto. Hay un criterio: **«¿Cómo de cargado es el contenido que se desplazará detrás de la barra?»**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum es diese Funktion überhaupt gibt: Weil die Symbolleiste **als durchscheinendes Glas über dem Inhalt schwebt**, können ihre Steuerelemente schwer erkennbar werden, wenn der darunter vorbeiziehende Inhalt sie überlappt. Der Kanteneffekt ist **eine Absicherung für die Lesbarkeit**, weshalb er standardmäßig an ist. Es gibt ein Kriterium: **„Wie unruhig ist der Inhalt, der hinter der Leiste scrollt?“**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi cette fonction existe : parce que la barre d'outils **flotte au-dessus du contenu comme un verre translucide**, ses contrôles peuvent devenir difficiles à voir quand le contenu qui passe dessous les chevauche. L'effet de bord est **une protection pour la lisibilité**, c'est pourquoi il est activé par défaut. Il y a un seul critère : **« À quel point le contenu qui défilera derrière la barre est-il chargé ? »**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché questa funzione esiste: poiché la barra degli strumenti **fluttua sopra il contenuto come vetro traslucido**, i suoi controlli possono diventare difficili da vedere quando il contenuto che passa sotto li sovrappone. L'effetto sul bordo è **una salvaguardia per la leggibilità**, ed è per questo attivo di default. C'è un solo criterio: **«Quanto è carico il contenuto che scorrerà dietro la barra?»**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que esta funcionalidade existe: como a barra de ferramentas **flutua sobre o conteúdo como vidro translúcido**, seus controles podem ficar difíceis de ver quando o conteúdo que passa por baixo se sobrepõe a eles. O efeito de borda é **uma salvaguarda para a legibilidade**, e por isso vem ligado por padrão. Há um único critério: **«Quão carregado é o conteúdo que vai rolar atrás da barra?»**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไมฟีเจอร์นี้จึงมีอยู่: เพราะแถบเครื่องมือ**ลอยเหนือเนื้อหาเป็นกระจกโปร่งแสง** ตัวควบคุมของมันจึงอาจมองยากเมื่อเนื้อหาที่ผ่านด้านล่างทับกัน เอฟเฟกต์ขอบคือ**เครื่องป้องกันเพื่อความอ่านออก** จึงเปิดโดยค่าเริ่มต้น มีเกณฑ์เดียว: **\"เนื้อหาที่จะเลื่อนผ่านด้านหลังแถบวุ่นวายแค่ไหน\"**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao tính năng này tồn tại: vì thanh công cụ **nổi trên nội dung như kính trong suốt**, các điều khiển của nó có thể khó thấy khi nội dung đi bên dưới chồng lên. Hiệu ứng cạnh là **biện pháp bảo vệ khả năng đọc**, đó là lý do nó bật mặc định. Có một tiêu chí: **\"Nội dung sẽ cuộn phía sau thanh rối đến mức nào?\"**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proč tato funkce vůbec existuje: protože panel nástrojů **plave nad obsahem jako průsvitné sklo**, jeho ovladače mohou být špatně vidět, když je překrývá obsah procházející pod nimi. Okrajový efekt je **pojistka čitelnosti**, a proto je ve výchozím stavu zapnutý. Existuje jedno kritérium: **„Jak rušný je obsah, který se bude posouvat za panelem?“**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor denne funktion overhovedet findes: fordi værktøjslinjen **svæver over indholdet som gennemsigtigt glas**, kan dens kontroller blive svære at se, når indhold, der passerer under, overlapper dem. Kanteffekten er **en sikkerhedsforanstaltning for læselighed**, og derfor er den slået til som standard. Der er ét kriterium: **»Hvor uroligt er det indhold, der scroller bag bjælken?«**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γιατί υπάρχει αυτή η λειτουργία εξαρχής: επειδή η γραμμή εργαλείων **επιπλέει πάνω από το περιεχόμενο ως ημιδιαφανές γυαλί**, οι έλεγχοί της μπορεί να γίνουν δύσκολο να φανούν όταν το περιεχόμενο που περνά από κάτω τους επικαλύπτει. Το εφέ άκρης είναι **μέτρο ασφαλείας για την αναγνωσιμότητα**, γι' αυτό είναι ενεργό από προεπιλογή. Υπάρχει ένα κριτήριο: **«Πόσο φορτωμένο είναι το περιεχόμενο που θα κυλά πίσω από τη γραμμή;»**"
          }
        }
      }
    },
    "이 카드는 리뷰가 길어서 세 줄 높이를 전부 채웠습니다. 기준 높이.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card's review is long, so it fills all three lines. This is the reference height."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This card's review is long, so it fills all three lines. This is the reference height."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードはレビューが長いので、3行分の高さをすべて埋めています。基準の高さ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张卡片的评价很长，把三行高度全部填满了。这是基准高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張卡片的評價很長，把三行高度全部填滿了。這是基準高度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзыв в этой карточке длинный, поэтому он занимает все три строки. Это эталонная высота."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reseña de esta tarjeta es larga, así que ocupa las tres líneas. Esta es la altura de referencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rezension dieser Karte ist lang, also füllt sie alle drei Zeilen. Das ist die Referenzhöhe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'avis de cette carte est long, donc il remplit les trois lignes. C'est la hauteur de référence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La recensione di questa scheda è lunga, quindi riempie tutte e tre le righe. Questa è l'altezza di riferimento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A avaliação deste cartão é longa, então preenche as três linhas. Esta é a altura de referência."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีวิวของการ์ดนี้ยาว จึงเต็มทั้งสามบรรทัด นี่คือความสูงอ้างอิง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh giá của thẻ này dài nên lấp cả ba dòng. Đây là chiều cao tham chiếu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Recenze této karty je dlouhá, takže vyplní všechny tři řádky. To je referenční výška."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette korts anmeldelse er lang, så den fylder alle tre linjer. Det er referencehøjden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κριτική αυτής της κάρτας είναι μακριά, οπότε γεμίζει και τις τρεις γραμμές. Αυτό είναι το ύψος αναφοράς."
          }
        }
      }
    },
    "이 컨트롤 값에 따라 화면 전체 내용이 바뀌므로 \"화면의 정체성\"이라는 principal의 문법과 정확히 일치": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its value changes the content of the entire screen, so it matches principal's grammar, \"the identity of the screen,\" exactly"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Its value changes the content of the entire screen, so it matches principal's grammar, \"the identity of the screen,\" exactly"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコントロールの値によって画面全体の内容が変わるので、「画面のアイデンティティ」というprincipalの文法とぴったり一致する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个控件的值会让整个界面内容发生变化，所以与“界面的身份”这个 principal 的语法完全一致"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個控制元件的值會讓整個介面內容發生變化，所以與「介面的身份」這個 principal 的語法完全一致"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его значение меняет содержимое всего экрана, поэтому оно точно соответствует грамматике principal, «идентичности экрана»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su valor cambia el contenido de toda la pantalla, así que coincide exactamente con la gramática de principal, «la identidad de la pantalla»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Wert ändert den Inhalt des gesamten Bildschirms, passt also genau zur Grammatik von principal, „der Identität des Bildschirms“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa valeur change le contenu de tout l'écran, donc il correspond exactement à la grammaire de principal, « l'identité de l'écran »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo valore cambia il contenuto dell'intera schermata, quindi corrisponde esattamente alla grammatica di principal, «l'identità della schermata»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor dele muda o conteúdo da tela inteira, então corresponde exatamente à gramática de principal, «a identidade da tela»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าของมันเปลี่ยนเนื้อหาของทั้งหน้าจอ จึงตรงกับไวยากรณ์ของ principal \"ตัวตนของหน้าจอ\" พอดี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị của nó đổi nội dung của cả màn hình, nên khớp chính xác ngữ pháp của principal, \"danh tính của màn hình\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Její hodnota mění obsah celé obrazovky, takže přesně odpovídá gramatice principal, „identitě obrazovky“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens værdi ændrer indholdet på hele skærmen, så den matcher principals grammatik, »skærmens identitet«, præcist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τιμή του αλλάζει το περιεχόμενο ολόκληρης της οθόνης, οπότε ταιριάζει ακριβώς με τη γραμματική του principal, «την ταυτότητα της οθόνης»"
          }
        }
      }
    },
    "이 컨트롤의 모습이 그 자리의 문법과 일치하는가? 시트에서는 **보이는 신호와 실제 동작이 같은 말을 하는가**로 읽는다. 만질 수 있으면 어둡게 하지 않고, 어둡게 했으면 막는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does this control's appearance match the grammar of its spot? For sheets, read it as **whether the visible signal and the actual behavior are saying the same thing**. If it can be touched, don't dim it; if you dimmed it, block it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Does this control's appearance match the grammar of its spot? For sheets, read it as **whether the visible signal and the actual behaviour are saying the same thing**. If it can be touched, don't dim it; if you dimmed it, block it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコントロールの見た目は、その場所の文法と一致しているか？ シートでは、**見えるサインと実際の動作が同じことを語っているか**と読み替える。触れるなら暗くせず、暗くしたならブロックする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个控件的外观与那个位置的语法一致吗？在弹层里，读的是**看得见的信号和实际行为是否在说同一句话**。能操作就不压暗，压暗了就要屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個控制元件的外觀與那個位置的語法一致嗎？在工作表裡，讀的是**看得見的訊號和實際行為是否在說同一句話**。能操作就不壓暗，壓暗了就要遮蔽。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соответствует ли вид этого элемента грамматике его места? Для шторок читайте это как **«говорят ли видимый сигнал и реальное поведение одно и то же»**. Если можно трогать, не затемняйте; если затемнили, заблокируйте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Coincide el aspecto de este control con la gramática de su sitio? En las hojas, léelo como **si la señal visible y el comportamiento real dicen lo mismo**. Si se puede tocar, no lo atenúes; si lo atenuaste, bloquéalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt das Aussehen dieses Steuerelements zur Grammatik seines Platzes? Bei Sheets lies es als **ob das sichtbare Signal und das tatsächliche Verhalten dasselbe sagen**. Kann man es berühren, dunkle es nicht ab; hast du es abgedunkelt, blockiere es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aspect de ce contrôle correspond-il à la grammaire de son emplacement ? Pour les feuilles, lisez-le comme **le signal visible et le comportement réel disent-ils la même chose**. Si on peut le toucher, ne l'assombrissez pas ; si vous l'avez assombri, bloquez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aspetto di questo controllo corrisponde alla grammatica del suo posto? Per i fogli, leggilo come **se il segnale visibile e il comportamento reale dicono la stessa cosa**. Se si può toccare, non oscurarlo; se lo hai oscurato, bloccalo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aparência deste controle combina com a gramática do seu lugar? Para as folhas, leia como **se o sinal visível e o comportamento real dizem a mesma coisa**. Se pode ser tocado, não escureça; se escureceu, bloqueie."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปลักษณ์ของตัวควบคุมนี้ตรงกับไวยากรณ์ของตำแหน่งหรือไม่ สำหรับชีต ให้อ่านว่า**สัญญาณที่มองเห็นกับพฤติกรรมจริงบอกสิ่งเดียวกันหรือไม่** ถ้าแตะได้ อย่าหรี่ ถ้าหรี่ ให้บล็อก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẻ ngoài của điều khiển này có khớp ngữ pháp của chỗ nó đứng không? Với sheet, hãy đọc là **tín hiệu nhìn thấy và hành vi thực có nói cùng một điều không**. Nếu chạm được, đừng làm tối; nếu đã làm tối, hãy chặn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídá vzhled tohoto ovladače gramatice jeho místa? U sheetů to čtěte jako **zda viditelný signál a skutečné chování říkají totéž**. Pokud se dá sáhnout, neztmavujte; pokud jste ztmavili, blokujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer denne kontrols udseende til grammatikken på dens plads? For ark læses det som **om det synlige signal og den faktiske adfærd siger det samme**. Hvis det kan røres, så dæmp det ikke; hvis du dæmpede det, så bloker det."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταιριάζει η εμφάνιση αυτού του ελέγχου με τη γραμματική της θέσης του; Για τα φύλλα, διάβασέ το ως **αν το ορατό σήμα και η πραγματική συμπεριφορά λένε το ίδιο πράγμα**. Αν μπορεί να αγγιχτεί, μην το σκιάζεις· αν το σκίασες, μπλόκαρέ το."
          }
        }
      }
    },
    "이 컨트롤의 모습이 그 자리의 문법과 일치하는가? 시트의 문법에서 그랩바는 **끌 수 있다는 약속**이다. 끌 수 있는 시트라면 그 약속을 보여 주고, 끌 수 없다면 detent를 하나로 둔다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does this control's appearance match the grammar of its spot? In the grammar of sheets, the grabber is **the promise that it can be dragged**. If a sheet can be dragged, show that promise; if it can't, keep it to a single detent."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Does this control's appearance match the grammar of its spot? In the grammar of sheets, the grabber is **the promise that it can be dragged**. If a sheet can be dragged, show that promise; if it can't, keep it to a single detent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコントロールの見た目は、その場所の文法と一致しているか？ シートの文法では、グラバーは**ドラッグできるという約束**だ。ドラッグできるシートならその約束を見せ、ドラッグできないなら detent をひとつにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个控件的外观与那个位置的语法一致吗？在弹层的语法里，抓取条是**“可以拖动”的约定**。如果是可以拖动的弹层，就把这个约定显示出来；不能拖动的话，就把 detent 定成一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個控制元件的外觀與那個位置的語法一致嗎？在工作表的語法裡，抓取列是**「可以拖動」的約定**。如果是可以拖動的工作表，就把這個約定顯示出來；不能拖動的話，就把 detent 定成一個。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соответствует ли вид этого элемента грамматике его места? В грамматике шторок индикатор-ручка - это **обещание, что её можно тянуть**. Если шторку можно тянуть, покажите это обещание; если нельзя, оставьте один detent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Coincide el aspecto de este control con la gramática de su sitio? En la gramática de las hojas, el tirador es **la promesa de que se puede arrastrar**. Si una hoja se puede arrastrar, muestra esa promesa; si no, déjala en un solo detent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt das Aussehen dieses Steuerelements zur Grammatik seines Platzes? In der Grammatik der Sheets ist der Griff **das Versprechen, dass man ziehen kann**. Lässt sich ein Sheet ziehen, zeige dieses Versprechen; wenn nicht, beschränke es auf einen Detent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aspect de ce contrôle correspond-il à la grammaire de son emplacement ? Dans la grammaire des feuilles, la poignée est **la promesse qu'on peut la faire glisser**. Si une feuille peut être glissée, montrez cette promesse ; sinon, limitez-la à un seul detent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aspetto di questo controllo corrisponde alla grammatica del suo posto? Nella grammatica dei fogli, la maniglia è **la promessa che si può trascinare**. Se un foglio si può trascinare, mostra quella promessa; se non si può, tienilo a un solo detent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aparência deste controle combina com a gramática do seu lugar? Na gramática das folhas, a alça é **a promessa de que dá para arrastar**. Se uma folha pode ser arrastada, mostre essa promessa; se não, mantenha-a num único detent."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปลักษณ์ของตัวควบคุมนี้ตรงกับไวยากรณ์ของตำแหน่งหรือไม่ ในไวยากรณ์ของชีต grabber คือ**คำมั่นว่าลากได้** ถ้าชีตลากได้ ให้แสดงคำมั่นนั้น ถ้าลากไม่ได้ ให้คงไว้ที่ detent เดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẻ ngoài của điều khiển này có khớp ngữ pháp của chỗ nó đứng không? Trong ngữ pháp của sheet, grabber là **lời hứa rằng nó kéo được**. Nếu sheet kéo được, hãy hiện lời hứa đó; nếu không, giữ một detent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídá vzhled tohoto ovladače gramatice jeho místa? V gramatice sheetů je grabber **slib, že jde táhnout**. Pokud sheet jde táhnout, ukažte ten slib; pokud ne, ponechte jediný detent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer denne kontrols udseende til grammatikken på dens plads? I arkenes grammatik er grabberen **løftet om, at det kan trækkes**. Hvis et ark kan trækkes, så vis det løfte; hvis det ikke kan, så hold det til én detent."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταιριάζει η εμφάνιση αυτού του ελέγχου με τη γραμματική της θέσης του; Στη γραμματική των φύλλων, το grabber είναι **η υπόσχεση ότι μπορεί να συρθεί**. Αν ένα φύλλο μπορεί να συρθεί, δείξε αυτή την υπόσχεση· αν όχι, κράτα το σε ένα μόνο detent."
          }
        }
      }
    },
    "이 화면에서 삭제는 자주 쓰는 액션처럼 보인다. 빈도가 높을수록 엄지에 가깝게, 라는 기준을 그대로 적용하면 삭제는 하단으로 간다. 하단에 하나만 두니 화면도 단순해진다. 기준을 지켰다고 생각하기 쉽다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this screen, Delete looks like a frequently used action. Apply the rule \"the more frequent, the closer to the thumb\" as is, and Delete goes to the bottom. With just one item at the bottom, the screen gets simpler too. It's easy to believe you followed the criterion."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On this screen, Delete looks like a frequently used action. Apply the rule \"the more frequent, the closer to the thumb\" as is, and Delete goes to the bottom. With just one item at the bottom, the screen gets simpler too. It's easy to believe you followed the criterion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面では、削除はよく使うアクションに見える。「頻度が高いほど親指の近くに」という基準をそのまま当てはめると、削除は下部に行く。下部にひとつだけ置けば、画面もシンプルになる。基準を守ったと思いやすい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个界面里，删除看起来是常用操作。如果直接套用“频率越高越靠近拇指”的标准，删除就会去底部。底部只放一个，界面也变简单了。很容易觉得自己守住了标准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這個介面裡，刪除看起來是常用操作。如果直接套用「頻率越高越靠近拇指」的標準，刪除就會去底部。底部只放一個，介面也變簡單了。很容易覺得自己守住了標準。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом экране «Удалить» выглядит часто используемым действием. Применяя правило «чем чаще, тем ближе к большому пальцу» как есть, вы отправляете «Удалить» вниз. С одним элементом внизу экран становится и проще. Легко поверить, что вы следовали критерию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta pantalla, Eliminar parece una acción de uso frecuente. Aplica la regla «cuanto más frecuente, más cerca del pulgar» tal cual, y Eliminar va abajo. Con un solo elemento abajo, la pantalla también se simplifica. Es fácil creer que seguiste el criterio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Bildschirm sieht Löschen wie eine häufig genutzte Aktion aus. Wendet man die Regel „je häufiger, desto näher am Daumen“ unverändert an, geht Löschen nach unten. Mit nur einem Element unten wird auch der Bildschirm einfacher. Man glaubt leicht, das Kriterium befolgt zu haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet écran, Supprimer ressemble à une action fréquemment utilisée. Appliquez telle quelle la règle « plus c'est fréquent, plus c'est près du pouce », et Supprimer va en bas. Avec un seul élément en bas, l'écran devient aussi plus simple. On croit facilement avoir suivi le critère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa schermata, Elimina sembra un'azione usata spesso. Applica così com'è la regola «più è frequente, più vicino al pollice» e Elimina finisce in basso. Con un solo elemento in basso, anche la schermata si semplifica. È facile credere di aver seguito il criterio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta tela, Excluir parece uma ação muito usada. Aplique como está a regra «quanto mais frequente, mais perto do polegar» e Excluir vai para baixo. Com um único item embaixo, a tela também fica mais simples. É fácil acreditar que você seguiu o critério."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้าจอนี้ ลบดูเหมือนการกระทำที่ใช้บ่อย ใช้กฎ \"ยิ่งบ่อย ยิ่งใกล้นิ้วโป้ง\" ตามเดิม ลบก็ไปอยู่ด้านล่าง เมื่อมีรายการเดียวที่ด้านล่าง หน้าจอก็เรียบง่ายขึ้นด้วย เชื่อได้ง่ายว่าคุณทำตามเกณฑ์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình này, Xóa trông như một hành động dùng thường xuyên. Áp nguyên quy tắc \"càng thường xuyên càng gần ngón cái\", Xóa xuống dưới. Chỉ một mục ở dưới thì màn hình cũng đơn giản hơn. Dễ tin rằng bạn đã theo đúng tiêu chí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na této obrazovce vypadá Smazat jako často používaná akce. Aplikujte pravidlo „čím častější, tím blíž palci“ tak, jak je, a Smazat jde dolů. S jedinou položkou dole je i obrazovka jednodušší. Snadno uvěříte, že jste se řídili kritériem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne skærm ligner Slet en hyppigt brugt handling. Anvend reglen »jo hyppigere, jo tættere på tommelfingeren« uændret, og Slet havner i bunden. Med kun ét element i bunden bliver skærmen også enklere. Det er let at tro, at du fulgte kriteriet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε αυτή την οθόνη, η Διαγραφή μοιάζει με συχνά χρησιμοποιούμενη ενέργεια. Εφάρμοσε τον κανόνα «όσο πιο συχνά, τόσο πιο κοντά στον αντίχειρα» ως έχει, και η Διαγραφή πάει κάτω. Με μόνο ένα στοιχείο κάτω, η οθόνη γίνεται επίσης απλούστερη. Είναι εύκολο να πιστέψεις ότι ακολούθησες το κριτήριο."
          }
        }
      }
    },
    "이 화면의 가장자리 효과를 hard로 바꾼다(`scrollEdgeEffectStyle`). 선명한 구분선이 바 영역과 콘텐츠를 나누고, 선 아래의 행은 온전히 읽힌다. 경계에 걸린 행을 두고 판단할 일이 없어진다. 같은 종류의 표 화면끼리는 hard로 통일해 둔다. 1.3.1 Soft 예제와 1.3.2 Hard 예제를 번갈아 열어 스크롤해 보면, 경계가 정보가 되는 순간이 어떤 건지 바로 보인다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch this screen's edge effect to hard (`scrollEdgeEffectStyle`). A crisp divider separates the bar area from the content, and rows below the line are fully readable. There's no longer any row at the boundary to puzzle over. Standardize on hard across table screens of the same kind. Open the 1.3.1 Soft and 1.3.2 Hard examples and scroll them alternately, and you'll see right away what it means for a boundary to become information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch this screen's edge effect to hard (`scrollEdgeEffectStyle`). A crisp divider separates the bar area from the content, and rows below the line are fully readable. There's no longer any row at the boundary to puzzle over. Standardise on hard across table screens of the same kind. Open the 1.3.1 Soft and 1.3.2 Hard examples and scroll them alternately, and you'll see right away what it means for a boundary to become information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面のエッジエフェクトを hard に変える（`scrollEdgeEffectStyle`）。くっきりした区切り線がバーの領域とコンテンツを分け、線より下の行は完全に読める。境界にかかった行をどうするか判断する必要がなくなる。同じ種類の表の画面同士は hard で統一しておく。1.3.1 Soft の例と 1.3.2 Hard の例を交互に開いてスクロールしてみると、境界が情報になる瞬間がどういうものか、すぐに分かる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这个界面的边缘效果改成 hard（`scrollEdgeEffectStyle`）。清晰的分隔线把栏区域和内容分开，线下面的行完整可读。不再需要对卡在边界的行做判断。同类的表格界面之间统一用 hard。交替打开并滚动 1.3.1 Soft 示例和 1.3.2 Hard 示例，立刻就能看到边界成为信息的那一刻是什么样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這個介面的邊緣效果改成 hard（`scrollEdgeEffectStyle`）。清晰的分隔線把列區域和內容分開，線下面的行完整可讀。不再需要對卡在邊界的行做判斷。同類的表格介面之間統一用 hard。交替開啟並滾動 1.3.1 Soft 示例和 1.3.2 Hard 示例，立刻就能看到邊界成為資訊的那一刻是什麼樣子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключите эффект края этого экрана на hard (`scrollEdgeEffectStyle`). Чёткий разделитель отделяет область панели от содержимого, и строки под линией полностью читаемы. На границе больше нет строки, над которой приходится ломать голову. Приведите табличные экраны одного типа к единому hard. Откройте примеры 1.3.1 Soft и 1.3.2 Hard и прокрутите их по очереди, и вы сразу увидите, что значит, когда граница становится информацией."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el efecto de borde de esta pantalla a hard (`scrollEdgeEffectStyle`). Un divisor nítido separa el área de la barra del contenido, y las filas bajo la línea son totalmente legibles. Ya no hay ninguna fila en el límite que haga dudar. Estandariza hard en las pantallas de tabla del mismo tipo. Abre los ejemplos 1.3.1 Soft y 1.3.2 Hard y desplázalos alternando, y verás enseguida qué significa que un límite pase a ser información."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle den Kanteneffekt dieses Bildschirms auf hard (`scrollEdgeEffectStyle`). Eine klare Trennlinie scheidet den Leistenbereich vom Inhalt, und die Zeilen unter der Linie sind vollständig lesbar. An der Grenze gibt es keine Zeile mehr, über die man rätseln müsste. Vereinheitliche hard auf Tabellenbildschirmen derselben Art. Öffne die Beispiele 1.3.1 Soft und 1.3.2 Hard und scrolle sie abwechselnd, und du siehst sofort, was es heißt, wenn eine Grenze zur Information wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez l'effet de bord de cet écran sur hard (`scrollEdgeEffectStyle`). Un séparateur net distingue la zone de barre du contenu, et les lignes sous la ligne sont entièrement lisibles. Il n'y a plus de ligne à la limite sur laquelle s'interroger. Uniformisez hard sur les écrans de tableaux de même type. Ouvrez les exemples 1.3.1 Soft et 1.3.2 Hard et faites-les défiler en alternance, et vous verrez aussitôt ce que signifie qu'une limite devienne de l'information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa l'effetto sul bordo di questa schermata a hard (`scrollEdgeEffectStyle`). Una linea di divisione netta separa l'area della barra dal contenuto e le righe sotto la linea sono perfettamente leggibili. Non c'è più nessuna riga sul confine da interrogarsi. Standardizza su hard le schermate a tabella dello stesso tipo. Apri gli esempi 1.3.1 Soft e 1.3.2 Hard e scorrili in alternanza, e vedrai subito che cosa significa per un confine diventare informazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o efeito de borda desta tela para hard (`scrollEdgeEffectStyle`). Uma linha divisória nítida separa a área da barra do conteúdo, e as linhas abaixo da linha ficam plenamente legíveis. Já não há nenhuma linha na fronteira para intrigar. Padronize em hard as telas de tabela do mesmo tipo. Abra os exemplos 1.3.1 Soft e 1.3.2 Hard e role-os alternadamente, e você verá de imediato o que significa uma fronteira se tornar informação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับเอฟเฟกต์ขอบของหน้าจอนี้เป็น hard (`scrollEdgeEffectStyle`) เส้นคั่นที่คมชัดแยกพื้นที่แถบออกจากเนื้อหา และแถวใต้เส้นอ่านออกครบ ไม่มีแถวที่ขอบเขตให้งงอีก ทำให้เป็นมาตรฐาน hard บนหน้าจอตารางชนิดเดียวกัน เปิดตัวอย่าง 1.3.1 Soft และ 1.3.2 Hard แล้วเลื่อนสลับกัน คุณจะเห็นทันทีว่าการที่ขอบเขตกลายเป็นข้อมูลหมายถึงอะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển hiệu ứng cạnh của màn hình này sang hard (`scrollEdgeEffectStyle`). Một đường phân cách sắc nét ngăn vùng thanh với nội dung, và các dòng dưới đường kẻ đọc được trọn vẹn. Không còn dòng nào ở ranh giới để phải đoán. Chuẩn hóa hard trên các màn hình bảng cùng loại. Mở ví dụ 1.3.1 Soft và 1.3.2 Hard rồi cuộn xen kẽ, bạn sẽ thấy ngay ranh giới trở thành thông tin nghĩa là gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepněte okrajový efekt této obrazovky na hard (`scrollEdgeEffectStyle`). Ostrá dělicí čára odděluje oblast panelu od obsahu a řádky pod čárou jsou plně čitelné. Na hranici už není žádný řádek, nad kterým by se dalo přemýšlet. Standardizujte hard napříč obrazovkami tabulek stejného druhu. Otevřete příklady 1.3.1 Soft a 1.3.2 Hard a posouvejte je střídavě a hned uvidíte, co znamená, že se hranice stane informací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift denne skærms kanteffekt til hard (`scrollEdgeEffectStyle`). En skarp skillelinje adskiller bjælkeområdet fra indholdet, og rækker under linjen er fuldt læselige. Der er ikke længere nogen række ved grænsen at undre sig over. Standardisér på hard på tværs af tabelskærme af samme slags. Åbn eksemplerne 1.3.1 Soft og 1.3.2 Hard og scroll dem vekslende, og du ser straks, hvad det betyder, at en grænse bliver information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε το εφέ άκρης αυτής της οθόνης σε hard (`scrollEdgeEffectStyle`). Μια καθαρή γραμμή διαχωρισμού χωρίζει την περιοχή της γραμμής από το περιεχόμενο, και οι γραμμές κάτω από τη γραμμή είναι πλήρως ευανάγνωστες. Δεν υπάρχει πια γραμμή στο όριο για να σε προβληματίζει. Τυποποίησε το hard σε οθόνες πινάκων του ίδιου είδους. Άνοιξε τα παραδείγματα 1.3.1 Soft και 1.3.2 Hard και κύλισέ τα εναλλάξ, και θα δεις αμέσως τι σημαίνει να γίνεται το όριο πληροφορία."
          }
        }
      }
    },
    "이건 \"이렇게 쓰라\"보다 **\"이만큼 넣으면 시스템이 어떻게 처리하는지\"**를 보여주는 케이스. 실제로 5개가 필요하면 제목·아이템의 공간 협상과 overflow 동작을 여기서 확인.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This case is less \"do it this way\" and more **\"here's how the system handles it when you put in this much.\"** If you really need five, use it to check how the title and items negotiate for space and how overflow behaves."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This case is less \"do it this way\" and more **\"here's how the system handles it when you put in this much.\"** If you really need five, use it to check how the title and items negotiate for space and how overflow behaves."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは「こう使え」というより、**「これだけ入れるとシステムがどう処理するか**」を見せるケース。実際に5つ必要なら、タイトルとアイテムのスペースの交渉とoverflowの動作をここで確認する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是展示**“放这么多系统会怎么处理”**而不是“要这样用”的案例。如果真的需要 5 个，请在这里确认标题与项目的空间协商和 overflow 行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是展示**「放這麼多系統會怎麼處理」**而不是「要這樣用」的案例。如果真的需要 5 個，請在這裡確認標題與項目的空間協商和 overflow 行為。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот случай скорее не «делайте так», а **«вот как система справляется, когда вы кладёте столько»**. Если вам правда нужно пять, используйте его, чтобы проверить, как заголовок и элементы договариваются о месте и как ведёт себя переполнение."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este caso va menos de «hazlo así» y más de **«así lo gestiona el sistema cuando metes tanto».** Si de verdad necesitas cinco, úsalo para comprobar cómo negocian el espacio el título y los elementos y cómo se comporta el desbordamiento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Fall ist weniger „mach es so“, sondern **„so geht das System damit um, wenn man so viele hineinsetzt“.** Brauchst du wirklich fünf, nutze ihn, um zu prüfen, wie Titel und Elemente um Platz verhandeln und wie sich der Überlauf verhält."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce cas est moins « faites ainsi » que **« voici comment le système gère les choses quand on en met autant ».** Si vous en avez vraiment besoin de cinq, servez-vous-en pour vérifier comment le titre et les éléments négocient l'espace et comment se comporte le débordement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo caso è meno un «fai così» e più **«ecco come lo gestisce il sistema quando ne metti così tanti».** Se te ne servono davvero cinque, usalo per verificare come titolo ed elementi negoziano lo spazio e come si comporta l'overflow."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este caso é menos um «faça assim» e mais **«veja como o sistema lida quando você põe tanta coisa».** Se você realmente precisa de cinco, use-o para conferir como o título e os itens negociam espaço e como o overflow se comporta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรณีนี้เป็น**\"นี่คือวิธีที่ระบบจัดการเมื่อใส่มากขนาดนี้\"** มากกว่า \"ทำแบบนี้\" ถ้าต้องการห้าจริง ๆ ให้ใช้ตรวจว่าชื่อเรื่องกับรายการต่อรองพื้นที่อย่างไรและส่วนเกินทำงานอย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trường hợp này ít là \"hãy làm thế này\" mà là **\"đây là cách hệ thống xử lý khi bạn đưa vào chừng này.\"** Nếu thật sự cần năm, hãy dùng nó để kiểm tra tiêu đề và các mục thương lượng chỗ ra sao và phần tràn hoạt động thế nào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento případ není tolik „dělejte to takto“, ale spíš **„takto to systém zvládne, když dáte tolik.“** Pokud opravdu potřebujete pět, použijte to k ověření, jak spolu nadpis a položky vyjednávají o místo a jak se chová přetečení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette tilfælde handler mindre om »gør det sådan her« og mere om **»sådan håndterer systemet det, når du lægger så meget ind.«** Hvis du virkelig har brug for fem, så brug det til at tjekke, hvordan titlen og elementerne forhandler om plads, og hvordan overløb opfører sig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η περίπτωση αφορά λιγότερο το «κάν' το έτσι» και περισσότερο **«έτσι το χειρίζεται το σύστημα όταν βάλεις τόσα».** Αν πραγματικά χρειάζεσαι πέντε, χρησιμοποίησέ το για να δεις πώς διαπραγματεύονται ο τίτλος και τα στοιχεία τον χώρο και πώς συμπεριφέρεται το υπερχείλισμα."
          }
        }
      }
    },
    "이니셜 아바타에 .abbreviated 스타일 활용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the .abbreviated style for initials avatars"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Using the .abbreviated style for initials avatars"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イニシャルのアバターに.abbreviatedスタイルを活用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给首字母头像使用 .abbreviated 样式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給首字母頭像使用 .abbreviated 樣式"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применение стиля .abbreviated для аватаров с инициалами"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar el estilo .abbreviated para avatares de iniciales"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Stil .abbreviated für Initialen-Avatare nutzen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le style .abbreviated pour les avatars à initiales"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usare lo stile .abbreviated per gli avatar con iniziali"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar o estilo .abbreviated para avatares com iniciais"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สไตล์ .abbreviated สำหรับอวาตาร์ตัวอักษรย่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng style .abbreviated cho avatar chữ cái đầu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použití stylu .abbreviated pro avatary s iniciálami"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At bruge stilen .abbreviated til initialavatarer"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήση του στυλ .abbreviated για avatars με αρχικά"
          }
        }
      }
    },
    "이니셜 추출 규칙조차 문화권마다 다르므로 직접 substring 하지 않고 시스템에 위임.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even the rules for extracting initials vary by culture, so don't take a substring yourself; leave it to the system."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Even the rules for extracting initials vary by culture, so don't take a substring yourself; leave it to the system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イニシャルの取り出し方さえ文化圏ごとに違うので、自分でsubstringせずシステムに任せる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连首字母的提取规则也因文化圈而异，所以不要自己 substring，而是委托给系统。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連首字母的提取規則也因文化圈而異，所以不要自己 substring，而是委託給系統。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже правила получения инициалов различаются по культурам, поэтому не берите подстроку сами; доверьте это системе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso las reglas para sacar las iniciales varían según la cultura, así que no tomes una subcadena tú mismo; déjalo al sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch die Regeln zur Gewinnung von Initialen unterscheiden sich je nach Kultur, also nimm nicht selbst einen Teilstring; überlasse es dem System."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même les règles d'extraction des initiales varient selon la culture, donc ne prenez pas vous-même une sous-chaîne ; laissez-le au système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le regole per estrarre le iniziali cambiano da cultura a cultura, quindi non prendere tu una sottostringa; lascialo al sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até as regras para extrair iniciais variam conforme a cultura, então não pegue você mesmo uma substring; deixe com o sistema."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้กฎการดึงตัวอักษรย่อก็ต่างกันตามวัฒนธรรม ดังนั้นอย่าตัดสตริงย่อยเอง ปล่อยให้ระบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay cả quy tắc lấy chữ cái đầu cũng khác theo văn hóa, nên đừng tự cắt chuỗi con; hãy để hệ thống lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I pravidla pro získání iniciál se liší podle kultury, takže si nevytahujte podřetězec sami; nechte to na systému."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv reglerne for at udtrække initialer varierer med kulturen, så tag ikke selv en delstreng; overlad det til systemet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμα και οι κανόνες εξαγωγής αρχικών διαφέρουν ανά πολιτισμό, οπότε μην παίρνεις μόνος σου υποσυμβολοσειρά· άφησέ το στο σύστημα."
          }
        }
      }
    },
    "이동 구조가 실제 목적과 맞는가? 시트에서는 **이것이 확정하는 순간인가**로 묻는다. 확정이라면 그 순간의 값은 잠겨 있어야 한다. 모달의 본질이 \"응답을 요구하고 나머지를 차단\"하는 것인 이유다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does the navigation structure match the actual goal? For sheets, ask **whether this is the moment of commitment**. If it is, the values at that moment must be locked. That's why the essence of a modal is to \"demand a response and block everything else.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Does the navigation structure match the actual goal? For sheets, ask **whether this is the moment of commitment**. If it is, the values at that moment must be locked. That's why the essence of a modal is to \"demand a response and block everything else.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動の構造は実際の目的に合っているか？ シートでは**これは確定する瞬間か**と問う。確定なら、その瞬間の値はロックされていなければならない。モーダルの本質が「応答を求め、ほかを遮断する」ことである理由だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航结构与实际目的相符吗？在弹层里，问的是**这是不是确认的时刻**。如果是确认，那一刻的值就必须被锁住。这就是模态的本质是“要求回应并屏蔽其余”的原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導覽結構與實際目的相符嗎？在工作表裡，問的是**這是不是確認的時刻**。如果是確認，那一刻的值就必須被鎖住。這就是模態的本質是「要求回應並遮蔽其餘」的原因。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соответствует ли структура навигации реальной цели? Для шторок спросите, **не момент ли это принятия решения**. Если да, значения в этот момент должны быть заблокированы. Потому суть модального окна в том, чтобы «требовать ответа и блокировать всё остальное»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Coincide la estructura de navegación con el objetivo real? En las hojas, pregunta **si este es el momento de la confirmación**. Si lo es, los valores de ese momento deben estar bloqueados. Por eso la esencia de un modal es «exigir una respuesta y bloquear todo lo demás»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt die Navigationsstruktur zum tatsächlichen Ziel? Bei Sheets frage, **ob dies der Moment der Verbindlichkeit ist**. Wenn ja, müssen die Werte in diesem Moment gesperrt sein. Deshalb ist das Wesen eines Modals, „eine Antwort zu verlangen und alles andere zu sperren“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La structure de navigation correspond-elle à l'objectif réel ? Pour les feuilles, demandez **si c'est le moment de l'engagement**. Si oui, les valeurs à ce moment doivent être verrouillées. C'est pourquoi l'essence d'une modale est d'« exiger une réponse et de bloquer tout le reste »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La struttura di navigazione corrisponde all'obiettivo reale? Per i fogli, chiediti **se questo è il momento dell'impegno**. Se lo è, i valori in quel momento devono essere bloccati. Per questo l'essenza di un modale è «esigere una risposta e bloccare tutto il resto»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A estrutura de navegação combina com o objetivo real? Para as folhas, pergunte **se este é o momento do compromisso**. Se for, os valores nesse momento precisam estar travados. Por isso a essência de um modal é «exigir uma resposta e bloquear todo o resto»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โครงสร้างการนำทางตรงกับเป้าหมายจริงหรือไม่ สำหรับชีต ให้ถาม**ว่านี่คือจังหวะของการยืนยันหรือไม่** ถ้าใช่ ค่าในจังหวะนั้นต้องถูกล็อก นั่นคือเหตุผลที่แก่นของโมดัลคือ \"เรียกร้องการตอบสนองและบล็อกทุกอย่างอื่น\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu trúc điều hướng có khớp mục tiêu thực không? Với sheet, hãy hỏi **đây có phải khoảnh khắc cam kết không**. Nếu có, các giá trị lúc đó phải được khóa. Đó là lý do bản chất của modal là \"đòi một phản hồi và chặn mọi thứ khác.\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídá navigační struktura skutečnému cíli? U sheetů se zeptejte, **zda je toto okamžik závazku**. Pokud ano, hodnoty v tu chvíli musejí být zamčené. Proto je podstata modalu „vyžadovat odpověď a blokovat všechno ostatní“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer navigationsstrukturen til det faktiske mål? For ark, spørg **om dette er forpligtelsens øjeblik**. Hvis det er, skal værdierne i det øjeblik være låst. Derfor er en modals essens at »kræve et svar og blokere alt andet.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταιριάζει η δομή πλοήγησης στον πραγματικό στόχο; Για τα φύλλα, ρώτα **αν αυτή είναι η στιγμή της δέσμευσης**. Αν είναι, οι τιμές εκείνη τη στιγμή πρέπει να είναι κλειδωμένες. Γι' αυτό η ουσία ενός modal είναι να «απαιτεί απάντηση και να μπλοκάρει όλα τα άλλα»."
          }
        }
      }
    },
    "이동 구조가 실제 목적과 맞는가? 화면 위의 바에서는 **콘텐츠가 바의 존재를 아는가**로 묻는다. 바가 차지한 자리만큼 콘텐츠가 비켜나야 한다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does the navigation structure match its actual purpose? For a bar on top of the screen, ask: **does the content know the bar is there?** The content needs to move aside by exactly the space the bar takes up."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Does the navigation structure match its actual purpose? For a bar on top of the screen, ask: **does the content know the bar is there?** The content needs to move aside by exactly the space the bar takes up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションの構造は実際の目的と合っているか。画面上部のバーについては、**コンテンツがバーの存在を知っているか**と問う。バーが占める分だけ、コンテンツがよけなければならない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航结构与实际目的相符吗？在界面上方的栏里，问的是**内容知不知道栏的存在**。栏占了多少位置，内容就要让开多少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導覽結構與實際目的相符嗎？在介面上方的列裡，問的是**內容知不知道列的存在**。列佔了多少位置，內容就要讓開多少。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соответствует ли структура навигации реальному назначению? Для панели вверху экрана спросите: **знает ли содержимое, что панель там есть?** Содержимое должно сдвинуться ровно на место, которое занимает панель."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Coincide la estructura de navegación con su propósito real? Para una barra en la parte superior de la pantalla, pregunta: **¿sabe el contenido que la barra está ahí?** El contenido tiene que apartarse exactamente el espacio que ocupa la barra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt die Navigationsstruktur zu ihrem tatsächlichen Zweck? Bei einer Leiste oben auf dem Bildschirm frage: **Weiß der Inhalt, dass die Leiste da ist?** Der Inhalt muss genau um den Platz ausweichen, den die Leiste einnimmt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La structure de navigation correspond-elle à son but réel ? Pour une barre en haut de l'écran, demandez : **le contenu sait-il que la barre est là ?** Le contenu doit s'écarter exactement de la place que prend la barre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La struttura di navigazione corrisponde allo scopo reale? Per una barra in cima alla schermata, chiediti: **il contenuto sa che la barra c'è?** Il contenuto deve spostarsi di lato esattamente dello spazio che la barra occupa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A estrutura de navegação combina com o propósito real? Para uma barra no topo da tela, pergunte: **o conteúdo sabe que a barra está ali?** O conteúdo precisa se afastar exatamente o espaço que a barra ocupa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โครงสร้างการนำทางตรงกับวัตถุประสงค์จริงหรือไม่ สำหรับแถบที่ด้านบนของหน้าจอ ให้ถาม: **เนื้อหารู้ไหมว่ามีแถบอยู่** เนื้อหาต้องเลี่ยงออกไปเท่ากับที่แถบกินพอดี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu trúc điều hướng có khớp mục đích thực không? Với thanh ở trên màn hình, hãy hỏi: **nội dung có biết thanh ở đó không?** Nội dung cần dời đi đúng bằng chỗ thanh chiếm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídá navigační struktura skutečnému účelu? U panelu nahoře na obrazovce se zeptejte: **ví obsah, že tam panel je?** Obsah se musí odsunout přesně o místo, které panel zabírá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer navigationsstrukturen til det faktiske formål? For en bjælke øverst på skærmen, spørg: **ved indholdet, at bjælken er der?** Indholdet skal flytte sig til side med præcis den plads, bjælken optager."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταιριάζει η δομή πλοήγησης στον πραγματικό σκοπό; Για μια γραμμή στην κορυφή της οθόνης, ρώτα: **ξέρει το περιεχόμενο ότι η γραμμή είναι εκεί;** Το περιεχόμενο πρέπει να παραμερίσει ακριβώς όσο χώρο καταλαμβάνει η γραμμή."
          }
        }
      }
    },
    "이동 구조가 실제 목적지와 맞는가? 덮는 화면에서는 **나가는 길이 눈에 보이는가**로 묻는다. 시트의 습관은 여기서 통하지 않는다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does the navigation structure match where people actually need to go? For a covering screen, ask: **is the way out visible?** Sheet habits don't apply here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Does the navigation structure match where people actually need to go? For a covering screen, ask: **is the way out visible?** Sheet habits don't apply here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションの構造は実際の行き先と合っているか。画面を覆う場合は、**出口が目に見えるか**と問う。シートの習慣はここでは通じない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航结构与实际目的地相符吗？在覆盖式界面里，问的是**退出的路看不看得见**。弹层的习惯在这里行不通。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導覽結構與實際目的地相符嗎？在覆蓋式介面裡，問的是**退出的路看不看得見**。工作表的習慣在這裡行不通。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соответствует ли структура навигации тому, куда людям на самом деле нужно попасть? Для закрывающего экрана спросите: **виден ли выход?** Привычки шторок здесь не работают."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Coincide la estructura de navegación con adónde la gente necesita ir realmente? Para una pantalla que cubre, pregunta: **¿se ve la salida?** Los hábitos de las hojas no valen aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt die Navigationsstruktur dazu, wohin Menschen tatsächlich müssen? Bei einem abdeckenden Bildschirm frage: **Ist der Ausgang sichtbar?** Sheet-Gewohnheiten gelten hier nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La structure de navigation correspond-elle à l'endroit où les gens ont réellement besoin d'aller ? Pour un écran qui recouvre, demandez : **la sortie est-elle visible ?** Les habitudes des feuilles ne s'appliquent pas ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La struttura di navigazione corrisponde a dove le persone hanno davvero bisogno di andare? Per una schermata di copertura, chiediti: **la via d'uscita è visibile?** Le abitudini dei fogli qui non valgono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A estrutura de navegação combina com aonde as pessoas realmente precisam ir? Para uma tela de cobertura, pergunte: **a saída está visível?** Os hábitos das folhas não valem aqui."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โครงสร้างการนำทางตรงกับที่ที่คนต้องไปจริงหรือไม่ สำหรับหน้าจอที่คลุม ให้ถาม: **ทางออกมองเห็นไหม** นิสัยแบบชีตใช้ไม่ได้ที่นี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu trúc điều hướng có khớp nơi người ta thực sự cần đến không? Với màn hình che phủ, hãy hỏi: **lối thoát có nhìn thấy không?** Thói quen sheet không áp dụng ở đây."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídá navigační struktura tomu, kam lidé skutečně potřebují jít? U zakrývající obrazovky se zeptejte: **je vidět cesta ven?** Zvyky ze sheetu tu neplatí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer navigationsstrukturen til, hvor folk faktisk har brug for at gå hen? For en skærm, der dækker, spørg: **er vejen ud synlig?** Arkvaner gælder ikke her."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταιριάζει η δομή πλοήγησης στο πού πραγματικά χρειάζεται να πάνε οι άνθρωποι; Για μια οθόνη που καλύπτει, ρώτα: **είναι ορατή η διέξοδος;** Οι συνήθειες των φύλλων δεν ισχύουν εδώ."
          }
        }
      }
    },
    "이동 구조가 실제 사용 빈도·목적지와 맞는가? 메뉴에서는 **원하는 항목까지 몇 번을 여는가**로 묻는다. 메뉴 안의 서브메뉴는 한 단까지. 그보다 깊어야 한다면 구조를 다시 짠다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does the navigation structure match actual frequency of use and destinations? For menus, ask: **how many times do people have to open something to reach the item they want?** Keep submenus inside a menu to one level. If it needs to go deeper, rethink the structure."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Does the navigation structure match actual frequency of use and destinations? For menus, ask: **how many times do people have to open something to reach the item they want?** Keep submenus inside a menu to one level. If it needs to go deeper, rethink the structure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションの構造は、実際の使用頻度や行き先と合っているか。メニューでは、**目的の項目まで何回開くか**と問う。メニューの中のサブメニューは1段まで。それより深くする必要があるなら、構造を組み直す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航结构与实际使用频率 · 目的地相符吗？在菜单里，问的是**到想要的项目要打开几次**。菜单里的子菜单只做一层。需要更深，就重新设计结构。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導覽結構與實際使用頻率 · 目的地相符嗎？在選單裡，問的是**到想要的項目要開啟幾次**。選單裡的子選單隻做一層。需要更深，就重新設計結構。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соответствует ли структура навигации реальной частоте использования и местам назначения? Для меню спросите: **сколько раз людям приходится что-то открыть, чтобы добраться до нужного пункта?** Держите подменю внутри меню в один уровень. Если нужно глубже, пересмотрите структуру."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Coincide la estructura de navegación con la frecuencia de uso y los destinos reales? Para los menús, pregunta: **¿cuántas veces tiene que abrir algo la gente para llegar al elemento que quiere?** Mantén los submenús dentro de un menú a un nivel. Si tiene que ir más hondo, replantea la estructura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt die Navigationsstruktur zur tatsächlichen Nutzungshäufigkeit und zu den Zielen? Bei Menüs frage: **Wie oft müssen Menschen etwas öffnen, um zum gewünschten Eintrag zu gelangen?** Halte Untermenüs innerhalb eines Menüs auf eine Ebene. Muss es tiefer gehen, überdenke die Struktur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La structure de navigation correspond-elle à la fréquence d'usage et aux destinations réelles ? Pour les menus, demandez : **combien de fois les gens doivent-ils ouvrir quelque chose pour atteindre l'élément voulu ?** Limitez les sous-menus d'un menu à un niveau. S'il faut aller plus profond, repensez la structure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La struttura di navigazione corrisponde alla frequenza d'uso e alle destinazioni reali? Per i menu, chiediti: **quante volte le persone devono aprire qualcosa per raggiungere la voce che vogliono?** Tieni i sottomenu dentro un menu a un solo livello. Se deve andare più in profondità, ripensa la struttura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A estrutura de navegação combina com a frequência de uso e os destinos reais? Para menus, pergunte: **quantas vezes as pessoas precisam abrir algo para chegar ao item que querem?** Mantenha os submenus dentro de um menu em um nível. Se precisa ir mais fundo, repense a estrutura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โครงสร้างการนำทางตรงกับความถี่ในการใช้และจุดหมายจริงหรือไม่ สำหรับเมนู ให้ถาม: **คนต้องเปิดอะไรกี่ครั้งเพื่อไปถึงรายการที่ต้องการ** คงเมนูย่อยในเมนูไว้หนึ่งระดับ ถ้าต้องลึกกว่านั้น ให้คิดโครงสร้างใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu trúc điều hướng có khớp tần suất dùng và điểm đến thực không? Với menu, hãy hỏi: **người ta phải mở bao nhiêu lần để tới mục mình muốn?** Giữ menu con trong menu ở một cấp. Nếu cần sâu hơn, hãy nghĩ lại cấu trúc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídá navigační struktura skutečné frekvenci používání a cílům? U nabídek se zeptejte: **kolikrát musejí lidé něco otevřít, aby se dostali k požadované položce?** Podnabídky uvnitř nabídky držte na jedné úrovni. Pokud je třeba jít hlouběji, přehodnoťte strukturu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer navigationsstrukturen til den faktiske brugshyppighed og de faktiske destinationer? For menuer, spørg: **hvor mange gange må folk åbne noget for at nå det element, de vil have?** Hold undermenuer inde i en menu til ét niveau. Hvis det skal gå dybere, så gentænk strukturen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταιριάζει η δομή πλοήγησης στην πραγματική συχνότητα χρήσης και στους προορισμούς; Για τα μενού, ρώτα: **πόσες φορές πρέπει να ανοίξουν οι άνθρωποι κάτι για να φτάσουν στο στοιχείο που θέλουν;** Κράτα τα υπομενού μέσα σε ένα μενού σε ένα επίπεδο. Αν πρέπει να πάει βαθύτερα, ξανασκέψου τη δομή."
          }
        }
      }
    },
    "이동 구조가 실제 사용 빈도·목적지와 어긋난다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The navigation structure doesn't match how often things are actually used or where people actually go"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The navigation structure doesn't match how often things are actually used or where people actually go"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ナビゲーションの構造が、実際の利用頻度や行き先と食い違っている"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导航结构与实际使用频率 · 目的地不符"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導覽結構與實際使用頻率 · 目的地不符"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Структура навигации не соответствует тому, как часто всем пользуются и куда люди на самом деле идут"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estructura de navegación no coincide con la frecuencia con que se usan las cosas ni con adónde va realmente la gente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Navigationsstruktur passt nicht dazu, wie oft Dinge tatsächlich genutzt werden oder wohin Menschen tatsächlich gehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La structure de navigation ne correspond pas à la fréquence réelle d'usage ni aux endroits où les gens vont vraiment"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La struttura di navigazione non corrisponde a quanto spesso le cose vengono usate davvero né a dove le persone vanno davvero"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A estrutura de navegação não combina com a frequência real de uso das coisas nem com aonde as pessoas realmente vão"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โครงสร้างการนำทางไม่ตรงกับความถี่ที่ใช้จริงหรือที่ที่คนไปจริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu trúc điều hướng không khớp với tần suất dùng thực và nơi người ta thực sự đến"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigační struktura neodpovídá tomu, jak často se věci skutečně používají nebo kam lidé skutečně chodí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigationsstrukturen passer ikke til, hvor ofte tingene faktisk bruges, eller hvor folk faktisk går hen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η δομή πλοήγησης δεν ταιριάζει με το πόσο συχνά χρησιμοποιούνται πραγματικά τα πράγματα ή πού πηγαίνουν πραγματικά οι άνθρωποι"
          }
        }
      }
    },
    "이동과 상태의 역할 혼동": {
