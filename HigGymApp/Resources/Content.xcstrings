        }
      }
    },
    "정렬·공유·설정·삭제를 한 유리 캡슐에 붙이면 사용자는 \"한 세트\"로 읽음. 묶음이 거짓 정보가 되어 인지 부담 증가": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach Sort, Share, Settings and Delete to one glass capsule and users read them as \"one set.\" The grouping becomes false information and adds cognitive load"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach Sort, Share, Settings and Delete to one glass capsule and users read them as \"one set.\" The grouping becomes false information and adds cognitive load"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替え・共有・設定・削除をひとつのガラスカプセルにまとめると、ユーザーは「ひとつのセット」として読む。まとまりが偽の情報になり、認知負荷が増える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把排序 · 分享 · 设置 · 删除贴进同一个玻璃胶囊，用户会读成“一组”。分组成了假信息，认知负担增加"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把排序 · 分享 · 設定 · 刪除貼進同一個玻璃膠囊，使用者會讀成「一組」。分組成了假資訊，認知負擔增加"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикрепите «Сортировку», «Поделиться», «Настройки» и «Удалить» к одной стеклянной капсуле, и пользователи прочтут их как «один набор». Группировка превращается в ложную информацию и добавляет когнитивную нагрузку"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Une Ordenar, Compartir, Ajustes y Eliminar a una cápsula de cristal y los usuarios los leerán como «un conjunto». La agrupación se convierte en información falsa y añade carga cognitiva"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hängt man Sortieren, Teilen, Einstellungen und Löschen an eine Glaskapsel, lesen Nutzer sie als „ein Set“. Die Gruppierung wird zur falschen Information und erhöht die kognitive Last"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rattachez Trier, Partager, Réglages et Supprimer à une seule capsule de verre et les utilisateurs les lisent comme « un seul ensemble ». Le regroupement devient une fausse information et ajoute de la charge cognitive"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attacca Ordina, Condividi, Impostazioni ed Elimina a un'unica capsula di vetro e gli utenti li leggono come «un insieme». Il raggruppamento diventa informazione falsa e aggiunge carico cognitivo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenda Ordenar, Compartilhar, Ajustes e Excluir a uma cápsula de vidro e os usuários os leem como «um conjunto». O agrupamento vira informação falsa e soma carga cognitiva"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผูกเรียงลำดับ แชร์ การตั้งค่า และลบเข้ากับแคปซูลกระจกเดียว แล้วผู้ใช้อ่านว่า \"ชุดเดียว\" การจัดกลุ่มกลายเป็นข้อมูลเท็จและเพิ่มภาระทางความคิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gắn Sắp xếp, Chia sẻ, Cài đặt và Xóa vào một capsule kính và người dùng đọc chúng là \"một bộ.\" Việc gom nhóm trở thành thông tin sai và thêm gánh nặng nhận thức"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte Seřadit, Sdílet, Nastavení a Smazat k jedné skleněné kapsli a uživatelé je čtou jako „jednu sadu“. Seskupení se stává nepravdivou informací a přidává kognitivní zátěž"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt Sortér, Del, Indstillinger og Slet i én glaskapsel, og brugerne læser dem som »ét sæt.« Grupperingen bliver falsk information og lægger kognitiv belastning på"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κόλλα Ταξινόμηση, Κοινοποίηση, Ρυθμίσεις και Διαγραφή σε μία κάψουλα γυαλιού και οι χρήστες τα διαβάζουν ως «ένα σετ». Η ομαδοποίηση γίνεται ψευδής πληροφορία και προσθέτει γνωστικό φορτίο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitä Lajittele, Jaa, Asetukset ja Poista yhteen lasikapseliin, ja käyttäjät lukevat ne ”yhdeksi kokonaisuudeksi”. Ryhmittelystä tulee väärää tietoa, ja se lisää kognitiivista kuormaa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempelkan Urutkan, Bagikan, Pengaturan, dan Hapus ke satu kapsul kaca dan pengguna membacanya sebagai \"satu set.\" Pengelompokan menjadi informasi palsu dan menambah beban kognitif"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fest Sorter, Del, Innstillinger og Slett til én glasskapsel, og brukerne leser dem som «ett sett». Grupperingen blir falsk informasjon og øker den kognitive belastningen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel Sorteer, Deel, Instellingen en Verwijder aan één glazen capsule en gebruikers lezen ze als \"één set\". De groepering wordt valse informatie en voegt cognitieve last toe"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podepnij Sortuj, Udostępnij, Ustawienia i Usuń do jednej szklanej kapsuły, a użytkownicy odczytają je jako „jeden zestaw”. Grupowanie staje się fałszywą informacją i zwiększa obciążenie poznawcze"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fäst Sortera, Dela, Inställningar och Radera på en glaskapsel och användare läser dem som ”en uppsättning”. Grupperingen blir falsk information och ökar den kognitiva belastningen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırala, Paylaş, Ayarlar ve Sil'i tek bir cam kapsüle bağlarsan kullanıcılar bunları “tek bir set” olarak okur. Gruplama yanlış bilgiye dönüşür ve bilişsel yük ekler"
          }
        }
      }
    },
    "정보 구조상 6개가 불가피할 때 시스템의 자동 축약을 수용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting the system's automatic condensing when six is truly unavoidable in the information architecture"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting the system's automatic condensing when six is truly unavoidable in the information architecture"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報構造上6個が避けられないとき、システムによる自動の集約を受け入れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信息结构上 6 个不可避免时，接受系统的自动缩减"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資訊結構上 6 個不可避免時，接受系統的自動縮減"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согласие с автоматическим сжатием системой, когда шесть элементов действительно неизбежны в информационной архитектуре"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar el plegado automático del sistema cuando seis es realmente inevitable en la arquitectura de la información"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das automatische Zusammenstauchen des Systems akzeptieren, wenn sechs in der Informationsarchitektur wirklich unvermeidbar sind"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter le resserrement automatique du système quand six est vraiment inévitable dans l'architecture de l'information"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accettare la compressione automatica del sistema quando sei è davvero inevitabile nell'architettura dell'informazione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceitar a condensação automática do sistema quando seis é realmente inevitável na arquitetura da informação"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอมรับการบีบอัดอัตโนมัติของระบบเมื่อหกเป็นสิ่งที่เลี่ยงไม่ได้จริง ๆ ในสถาปัตยกรรมข้อมูล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chấp nhận việc hệ thống tự động cô đọng khi sáu thật sự không tránh được trong kiến trúc thông tin"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přijetí automatického zhušťování systému, když je šest v informační architektuře skutečně nevyhnutelných"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At acceptere systemets automatiske sammentrækning, når seks virkelig er uundgåeligt i informationsarkitekturen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποδοχή της αυτόματης συμπύκνωσης του συστήματος όταν το έξι είναι πραγματικά αναπόφευκτο στην αρχιτεκτονική πληροφορίας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmän automaattisen tiivistyksen hyväksyminen, kun kuusi on todella väistämätön tietoarkkitehtuurissa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerima penyederhanaan otomatis sistem saat enam benar-benar tak terelakkan dalam arsitektur informasi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å akseptere systemets automatiske sammentrekking når seks virkelig er uunngåelig i informasjonsarkitekturen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De automatische samenvoeging door het systeem accepteren wanneer zes echt onvermijdelijk is in de informatiearchitectuur"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaakceptowanie automatycznego skondensowania przez system, gdy sześć jest naprawdę nieuniknione w architekturze informacji"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att acceptera systemets automatiska ihoptryckning när sex verkligen är oundvikligt i informationsarkitekturen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgi mimarisinde altı gerçekten kaçınılmazken sistemin otomatik daraltmasını kabul etmek"
          }
        }
      }
    },
    "정작 필요한 끝이 잘림": {
