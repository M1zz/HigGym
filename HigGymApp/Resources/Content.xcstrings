            "value": "Handling langt fra sit mål"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενέργεια μακριά από τον στόχο της"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toiminto kaukana kohteestaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksi jauh dari sasarannya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Handling langt fra målet"
          }
        },
        "nl": {
