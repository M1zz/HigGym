            "value": "区別がつかない"
          }
        }
      }
    },
    "구조가 거짓말을 함": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Structure that lies"
          }
        },
