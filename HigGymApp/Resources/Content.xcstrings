    },
    "요소를 다 켜고 위계 설계는 없음": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning on every element with no thought to hierarchy"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning on every element with no thought to hierarchy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要素を全部オンにして階層の設計はなし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把元素全部打开，却没有层级设计"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把元素全部開啟，卻沒有層級設計"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включение всех элементов без мысли об иерархии"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar todos los elementos sin pensar en la jerarquía"
          }
        }
      }
    },
    "운송장 번호·인증 코드를 선택할 수 없게 둔다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving tracking numbers and verification codes unselectable"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving tracking numbers and verification codes unselectable"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡番号・認証コードを選択できないままにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让运单号、验证码无法选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓運單號、驗證碼無法選擇"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставление номеров отслеживания и кодов подтверждения невыделяемыми"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar los números de seguimiento y los códigos de verificación sin poder seleccionarse"
          }
        }
      }
    },
    "운송장 번호에 미적용": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enabled on a tracking number"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enabled on a tracking number"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡番号で有効にしていない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有应用到运单号上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有應用到運單號上"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не включено для номера отслеживания"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No activado en un número de seguimiento"
          }
        }
      }
    },
    "운송장 번호와 인증 코드에 `textSelection(.enabled)`을 건다. 번호를 길게 누르면 전체가 한 번에 선택·복사된다. iOS에서는 부분 선택이 아니라 텍스트 전체가 복사되어서, 번호처럼 통째로 쓰는 값에 잘 맞는다. 복사가 대상 위에서 바로 일어나니 따로 복사 버튼을 찾을 일도 없다. 2.1.5 예제에서 길게 눌러 보면 무엇이 복사되는지 확인할 수 있다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply `textSelection(.enabled)` to the tracking number and the verification code. Long-press the number and the whole thing is selected and copied at once. On iOS the entire text is copied rather than a partial selection, which suits values used as a whole, like numbers. Copying happens right on the target, so there's no need to hunt for a separate copy button. Long-press in the 2.1.5 example to see what gets copied."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply `textSelection(.enabled)` to the tracking number and the verification code. Long-press the number and the whole thing is selected and copied at once. On iOS the entire text is copied rather than a partial selection, which suits values used as a whole, like numbers. Copying happens right on the target, so there's no need to hunt for a separate copy button. Long-press in the 2.1.5 example to see what gets copied."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡番号と認証コードに `textSelection(.enabled)` をかける。番号を長押しすると、全体が一度に選択・コピーされる。iOSでは部分選択ではなくテキスト全体がコピーされるので、番号のように丸ごと使う値によく合う。コピーが対象の上ですぐに起きるので、別のコピーボタンを探す必要もない。2.1.5の例で長押ししてみると、何がコピーされるかを確かめられる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给运单号和验证码加上 `textSelection(.enabled)`。长按号码，整体一次选中并复制。在 iOS 上不是部分选择而是整段文本被复制，所以很适合号码这类整体使用的值。复制直接在对象上发生，也不必另外去找复制按钮。在 2.1.5 示例里长按看看，就能确认复制的是什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給運單號和驗證碼加上 `textSelection(.enabled)`。長按號碼，整體一次選中並複製。在 iOS 上不是部分選擇而是整段文字被複製，所以很適合號碼這類整體使用的值。複製直接在物件上發生，也不必另外去找複製按鈕。在 2.1.5 示例裡長按看看，就能確認複製的是什麼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примените `textSelection(.enabled)` к номеру отслеживания и коду подтверждения. Долгое нажатие на номер, и он выделяется и копируется целиком. В iOS копируется весь текст, а не его часть, что подходит значениям, которые используют целиком, например номерам. Копирование происходит прямо на самом объекте, так что искать отдельную кнопку копирования не нужно. Нажмите и удерживайте в примере 2.1.5, чтобы увидеть, что копируется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica `textSelection(.enabled)` al número de seguimiento y al código de verificación. Mantén pulsado el número y se selecciona y copia entero de una vez. En iOS se copia el texto entero en lugar de una selección parcial, lo que va bien a valores que se usan completos, como los números. La copia ocurre justo sobre el objetivo, así que no hace falta buscar un botón de copiar aparte. Mantén pulsado en el ejemplo 2.1.5 para ver qué se copia."
          }
        }
      }
    },
    "원칙별 기준과 사례": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Criteria and examples by principle"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Criteria and examples by principle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原則ごとの基準と事例"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各原则的标准与案例"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各原則的標準與案例"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Критерии и примеры по принципам"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Criterios y ejemplos por principio"
          }
        }
      }
    },
    "원칙의 절반만 지켰다. 잘리지는 않았지만 **읽히지 않는다.** 0.5 밑으로 줄여야 들어간다면 그건 축소가 아니라 설계 문제다. 과도한 축소 허용은 가독성을 부순다. 같은 줄의 이웃 텍스트와 크기가 어긋나는 부작용도 커진다. \"넣을 수 있다\"와 \"읽을 수 있다\"는 다른 검증이다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only half the principle was kept. Nothing is cut off, but **it can't be read.** If text has to shrink below 0.5 to fit, that's not scaling but a design problem. Allowing excessive scaling breaks legibility. It also worsens the side effect of the text falling out of size with its neighbors on the same line. \"It fits\" and \"it's readable\" are separate tests."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only half the principle was kept. Nothing is cut off, but **it can't be read.** If text has to shrink below 0.5 to fit, that's not scaling but a design problem. Allowing excessive scaling breaks legibility. It also worsens the side effect of the text falling out of size with its neighbours on the same line. \"It fits\" and \"it's readable\" are separate tests."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原則の半分しか守っていない。切り詰められてはいないが、**読めない。** 0.5より小さく縮めないと収まらないなら、それは縮小ではなく設計の問題だ。過度な縮小の許容は可読性を壊す。同じ行の隣のテキストとサイズが食い違うという副作用も大きくなる。「収まる」と「読める」は別の検証だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只守住了原则的一半。没有被截断，但**读不清**。如果必须缩到 0.5 以下才放得下，那就不是缩小而是设计问题。允许过度缩小会破坏可读性，与同一行相邻文字大小错位的副作用也会变大。“放得进去”和“读得清”是两种不同的验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只守住了原則的一半。沒有被截斷，但**讀不清**。如果必須縮到 0.5 以下才放得下，那就不是縮小而是設計問題。允許過度縮小會破壞可讀性，與同一行相鄰文字大小錯位的副作用也會變大。「放得進去」和「讀得清」是兩種不同的驗證。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранена лишь половина принципа. Ничего не обрезано, но **прочесть нельзя.** Если для вмещения текст приходится сжимать ниже 0,5, это уже не масштабирование, а проблема дизайна. Чрезмерное масштабирование разрушает читаемость. Оно также усугубляет побочный эффект, когда текст расходится по размеру с соседями в той же строке. «Помещается» и «читается» - разные проверки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se conservó la mitad del principio. No se corta nada, pero **no se puede leer.** Si el texto tiene que encogerse por debajo de 0,5 para caber, eso no es escalado sino un problema de diseño. Permitir un escalado excesivo estropea la legibilidad. También agrava el efecto secundario de que el texto desentone en tamaño con los vecinos de la misma línea. «Cabe» y «se lee» son pruebas distintas."
          }
        }
      }
    },
    "웹 검색처럼 “이 화면 = 검색”인 화면": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen where “this screen = search,” like web search"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen where “this screen = search,” like web search"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブ検索のように「この画面 = 検索」である画面"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像网页搜索那样“这个界面 = 搜索”的界面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像網頁搜尋那樣「這個介面 = 搜尋」的介面"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран, где «этот экран = поиск», как веб-поиск"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pantalla donde «esta pantalla = búsqueda», como la búsqueda web"
          }
        }
      }
    },
    "웹·안드로이드와 같은 위치라 익숙하고, 예전 iOS도 그랬다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's in the same place as on the web and Android, so it feels familiar, and older iOS did it too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's in the same place as on the web and Android, so it feels familiar, and older iOS did it too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web や Android と同じ位置なので見慣れているし、以前の iOS もそうだった。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与网页、Android 位置相同所以熟悉，过去的 iOS 也是这样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與網頁、Android 位置相同所以熟悉，過去的 iOS 也是這樣。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он на том же месте, что и в вебе и Android, поэтому кажется знакомым, и старые iOS делали так же."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está en el mismo sitio que en la web y en Android, así que resulta familiar, y el iOS antiguo también lo hacía."
          }
        }
      }
    },
    "웹과 안드로이드에서 검색은 대개 위에 있다. 예전 iOS도 그랬다. 모든 플랫폼에서 같은 자리에 두면 익숙하고 일관돼 보인다. 시스템 배치가 바뀐 줄 모르면, 커스텀 뷰로 예전 자리를 그대로 재현하게 된다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the web and Android, search is usually at the top. Older iOS did the same. Putting it in the same place on every platform looks familiar and consistent. If you don't know the system placement has changed, you end up recreating the old position with a custom view."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On the web and Android, search is usually at the top. Older iOS did the same. Putting it in the same place on every platform looks familiar and consistent. If you don't know the system placement has changed, you end up recreating the old position with a custom view."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web や Android では、検索はたいてい上にある。以前の iOS もそうだった。すべてのプラットフォームで同じ場所に置けば、見慣れていて一貫しているように見える。システムの配置が変わったことを知らなければ、カスタムビューで以前の位置をそのまま再現してしまう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在网页和 Android 上，搜索通常在上面。过去的 iOS 也是。所有平台都放在同一个位置，看起来熟悉又一致。不知道系统布局已经变了，就会用自定义视图原样重现旧位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在網頁和 Android 上，搜尋通常在上面。過去的 iOS 也是。所有平臺都放在同一個位置，看起來熟悉又一致。不知道系統佈局已經變了，就會用自定義檢視原樣重現舊位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В вебе и Android поиск обычно вверху. Старая iOS делала так же. Одно и то же место на всех платформах выглядит привычно и единообразно. Если вы не знаете, что системное размещение изменилось, вы воссоздадите прежнее положение пользовательским видом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la web y en Android, la búsqueda suele estar arriba. El iOS antiguo hacía lo mismo. Ponerla en el mismo sitio en todas las plataformas parece familiar y coherente. Si no sabes que la colocación del sistema ha cambiado, acabas recreando la posición antigua con una vista personalizada."
          }
        }
      }
    },
    "위 상태 배너 + 아래 재생 바": {
