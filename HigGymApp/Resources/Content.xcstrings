            "state": "translated",
            "value": "Non tornare alla posizione originale alla chiusura"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não voltar à posição original ao fechar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่กลับไปตำแหน่งเดิมเมื่อปิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không quay về vị trí gốc khi đóng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevracení na původní pozici při zavření"
          }
