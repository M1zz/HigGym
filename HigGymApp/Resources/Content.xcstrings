          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ai khám phá ra"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikdo to neobjeví"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen opdager det"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κανείς δεν το ανακαλύπτει"
          }
        }
      }
    },
    "밝은 화면 한 조건에서만 확인하고 끄면, 흰 사진이 바 뒤를 지나는 순간 컨트롤이 사라짐. \"최악의 배경에서 검증\" 기준을 건너뛴 경우": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it off after checking only one bright condition, and the controls vanish the moment a white photo passes behind the bar. This skips the \"test against the worst background\" criterion"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it off after checking only one bright condition, and the controls vanish the moment a white photo passes behind the bar. This skips the \"test against the worst background\" criterion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るい画面というひとつの条件だけで確認して切ると、白い写真がバーの後ろを通った瞬間にコントロールが消える。「最悪の背景で検証する」という基準を飛ばしたケース"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在一个明亮界面的条件下确认就关掉，白色照片从栏后经过的瞬间，控件就消失了。这是跳过了“在最糟糕的背景上验证”标准的情形"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在一個明亮介面的條件下確認就關掉，白色照片從列後經過的瞬間，控制元件就消失了。這是跳過了「在最糟糕的背景上驗證」標準的情形"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключить, проверив только одно яркое условие, элементы управления исчезнут в момент, когда белая фотография пройдёт за панелью. Это пропуск критерия «проверять на худшем фоне»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo tras comprobar solo una condición brillante, y los controles desaparecen en el momento en que una foto blanca pasa tras la barra. Esto se salta el criterio de «probar contra el peor fondo»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltest du ihn nach der Prüfung nur einer hellen Bedingung aus, verschwinden die Steuerelemente in dem Moment, in dem ein weißes Foto hinter der Leiste vorbeizieht. Das überspringt das Kriterium „gegen den schlechtesten Hintergrund testen“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez-le après avoir vérifié une seule condition lumineuse, et les contrôles disparaissent à l'instant où une photo blanche passe derrière la barre. Cela saute le critère « tester sur le pire arrière-plan »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivalo dopo aver controllato una sola condizione luminosa e i controlli spariscono nel momento in cui una foto bianca passa dietro la barra. Salta il criterio «prova sullo sfondo peggiore»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue depois de conferir só uma condição clara e os controles somem no instante em que uma foto branca passa atrás da barra. Isso pula o critério «teste contra o pior fundo»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดหลังตรวจเพียงสภาวะสว่างเดียว แล้วตัวควบคุมหายไปทันทีที่รูปสีขาวผ่านด้านหลังแถบ นี่ข้ามเกณฑ์ \"ทดสอบกับพื้นหลังที่แย่ที่สุด\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt đi sau khi chỉ kiểm tra một điều kiện sáng, và điều khiển biến mất ngay khi ảnh trắng đi qua sau thanh. Điều này bỏ qua tiêu chí \"thử với nền tệ nhất\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypněte to po kontrole jediné světlé podmínky a ovladače zmizí ve chvíli, kdy za panelem projde bílá fotka. Tím se přeskočí kritérium „test proti nejhoršímu pozadí“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå den fra efter kun at have tjekket én lys betingelse, og kontrollerne forsvinder i det øjeblik, et hvidt foto passerer bag bjælken. Det springer kriteriet »test mod den værste baggrund« over"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποίησέ το αφού ελέγξεις μόνο μία φωτεινή συνθήκη, και οι έλεγχοι εξαφανίζονται τη στιγμή που μια λευκή φωτογραφία περνά πίσω από τη γραμμή. Αυτό παραλείπει το κριτήριο «δοκίμασε με το χειρότερο φόντο»"
          }
        }
      }
    },
    "방어 장치를 넣기 전에 묻는다. \"이 화면의 배경이 정말 방어가 필요한가?\" 방어는 필요한 곳에만 둔다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before adding a safeguard, ask: \"Does this screen's background really need defending?\" Defend only where defense is needed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before adding a safeguard, ask: \"Does this screen's background really need defending?\" Defend only where defence is needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "守りの仕掛けを入れる前に問う。「この画面の背景は、本当に守りが必要か？」 守りは必要な場所にだけ置く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加防护之前先问：“这个界面的背景真的需要防护吗？”防护只放在需要的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加防護之前先問：「這個介面的背景真的需要防護嗎？」防護只放在需要的地方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем добавлять защиту, спросите: «Нужна ли фону этого экрана на самом деле защита?» Защищайте только там, где защита нужна."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de añadir una salvaguarda, pregunta: «¿Necesita realmente defensa el fondo de esta pantalla?» Defiende solo donde haga falta defensa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage vor dem Hinzufügen einer Absicherung: „Muss der Hintergrund dieses Bildschirms wirklich verteidigt werden?“ Verteidige nur dort, wo Verteidigung nötig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'ajouter une protection, demandez : « L'arrière-plan de cet écran a-t-il vraiment besoin d'être défendu ? » Ne défendez que là où une défense est nécessaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di aggiungere una salvaguardia, chiediti: «Lo sfondo di questa schermata ha davvero bisogno di essere difeso?» Difendi solo dove serve difendere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de acrescentar uma salvaguarda, pergunte: «O fundo desta tela realmente precisa ser defendido?» Defenda só onde a defesa é necessária."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนเพิ่มเครื่องป้องกัน ให้ถาม: \"พื้นหลังของหน้าจอนี้ต้องการการป้องกันจริงไหม\" ป้องกันเฉพาะที่ต้องป้องกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi thêm biện pháp bảo vệ, hãy hỏi: \"Nền của màn hình này có thật sự cần được bảo vệ không?\" Chỉ bảo vệ nơi cần."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než přidáte pojistku, zeptejte se: „Opravdu pozadí této obrazovky potřebuje obranu?“ Braňte jen tam, kde je obrana potřeba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du tilføjer en sikkerhedsforanstaltning, så spørg: »Har denne skærms baggrund virkelig brug for forsvar?« Forsvar kun, hvor der er brug for forsvar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν προσθέσεις ένα μέτρο ασφαλείας, ρώτα: «Χρειάζεται πραγματικά το φόντο αυτής της οθόνης προστασία;» Προστάτευσε μόνο εκεί που χρειάζεται προστασία."
          }
        }
      }
    },
    "방향별 역할 분리": {
