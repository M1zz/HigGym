          }
        }
      }
    },
    "시스템 내비바와 커스텀 헤더를 동시에 띄운다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing both the system navigation bar and a custom header"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing both the system navigation bar and a custom header"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのナビゲーションバーとカスタムヘッダを同時に表示する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时显示系统导航栏和自定义标题区"
