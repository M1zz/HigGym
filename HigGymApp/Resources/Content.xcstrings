    "메뉴 순서를 정하는 기준은 흐름이 아니라 **무게**다. 되돌릴 수 없는 것은 언제나 따로, 그리고 끝에.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule for ordering a menu is **weight**, not flow. Anything irreversible always goes separately, and at the end."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The rule for ordering a menu is **weight**, not flow. Anything irreversible always goes separately, and at the end."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューの順番を決める基準は、流れではなく**重さ**だ。取り消せないものは、いつも別に、そして最後に。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定菜单顺序的标准不是流程，而是**分量**。无法撤销的永远单独放，并放在最后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定選單順序的標準不是流程，而是**分量**。無法撤銷的永遠單獨放，並放在最後。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило порядка в меню - **вес**, а не поток. Всё необратимое всегда идёт отдельно и в конце."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La regla para ordenar un menú es **el peso**, no el flujo. Todo lo irreversible va siempre aparte, y al final."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regel für die Reihenfolge eines Menüs ist **Gewicht**, nicht Ablauf. Alles Unumkehrbare steht immer getrennt und am Ende."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La règle pour ordonner un menu est **le poids**, pas le déroulement. Tout ce qui est irréversible va toujours à part, et à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La regola per ordinare un menu è il **peso**, non il flusso. Tutto ciò che è irreversibile va sempre a parte, e in fondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A regra para ordenar um menu é o **peso**, não o fluxo. Tudo o que é irreversível vai sempre à parte, e no fim."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กฎการเรียงเมนูคือ**น้ำหนัก** ไม่ใช่การไหล สิ่งที่ย้อนกลับไม่ได้ไปแยกต่างหากเสมอ และอยู่ท้ายสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy tắc sắp xếp menu là **trọng lượng**, không phải dòng chảy. Thứ không thể hoàn tác luôn tách riêng, và ở cuối."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidlem řazení nabídky je **váha**, ne tok. Cokoli nevratného jde vždy zvlášť a na konec."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglen for rækkefølgen i en menu er **vægt**, ikke flow. Alt uigenkaldeligt kommer altid for sig og til sidst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κανόνας για τη σειρά ενός μενού είναι **το βάρος**, όχι η ροή. Ό,τι είναι μη αναστρέψιμο πηγαίνει πάντα χωριστά, και στο τέλος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valikon järjestämisen sääntö on **paino**, ei virta. Kaikki peruuttamaton menee aina erikseen ja viimeiseksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aturan mengurutkan menu adalah **bobot**, bukan alur. Apa pun yang tak bisa dibatalkan selalu ditaruh terpisah, dan di akhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Regelen for å ordne en meny er **vekt**, ikke flyt. Alt som ikke kan angres havner alltid for seg selv, og til slutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De regel voor het ordenen van een menu is **gewicht**, niet flow. Alles wat onomkeerbaar is, komt altijd apart, en aan het eind."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regułą porządkowania menu jest **waga**, a nie przepływ. Wszystko, co nieodwracalne, zawsze idzie osobno i na końcu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln för att ordna en meny är **tyngd**, inte flöde. Allt oåterkalleligt hamnar alltid separat, och sist."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir menüyü sıralama kuralı akış değil **ağırlıktır**. Geri alınamayan her şey her zaman ayrı ve sonda gider."
          }
        }
      }
    },
