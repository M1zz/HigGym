            "value": "Dát tlačítko Hotovo, na které klepnete jednou, do spodního panelu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lægge en Færdig-knap, du trykker på én gang, i den nederste bjælke"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοποθέτηση ενός κουμπιού Τέλος που το πατάς μία φορά στην κάτω γραμμή"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerran napautettavan Valmis-painikkeen laittaminen alapalkkiin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menaruh tombol Selesai yang diketuk sekali di bilah bawah"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å sette en Ferdig-knapp du trykker på én gang i bunnlinjen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Klaar-knop waarop je één keer tikt in de onderbalk zetten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieszczenie w dolnym pasku przycisku Gotowe, który stukasz raz"
          }
        },
        "sv": {
