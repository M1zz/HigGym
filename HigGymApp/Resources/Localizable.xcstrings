    "진입 순간엔 방향감을 주고, 읽기 시작하면 inline으로 접혀 공간을 콘텐츠에 반납합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On entry it gives a sense of place; once you start reading, it collapses to inline and gives the space back to the content."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On entry it gives a sense of place; once you start reading, it collapses to inline and gives the space back to the content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入った瞬間は現在地を伝え、読み始めると inline に折りたたまれてスペースをコンテンツに返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진입 순간엔 방향감을 주고, 읽기 시작하면 inline으로 접혀 공간을 콘텐츠에 반납합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入时提供方向感，开始阅读后折叠为 inline，把空间还给内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入時提供方向感，開始閱讀後摺疊為 inline，把空間還給內容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При входе даёт чувство места; когда вы начинаете читать, сворачивается в inline и возвращает место контенту."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al entrar da sensación de lugar; cuando empiezas a leer, se colapsa a inline y devuelve el espacio al contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Einstieg gibt er ein Ortsgefühl; sobald du zu lesen beginnst, klappt er zu inline zusammen und gibt den Platz an den Inhalt zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'arrivée, il donne un sens du lieu ; dès que vous commencez à lire, il se replie en inline et rend l'espace au contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All'ingresso dà un senso di luogo; quando inizi a leggere si comprime in linea e restituisce lo spazio al contenuto."
          }
        }
      }
    },
    "진입 시점엔 방향감이 필요하지만 읽기 시작하면 기여가 끝나므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because orientation matters on entry, but once you start reading, its job is done"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because orientation matters on entry, but once you start reading, its job is done"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入った時点では現在地の手がかりが必要だが、読み始めれば役目を終えるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진입 시점엔 방향감이 필요하지만 읽기 시작하면 기여가 끝나므로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入时需要方向感，但开始阅读后它的贡献就结束了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入時需要方向感，但開始閱讀後它的貢獻就結束了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что при входе важна ориентация, а когда вы начинаете читать, её роль закончена"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque la orientación importa al entrar, pero cuando empiezas a leer, su trabajo ha terminado"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil Orientierung beim Einstieg zählt, aber ihre Aufgabe erledigt ist, sobald du zu lesen beginnst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce que l'orientation compte à l'arrivée, mais une fois la lecture commencée, son travail est fait"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché l'orientamento conta all'ingresso, ma quando inizi a leggere il suo compito è finito"
          }
        }
      }
    },
