          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna on **⋯:n sisällä**. Tallennuksia: %lld"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan ada di **dalam ⋯**. Simpanan: %lld"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre er **inne i ⋯**. Lagringer: %lld"
          }
        },
