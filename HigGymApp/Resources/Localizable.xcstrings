      }
    },
    "탭바를 상세 화면에서 숨기는 것이 맞는 경우는?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When is it right to hide the tab bar on a detail screen?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When is it right to hide the tab bar on a detail screen?"
          }
        },
        "ja": {
