    "저장이 밖에, 별표·프린트가 접힘. 저장 %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save out front, Star and Print folded. Saves: %lld"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Save out front, Star and Print folded. Saves: %lld"
          }
        },
