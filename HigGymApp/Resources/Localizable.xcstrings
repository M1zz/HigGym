    "사진 위 버튼은 가장자리 효과를 켜서 대비를 확보합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons over photos turn on the edge effect to secure contrast."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons over photos turn on the edge effect to secure contrast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の上のボタンは、エッジエフェクトをオンにしてコントラストを確保します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 위 버튼은 가장자리 효과를 켜서 대비를 확보합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片上的按钮要开启边缘效果来保证对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片上的按鈕要開啟邊緣效果來保證對比度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки над фотографиями включают эффект края, чтобы обеспечить контраст."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones sobre fotos activan el efecto de borde para asegurar el contraste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons über Fotos aktivieren den Kanteneffekt, um den Kontrast zu sichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boutons sur des photos activent l'effet de bord pour sécuriser le contraste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pulsanti sopra le foto attivano l'effetto sul bordo per garantire il contrasto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Botões sobre fotos ativam o efeito de borda para garantir contraste."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มเหนือรูปภาพเปิดเอฟเฟกต์ขอบเพื่อรักษาความตัดกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nút trên ảnh bật hiệu ứng cạnh để bảo đảm độ tương phản."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítka nad fotkami zapínají okrajový efekt, aby zajistila kontrast."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper over fotos slår kanteffekten til for at sikre kontrast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κουμπιά πάνω από φωτογραφίες ενεργοποιούν το εφέ άκρης για να εξασφαλίσουν αντίθεση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valokuvien päällä olevat painikkeet kytkevät reunaefektin päälle varmistaakseen kontrastin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol di atas foto menyalakan efek tepi untuk menjamin kontras."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Knapper over bilder slår på kanteffekten for å sikre kontrast."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoppen boven foto's zetten het randeffect aan om contrast te garanderen."
          }
        }
      }
    },
    "사진 위에 툴바가 떠 있는 화면에서 버튼 대비가 부족합니다. 어떻게 할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a screen with a toolbar floating over a photo, the buttons lack contrast. What should you do?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On a screen with a toolbar floating over a photo, the buttons lack contrast. What should you do?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の上にツールバーが浮いている画面で、ボタンのコントラストが足りません。どうしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 위에 툴바가 떠 있는 화면에서 버튼 대비가 부족합니다. 어떻게 할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片上悬浮着工具栏的界面里，按钮对比度不够。该怎么办？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片上懸浮著工具列的介面裡，按鈕對比度不夠。該怎麼辦？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране, где над фотографией парит панель инструментов, у кнопок не хватает контраста. Что делать?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una pantalla con una barra de herramientas flotando sobre una foto, los botones no tienen contraste. ¿Qué debes hacer?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einem Bildschirm mit einer Symbolleiste, die über einem Foto schwebt, fehlt den Buttons der Kontrast. Was solltest du tun?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un écran dont la barre d'outils flotte au-dessus d'une photo, les boutons manquent de contraste. Que faire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In una schermata con una barra degli strumenti che fluttua sopra una foto, i pulsanti hanno poco contrasto. Che cosa dovresti fare?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa tela com uma barra de ferramentas flutuando sobre uma foto, os botões têm pouco contraste. O que fazer?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้าจอที่มีแถบเครื่องมือลอยเหนือรูปภาพ ปุ่มมีความตัดกันไม่พอ คุณควรทำอย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình có thanh công cụ nổi trên ảnh, các nút thiếu độ tương phản. Bạn nên làm gì?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na obrazovce s panelem nástrojů plovoucím nad fotkou tlačítkům chybí kontrast. Co máte udělat?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På en skærm med en værktøjslinje, der svæver over et foto, mangler knapperne kontrast. Hvad skal du gøre?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε μια οθόνη με γραμμή εργαλείων που επιπλέει πάνω από μια φωτογραφία, τα κουμπιά στερούνται αντίθεσης. Τι πρέπει να κάνεις;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkymässä, jossa työkalupalkki kelluu valokuvan päällä, painikkeilta puuttuu kontrastia. Mitä pitäisi tehdä?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada layar dengan bilah alat yang mengambang di atas foto, tombol kekurangan kontras. Apa yang harus dilakukan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På en skjerm med en verktøylinje som flyter over et bilde mangler knappene kontrast. Hva bør du gjøre?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een scherm met een werkbalk die boven een foto zweeft, hebben de knoppen te weinig contrast. Wat moet je doen?"
          }
        }
      }
    },
    "사진 전체 화면·영상 재생처럼 몰입이 주 작업일 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When immersion is the main task, like full-screen photos or video playback"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When immersion is the main task, like full-screen photos or video playback"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の全画面表示や動画再生のように、没入が主な作業のとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 전체 화면·영상 재생처럼 몰입이 주 작업일 때"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整张照片全屏、视频播放等以沉浸为主要任务时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整張照片全螢幕、影片播放等以沉浸為主要任務時"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда главная задача - погружение, как при просмотре фото на весь экран или воспроизведении видео"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la inmersión es la tarea principal, como fotos a pantalla completa o reproducción de vídeo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Immersion die Hauptaufgabe ist, etwa bei Vollbildfotos oder Videowiedergabe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand l'immersion est la tâche principale, comme les photos en plein écran ou la lecture vidéo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando l'immersione è il compito principale, come nelle foto a schermo intero o nella riproduzione video"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a imersão é a tarefa principal, como em fotos em tela cheia ou reprodução de vídeo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อความดื่มด่ำเป็นงานหลัก เช่นรูปภาพเต็มหน้าจอหรือการเล่นวิดีโอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi sự đắm chìm là tác vụ chính, như ảnh toàn màn hình hoặc phát video"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je hlavním úkolem pohlcení, jako u fotek na celou obrazovku nebo přehrávání videa"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når fordybelse er hovedopgaven, som fotos i fuld skærm eller videoafspilning"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν η εμβύθιση είναι η κύρια εργασία, όπως οι φωτογραφίες πλήρους οθόνης ή η αναπαραγωγή βίντεο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun immersio on pääasiallinen tehtävä, kuten kokoruudun valokuvissa tai videon toistossa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketika imersi adalah tugas utama, seperti foto layar penuh atau pemutaran video"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når oppslukthet er hovedoppgaven, som helskjermbilder eller videoavspilling"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer onderdompeling de hoofdtaak is, zoals bij foto's op volledig scherm of het afspelen van video"
          }
        }
      }
    },
