    "오른쪽 위 버튼들로 **정렬을 한 번, 편집을 한 번** 눌러보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the buttons at the top right to tap **Sort once, then Edit once**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the buttons at the top right to tap **Sort once, then Edit once**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上のボタンで、**並べ替えを1回、編集を1回**押してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위 버튼들로 **정렬을 한 번, 편집을 한 번** 눌러보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用右上角的按钮**点一次排序、点一次编辑**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用右上角的按鈕**點一次排序、點一次編輯**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопками справа вверху нажмите **один раз «Сортировка» и один раз «Изменить»**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los botones de arriba a la derecha para tocar **Ordenar una vez y Editar una vez**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe mit den Buttons oben rechts **einmal auf Sortieren, dann einmal auf Bearbeiten**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les boutons en haut à droite pour toucher **Trier une fois, puis Modifier une fois**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa i pulsanti in alto a destra per toccare **Ordina una volta, poi Modifica una volta**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use os botões do topo à direita para tocar em **Ordenar uma vez, depois Editar uma vez**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ปุ่มที่ขวาบนเพื่อแตะ**เรียงลำดับหนึ่งครั้ง แล้วแก้ไขหนึ่งครั้ง**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng các nút ở trên cùng bên phải để chạm **Sắp xếp một lần, rồi Sửa một lần**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí tlačítek vpravo nahoře klepněte **jednou na Seřadit, pak jednou na Upravit**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug knapperne øverst til højre til at trykke på **Sortér én gang, så Rediger én gang**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε τα κουμπιά πάνω δεξιά για να πατήσεις **Ταξινόμηση μία φορά, μετά Επεξεργασία μία φορά**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä oikean yläkulman painikkeita napauttaaksesi **kerran Lajittele, sitten kerran Muokkaa**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan tombol di kanan atas untuk mengetuk **Urutkan sekali, lalu Ubah sekali**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk knappene øverst til høyre til å trykke på **Sorter én gang, deretter Rediger én gang**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de knoppen rechtsboven om **één keer op Sorteer, dan één keer op Wijzig** te tikken."
          }
        }
      }
    },
    "오른쪽 캡슐, **선택**과 **공유**. 콘텐츠를 다루는 일입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right capsule: **Select** and **Share**. Both act on the content."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Right capsule: **Select** and **Share**. Both act on the content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右のカプセルは**選択**と**共有**。どちらもコンテンツを扱う操作です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 캡슐, **선택**과 **공유**. 콘텐츠를 다루는 일입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧胶囊，**选择**和**分享**。都是对内容的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右側膠囊，**選擇**和**分享**。都是對內容的操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правая капсула: **«Выбрать»** и **«Поделиться»**. Оба действия относятся к содержимому."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cápsula derecha: **Seleccionar** y **Compartir**. Ambos actúan sobre el contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechte Kapsel: **Auswählen** und **Teilen**. Beide wirken auf den Inhalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule de droite : **Sélectionner** et **Partager**. Les deux agissent sur le contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsula di destra: **Seleziona** e **Condividi**. Entrambi agiscono sul contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cápsula da direita: **Selecionar** e **Compartilhar**. Ambos agem sobre o conteúdo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แคปซูลขวา: **เลือก**และ**แชร์** ทั้งสองทำงานกับเนื้อหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule bên phải: **Chọn** và **Chia sẻ**. Cả hai đều tác động lên nội dung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravá kapsle: **Vybrat** a **Sdílet**. Obě působí na obsah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapsel til højre: **Vælg** og **Del**. Begge virker på indholdet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεξιά κάψουλα: **Επιλογή** και **Κοινοποίηση**. Και τα δύο δρουν στο περιεχόμενο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikea kapseli: **Valitse** ja **Jaa**. Molemmat vaikuttavat sisältöön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapsul kanan: **Pilih** dan **Bagikan**. Keduanya bekerja pada konten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Høyre kapsel: **Velg** og **Del**. Begge virker på innholdet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechter capsule: **Selecteer** en **Deel**. Beide werken op de inhoud."
          }
        }
      }
    },
    "오른쪽 하단은 **작성**입니다. 삭제는 행을 왼쪽으로 밀어야 나옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottom right is **Compose**. Delete appears only when you swipe a row to the left."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottom right is **Compose**. Delete appears only when you swipe a row to the left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右下は**作成**です。削除は行を左にスワイプしたときだけ現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 하단은 **작성**입니다. 삭제는 행을 왼쪽으로 밀어야 나옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右下角是**撰写**。删除要把行向左滑才会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右下角是**撰寫**。刪除要把行向左滑才會出現。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справа внизу **«Написать»**. «Удалить» появляется, только если смахнуть строку влево."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abajo a la derecha está **Redactar**. Eliminar aparece solo al deslizar una fila hacia la izquierda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten rechts ist **Verfassen**. Löschen erscheint nur, wenn du eine Zeile nach links wischst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En bas à droite se trouve **Rédiger**. Supprimer n'apparaît que lorsque vous balayez une ligne vers la gauche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In basso a destra c'è **Scrivi**. Elimina compare solo quando scorri una riga verso sinistra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No canto inferior direito está **Escrever**. Excluir só aparece quando você desliza uma linha para a esquerda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขวาล่างคือ**เขียน** ลบปรากฏเมื่อปัดแถวไปทางซ้ายเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dưới cùng bên phải là **Soạn**. Xóa chỉ xuất hiện khi bạn vuốt một dòng sang trái."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vpravo dole je **Napsat**. Smazat se objeví, jen když přejedete řádek doleva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nederst til højre er **Skriv**. Slet dukker kun op, når du stryger en række mod venstre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάτω δεξιά είναι η **Σύνταξη**. Η Διαγραφή εμφανίζεται μόνο όταν σύρεις μια γραμμή προς τα αριστερά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikeassa alakulmassa on **Kirjoita**. Poista ilmestyy vain, kun pyyhkäiset riviä vasemmalle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanan bawah adalah **Tulis**. Hapus muncul hanya saat kamu mengusap baris ke kiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nederst til høyre er **Skriv**. Slett vises bare når du sveiper en rad mot venstre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsonder staat **Schrijf**. Verwijder verschijnt alleen als je een rij naar links veegt."
          }
        }
      }
    },
    "오른쪽에는 취소·완료가 있습니다. 같은 전체 화면인데 출구가 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The right one has Cancel and Done. Same full screen, but there's a way out."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The right one has Cancel and Done. Same full screen, but there's a way out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右はキャンセルと完了があります。同じフルスクリーンでも出口があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽에는 취소·완료가 있습니다. 같은 전체 화면인데 출구가 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧有取消、完成。同样是全屏，却有出口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右側有取消、完成。同樣是全螢幕，卻有出口。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У правого есть «Отмена» и «Готово». Тот же полный экран, но есть выход."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La de la derecha tiene Cancelar y Listo. Misma pantalla completa, pero con una salida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die rechte hat Abbrechen und Fertig. Derselbe Vollbildschirm, aber es gibt einen Ausweg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui de droite a Annuler et OK. Même plein écran, mais il y a une issue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello a destra ha Annulla e Fine. Stessa schermata intera, ma c'è una via d'uscita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O da direita tem Cancelar e Concluir. A mesma tela cheia, mas com uma saída."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อันขวามียกเลิกและเสร็จสิ้น เต็มหน้าจอเหมือนกัน แต่มีทางออก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cái bên phải có Hủy và Xong. Cùng toàn màn hình, nhưng có lối thoát."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravá má Zrušit a Hotovo. Stejná celá obrazovka, ale s cestou ven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den til højre har Annuller og Færdig. Samme fulde skærm, men der er en vej ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό στα δεξιά έχει Ακύρωση και Τέλος. Ίδια πλήρης οθόνη, αλλά υπάρχει διέξοδος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikeanpuoleisessa on Peruuta ja Valmis. Sama kokoruutu, mutta ulospääsy on olemassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang kanan punya Batal dan Selesai. Layar penuh yang sama, tetapi ada jalan keluar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den til høyre har Avbryt og Ferdig. Samme helskjerm, men det finnes en vei ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rechter heeft Annuleer en Klaar. Hetzelfde volledige scherm, maar er is een uitweg."
          }
        }
      }
    },
    "오른쪽은 값만 들고 있다가 3.1mi로 바뀝니다. 앱 코드는 한 줄도 다르지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The right one holds only the value and turns into 3.1mi. Not a single line of app code differs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The right one holds only the value and turns into 3.1mi. Not a single line of app code differs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右は値だけを持っていて、3.1miに変わります。アプリのコードは1行も違いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽은 값만 들고 있다가 3.1mi로 바뀝니다. 앱 코드는 한 줄도 다르지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右边只保存数值，会变成 3.1mi。应用代码一行都没有不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右邊只儲存數值，會變成 3.1mi。應用程式碼一行都沒有不同。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правый хранит только значение и превращается в 3,1 мили. Ни одна строка кода приложения не отличается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La de la derecha guarda solo el valor y se convierte en 3,1 mi. Ni una línea de código de la app es distinta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die rechte hält nur den Wert und wird zu 3,1 mi. Nicht eine einzige Zeile App-Code unterscheidet sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui de droite ne garde que la valeur et devient 3,1 mi. Pas une seule ligne de code de l'app ne diffère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello a destra conserva solo il valore e diventa 3,1 mi. Non cambia nemmeno una riga di codice dell'app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O da direita guarda só o valor e vira 3,1 mi. Nem uma linha de código do app é diferente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อันขวาเก็บแค่ค่าและกลายเป็น 3.1 ไมล์ โค้ดแอปไม่ต่างกันแม้แต่บรรทัดเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cái bên phải chỉ giữ giá trị và thành 3,1 mi. Không một dòng mã app nào khác nhau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravá drží jen hodnotu a změní se na 3,1 mi. Ani řádek kódu aplikace se neliší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den til højre holder kun værdien og bliver til 3.1mi. Ikke en eneste linje app-kode er forskellig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό στα δεξιά κρατά μόνο την τιμή και γίνεται 3.1mi. Ούτε μία γραμμή κώδικα της εφαρμογής δεν διαφέρει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikeanpuoleinen pitää vain arvon ja muuttuu muotoon 3,1 mi. Yksikään sovelluskoodin rivi ei eroa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang kanan hanya menyimpan nilai dan berubah menjadi 3,1 mi. Tidak satu baris pun kode aplikasi berbeda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den til høyre holder bare verdien og blir til 3,1 mi. Ikke én eneste linje med appkode er forskjellig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rechter bewaart alleen de waarde en wordt 3.1mi. Geen enkele regel appcode verschilt."
          }
        }
      }
    },
    "오른쪽은 도구가 왼쪽 묶음, 삭제는 오른쪽 메뉴 안쪽에 있습니다. 같은 실수를 하기가 어렵습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the right, tools are in the left group and Delete sits inside the right menu. It's hard to make the same mistake."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On the right, tools are in the left group and Delete sits inside the right menu. It's hard to make the same mistake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右はツールが左のまとまりに、削除は右のメニューの中にあります。同じミスはしにくくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽은 도구가 왼쪽 묶음, 삭제는 오른쪽 메뉴 안쪽에 있습니다. 같은 실수를 하기가 어렵습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右边的工具在左侧一组，删除在右侧菜单深处。很难犯同样的错。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右邊的工具在左側一組，刪除在右側選單深處。很難犯同樣的錯。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справа инструменты в левой группе, а «Удалить» внутри правого меню. Допустить ту же ошибку трудно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la derecha, las herramientas están en el grupo izquierdo y Eliminar dentro del menú derecho. Es difícil cometer el mismo error."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts sind die Werkzeuge in der linken Gruppe und Löschen im rechten Menü. Es ist schwer, denselben Fehler zu machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À droite, les outils sont dans le groupe de gauche et Supprimer se trouve dans le menu de droite. Il est difficile de faire la même erreur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A destra, gli strumenti sono nel gruppo di sinistra e Elimina sta dentro il menu di destra. È difficile commettere lo stesso errore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À direita, as ferramentas estão no grupo da esquerda e Excluir fica dentro do menu da direita. É difícil cometer o mesmo erro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทางขวา เครื่องมืออยู่กลุ่มซ้าย และลบอยู่ในเมนูขวา ทำผิดแบบเดิมได้ยาก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở bên phải, công cụ nằm trong nhóm bên trái và Xóa nằm trong menu bên phải. Khó mắc cùng lỗi đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vpravo jsou nástroje v levé skupině a Smazat sedí uvnitř pravé nabídky. Stejnou chybu je těžké udělat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til højre ligger værktøjerne i venstre gruppe, og Slet ligger inde i højre menu. Det er svært at begå samme fejl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στα δεξιά, τα εργαλεία είναι στην αριστερή ομάδα και η Διαγραφή βρίσκεται μέσα στο δεξί μενού. Είναι δύσκολο να γίνει το ίδιο λάθος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikealla työkalut ovat vasemmassa ryhmässä ja Poista on oikean valikon sisällä. Samaa virhettä on vaikea tehdä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di kanan, alat ada di grup kiri dan Hapus berada di dalam menu kanan. Sulit membuat kesalahan yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Til høyre ligger verktøyene i venstre gruppe og Slett inne i høyre meny. Det er vanskelig å gjøre den samme feilen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts staan de hulpmiddelen in de linkergroep en zit Verwijder in het rechtermenu. Dezelfde fout is moeilijk te maken."
          }
        }
      }
    },
    "오른쪽은 선택·복사가 되고, 복사 버튼도 있습니다. 실제로 복사됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The right one can be selected and copied, and it has a Copy button too. It really copies."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The right one can be selected and copied, and it has a Copy button too. It really copies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右は選択もコピーもでき、コピーボタンもあります。実際にコピーされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽은 선택·복사가 되고, 복사 버튼도 있습니다. 실제로 복사됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右边可以选择、复制，也有复制按钮。真的能复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右邊可以選擇、複製，也有複製按鈕。真的能複製。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правый можно выделять и копировать, и у него есть кнопка «Скопировать». Он действительно копирует."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La de la derecha se puede seleccionar y copiar, y también tiene un botón Copiar. Copia de verdad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die rechte lässt sich auswählen und kopieren und hat auch einen Kopieren-Button. Sie kopiert wirklich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui de droite peut être sélectionné et copié, et il a aussi un bouton Copier. Il copie vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello a destra si può selezionare e copiare, e ha anche un pulsante Copia. Copia davvero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O da direita pode ser selecionado e copiado, e também tem um botão Copiar. Copia de verdade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อันขวาเลือกและคัดลอกได้ และมีปุ่มคัดลอกด้วย คัดลอกได้จริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cái bên phải chọn và sao chép được, và cũng có nút Sao chép. Nó sao chép thật."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravou lze vybrat a zkopírovat a má i tlačítko Kopírovat. Opravdu kopíruje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den til højre kan markeres og kopieres, og den har også en knap Kopiér. Den kopierer for alvor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό στα δεξιά μπορεί να επιλεγεί και να αντιγραφεί, και έχει και κουμπί Αντιγραφή. Αντιγράφει πραγματικά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikeanpuoleisen voi valita ja kopioida, ja siinä on myös Kopioi-painike. Se todella kopioi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang kanan bisa dipilih dan disalin, dan juga punya tombol Salin. Ia benar-benar menyalin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den til høyre kan markeres og kopieres, og den har også en Kopier-knapp. Den kopierer faktisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rechter kan worden geselecteerd en gekopieerd, en heeft ook een knop Kopieer. Hij kopieert echt."
          }
        }
      }
    },
    "오른쪽은 읽을 때마다 숫자가 줄고, 0이 되면 배지가 사라집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the right, the number drops each time you read, and the badge disappears at 0."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On the right, the number drops each time you read, and the badge disappears at 0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右は読むたびに数字が減り、0になるとバッジが消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽은 읽을 때마다 숫자가 줄고, 0이 되면 배지가 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右边每读一条数字就减一，到 0 时角标消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右邊每讀一條數字就減一，到 0 時標記消失。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справа число уменьшается с каждым прочтением, а при 0 бейдж исчезает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la derecha, el número baja cada vez que lees, y la insignia desaparece en 0."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts sinkt die Zahl bei jedem Lesen, und das Badge verschwindet bei 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À droite, le nombre diminue à chaque lecture, et le badge disparaît à 0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A destra, il numero scende a ogni lettura e il badge scompare a 0."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À direita, o número cai a cada leitura e o badge some em 0."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทางขวา ตัวเลขลดลงทุกครั้งที่คุณอ่าน และป้ายตัวเลขหายไปที่ 0"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở bên phải, con số giảm mỗi lần bạn đọc, và huy hiệu biến mất ở 0."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vpravo číslo klesá s každým přečtením a odznak na 0 zmizí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til højre falder tallet, hver gang du læser, og badgen forsvinder ved 0."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στα δεξιά, ο αριθμός μειώνεται κάθε φορά που διαβάζεις, και το σήμα εξαφανίζεται στο 0."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikealla numero laskee jokaisella lukukerralla, ja merkki katoaa nollassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di kanan, angka turun setiap kali kamu membaca, dan lencana menghilang pada 0."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Til høyre går tallet ned for hver gang du leser, og merket forsvinner ved 0."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts daalt het getal elke keer dat je leest, en de badge verdwijnt bij 0."
          }
        }
      }
    },
    "오른쪽은 작성이 하단 툴바 버튼입니다. 탭은 목적지만 남았습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the right, Compose is a bottom toolbar button. Only destinations remain as tabs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On the right, Compose is a bottom toolbar button. Only destinations remain as tabs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右は作成が下部ツールバーのボタンです。タブには行き先だけが残りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽은 작성이 하단 툴바 버튼입니다. 탭은 목적지만 남았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右边的撰写是底部工具栏按钮。标签只剩下目的地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右邊的撰寫是底部工具列按鈕。標籤只剩下目的地。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справа «Написать» - кнопка нижней панели инструментов. Вкладками остались только места назначения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la derecha, Redactar es un botón de la barra de herramientas inferior. Solo quedan destinos como pestañas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts ist Verfassen ein Button der unteren Symbolleiste. Als Tabs bleiben nur Ziele übrig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À droite, Rédiger est un bouton de la barre d'outils du bas. Il ne reste que des destinations parmi les onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A destra, Scrivi è un pulsante della barra degli strumenti in basso. Come schede restano solo le destinazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À direita, Escrever é um botão da barra de ferramentas inferior. Só restam destinos como abas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทางขวา เขียนเป็นปุ่มแถบเครื่องมือด้านล่าง เหลือแต่จุดหมายปลายทางเป็นแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở bên phải, Soạn là một nút trên thanh công cụ dưới. Chỉ còn các điểm đến làm tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vpravo je Napsat tlačítko spodního panelu nástrojů. Jako karty zůstávají jen cíle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til højre er Skriv en knap i den nederste værktøjslinje. Kun destinationer er tilbage som faner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στα δεξιά, η Σύνταξη είναι κουμπί της κάτω γραμμής εργαλείων. Μόνο προορισμοί απομένουν ως καρτέλες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikealla Kirjoita on alatyökalupalkin painike. Välilehdiksi jäävät vain määränpäät."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di kanan, Tulis adalah tombol bilah alat bawah. Hanya tujuan yang tersisa sebagai tab."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Til høyre er Skriv en bunnverktøylinjeknapp. Bare destinasjoner blir igjen som faner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts is Schrijf een knop in de onderste werkbalk. Alleen bestemmingen blijven over als tabbladen."
          }
        }
      }
    },
    "오른쪽은 저장이 밖에, 별표·프린트가 접혔습니다. 선언 순서만 바꾼 결과입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the right, Save is out front and Star and Print are folded away. The only change is the declaration order."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On the right, Save is out front and Star and Print are folded away. The only change is the declaration order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右は保存が外に出て、スターとプリントが折りたたまれました。宣言の順番を変えただけの結果です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽은 저장이 밖에, 별표·프린트가 접혔습니다. 선언 순서만 바꾼 결과입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右边的存储在外面，星标、打印被折叠了。只是改了声明顺序的结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右邊的儲存在外面，星標、列印被摺疊了。只是改了宣告順序的結果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справа «Сохранить» вынесено наружу, а «Звезда» и «Печать» свёрнуты. Изменился лишь порядок объявления."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la derecha, Guardar va delante y Destacar e Imprimir están plegados. El único cambio es el orden de declaración."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts steht Sichern vorn, und Markieren und Drucken sind weggefaltet. Die einzige Änderung ist die Deklarationsreihenfolge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À droite, Enregistrer est en tête et Favori et Imprimer sont repliés. Le seul changement est l'ordre de déclaration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A destra, Salva è in primo piano e Preferiti e Stampa sono ripiegati. L'unica modifica è l'ordine di dichiarazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À direita, Salvar está na frente e Favorito e Imprimir estão dobrados. A única mudança é a ordem de declaração."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทางขวา บันทึกอยู่หน้า ส่วนติดดาวและพิมพ์ถูกพับซ่อน สิ่งเดียวที่เปลี่ยนคือลำดับการประกาศ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở bên phải, Lưu ở đầu và Gắn sao cùng In được gập đi. Thay đổi duy nhất là thứ tự khai báo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vpravo je Uložit vpředu a Hvězdička a Tisk sbaleny. Jediná změna je pořadí deklarace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til højre står Gem forrest, og Stjerne og Udskriv er gemt væk. Den eneste ændring er deklarationsrækkefølgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στα δεξιά, η Αποθήκευση είναι μπροστά και το Αστέρι και η Εκτύπωση διπλωμένα. Η μόνη αλλαγή είναι η σειρά δήλωσης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikealla Tallenna on edessä ja Tähti ja Tulosta on taitettu pois. Ainoa muutos on ilmoitusjärjestys."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di kanan, Simpan di depan dan Bintang serta Cetak dilipat. Satu-satunya perubahan adalah urutan deklarasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Til høyre er Lagre foran, og Stjerne og Skriv ut er foldet bort. Den eneste endringen er deklarasjonsrekkefølgen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts staat Bewaar vooraan en zijn Ster en Print weggeklapt. De enige wijziging is de volgorde van declaratie."
          }
        }
      }
    },
    "오른쪽은 줄이 늘어나며 값을 지킵니다. 카드가 길어질 뿐 정보는 살아 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The right one adds lines and keeps the value. The card just gets taller, and the information survives."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The right one adds lines and keeps the value. The card just gets taller, and the information survives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右は行が増えて値を守ります。カードが長くなるだけで、情報は生きています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽은 줄이 늘어나며 값을 지킵니다. 카드가 길어질 뿐 정보는 살아 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右边用增加行数来守住数值。只是卡片变长，信息还在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右邊用增加行數來守住數值。只是卡片變長，資訊還在。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правый добавляет строки и сохраняет значение. Карточка просто становится выше, а информация остаётся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La de la derecha añade líneas y conserva el valor. La tarjeta simplemente crece y la información sobrevive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die rechte fügt Zeilen hinzu und behält den Wert. Die Karte wird einfach höher, und die Information bleibt erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui de droite ajoute des lignes et garde la valeur. La carte devient simplement plus haute, et l'information survit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello a destra aggiunge righe e conserva il valore. La scheda diventa solo più alta, e l'informazione sopravvive."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O da direita acrescenta linhas e mantém o valor. O cartão só fica mais alto, e a informação sobrevive."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อันขวาเพิ่มบรรทัดและเก็บค่าไว้ การ์ดแค่สูงขึ้น และข้อมูลอยู่รอด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cái bên phải thêm dòng và giữ giá trị. Thẻ chỉ cao hơn, và thông tin sống sót."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravá přidává řádky a drží hodnotu. Karta jen povyroste a informace přežije."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den til højre tilføjer linjer og beholder værdien. Kortet bliver bare højere, og informationen overlever."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό στα δεξιά προσθέτει γραμμές και κρατά την τιμή. Η κάρτα απλώς ψηλώνει και η πληροφορία επιβιώνει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikeanpuoleinen lisää rivejä ja säilyttää arvon. Kortti vain kasvaa korkeammaksi, ja tieto säilyy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang kanan menambah baris dan mempertahankan nilai. Kartu hanya menjadi lebih tinggi, dan informasinya selamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den til høyre legger til linjer og beholder verdien. Kortet blir bare høyere, og informasjonen overlever."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rechter voegt regels toe en houdt de waarde. De kaart wordt gewoon hoger, en de informatie blijft behouden."
          }
        }
      }
    },
    "오세훈": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ethan Oh"
          }
