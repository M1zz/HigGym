    },
    "다음 회의: 목요일 오후 2시, 3층 회의실": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next meeting: Thursday 2 PM, 3rd-floor conference room"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回の会議：木曜日 午後2時、3階会議室"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 회의: 목요일 오후 2시, 3층 회의실"
          }
        }
      }
    },
    "다음에 같은 상황을 만났을 때 꺼내 쓸 수 있는 문장으로 적어보세요. 남긴 글은 **노트** 탭에 쌓입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write it as a sentence you can pull out the next time you face the same situation. What you write collects in the **Notes** tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に同じ状況に出会ったとき取り出して使える文として書いてみてください。書いたものは**ノート**タブにたまります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음에 같은 상황을 만났을 때 꺼내 쓸 수 있는 문장으로 적어보세요. 남긴 글은 **노트** 탭에 쌓입니다."
          }
        }
      }
    },
    "다이나믹 아일랜드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Island"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다이나믹 아일랜드"
          }
        }
      }
    },
    "다크 모드 색을 알아서 맞춰주므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because it adapts colors for Dark Mode automatically"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダークモードの色を自動で合わせてくれるから"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다크 모드 색을 알아서 맞춰주므로"
          }
        }
      }
    },
    "다크 모드에서 잘 보이는지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether it's easy to see in Dark Mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダークモードでよく見えるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다크 모드에서 잘 보이는지"
          }
        }
      }
    },
    "다크 모드일수록 두껍게": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thicker in Dark Mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダークモードほど厚く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다크 모드일수록 두껍게"
          }
        }
      }
    },
    "단색": {
      "localizations": {
        "en": {
