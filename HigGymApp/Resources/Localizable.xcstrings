            "value": "68 тем с примерами, 7 принципов и ваши заметки остаются бесплатными."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los 68 temas con ejemplos, los 7 principios y tus notas siguen siendo gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die 68 Themen mit Beispielen, 7 Prinzipien und deine Notizen bleiben kostenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 68 sujets avec exemples, les 7 principes et vos notes restent gratuits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I 68 argomenti con esempi, i 7 principi e i tuoi appunti restano gratuiti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os 68 tópicos com exemplos, os 7 princípios e suas notas continuam grátis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "68 หัวข้อพร้อมตัวอย่าง 7 หลักการ และโน้ตของคุณยังฟรี"
