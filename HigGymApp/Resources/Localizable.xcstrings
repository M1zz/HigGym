    "작성은 하단 툴바 버튼. 탭은 목적지만.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose is a bottom toolbar button. Tabs are only for destinations."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose is a bottom toolbar button. Tabs are only for destinations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成は下部ツールバーのボタン。タブは行き先だけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성은 하단 툴바 버튼. 탭은 목적지만."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写是底部工具栏按钮，标签只放目的地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫是底部工具列按鈕，標籤只放目的地。"
          }
        },
        "ru": {
          "stringUnit": {
