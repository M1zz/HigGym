            "state": "translated",
            "value": ".head, 앞을 자른다"
          }
        }
      }
    },
    ".large detent로 올려 지도를 가린다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raises it to the .large detent and covers the map"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".large デタントまで上げて地図を隠す"
          }
        },
        "ko": {
