    "3~5개는 터치 타깃 크기와 인지 부하가 만나는 안전 범위입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 to 5 is the safe range where touch target size and cognitive load meet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "3 to 5 is the safe range where touch target size and cognitive load meet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3〜5個は、タッチターゲットのサイズと認知負荷が折り合う安全な範囲です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3~5개는 터치 타깃 크기와 인지 부하가 만나는 안전 범위입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 到 5 个，是触控目标大小与认知负担相交的安全范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3 到 5 個，是觸控目標大小與認知負擔相交的安全範圍。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От 3 до 5 - безопасный диапазон, где сходятся размер области касания и когнитивная нагрузка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 3 a 5 es el rango seguro donde se encuentran el tamaño del objetivo táctil y la carga cognitiva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 bis 5 ist der sichere Bereich, in dem sich Größe des Touch-Ziels und kognitive Last treffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De 3 à 5 est la plage sûre où la taille des cibles tactiles et la charge cognitive se rejoignent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 3 a 5 è l'intervallo sicuro in cui si incontrano la dimensione dei bersagli tattili e il carico cognitivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De 3 a 5 é a faixa segura em que o tamanho do alvo de toque e a carga cognitiva se encontram."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ถึง 5 คือช่วงปลอดภัยที่ขนาดเป้าสัมผัสกับภาระทางความคิดมาบรรจบกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "3 đến 5 là khoảng an toàn nơi kích thước vùng chạm gặp tải nhận thức."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "3 až 5 je bezpečný rozsah, kde se potkává velikost dotykové plochy a kognitivní zátěž."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "3 til 5 er det sikre interval, hvor størrelsen på berøringsmålet og den kognitive belastning mødes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "3 έως 5 είναι το ασφαλές εύρος όπου συναντώνται το μέγεθος του στόχου αφής και το γνωστικό φορτίο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "3-5 on turvallinen vaihteluväli, jossa kosketuskohteen koko ja kognitiivinen kuorma kohtaavat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "3 sampai 5 adalah rentang aman tempat ukuran target sentuh dan beban kognitif bertemu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "3 til 5 er det trygge området der størrelsen på berøringsmålene og den kognitive belastningen møtes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "3 tot 5 is het veilige bereik waar de grootte van aanraakdoelen en de cognitieve belasting samenkomen."
          }
        }
      }
    },
    "3~5개로 추리고 나머지는 탭 안의 화면으로 내린다": {
