    "제목 자리에 텍스트가 아니라 **아바타 + 이름 + 상태**가 들어가 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title spot holds an **avatar + name + status** instead of text."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The title spot holds an **avatar + name + status** instead of text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの位置にテキストではなく**アバター + 名前 + ステータス**が入っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 자리에 텍스트가 아니라 **아바타 + 이름 + 상태**가 들어가 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题位置放的不是文字，而是**头像 + 名字 + 状态**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題位置放的不是文字，而是**頭像 + 名字 + 狀態**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На месте заголовка стоит не текст, а **аватар + имя + статус**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sitio del título lleva un **avatar + nombre + estado** en lugar de texto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Titelstelle enthält statt Text einen **Avatar + Namen + Status**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement du titre contient un **avatar + nom + statut** au lieu de texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il posto del titolo contiene **avatar + nome + stato** invece del testo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lugar do título guarda um **avatar + nome + status** em vez de texto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งชื่อเรื่องถือ**อวาตาร์ + ชื่อ + สถานะ**แทนข้อความ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí tiêu đề chứa **avatar + tên + trạng thái** thay vì chữ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místo nadpisu drží **avatar + jméno + stav** místo textu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titelpladsen rummer en **avatar + navn + status** i stedet for tekst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η θέση τίτλου κρατά **avatar + όνομα + κατάσταση** αντί για κείμενο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsikkopaikka pitää tekstin sijaan **avatarin + nimen + tilan**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat judul memuat **avatar + nama + status** alih-alih teks."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tittelplassen rommer en **avatar + navn + status** i stedet for tekst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De titelplek bevat een **avatar + naam + status** in plaats van tekst."
          }
        }
      }
    },
    "제목 자체를 눌러 대상에 대한 액션을 여는 구성입니다. 대상과 액션이 한 몸이라 관계를 설명할 필요가 없고 툴바 자리도 아낍니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You tap the title itself to open actions on its target. Target and action are one, so the relationship needs no explanation, and it saves toolbar space."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You tap the title itself to open actions on its target. Target and action are one, so the relationship needs no explanation, and it saves toolbar space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルそのものをタップして、対象についてのアクションを開く構成です。対象とアクションが一体なので関係を説明する必要がなく、ツールバーの場所も節約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 자체를 눌러 대상에 대한 액션을 여는 구성입니다. 대상과 액션이 한 몸이라 관계를 설명할 필요가 없고 툴바 자리도 아낍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是点按标题本身来打开对该对象的操作的配置。对象和操作是一体的，无需解释它们的关系，也省下了工具栏位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是輕點標題本身來開啟對該物件的操作的配置。物件和操作是一體的，無需解釋它們的關係，也省下了工具列位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы нажимаете на сам заголовок, чтобы открыть действия над его объектом. Объект и действие едины, поэтому связь не нужно объяснять, и экономится место на панели инструментов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocas el propio título para abrir las acciones sobre su objetivo. Objetivo y acción son uno, así que la relación no necesita explicación, y ahorra espacio en la barra de herramientas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tippst den Titel selbst an, um Aktionen auf sein Ziel zu öffnen. Ziel und Aktion sind eins, daher braucht die Beziehung keine Erklärung, und es spart Platz in der Symbolleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous touchez le titre lui-même pour ouvrir les actions sur sa cible. Cible et action ne font qu'un, donc la relation n'a pas besoin d'explication, et cela économise de l'espace dans la barre d'outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocchi il titolo stesso per aprire le azioni sul suo bersaglio. Bersaglio e azione sono uno solo, quindi la relazione non ha bisogno di spiegazioni, e si risparmia spazio nella barra degli strumenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você toca no próprio título para abrir as ações do alvo dele. Alvo e ação são uma coisa só, então a relação dispensa explicação, e economiza espaço na barra de ferramentas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแตะชื่อเรื่องเองเพื่อเปิดการกระทำต่อเป้าหมายของมัน เป้าหมายกับการกระทำเป็นหนึ่งเดียว ความสัมพันธ์จึงไม่ต้องอธิบาย และประหยัดพื้นที่แถบเครื่องมือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chạm chính tiêu đề để mở các hành động trên đối tượng của nó. Đối tượng và hành động là một, nên mối quan hệ không cần giải thích, và tiết kiệm chỗ thanh công cụ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnete na samotný nadpis a otevřou se akce na jeho cíli. Cíl a akce jsou jedno, takže vztah nepotřebuje vysvětlení, a šetří se místo na panelu nástrojů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du trykker på selve titlen for at åbne handlinger på dens mål. Mål og handling er ét, så forholdet behøver ingen forklaring, og det sparer plads i værktøjslinjen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατάς τον ίδιο τον τίτλο για να ανοίξεις ενέργειες στον στόχο του. Στόχος και ενέργεια είναι ένα, οπότε η σχέση δεν χρειάζεται εξήγηση, και εξοικονομείς χώρο στη γραμμή εργαλείων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napautat itse otsikkoa avataksesi kohteen toiminnot. Kohde ja toiminto ovat yksi, joten suhde ei tarvitse selitystä, ja se säästää työkalupalkin tilaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu mengetuk judul itu sendiri untuk membuka aksi pada targetnya. Target dan aksi menyatu, jadi hubungannya tak perlu dijelaskan, dan ia menghemat ruang bilah alat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du trykker på selve tittelen for å åpne handlinger på målet. Mål og handling er ett, så forholdet trenger ingen forklaring, og det sparer verktøylinjeplass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je tikt op de titel zelf om acties op het doel te openen. Doel en actie zijn één, dus de relatie hoeft geen uitleg, en het bespaart ruimte in de werkbalk."
          }
        }
      }
    },
