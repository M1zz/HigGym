            "value": "// こうしていた: 移動しないタブ\nTab(\"作成\", systemImage: \"square.and.pencil\", value: 2) { EmptyView() }\n.onChange(of: selection) { if $1 == 2 { composing = true; selection = old } }\n\n// こう直した: アクションはツールバーへ\n.toolbar {\n    ToolbarItem(placement: .bottomBar) {\n        Button(\"作成\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}"
          }
        },
        "ko": {
