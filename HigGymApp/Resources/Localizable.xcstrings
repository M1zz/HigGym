    "누구나 아는 소수의 아이콘(홈·검색)에만 쓸 수 있는 형태입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This form only works for the few icons everyone knows (Home, Search)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This form only works for the few icons everyone knows (Home, Search)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰もが知っている少数のアイコン（ホーム・検索）にしか使えない形です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 아는 소수의 아이콘(홈·검색)에만 쓸 수 있는 형태입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是只适用于人人都认识的少数图标（主页、搜索）的形态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是隻適用於人人都認識的少數圖示（主頁、搜尋）的形態。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта форма подходит только для немногих значков, которые известны всем («Главная», «Поиск»)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta forma solo funciona para los pocos iconos que todo el mundo conoce (Inicio, Buscar)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Form funktioniert nur für die wenigen Symbole, die jeder kennt (Start, Suchen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette forme ne fonctionne que pour les quelques icônes que tout le monde connaît (Accueil, Recherche)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa forma funziona solo per le poche icone che tutti conoscono (Home, Cerca)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta forma só funciona para os poucos ícones que todo mundo conhece (Início, Buscar)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบนี้ใช้ได้เฉพาะไอคอนไม่กี่ตัวที่ทุกคนรู้จัก (หน้าแรก, ค้นหา)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dạng này chỉ dùng được cho vài biểu tượng ai cũng biết (Trang chủ, Tìm kiếm)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato forma funguje jen pro těch pár ikon, které zná každý (Domů, Hledat)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne form virker kun for de få ikoner, alle kender (Hjem, Søg)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η μορφή λειτουργεί μόνο για τα λίγα εικονίδια που ξέρουν όλοι (Αρχική, Αναζήτηση)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä muoto toimii vain harvoille kuvakkeille, jotka kaikki tuntevat (Koti, Haku)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentuk ini hanya cocok untuk beberapa ikon yang dikenal semua orang (Beranda, Cari)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne formen fungerer bare for de få ikonene alle kjenner (Hjem, Søk)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vorm werkt alleen voor de paar icoontjes die iedereen kent (Thuis, Zoek)."
          }
        }
      }
    },
    "누르려던 탭이 눌렸나요? 라벨은 끝까지 보였나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the tab you meant to tap get tapped? Were the labels visible in full?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the tab you meant to tap get tapped? Were the labels visible in full?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしようとしたタブがタップされましたか？ラベルは最後まで見えましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르려던 탭이 눌렸나요? 라벨은 끝까지 보였나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想点的标签被点中了吗？标签文字能完整看到吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你想點的標籤被點中了嗎？標籤文字能完整看到嗎？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажалась ли та вкладка, которую вы хотели? Были ли подписи видны целиком?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Se tocó la pestaña que querías tocar? ¿Se veían las etiquetas completas?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wurde der Tab angetippt, den du antippen wolltest? Waren die Beschriftungen vollständig sichtbar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'onglet que vous visiez a-t-il été touché ? Les libellés étaient-ils visibles en entier ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda che volevi toccare è stata toccata? Le etichette erano visibili per intero?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aba que você pretendia tocar foi a tocada? Os rótulos estavam visíveis por inteiro?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บที่ตั้งใจจะแตะถูกแตะไหม ป้ายชื่อมองเห็นครบหรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab bạn định chạm có được chạm không? Các nhãn có hiện đầy đủ không?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepla se karta, kterou jste chtěli? Byly popisky vidět celé?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blev den fane, du ville trykke på, trykket på? Var etiketterne synlige fuldt ud?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήθηκε η καρτέλα που ήθελες να πατήσεις; Φαίνονταν ολόκληρες οι ετικέτες;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osuiko napautus oikealle välilehdelle? Näkyivätkö nimikkeet kokonaan?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah tab yang kamu maksud terketuk? Apakah label terlihat utuh?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ble fanen du ville trykke på trykket? Var etikettene fullt synlige?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werd het tabblad waarop je wilde tikken aangetikt? Waren de labels volledig zichtbaar?"
          }
        }
      }
    },
