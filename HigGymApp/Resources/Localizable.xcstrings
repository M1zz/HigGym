        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "// เกณฑ์: การให้คนอ่านทุกอย่างในแคปซูลเดียวว่าเป็น \"ชุดเดียว\" ถูกต้องหรือไม่\nToolbarItemGroup(placement: .topBarLeading) { viewToggle; sort }\nToolbarItem(placement: .topBarTrailing) { Menu { delete } }"
