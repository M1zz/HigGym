    "%@\n이 설계 판단은 적절한가요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nIs this design decision appropriate?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nIs this design decision appropriate?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nこの設計判断は適切でしょうか？"
