    "minimumScaleFactor로 글자를 줄인다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrink the text with minimumScaleFactor"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrink the text with minimumScaleFactor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactorで文字を縮小する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor로 글자를 줄인다"
          }
        },
