            "value": "Skift landestandard nedenfor til **en_US**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε τη γλώσσα και περιοχή παρακάτω σε **en_US**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda alla oleva kieliasetus arvoon **en_US**."
          }
        },
