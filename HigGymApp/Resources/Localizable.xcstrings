        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhoud"
          }
        }
      }
    },
    "내용 오류나 다뤄 줬으면 하는 화면이 있으면 알려 주세요. 메일에는 기기 모델과 iOS 버전을 함께 적어 주시면 빨리 확인할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let us know about errors in the content or screens you'd like covered. Including your device model and iOS version in the email helps us look into it quickly."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Let us know about errors in the content or screens you'd like covered. Including your device model and iOS version in the email helps us look into it quickly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容の誤りや取り上げてほしい画面があれば教えてください。メールにデバイスのモデルとiOSのバージョンを書いていただくと、早く確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용 오류나 다뤄 줬으면 하는 화면이 있으면 알려 주세요. 메일에는 기기 모델과 iOS 버전을 함께 적어 주시면 빨리 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果发现内容有误，或者希望我们讲解某个界面，请告诉我们。邮件里附上设备型号和 iOS 版本，我们能更快确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果發現內容有誤，或者希望我們講解某個介面，請告訴我們。郵件裡附上裝置型號和 iOS 版本，我們能更快確認。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщите нам об ошибках в содержимом или об экранах, которые стоит разобрать. Если указать в письме модель устройства и версию iOS, мы быстрее разберёмся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos los errores en el contenido o las pantallas que te gustaría que cubriéramos. Incluir en el correo el modelo de tu dispositivo y la versión de iOS nos ayuda a investigarlo rápido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile uns Fehler im Inhalt oder Bildschirme mit, die wir behandeln sollen. Gib in der E-Mail Gerätemodell und iOS-Version an, damit wir schnell nachgehen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalez-nous les erreurs de contenu ou les écrans que vous aimeriez voir traités. Indiquer le modèle de votre appareil et la version d'iOS dans l'e-mail nous aide à enquêter rapidement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facci sapere errori nei contenuti o schermate che vorresti vedere trattate. Indicare nell'e-mail il modello del dispositivo e la versione di iOS ci aiuta a verificare in fretta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte-nos sobre erros no conteúdo ou telas que você gostaria de ver cobertas. Incluir o modelo do seu dispositivo e a versão do iOS no e-mail nos ajuda a investigar rápido."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งข้อผิดพลาดในเนื้อหาหรือหน้าจอที่อยากให้ครอบคลุม การใส่รุ่นอุปกรณ์และเวอร์ชัน iOS ในอีเมลช่วยให้เราตรวจสอบได้เร็ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho chúng tôi biết về lỗi trong nội dung hoặc những màn hình bạn muốn được đề cập. Ghi kèm kiểu thiết bị và phiên bản iOS trong email giúp chúng tôi kiểm tra nhanh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte nám vědět o chybách v obsahu nebo o obrazovkách, které byste chtěli pokrýt. Uvedení modelu zařízení a verze iOS v e-mailu nám pomůže věc rychle prověřit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæl os om fejl i indholdet eller skærme, du gerne vil have dækket. At oplyse din enhedsmodel og iOS-version i mailen hjælper os med at undersøge det hurtigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημέρωσέ μας για λάθη στο περιεχόμενο ή οθόνες που θα ήθελες να καλύψουμε. Αν συμπεριλάβεις το μοντέλο συσκευής και την έκδοση iOS στο email, μας βοηθάς να το ελέγξουμε γρήγορα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro meille sisällön virheistä tai näkymistä, joita haluaisit käsiteltävän. Laitteen mallin ja iOS-version liittäminen sähköpostiin auttaa meitä tutkimaan asian nopeasti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu kami tentang kesalahan di konten atau layar yang ingin kamu bahas. Menyertakan model perangkat dan versi iOS di email membantu kami menelitinya dengan cepat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si fra om feil i innholdet eller skjermer du ønsker dekket. Hvis du oppgir enhetsmodell og iOS-versjon i e-posten, hjelper det oss å undersøke raskt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat ons weten of er fouten in de inhoud staan of schermen die je behandeld wilt zien. Het vermelden van je apparaatmodel en iOS-versie in de e-mail helpt ons het snel uit te zoeken."
          }
        }
      }
    },
    "내용이 커지면 어떻게 되는지도 확인해 보세요. 커스텀 높이는 내용과 어긋나기 쉽습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also check what happens when the content grows. Custom heights easily fall out of sync with the content."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Also check what happens when the content grows. Custom heights easily fall out of sync with the content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が増えたらどうなるかも確かめてみてください。カスタムの高さは内容とずれやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 커지면 어떻게 되는지도 확인해 보세요. 커스텀 높이는 내용과 어긋나기 쉽습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也请确认内容变大后会怎样。自定义高度很容易和内容错位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也請確認內容變大後會怎樣。自定義高度很容易和內容錯位。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте и то, что будет, когда содержимое вырастет. Пользовательская высота легко расходится с содержимым."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba también qué ocurre cuando el contenido crece. Las alturas personalizadas se desfasan fácilmente del contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe auch, was passiert, wenn der Inhalt wächst. Eigene Höhen geraten leicht aus dem Takt mit dem Inhalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez aussi ce qui se passe quand le contenu grossit. Les hauteurs personnalisées se désynchronisent facilement du contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla anche cosa succede quando il contenuto cresce. Le altezze personalizzate si disallineano facilmente dal contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira também o que acontece quando o conteúdo cresce. Alturas personalizadas facilmente saem de sincronia com o conteúdo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจด้วยว่าเกิดอะไรขึ้นเมื่อเนื้อหาโตขึ้น ความสูงแบบกำหนดเองหลุดซิงค์กับเนื้อหาได้ง่าย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cũng kiểm tra xem điều gì xảy ra khi nội dung dài ra. Chiều cao tùy chỉnh dễ lệch pha với nội dung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte také, co se stane, když obsah poroste. Vlastní výšky se snadno rozcházejí s obsahem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek også, hvad der sker, når indholdet vokser. Brugerdefinerede højder kommer let ud af takt med indholdet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε επίσης τι συμβαίνει όταν το περιεχόμενο μεγαλώνει. Τα προσαρμοσμένα ύψη εύκολα χάνουν τον συγχρονισμό με το περιεχόμενο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista myös, mitä tapahtuu, kun sisältö kasvaa. Mukautetut korkeudet menevät helposti epäsynkkaan sisällön kanssa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa juga apa yang terjadi saat konten bertambah. Tinggi kustom mudah tidak sinkron dengan konten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk også hva som skjer når innholdet vokser. Egendefinerte høyder kommer lett ut av synk med innholdet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer ook wat er gebeurt als de inhoud groeit. Aangepaste hoogtes lopen makkelijk uit de pas met de inhoud."
          }
        }
      }
    },
