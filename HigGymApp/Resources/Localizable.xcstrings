          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale apre selezione e copia per i valori che le persone devono copiare? (Prova a tenere premuto sul testo)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual abre seleção e cópia para valores que as pessoas precisam copiar? (Tente pressionar e segurar o texto)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อันไหนเปิดการเลือกและคัดลอกสำหรับค่าที่คนต้องคัดลอก (ลองกดค้างที่ข้อความ)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cái nào mở chọn và sao chép cho các giá trị người ta cần sao chép? (Thử nhấn giữ văn bản)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Která otevírá výběr a kopírování pro hodnoty, které lidé potřebují zkopírovat? (Zkuste text dlouze podržet)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken åbner markering og kopiering af værdier, folk skal kopiere? (Prøv at trykke og holde på teksten)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποιο ανοίγει επιλογή και αντιγραφή για τιμές που πρέπει να αντιγράψουν οι άνθρωποι; (Δοκίμασε παρατεταμένο πάτημα στο κείμενο)"
