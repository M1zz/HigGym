    "저장을 어디서 찾았나요? 한 번 저장하는 데 몇 번의 동작이 필요했나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did you find Save? How many steps did one save take?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did you find Save? How many steps did one save take?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存はどこで見つかりましたか？1回保存するのに何回の操作が必要でしたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장을 어디서 찾았나요? 한 번 저장하는 데 몇 번의 동작이 필요했나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是在哪里找到存储的？存储一次需要几个动作？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是在哪裡找到儲存的？儲存一次需要幾個動作？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где вы нашли «Сохранить»? Сколько шагов занимало одно сохранение?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde encontraste Guardar? ¿Cuántos pasos llevó un guardado?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo hast du Sichern gefunden? Wie viele Schritte brauchte ein Sichern?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où avez-vous trouvé Enregistrer ? Combien d'étapes a demandé un enregistrement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove hai trovato Salva? Quanti passi ha richiesto un salvataggio?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde você achou Salvar? Quantos passos um salvamento levou?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเจอปุ่มบันทึกที่ไหน บันทึกหนึ่งครั้งใช้กี่ขั้นตอน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn tìm thấy Lưu ở đâu? Một lần lưu mất bao nhiêu bước?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kde jste našli Uložit? Kolik kroků zabralo jedno uložení?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor fandt du Gem? Hvor mange trin tog ét gem?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πού βρήκες την Αποθήκευση; Πόσα βήματα χρειάστηκε μία αποθήκευση;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistä löysit Tallenna-toiminnon? Kuinka monta askelta yksi tallennus vei?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di mana kamu menemukan Simpan? Berapa langkah yang dibutuhkan satu kali simpan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor fant du Lagre? Hvor mange steg tok én lagring?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar vond je Bewaar? Hoeveel stappen kostte één keer bewaren?"
          }
        }
      }
    },
    "저장이 **⋯ 안**에. 저장 횟수 %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save is **inside ⋯**. Saves: %lld"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Save is **inside ⋯**. Saves: %lld"
          }
        },
