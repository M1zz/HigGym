            "value": "String-interpolatie is slecht voor de prestaties"
          }
        }
      }
    },
    "문자열이 아니라 Date 값을 갖고 있고, 표기는 로케일에 맡긴다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a Date value, not a string, and leave the format to the locale"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a Date value, not a string, and leave the format to the locale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字列ではなく Date 値を持ち、表記はロケールに任せる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자열이 아니라 Date 값을 갖고 있고, 표기는 로케일에 맡긴다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的不是字符串而是 Date 值，写法交给区域设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的不是字串而是 Date 值，寫法交給區域設定"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранить значение Date, а не строку, и оставить запись региону"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un valor Date, no una cadena, y deja el formato a la configuración regional"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Date-Wert statt einer Zeichenfolge und überlasse das Format der Region"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez une valeur Date, pas une chaîne, et laissez le format à la région"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni un valore Date, non una stringa, e lascia il formato alla regione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde um valor Date, não uma string, e deixe o formato para a região"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บค่าชนิด Date ไม่ใช่สตริง และปล่อยรูปแบบให้ภาษาและภูมิภาคจัดการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ một giá trị Date, không phải chuỗi, và để định dạng cho ngôn ngữ và vùng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držte hodnotu Date, ne řetězec, a formát nechte na lokalitě"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en Date-værdi, ikke en streng, og overlad formatet til landestandarden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτα μια τιμή Date, όχι συμβολοσειρά, και άφησε τη μορφή στη γλώσσα και περιοχή"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä Date-arvoa, älä merkkijonoa, ja jätä muoto kieliasetukselle"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan nilai Date, bukan string, dan serahkan formatnya ke locale"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold en Date-verdi, ikke en streng, og overlat formatet til locale"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar een Date-waarde, geen string, en laat het formaat aan de locale over"
          }
        }
      }
    },
    "문장, 잘려도 앞부분으로 뜻이 통한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sentence still makes sense from its beginning when cut off"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sentence still makes sense from its beginning when cut off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文章は、切り詰められても冒頭で意味が通じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장, 잘려도 앞부분으로 뜻이 통한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "句子，即使被截断，开头部分也能表达意思"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "句子，即使被截斷，開頭部分也能表達意思"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложение сохраняет смысл по началу, даже если его обрезать"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase sigue teniendo sentido desde el principio aunque se corte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Satz ergibt auch abgeschnitten von seinem Anfang her noch Sinn"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une phrase garde un sens depuis son début même coupée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase ha ancora senso dall'inizio anche se tagliata"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma frase ainda faz sentido desde o começo quando cortada"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประโยคยังมีความหมายตั้งแต่ต้นแม้ถูกตัด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một câu vẫn hiểu được từ phần đầu khi bị cắt"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Věta dává smysl od svého začátku i po oříznutí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En sætning giver stadig mening fra sin begyndelse, selv når den skæres af"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια πρόταση εξακολουθεί να βγάζει νόημα από την αρχή της όταν κοπεί"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lauseella on edelleen järkeä alustaan asti, kun se katkaistaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah kalimat masih masuk akal dari awalnya saat dipotong"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En setning gir fortsatt mening fra begynnelsen når den kuttes"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zin is nog steeds logisch vanaf het begin als hij wordt afgekapt"
          }
        }
      }
    },
    "문장에 쓰면 이렇게 됩니다, 다 보이긴 하지만 **읽히지 않습니다**. 가독성이 미학을 이깁니다(8.1.4).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here's what happens in a sentence: it all fits, but **it can't be read**. Legibility beats aesthetics (8.1.4)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Here's what happens in a sentence: it all fits, but **it can't be read**. Legibility beats aesthetics (8.1.4)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文章に使うとこうなります。すべて見えはしますが、**読めません**。読みやすさは美しさに勝ります（8.1.4）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장에 쓰면 이렇게 됩니다, 다 보이긴 하지만 **읽히지 않습니다**. 가독성이 미학을 이깁니다(8.1.4)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用在句子上就是这样：虽然全都看得见，却**读不下去**。可读性胜过美观（8.1.4）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用在句子上就是這樣：雖然全都看得見，卻**讀不下去**。可讀性勝過美觀（8.1.4）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот что получается с предложением: всё помещается, но **читать невозможно**. Читаемость важнее эстетики (8.1.4)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es lo que pasa con una frase: cabe entera, pero **no se puede leer**. La legibilidad vence a la estética (8.1.4)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das passiert bei einem Satz: Es passt alles, aber **es lässt sich nicht lesen**. Lesbarkeit schlägt Ästhetik (8.1.4)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici ce qui arrive dans une phrase : tout tient, mais **on ne peut pas la lire**. La lisibilité l'emporte sur l'esthétique (8.1.4)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco che cosa succede in una frase: ci sta tutta, ma **non si può leggere**. La leggibilità batte l'estetica (8.1.4)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eis o que acontece numa frase: ela cabe toda, mas **não dá para ler**. Legibilidade vence estética (8.1.4)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือสิ่งที่เกิดกับประโยค: ใส่ได้ครบ แต่**อ่านไม่ได้** ความอ่านออกชนะความสวยงาม (8.1.4)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là chuyện xảy ra với một câu: nó vừa hết, nhưng **không đọc được**. Dễ đọc thắng thẩm mỹ (8.1.4)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co se stane ve větě: všechno se vejde, ale **nedá se to přečíst**. Čitelnost má přednost před estetikou (8.1.4)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her er, hvad der sker i en sætning: det hele passer, men **den kan ikke læses**. Læsbarhed slår æstetik (8.1.4)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να τι συμβαίνει σε μια πρόταση: χωρά όλη, αλλά **δεν διαβάζεται**. Η αναγνωσιμότητα νικά την αισθητική (8.1.4)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näin käy lauseessa: kaikki mahtuu, mutta **sitä ei voi lukea**. Luettavuus voittaa estetiikan (8.1.4)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Inilah yang terjadi pada kalimat: semuanya muat, tetapi **tidak bisa dibaca**. Keterbacaan mengalahkan estetika (8.1.4)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slik går det med en setning: alt får plass, men **den kan ikke leses**. Lesbarhet slår estetikk (8.1.4)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo gaat het met een zin: alles past, maar **het is niet te lezen**. Leesbaarheid wint van esthetiek (8.1.4)."
          }
        }
      }
    },
    "문장에 축소를 걸면 글자만 작아지고 읽기는 더 어려워집니다. 문장은 자르거나(truncation) 줄 수를 늘리는 쪽이 맞습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply scaling to a sentence and only the letters get smaller, making it harder to read. For sentences, truncation or more lines is the right approach."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply scaling to a sentence and only the letters get smaller, making it harder to read. For sentences, truncation or more lines is the right approach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文章に縮小をかけると文字が小さくなるだけで、かえって読みにくくなります。文章は切り詰める（truncation）か、行数を増やすほうが正解です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장에 축소를 걸면 글자만 작아지고 읽기는 더 어려워집니다. 문장은 자르거나(truncation) 줄 수를 늘리는 쪽이 맞습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对句子做缩小，只会让字变小、更难读。句子应该截断（truncation）或增加行数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對句子做縮小，只會讓字變小、更難讀。句子應該截斷（truncation）或增加行數。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если применить к предложению масштабирование, уменьшатся только буквы, и читать станет труднее. Для предложений правильны обрезка (truncation) или больше строк."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica el escalado a una frase y solo las letras se hacen más pequeñas, lo que dificulta la lectura. Para frases, lo correcto es truncar o usar más líneas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet man Skalierung auf einen Satz an, werden nur die Buchstaben kleiner, was das Lesen erschwert. Bei Sätzen ist Abschneiden oder mehr Zeilen der richtige Ansatz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquez la mise à l'échelle à une phrase et seules les lettres rapetissent, ce qui la rend plus difficile à lire. Pour les phrases, la bonne approche est la troncature ou davantage de lignes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica la scalatura a una frase e si rimpiccioliscono solo le lettere, rendendola più difficile da leggere. Per le frasi, il troncamento o più righe è l'approccio giusto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplique escala a uma frase e só as letras diminuem, deixando-a mais difícil de ler. Para frases, truncamento ou mais linhas é a abordagem certa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้การปรับขนาดกับประโยค แล้วมีแต่ตัวอักษรที่เล็กลง ทำให้อ่านยากขึ้น สำหรับประโยค การตัดหรือเพิ่มบรรทัดคือแนวทางที่ถูก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng co chữ cho một câu thì chỉ các chữ nhỏ đi, khiến khó đọc hơn. Với câu, cắt bớt hoặc thêm dòng là cách đúng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte škálování na větu a zmenší se jen písmena, což ztěžuje čtení. Pro věty je správný přístup ořez nebo víc řádků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anvend skalering på en sætning, og kun bogstaverne bliver mindre, hvilket gør den sværere at læse. For sætninger er afkortning eller flere linjer den rigtige tilgang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εφάρμοσε κλιμάκωση σε μια πρόταση και μικραίνουν μόνο τα γράμματα, κάνοντάς την δυσκολότερη στην ανάγνωση. Για προτάσεις, η περικοπή ή οι περισσότερες γραμμές είναι η σωστή προσέγγιση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä skaalausta lauseeseen, ja vain kirjaimet pienenevät, mikä vaikeuttaa lukemista. Lauseissa katkaisu tai lisää rivejä on oikea lähestymistapa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terapkan penskalaan pada kalimat dan hanya hurufnya yang mengecil, membuatnya lebih sulit dibaca. Untuk kalimat, pemotongan atau lebih banyak baris adalah pendekatan yang tepat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk skalering på en setning, og bare bokstavene blir mindre, noe som gjør den vanskeligere å lese. For setninger er avkorting eller flere linjer riktig tilnærming."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas schalen toe op een zin en alleen de letters worden kleiner, waardoor hij moeilijker te lezen is. Voor zinnen is afkappen of meer regels de juiste aanpak."
          }
        }
      }
    },
    "문장이 잘리면 요약이 되지만 숫자가 잘리면 **다른 값**이 된다. 텍스트 처리 규칙을 앱 전체에 일괄로 세우면 안 되는 이유가 여기 있다, 규칙은 값의 종류마다 다르다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A truncated sentence becomes a summary, but a truncated number becomes **a different value**. That's why you can't set one text-handling rule for the whole app: the rule depends on the kind of value."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A truncated sentence becomes a summary, but a truncated number becomes **a different value**. That's why you can't set one text-handling rule for the whole app: the rule depends on the kind of value."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文章が切り詰められれば要約になるが、数字が切り詰められると**別の値**になる。テキスト処理のルールをアプリ全体で一律に決めてはいけない理由はここにある。ルールは値の種類ごとに違う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문장이 잘리면 요약이 되지만 숫자가 잘리면 **다른 값**이 된다. 텍스트 처리 규칙을 앱 전체에 일괄로 세우면 안 되는 이유가 여기 있다, 규칙은 값의 종류마다 다르다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "句子被截断还能成为摘要，数字被截断就成了**另一个值**。这就是不能给整个应用统一设定文字处理规则的原因：规则因值的类型而异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "句子被截斷還能成為摘要，數字被截斷就成了**另一個值**。這就是不能給整個應用程式統一設定文書處理規則的原因：規則因值的型別而異。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезанное предложение превращается в краткое изложение, а обрезанное число - в **другое значение**. Поэтому нельзя задать одно правило обработки текста для всего приложения: правило зависит от вида значения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase truncada se convierte en un resumen, pero un número truncado se convierte en **otro valor**. Por eso no puedes fijar una única regla de tratamiento de texto para toda la app: la regla depende del tipo de valor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein abgeschnittener Satz wird zur Zusammenfassung, aber eine abgeschnittene Zahl wird zu **einem anderen Wert**. Deshalb kannst du nicht eine einzige Textregel für die ganze App aufstellen: Die Regel hängt von der Art des Werts ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une phrase tronquée devient un résumé, mais un nombre tronqué devient **une autre valeur**. C'est pourquoi on ne peut pas fixer une seule règle de traitement du texte pour toute l'app : la règle dépend du type de valeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una frase troncata diventa un riassunto, ma un numero troncato diventa **un altro valore**. Per questo non puoi fissare un'unica regola di gestione del testo per tutta l'app: la regola dipende dal tipo di valore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma frase truncada vira um resumo, mas um número truncado vira **outro valor**. Por isso não dá para fixar uma única regra de tratamento de texto para o app todo: a regra depende do tipo de valor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประโยคที่ถูกตัดกลายเป็นบทสรุป แต่ตัวเลขที่ถูกตัดกลายเป็น**ค่าอื่น** นั่นคือเหตุผลที่ตั้งกฎจัดการข้อความเดียวให้ทั้งแอปไม่ได้: กฎขึ้นอยู่กับชนิดของค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một câu bị cắt thành bản tóm tắt, nhưng một con số bị cắt thành **một giá trị khác**. Đó là lý do bạn không thể đặt một quy tắc xử lý văn bản cho cả app: quy tắc phụ thuộc vào loại giá trị."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oříznutá věta se stane shrnutím, ale oříznuté číslo se stane **jinou hodnotou**. Proto nejde nastavit jediné pravidlo pro zacházení s textem v celé aplikaci: pravidlo závisí na druhu hodnoty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En afkortet sætning bliver et resumé, men et afkortet tal bliver **en anden værdi**. Derfor kan du ikke sætte én tekstregel for hele appen: reglen afhænger af værdiens art."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια περικομμένη πρόταση γίνεται περίληψη, αλλά ένας περικομμένος αριθμός γίνεται **διαφορετική τιμή**. Γι' αυτό δεν μπορείς να ορίσεις έναν κανόνα χειρισμού κειμένου για όλη την εφαρμογή: ο κανόνας εξαρτάται από το είδος της τιμής."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkaistusta lauseesta tulee yhteenveto, mutta katkaistusta luvusta tulee **eri arvo**. Siksi koko sovellukselle ei voi asettaa yhtä tekstinkäsittelysääntöä: sääntö riippuu arvon lajista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalimat yang terpotong menjadi ringkasan, tetapi angka yang terpotong menjadi **nilai yang berbeda**. Itulah mengapa kamu tidak bisa menetapkan satu aturan penanganan teks untuk seluruh aplikasi: aturannya bergantung pada jenis nilai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En avkortet setning blir et sammendrag, men et avkortet tall blir **en annen verdi**. Derfor kan du ikke sette én regel for tekstbehandling for hele appen: regelen avhenger av typen verdi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een afgekapte zin wordt een samenvatting, maar een afgekapt getal wordt **een andere waarde**. Daarom kun je niet één regel voor tekstafhandeling voor de hele app vaststellen: de regel hangt af van het soort waarde."
          }
        }
      }
    },
    "문제를 맞혔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You got it right"
          }
        },
        "en-GB": {
          "stringUnit": {
