            "value": "多少個以內算標籤列"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько вкладок помещается в панель вкладок?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuántas pestañas caben en una barra de pestañas?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Tabs passen in eine Tab-Leiste?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien d'onglets tiennent dans une barre d'onglets ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quante schede entrano in una barra delle schede?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantas abas cabem numa barra de abas?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บใส่ได้กี่แท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thanh tab chứa được bao nhiêu tab?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik karet se vejde do panelu karet?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange faner er der plads til i en fanelinje?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πόσες καρτέλες χωρούν σε μια γραμμή καρτελών;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuinka monta välilehteä mahtuu välilehtipalkkiin?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berapa banyak tab yang muat di bilah tab?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor mange faner passer i en fanelinje?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveel tabbladen passen in een tabbalk?"
          }
        }
      }
    },
    "모달성의 시각 신호, 딤이 없다는 건 “뒤를 만져도 된다”는 뜻입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No dimming, the visual signal of modality, means “you can touch what's behind.”"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No dimming, the visual signal of modality, means “you can touch what's behind.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モーダル性の視覚的な合図であるディムがないことは、「背後に触れてもいい」という意味です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모달성의 시각 신호, 딤이 없다는 건 “뒤를 만져도 된다”는 뜻입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模态性的视觉信号：没有压暗，意味着“可以操作后面”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模態性的視覺訊號：沒有壓暗，意味著「可以操作後面」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсутствие затемнения - визуальный сигнал модальности: «позади можно трогать»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ausencia de atenuación, la señal visual de la modalidad, significa «puedes tocar lo que hay detrás»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Abdunklung, das visuelle Signal der Modalität, heißt: „Du kannst anfassen, was dahinter liegt.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'assombrissement, le signal visuel de la modalité, signifie « vous pouvez toucher ce qui est derrière »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente oscuramento, il segnale visivo della modalità, significa «puoi toccare ciò che sta dietro»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem escurecimento, o sinal visual da modalidade, significa «você pode tocar no que está atrás»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการหรี่ ซึ่งเป็นสัญญาณภาพของความเป็นโมดัล หมายถึง “คุณแตะสิ่งที่อยู่ด้านหลังได้”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không làm tối, tín hiệu thị giác của tính modal, nghĩa là “bạn chạm được thứ phía sau.”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné ztmavení, vizuální signál modality, znamená „můžete sáhnout na to, co je za tím“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mørklægning, modalitetens visuelle signal, betyder »du kan røre ved det, der er bagved.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απουσία σκίασης, το οπτικό σήμα της τροπικότητας, σημαίνει «μπορείς να αγγίξεις ό,τι βρίσκεται πίσω»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Himmennyksen puuttuminen, modaalisuuden visuaalinen merkki, tarkoittaa ”voit koskettaa taustaa”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa peredupan, sinyal visual modalitas, berarti \"kamu bisa menyentuh yang ada di belakang.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dimming, det visuelle signalet for modalitet, betyr «du kan røre det som er bak»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen dimming, het visuele signaal van modaliteit, betekent \"je kunt aanraken wat erachter zit\"."
          }
        }
      }
    },
    "모달의 본질은 “응답을 요구하고 나머지를 차단”인데 도구 패널은 응답이 아니라 **병행 작업**입니다. 딤이 사라진 것이 “뒤를 만져도 된다”는 시각 신호입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A modal by nature “demands a response and blocks everything else,” but a tool panel isn't a response, it's **parallel work**. The missing dimming is the visual signal that “you can touch what's behind.”"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A modal by nature “demands a response and blocks everything else,” but a tool panel isn't a response, it's **parallel work**. The missing dimming is the visual signal that “you can touch what's behind.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モーダルの本質は「応答を求め、それ以外を遮断する」ことですが、ツールパネルは応答ではなく**並行作業**です。ディムが消えたことが「背後に触れてもいい」という視覚的な合図です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모달의 본질은 “응답을 요구하고 나머지를 차단”인데 도구 패널은 응답이 아니라 **병행 작업**입니다. 딤이 사라진 것이 “뒤를 만져도 된다”는 시각 신호입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模态的本质是“要求回应并屏蔽其余”，而工具面板不是回应，而是**并行工作**。压暗消失，就是“可以操作后面”的视觉信号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模態的本質是「要求回應並遮蔽其餘」，而工具面板不是回應，而是**並行工作**。壓暗消失，就是「可以操作後面」的視覺訊號。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Суть модального окна - «потребовать ответа и заблокировать остальное», но панель инструментов - это не ответ, а **параллельная работа**. Отсутствие затемнения - визуальный сигнал «позади можно трогать»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modal por naturaleza «exige una respuesta y bloquea todo lo demás», pero un panel de herramientas no es una respuesta, es **trabajo en paralelo**. La falta de atenuación es la señal visual de que «puedes tocar lo que hay detrás»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Modal „verlangt von Natur aus eine Antwort und blockiert alles andere“, aber ein Werkzeugpanel ist keine Antwort, sondern **parallele Arbeit**. Die fehlende Abdunklung ist das visuelle Signal: „Du kannst anfassen, was dahinter liegt.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une modale par nature « exige une réponse et bloque tout le reste », mais un panneau d'outils n'est pas une réponse, c'est du **travail en parallèle**. L'absence d'assombrissement est le signal visuel qui dit « vous pouvez toucher ce qui est derrière »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modale per natura «esige una risposta e blocca tutto il resto», ma un pannello di strumenti non è una risposta, è **lavoro in parallelo**. L'oscuramento assente è il segnale visivo che dice «puoi toccare ciò che sta dietro»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um modal por natureza «exige uma resposta e bloqueia todo o resto», mas um painel de ferramentas não é uma resposta, é **trabalho em paralelo**. A falta de escurecimento é o sinal visual de que «você pode tocar no que está atrás»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดยธรรมชาติ โมดัล “เรียกร้องการตอบสนองและบล็อกทุกอย่างอื่น” แต่แผงเครื่องมือไม่ใช่การตอบสนอง มันคือ**งานคู่ขนาน** การไม่มีการหรี่คือสัญญาณภาพว่า “คุณแตะสิ่งที่อยู่ด้านหลังได้”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Về bản chất, một modal “đòi hỏi phản hồi và chặn mọi thứ khác”, nhưng một bảng công cụ không phải là phản hồi, nó là **công việc song song**. Việc không làm tối là tín hiệu thị giác rằng “bạn chạm được thứ phía sau.”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modální chování „vyžaduje odpověď a blokuje všechno ostatní“, ale panel nástrojů není odpověď, je to **souběžná práce**. Chybějící ztmavení je vizuálním signálem, že „můžete sáhnout na to, co je za tím“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En modal »kræver et svar og blokerer alt andet«, men et værktøjspanel er ikke et svar, det er **parallelt arbejde**. Den manglende mørklægning er det visuelle signal om, at »du kan røre ved det, der er bagved.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα modal από τη φύση του «απαιτεί απάντηση και μπλοκάρει όλα τα άλλα», αλλά ένα πάνελ εργαλείων δεν είναι απάντηση, είναι **παράλληλη εργασία**. Η απουσία σκίασης είναι το οπτικό σήμα ότι «μπορείς να αγγίξεις ό,τι βρίσκεται πίσω»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Modaali ”vaatii vastauksen ja estää kaiken muun” luonteeltaan, mutta työkalupaneeli ei ole vastaus, se on **rinnakkaista työtä**. Puuttuva himmennys on visuaalinen merkki siitä, että ”voit koskettaa taustaa”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Modal pada dasarnya \"menuntut respons dan memblokir semua yang lain\", tetapi panel alat bukanlah respons, ia **pekerjaan paralel**. Peredupan yang hilang adalah sinyal visual bahwa \"kamu bisa menyentuh yang ada di belakang.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En modal «krever et svar og blokkerer alt annet» av natur, men et verktøypanel er ikke et svar, det er **parallelt arbeid**. Den manglende dimmingen er det visuelle signalet om at «du kan røre det som er bak»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een modal \"eist van nature een antwoord en blokkeert al het andere\", maar een gereedschapspaneel is geen antwoord, het is **parallel werk**. De ontbrekende dimming is het visuele signaal dat \"je kunt aanraken wat erachter zit\"."
          }
        }
      }
    },
    "모달의 본질은 “응답을 요구하고 나머지를 차단”인데, 도구 패널은 응답이 아니라 **병행 작업**입니다.\n\n시트의 형태(하단 패널)만 빌리고 모달성은 제거한 것이 nonmodal 시트입니다. 딤이 없는 것이 “뒤를 만져도 된다”는 시각 신호입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A modal by nature “demands a response and blocks everything else,” but a tool panel isn't a response, it's **parallel work**.\n\nA nonmodal sheet borrows only the sheet's form (a bottom panel) and drops the modality. The absence of dimming is the visual signal that “you can touch what's behind.”"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A modal by nature “demands a response and blocks everything else,” but a tool panel isn't a response, it's **parallel work**.\n\nA nonmodal sheet borrows only the sheet's form (a bottom panel) and drops the modality. The absence of dimming is the visual signal that “you can touch what's behind.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モーダルの本質は「応答を求め、それ以外を遮断する」ことですが、ツールパネルは応答ではなく**並行作業**です。\n\nシートの形（下部のパネル）だけを借りてモーダル性を取り除いたのが nonmodal シートです。ディムがないことが「背後に触れてもいい」という視覚的な合図です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모달의 본질은 “응답을 요구하고 나머지를 차단”인데, 도구 패널은 응답이 아니라 **병행 작업**입니다.\n\n시트의 형태(하단 패널)만 빌리고 모달성은 제거한 것이 nonmodal 시트입니다. 딤이 없는 것이 “뒤를 만져도 된다”는 시각 신호입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模态的本质是“要求回应并屏蔽其余”，而工具面板不是回应，而是**并行工作**。\n\n非模态弹层只借用了弹层的形态（底部面板），去掉了模态性。没有压暗，就是“可以操作后面”的视觉信号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模態的本質是「要求回應並遮蔽其餘」，而工具面板不是回應，而是**並行工作**。\n\n非模態工作表只借用了工作表的形態（底部面板），去掉了模態性。沒有壓暗，就是「可以操作後面」的視覺訊號。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Суть модального окна - «потребовать ответа и заблокировать остальное», но панель инструментов - это не ответ, а **параллельная работа**.\n\nНеблокирующая шторка заимствует лишь форму шторки (нижняя панель) и убирает модальность. Отсутствие затемнения - визуальный сигнал «позади можно трогать»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modal por naturaleza «exige una respuesta y bloquea todo lo demás», pero un panel de herramientas no es una respuesta, es **trabajo en paralelo**.\n\nUna hoja no modal toma prestada solo la forma de la hoja (un panel inferior) y deja la modalidad. La ausencia de atenuación es la señal visual de que «puedes tocar lo que hay detrás»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Modal „verlangt von Natur aus eine Antwort und blockiert alles andere“, aber ein Werkzeugpanel ist keine Antwort, sondern **parallele Arbeit**.\n\nEin nichtmodales Sheet übernimmt nur die Form des Sheets (ein unteres Panel) und lässt die Modalität weg. Die fehlende Abdunklung ist das visuelle Signal: „Du kannst anfassen, was dahinter liegt.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une modale par nature « exige une réponse et bloque tout le reste », mais un panneau d'outils n'est pas une réponse, c'est du **travail en parallèle**.\n\nUne feuille nonmodal n'emprunte que la forme de la feuille (un panneau du bas) et abandonne la modalité. L'absence d'assombrissement est le signal visuel qui dit « vous pouvez toucher ce qui est derrière »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modale per natura «esige una risposta e blocca tutto il resto», ma un pannello di strumenti non è una risposta, è **lavoro in parallelo**.\n\nUn foglio nonmodal prende in prestito solo la forma del foglio (un pannello in basso) e lascia cadere la modalità. L'assenza di oscuramento è il segnale visivo che dice «puoi toccare ciò che sta dietro»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um modal por natureza «exige uma resposta e bloqueia todo o resto», mas um painel de ferramentas não é uma resposta, é **trabalho em paralelo**.\n\nUma folha nonmodal toma emprestada só a forma da folha (um painel embaixo) e abandona a modalidade. A ausência de escurecimento é o sinal visual de que «você pode tocar no que está atrás»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดยธรรมชาติ โมดัล “เรียกร้องการตอบสนองและบล็อกทุกอย่างอื่น” แต่แผงเครื่องมือไม่ใช่การตอบสนอง มันคือ**งานคู่ขนาน**\n\nชีตแบบ nonmodal ยืมเฉพาะรูปทรงของชีต (แผงด้านล่าง) และทิ้งความเป็นโมดัล การไม่มีการหรี่คือสัญญาณภาพว่า “คุณแตะสิ่งที่อยู่ด้านหลังได้”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Về bản chất, một modal “đòi hỏi phản hồi và chặn mọi thứ khác”, nhưng một bảng công cụ không phải là phản hồi, nó là **công việc song song**.\n\nMột sheet nonmodal chỉ mượn hình dạng của sheet (bảng phía dưới) và bỏ tính modal. Việc không làm tối là tín hiệu thị giác rằng “bạn chạm được thứ phía sau.”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Modální chování „vyžaduje odpověď a blokuje všechno ostatní“, ale panel nástrojů není odpověď, je to **souběžná práce**.\n\nNonmodal sheet si půjčuje jen formu sheetu (spodní panel) a zahazuje modalitu. Absence ztmavení je vizuálním signálem, že „můžete sáhnout na to, co je za tím“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En modal »kræver et svar og blokerer alt andet«, men et værktøjspanel er ikke et svar, det er **parallelt arbejde**.\n\nEt nonmodalt ark låner kun arkets form (et bundpanel) og dropper modaliteten. Fraværet af mørklægning er det visuelle signal om, at »du kan røre ved det, der er bagved.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα modal από τη φύση του «απαιτεί απάντηση και μπλοκάρει όλα τα άλλα», αλλά ένα πάνελ εργαλείων δεν είναι απάντηση, είναι **παράλληλη εργασία**.\n\nΈνα nonmodal φύλλο δανείζεται μόνο τη μορφή του φύλλου (ένα κάτω πάνελ) και αφήνει την τροπικότητα. Η απουσία σκίασης είναι το οπτικό σήμα ότι «μπορείς να αγγίξεις ό,τι βρίσκεται πίσω»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Modaali ”vaatii vastauksen ja estää kaiken muun” luonteeltaan, mutta työkalupaneeli ei ole vastaus, se on **rinnakkaista työtä**.\n\nNonmodal-arkki lainaa vain arkin muodon (alapaneeli) ja luopuu modaalisuudesta. Himmennyksen puuttuminen on visuaalinen merkki siitä, että ”voit koskettaa taustaa”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Modal pada dasarnya \"menuntut respons dan memblokir semua yang lain\", tetapi panel alat bukanlah respons, ia **pekerjaan paralel**.\n\nLembar nonmodal hanya meminjam bentuk lembar (panel bawah) dan membuang modalitasnya. Ketiadaan peredupan adalah sinyal visual bahwa \"kamu bisa menyentuh yang ada di belakang.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En modal «krever et svar og blokkerer alt annet» av natur, men et verktøypanel er ikke et svar, det er **parallelt arbeid**.\n\nEt nonmodal ark låner bare arkets form (et bunnpanel) og dropper modaliteten. Fraværet av dimming er det visuelle signalet om at «du kan røre det som er bak»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een modal \"eist van nature een antwoord en blokkeert al het andere\", maar een gereedschapspaneel is geen antwoord, het is **parallel werk**.\n\nEen nonmodal sheet leent alleen de vorm van de sheet (een onderpaneel) en laat de modaliteit vallen. De afwezigheid van dimming is het visuele signaal dat \"je kunt aanraken wat erachter zit\"."
          }
        }
      }
    },
    "모달입니다, 뒤는 딤 처리되어 닫기 전에는 만질 수 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's modal: the background is dimmed and can't be touched until you close it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's modal: the background is dimmed and can't be touched until you close it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モーダルです。背後はディムがかかり、閉じるまでは触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모달입니다, 뒤는 딤 처리되어 닫기 전에는 만질 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是模态，后面被压暗，关闭之前无法操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是模態，後面被壓暗，關閉之前無法操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это модальное окно: фон затемнён, и пока вы его не закроете, трогать его нельзя."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es modal: el fondo está atenuado y no se puede tocar hasta que lo cierres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist modal: Der Hintergrund ist abgedunkelt und lässt sich nicht berühren, bis du schließt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est modal : l'arrière-plan est assombri et ne peut pas être touché tant que vous ne fermez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È modale: lo sfondo è oscurato e non può essere toccato finché non chiudi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É modal: o fundo fica escurecido e não pode ser tocado até você fechar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันเป็นโมดัล: พื้นหลังถูกหรี่และแตะไม่ได้จนกว่าคุณจะปิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó là modal: nền bị làm tối và không chạm được cho đến khi bạn đóng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je modální: pozadí je ztmavené a nedá se ho dotknout, dokud sheet nezavřete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er modal: baggrunden er mørklagt og kan ikke røres, før du lukker den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι modal: το φόντο σκιάζεται και δεν μπορεί να αγγιχτεί μέχρι να το κλείσεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on modaali: tausta on himmennetty, eikä sitä voi koskettaa ennen kuin suljet sen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini modal: latar diredupkan dan tidak bisa disentuh sampai kamu menutupnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er modalt: bakgrunnen er dimmet og kan ikke røres før du lukker det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is modaal: de achtergrond is gedimd en kan niet worden aangeraakt tot je hem sluit."
          }
        }
      }
    },
