        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบย้ายจากแถว (ปัด) ↔ ไปเป็นปุ่มเดี่ยวในแถบล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa chuyển từ dòng (vuốt) ↔ sang một nút riêng ở thanh dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat přesunuto z řádku (přejetí) ↔ na samostatné tlačítko ve spodním panelu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet flyttet fra rækken (stryg) ↔ til en selvstændig knap i den nederste bjælke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Διαγραφή μετακινήθηκε από τη γραμμή (σύρσιμο) ↔ σε αυτόνομο κουμπί στην κάτω γραμμή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista siirretty riviltä (pyyhkäisy) ↔ erilliseksi painikkeeksi alapalkkiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus dipindahkan dari baris (usap) ↔ ke tombol mandiri di bilah bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett flyttet fra raden (sveip) ↔ til en frittstående knapp i bunnlinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder verplaatst van de rij (vegen) ↔ naar een losse knop in de onderbalk."
          }
        }
      }
    },
    "삭제는 잘 쓰지 않는 기능이라 접어둔 것이다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete is rarely used, so it was tucked away"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete is rarely used, so it was tucked away"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除はあまり使わない機能なので、しまっておいたのだ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제는 잘 쓰지 않는 기능이라 접어둔 것이다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为删除不常用，所以折叠起来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為刪除不常用，所以摺疊起來"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Удалить» используют редко, поэтому его убрали подальше"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar se usa poco, así que se guardó"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen wird selten genutzt, daher wurde es weggepackt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer est rarement utilisé, donc on l'a rangé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina si usa di rado, quindi è stato nascosto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir é pouco usado, então foi escondido"
