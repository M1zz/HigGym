          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Maior tamanho de acessibilidade"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดการช่วยการเข้าถึงที่ใหญ่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cỡ trợ năng lớn nhất"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Největší velikost přístupnosti"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Største tilgængelighedsstørrelse"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεγαλύτερο μέγεθος προσβασιμότητας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurin saavutettavuuskoko"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran aksesibilitas terbesar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Største tilgjengelighetsstørrelse"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grootste toegankelijkheidsgrootte"
          }
        }
      }
    },
    "접근성 최대 글씨에서 내용이 잘립니다. 기본 크기에서만 확인하고 넘어가면 이 상태가 그대로 출시됩니다, 검증 기준은 가장 나쁜 조건입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the largest accessibility text size, content gets cut off. If you only check at the default size and move on, it ships exactly like this. Test against the worst case."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "At the largest accessibility text size, content gets cut off. If you only check at the default size and move on, it ships exactly like this. Test against the worst case."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの最大の文字サイズで内容が切れます。標準サイズだけ確認して進むと、この状態のままリリースされます。検証の基準は最悪の条件です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근성 최대 글씨에서 내용이 잘립니다. 기본 크기에서만 확인하고 넘어가면 이 상태가 그대로 출시됩니다, 검증 기준은 가장 나쁜 조건입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在无障碍最大字号下内容被截断了。只在默认字号下检查就放行的话，这个状态会原样发布：验证的标准是最糟糕的条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在無障礙最大字號下內容被截斷了。只在預設字號下檢查就放行的話，這個狀態會原樣釋出：驗證的標準是最糟糕的條件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При максимальном размере текста универсального доступа содержимое обрезается. Если проверить только при стандартном размере и пройти дальше, оно выйдет в таком виде. Проверяйте по худшему случаю."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el mayor tamaño de texto de accesibilidad, el contenido se corta. Si solo compruebas con el tamaño por defecto y sigues adelante, sale exactamente así. Prueba con el peor caso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der größten Textgröße der Bedienungshilfen wird Inhalt abgeschnitten. Prüft man nur bei der Standardgröße und macht weiter, geht es genau so raus. Teste am schlimmsten Fall."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la plus grande taille de texte d'accessibilité, le contenu est coupé. Si vous ne vérifiez qu'à la taille par défaut et passez à autre chose, il sort exactement comme ça. Testez le pire cas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla massima dimensione di testo di accessibilità, il contenuto viene tagliato. Se controlli solo alla dimensione predefinita e vai avanti, viene rilasciato esattamente così. Prova sul caso peggiore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No maior tamanho de texto de acessibilidade, o conteúdo é cortado. Se você só confere no tamanho padrão e segue em frente, ele sai exatamente assim. Teste contra o pior caso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่ขนาดตัวอักษรสำหรับการช่วยการเข้าถึงที่ใหญ่สุด เนื้อหาจะถูกตัด ถ้าตรวจแค่ที่ขนาดเริ่มต้นแล้วผ่านไป มันก็จะส่งออกไปแบบนี้เลย ทดสอบกับกรณีที่แย่ที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở cỡ chữ trợ năng lớn nhất, nội dung bị cắt. Nếu bạn chỉ kiểm tra ở cỡ mặc định rồi đi tiếp, nó sẽ phát hành đúng như thế này. Hãy thử với trường hợp tệ nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při největší velikosti textu přístupnosti se obsah ořezává. Pokud zkontrolujete jen výchozí velikost a jdete dál, vyjde to přesně takto. Testujte nejhorší případ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved den største tekststørrelse til tilgængelighed bliver indhold skåret af. Hvis du kun tjekker ved standardstørrelsen og går videre, udkommer det præcis sådan. Test mod det værste tilfælde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο μεγαλύτερο μέγεθος κειμένου προσβασιμότητας, το περιεχόμενο κόβεται. Αν ελέγχεις μόνο στο προεπιλεγμένο μέγεθος και προχωράς, κυκλοφορεί ακριβώς έτσι. Δοκίμασε με τη χειρότερη περίπτωση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurimmalla saavutettavuuden tekstikoolla sisältö leikkautuu. Jos tarkistat vain oletuskoolla ja jatkat, se julkaistaan juuri tällaisena. Testaa pahinta tapausta vasten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada ukuran teks aksesibilitas terbesar, konten terpotong. Jika kamu hanya memeriksa pada ukuran bawaan lalu lanjut, ia dirilis persis seperti ini. Uji terhadap kasus terburuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved den største tekststørrelsen for tilgjengelighet blir innhold kuttet. Hvis du bare sjekker ved standardstørrelsen og går videre, leveres det akkurat slik. Test mot det verste tilfellet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij de grootste tekstgrootte voor toegankelijkheid wordt inhoud afgesneden. Als je alleen op de standaardgrootte controleert en doorgaat, verschijnt het precies zo. Test tegen het slechtste geval."
          }
        }
      }
    },
    "접근성 큰 글씨 설정을 켠 상태입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility large text is turned on"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility large text is turned on"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの大きな文字をオンにした状態です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근성 큰 글씨 설정을 켠 상태입니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启无障碍大字号设置"
          }
        },
        "zh-Hant": {
