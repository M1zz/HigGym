    "상단 바 안에 **타이틀과 카운트**가 함께 있습니다. 필터를 바꾸면 숫자가 실제로 바뀝니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The top bar holds **the title and a count** together. Change the filter and the number really changes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The top bar holds **the title and a count** together. Change the filter and the number really changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部のバーの中に**タイトルと件数**が一緒にあります。フィルタを変えると数字が実際に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단 바 안에 **타이틀과 카운트**가 함께 있습니다. 필터를 바꾸면 숫자가 실제로 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部栏里同时有**标题和数量**。切换筛选，数字真的会变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂部列裡同時有**標題和數量**。切換篩選，數字真的會變。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В верхней панели вместе показаны **заголовок и счётчик**. Измените фильтр, и число действительно меняется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra superior contiene **el título y un contador** juntos. Cambia el filtro y el número cambia de verdad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die obere Leiste enthält **Titel und Zähler** zusammen. Ändere den Filter, und die Zahl ändert sich wirklich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre du haut contient **le titre et un compteur** ensemble. Changez le filtre et le nombre change vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra in alto contiene **il titolo e un conteggio** insieme. Cambia il filtro e il numero cambia davvero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra superior guarda **o título e uma contagem** juntos. Mude o filtro e o número realmente muda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบด้านบนถือ**ชื่อเรื่องและจำนวน**ไว้ด้วยกัน เปลี่ยนตัวกรองแล้วตัวเลขเปลี่ยนจริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh trên chứa **tiêu đề và một con số** cùng nhau. Đổi bộ lọc và con số thật sự thay đổi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Horní panel drží **nadpis a počet** pohromadě. Změňte filtr a číslo se opravdu změní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den øverste bjælke rummer **titlen og et antal** sammen. Ændr filteret, og tallet ændrer sig virkelig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πάνω γραμμή κρατά **τον τίτλο και ένα πλήθος** μαζί. Άλλαξε το φίλτρο και ο αριθμός αλλάζει πραγματικά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yläpalkki pitää **otsikon ja lukumäärän** yhdessä. Vaihda suodatinta, niin numero todella muuttuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah atas memuat **judul dan jumlah** sekaligus. Ubah filter dan angkanya benar-benar berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den øvre linjen holder **tittelen og et antall** sammen. Endre filteret, og tallet endres faktisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bovenbalk bevat **de titel en een aantal** samen. Wijzig het filter en het getal verandert echt."
          }
        }
      }
    },
    "상단 서랍(스크롤하면 접힘) ↔ 하단 툴바 캡슐. 목록과 데이터는 같습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top drawer (collapses on scroll) ↔ bottom toolbar capsule. The list and data are the same."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Top drawer (collapses on scroll) ↔ bottom toolbar capsule. The list and data are the same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部の引き出し（スクロールすると折りたたまれる）↔ 下部のツールバーのカプセル。リストとデータは同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단 서랍(스크롤하면 접힘) ↔ 하단 툴바 캡슐. 목록과 데이터는 같습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部抽屉（滚动时折叠）↔ 底部工具栏胶囊。列表和数据相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂部抽屜（滾動時摺疊）↔ 底部工具列膠囊。列表和資料相同。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верхняя выдвижная панель (сворачивается при прокрутке) ↔ капсула нижней панели инструментов. Список и данные те же."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cajón superior (se colapsa al desplazar) ↔ cápsula de la barra de herramientas inferior. La lista y los datos son los mismos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obere Schublade (klappt beim Scrollen zusammen) ↔ Kapsel der unteren Symbolleiste. Liste und Daten sind dieselben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir du haut (se replie au défilement) ↔ capsule de la barre d'outils du bas. La liste et les données sont les mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassetto in alto (si comprime con lo scorrimento) ↔ capsula della barra degli strumenti in basso. L'elenco e i dati sono gli stessi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaveta superior (recolhe ao rolar) ↔ cápsula da barra de ferramentas inferior. A lista e os dados são os mesmos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิ้นชักด้านบน (ยุบเมื่อเลื่อน) ↔ แคปซูลแถบเครื่องมือด้านล่าง รายการและข้อมูลเหมือนกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn trên (thu gọn khi cuộn) ↔ capsule thanh công cụ dưới. Danh sách và dữ liệu như nhau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Horní zásuvka (sbalí se při posouvání) ↔ kapsle ve spodním panelu nástrojů. Seznam a data jsou stejné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øverste skuffe (klapper sammen ved scrolling) ↔ kapsel i den nederste værktøjslinje. Listen og dataene er de samme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάνω συρτάρι (συμπτύσσεται με την κύλιση) ↔ κάψουλα κάτω γραμμής εργαλείων. Η λίστα και τα δεδομένα είναι ίδια."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ylälaatikko (tiivistyy vieritettäessä) ↔ alatyökalupalkin kapseli. Luettelo ja data ovat samat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laci atas (menciut saat digulir) ↔ kapsul bilah alat bawah. Daftar dan datanya sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øvre skuff (kollapser ved rulling) ↔ kapsel i bunnverktøylinjen. Listen og dataene er de samme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bovenlade (klapt in bij scrollen) ↔ capsule in de onderste werkbalk. De lijst en de gegevens zijn dezelfde."
          }
        }
      }
    },
