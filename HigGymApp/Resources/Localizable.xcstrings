    "뒤로 지나갈 콘텐츠가 복잡할수록 두껍게": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The busier the content passing behind, the thicker"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The busier the content passing behind, the thicker"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背後を通るコンテンツが複雑なほど厚く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤로 지나갈 콘텐츠가 복잡할수록 두껍게"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背后经过的内容越复杂，就越要厚"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背後經過的內容越複雜，就越要厚"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем сложнее контент, проходящий позади, тем толще"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más cargado el contenido que pasa por detrás, más grueso"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je unruhiger der Inhalt, der dahinter vorbeizieht, desto dicker"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus le contenu qui passe derrière est chargé, plus c'est épais"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più è carico il contenuto che passa dietro, più è spesso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais carregado o conteúdo que passa atrás, mais grosso"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยิ่งเนื้อหาที่ผ่านด้านหลังวุ่นวาย ก็ยิ่งหนา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung đi qua phía sau càng rối thì càng dày"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čím rušnější obsah prochází vzadu, tím tlustší"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo mere urolig indholdet bagved er, desto tykkere"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο πιο φορτωμένο το περιεχόμενο που περνά πίσω, τόσο παχύτερο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä vilkkaampi sisältö kulkee takana, sitä paksumpi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakin ramai konten yang lewat di belakang, semakin tebal"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo travlere innhold som passerer bak, desto tykkere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe drukker de inhoud die erachter langskomt, hoe dikker"
          }
        }
      }
    },
    "뒤로가기 버튼이 있는 상세 화면의 왼쪽 상단에 보기 전환·정렬 버튼 묶음을 배치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a view-switch and sort button group at the top left of a detail screen that has a back button"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a view-switch and sort button group at the top left of a detail screen that has a back button"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻るボタンのある詳細画面の左上に、表示切り替えと並べ替えのボタン群を置く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤로가기 버튼이 있는 상세 화면의 왼쪽 상단에 보기 전환·정렬 버튼 묶음을 배치"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在有返回按钮的详情界面左上角，放一组视图切换和排序按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在有返回按鈕的詳情介面左上角，放一組檢視切換和排序按鈕"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставить блок кнопок смены вида и сортировки слева вверху на экране подробностей, где есть кнопка «Назад»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner un grupo de botones de cambio de vista y orden arriba a la izquierda en una pantalla de detalle que tiene botón de retroceso"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Button-Gruppe für Ansichtswechsel und Sortierung oben links auf einem Detailbildschirm platzieren, der einen Zurück-Button hat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre un groupe de boutons de changement d'affichage et de tri en haut à gauche d'un écran de détail qui a un bouton Retour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettere un gruppo di pulsanti per cambiare vista e ordinare in alto a sinistra in una schermata di dettaglio che ha un pulsante Indietro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar um grupo de botões de troca de visualização e ordenação no canto superior esquerdo de uma tela de detalhe que tem botão de voltar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางกลุ่มปุ่มสลับมุมมองและเรียงลำดับไว้ที่ซ้ายบนของหน้ารายละเอียดที่มีปุ่มย้อนกลับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt nhóm nút chuyển chế độ xem và sắp xếp ở trên cùng bên trái của màn hình chi tiết có nút quay lại"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dát skupinu tlačítek pro přepínání zobrazení a řazení vlevo nahoře na detailní obrazovku s tlačítkem Zpět"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg en knapgruppe til skift af visning og sortering øverst til venstre på en detaljeskærm, der har en tilbage-knap"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε μια ομάδα κουμπιών αλλαγής προβολής και ταξινόμησης πάνω αριστερά σε μια οθόνη λεπτομερειών που έχει κουμπί πίσω"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita näkymänvaihto- ja lajittelupainikeryhmä vasempaan yläkulmaan yksityiskohtanäkymässä, jossa on Takaisin-painike"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh grup tombol pengalih tampilan dan urutkan di kiri atas layar detail yang punya tombol kembali"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett en knappegruppe for visningsbytte og sortering øverst til venstre på en detaljskjerm som har en tilbakeknapp"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een groep knoppen voor weergave wisselen en sorteren linksboven op een detailscherm dat een terugknop heeft"
          }
        }
      }
    },
    "뒤로가기를 없애고 클러스터를 넣는다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
