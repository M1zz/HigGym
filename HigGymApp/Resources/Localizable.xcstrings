    ".toolbar {\n    // 단독 아이템은 기본이 가운데다. 메일 앱처럼 오른쪽 끝에 두려면 Spacer 로 민다.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"새 메일\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // A lone item is centered by default. To push it to the trailing edge like Mail, use a Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"New Message\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // A lone item is centred by default. To push it to the trailing edge like Mail, use a Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"New Message\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // 単独のアイテムはデフォルトで中央に置かれる。メールアプリのように右端に置くなら Spacer で押し出す。\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"新規メッセージ\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // 단독 아이템은 기본이 가운데다. 메일 앱처럼 오른쪽 끝에 두려면 Spacer 로 민다.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"새 메일\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // 单独的项目默认居中。要像“邮件”应用那样放在最右端，就用 Spacer 顶过去。\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"写邮件\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // 單獨的項目預設居中。要像「郵件」應用程式那樣放在最右端，就用 Spacer 頂過去。\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"寫郵件\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Одиночный элемент по умолчанию стоит по центру. Чтобы поставить его у правого края, как в «Почте», сдвиньте его Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Новое письмо\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Un elemento solo se centra por defecto. Para llevarlo al borde final como en Correo, usa un Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Nuevo mensaje\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Ein einzelnes Element wird standardmäßig zentriert. Um es wie in Mail ans hintere Ende zu schieben, nutze einen Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Neue Nachricht\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Un élément seul est centré par défaut. Pour le pousser vers le bord de fin comme dans Mail, utilisez un Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Nouveau message\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Un elemento singolo è centrato di default. Per spingerlo al bordo finale come in Mail, usa uno Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Nuovo messaggio\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Um item sozinho fica centralizado por padrão. Para empurrá-lo ao lado trailing como no Mail, use um Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Nova mensagem\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // รายการเดี่ยวจะอยู่กึ่งกลางโดยค่าเริ่มต้น หากต้องการดันไปขอบท้ายแบบ Mail ให้ใช้ Spacer\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"ข้อความใหม่\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Một mục đơn lẻ mặc định được căn giữa. Để đẩy nó sang mép cuối như Mail, dùng Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Thư mới\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Osamocená položka je ve výchozím stavu uprostřed. Chcete-li ji odsunout doprava jako v Poště, použijte Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Nová zpráva\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Et enkelt element er som standard centreret. For at skubbe det til trailing-kanten som i Mail, brug en Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Ny besked\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Ένα μοναχικό στοιχείο κεντράρεται από προεπιλογή. Για να το σπρώξεις στο τέλος όπως στο Mail, χρησιμοποίησε Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Νέο μήνυμα\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Yksittäinen kohde keskitetään oletuksena. Työnnä se perään kuten Mailissa Spacerilla.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Uusi viesti\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Item tunggal ditengahkan secara bawaan. Untuk mendorongnya ke tepi trailing seperti Mail, gunakan Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Pesan Baru\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Et enkelt element sentreres som standard. For å skyve det til trailing-kanten som i Mail, bruk en Spacer.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Ny melding\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": ".toolbar {\n    // Een los item wordt standaard gecentreerd. Gebruik een Spacer om het naar de trailing-rand te duwen zoals in Mail.\n    ToolbarItemGroup(placement: .bottomBar) {\n        Spacer()\n        Button(\"Nieuw bericht\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}\n.sheet(isPresented: $composing) { ComposeView() }"
          }
        }
      }
    },
    ".toolbar {\n    ToolbarItem(placement: .bottomBar) {\n        HStack(spacing: 12) {\n            Text(\"\\(count)장\").font(.footnote).monospacedDigit()\n            Slider(value: $zoom, in: 2...5, step: 1)\n                .frame(width: 140)\n            ProgressView(value: uploaded).frame(width: 44)\n        }\n    }\n}": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
