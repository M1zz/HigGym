          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidimos mover el botón Redactar abajo a la derecha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben beschlossen, den Verfassen-Button nach unten rechts zu verlegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
