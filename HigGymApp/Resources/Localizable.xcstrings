        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ giữ hành động màn hình này thật sự dùng (Xong) trên thanh công cụ và chuyển phần còn lại vào menu ngữ cảnh trên đối tượng."
          }
