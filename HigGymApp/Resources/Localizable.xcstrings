    "읽기 전용 텍스트라고 조작이 필요 없는 건 아닙니다. **옮겨 적을 일이 있는 값**에는 선택을 엽니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only text still may need interaction. Open selection for **values people need to copy**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only text still may need interaction. Open selection for **values people need to copy**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用のテキストだからといって、操作が要らないわけではありません。**書き写す必要のある値**には選択を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 텍스트라고 조작이 필요 없는 건 아닙니다. **옮겨 적을 일이 있는 값**에는 선택을 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读文本也不是不需要操作。对**需要抄写的值**要开放选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只讀文字也不是不需要操作。對**需要抄寫的值**要開放選擇。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст «только для чтения» тоже может требовать взаимодействия. Откройте выделение для **значений, которые люди переписывают**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto de solo lectura puede seguir necesitando interacción. Abre la selección para **los valores que la gente necesita copiar**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibgeschützter Text braucht womöglich dennoch Interaktion. Öffne die Auswahl für **Werte, die Menschen kopieren müssen**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un texte en lecture seule peut quand même nécessiter une interaction. Ouvrez la sélection pour **les valeurs que les gens doivent copier**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo di sola lettura può comunque richiedere interazione. Apri la selezione per i **valori che le persone devono copiare**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto somente leitura ainda pode precisar de interação. Abra a seleção para **valores que as pessoas precisam copiar**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความแบบอ่านอย่างเดียวก็อาจต้องการการโต้ตอบ เปิดการเลือกสำหรับ**ค่าที่คนต้องคัดลอก**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản chỉ đọc vẫn có thể cần tương tác. Mở tính năng chọn cho **những giá trị người ta cần sao chép**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text jen pro čtení může stále potřebovat interakci. Otevřete výběr pro **hodnoty, které lidé potřebují zkopírovat**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebeskyttet tekst kan stadig kræve interaktion. Åbn markering for **værdier, folk skal kopiere**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο μόνο για ανάγνωση μπορεί ακόμα να χρειάζεται αλληλεπίδραση. Άνοιξε την επιλογή για **τιμές που πρέπει να αντιγράψουν οι άνθρωποι**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain luettavaksi tarkoitettu teksti voi silti tarvita vuorovaikutusta. Avaa valinta **arvoille, joita ihmisten täytyy kopioida**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang hanya-baca tetap mungkin butuh interaksi. Buka pemilihan untuk **nilai yang perlu disalin orang**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebeskyttet tekst kan fortsatt trenge interaksjon. Åpne markering for **verdier folk trenger å kopiere**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen-lezen tekst kan toch interactie nodig hebben. Open selectie voor **waarden die mensen moeten kopiëren**."
          }
        }
      }
    },
