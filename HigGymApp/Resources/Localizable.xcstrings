            "value": "Remover o botão de voltar e colocar o grupo ali"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอาปุ่มย้อนกลับออกแล้วนำกลุ่มนั้นไปวางตรงนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ nút quay lại và đặt cụm đó ở đó"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat tlačítko Zpět a dát tam cluster"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern tilbage-knappen og læg klyngen der"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεσε το κουμπί πίσω και βάλε εκεί την ομάδα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista Takaisin-painike ja laita ryhmä sen paikalle"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus tombol kembali dan taruh klaster di sana"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern tilbakeknappen og sett klyngen der"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal de terugknop weg en zet het cluster daar"
          }
        }
      }
    },
    "뒤로가기와 자리를 다투므로 피한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid it, since it competes with the back button for the spot"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid it, since it competes with the back button for the spot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻るボタンと場所を奪い合うので避ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤로가기와 자리를 다투므로 피한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会和返回按钮抢位置，所以要避免"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會和返回按鈕搶位置，所以要避免"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегать, поскольку он борется с кнопкой «Назад» за место"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evítalo, porque compite con el botón de retroceso por el sitio"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeide es, da es mit dem Zurück-Button um den Platz konkurriert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À éviter, car il entre en concurrence avec le bouton Retour pour l'emplacement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitalo, perché compete con il pulsante Indietro per il posto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite, pois compete com o botão de voltar pelo lugar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลีกเลี่ยง เพราะมันแย่งตำแหน่งกับปุ่มย้อนกลับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tránh nó, vì nó tranh vị trí với nút quay lại"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhnout se tomu, protože to soupeří s tlačítkem Zpět o místo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undgå det, da det konkurrerer med tilbage-knappen om pladsen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απόφυγέ το, γιατί ανταγωνίζεται το κουμπί πίσω για τη θέση"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vältä sitä, koska se kilpailee Takaisin-painikkeen kanssa paikasta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindari, karena ia bersaing dengan tombol kembali untuk tempat itu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå det, siden det konkurrerer med tilbakeknappen om plassen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd het, omdat het met de terugknop om de plek concurreert"
          }
        }
      }
    },
    "뒤를 비춰 “콘텐츠 위에 떠 있다”는 깊이 관계를 표현합니다. 뒤가 복잡할수록 두껍게.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It reflects what's behind to express depth: “floating above the content.” The busier the background, the thicker."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It reflects what's behind to express depth: “floating above the content.” The busier the background, the thicker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背後を映して「コンテンツの上に浮いている」という奥行きの関係を表します。背後が複雑なほど厚く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤를 비춰 “콘텐츠 위에 떠 있다”는 깊이 관계를 표현합니다. 뒤가 복잡할수록 두껍게."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透出背后，表达“浮在内容之上”的纵深关系。背后越复杂，就越要厚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透出背後，表達「浮在內容之上」的縱深關係。背後越複雜，就越要厚。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропускает фон, чтобы выразить глубину: «парит над контентом». Чем сложнее фон, тем толще."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Refleja lo que hay detrás para expresar profundidad: «flotando sobre el contenido». Cuanto más cargado el fondo, más grueso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es spiegelt wider, was dahinter liegt, um Tiefe auszudrücken: „über dem Inhalt schwebend“. Je unruhiger der Hintergrund, desto dicker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reflète ce qui est derrière pour exprimer la profondeur : « flotter au-dessus du contenu ». Plus l'arrière-plan est chargé, plus il est épais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riflette ciò che sta dietro per esprimere profondità: «fluttuare sopra il contenuto». Più lo sfondo è carico, più è spesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflete o que está atrás para expressar profundidade: «flutuando sobre o conteúdo». Quanto mais carregado o fundo, mais grosso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันสะท้อนสิ่งที่อยู่ด้านหลังเพื่อสื่อความลึก: “ลอยอยู่เหนือเนื้อหา” ยิ่งพื้นหลังวุ่นวาย ก็ยิ่งหนา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó phản chiếu thứ phía sau để thể hiện chiều sâu: “nổi phía trên nội dung.” Nền càng rối thì càng dày."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odráží, co je vzadu, aby vyjádřil hloubku: „vznáší se nad obsahem“. Čím rušnější pozadí, tím tlustší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den afspejler det, der er bagved, for at udtrykke dybde: »svævende over indholdet.« Jo mere urolig baggrunden er, desto tykkere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αντανακλά ό,τι βρίσκεται πίσω για να εκφράσει βάθος: «επιπλέει πάνω από το περιεχόμενο». Όσο πιο φορτωμένο το φόντο, τόσο παχύτερο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se heijastaa takana olevaa ilmaistakseen syvyyttä: ”sisällön yläpuolella kelluva”. Mitä vilkkaampi tausta, sitä paksumpi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia memantulkan yang ada di belakang untuk mengekspresikan kedalaman: \"mengambang di atas konten\". Semakin ramai latarnya, semakin tebal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det reflekterer det som er bak for å uttrykke dybde: «flyter over innholdet». Jo travlere bakgrunnen er, desto tykkere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het weerspiegelt wat erachter zit om diepte uit te drukken: \"zwevend boven de inhoud\". Hoe drukker de achtergrond, hoe dikker."
          }
        }
      }
    },
    "뒤에서 값이 바뀌면 시트가 거짓말을 한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If values change behind it, the sheet lies"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If values change behind it, the sheet lies"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背後で値が変わると、シートが嘘をつく"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤에서 값이 바뀌면 시트가 거짓말을 한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后面的值一变，弹层就在撒谎"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後面的值一變，工作表就在撒謊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если позади меняются значения, шторка лжёт"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los valores cambian por detrás, la hoja miente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern sich dahinter Werte, lügt das Sheet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les valeurs changent derrière, la feuille ment"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se i valori cambiano dietro, il foglio mente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os valores mudam atrás, a folha mente"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าค่าเปลี่ยนไปด้านหลัง ชีตก็โกหก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu giá trị thay đổi phía sau, sheet đang nói dối"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se hodnoty vzadu změní, sheet lže"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis værdier ændrer sig bagved, lyver arket"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν οι τιμές αλλάζουν πίσω, το φύλλο λέει ψέματα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos arvot muuttuvat sen takana, arkki valehtelee"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika nilai berubah di belakangnya, lembar berdusta"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis verdier endres bak, lyver arket"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als waarden erachter veranderen, liegt de sheet"
          }
        }
      }
    },
    "뒤집으면": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you flip it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you flip it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "逆にすると"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒤집으면"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻转后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻轉後"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если перевернуть"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo inviertes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du es umkehrst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous l'inversez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lo inverti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você inverter"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าคุณพลิกมัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn lật nó"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když to převrátíte"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vender det om"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν το αναστρέψεις"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos käännät sen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu membaliknya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du snur det"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je het omdraait"
          }
        }
      }
    },
    "드물게 쓰는 액션은 지금의 과업에 기여할 확률이 낮으므로 접어둡니다, 기능의 완전성은 유지하면서 **화면 점유는 기여도에 비례**시키는 것입니다.\n\n툴바 overflow가 자동으로 만드는 것도 결국 이 메뉴입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rarely used actions are unlikely to help with the task at hand, so they get tucked away: you keep every feature, but **screen space is proportional to contribution**.\n\nThe toolbar's automatic overflow produces exactly this menu."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Rarely used actions are unlikely to help with the task at hand, so they get tucked away: you keep every feature, but **screen space is proportional to contribution**.\n\nThe toolbar's automatic overflow produces exactly this menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "めったに使わないアクションは、いまの作業に役立つ可能性が低いのでしまっておきます。機能の完全さは保ちつつ、**画面の占有を貢献度に比例**させるということです。\n\nツールバーの overflow が自動で作るのも、結局このメニューです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드물게 쓰는 액션은 지금의 과업에 기여할 확률이 낮으므로 접어둡니다, 기능의 완전성은 유지하면서 **화면 점유는 기여도에 비례**시키는 것입니다.\n\n툴바 overflow가 자동으로 만드는 것도 결국 이 메뉴입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很少用的操作对当前任务贡献的概率低，所以折叠起来。这样既保持功能完整，又让**界面占用与贡献度成正比**。\n\n工具栏的 overflow 自动生成的，说到底也是这个菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "很少用的操作對當前任務貢獻的機率低，所以摺疊起來。這樣既保持功能完整，又讓**介面佔用與貢獻度成正比**。\n\n工具列的 overflow 自動生成的，說到底也是這個選單。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редко используемые действия вряд ли помогут в текущей задаче, поэтому их прячут: вы сохраняете все функции, а **место на экране пропорционально вкладу**.\n\nИменно такое меню автоматически создаёт переполнение панели инструментов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones poco usadas es poco probable que ayuden con la tarea en curso, así que se guardan: conservas todas las funciones, pero **el espacio de pantalla es proporcional a la aportación**.\n\nEl desbordamiento automático de la barra de herramientas produce exactamente este menú."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selten genutzte Aktionen helfen bei der aktuellen Aufgabe wahrscheinlich nicht, daher werden sie weggepackt: Du behältst jede Funktion, aber **der Bildschirmplatz ist proportional zum Beitrag**.\n\nDer automatische Überlauf der Symbolleiste erzeugt genau dieses Menü."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions rarement utilisées sont peu susceptibles d'aider à la tâche en cours, donc on les range : vous gardez toutes les fonctions, mais **l'espace d'écran est proportionnel à la contribution**.\n\nLe débordement automatique de la barre d'outils produit exactement ce menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni usate raramente difficilmente aiutano il compito in corso, quindi vengono riposte: mantieni ogni funzione, ma **lo spazio sullo schermo è proporzionale al contributo**.\n\nL'overflow automatico della barra degli strumenti produce esattamente questo menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações pouco usadas dificilmente ajudam na tarefa em questão, então são guardadas: você mantém todas as funcionalidades, mas **o espaço da tela é proporcional à contribuição**.\n\nO overflow automático da barra de ferramentas produz exatamente este menu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำที่ใช้น้อยไม่น่าจะช่วยงานตรงหน้า จึงถูกซ่อนไว้: คุณยังมีทุกฟีเจอร์ แต่**พื้นที่หน้าจอเป็นสัดส่วนกับคุณูปการ**\n\nการล้นอัตโนมัติของแถบเครื่องมือสร้างเมนูนี้ขึ้นมาพอดี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hành động hiếm dùng khó giúp ích cho tác vụ hiện tại, nên được cất đi: bạn vẫn giữ mọi tính năng, nhưng **không gian màn hình tỉ lệ với đóng góp**.\n\nMục tràn tự động của thanh công cụ tạo ra đúng menu này."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zřídka používané akce se pravděpodobně nehodí k aktuálnímu úkolu, proto se schovají: zachováte všechny funkce, ale **místo na obrazovce odpovídá příspěvku**.\n\nAutomatické přetečení panelu nástrojů vytváří přesně tuto nabídku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjældent brugte handlinger hjælper næppe med den aktuelle opgave, så de gemmes væk: du beholder alle funktioner, men **skærmpladsen er proportional med bidraget**.\n\nVærktøjslinjens automatiske overløb producerer netop denne menu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σπάνια χρησιμοποιούμενες ενέργειες είναι απίθανο να βοηθούν στην τρέχουσα εργασία, οπότε αποκρύπτονται: κρατάς κάθε λειτουργία, αλλά **ο χώρος της οθόνης είναι ανάλογος της συμβολής**.\n\nΗ αυτόματη υπερχείλιση της γραμμής εργαλείων παράγει ακριβώς αυτό το μενού."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harvoin käytetyt toiminnot eivät todennäköisesti auta käsillä olevaa tehtävää, joten ne piilotetaan: säilytät jokaisen ominaisuuden, mutta **näyttötila on verrannollinen vaikutukseen**.\n\nTyökalupalkin automaattinen ylivuoto tuottaa täsmälleen tämän valikon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksi yang jarang dipakai kecil kemungkinannya membantu tugas yang sedang dikerjakan, jadi disimpan: kamu mempertahankan semua fitur, tetapi **ruang layar sebanding dengan kontribusi**.\n\nOverflow otomatis bilah alat menghasilkan persis menu ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjelden brukte handlinger hjelper neppe med oppgaven for hånden, så de gjemmes unna: du beholder alle funksjoner, men **skjermplassen står i forhold til bidraget**.\n\nVerktøylinjens automatiske overflyt gir nøyaktig denne menyen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelden gebruikte acties helpen waarschijnlijk niet bij de taak die voorligt, dus ze worden weggestopt: je behoudt elke functie, maar **de schermruimte is evenredig met de bijdrage**.\n\nDe automatische overflow van de werkbalk levert precies dit menu op."
          }
        }
      }
    },
    "드물게 쓰는 액션을 접어두는 곳. 파괴적 액션은 Divider로 분리해 빨간색이 규약입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where rarely used actions are tucked away. By convention, destructive actions are separated by a Divider and shown in red."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Where rarely used actions are tucked away. By convention, destructive actions are separated by a Divider and shown in red."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "めったに使わないアクションをしまっておく場所。破壊的なアクションは Divider で分けて赤にするのが決まりです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드물게 쓰는 액션을 접어두는 곳. 파괴적 액션은 Divider로 분리해 빨간색이 규약입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠很少使用的操作的地方。惯例是用 Divider 隔开破坏性操作，并设为红色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊很少使用的操作的地方。慣例是用 Divider 隔開破壞性操作，並設為紅色。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Место, где прячут редко используемые действия. По соглашению разрушительные действия отделяют Divider и показывают красным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Donde se guardan las acciones poco usadas. Por convención, las acciones destructivas se separan con un Divider y se muestran en rojo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo selten genutzte Aktionen weggepackt werden. Per Konvention werden destruktive Aktionen durch einen Divider abgetrennt und rot dargestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'endroit où l'on range les actions rarement utilisées. Par convention, les actions destructives sont séparées par un Divider et affichées en rouge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove vengono riposte le azioni usate raramente. Per convenzione, le azioni distruttive sono separate da un Divider e mostrate in rosso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde as ações pouco usadas ficam guardadas. Por convenção, as ações destrutivas são separadas por um Divider e mostradas em vermelho."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่ซ่อนการกระทำที่ใช้น้อย ตามธรรมเนียม การกระทำที่ทำลายข้อมูลจะถูกแยกด้วย Divider และแสดงเป็นสีแดง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nơi cất các hành động hiếm dùng. Theo quy ước, hành động phá hủy được tách bằng Divider và hiển thị màu đỏ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kam se schovávají zřídka používané akce. Podle konvence jsou destruktivní akce oddělené pomocí Divider a zobrazené červeně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor sjældent brugte handlinger gemmes væk. Efter konvention adskilles destruktive handlinger af en Divider og vises i rødt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκεί όπου αποκρύπτονται οι σπάνια χρησιμοποιούμενες ενέργειες. Κατά σύμβαση, οι καταστροφικές ενέργειες χωρίζονται με Divider και εμφανίζονται με κόκκινο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikka, johon harvoin käytetyt toiminnot piilotetaan. Käytännön mukaan tuhoavat toiminnot erotetaan Dividerilla ja näytetään punaisina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat aksi yang jarang dipakai disimpan. Menurut konvensi, aksi destruktif dipisahkan dengan Divider dan ditampilkan merah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Der sjelden brukte handlinger gjemmes unna. Etter konvensjon skilles destruktive handlinger av med en Divider og vises i rødt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar zelden gebruikte acties worden weggestopt. Per conventie worden destructieve acties gescheiden door een Divider en in rood getoond."
          }
        }
      }
    },
    "들어가는 것과 **쓸 수 있는 것**은 다르다. 폭이 좁아질수록 라벨이 잘리고 터치 타깃이 좁아진다. 그리고 여섯이 필요하다는 건 정보 구조가 여섯 갈래로 흩어져 있다는 신호다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitting is not the same as **being usable**. The narrower the items, the more labels get truncated and the smaller the touch targets. And needing six is a sign that the information architecture is scattered six ways."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitting is not the same as **being usable**. The narrower the items, the more labels get truncated and the smaller the touch targets. And needing six is a sign that the information architecture is scattered six ways."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入ることと**使えること**は違う。幅が狭くなるほどラベルは切り詰められ、タッチターゲットも狭くなる。そして6つ必要だというのは、情報構造が6方向に散らばっているというサインだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어가는 것과 **쓸 수 있는 것**은 다르다. 폭이 좁아질수록 라벨이 잘리고 터치 타깃이 좁아진다. 그리고 여섯이 필요하다는 건 정보 구조가 여섯 갈래로 흩어져 있다는 신호다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放得下和**用得上**是两回事。宽度越窄，标签越容易被截断，触控目标也越窄。而需要六个，说明信息结构已经散成了六个方向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放得下和**用得上**是兩回事。寬度越窄，標籤越容易被截斷，觸控目標也越窄。而需要六個，說明資訊結構已經散成了六個方向。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместиться - не значит **быть пригодным к использованию**. Чем уже элементы, тем сильнее обрезаются подписи и тем меньше области касания. А потребность в шести - признак того, что информационная архитектура разошлась на шесть направлений."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caber no es lo mismo que **ser utilizable**. Cuanto más estrechos los elementos, más etiquetas se truncan y más pequeños son los objetivos táctiles. Y necesitar seis es señal de que la arquitectura de la información está dispersa en seis direcciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hineinpassen ist nicht dasselbe wie **brauchbar zu sein**. Je schmaler die Elemente, desto mehr Beschriftungen werden abgeschnitten und desto kleiner die Touch-Ziele. Und sechs zu brauchen ist ein Zeichen, dass die Informationsarchitektur sechsfach zersplittert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenir n'est pas la même chose qu'**être utilisable**. Plus les éléments sont étroits, plus les libellés sont tronqués et plus les cibles tactiles sont petites. Et avoir besoin de six est le signe que l'architecture de l'information est éparpillée en six."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Starci dentro non equivale a **essere utilizzabile**. Più gli elementi sono stretti, più le etichette vengono troncate e più i bersagli tattili si rimpiccioliscono. E avere bisogno di sei è il segno che l'architettura dell'informazione è dispersa in sei direzioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caber não é o mesmo que **ser utilizável**. Quanto mais estreitos os itens, mais rótulos são truncados e menores ficam os alvos de toque. E precisar de seis é sinal de que a arquitetura da informação está espalhada em seis direções."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใส่ได้ไม่เหมือนกับ**การใช้งานได้** ยิ่งรายการแคบ ป้ายชื่อก็ยิ่งถูกตัดและเป้าสัมผัสก็ยิ่งเล็ก และการที่ต้องมีหกอันเป็นสัญญาณว่าสถาปัตยกรรมข้อมูลกระจัดกระจายหกทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vừa khít không giống **dùng được**. Các mục càng hẹp thì nhãn càng bị cắt và vùng chạm càng nhỏ. Và việc cần sáu mục là dấu hiệu kiến trúc thông tin bị rải theo sáu hướng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vejít se není totéž co **být použitelný**. Čím užší položky, tím víc popisků se ořízne a tím menší jsou dotykové plochy. A potřeba šesti je znamení, že informační architektura je rozptýlená šesti směry."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At passe er ikke det samme som **at være brugbar**. Jo smallere elementerne er, desto flere etiketter bliver afkortet, og desto mindre bliver berøringsmålene. Og behovet for seks er et tegn på, at informationsarkitekturen er spredt i seks retninger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το να χωρά δεν είναι το ίδιο με το να **είναι χρησιμοποιήσιμο**. Όσο στενότερα τα στοιχεία, τόσο περισσότερες ετικέτες περικόπτονται και τόσο μικρότεροι οι στόχοι αφής. Και η ανάγκη για έξι είναι σημάδι ότι η αρχιτεκτονική πληροφορίας είναι σκορπισμένη σε έξι κατευθύνσεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahtuminen ei ole sama asia kuin **käyttökelpoisuus**. Mitä kapeammat kohteet, sitä enemmän nimikkeitä katkeaa ja sitä pienemmiksi kosketuskohteet käyvät. Ja kuuden tarve on merkki siitä, että tietoarkkitehtuuri on hajonnut kuuteen suuntaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat tidak sama dengan **dapat dipakai**. Semakin sempit item, semakin banyak label terpotong dan semakin kecil target sentuh. Dan membutuhkan enam adalah tanda bahwa arsitektur informasi tersebar ke enam arah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å passe er ikke det samme som **å være brukbar**. Jo smalere elementene er, desto flere etiketter kuttes og desto mindre blir berøringsmålene. Og å trenge seks er et tegn på at informasjonsarkitekturen er spredt seks veier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen is niet hetzelfde als **bruikbaar zijn**. Hoe smaller de items, hoe meer labels worden afgekapt en hoe kleiner de aanraakdoelen. En zes nodig hebben is een teken dat de informatiearchitectuur zes kanten op is verspreid."
          }
        }
      }
    },
