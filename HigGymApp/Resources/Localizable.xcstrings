            "value": "// Antes: una pestaña que no lleva a ningún sitio\nTab(\"Redactar\", systemImage: \"square.and.pencil\", value: 2) { EmptyView() }\n.onChange(of: selection) { if $1 == 2 { composing = true; selection = old } }\n\n// Después: las acciones van en la barra de herramientas\n.toolbar {\n    ToolbarItem(placement: .bottomBar) {\n        Button(\"Redactar\", systemImage: \"square.and.pencil\") { composing = true }\n    }\n}"
