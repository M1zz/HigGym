          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".safeAreaBar(edge: .top) {\n    VStack(alignment: .leading, spacing: 6) {\n        Text(\"ライブラリ\").font(.title3.bold())\n        FilterChips(selection: $filter)\n    }\n}"
          }
        },
        "ko": {
