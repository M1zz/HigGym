    "하단 바가 비어 보이면 미완성처럼 보이기 때문에": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because an empty-looking bottom bar looks unfinished"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because an empty-looking bottom bar looks unfinished"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーが空いていると未完成に見えるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바가 비어 보이면 미완성처럼 보이기 때문에"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为底部栏空着看起来像没做完"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為底部列空著看起來像沒做完"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что пустая нижняя панель выглядит недоделанной"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque una barra inferior que parece vacía parece inacabada"
          }
        }
      }
    },
    "하단 바는 조작을 위한 콕핏이다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bottom bar is a cockpit for controls"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The bottom bar is a cockpit for controls"
          }
        },
        "ja": {
          "stringUnit": {
