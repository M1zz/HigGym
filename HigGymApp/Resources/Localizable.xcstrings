    "화면 안 배경 전환기로 **흰 배경**을 골라보세요. 부드러운 페이드가 어디까지 버티는지 드러납니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick **White background** in the on-screen background switcher. You'll see how far the soft fade holds up."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick **White background** in the on-screen background switcher. You'll see how far the soft fade holds up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面内の背景切り替えで**白い背景**を選んでみてください。ソフトなフェードがどこまで持ちこたえるかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 안 배경 전환기로 **흰 배경**을 골라보세요. 부드러운 페이드가 어디까지 버티는지 드러납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用界面内的背景切换器选择**白色背景**，看看柔和的淡出能撑到哪一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用介面內的背景切換器選擇**白色背景**，看看柔和的淡出能撐到哪一步。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите **белый фон** в переключателе фона на экране. Вы увидите, насколько долго выдерживает мягкое затухание."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige **Fondo blanco** en el selector de fondo de la pantalla. Verás hasta dónde aguanta el desvanecimiento soft."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle im Hintergrundumschalter auf dem Bildschirm **Weißer Hintergrund**. Du siehst, wie weit das weiche Ausblenden standhält."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez **Fond blanc** dans le sélecteur d'arrière-plan à l'écran. Vous verrez jusqu'où tient le fondu soft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli **Sfondo bianco** nel selettore di sfondo sullo schermo. Vedrai fin dove regge la dissolvenza morbida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha **Fundo branco** no seletor de fundo da tela. Você verá até onde a dissolvência suave aguenta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก**พื้นหลังสีขาว**ในตัวสลับพื้นหลังบนหน้าจอ คุณจะเห็นว่าการจางแบบนุ่มรับได้แค่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn **Nền trắng** trong bộ chuyển nền trên màn hình. Bạn sẽ thấy hiệu ứng mờ soft trụ được đến đâu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V přepínači pozadí na obrazovce vyberte **Bílé pozadí**. Uvidíte, jak daleko měkké mizení vydrží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg **Hvid baggrund** i baggrundsskifteren på skærmen. Du vil se, hvor langt den bløde udtoning holder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε **Λευκό φόντο** στον εναλλάκτη φόντου της οθόνης. Θα δεις μέχρι πού αντέχει το απαλό σβήσιμο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse näytön taustanvaihtajasta **Valkoinen tausta**. Näet, kuinka pitkälle soft-häivytys kestää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih **Latar putih** di pengalih latar pada layar. Kamu akan melihat sejauh mana pemudaran soft bertahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg **Hvit bakgrunn** i bakgrunnsbytteren på skjermen. Du ser hvor langt den myke tonen holder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies **Witte achtergrond** in de achtergrondwisselaar op het scherm. Je ziet hoe ver de zachte vervaging standhoudt."
          }
        }
      }
    },
    "화면 안 스위치로 제목을 긴 것으로 바꿔보세요, 어디까지 버티는지 드러납니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the on-screen switch to make the title long, and see how far it holds up."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the on-screen switch to make the title long, and see how far it holds up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面内のスイッチでタイトルを長いものに変えてみてください。どこまで持ちこたえるかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 안 스위치로 제목을 긴 것으로 바꿔보세요, 어디까지 버티는지 드러납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用界面内的开关把标题换成长的，看看能撑到哪一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用介面內的開關把標題換成長的，看看能撐到哪一步。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключателем на экране сделайте заголовок длинным и посмотрите, как долго он выдерживает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el interruptor de la pantalla para alargar el título y ve hasta dónde aguanta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze den Schalter auf dem Bildschirm, um den Titel lang zu machen, und sieh, wie weit er standhält."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l'interrupteur à l'écran pour allonger le titre, et voyez jusqu'où cela tient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l'interruttore sullo schermo per allungare il titolo e vedi fin dove regge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o interruptor da tela para alongar o título e veja até onde aguenta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สวิตช์บนหน้าจอเพื่อทำให้ชื่อเรื่องยาว และดูว่ารับได้แค่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng công tắc trên màn hình để làm tiêu đề dài, và xem nó trụ được đến đâu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí přepínače na obrazovce udělejte nadpis dlouhý a podívejte se, jak daleko to vydrží."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug kontakten på skærmen til at gøre titlen lang, og se, hvor langt den holder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε τον διακόπτη της οθόνης για να μακρύνεις τον τίτλο και δες μέχρι πού αντέχει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä näytön kytkintä tehdäksesi otsikosta pitkän, ja katso, kuinka pitkälle se kestää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan sakelar di layar untuk membuat judul panjang, dan lihat sejauh mana ia bertahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk bryteren på skjermen til å gjøre tittelen lang, og se hvor langt den holder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de schakelaar op het scherm om de titel lang te maken en zie hoe ver het standhoudt."
          }
        }
      }
    },
    "화면 안 스테퍼로 아이템을 **하나씩 늘려보세요**. 어느 순간 시스템이 나머지를 **…** 안으로 접습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the on-screen stepper to **add items one at a time**. At some point, the system folds the rest into **…**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the on-screen stepper to **add items one at a time**. At some point, the system folds the rest into **…**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面内のステッパーでアイテムを**1つずつ増やして**みてください。あるところでシステムが残りを「…」の中に折りたたみます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 안 스테퍼로 아이템을 **하나씩 늘려보세요**. 어느 순간 시스템이 나머지를 **…** 안으로 접습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用界面内的步进器**一个一个增加**项目。到某个时刻，系统会把剩下的折叠进 **…**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用介面內的步進器**一個一個增加**項目。到某個時刻，系統會把剩下的摺疊進 **…**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Степпером на экране **добавляйте элементы по одному**. В какой-то момент система сворачивает остальные в **…**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el selector numérico de la pantalla para **añadir elementos de uno en uno**. En algún momento, el sistema pliega el resto en **…**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze den Stepper auf dem Bildschirm, um **Elemente nacheinander hinzuzufügen**. Irgendwann faltet das System den Rest zu **…**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le stepper à l'écran pour **ajouter les éléments un par un**. À un moment, le système replie le reste dans **…**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa lo stepper sullo schermo per **aggiungere un elemento alla volta**. A un certo punto il sistema ripiega il resto in **…**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o seletor numérico da tela para **adicionar itens um de cada vez**. Em algum ponto, o sistema dobra o resto em **…**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สเต็ปเปอร์บนหน้าจอเพื่อ**เพิ่มรายการทีละอัน** ที่จุดหนึ่ง ระบบพับที่เหลือเข้า **…**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng bước tăng trên màn hình để **thêm từng mục một**. Đến một lúc nào đó, hệ thống gập phần còn lại vào **…**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí stepperu na obrazovce **přidávejte položky po jedné**. V jednu chvíli systém zbytek sbalí do **…**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug trinknappen på skærmen til at **tilføje elementer ét ad gangen**. På et tidspunkt folder systemet resten ind i **…**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε το stepper της οθόνης για να **προσθέτεις στοιχεία ένα-ένα**. Κάποια στιγμή, το σύστημα διπλώνει τα υπόλοιπα στο **…**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä näytön askelmittaria **lisätäksesi kohteita yksi kerrallaan**. Jossain vaiheessa järjestelmä taittaa loput **…**-merkin taakse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan stepper di layar untuk **menambah item satu per satu**. Di suatu titik, sistem melipat sisanya ke **…**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk steppern på skjermen til å **legge til elementer ett om gangen**. På et tidspunkt folder systemet resten inn i **…**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de stepper op het scherm om **items één voor één toe te voegen**. Op een gegeven moment klapt het systeem de rest in **…**."
          }
        }
      }
    },
