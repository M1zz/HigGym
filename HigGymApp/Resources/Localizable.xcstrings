    "사진 격자를 **천천히 스크롤**하면서 상단의 선택·공유 버튼을 계속 읽어보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll slowly** through the photo grid while you keep reading the Select and Share buttons at the top."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll slowly** through the photo grid while you keep reading the Select and Share buttons at the top."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のグリッドを**ゆっくりスクロール**しながら、上部の選択・共有ボタンを読み続けてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 격자를 **천천히 스크롤**하면서 상단의 선택·공유 버튼을 계속 읽어보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**慢慢滚动**照片网格，同时一直读顶部的选择、分享按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**慢慢滾動**照片網格，同時一直讀頂部的選擇、分享按鈕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Медленно прокручивайте** сетку фотографий, не переставая читать кнопки «Выбрать» и «Поделиться» вверху."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desplázate despacio** por la cuadrícula de fotos mientras sigues leyendo los botones Seleccionar y Compartir de arriba."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scrolle langsam** durch das Fotoraster, während du weiter die Buttons „Auswählen“ und „Teilen“ oben liest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Faites défiler lentement** la grille de photos tout en continuant à lire les boutons Sélectionner et Partager en haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scorri lentamente** la griglia di foto continuando a leggere i pulsanti Seleziona e Condividi in alto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Role devagar** pela grade de fotos enquanto continua lendo os botões Selecionar e Compartilhar no topo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**เลื่อนช้า ๆ** ผ่านกริดรูปภาพ ขณะที่คุณอ่านปุ่มเลือกและแชร์ที่ด้านบนต่อไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Cuộn chậm** qua lưới ảnh trong khi bạn tiếp tục đọc các nút Chọn và Chia sẻ ở trên cùng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pomalu posouvejte** mřížku fotek a přitom stále čtěte tlačítka Vybrat a Sdílet nahoře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll langsomt** gennem fotogitteret, mens du bliver ved med at læse knapperne Vælg og Del øverst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Κύλισε αργά** το πλέγμα φωτογραφιών ενώ συνεχίζεις να διαβάζεις τα κουμπιά Επιλογή και Κοινοποίηση στην κορυφή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vieritä hitaasti** kuvaruudukkoa samalla, kun luet edelleen ylhäällä olevia Valitse- ja Jaa-painikkeita."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gulir perlahan** kisi foto sambil terus membaca tombol Pilih dan Bagikan di atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rull sakte** gjennom bilderutenettet mens du fortsetter å lese Velg- og Del-knappene øverst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll langzaam** door het fotoraster terwijl je de knoppen Selecteer en Deel bovenaan blijft lezen."
          }
        }
      }
    },
