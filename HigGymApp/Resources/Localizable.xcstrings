    "시트는 쓸어내려 닫히지만 전체 화면 커버는 아닙니다. 그 차이가 이 항목의 요지입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet closes when you swipe down, but a full-screen cover doesn't. That difference is the point of this topic."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A sheet closes when you swipe down, but a full-screen cover doesn't. That difference is the point of this topic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートは下にスワイプすると閉じますが、フルスクリーンカバーは閉じません。その違いがこのトピックの要点です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트는 쓸어내려 닫히지만 전체 화면 커버는 아닙니다. 그 차이가 이 항목의 요지입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层可以向下轻扫关闭，但全屏覆盖不行。这个差别就是这一项的要点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表可以向下輕掃關閉，但全螢幕覆蓋不行。這個差別就是這一項的要點。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шторка закрывается смахиванием вниз, а полноэкранное покрытие - нет. Эта разница и составляет суть темы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una hoja se cierra al deslizar hacia abajo, pero una cubierta a pantalla completa no. Esa diferencia es el sentido de este tema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sheet schließt sich beim Wischen nach unten, eine Vollbild-Abdeckung nicht. Dieser Unterschied ist der Kern dieses Themas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une feuille se ferme quand on balaie vers le bas, mais une couverture plein écran non. Cette différence est le sujet de cette rubrique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un foglio si chiude quando scorri verso il basso, ma una copertura a schermo intero no. Quella differenza è il punto di questo argomento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma folha fecha quando você desliza para baixo, mas uma cobertura em tela cheia não. Essa diferença é o ponto deste tópico."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชีตปิดเมื่อปัดลง แต่ full-screen cover ไม่ปิด ความต่างนั้นคือประเด็นของหัวข้อนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet đóng khi vuốt xuống, nhưng full-screen cover thì không. Sự khác biệt đó là ý chính của chủ đề này."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet se zavře přejetím dolů, ale cover na celou obrazovku ne. Ten rozdíl je smyslem tohoto tématu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ark lukker, når du stryger nedad, men et fuldskærmscover gør ikke. Den forskel er pointen med dette emne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα φύλλο κλείνει όταν σύρεις προς τα κάτω, ένα κάλυμμα πλήρους οθόνης όχι. Αυτή η διαφορά είναι το νόημα αυτού του θέματος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkki sulkeutuu pyyhkäistäessä alas, mutta kokoruudun peite ei. Tuo ero on tämän aiheen pointti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembar menutup saat kamu mengusap ke bawah, tetapi penutup layar penuh tidak. Perbedaan itu inti topik ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ark lukkes når du sveiper ned, men et dekke over hele skjermen gjør ikke det. Den forskjellen er poenget med dette emnet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een sheet sluit als je omlaag veegt, maar een dekkende dekking op volledig scherm niet. Dat verschil is waar dit onderwerp om draait."
          }
        }
      }
    },
    "시트를 **위아래로 끌어보세요**, medium과 large 사이에서 걸립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Drag the sheet up and down**: it catches between medium and large."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Drag the sheet up and down**: it catches between medium and large."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートを**上下にドラッグしてみてください**。mediumとlargeのあいだで止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트를 **위아래로 끌어보세요**, medium과 large 사이에서 걸립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**上下拖动**弹层，它会停在 medium 和 large 之间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**上下拖動**工作表，它會停在 medium 和 large 之間。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Потяните шторку вверх и вниз**: она задерживается между medium и large."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Arrastra la hoja arriba y abajo**: se detiene entre medium y large."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ziehe das Sheet nach oben und unten**: Es rastet zwischen medium und large ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Faites glisser la feuille vers le haut et le bas** : elle s'arrête entre medium et large."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trascina il foglio su e giù**: si aggancia tra medium e large."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Arraste a folha para cima e para baixo**: ela encaixa entre medium e large."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ลากชีตขึ้นลง**: มันจับอยู่ระหว่าง medium กับ large"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kéo sheet lên xuống**: nó dừng giữa medium và large."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Táhněte sheet nahoru a dolů**: zachytí se mezi medium a large."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Træk arket op og ned**: det fanger mellem medium og large."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Σύρε το φύλλο πάνω και κάτω**: πιάνει ανάμεσα σε medium και large."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vedä arkkia ylös ja alas**: se tarttuu mediumin ja largen välille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Seret lembar naik dan turun**: ia tersangkut di antara medium dan large."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dra arket opp og ned**: det fester seg mellom medium og large."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sleep de sheet omhoog en omlaag**: hij klikt vast tussen medium en large."
          }
        }
      }
    },
    "시트를 large까지 끌어올리면 뒤가 다시 잠깁니다. 허용 구간이 medium까지이기 때문입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the sheet up to large and the background locks again. That's because interaction is only allowed up to medium."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull the sheet up to large and the background locks again. That's because interaction is only allowed up to medium."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートをlargeまで引き上げると、後ろが再びロックされます。操作できる範囲がmediumまでだからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트를 large까지 끌어올리면 뒤가 다시 잠깁니다. 허용 구간이 medium까지이기 때문입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把弹层拉到 large，后面会再次被锁住。因为允许的区间只到 medium。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把工作表拉到 large，後面會再次被鎖住。因為允許的區間只到 medium。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вытянуть шторку до large, фон снова блокируется. Потому что взаимодействие разрешено только до medium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube la hoja a large y el fondo se bloquea de nuevo. Eso es porque la interacción solo se permite hasta medium."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe das Sheet auf large, und der Hintergrund sperrt wieder. Das liegt daran, dass Interaktion nur bis medium erlaubt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez la feuille jusqu'à large et l'arrière-plan se verrouille de nouveau. C'est parce que l'interaction n'est autorisée que jusqu'à medium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira il foglio su fino a large e lo sfondo si blocca di nuovo. Succede perché l'interazione è consentita solo fino a medium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe a folha até large e o fundo trava de novo. Isso porque a interação só é permitida até medium."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงชีตขึ้นเป็น large แล้วพื้นหลังจะล็อกอีกครั้ง เพราะอนุญาตให้โต้ตอบได้ถึง medium เท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo sheet lên large và nền bị khóa lại. Đó là vì tương tác chỉ được cho phép đến medium."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytáhněte sheet na large a pozadí se znovu zamkne. To proto, že interakce je povolena jen do medium."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk arket op til large, og baggrunden låses igen. Det er, fordi interaktion kun er tilladt op til medium."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τράβηξε το φύλλο προς τα πάνω σε large και το φόντο κλειδώνει ξανά. Αυτό συμβαίνει επειδή η αλληλεπίδραση επιτρέπεται μόνο μέχρι το medium."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä arkki large-kokoon, ja tausta lukittuu uudelleen. Se johtuu siitä, että vuorovaikutus sallitaan vain mediumiin asti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik lembar naik ke large dan latar terkunci lagi. Itu karena interaksi hanya diizinkan sampai medium."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra arket opp til large, så låses bakgrunnen igjen. Det er fordi interaksjon bare er tillatt opp til medium."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek de sheet omhoog naar large en de achtergrond vergrendelt weer. Dat komt doordat interactie alleen tot medium is toegestaan."
          }
        }
      }
    },
    "시트를 닫았다 다시 여는 흐름으로 만든다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it a flow of closing the sheet and opening it again"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it a flow of closing the sheet and opening it again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートを閉じてからもう一度開く流れにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트를 닫았다 다시 여는 흐름으로 만든다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做成关闭弹层再重新打开的流程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做成關閉工作表再重新開啟的流程"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать поток, в котором шторку закрывают и открывают снова"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertirlo en un flujo de cerrar la hoja y abrirla otra vez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu einem Ablauf machen, bei dem man das Sheet schließt und wieder öffnet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En faire un parcours où l'on ferme la feuille puis la rouvre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Farne un flusso in cui chiudi il foglio e lo riapri"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme num fluxo de fechar a folha e abri-la de novo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเป็นขั้นตอนปิดชีตแล้วเปิดใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến nó thành luồng đóng sheet rồi mở lại"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udělat z toho tok zavření sheetu a jeho znovuotevření"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør det til et flow med at lukke arket og åbne det igen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάν' το ροή κλεισίματος του φύλλου και ξανανοίγματός του"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee siitä kulku, jossa arkki suljetaan ja avataan uudelleen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadikan alur menutup lembar dan membukanya lagi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør det til et forløp der du lukker arket og åpner det igjen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak er een flow van waarin je de sheet sluit en weer opent"
          }
        }
      }
    },
    "시트를 연 채로 **뒤 화면의 슬라이더를 만져보세요**, 실제로 움직입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the sheet open, **try the slider on the screen behind it**: it really moves."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With the sheet open, **try the slider on the screen behind it**: it really moves."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートを開いたまま**後ろの画面のスライダーを触ってみてください**。実際に動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트를 연 채로 **뒤 화면의 슬라이더를 만져보세요**, 실제로 움직입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持弹层打开，**操作后面界面的滑块**，它真的会动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持工作表開啟，**操作後面介面的滑塊**，它真的會動。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При открытой шторке **попробуйте ползунок на экране позади**: он действительно двигается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la hoja abierta, **prueba el control deslizante de la pantalla de detrás**: se mueve de verdad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere bei geöffnetem Sheet **den Schieberegler auf dem Bildschirm dahinter**: Er bewegt sich wirklich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feuille ouverte, **essayez le curseur sur l'écran derrière** : il bouge vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con il foglio aperto, **prova il cursore sulla schermata dietro**: si muove davvero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a folha aberta, **experimente o controle deslizante na tela atrás dela**: ele realmente se move."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดชีตค้างไว้ แล้ว**ลองแถบเลื่อนบนหน้าจอด้านหลัง**: มันขยับจริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi sheet đang mở, **thử thanh trượt trên màn hình phía sau**: nó thật sự di chuyển."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S otevřeným sheetem **zkuste posuvník na obrazovce za ním**: opravdu se hýbe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med arket åbent, **prøv skyderen på skærmen bagved**: den bevæger sig faktisk."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με το φύλλο ανοιχτό, **δοκίμασε το ρυθμιστικό στην οθόνη πίσω του**: κινείται πραγματικά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkin ollessa auki **kokeile sen takana olevan näkymän liukusäädintä**: se todella liikkuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan lembar terbuka, **coba penggeser di layar di belakangnya**: ia benar-benar bergerak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med arket åpent, **prøv glidebryteren på skjermen bak det**: den beveger seg faktisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer bij geopende sheet **de schuifregelaar op het scherm erachter**: hij beweegt echt."
          }
        }
      }
    },
    "시트를 연 채로 이 슬라이더를 움직여 보세요. **뒤가 살아 있다**는 게 이 항목의 전부입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move this slider with the sheet still open. **The background stays live**, and that's all this topic is about."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Move this slider with the sheet still open. **The background stays live**, and that's all this topic is about."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートを開いたまま、このスライダーを動かしてみてください。**後ろが生きている**ということが、このトピックのすべてです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트를 연 채로 이 슬라이더를 움직여 보세요. **뒤가 살아 있다**는 게 이 항목의 전부입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持弹层打开，拖动这个滑块。**后面是活的**，这就是这一项的全部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持工作表開啟，拖動這個滑塊。**後面是活的**，這就是這一項的全部。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигайте этот ползунок при открытой шторке. **Фон остаётся живым**, и в этом вся тема."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve este control deslizante con la hoja aún abierta. **El fondo sigue activo**, y de eso trata todo este tema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewege diesen Schieberegler bei weiterhin geöffnetem Sheet. **Der Hintergrund bleibt aktiv**, und darum geht es in diesem ganzen Thema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez ce curseur avec la feuille toujours ouverte. **L'arrière-plan reste actif**, et c'est tout l'objet de cette rubrique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Muovi questo cursore con il foglio ancora aperto. **Lo sfondo resta attivo**, ed è tutto ciò di cui parla questo argomento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova este controle deslizante com a folha ainda aberta. **O fundo continua ativo**, e é só disso que este tópico trata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขยับแถบเลื่อนนี้ขณะชีตยังเปิดอยู่ **พื้นหลังยังใช้งานได้** และนั่นคือทั้งหมดของหัวข้อนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển thanh trượt này khi sheet vẫn mở. **Nền vẫn hoạt động**, và đó là toàn bộ chủ đề này."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hýbejte tímto posuvníkem, zatímco sheet zůstává otevřený. **Pozadí zůstává živé** a o tom je celé toto téma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt denne skyder, mens arket stadig er åbent. **Baggrunden forbliver levende**, og det er alt, dette emne handler om."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κούνησε αυτό το ρυθμιστικό με το φύλλο ακόμα ανοιχτό. **Το φόντο μένει ενεργό**, και αυτό είναι όλο το θέμα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikuta tätä liukusäädintä arkin ollessa vielä auki. **Tausta pysyy elävänä**, ja siitä tässä aiheessa on kyse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakkan penggeser ini dengan lembar tetap terbuka. **Latar tetap hidup**, dan hanya itulah isi topik ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt denne glidebryteren mens arket fortsatt er åpent. **Bakgrunnen forblir levende**, og det er alt dette emnet handler om."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweeg deze schuifregelaar terwijl de sheet open blijft. **De achtergrond blijft live**, en daar gaat dit onderwerp helemaal over."
          }
        }
      }
    },
    "시트보다 애니메이션이 빠르므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because the animation is faster than a sheet"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because the animation is faster than a sheet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートよりアニメーションが速いから"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트보다 애니메이션이 빠르므로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为动画比弹层更快"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為動畫比工作表更快"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что анимация быстрее, чем у шторки"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque la animación es más rápida que la de una hoja"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil die Animation schneller ist als bei einem Sheet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce que l'animation est plus rapide qu'une feuille"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché l'animazione è più veloce di un foglio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque a animação é mais rápida que uma folha"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพราะแอนิเมชันเร็วกว่าชีต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì hoạt ảnh nhanh hơn sheet"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože animace je rychlejší než u sheetu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi animationen er hurtigere end et ark"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επειδή η κίνηση είναι ταχύτερη από ένα φύλλο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska animaatio on nopeampi kuin arkki"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena animasinya lebih cepat daripada lembar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi animasjonen er raskere enn et ark"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat de animatie sneller is dan een sheet"
          }
        }
      }
    },
    "시트에 표시된 금액과 실제 청구액이 같았나요? 사용자는 어느 쪽을 보고 결제했을까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the amount shown in the sheet match the actual charge? Which one did people look at when they paid?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the amount shown in the sheet match the actual charge? Which one did people look at when they paid?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートに表示された金額と実際の請求額は同じでしたか？ユーザーはどちらを見て支払ったでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트에 표시된 금액과 실제 청구액이 같았나요? 사용자는 어느 쪽을 보고 결제했을까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弹层里显示的金额和实际扣款一致吗？用户是看着哪一个付的款？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表裡顯示的金額和實際扣款一致嗎？使用者是看著哪一個付的款？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совпадала ли сумма, показанная в шторке, с реально списанной? На какую из них смотрели, когда платили?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Coincidía el importe mostrado en la hoja con el cargo real? ¿En cuál se fijó la gente al pagar?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stimmte der im Sheet angezeigte Betrag mit der tatsächlichen Abbuchung überein? Worauf schauten die Leute beim Bezahlen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant affiché dans la feuille correspondait-il au débit réel ? Lequel les gens ont-ils regardé au moment de payer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importo mostrato nel foglio corrispondeva all'addebito reale? Quale hanno guardato le persone quando hanno pagato?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor mostrado na folha correspondeu à cobrança real? Qual deles as pessoas olharam ao pagar?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเงินที่แสดงในชีตตรงกับที่เรียกเก็บจริงไหม ตอนจ่ายเงิน คนมองอันไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tiền hiển thị trong sheet có khớp với số bị tính thực tế không? Người ta nhìn cái nào khi thanh toán?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Shodovala se částka zobrazená v sheetu se skutečným zúčtováním? Na kterou se lidé dívali, když platili?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Matchede beløbet vist i arket det faktiske beløb? Hvilket kiggede folk på, da de betalte?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ταίριαζε το ποσό που εμφανιζόταν στο φύλλο με την πραγματική χρέωση; Ποιο κοίταζαν οι άνθρωποι όταν πλήρωναν;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastasiko arkissa näytetty summa todellista veloitusta? Kumpaa ihmiset katsoivat maksaessaan?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah jumlah yang ditampilkan di lembar cocok dengan tagihan sebenarnya? Mana yang dilihat orang saat membayar?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemte beløpet vist i arket med den faktiske belastningen? Hvilket så folk på da de betalte?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwam het bedrag in de sheet overeen met de werkelijke afschrijving? Naar welke keken mensen toen ze betaalden?"
          }
        }
      }
    },
    "시트와 모양을 맞추기 위한 관습적인 배치다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a conventional layout meant to match the sheet's look"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a conventional layout meant to match the sheet's look"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートと見た目をそろえるための慣習的な配置だ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트와 모양을 맞추기 위한 관습적인 배치다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是为了与弹层的样式保持一致的惯例性布局"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是為了與工作表的樣式保持一致的慣例性佈局"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это условная раскладка, чтобы по виду совпасть со шторкой"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un diseño convencional pensado para combinar con el aspecto de la hoja"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein konventionelles Layout, das zum Aussehen des Sheets passen soll"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est une disposition conventionnelle destinée à s'accorder à l'aspect de la feuille"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un layout convenzionale pensato per adattarsi all'aspetto del foglio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um layout convencional pensado para combinar com o visual da folha"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นเลย์เอาต์ตามธรรมเนียมเพื่อให้เข้ากับรูปลักษณ์ของชีต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là bố cục theo quy ước để khớp với diện mạo của sheet"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to konvenční rozvržení, které má odpovídat vzhledu sheetu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er et konventionelt layout, der skal passe til arkets udseende"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι μια συμβατική διάταξη που προορίζεται να ταιριάζει με την όψη του φύλλου"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on perinteinen asettelu, jonka on tarkoitus vastata arkin ulkoasua"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tata letak konvensional yang dimaksudkan menyesuaikan tampilan lembar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er et konvensjonelt oppsett ment å matche arkets utseende"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is een conventionele layout die past bij het uiterlijk van de sheet"
          }
        }
      }
    },
