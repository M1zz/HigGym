            "value": "비어 있음"
          }
        }
      }
    },
    "비우기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비우기"
          }
        }
      }
    },
    "빈 자리는 실패가 아니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty space is not a failure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いた場所は失敗ではない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 자리는 실패가 아니다"
          }
        }
      }
    },
    "빈 자리는 실패가 아닙니다. 채우기 위해 넣은 것은 대개 군더더기입니다(8.1.1).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty space is not a failure. Things added just to fill it are usually clutter (8.1.1)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いた場所は失敗ではありません。埋めるために入れたものは、たいてい余計なものです（8.1.1）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 자리는 실패가 아닙니다. 채우기 위해 넣은 것은 대개 군더더기입니다(8.1.1)."
          }
        }
      }
    },
    "빈도": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도"
          }
        }
      }
    },
    "빈도 문제가 아닙니다. 자주 쓰더라도 되돌릴 수 없으면 한 단계 멀리 둡니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not about frequency. Even if it's used often, an irreversible action goes one step away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度の問題ではありません。よく使うとしても、取り消せないなら一段遠くに置きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도 문제가 아닙니다. 자주 쓰더라도 되돌릴 수 없으면 한 단계 멀리 둡니다."
          }
        }
      }
    },
    "빈도가 낮은 액션(설정)은 어디에 있는 게 맞는지도 함께 생각해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also think about where a rarely used action (Settings) belongs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度の低いアクション（設定）がどこにあるべきかも、あわせて考えてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도가 낮은 액션(설정)은 어디에 있는 게 맞는지도 함께 생각해 보세요."
          }
        }
      }
    },
    "빈도가 높을수록 엄지에 가깝게. 목록 화면에서 반복되는 액션은 새 노트 하나뿐이라 그 자리를 그것에 줬다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The more frequent, the closer to the thumb. On the list screen, the only repeated action is New Note, so that spot went to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度が高いほど親指の近くに。リスト画面で繰り返されるアクションは新規メモだけなので、その場所をそれに与えた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도가 높을수록 엄지에 가깝게. 목록 화면에서 반복되는 액션은 새 노트 하나뿐이라 그 자리를 그것에 줬다."
          }
        }
      }
    },
    "빈도와 높이는 반비례한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency and height are inversely related"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度と高さは反比例する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도와 높이는 반비례한다"
          }
        }
      }
    },
    "빈도와 높이는 반비례해야 합니다. 목록에서 반복되는 액션은 새 노트 하나뿐입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency and height should be inversely related. On the list, the only repeated action is New Note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度と高さは反比例すべきです。リストで繰り返されるアクションは新規メモだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도와 높이는 반비례해야 합니다. 목록에서 반복되는 액션은 새 노트 하나뿐입니다."
          }
        }
      }
    },
    "빌드 118 이 배포되었습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build 118 has been released."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルド 118 が配信されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드 118 이 배포되었습니다."
          }
        }
      }
    },
    "빽빽하게": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compact"
          }
        },
        "ja": {
