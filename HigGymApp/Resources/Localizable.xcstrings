    "Text(\"읽혀야 하는 글자\")\n    .padding()\n    .background(.regularMaterial, in: .rect(cornerRadius: 16))\n// .ultraThinMaterial · .thinMaterial · .regularMaterial\n// .thickMaterial · .ultraThickMaterial": {
