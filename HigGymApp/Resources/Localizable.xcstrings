          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. Kun arket dukkede op, og fanen var gået tilbage til Hjem. Jeg trykkede på den igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. Εμφανίστηκε μόνο το φύλλο και η καρτέλα είχε γυρίσει στην Αρχική. Την πάτησα ξανά."
          }
        },
        "fi": {
