    "흐름이 아니라 무게로 정한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide by weight, not by flow"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide by weight, not by flow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流れではなく重さで決める"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐름이 아니라 무게로 정한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按分量而不是流程来决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按分量而不是流程來決定"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решать по весу, а не по потоку"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide por peso, no por flujo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Gewicht entscheiden, nicht nach Ablauf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décider selon le poids, pas selon le déroulement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi in base al peso, non al flusso"
