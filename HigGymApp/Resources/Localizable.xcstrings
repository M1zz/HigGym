    "줄 수 범위와 공간 예약이 들어갔습니다. 커져도 무너지지 않고 이웃도 흔들리지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A line range and reserved space were added. It doesn't fall apart as text grows, and its neighbors don't shift."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A line range and reserved space were added. It doesn't fall apart as text grows, and its neighbours don't shift."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行数の範囲とスペースの確保が入りました。大きくなっても崩れず、隣も揺れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄 수 범위와 공간 예약이 들어갔습니다. 커져도 무너지지 않고 이웃도 흔들리지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入了行数范围和空间预留。变大也不会崩，邻近的行也不会晃动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入了行數範圍和空間預留。變大也不會崩，鄰近的行也不會晃動。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлены диапазон строк и зарезервированное место. Оно не разваливается при росте текста, и соседи не сдвигаются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadieron un rango de líneas y espacio reservado. No se desmorona cuando el texto crece, y sus vecinos no se desplazan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zeilenbereich und reservierter Platz wurden hinzugefügt. Es zerfällt nicht, wenn der Text wächst, und die Nachbarn verschieben sich nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une plage de lignes et de l'espace réservé ont été ajoutés. Cela ne s'effondre pas quand le texte grossit, et ses voisins ne bougent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono stati aggiunti un intervallo di righe e uno spazio riservato. Non si sfalda al crescere del testo, e le righe vicine non si spostano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram adicionados um intervalo de linhas e espaço reservado. Não se desfaz conforme o texto cresce, e os vizinhos não se deslocam."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มช่วงบรรทัดและพื้นที่สำรอง มันไม่พังเมื่อข้อความโตขึ้น และข้างเคียงไม่ขยับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thêm khoảng số dòng và không gian dành sẵn. Nó không vỡ khi chữ to ra, và các mục bên cạnh không xê dịch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Byl přidán rozsah řádků a rezervované místo. Neroztříští se, když text roste, a sousedé se neposouvají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et linjeinterval og reserveret plads blev tilføjet. Det falder ikke fra hinanden, når teksten vokser, og naboerne flytter sig ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προστέθηκε εύρος γραμμών και δεσμευμένος χώρος. Δεν καταρρέει καθώς μεγαλώνει το κείμενο, και οι γείτονές του δεν μετατοπίζονται."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivin vaihteluväli ja varattu tila lisättiin. Se ei hajoa tekstin kasvaessa, eivätkä naapurit siirry."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentang baris dan ruang yang disisihkan ditambahkan. Ia tidak berantakan saat teks membesar, dan tetangganya tidak bergeser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et linjeområde og reservert plass ble lagt til. Den faller ikke fra hverandre når teksten vokser, og naboene forskyves ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een regelbereik en gereserveerde ruimte zijn toegevoegd. Het valt niet uit elkaar als de tekst groeit, en de buren verschuiven niet."
          }
        }
      }
    },
