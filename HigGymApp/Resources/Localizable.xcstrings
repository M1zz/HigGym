        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเครื่องมือตามว่าถูกตัดแล้วยังมีความหมายหรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn công cụ theo việc nó có còn hiểu được khi bị cắt không"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte nástroj podle toho, zda to dává smysl i po oříznutí"
