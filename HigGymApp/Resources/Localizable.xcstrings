            "value": "Sovellus kokosi näytöllä näkyvät merkkijonot käsin: `\"\\(km)km\"`, `\"\\(family)\\(given)\"`."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi merangkai string di layar dengan tangan: `\"\\(km)km\"`, `\"\\(family)\\(given)\"`."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen satte sammen strenger på skjermen for hånd: `\"\\(km)km\"`, `\"\\(family)\\(given)\"`."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app stelde tekenreeksen op het scherm met de hand samen: `\"\\(km)km\"`, `\"\\(family)\\(given)\"`."
          }
        }
      }
    },
