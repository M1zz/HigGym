    "작성 버튼을 오른쪽 아래로 옮기기로 결정했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We decided to move the Compose button to the bottom right."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We decided to move the Compose button to the bottom right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成ボタンを右下に移すことに決めました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성 버튼을 오른쪽 아래로 옮기기로 결정했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定把撰写按钮移到右下角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定把撰寫按鈕移到右下角。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы решили перенести кнопку «Написать» вправо вниз."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidimos mover el botón Redactar abajo a la derecha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben beschlossen, den Verfassen-Button nach unten rechts zu verlegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons décidé de déplacer le bouton Rédiger en bas à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo deciso di spostare il pulsante Scrivi in basso a destra."
          }
        }
      }
    },
    "작성 중이던 내용을 지키는 대신 사용자를 가둡니다, 그 무게에 맞는 화면에만 씁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It protects what you're writing by trapping you, so use it only on screens that warrant that weight."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It protects what you're writing by trapping you, so use it only on screens that warrant that weight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成中の内容を守る代わりにユーザーを閉じ込めます。その重さに見合う画面にだけ使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성 중이던 내용을 지키는 대신 사용자를 가둡니다, 그 무게에 맞는 화면에만 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它不保护正在撰写的内容，而是把用户困住了。只用在配得上这个分量的界面上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它不保護正在撰寫的內容，而是把使用者困住了。只用在配得上這個分量的介面上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он защищает то, что вы пишете, запирая вас, поэтому применяйте его только на экранах, которые оправдывают такой вес."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege lo que escribes atrapándote, así que úsalo solo en pantallas que justifiquen ese peso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es schützt, was du schreibst, indem es dich festhält, also nutze es nur auf Bildschirmen, die dieses Gewicht rechtfertigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il protège ce que vous écrivez en vous piégeant, donc ne l'utilisez que sur les écrans qui justifient un tel poids."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegge ciò che stai scrivendo intrappolandoti, quindi usalo solo nelle schermate che meritano quel peso."
          }
        }
      }
    },
    "작성 중인 글을 지키는 대신 출구를 만들 의무가 따라옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protecting the draft comes with an obligation to build a way out."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Protecting the draft comes with an obligation to build a way out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書きかけの文章を守る代わりに、出口をつくる義務がついてきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성 중인 글을 지키는 대신 출구를 만들 의무가 따라옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护正在写的内容，随之而来的是必须做出口的义务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護正在寫的內容，隨之而來的是必須做出口的義務。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защита черновика влечёт обязанность построить путь выхода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteger el borrador conlleva la obligación de construir una salida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Entwurf zu schützen bringt die Pflicht mit sich, einen Ausweg zu bauen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protéger le brouillon s'accompagne de l'obligation de construire une issue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggere la bozza comporta l'obbligo di costruire una via d'uscita."
          }
        }
      }
    },
    "작성 탭 → 시트만 뜨고 선택은 되돌아옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose tab → only a sheet appears, and the selection goes back."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose tab → only a sheet appears, and the selection goes back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成タブ → シートが出るだけで、選択は元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성 탭 → 시트만 뜨고 선택은 되돌아옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写标签 → 只弹出弹层，选中状态又弹回去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫標籤 → 只彈出工作表，選中狀態又彈回去。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка «Написать» → появляется только шторка, а выбор откатывается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pestaña Redactar → solo aparece una hoja y la selección vuelve atrás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab „Verfassen“ → es erscheint nur ein Sheet, und die Auswahl springt zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onglet Rédiger → seule une feuille apparaît, et la sélection revient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheda Scrivi → compare solo un foglio e la selezione torna indietro."
          }
        }
      }
    },
    "작성: 김하늘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Author: Olivia Kim"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Author: Olivia Kim"
          }
