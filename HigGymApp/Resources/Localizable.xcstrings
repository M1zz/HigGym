    "작업 흐름 순서대로 정렬하면 논리적으로는 맞지만, 손의 습관과는 어긋난다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordering by workflow is logical, but it goes against the habits of the hand."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordering by workflow is logical, but it goes against the habits of the hand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業の流れの順に並べると論理的には正しいが、手の習慣とは食い違う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 흐름 순서대로 정렬하면 논리적으로는 맞지만, 손의 습관과는 어긋난다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按工作流顺序排列，逻辑上没错，但与手的习惯相悖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按工作流順序排列，邏輯上沒錯，但與手的習慣相悖。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядочение по ходу работы логично, но противоречит привычкам руки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar por flujo de trabajo es lógico, pero va contra los hábitos de la mano."
          }
        }
      }
    },
    "잘려도 뜻이 통하는가": {
