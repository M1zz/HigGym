        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste posouvat: panel karet se minimalizuje a **kapsle hledání zůstane**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv at scrolle: fanelinjen minimeres, og **søgekapslen bliver**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκίμασε να κυλήσεις: η γραμμή καρτελών ελαχιστοποιείται και **η κάψουλα αναζήτησης μένει**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile vierittää: välilehtipalkki pienenee ja **hakukapseli pysyy**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba gulir: bilah tab menciut dan **kapsul pencarian tetap**."
