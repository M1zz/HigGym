    "보관·삭제는 더보기 메뉴 안으로 넣습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive and Delete go inside the More menu."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive and Delete go inside the More menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブと削除は「その他」メニューの中に入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관·삭제는 더보기 메뉴 안으로 넣습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把归档、删除放进更多菜单里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把歸檔、刪除放進更多選單裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«В архив» и «Удалить» уходят в меню «Ещё»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivar y Eliminar van dentro del menú Más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivieren und Löschen kommen in das Menü „Mehr“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiver et Supprimer vont dans le menu Plus."
          }
        },
