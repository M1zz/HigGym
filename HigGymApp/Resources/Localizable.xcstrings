            "state": "translated",
            "value": "Досягаемость относится только к безвредным действиям"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alcance se aplica solo a acciones inofensivas"
          }
        },
        "de": {
          "stringUnit": {
