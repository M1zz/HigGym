        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบบฝึกนี้เป็นส่วนของ Pro ทำทุกข้อที่ให้คุณตัดสินหน้าจอจริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài tập này là một phần của Pro. Giải mọi câu hỏi yêu cầu bạn đánh giá màn hình thật."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto cvičení je součástí Pro. Vyřešte každou otázku, která vás žádá o posouzení skutečné obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne øvelse er en del af Pro. Løs hvert spørgsmål, der beder dig bedømme en rigtig skærm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η άσκηση αποτελεί μέρος του Pro. Λύσε κάθε ερώτηση που σου ζητά να κρίνεις μια πραγματική οθόνη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä harjoitus kuuluu Pro-versioon. Ratkaise kaikki kysymykset, joissa arvioit todellista näkymää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan ini adalah bagian dari Pro. Selesaikan setiap pertanyaan yang meminta kamu menilai layar nyata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne øvelsen er en del av Pro. Løs alle spørsmålene som ber deg bedømme en ekte skjerm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze oefening is onderdeel van Pro. Los elke vraag op waarin je een echt scherm moet beoordelen."
          }
        }
      }
    },
