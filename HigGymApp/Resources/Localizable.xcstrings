    "하단 캡슐이 더 최신 디자인처럼 보이기 때문에": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because a bottom capsule looks like a more modern design"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because a bottom capsule looks like a more modern design"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のカプセルのほうが新しいデザインに見えるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 캡슐이 더 최신 디자인처럼 보이기 때문에"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为底部胶囊看起来更像新设计"
