    "그 버튼들이 한 덩어리로 보였나요? 누르는 동안 아찔하거나 망설인 순간이 있었나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did those buttons look like one block? Was there a moment of alarm or hesitation while you were tapping?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Did those buttons look like one block? Was there a moment of alarm or hesitation while you were tapping?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのボタンはひとかたまりに見えましたか？タップしている間、ひやっとしたり迷ったりした瞬間はありましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 버튼들이 한 덩어리로 보였나요? 누르는 동안 아찔하거나 망설인 순간이 있었나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那些按钮看起来像一整块吗？点按时有没有哪一刻感到发慌或犹豫？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那些按鈕看起來像一整塊嗎？輕點時有沒有哪一刻感到發慌或猶豫？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Казалось ли, что эти кнопки слиплись в один блок? Был ли момент, когда при нажатии стало не по себе или вы засомневались?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Esos botones parecían un solo bloque? ¿Hubo un momento de alarma o de duda mientras tocabas?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahen diese Buttons wie ein Block aus? Gab es beim Tippen einen Moment des Schreckens oder Zögerns?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces boutons ressemblaient-ils à un seul bloc ? Avez-vous eu un moment d'alarme ou d'hésitation en touchant ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quei pulsanti sembravano un unico blocco? C'è stato un momento di allarme o di esitazione mentre toccavi?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses botões pareceram um bloco só? Houve um momento de susto ou hesitação enquanto você tocava?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มเหล่านั้นดูเป็นก้อนเดียวกันไหม มีจังหวะตกใจหรือลังเลระหว่างที่แตะหรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những nút đó trông có giống một khối không? Có lúc nào bạn thấy giật mình hay do dự khi chạm không?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypadala ta tlačítka jako jeden blok? Byla chvíle úlekem nebo váhání při klepání?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lignede knapperne én blok? Var der et øjeblik af alarm eller tøven, mens du trykkede?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έμοιαζαν αυτά τα κουμπιά με ένα μπλοκ; Υπήρξε στιγμή ανησυχίας ή δισταγμού καθώς πατούσες;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttivätkö nuo painikkeet yhdeltä lohkolta? Tuliko napautellessa hetki hälytystä tai epäröintiä?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah tombol-tombol itu terlihat seperti satu blok? Apakah ada momen waspada atau ragu saat kamu mengetuk?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så disse knappene ut som én blokk? Var det et øyeblikk av skrekk eller nøling mens du trykket?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zagen die knoppen eruit als één blok? Was er een moment van schrik of aarzeling tijdens het tikken?"
          }
        }
      }
    },
    "그 자리는 무엇을 위한 자리인가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is that spot for?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What is that spot for?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場所は何のための場所か"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 자리는 무엇을 위한 자리인가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那个位置是为了什么而设的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那個位置是為了什麼而設的"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для чего предназначено это место?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Para qué sirve ese sitio?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür ist diese Stelle da?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quoi sert cet emplacement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A che cosa serve quel posto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que serve aquele lugar?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งนั้นมีไว้เพื่ออะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí đó để làm gì?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K čemu to místo slouží?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad er den plads til?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε τι χρησιμεύει εκείνο το σημείο;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mihin tuo paikka on tarkoitettu?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk apa tempat itu?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva er den plassen til?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar is die plek voor?"
          }
        }
      }
    },
    "그 자리의 약속을 한 번 깨면, 다음에 거기 놓는 진짜 액션도 광고처럼 보인다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Break that spot's promise once, and the next real action you put there looks like an ad too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Break that spot's promise once, and the next real action you put there looks like an ad too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場所の約束を一度破ると、次にそこに置く本物のアクションも広告のように見える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 자리의 약속을 한 번 깨면, 다음에 거기 놓는 진짜 액션도 광고처럼 보인다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦打破那个位置的约定，下次放在那里的真正的操作也会像广告一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦打破那個位置的約定，下次放在那裡的真正的操作也會像廣告一樣。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоит один раз нарушить обещание этого места, и следующее настоящее действие, которое вы туда поставите, тоже будет выглядеть как реклама."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompe la promesa de ese sitio una vez, y la siguiente acción real que pongas ahí también parecerá un anuncio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brich das Versprechen dieser Stelle einmal, und die nächste echte Aktion, die du dort platzierst, sieht ebenfalls wie Werbung aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisez la promesse de cet emplacement une fois, et la prochaine vraie action que vous y mettrez ressemblera elle aussi à une publicité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompi una volta la promessa di quel posto, e la prossima vera azione che ci metterai sembrerà anch'essa una pubblicità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quebre a promessa daquele lugar uma vez, e a próxima ação de verdade que você colocar ali também vai parecer um anúncio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผิดสัญญาของตำแหน่งนั้นสักครั้ง การกระทำจริงถัดไปที่คุณวางไว้ตรงนั้นก็จะดูเหมือนโฆษณาด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phá lời hứa của vị trí đó một lần, và hành động thật tiếp theo bạn đặt ở đó cũng trông như quảng cáo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porušte slib toho místa jednou a další skutečná akce, kterou tam dáte, bude vypadat také jako reklama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bryd den plads' løfte én gang, og den næste rigtige handling, du lægger der, ligner også en reklame."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παραβίασε το λόγο εκείνου του σημείου μία φορά και η επόμενη πραγματική ενέργεια που θα βάλεις εκεί θα μοιάζει κι αυτή με διαφήμιση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Riko tuon paikan lupaus kerran, ja seuraava todellinen toiminto, jonka sinne sijoitat, näyttää myös mainokselta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langgar janji tempat itu sekali, dan aksi nyata berikutnya yang kamu taruh di sana juga terlihat seperti iklan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bryt løftet til den plassen én gang, og den neste ekte handlingen du setter der ser også ut som en annonse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breek de belofte van die plek één keer, en de volgende echte actie die je daar zet, lijkt ook een advertentie."
          }
        }
      }
    },
    "그 탭에 들어가 목록의 항목을 눌러 읽으면 **배지 숫자가 실제로 줄어듭니다**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go into that tab and tap items in the list to read them, and **the badge number actually goes down**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Go into that tab and tap items in the list to read them, and **the badge number actually goes down**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのタブに入ってリストの項目をタップして読むと、**バッジの数字が実際に減ります**。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 탭에 들어가 목록의 항목을 눌러 읽으면 **배지 숫자가 실제로 줄어듭니다**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入那个标签，点按列表中的项目阅读，**角标数字会真的减少**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入那個標籤，輕點列表中的項目閱讀，**標記數字會真的減少**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зайдите на эту вкладку и нажимайте элементы списка, чтобы прочитать их: **число на бейдже действительно уменьшается**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra en esa pestaña y toca elementos de la lista para leerlos, y **el número de la insignia baja de verdad**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe in diesen Tab und tippe Elemente in der Liste an, um sie zu lesen, und **die Zahl im Badge sinkt wirklich**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allez dans cet onglet et touchez des éléments de la liste pour les lire, et **le nombre du badge diminue vraiment**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra in quella scheda e tocca gli elementi dell'elenco per leggerli, e **il numero del badge scende davvero**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre nessa aba e toque em itens da lista para lê-los, e **o número do badge realmente diminui**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าไปในแท็บนั้นแล้วแตะรายการในรายการเพื่ออ่าน แล้ว**ตัวเลขบนป้ายจะลดลงจริง**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vào tab đó và chạm các mục trong danh sách để đọc, thì **con số trên huy hiệu thật sự giảm xuống**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejděte na tu kartu a klepejte na položky v seznamu, abyste je přečetli, a **číslo na odznaku opravdu klesá**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå ind på den fane og tryk på elementer i listen for at læse dem, og **badgens tal falder faktisk**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπες σε εκείνη την καρτέλα και πάτησε στοιχεία στη λίστα για να τα διαβάσεις, και **ο αριθμός του σήματος πραγματικά μειώνεται**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mene tuolle välilehdelle ja napauta luettelon kohteita lukeaksesi ne, niin **merkin numero todella laskee**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk ke tab itu dan ketuk item di daftar untuk membacanya, dan **angka lencana benar-benar turun**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå inn i den fanen og trykk på elementer i listen for å lese dem, og **merketallet går faktisk ned**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga naar dat tabblad en tik op items in de lijst om ze te lezen, en **het getal op de badge gaat echt omlaag**."
          }
        }
      }
    },
    "그 탭에 한 번 들어갔다 나오면 배지가 사라집니다, \"새 것\"은 한 번 보면 새 것이 아니니까요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit that tab once and the badge disappears. Once you've seen something \"new,\" it isn't new anymore."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit that tab once and the badge disappears. Once you've seen something \"new,\" it isn't new anymore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのタブに一度入って出るとバッジが消えます。「新しいもの」は一度見たら、もう新しくないからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 탭에 한 번 들어갔다 나오면 배지가 사라집니다, \"새 것\"은 한 번 보면 새 것이 아니니까요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入那个标签一次再出来，角标就会消失：“新的”看过一次就不再是新的了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入那個標籤一次再出來，標記就會消失：「新的」看過一次就不再是新的了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашли на эту вкладку один раз, и бейдж исчезает. Увиденное «новое» новым уже не является."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visita esa pestaña una vez y la insignia desaparece. Cuando ya has visto algo «nuevo», deja de ser nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besuche diesen Tab einmal, und das Badge verschwindet. Hat man etwas „Neues“ gesehen, ist es nicht mehr neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visitez cet onglet une fois et le badge disparaît. Une fois que vous avez vu quelque chose de « nouveau », ce n'est plus nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visita quella scheda una volta e il badge scompare. Una volta che hai visto una «novità», non è più nuova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visite essa aba uma vez e o badge some. Depois que você viu algo «novo», aquilo já não é novo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าแท็บนั้นสักครั้ง ป้ายตัวเลขก็จะหายไป เมื่อเห็นสิ่งที่ \"ใหม่\" แล้ว มันก็ไม่ใหม่อีกต่อไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghé tab đó một lần là huy hiệu biến mất. Một khi bạn đã thấy thứ \"mới\", nó không còn mới nữa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navštivte tu kartu jednou a odznak zmizí. Jakmile jste „nové“ viděli, už není nové."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Besøg den fane én gang, og badgen forsvinder. Når du først har set noget »nyt«, er det ikke nyt mere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επισκέψου εκείνη την καρτέλα μία φορά και το σήμα εξαφανίζεται. Μόλις δεις κάτι «νέο», δεν είναι πια νέο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käy tuolla välilehdellä kerran, ja merkki katoaa. Kun olet nähnyt jonkin ”uuden”, se ei ole enää uusi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunjungi tab itu sekali dan lencana menghilang. Setelah kamu melihat sesuatu yang \"baru\", ia tidak baru lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Besøk den fanen én gang, og merket forsvinner. Når du har sett noe «nytt», er det ikke nytt lenger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezoek dat tabblad één keer en de badge verdwijnt. Zodra je iets \"nieuws\" hebt gezien, is het niet meer nieuw."
          }
        }
      }
    },
    "그 탭이 가장 중요한 탭일 때": {
