    "리스트 셀에 금액 **₩1,234,000**을 넣는데 폭이 모자랍니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're putting the amount **$12,345.67** into a list cell, but it's too narrow."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You're putting the amount **$12,345.67** into a list cell, but it's too narrow."
