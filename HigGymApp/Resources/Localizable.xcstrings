    "흐름이 아니라 무게로 정한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide by weight, not by flow"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide by weight, not by flow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流れではなく重さで決める"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐름이 아니라 무게로 정한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按分量而不是流程来决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按分量而不是流程來決定"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решать по весу, а не по потоку"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide por peso, no por flujo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Gewicht entscheiden, nicht nach Ablauf"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décider selon le poids, pas selon le déroulement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decidi in base al peso, non al flusso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Decida pelo peso, não pelo fluxo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัดสินด้วยน้ำหนัก ไม่ใช่ด้วยลำดับการไหล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyết định theo mức nặng, không theo dòng chảy"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozhodujte podle váhy, ne podle toku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgør efter vægt, ikke efter flow"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποφάσισε με βάση το βάρος, όχι τη ροή"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päätä painon, ei virran mukaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Putuskan berdasarkan bobot, bukan alur"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avgjør etter vekt, ikke etter flyt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beslis op gewicht, niet op stroom"
          }
        }
      }
    },
