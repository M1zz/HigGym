            "value": "// fullScreenCover ei sulkeudu alaspäin pyyhkäisemällä. Poistumistie on tehtävä itse.\n.fullScreenCover(isPresented: $editing) {\n    EditorView()\n        .toolbar {\n            ToolbarItem(placement: .topBarLeading) { Button(\"Peruuta\") { editing = false } }\n            ToolbarItem(placement: .topBarTrailing) { Button(\"Valmis\") { save() } }\n        }\n}"
