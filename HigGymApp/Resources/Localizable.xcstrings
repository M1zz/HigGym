    "자주 쓰는 저장을 툴바 앞쪽에 두고, 가끔 쓰는 것들을 뒤로 보냈다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the frequently used Save at the front of the toolbar and sent occasional ones to the back."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the frequently used Save at the front of the toolbar and sent occasional ones to the back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく使う保存をツールバーの前に置き、たまに使うものは後ろに回した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 쓰는 저장을 툴바 앞쪽에 두고, 가끔 쓰는 것들을 뒤로 보냈다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把常用的存储放在工具栏前面，偶尔用的放到后面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把常用的儲存放在工具列前面，偶爾用的放到後面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часто используемое «Сохранить» поставили в начало панели инструментов, а редкие отправили в конец."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puso Guardar, de uso frecuente, al principio de la barra de herramientas y se mandaron al final las ocasionales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das häufig genutzte Sichern an den Anfang der Symbolleiste gesetzt und gelegentliche nach hinten geschickt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer, souvent utilisé, a été mis en tête de la barre d'outils, et les actions occasionnelles envoyées à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha messo Salva, usato spesso, all'inizio della barra degli strumenti e mandato in fondo quelli occasionali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocou o Salvar, muito usado, no começo da barra de ferramentas e mandou os ocasionais para o fim."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางบันทึกที่ใช้บ่อยไว้หน้าสุดของแถบเครื่องมือ และส่งอันที่ใช้นาน ๆ ครั้งไปไว้ท้าย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt Lưu hay dùng ở đầu thanh công cụ và đẩy các mục thỉnh thoảng ra sau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Často používané Uložit dalo na začátek panelu nástrojů a občasné poslalo dozadu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Satte den hyppigt brugte Gem forrest i værktøjslinjen og sendte de sjældne bagerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έβαλε την Αποθήκευση που χρησιμοποιείται συχνά στην αρχή της γραμμής εργαλείων και έστειλε τις περιστασιακές στο τέλος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita usein käytetty Tallenna työkalupalkin alkuun ja lähetä satunnaiset loppuun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh Simpan yang sering dipakai di depan bilah alat dan kirim yang sesekali ke belakang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Satte den hyppig brukte Lagre foran i verktøylinjen og sendte de sjeldne til slutten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het veelgebruikte Bewaar vooraan in de werkbalk gezet en incidentele acties naar achteren gestuurd."
          }
        }
      }
    },
    "자주 여는 입구는 닿기 쉬운 자리에, 안 쓰는 순간에는 비켜 있게.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put frequently opened entry points within easy reach, and keep them out of the way when not in use."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put frequently opened entry points within easy reach, and keep them out of the way when not in use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく開く入口は届きやすい場所に、使わない間はじゃまにならないように。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 여는 입구는 닿기 쉬운 자리에, 안 쓰는 순간에는 비켜 있게."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常开的入口放在容易够到的位置，不用的时候让开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常開的入口放在容易夠到的位置，不用的時候讓開。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часто открываемые точки входа ставят в зону лёгкой досягаемости, а когда они не нужны, убирают с дороги."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon al alcance fácil los puntos de entrada que se abren con frecuencia, y mantenlos apartados cuando no se usan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufig geöffnete Einstiegspunkte in bequeme Reichweite setzen und aus dem Weg halten, wenn sie nicht genutzt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez à portée de main les points d'entrée souvent ouverts, et gardez-les discrets quand ils ne servent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti a portata di mano i punti d'ingresso aperti di frequente, e tienili fuori mano quando non servono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque os pontos de entrada abertos com frequência ao alcance, e mantenha-os fora do caminho quando não estiverem em uso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางจุดเข้าที่เปิดบ่อยไว้ในระยะเอื้อมง่าย และให้พ้นทางเมื่อไม่ใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt các lối vào hay mở trong tầm với dễ dàng, và tránh đường khi không dùng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Často otevírané vstupní body dejte na dosah a nechte je mimo cestu, když se nepoužívají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Placér ofte åbnede indgange inden for let rækkevidde, og hold dem af vejen, når de ikke bruges."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε τα σημεία εισόδου που ανοίγονται συχνά σε εύκολη εμβέλεια και κράτα τα εκτός δρόμου όταν δεν χρησιμοποιούνται."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita usein avattavat sisäänkäynnit helposti ulottuville ja pidä ne pois tieltä, kun ne eivät ole käytössä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh pintu masuk yang sering dibuka dalam jangkauan mudah, dan singkirkan saat tidak dipakai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Plasser hyppig åpnede innganger innen lett rekkevidde, og hold dem unna når de ikke brukes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet vaak geopende ingangen binnen handbereik, en houd ze uit de weg als ze niet in gebruik zijn."
          }
        }
      }
    },
    "자주 여는 입구는 어디에 두는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
