    "상단 바 안에 **타이틀과 카운트**가 함께 있습니다. 필터를 바꾸면 숫자가 실제로 바뀝니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The top bar holds **the title and a count** together. Change the filter and the number really changes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The top bar holds **the title and a count** together. Change the filter and the number really changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部のバーの中に**タイトルと件数**が一緒にあります。フィルタを変えると数字が実際に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단 바 안에 **타이틀과 카운트**가 함께 있습니다. 필터를 바꾸면 숫자가 실제로 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部栏里同时有**标题和数量**。切换筛选，数字真的会变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂部列裡同時有**標題和數量**。切換篩選，數字真的會變。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В верхней панели вместе показаны **заголовок и счётчик**. Измените фильтр, и число действительно меняется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra superior contiene **el título y un contador** juntos. Cambia el filtro y el número cambia de verdad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die obere Leiste enthält **Titel und Zähler** zusammen. Ändere den Filter, und die Zahl ändert sich wirklich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre du haut contient **le titre et un compteur** ensemble. Changez le filtre et le nombre change vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra in alto contiene **il titolo e un conteggio** insieme. Cambia il filtro e il numero cambia davvero."
          }
        }
      }
    },
    "상단 서랍(스크롤하면 접힘) ↔ 하단 툴바 캡슐. 목록과 데이터는 같습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top drawer (collapses on scroll) ↔ bottom toolbar capsule. The list and data are the same."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Top drawer (collapses on scroll) ↔ bottom toolbar capsule. The list and data are the same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部の引き出し（スクロールすると折りたたまれる）↔ 下部のツールバーのカプセル。リストとデータは同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단 서랍(스크롤하면 접힘) ↔ 하단 툴바 캡슐. 목록과 데이터는 같습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部抽屉（滚动时折叠）↔ 底部工具栏胶囊。列表和数据相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂部抽屜（滾動時摺疊）↔ 底部工具列膠囊。列表和資料相同。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верхняя выдвижная панель (сворачивается при прокрутке) ↔ капсула нижней панели инструментов. Список и данные те же."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cajón superior (se colapsa al desplazar) ↔ cápsula de la barra de herramientas inferior. La lista y los datos son los mismos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obere Schublade (klappt beim Scrollen zusammen) ↔ Kapsel der unteren Symbolleiste. Liste und Daten sind dieselben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiroir du haut (se replie au défilement) ↔ capsule de la barre d'outils du bas. La liste et les données sont les mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cassetto in alto (si comprime con lo scorrimento) ↔ capsula della barra degli strumenti in basso. L'elenco e i dati sono gli stessi."
          }
        }
      }
    },
