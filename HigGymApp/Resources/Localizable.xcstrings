          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto grande de acessibilidade ativado"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดตัวอักษรใหญ่สำหรับการช่วยการเข้าถึงอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bật chữ lớn của trợ năng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velký text přístupnosti je zapnutý"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stor tekst til tilgængelighed er slået til"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μεγάλο κείμενο προσβασιμότητας είναι ενεργό"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saavutettavuuden suuri teksti on päällä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks besar aksesibilitas menyala"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stor tekst for tilgjengelighet er slått på"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grote tekst voor toegankelijkheid staat aan"
          }
        }
      }
    },
    "접기는 시스템이 최소 터치 크기를 지키는 방식입니다. 막을 게 아니라 **순서를 설계**하면 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folding is how the system keeps minimum touch sizes. Don't block it, just **design the order**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Folding is how the system keeps minimum touch sizes. Don't block it, just **design the order**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみは、システムが最小タップサイズを守るための方法です。止めるのではなく**順番を設計**すればよいのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접기는 시스템이 최소 터치 크기를 지키는 방식입니다. 막을 게 아니라 **순서를 설계**하면 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠是系统守住最小触控尺寸的方式。不需要去阻止，只需**设计好顺序**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊是系統守住最小觸控尺寸的方式。不需要去阻止，只需**設計好順序**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сворачивание - способ, которым система сохраняет минимальные области касания. Не блокируйте его, а **продумайте порядок**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plegar es la forma en que el sistema mantiene los tamaños táctiles mínimos. No lo bloquees, **diseña el orden**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falten ist die Art, wie das System minimale Touch-Größen wahrt. Verhindere es nicht, **gestalte die Reihenfolge**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le repli est la façon dont le système préserve les tailles tactiles minimales. Ne le bloquez pas, **concevez simplement l'ordre**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripiegamento è il modo in cui il sistema mantiene le dimensioni minime del tocco. Non bloccarlo, **progetta l'ordine**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobrar é como o sistema mantém os tamanhos mínimos de toque. Não bloqueie, **projete a ordem**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การพับคือวิธีที่ระบบรักษาขนาดสัมผัสขั้นต่ำ อย่าขวางมัน แค่**ออกแบบลำดับ**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gập là cách hệ thống giữ kích thước chạm tối thiểu. Đừng chặn nó, chỉ cần **thiết kế thứ tự**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbalení je způsob, jak systém drží minimální velikosti dotyku. Neblokujte ho, jen **navrhněte pořadí**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenfoldning er den måde, systemet bevarer minimale berøringsstørrelser på. Bloker det ikke, **design bare rækkefølgen**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύμπτυξη είναι ο τρόπος με τον οποίο το σύστημα διατηρεί τα ελάχιστα μεγέθη αφής. Μην την εμποδίζεις, απλώς **σχεδίασε τη σειρά**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taittaminen on tapa, jolla järjestelmä pitää vähimmäiskosketuskoot. Älä estä sitä, **suunnittele vain järjestys**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Melipat adalah cara sistem menjaga ukuran sentuh minimum. Jangan blokir, cukup **rancang urutannya**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folding er hvordan systemet opprettholder minste berøringsstørrelser. Ikke blokker det, **design bare rekkefølgen**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inklappen is hoe het systeem minimale aanraakgroottes behoudt. Blokkeer het niet, **ontwerp** gewoon **de volgorde**."
          }
        }
      }
    },
    "접히는 순서는 선언 순서를 따릅니다, 자주 쓰는 것을 앞에 둬야 하는 이유입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items fold in declaration order, which is why frequently used ones should go first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Items fold in declaration order, which is why frequently used ones should go first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれる順番は宣言順に従います。よく使うものを前に置くべき理由です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접히는 순서는 선언 순서를 따릅니다, 자주 쓰는 것을 앞에 둬야 하는 이유입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠的顺序遵循声明顺序，这就是为什么常用的要放前面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊的順序遵循宣告順序，這就是為什麼常用的要放前面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы сворачиваются в порядке объявления, поэтому часто используемые нужно ставить первыми."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos se pliegan en el orden de declaración, por eso los de uso frecuente deben ir primero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemente falten sich in Deklarationsreihenfolge, deshalb sollten häufig genutzte zuerst stehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments se replient dans l'ordre de déclaration, c'est pourquoi les plus utilisés doivent venir en premier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi si ripiegano nell'ordine di dichiarazione, ed è per questo che quelli usati spesso devono venire per primi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens dobram na ordem de declaração, e é por isso que os mais usados devem ir primeiro."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการพับตามลำดับการประกาศ นั่นคือเหตุผลที่อันที่ใช้บ่อยควรมาก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục gập theo thứ tự khai báo, đó là lý do các mục dùng thường xuyên nên đứng đầu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Položky se sbalují v pořadí deklarace, proto by ty často používané měly jít první."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementer foldes i deklarationsrækkefølge, og derfor bør de hyppigt brugte stå først."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στοιχεία διπλώνουν με τη σειρά δήλωσης, γι' αυτό τα συχνά χρησιμοποιούμενα πρέπει να μπαίνουν πρώτα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteet taittuvat ilmoitusjärjestyksessä, minkä vuoksi usein käytettyjen pitäisi olla ensin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item terlipat menurut urutan deklarasi, itulah mengapa yang sering dipakai harus didahulukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementer foldes i deklarasjonsrekkefølge, og derfor bør de som brukes hyppig stå først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Items klappen in in volgorde van declaratie, daarom horen veelgebruikte eerst."
          }
        }
      }
    },
    "접힌 상태에서 검색을 눌러보세요. 읽는 중에도 검색만은 한 손에 닿습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Search while it's collapsed. Even while reading, Search stays within one-handed reach."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Search while it's collapsed. Even while reading, Search stays within one-handed reach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれた状態で検索をタップしてみてください。読んでいる間も、検索だけは片手で届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힌 상태에서 검색을 눌러보세요. 읽는 중에도 검색만은 한 손에 닿습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在折叠状态下点按搜索。即使在阅读中，搜索也依然单手可达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在摺疊狀態下輕點搜尋。即使在閱讀中，搜尋也依然單手可達。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Поиск» в свёрнутом виде. Даже во время чтения поиск остаётся под рукой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Buscar mientras está colapsada. Incluso mientras lees, Buscar sigue al alcance de una mano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Suchen, solange sie zusammengeklappt ist. Selbst beim Lesen bleibt die Suche in Einhandreichweite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Recherche quand elle est repliée. Même en lisant, la recherche reste à portée d'une main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Cerca mentre è compressa. Anche leggendo, Cerca resta a portata di una sola mano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Buscar enquanto está recolhido. Mesmo lendo, Buscar fica ao alcance de uma mão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะค้นหาขณะที่ยุบอยู่ แม้ขณะอ่าน การค้นหาก็ยังอยู่ในระยะเอื้อมมือเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm Tìm kiếm khi nó đang thu gọn. Ngay cả khi đang đọc, Tìm kiếm vẫn trong tầm một tay."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Hledat, když je sbalené. I při čtení zůstává Hledat v dosahu jedné ruky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Søg, mens den er sammenfoldet. Selv under læsning forbliver Søg inden for rækkevidde med én hånd."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε Αναζήτηση ενώ είναι συμπτυγμένη. Ακόμα και ενώ διαβάζεις, η Αναζήτηση μένει εντός εμβέλειας με το ένα χέρι."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Hakua sen ollessa tiivistettynä. Lukiessakin Haku pysyy yhden käden ulottuvilla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Cari saat diciutkan. Bahkan saat membaca, Cari tetap dalam jangkauan satu tangan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Søk mens det er kollapset. Selv mens du leser, forblir Søk innen rekkevidde for én hånd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Zoek terwijl het is ingeklapt. Ook tijdens het lezen blijft Zoek binnen bereik van één hand."
          }
        }
      }
    },
    "접힌 상태에서도 재생·일시정지는 그대로 눌립니다. 기능을 잃지 않고 자리만 줄입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when collapsed, play and pause still work. It takes up less room without losing any function."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when collapsed, play and pause still work. It takes up less room without losing any function."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれた状態でも、再生・一時停止はそのまま押せます。機能を失わずに場所だけを小さくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힌 상태에서도 재생·일시정지는 그대로 눌립니다. 기능을 잃지 않고 자리만 줄입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠状态下播放、暂停照样能点。不丢功能，只是缩小了占位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊狀態下播放、暫停照樣能點。不丟功能，只是縮小了佔位。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже в свёрнутом виде воспроизведение и пауза работают. Занимается меньше места, но функции не теряются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso colapsado, reproducir y pausar siguen funcionando. Ocupa menos sitio sin perder ninguna función."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch zusammengeklappt funktionieren Wiedergabe und Pause weiter. Es braucht weniger Platz, ohne eine Funktion zu verlieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même repliés, lecture et pause fonctionnent toujours. Il prend moins de place sans perdre aucune fonction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche compressi, riproduzione e pausa funzionano ancora. Occupa meno spazio senza perdere alcuna funzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo recolhidos, reproduzir e pausar ainda funcionam. Ocupa menos espaço sem perder nenhuma função."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้ยุบอยู่ เล่นและหยุดก็ยังทำงาน มันกินที่น้อยลงโดยไม่เสียฟังก์ชันใด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay cả khi thu gọn, phát và tạm dừng vẫn hoạt động. Nó chiếm ít chỗ hơn mà không mất chức năng nào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I sbalené fungují přehrání a pozastavení dál. Zabírá méně místa, aniž by ztratilo funkci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv sammenfoldet virker afspil og pause stadig. Det fylder mindre uden at miste nogen funktion."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμα και συμπτυγμένο, η αναπαραγωγή και η παύση λειτουργούν. Καταλαμβάνει λιγότερο χώρο χωρίς να χάνει καμία λειτουργία."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiivistettynäkin toisto ja tauko toimivat. Se vie vähemmän tilaa menettämättä yhtään toimintoa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahkan saat diciutkan, putar dan jeda tetap berfungsi. Ia memakai lebih sedikit ruang tanpa kehilangan fungsi apa pun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv når det er kollapset, fungerer avspilling og pause fortsatt. Det tar mindre plass uten å miste noen funksjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook ingeklapt werken afspelen en pauzeren nog. Het neemt minder ruimte in zonder functies te verliezen."
          }
        }
      }
    },
    "접힌 상태에서도 탭은 그대로 눌립니다. 사라지는 게 아니라 **작아지는** 것입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when collapsed, the tabs still respond. They don't disappear, they **get smaller**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when collapsed, the tabs still respond. They don't disappear, they **get smaller**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれた状態でも、タブはそのまま押せます。消えるのではなく**小さくなる**のです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힌 상태에서도 탭은 그대로 눌립니다. 사라지는 게 아니라 **작아지는** 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠状态下标签照样能点。它不是消失，而是**变小**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊狀態下標籤照樣能點。它不是消失，而是**變小**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже в свёрнутом виде вкладки откликаются. Они не исчезают, а **уменьшаются**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso colapsadas, las pestañas siguen respondiendo. No desaparecen, **se hacen más pequeñas**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch zusammengeklappt reagieren die Tabs weiter. Sie verschwinden nicht, sie **werden kleiner**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même repliés, les onglets répondent toujours. Ils ne disparaissent pas, ils **rapetissent**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche compresse, le schede rispondono ancora. Non spariscono, **si rimpiccioliscono**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo recolhidas, as abas ainda respondem. Elas não desaparecem, **ficam menores**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้ยุบอยู่ แท็บก็ยังตอบสนอง มันไม่ได้หายไป แต่**เล็กลง**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay cả khi thu gọn, các tab vẫn phản hồi. Chúng không biến mất, chúng **nhỏ lại**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I sbalené karty dál reagují. Nemizí, **zmenšují se**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv sammenfoldet reagerer fanerne stadig. De forsvinder ikke, de **bliver mindre**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμα και συμπτυγμένες, οι καρτέλες ανταποκρίνονται. Δεν εξαφανίζονται, **μικραίνουν**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiivistettynäkin välilehdet reagoivat. Ne eivät katoa, ne **pienenevät**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahkan saat diciutkan, tab tetap merespons. Mereka tidak hilang, mereka **menjadi lebih kecil**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv når det er kollapset, reagerer fanene fortsatt. De forsvinner ikke, de **blir mindre**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook ingeklapt reageren de tabbladen nog. Ze verdwijnen niet, ze **worden kleiner**."
          }
        }
      }
    },
    "접힐 때 액세서리가 사라지지 않고 **탭바 자리로 승격**됩니다, “이동 < 상태”라는 우선순위 역전을 시스템이 자동 처리합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it collapses, the accessory doesn't disappear. It's **promoted into the tab bar's spot**, and the system handles the priority flip (“navigation < status”) for you."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When it collapses, the accessory doesn't disappear. It's **promoted into the tab bar's spot**, and the system handles the priority flip (“navigation < status”) for you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれるとき、アクセサリは消えずに**タブバーの位置へ昇格**します。「移動 < 状態」という優先順位の逆転をシステムが自動で処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힐 때 액세서리가 사라지지 않고 **탭바 자리로 승격**됩니다, “이동 < 상태”라는 우선순위 역전을 시스템이 자동 처리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠时附件不会消失，而是**升级到标签栏的位置**，“导航 < 状态”的优先级反转由系统自动处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊時附件不會消失，而是**升級到標籤列的位置**，「導覽 < 狀態」的優先順序反轉由系統自動處理。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При сворачивании accessory не исчезает. Он **повышается до места панели вкладок**, а переворот приоритета («навигация < состояние») система выполняет сама."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se colapsa, el accesorio no desaparece. **Sube al sitio de la barra de pestañas**, y el sistema se ocupa de invertir la prioridad («navegación < estado») por ti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Zusammenklappen verschwindet das Accessory nicht. Es **rückt an den Platz der Tab-Leiste auf**, und das System übernimmt die Prioritätsumkehr („Navigation < Status“) für dich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand elle se replie, l'accessoire ne disparaît pas. Il est **promu à la place de la barre d'onglets**, et le système gère pour vous l'inversion de priorité (« navigation < état »)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando si comprime, l'accessorio non sparisce. Viene **promosso al posto della barra delle schede**, e il sistema gestisce per te il ribaltamento di priorità («navigazione < stato»)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando recolhe, o acessório não desaparece. Ele é **promovido ao lugar da barra de abas**, e o sistema cuida da inversão de prioridade («navegação < estado») para você."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมันยุบ อุปกรณ์เสริมไม่ได้หายไป แต่ **ถูกเลื่อนขึ้นไปอยู่ในตำแหน่งของแถบแท็บ** และระบบจัดการการสลับลำดับความสำคัญ (“การนำทาง < สถานะ”) ให้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi nó thu gọn, phụ kiện không biến mất. Nó **được đưa lên vị trí của thanh tab**, và hệ thống lo việc đảo ưu tiên (“điều hướng < trạng thái”) cho bạn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se sbalí, příslušenství nezmizí. **Povýší do místa panelu karet** a systém za vás vyřeší přehození priority („navigace < stav“)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det folder sig sammen, forsvinder tilbehøret ikke. Det **rykker op på fanelinjens plads**, og systemet håndterer prioritetsskiftet (»navigation < status«) for dig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν συμπτύσσεται, το εξάρτημα δεν εξαφανίζεται. **Προάγεται στη θέση της γραμμής καρτελών**, και το σύστημα χειρίζεται για σένα την αντιστροφή προτεραιότητας («πλοήγηση < κατάσταση»)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun se tiivistyy, accessory ei katoa. Se **ylennetään välilehtipalkin paikalle**, ja järjestelmä hoitaa prioriteettien käänteisen (”navigointi < tila”) puolestasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ia menciut, accessory tidak hilang. Ia **dinaikkan ke tempat bilah tab**, dan sistem menangani pembalikan prioritas (\"navigasi < status\") untukmu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når den kollapser, forsvinner ikke accessoryen. Den **løftes inn på fanelinjens plass**, og systemet håndterer prioritetsvendingen («navigasjon < status») for deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als hij inklapt, verdwijnt het accessoire niet. Het wordt **gepromoveerd naar de plek van de tabbalk**, en het systeem regelt de prioriteitsomslag (\"navigatie < status\") voor je."
          }
        }
      }
    },
    "정답": {
      "localizations": {
        "en": {
          "stringUnit": {
