    "도구(보기·정렬)는 왼쪽 묶음으로, 파괴적 액션은 오른쪽 메뉴 안으로 갈라졌습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools (view, sort) split off into the left group, and the destructive action went inside the right menu."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools (view, sort) split off into the left group, and the destructive action went inside the right menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール（表示・並べ替え）は左のまとまりへ、破壊的なアクションは右のメニューの中へ分かれました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구(보기·정렬)는 왼쪽 묶음으로, 파괴적 액션은 오른쪽 메뉴 안으로 갈라졌습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具（视图、排序）归到左侧一组，破坏性操作进入右侧菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具（檢視、排序）歸到左側一組，破壞性操作進入右側選單。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты (вид, сортировка) ушли в левую группу, а разрушительное действие - внутрь правого меню."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas (vista, orden) pasaron al grupo izquierdo y la acción destructiva se metió en el menú derecho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkzeuge (Ansicht, Sortierung) wurden in die linke Gruppe ausgelagert, und die destruktive Aktion wanderte in das rechte Menü."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils (affichage, tri) sont passés dans le groupe de gauche, et l'action destructive est allée dans le menu de droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti (vista, ordinamento) sono passati al gruppo di sinistra, e l'azione distruttiva è andata dentro il menu di destra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas (visualização, ordenar) foram separadas no grupo da esquerda, e a ação destrutiva foi para dentro do menu da direita."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือ (มุมมอง, เรียงลำดับ) แยกไปอยู่กลุ่มซ้าย และการกระทำที่ทำลายข้อมูลไปอยู่ในเมนูขวา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ (xem, sắp xếp) tách sang nhóm bên trái, và hành động phá hủy nằm trong menu bên phải."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nástroje (zobrazení, řazení) se oddělily do levé skupiny a destruktivní akce šla do pravé nabídky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Værktøjer (visning, sortering) blev delt ud i venstre gruppe, og den destruktive handling kom ind i højre menu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα εργαλεία (προβολή, ταξινόμηση) χωρίστηκαν στην αριστερή ομάδα και η καταστροφική ενέργεια μπήκε μέσα στο δεξί μενού."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalut (näkymä, lajittelu) siirtyivät vasempaan ryhmään, ja tuhoava toiminto meni oikean valikon sisään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat (tampilan, urutkan) dipisah ke grup kiri, dan aksi destruktif masuk ke menu kanan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktøy (visning, sortering) ble skilt ut i venstre gruppe, og den destruktive handlingen havnet i høyre meny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gereedschap (weergave, sorteren) is afgesplitst naar de linkergroep, en de destructieve actie ging in het rechtermenu."
          }
        }
      }
    },
    "도구는 왼쪽 묶음, 삭제는 메뉴 안 맨 아래.": {
