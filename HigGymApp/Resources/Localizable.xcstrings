    "그때는 왜 맞아 보였는지까지 읽습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Including why each one seemed right at the time"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Including why each one seemed right at the time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
