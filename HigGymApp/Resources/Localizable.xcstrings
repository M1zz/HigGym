    "전체를 덮는 화면일수록 어디서 왔는지가 중요해집니다, zoom이 특히 값을 하는 이유입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The more of the screen it covers, the more it matters where it came from. That's why zoom is especially worth it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The more of the screen it covers, the more it matters where it came from. That's why zoom is especially worth it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面全体を覆うほど、どこから来たかが重要になります。zoomが特に効く理由です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체를 덮는 화면일수록 어디서 왔는지가 중요해집니다, zoom이 특히 값을 하는 이유입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "越是覆盖整个屏幕的界面，来源就越重要，这正是 zoom 特别有价值的原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "越是覆蓋整個螢幕的介面，來源就越重要，這正是 zoom 特別有價值的原因。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем больше экран закрывает, тем важнее, откуда он пришёл. Поэтому zoom особенно ценен."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más de la pantalla cubre, más importa de dónde viene. Por eso zoom merece especialmente la pena."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mehr vom Bildschirm es abdeckt, desto wichtiger ist, woher es kam. Deshalb lohnt sich zoom besonders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus il recouvre d'écran, plus son origine compte. C'est pourquoi le zoom vaut particulièrement la peine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più schermo copre, più conta da dove arriva. Per questo lo zoom vale particolarmente la pena."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais da tela ela cobre, mais importa de onde veio. Por isso o zoom vale especialmente a pena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยิ่งคลุมหน้าจอมาก ที่มาของมันก็ยิ่งสำคัญ นั่นคือเหตุผลที่ zoom คุ้มเป็นพิเศษ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó che phủ càng nhiều màn hình thì nguồn gốc của nó càng quan trọng. Đó là lý do zoom đặc biệt đáng giá."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čím víc obrazovky zakrývá, tím víc záleží na tom, odkud přišel. Proto má zoom obzvlášť smysl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo mere af skærmen det dækker, jo mere betyder det, hvor det kom fra. Derfor er zoom særligt umagen værd."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο περισσότερο της οθόνης καλύπτει, τόσο περισσότερο μετράει από πού ήρθε. Γι' αυτό το zoom αξίζει ιδιαίτερα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä enemmän näytöstä se peittää, sitä enemmän merkitsee, mistä se tuli. Siksi zoom on erityisen arvokas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakin banyak layar yang ditutupinya, semakin penting dari mana ia berasal. Itulah mengapa zoom sangat berharga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo mer av skjermen det dekker, desto viktigere er det hvor det kom fra. Derfor er zoom spesielt verdt det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe meer van het scherm het bedekt, hoe belangrijker het is waar het vandaan komt. Daarom is zoom extra de moeite waard."
          }
        }
      }
    },
