    "결정 하나하나에 이유를 대는 디자이너로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a reason behind every design call"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a reason behind every design call"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデザイン判断に、理由を持てる人へ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成为每个决定都能讲出理由的设计师"
          }
        },
        "zh-Hant": {
