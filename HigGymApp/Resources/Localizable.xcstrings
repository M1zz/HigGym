            "state": "translated",
            "value": "วางปุ่มค้นหาไว้ในอุปกรณ์เสริมด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt nút tìm kiếm vào phụ kiện phía dưới"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dát tlačítko hledání do spodního příslušenství"
          }
        },
        "da": {
