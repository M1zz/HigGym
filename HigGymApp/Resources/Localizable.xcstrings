    "고정 폭·한 줄 고정입니다. Dynamic Type을 키우면 **글자가 잘려 뜻이 사라집니다**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed width, locked to one line. Increase Dynamic Type and **the text gets cut off and loses its meaning**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed width, locked to one line. Increase Dynamic Type and **the text gets cut off and loses its meaning**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定幅・1行固定です。Dynamic Typeを大きくすると**文字が切れて意味が失われます**。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정 폭·한 줄 고정입니다. Dynamic Type을 키우면 **글자가 잘려 뜻이 사라집니다**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定宽度、固定一行。放大 Dynamic Type 后，**文字被截断，意思就消失了**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定寬度、固定一行。放大 Dynamic Type 後，**文字被截斷，意思就消失了**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фиксированная ширина, зафиксировано в одну строку. Увеличьте Dynamic Type, и **текст обрежется и потеряет смысл**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancho fijo, bloqueado a una línea. Aumenta Dynamic Type y **el texto se corta y pierde su sentido**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Breite, auf eine Zeile festgelegt. Erhöhe Dynamic Type, und **der Text wird abgeschnitten und verliert seinen Sinn**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur fixe, verrouillée sur une ligne. Augmentez Dynamic Type et **le texte est coupé et perd son sens**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Larghezza fissa, bloccata su una riga. Aumenta Dynamic Type e **il testo viene tagliato e perde significato**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura fixa, travada em uma linha. Aumente o Dynamic Type e **o texto é cortado e perde o sentido**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความกว้างคงที่ ล็อกไว้บรรทัดเดียว เพิ่ม Dynamic Type แล้ว**ข้อความจะถูกตัดและสูญเสียความหมาย**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ rộng cố định, khóa ở một dòng. Tăng Dynamic Type và **văn bản bị cắt và mất nghĩa**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pevná šířka, zamčená na jeden řádek. Zvětšete Dynamic Type a **text se ořízne a ztratí smysl**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast bredde, låst til én linje. Hæv Dynamic Type, og **teksten bliver skåret af og mister sin betydning**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σταθερό πλάτος, κλειδωμένο σε μία γραμμή. Αύξησε το Dynamic Type και **το κείμενο κόβεται και χάνει το νόημά του**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinteä leveys, lukittu yhteen riviin. Suurenna Dynamic Typea, niin **teksti leikkautuu ja menettää merkityksensä**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar tetap, dikunci pada satu baris. Perbesar Dynamic Type dan **teks terpotong dan kehilangan maknanya**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast bredde, låst til én linje. Øk Dynamic Type, og **teksten kuttes og mister meningen**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaste breedte, vergrendeld op één regel. Zet Dynamic Type hoger en **de tekst wordt afgekapt en verliest zijn betekenis**."
          }
        }
      }
    },
