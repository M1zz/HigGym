        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버"
          }
        }
      }
    },
    "전체 화면 커버는 쓸어내려 닫히지 않는다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe down"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーは下にスワイプしても閉じない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 쓸어내려 닫히지 않는다"
          }
        }
      }
    },
    "전체 화면 커버는 쓸어내려 닫히지 않는다, 출구는 직접 만들어야 한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe down, so you have to build the exit yourself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーは下にスワイプしても閉じない。出口は自分でつくる必要がある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 쓸어내려 닫히지 않는다, 출구는 직접 만들어야 한다"
          }
        }
      }
    },
    "전체 화면 커버는 일부러 스와이프로 닫히지 않으므로, 출구를 직접 만들어야 한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover deliberately doesn't close with a swipe, so you have to build the exit yourself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーはあえてスワイプで閉じないので、出口を自分でつくる必要がある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 일부러 스와이프로 닫히지 않으므로, 출구를 직접 만들어야 한다"
          }
        }
      }
    },
    "전체 화면 커버는 일부러 쓸어내려 닫히지 않는다. 작성 중인 글을 지키는 대신 출구를 만들 의무가 따라온다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover deliberately doesn't close with a swipe down. Protecting the draft comes with an obligation to build a way out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーはあえて下にスワイプしても閉じない。書きかけの文章を守る代わりに、出口をつくる義務がついてくる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 일부러 쓸어내려 닫히지 않는다. 작성 중인 글을 지키는 대신 출구를 만들 의무가 따라온다."
          }
        }
      }
    },
    "전체 화면 커버는 제스처 닫기가 없는 **강한 모달**입니다. 온보딩·로그인·카메라처럼 “끝내거나 명시적으로 나가라”가 맞는 흐름에만 쓰세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover is a **strong modal** with no gesture to dismiss. Use it only for flows where “finish or leave explicitly” is right, like onboarding, sign-in or the camera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーはジェスチャーで閉じられない**強いモーダル**です。オンボーディング、ログイン、カメラのように「終えるか、明示的に出るか」が正しいフローにだけ使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 제스처 닫기가 없는 **강한 모달**입니다. 온보딩·로그인·카메라처럼 “끝내거나 명시적으로 나가라”가 맞는 흐름에만 쓰세요."
          }
        }
      }
    },
    "전체 화면 편집기에 출구를 직접 만들었다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built an exit into the full-screen editor ourselves."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンのエディタに出口を自分でつくった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 편집기에 출구를 직접 만들었다."
          }
        }
      }
    },
    "전체 화면으로 실행": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run full screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンで実行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면으로 실행"
          }
        }
      }
    },
    "전체 화면으로 편집하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit in full screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンで編集"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면으로 편집하기"
          }
        }
      }
    },
    "전체를 덮는 화면일수록 어디서 왔는지가 중요해집니다, zoom이 특히 값을 하는 이유입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The more of the screen it covers, the more it matters where it came from. That's why zoom is especially worth it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面全体を覆うほど、どこから来たかが重要になります。zoomが特に効く理由です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체를 덮는 화면일수록 어디서 왔는지가 중요해집니다, zoom이 특히 값을 하는 이유입니다."
          }
        }
      }
    },
    "전환": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transition"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジション"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환"
          }
        }
      }
    },
    "전환 출처": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transition source"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジションの起点"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환 출처"
          }
        }
      }
    },
    "전환의 출처가 되는 요소. 탭한 것과 열린 것이 같음을 모션으로 증명할 대상입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The element a transition starts from. Motion proves that what you tapped and what opened are the same thing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランジションの起点となる要素。タップしたものと開いたものが同じだと、モーションで示す対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환의 출처가 되는 요소. 탭한 것과 열린 것이 같음을 모션으로 증명할 대상입니다."
          }
        }
      }
    },
    "절반 높이는 **“원본과의 대화”** 은유입니다, 화면을 나눠 가짐으로써 시트가 배경 콘텐츠에 대한 것임을 형태로 말합니다.\n\n훑어보기와 집중이 둘 다 필요하면 `[.medium, .large]` 콤보로 높이 선택권을 사용자에게 넘기는 것이 더 좋습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half height is a metaphor for **“a conversation with the original.”** By sharing the screen, the sheet shows through its shape that it's about the content behind it.\n\nIf people need both skimming and focus, it's better to hand them the choice of height with the `[.medium, .large]` combo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分の高さは「**元の画面との対話**」の比喩です。画面を分け合うことで、シートが背景のコンテンツについてのものだと形で伝えます。\n\n流し見と集中の両方が必要なら、`[.medium, .large]` の組み合わせで高さの選択をユーザーに委ねるほうがよいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절반 높이는 **“원본과의 대화”** 은유입니다, 화면을 나눠 가짐으로써 시트가 배경 콘텐츠에 대한 것임을 형태로 말합니다.\n\n훑어보기와 집중이 둘 다 필요하면 `[.medium, .large]` 콤보로 높이 선택권을 사용자에게 넘기는 것이 더 좋습니다."
          }
        }
      }
    },
    "절반 높이는 **“원본과의 대화”** 은유입니다, 화면을 나눠 가짐으로써 이 시트가 배경 콘텐츠에 대한 것임을 형태로 말합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half height is a metaphor for **“a conversation with the original.”** By sharing the screen, this sheet shows through its shape that it's about the content behind it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分の高さは「**元の画面との対話**」の比喩です。画面を分け合うことで、このシートが背景のコンテンツについてのものだと形で伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절반 높이는 **“원본과의 대화”** 은유입니다, 화면을 나눠 가짐으로써 이 시트가 배경 콘텐츠에 대한 것임을 형태로 말합니다."
          }
        }
      }
    },
    "절반 높이에서 멈춥니다, 뒤 화면의 위쪽 절반이 계속 보입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stops at half height, and the top half of the screen behind stays visible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分の高さで止まり、後ろの画面の上半分が見えたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절반 높이에서 멈춥니다, 뒤 화면의 위쪽 절반이 계속 보입니다."
          }
        }
      }
    },
    "절반 이하로 줄여야 들어간다면 축소가 아니라 **설계 문제**입니다. 폭을 늘리거나 표기 자체를 줄이세요(1,234,000 → 1.2M). 잘림·축소는 안전장치이지 레이아웃 수단이 아닙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it only fits when shrunk to half size or less, that's not a scaling issue but a **design problem**. Widen the space or shorten the format itself (1,234,000 → 1.2M). Truncation and scaling are a safety net, not a layout tool."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半分以下に縮めないと収まらないなら、それは縮小ではなく**設計の問題**です。幅を広げるか、表記そのものを短くしてください（1,234,000 → 1.2M）。切り詰めと縮小は安全装置であって、レイアウトの手段ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절반 이하로 줄여야 들어간다면 축소가 아니라 **설계 문제**입니다. 폭을 늘리거나 표기 자체를 줄이세요(1,234,000 → 1.2M). 잘림·축소는 안전장치이지 레이아웃 수단이 아닙니다."
          }
        }
      }
    },
    "점심 어때요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunch today?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お昼どうですか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점심 어때요"
          }
        }
      }
    },
