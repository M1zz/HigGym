    "손이 먼저 간 자리는 어디였나요? 삭제와 얼마나 가까웠나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did your hand go first? How close was it to Delete?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did your hand go first? How close was it to Delete?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手が最初に向かったのはどこでしたか？削除とどれくらい近かったですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손이 먼저 간 자리는 어디였나요? 삭제와 얼마나 가까웠나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手最先伸向哪里？离删除有多近？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手最先伸向哪裡？離刪除有多近？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда рука потянулась в первую очередь? Насколько близко это было к «Удалить»?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Adónde fue primero tu mano? ¿A qué distancia estaba de Eliminar?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin ging deine Hand zuerst? Wie nah war sie an Löschen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où est allée votre main en premier ? À quelle distance de Supprimer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove è andata prima la tua mano? Quanto era vicina a Elimina?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para onde sua mão foi primeiro? Quão perto ela estava de Excluir?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือของคุณไปที่ไหนก่อน ใกล้ลบแค่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tay bạn đã đi đâu trước tiên? Nó gần Xóa đến mức nào?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kam šla vaše ruka nejdřív? Jak blízko byla ke Smazat?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor gik din hånd først hen? Hvor tæt var den på Slet?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πού πήγε πρώτα το χέρι σου; Πόσο κοντά ήταν στη Διαγραφή;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Minne kätesi meni ensin? Kuinka lähellä se oli Poistoa?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke mana tanganmu pergi lebih dulu? Seberapa dekat dengan Hapus?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor gikk hånden din først? Hvor nær var den Slett?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar ging je hand als eerste heen? Hoe dicht was dat bij Verwijder?"
          }
        }
      }
    },
    "손이 화면 위쪽까지 올라가야 한다는 점을 1.4.1과 비교해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with 1.4.1: your hand has to travel up to the top of the screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare with 1.4.1: your hand has to travel up to the top of the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手が画面の上のほうまで伸びなければならない点を、1.4.1と比べてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손이 화면 위쪽까지 올라가야 한다는 점을 1.4.1과 비교해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请与 1.4.1 比较：手必须抬到屏幕上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請與 1.4.1 比較：手必須抬到螢幕上方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравните с 1.4.1: руке приходится подниматься в верхнюю часть экрана."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compáralo con 1.4.1: tu mano tiene que subir hasta lo alto de la pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche mit 1.4.1: Deine Hand muss bis nach oben auf den Bildschirm wandern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez avec 1.4.1 : votre main doit monter tout en haut de l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta con 1.4.1: la tua mano deve arrivare fino in cima allo schermo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare com 1.4.1: sua mão precisa subir até o topo da tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปรียบเทียบกับ 1.4.1: มือของคุณต้องเอื้อมขึ้นไปบนสุดของหน้าจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "So sánh với 1.4.1: tay bạn phải vươn lên tận đầu màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnejte s 1.4.1: vaše ruka musí cestovat až nahoru na obrazovku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenlign med 1.4.1: din hånd skal rejse helt op til toppen af skærmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύγκρινε με το 1.4.1: το χέρι σου πρέπει να ταξιδέψει μέχρι την κορυφή της οθόνης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaa kohtaan 1.4.1: kätesi joutuu matkaamaan näytön yläreunaan asti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingkan dengan 1.4.1: tanganmu harus bergerak naik ke bagian atas layar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenlign med 1.4.1: hånden din må bevege seg opp til toppen av skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk met 1.4.1: je hand moet helemaal naar de bovenkant van het scherm reizen."
          }
        }
      }
    },
