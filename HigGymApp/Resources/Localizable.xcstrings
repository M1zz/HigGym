    "금액 불일치, 표시 ₩%@ / 청구 ₩%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount mismatch: shown ₩%@ / charged ₩%@"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount mismatch: shown ₩%@ / charged ₩%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額の不一致：表示 ₩%@ / 請求 ₩%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "금액 불일치, 표시 ₩%1$@ / 청구 ₩%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额不一致，显示 ¥%1$@ / 扣款 ¥%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金額不一致，顯示 NT$%1$@ / 扣款 NT$%2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммы расходятся: показано %1$@ ₽ / списано %2$@ ₽"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
