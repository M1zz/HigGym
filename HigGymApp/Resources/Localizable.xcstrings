    },
    "아래에서 올라오는 기본 모션은 OS 전역에서 동일해 “내리면 닫힌다”를 즉시 예측하게 합니다. 예측 가능성이 이 전환의 가치입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The standard slide-up motion is the same across the whole OS, so people instantly predict “swipe down to close.” Predictability is what this transition is worth."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The standard slide-up motion is the same across the whole OS, so people instantly predict “swipe down to close.” Predictability is what this transition is worth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下から上がってくる標準のモーションはOS全体で共通なので、「下ろせば閉じる」とすぐに予測できます。予測しやすさこそ、この遷移の価値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 올라오는 기본 모션은 OS 전역에서 동일해 “내리면 닫힌다”를 즉시 예측하게 합니다. 예측 가능성이 이 전환의 가치입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从下方升起的默认动效在整个系统里都一样，能让人立刻预判“往下拉就会关闭”。可预测性就是这种转场的价值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從下方升起的預設動效在整個系統裡都一樣，能讓人立刻預判「往下拉就會關閉」。可預測性就是這種轉場的價值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартное выезжание снизу одинаково во всей ОС, поэтому люди мгновенно предсказывают «смахнуть вниз - закрыть». Предсказуемость - вот ценность этого перехода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El movimiento estándar de deslizar hacia arriba es el mismo en todo el sistema operativo, así que la gente predice al instante «deslizar hacia abajo para cerrar». La previsibilidad es lo que vale esta transición."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die standardmäßige Hochgleit-Bewegung ist im ganzen Betriebssystem gleich, daher sagen Menschen sofort voraus: „Nach unten wischen zum Schließen.“ Vorhersagbarkeit ist es, was dieser Übergang wert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mouvement standard qui glisse vers le haut est le même dans tout le système, donc les gens prédisent aussitôt « balayer vers le bas pour fermer ». La prévisibilité est ce que vaut cette transition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il movimento standard di salita è lo stesso in tutto il sistema operativo, quindi le persone prevedono subito «scorri verso il basso per chiudere». La prevedibilità è ciò che vale questa transizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O movimento padrão de subir é o mesmo em todo o sistema operacional, então as pessoas preveem na hora «deslize para baixo para fechar». Previsibilidade é o que essa transição vale."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเลื่อนขึ้นมาตรฐานเหมือนกันทั่วทั้ง OS คนจึงคาดเดาได้ทันทีว่า “ปัดลงเพื่อปิด” ความคาดเดาได้คือคุณค่าของทรานซิชันนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển động trượt lên chuẩn giống nhau trên toàn bộ hệ điều hành, nên người ta lập tức đoán được “vuốt xuống để đóng.” Khả năng dự đoán là giá trị của kiểu chuyển cảnh này."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardní pohyb vyjetí zespodu je stejný v celém OS, takže lidé okamžitě předpokládají „přejeď dolů pro zavření“. Předvídatelnost je to, co tento přechod stojí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardbevægelsen op nedefra er den samme i hele OS, så folk forudsiger straks »stryg nedad for at lukke.« Forudsigelighed er det, denne overgang er værd."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η τυπική κίνηση ανεβάσματος είναι ίδια σε όλο το λειτουργικό, οπότε οι άνθρωποι προβλέπουν αμέσως «σύρε προς τα κάτω για κλείσιμο». Η προβλεψιμότητα είναι η αξία αυτής της μετάβασης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavallinen ylös liukuva liike on sama koko käyttöjärjestelmässä, joten ihmiset ennakoivat heti ”pyyhkäise alas sulkeaksesi”. Ennustettavuus on tämän siirtymän arvo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerakan meluncur naik standar sama di seluruh OS, jadi orang langsung memperkirakan \"usap ke bawah untuk menutup.\" Keterprediksian adalah nilai transisi ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardbevegelsen oppover er den samme i hele OS-et, så folk forutser umiddelbart «sveip ned for å lukke». Forutsigbarhet er det denne overgangen er verdt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De standaard omhoogschuivende beweging is in het hele OS hetzelfde, dus mensen voorspellen meteen \"veeg omlaag om te sluiten\". Voorspelbaarheid is wat deze overgang waard is."
          }
        }
      }
    },
    "아이콘 없이 텍스트만": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text only, no icon"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Text only, no icon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンなし、テキストのみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 없이 텍스트만"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有图标，只有文字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有圖示，只有文字"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только текст, без значка"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo texto, sin icono"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Text, kein Symbol"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte seul, sans icône"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo testo, nessuna icona"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só texto, sem ícone"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความอย่างเดียว ไม่มีไอคอน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có chữ, không có biểu tượng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen text, žádná ikona"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tekst, intet ikon"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο κείμενο, χωρίς εικονίδιο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain teksti, ei kuvaketta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya teks, tanpa ikon"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare tekst, ingen ikon"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen tekst, geen icoon"
          }
        }
      }
    },
    "아이콘은 빠른 스캔용, 제목은 의미 확정용, 두 채널을 함께 줘야 학습 없이 읽힙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icons are for quick scanning, titles pin down the meaning. Give both channels and people can read it without learning."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Icons are for quick scanning, titles pin down the meaning. Give both channels and people can read it without learning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンは素早く見渡すため、タイトルは意味を確定するため。2つのチャンネルを一緒に示してこそ、覚えなくても読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘은 빠른 스캔용, 제목은 의미 확정용, 두 채널을 함께 줘야 학습 없이 읽힙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图标用于快速扫视，标题用于确定含义，两个通道一起给，才能不用学习就读懂。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖示用於快速掃視，標題用於確定含義，兩個通道一起給，才能不用學習就讀懂。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значки нужны для быстрого просмотра, заголовки закрепляют смысл. Дайте оба канала, и люди прочтут без обучения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los iconos sirven para escanear rápido, los títulos fijan el significado. Da los dos canales y la gente puede leerlo sin aprender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbole dienen dem schnellen Überfliegen, Titel legen die Bedeutung fest. Biete beide Kanäle, und Menschen können es ohne Lernen lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les icônes servent à parcourir vite, les titres fixent le sens. Donnez les deux canaux et les gens peuvent lire sans apprendre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le icone servono per una scansione rapida, i titoli fissano il significato. Dai entrambi i canali e le persone leggono senza dover imparare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ícones servem para varredura rápida, títulos fixam o significado. Dê os dois canais e as pessoas leem sem precisar aprender."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไอคอนไว้ไล่ดูเร็ว ชื่อไว้ตรึงความหมาย ให้ทั้งสองช่องทาง คนก็อ่านได้โดยไม่ต้องเรียนรู้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu tượng để lướt nhanh, tiêu đề chốt ý nghĩa. Cho cả hai kênh và người ta đọc được mà không cần học."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikony slouží k rychlému přehlédnutí, nadpisy zpřesňují význam. Dejte oba kanály a lidé to přečtou bez učení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikoner er til hurtig skimning, titler fastlåser betydningen. Giv begge kanaler, og folk kan læse det uden at lære noget."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα εικονίδια είναι για γρήγορη σάρωση, οι τίτλοι καθηλώνουν το νόημα. Δώσε και τα δύο κανάλια και οι άνθρωποι το διαβάζουν χωρίς να μάθουν τίποτα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvakkeet ovat nopeaan silmäilyyn, otsikot kiinnittävät merkityksen. Anna molemmat kanavat, niin ihmiset voivat lukea sen oppimatta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon untuk menyisir cepat, judul memastikan makna. Berikan kedua kanal dan orang bisa membacanya tanpa belajar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikoner er for rask skanning, titler fester meningen. Gi begge kanaler, og folk kan lese det uten å lære."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iconen zijn voor snel scannen, titels leggen de betekenis vast. Geef beide kanalen en mensen kunnen het lezen zonder het te leren."
          }
        }
      }
    },
    "아이템 개수는 같습니다. **순서만** 다릅니다, 저장이 앞이냐 뒤냐.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same number of items. **Only the order** differs: whether Save comes first or last."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Same number of items. **Only the order** differs: whether Save comes first or last."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイテムの数は同じです。違うのは**順番だけ**、保存が前か後ろかです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이템 개수는 같습니다. **순서만** 다릅니다, 저장이 앞이냐 뒤냐."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目数量相同，**只有顺序**不同：存储在前还是在后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目數量相同，**只有順序**不同：儲存在前還是在後。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То же число элементов. Различается **только порядок**: «Сохранить» первым или последним."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismo número de elementos. **Solo cambia el orden**: si Guardar va primero o último."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleich viele Elemente. **Nur die Reihenfolge** unterscheidet sich: ob Sichern zuerst oder zuletzt kommt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même nombre d'éléments. **Seul l'ordre** diffère : Enregistrer en premier ou en dernier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stesso numero di elementi. **Cambia solo l'ordine**: se Salva viene per primo o per ultimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo número de itens. **Só a ordem** muda: se Salvar vem primeiro ou por último."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนรายการเท่ากัน **ต่างกันแค่ลำดับ**: บันทึกมาก่อนหรือมาทีหลัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng số mục. **Chỉ thứ tự** khác: Lưu đứng đầu hay đứng cuối."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stejný počet položek. Liší se **jen pořadí**: zda je Uložit první, nebo poslední."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samme antal elementer. **Kun rækkefølgen** er forskellig: om Gem kommer først eller sidst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ίδιος αριθμός στοιχείων. **Μόνο η σειρά** διαφέρει: αν η Αποθήκευση έρχεται πρώτη ή τελευταία."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama määrä kohteita. **Vain järjestys** eroaa: onko Tallenna ensin vai viimeisenä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah item sama. **Hanya urutannya** yang berbeda: apakah Simpan pertama atau terakhir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Like mange elementer. **Bare rekkefølgen** er forskjellig: om Lagre kommer først eller sist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Evenveel items. **Alleen de volgorde** verschilt: of Bewaar eerst of laatst komt."
          }
        }
      }
    },
    "아이템 다섯 개가 이미 오른쪽을 가득 채웠습니다. 제목을 길게 바꿔보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five items already fill up the right side. Try making the title longer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Five items already fill up the right side. Try making the title longer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5つのアイテムがすでに右側を埋めています。タイトルを長くしてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이템 다섯 개가 이미 오른쪽을 가득 채웠습니다. 제목을 길게 바꿔보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五个项目已经占满了右侧。试试把标题改长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五個項目已經佔滿了右側。試試把標題改長。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять элементов уже заполнили всю правую сторону. Попробуйте сделать заголовок длиннее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco elementos ya llenan el lado derecho. Prueba a alargar el título."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Elemente füllen die rechte Seite bereits. Versuche, den Titel länger zu machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq éléments remplissent déjà le côté droit. Essayez d'allonger le titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinque elementi riempiono già il lato destro. Prova ad allungare il titolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco itens já enchem o lado direito. Tente alongar o título."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ห้ารายการเต็มฝั่งขวาแล้ว ลองทำชื่อเรื่องให้ยาวขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Năm mục đã lấp đầy bên phải. Thử làm tiêu đề dài hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pět položek už zaplní pravou stranu. Zkuste nadpis prodloužit."
          }
