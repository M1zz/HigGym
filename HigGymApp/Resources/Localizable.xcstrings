    "세 개가 붙어 있어 **삭제가 도구처럼** 보입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The three are stuck together, so **Delete looks like just another tool**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The three are stuck together, so **Delete looks like just another tool**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3つがくっついているので、**削除が道具の一つのように**見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 개가 붙어 있어 **삭제가 도구처럼** 보입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三个挨在一起，**删除看起来就像工具**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三個挨在一起，**刪除看起來就像工具**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три элемента слиплись, и **«Удалить» выглядит как ещё один инструмент**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tres están pegados, así que **Eliminar parece una herramienta más**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die drei kleben zusammen, daher sieht **Löschen wie ein weiteres Werkzeug aus**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trois sont collés, donc **Supprimer ressemble à un outil comme un autre**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tre sono incollati insieme, quindi **Elimina sembra solo un altro strumento**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os três estão colados, então **Excluir parece só mais uma ferramenta**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งสามติดกัน จึง**ดูเหมือนลบเป็นแค่เครื่องมืออีกอัน**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả ba dính vào nhau, nên **Xóa trông như chỉ là một công cụ nữa**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ty tři jsou slepené, takže **Smazat vypadá jako další nástroj**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De tre sidder klistret sammen, så **Slet ligner bare endnu et værktøj**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα τρία είναι κολλημένα μεταξύ τους, οπότε **η Διαγραφή μοιάζει με ένα ακόμα εργαλείο**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolme on liimattu yhteen, joten **Poista näyttää vain yhdeltä työkalulta**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketiganya menempel jadi satu, sehingga **Hapus terlihat seperti alat biasa lainnya**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De tre sitter sammen, så **Slett ser ut som bare et verktøy til**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De drie zitten aan elkaar vast, dus **Verwijder lijkt gewoon nog een hulpmiddel**."
          }
        }
      }
    },
    "세 번 누르는 동안 손이 어떻게 움직였나요? 불편하거나 이상하다고 느낀 지점이 있었나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How did your hand move during the three taps? Was there any point that felt awkward or off?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "How did your hand move during the three taps? Was there any point that felt awkward or off?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3回押すあいだ、手はどう動きましたか？不便だったり、変だと感じたりしたところはありましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 번 누르는 동안 손이 어떻게 움직였나요? 불편하거나 이상하다고 느낀 지점이 있었나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点三次的时候手是怎么动的？有没有感到不方便或奇怪的地方？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點三次的時候手是怎麼動的？有沒有感到不方便或奇怪的地方？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как двигалась ваша рука при трёх нажатиях? Было ли что-то неудобное или странное?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo se movió tu mano durante los tres toques? ¿Hubo algún momento que se sintiera incómodo o raro?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie bewegte sich deine Hand bei den drei Tipps? Gab es eine Stelle, die sich ungewohnt oder falsch anfühlte?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment votre main a-t-elle bougé pendant les trois touchers ? Y a-t-il eu un moment gênant ou bizarre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come si è mossa la tua mano durante i tre tocchi? C'è stato un punto in cui ti è sembrato scomodo o strano?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como sua mão se moveu durante os três toques? Houve algum ponto que pareceu estranho ou fora de lugar?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มือของคุณเคลื่อนอย่างไรระหว่างการแตะสามครั้ง มีจุดไหนที่รู้สึกอึดอัดหรือแปลก ๆ ไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tay bạn di chuyển thế nào trong ba lần chạm? Có chỗ nào thấy vướng hoặc lạ không?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak se pohyboval vaše ruka při třech klepnutích? Bylo něco nepříjemné nebo divné?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan bevægede din hånd sig under de tre tryk? Var der noget, der føltes akavet eller forkert?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πώς κινήθηκε το χέρι σου στα τρία πατήματα; Υπήρξε σημείο που ένιωσες αμήχανα ή παράξενα;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miten kätesi liikkui kolmen napautuksen aikana? Oliko kohtaa, joka tuntui kömpelöltä tai oudolta?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana tanganmu bergerak selama tiga ketukan? Adakah titik yang terasa canggung atau janggal?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan beveget hånden din seg under de tre trykkene? Var det et punkt som føltes rart eller feil?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe bewoog je hand tijdens de drie tikken? Was er een moment dat het ongemakkelijk of vreemd voelde?"
          }
        }
      }
    },
