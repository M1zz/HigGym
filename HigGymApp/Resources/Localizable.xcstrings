    "이 화면에서 **저장을 세 번** 눌러보세요. 저장 버튼을 먼저 찾아야 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this screen, tap **Save three times**. First you have to find the Save button."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On this screen, tap **Save three times**. First you have to find the Save button."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面で**保存を3回**押してみてください。まず保存ボタンを見つけなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면에서 **저장을 세 번** 눌러보세요. 저장 버튼을 먼저 찾아야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个界面里**点三次存储**。得先找到存储按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這個介面裡**點三次儲存**。得先找到儲存按鈕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом экране нажмите **«Сохранить» три раза**. Сначала нужно найти кнопку «Сохранить»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta pantalla, toca **Guardar tres veces**. Primero tienes que encontrar el botón Guardar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf diesem Bildschirm **dreimal auf Sichern**. Zuerst musst du den Sichern-Button finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet écran, touchez **Enregistrer trois fois**. Il faut d'abord trouver le bouton Enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa schermata, tocca **Salva tre volte**. Prima devi trovare il pulsante Salva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta tela, toque em **Salvar três vezes**. Primeiro você precisa achar o botão Salvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้าจอนี้ แตะ**บันทึกสามครั้ง** ก่อนอื่นคุณต้องหาปุ่มบันทึกให้เจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên màn hình này, chạm **Lưu ba lần**. Trước hết bạn phải tìm nút Lưu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na této obrazovce klepněte **třikrát na Uložit**. Nejdřív musíte najít tlačítko Uložit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne skærm skal du trykke **Gem tre gange**. Først skal du finde knappen Gem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε αυτή την οθόνη, πάτησε **Αποθήκευση τρεις φορές**. Πρώτα πρέπει να βρεις το κουμπί Αποθήκευση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta tässä näkymässä **Tallenna kolme kertaa**. Ensin sinun täytyy löytää Tallenna-painike."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di layar ini, ketuk **Simpan tiga kali**. Pertama kamu harus menemukan tombol Simpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På denne skjermen, trykk **Lagre tre ganger**. Først må du finne Lagre-knappen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op dit scherm **drie keer op Bewaar**. Eerst moet je de knop Bewaar vinden."
          }
        }
      }
    },
    "이 화면에서 가장 자주 하는 일을 하단 오른쪽 끝에 뒀다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most frequent task on this screen goes at the far right of the bottom."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The most frequent task on this screen goes at the far right of the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面でいちばんよく行う操作を、下部の右端に置いた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면에서 가장 자주 하는 일을 하단 오른쪽 끝에 뒀다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这个界面最常做的事放在了底部最右端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這個介面最常做的事放在了底部最右端。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самое частое действие на этом экране поставили в самый правый край низа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea más frecuente de esta pantalla va en el extremo derecho de la parte inferior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die häufigste Aufgabe auf diesem Bildschirm gehört ganz nach rechts unten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche la plus fréquente de cet écran va tout à droite dans le bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il compito più frequente di questa schermata va all'estrema destra in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa mais frequente desta tela vai na extrema direita da parte de baixo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานที่ทำบ่อยที่สุดบนหน้าจอนี้อยู่ขวาสุดของด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác vụ thường xuyên nhất trên màn hình này nằm ở ngoài cùng bên phải của phía dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejčastější úkol na této obrazovce patří úplně vpravo dole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den hyppigste opgave på denne skærm sidder yderst til højre i bunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πιο συχνή εργασία σε αυτή την οθόνη μπαίνει στην άκρη δεξιά του κάτω μέρους."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän näkymän yleisin tehtävä kuuluu alaosan oikeaan reunaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugas paling sering di layar ini ditaruh di paling kanan bagian bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den hyppigste oppgaven på denne skjermen havner helt til høyre nederst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meest frequente taak op dit scherm komt uiterst rechts onderaan."
          }
        }
      }
    },
    "이 화면에서 가장 자주 하는 일이라, 엄지가 가장 쉽게 닿는 자리를 줬다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the most frequent task on this screen, so it gets the spot the thumb reaches most easily"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the most frequent task on this screen, so it gets the spot the thumb reaches most easily"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面でいちばんよく行う操作なので、親指がいちばん届きやすい場所を与えた"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면에서 가장 자주 하는 일이라, 엄지가 가장 쉽게 닿는 자리를 줬다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为是这个界面最常做的事，所以给了拇指最容易够到的位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為是這個介面最常做的事，所以給了拇指最容易夠到的位置"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это самое частое действие на этом экране, поэтому ему дали место, до которого проще всего дотянуться большим пальцем"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la tarea más frecuente de esta pantalla, así que se lleva el sitio al que el pulgar llega con más facilidad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist die häufigste Aufgabe auf diesem Bildschirm, daher bekommt sie den Platz, den der Daumen am leichtesten erreicht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la tâche la plus fréquente de cet écran, donc elle reçoit l'emplacement que le pouce atteint le plus facilement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il compito più frequente di questa schermata, quindi riceve il posto che il pollice raggiunge più facilmente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É a tarefa mais frequente desta tela, então ganha o lugar que o polegar alcança com mais facilidade"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นงานที่ทำบ่อยที่สุดบนหน้าจอนี้ จึงได้ตำแหน่งที่นิ้วโป้งเอื้อมถึงง่ายที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là tác vụ thường xuyên nhất trên màn hình này, nên nó có vị trí mà ngón cái với tới dễ nhất"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to nejčastější úkol na této obrazovce, takže dostává místo, kam palec dosáhne nejsnáze"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er den hyppigste opgave på denne skærm, så den får den plads, tommelfingeren nemmest når"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι η πιο συχνή εργασία σε αυτή την οθόνη, οπότε παίρνει τη θέση που φτάνει ευκολότερα ο αντίχειρας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on tämän näkymän yleisin tehtävä, joten se saa paikan, jonka peukalo tavoittaa helpoimmin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini tugas paling sering di layar ini, jadi ia mendapat tempat yang paling mudah dijangkau ibu jari"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er den hyppigste oppgaven på denne skjermen, så den får plassen tommelen når lettest"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
