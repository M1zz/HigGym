        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「郵件」應用程式的收件箱裡，**寫新郵件**按鈕該放哪裡？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где во входящих приложения «Почта» должна быть кнопка **«Новое письмо»**?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la bandeja de entrada de la app Correo, ¿dónde debe ir el botón **Nuevo mensaje**?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin gehört in der Eingangs-Ansicht der Mail-App der Button **Neue Nachricht**?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la boîte de réception de l'app Mail, où le bouton **Nouveau message** doit-il aller ?"
