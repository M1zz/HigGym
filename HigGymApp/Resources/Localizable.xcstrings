    "삭제를 구분선 아래 맨 끝으로 내리고 `role: .destructive` 를 줬다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved Delete to the very end below a separator and gave it `role: .destructive`."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved Delete to the very end below a separator and gave it `role: .destructive`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を区切り線の下のいちばん最後に移し、`role: .destructive` を付けた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제를 구분선 아래 맨 끝으로 내리고 `role: .destructive` 를 줬다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把删除放到分隔线下的最末尾，并设置了 `role: .destructive`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把刪除放到分隔線下的最末尾，並設定了 `role: .destructive`。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесли «Удалить» в самый конец под разделитель и задали `role: .destructive`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se movió Eliminar al final del todo bajo un separador y se le dio `role: .destructive`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen ganz ans Ende unter einen Trenner verschoben und mit `role: .destructive` versehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer a été déplacé tout à la fin sous un séparateur et reçoit `role: .destructive`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina è stato spostato in fondo, sotto un separatore, e gli è stato dato `role: .destructive`."
          }
        }
      }
    },
    "삭제를 툴바가 아니라 행 위에 뒀다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Delete on the row, not in the toolbar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Delete on the row, not in the toolbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除をツールバーではなく行の上に置いた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제를 툴바가 아니라 행 위에 뒀다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把删除放在行上，而不是工具栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把刪除放在行上，而不是工具列。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Удалить» поместили на строку, а не на панель инструментов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon Eliminar en la fila, no en la barra de herramientas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze Löschen auf die Zeile, nicht in die Symbolleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez Supprimer sur la ligne, pas dans la barre d'outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
