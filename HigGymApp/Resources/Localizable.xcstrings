        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, nach unten zu wischen: Es schließt sich nicht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de balayer vers le bas : elle ne se ferme pas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a scorrere verso il basso: non si chiude"
          }
        }
      }
    },
    "아래로 쓸어내려 보세요, 닫히지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try swiping down: it won't close."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try swiping down: it won't close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下にスワイプしてみてください。閉じません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래로 쓸어내려 보세요, 닫히지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向下轻扫看看，关不掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
