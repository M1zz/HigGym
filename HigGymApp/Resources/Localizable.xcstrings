        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Such-Schaltfläche in das untere Accessory setzen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre le bouton de recherche dans l'accessoire du bas"
