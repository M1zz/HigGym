            "value": "画面下部・検索カプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 아래 · 검색 캡슐"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕下方 · 搜索胶囊"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕下方 · 搜尋膠囊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Низ экрана · капсула поиска"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte inferior de la pantalla · cápsula de búsqueda"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten auf dem Bildschirm · Suchkapsel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bas de l'écran · capsule de recherche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fondo dello schermo · capsula di ricerca"
          }
        }
      }
    },
    "화면 아래 검색 캡슐을 눌러 **김**이라고 쳐보세요, 목록이 실제로 걸러집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the search capsule at the bottom and type **Kim**: the list actually filters."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the search capsule at the bottom and type **Kim**: the list actually filters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面下の検索カプセルを押して**高橋**と入力してみてください。リストが実際に絞り込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 아래 검색 캡슐을 눌러 **김**이라고 쳐보세요, 목록이 실제로 걸러집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按屏幕下方的搜索胶囊，输入**李**，列表真的会被过滤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點螢幕下方的搜尋膠囊，輸入**李**，列表真的會被過濾。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на капсулу поиска внизу и введите **Смирнова**: список действительно фильтруется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la cápsula de búsqueda de abajo y escribe **Kim**: la lista filtra de verdad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe unten auf die Suchkapsel und gib **Kim** ein: Die Liste filtert wirklich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez la capsule de recherche en bas et tapez **Kim** : la liste se filtre vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la capsula di ricerca in basso e digita **Kim**: l'elenco si filtra davvero."
          }
        }
      }
    },
