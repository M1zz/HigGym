            "value": "Transición push"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-Übergang"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transition push"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transizione push"
          }
        }
      }
    },
    "push된 상세 화면의 leading에 아이템이 있습니다. 이 자리는 뒤로가기가 선점하므로, leading 클러스터는 루트나 모달처럼 **back이 없는 화면**의 패턴입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's an item in the leading spot of a pushed detail screen. The back button already claims this spot, so a leading cluster is a pattern for screens **without a back button**, like a root screen or a modal."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There's an item in the leading spot of a pushed detail screen. The back button already claims this spot, so a leading cluster is a pattern for screens **without a back button**, like a root screen or a modal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pushされた詳細画面のleadingにアイテムがあります。この位置は戻るボタンが先に押さえているので、leadingのクラスタはルートやモーダルのような**戻るボタンのない画面**のパターンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "push된 상세 화면의 leading에 아이템이 있습니다. 이 자리는 뒤로가기가 선점하므로, leading 클러스터는 루트나 모달처럼 **back이 없는 화면**의 패턴입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被 push 进来的详情界面的 leading 里有项目。这个位置被返回按钮优先占用，所以 leading 集群是**没有返回的界面**（如根界面或模态）的模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被 push 進來的詳情介面的 leading 裡有項目。這個位置被返回按鈕優先佔用，所以 leading 叢集是**沒有返回的介面**（如根介面或模態）的模式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В leading на экране с подробностями, открытом через push, есть элемент. Это место уже занимает кнопка «Назад», поэтому кластер в leading - шаблон для экранов **без кнопки «Назад»**, таких как корневой экран или модальное окно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un elemento en el sitio leading de una pantalla de detalle abierta con push. El botón de retroceso ya reclama este sitio, así que un grupo en leading es un patrón para pantallas **sin botón de retroceso**, como una pantalla raíz o un modal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Detailansicht, die per Push geöffnet wurde, steht ein Element an der leading-Stelle. Der Zurück-Button beansprucht diese Stelle bereits, daher ist eine Gruppe in leading ein Muster für Bildschirme **ohne Zurück-Button**, etwa einen Wurzelbildschirm oder ein Modal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a un élément à l'emplacement leading d'un écran de détail ouvert par push. Le bouton Retour revendique déjà cet emplacement, donc un cluster en leading est un motif pour les écrans **sans bouton Retour**, comme un écran racine ou une modale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è un elemento nel posto leading di una schermata di dettaglio aperta con push. Il pulsante Indietro rivendica già questo posto, quindi un cluster in leading è un motivo per schermate **senza pulsante Indietro**, come una schermata radice o un modale."
          }
        }
      }
    },
    "push로 들어온 상세 화면입니다. leading에 도구 클러스터를 두려고 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a detail screen reached by push. You want to put a tool cluster in leading."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a detail screen reached by push. You want to put a tool cluster in leading."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pushで入ってきた詳細画面です。leadingにツールのクラスタを置こうとしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "push로 들어온 상세 화면입니다. leading에 도구 클러스터를 두려고 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是通过 push 进入的详情界面。想在 leading 放一组工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是透過 push 進入的詳情介面。想在 leading 放一組工具。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это экран подробностей, открытый через push. Вы хотите поставить в leading набор инструментов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una pantalla de detalle a la que se llega con push. Quieres poner un grupo de herramientas en leading."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist eine per Push erreichte Detailansicht. Du willst eine Werkzeuggruppe in leading setzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un écran de détail atteint par push. Vous voulez mettre un cluster d'outils en leading."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una schermata di dettaglio raggiunta con push. Vuoi mettere un cluster di strumenti in leading."
          }
        }
      }
    },
