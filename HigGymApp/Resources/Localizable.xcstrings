            "value": "// fullScreenCover không đóng khi vuốt xuống. Bạn phải tự làm lối thoát.\n.fullScreenCover(isPresented: $editing) {\n    EditorView()\n        .toolbar {\n            ToolbarItem(placement: .topBarLeading) { Button(\"Hủy\") { editing = false } }\n            ToolbarItem(placement: .topBarTrailing) { Button(\"Xong\") { save() } }\n        }\n}"
