        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhos compartilham um prefixo comum no início, então ver só o começo não distingue os itens. A informação está nas duas pontas, então recolha o meio com **.middle**."
          }
        },
        "th": {
          "stringUnit": {
