    "지금 어느 단계인지 시트 안에 표시됩니다. 손이 아니라 시스템이 단계를 정합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current step is shown inside the sheet. The system, not your hand, sets the step."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The current step is shown inside the sheet. The system, not your hand, sets the step."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまどのステップかがシートの中に表示されます。手ではなくシステムがステップを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 어느 단계인지 시트 안에 표시됩니다. 손이 아니라 시스템이 단계를 정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前处于哪一步会显示在弹层里。决定步骤的不是手，而是系统。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前處於哪一步會顯示在工作表裡。決定步驟的不是手，而是系統。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий шаг показан внутри шторки. Шаги определяет система, а не рука."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paso actual se muestra dentro de la hoja. Lo fija el sistema, no tu mano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Schritt wird im Sheet angezeigt. Das System, nicht deine Hand, legt den Schritt fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'étape actuelle est affichée dans la feuille. C'est le système, et non votre main, qui fixe l'étape."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passo attuale è mostrato dentro il foglio. È il sistema, non la tua mano, a fissare il passo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O passo atual é mostrado dentro da folha. É o sistema, e não a sua mão, que define o passo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นตอนปัจจุบันแสดงอยู่ในชีต ระบบ ไม่ใช่มือของคุณ เป็นผู้กำหนดขั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bước hiện tại được hiển thị bên trong sheet. Hệ thống, không phải tay bạn, đặt bước."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuální krok se zobrazuje uvnitř sheetu. Krok určuje systém, ne vaše ruka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det aktuelle trin vises inde i arket. Det er systemet, ikke din hånd, der sætter trinnet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τρέχον βήμα εμφανίζεται μέσα στο φύλλο. Το σύστημα, όχι το χέρι σου, ορίζει το βήμα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyinen vaihe näytetään arkin sisällä. Järjestelmä, ei kätesi, asettaa vaiheen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langkah saat ini ditampilkan di dalam lembar. Sistem, bukan tanganmu, yang menetapkan langkahnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
