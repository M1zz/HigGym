    "크롬이 물러나야 할 대상. UI는 이걸 돕는 수단이지 주인공이 아닙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the chrome should step back for. UI is a means to support it, not the star."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What the chrome should step back for. UI is a means to support it, not the star."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クロームが引き下がるべき対象。UIはこれを助ける手段であって、主役ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크롬이 물러나야 할 대상. UI는 이걸 돕는 수단이지 주인공이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面框架该退后的对象。UI 是帮助它的手段，不是主角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面框架該退後的物件。UI 是幫助它的手段，不是主角。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, перед чем «хром» должен отступить. Интерфейс - средство для его поддержки, а не главный герой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquello ante lo que el cromo debe retroceder. La interfaz es un medio para apoyarlo, no el protagonista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wofür das Chrome zurücktreten sollte. UI ist ein Mittel, es zu unterstützen, nicht der Star."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce devant quoi le chrome doit s'effacer. L'interface est un moyen de le soutenir, pas la vedette."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per che cosa il chrome deve farsi da parte. La UI è un mezzo per sostenerlo, non la protagonista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que o chrome deve recuar. A interface é um meio de sustentá-lo, não a estrela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ส่วนห่อหุ้มควรถอยให้ UI เป็นเพียงวิธีสนับสนุนมัน ไม่ใช่พระเอก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thứ mà lớp vỏ nên lùi lại cho. UI là phương tiện để hỗ trợ nó, không phải ngôi sao."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro co má rámec ustoupit. UI je prostředek k jeho podpoře, ne hvězda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, krommen skal vige for. Brugerfladen er et middel til at støtte det, ikke stjernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για τι πρέπει να υποχωρεί το chrome. Η διεπαφή είναι μέσο για να το στηρίζει, όχι ο πρωταγωνιστής."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mille kehyksen tulisi väistyä. Käyttöliittymä on keino sen tukemiseen, ei pääosan esittäjä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk apa chrome harus mundur. UI adalah sarana mendukungnya, bukan bintangnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva chrome skal trekke seg tilbake for. UI er et middel for å støtte det, ikke stjernen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarvoor de chrome opzij moet gaan. UI is een middel om dat te ondersteunen, niet de ster."
          }
        }
      }
    },
    "큰 제목이 성능에 부담을 주므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because large titles are a burden on performance"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because large titles are a burden on performance"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きいタイトルはパフォーマンスの負担になるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 제목이 성능에 부담을 주므로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为大标题会给性能带来负担"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為大標題會給效能帶來負擔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что крупные заголовки - нагрузка на производительность"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque los títulos grandes son una carga para el rendimiento"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil große Titel eine Belastung für die Performance sind"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce que les grands titres pèsent sur les performances"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché i titoli grandi pesano sulle prestazioni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque títulos grandes pesam no desempenho"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพราะชื่อเรื่องขนาดใหญ่เป็นภาระต่อประสิทธิภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì tiêu đề lớn là gánh nặng cho hiệu năng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože velké nadpisy jsou zátěží pro výkon"
          }
