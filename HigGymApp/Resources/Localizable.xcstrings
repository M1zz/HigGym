    "레슨 %lld편, 실수 %lld편, 실습실, 퀴즈 전부. 주간 · 월간 구독 또는 평생 이용권.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lessons, %2$lld mistakes, every lab and quiz. Weekly, monthly, or lifetime."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lessons, %2$lld mistakes, every lab and quiz. Weekly, monthly, or lifetime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レッスン%1$lld編、ミス%2$lld編、実習室、クイズのすべて。週間・月額プランまたは買い切り。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "레슨 %1$lld편, 실수 %2$lld편, 실습실, 퀴즈 전부. 주간 · 월간 구독 또는 평생 이용권."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 节课程、%2$lld 篇失误、练习室、测验全部包含。每周、每月订阅或终身使用权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 節課程、%2$lld 篇失誤、練習室、測驗全部包含。每週、每月訂閱或終身使用權。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уроков: %1$lld, ошибок: %2$lld, все практикумы и викторины. Неделя, месяц или навсегда."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lecciones, %2$lld errores, todos los laboratorios y cuestionarios. Semanal, mensual o de por vida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Lektionen, %2$lld Fehler, alle Labors und Quizze. Wöchentlich, monatlich oder einmalig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld leçons, %2$lld erreurs, tous les laboratoires et quiz. Hebdomadaire, mensuel ou à vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lezioni, %2$lld errori, ogni laboratorio e quiz. Settimanale, mensile o a vita."
          }
        }
      }
    }
  },
  "version": "1.0"
}