            "value": "// fullScreenCover non si chiude con uno scorrimento verso il basso. Devi costruire tu l'uscita.\n.fullScreenCover(isPresented: $editing) {\n    EditorView()\n        .toolbar {\n            ToolbarItem(placement: .topBarLeading) { Button(\"Annulla\") { editing = false } }\n            ToolbarItem(placement: .topBarTrailing) { Button(\"Fine\") { save() } }\n        }\n}"
