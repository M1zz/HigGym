          }
        }
      }
    },
    "정렬 · 삭제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort · Delete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替え · 削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정렬 · 삭제"
          }
        }
      }
    },
    "정렬 기준 변경": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change sort order"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替えの基準を変更"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정렬 기준 변경"
          }
        }
      }
    },
    "정렬과 표시 옵션을 바꾸면 목록이 **실제로** 바뀝니다. 메뉴는 창고가 아니라 조작 장치입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the sort and display options **actually** changes the list. A menu is a set of controls, not a storage closet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替えと表示オプションを変えると、リストが**実際に**変わります。メニューは倉庫ではなく操作装置です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정렬과 표시 옵션을 바꾸면 목록이 **실제로** 바뀝니다. 메뉴는 창고가 아니라 조작 장치입니다."
          }
        }
      }
    },
    "정민준": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcus Chung"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "田中 湊"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정민준"
          }
        }
      }
    },
    "정중앙의 **지도 / 목록** 세그먼트를 눌러보세요, 화면 전체가 바뀝니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **Map / List** segment in the center. The whole screen changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央の**マップ / リスト**のセグメントをタップしてみてください。画面全体が切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정중앙의 **지도 / 목록** 세그먼트를 눌러보세요, 화면 전체가 바뀝니다."
          }
        }
      }
    },
    "정체성": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイデンティティ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정체성"
          }
        }
      }
    },
    "제목": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목"
          }
        }
      }
    },
    "제목 · 노트 ⌄": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title · Notes ⌄"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル · メモ ⌄"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 · 노트 ⌄"
          }
        }
      }
    },
    "제목 길이가 길어질 수 있으므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because the title may get long"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルが長くなることがあるので"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 길이가 길어질 수 있으므로"
          }
        }
      }
    },
    "제목 메뉴": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルメニュー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 메뉴"
          }
        }
      }
    },
    "제목 메뉴가 iOS 26의 새 기능이라 써본 것이다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was tried because the title menu is new in iOS 26"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルメニューがiOS 26の新機能なので使ってみた"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 메뉴가 iOS 26의 새 기능이라 써본 것이다"
          }
        }
      }
    },
    "제목 메뉴는 **“제목이 가리키는 대상”에 대한 액션** 자리입니다.\n\n무관한 전역 액션을 넣으면 대상·액션 결합이라는 문법 자체가 거짓이 되어, 이후 이 앱의 모든 title menu를 사용자가 못 믿게 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title menu is the place for **actions on “what the title refers to.”**\n\nPut unrelated global actions there and the very grammar of tying actions to targets becomes a lie, so people stop trusting every title menu in this app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルメニューは「**タイトルが指す対象」についてのアクション**の場所です。\n\n関係のないグローバルなアクションを入れると、対象とアクションの結びつきという文法そのものが嘘になり、以後このアプリのすべてのtitle menuをユーザーが信用できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 메뉴는 **“제목이 가리키는 대상”에 대한 액션** 자리입니다.\n\n무관한 전역 액션을 넣으면 대상·액션 결합이라는 문법 자체가 거짓이 되어, 이후 이 앱의 모든 title menu를 사용자가 못 믿게 됩니다."
          }
        }
      }
    },
    "제목 아래 한 줄. `.always`로 상시 노출하면 대부분의 순간 기여하지 않는 UI가 세로 공간을 계속 씁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One line under the title. Showing it all the time with `.always` means UI that contributes nothing most of the time keeps using vertical space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの下の1行。`.always` で常に表示すると、ほとんどの瞬間に役立たないUIが縦のスペースを使い続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 아래 한 줄. `.always`로 상시 노출하면 대부분의 순간 기여하지 않는 UI가 세로 공간을 계속 씁니다."
          }
        }
      }
    },
    "제목 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Untitled"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名称未設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 없음"
          }
        }
      }
    },
    "제목 옆 **⌄** 를 눌러보세요, 제목 자체가 메뉴 버튼입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **⌄** next to the title. The title itself is a menu button."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの横の「⌄」をタップしてみてください。タイトルそのものがメニューボタンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 옆 **⌄** 를 눌러보세요, 제목 자체가 메뉴 버튼입니다."
          }
        }
      }
    },
    "제목 옆의 **⌄** 를 누르면 메뉴가 열립니다. 폴더를 바꾸면 제목과 목록이 같이 바뀝니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **⌄** next to the title to open a menu. Change the folder, and the title and list change together."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの横の「⌄」をタップするとメニューが開きます。フォルダを変えると、タイトルとリストが一緒に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 옆의 **⌄** 를 누르면 메뉴가 열립니다. 폴더를 바꾸면 제목과 목록이 같이 바뀝니다."
          }
        }
      }
    },
    "제목 옆의 ⌄ 를 눌러보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the ⌄ next to the title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの横の⌄をタップしてみてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 옆의 ⌄ 를 눌러보세요"
          }
        }
      }
    },
    "제목 옆의 별도 “폴더 변경” 버튼": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate “Change folder” button next to the title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの横にある別の「フォルダを変更」ボタン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 옆의 별도 “폴더 변경” 버튼"
          }
        }
      }
    },
    "제목 자리 (principal)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title spot (principal)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの位置 (principal)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 자리 (principal)"
          }
        }
      }
    },
    "제목 자리(principal)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title spot (principal)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの位置（principal）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 자리(principal)"
          }
        }
      }
    },
    "제목 자리에 텍스트가 아니라 **아바타 + 이름 + 상태**가 들어가 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title spot holds an **avatar + name + status** instead of text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの位置にテキストではなく**アバター + 名前 + ステータス**が入っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 자리에 텍스트가 아니라 **아바타 + 이름 + 상태**가 들어가 있습니다."
          }
        }
      }
    },
    "제목 자체를 눌러 대상에 대한 액션을 여는 구성입니다. 대상과 액션이 한 몸이라 관계를 설명할 필요가 없고 툴바 자리도 아낍니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You tap the title itself to open actions on its target. Target and action are one, so the relationship needs no explanation, and it saves toolbar space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルそのものをタップして、対象についてのアクションを開く構成です。対象とアクションが一体なので関係を説明する必要がなく、ツールバーの場所も節約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 자체를 눌러 대상에 대한 액션을 여는 구성입니다. 대상과 액션이 한 몸이라 관계를 설명할 필요가 없고 툴바 자리도 아낍니다."
          }
        }
      }
    },
    "제목 표시 방식": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title display mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの表示方法"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 표시 방식"
          }
        }
      }
    },
    "제목을 지운 형태(3.1.2)와 비교하면, 라벨이 있는 쪽이 처음 온 사람에게 얼마나 친절한지 보입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compared with the version without a title (3.1.2), you can see how much friendlier the labeled one is to first-time visitors."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルを消した形（3.1.2）と比べると、ラベルがあるほうが初めて来た人にどれだけ親切かがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목을 지운 형태(3.1.2)와 비교하면, 라벨이 있는 쪽이 처음 온 사람에게 얼마나 친절한지 보입니다."
          }
        }
      }
    },
    "제목을 탭하면 열리는 toolbarTitleMenu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "toolbarTitleMenu that opens when you tap the title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルをタップすると開くtoolbarTitleMenu"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목을 탭하면 열리는 toolbarTitleMenu"
          }
        }
      }
    },
    "제목이 **잘렸습니다**. 좁은 줄에서 제목과 아이템은 같은 폭을 두고 경쟁합니다, 8.1.5.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title **got truncated**. On a narrow line, the title and items compete for the same width (8.1.5)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルが**切り詰められました**。狭い行では、タイトルと項目が同じ幅を取り合います（8.1.5）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이 **잘렸습니다**. 좁은 줄에서 제목과 아이템은 같은 폭을 두고 경쟁합니다, 8.1.5."
          }
        }
      }
    },
    "제목이 곧 \"지금 무엇을 보고 있는가\"이므로, 그것을 바꾸는 액션은 제목 위에 있는 게 맞다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title says \"what you're looking at right now,\" so the action that changes it belongs on the title"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルこそ「いま何を見ているか」なので、それを変えるアクションはタイトルの上にあるのが正しい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이 곧 \"지금 무엇을 보고 있는가\"이므로, 그것을 바꾸는 액션은 제목 위에 있는 게 맞다"
          }
        }
      }
    },
    "제목이 곧 \"지금 무엇을 보고 있는가\"이므로, 그것을 바꾸는 액션은 제목 위에 있는 게 맞다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title says \"what you're looking at right now,\" so the action that changes it belongs on the title."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルこそ「いま何を見ているか」なので、それを変えるアクションはタイトルの上にあるのが正しい。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이 곧 \"지금 무엇을 보고 있는가\"이므로, 그것을 바꾸는 액션은 제목 위에 있는 게 맞다."
          }
        }
      }
    },
    "제목이 늘 커 보이는 대신, 콘텐츠에 내주는 세로 공간은 없습니다, 그 교환이 이 모드의 전부입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title always looks big, but it gives no vertical space back to the content. That trade-off is all this mode is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルが常に大きく見える代わりに、コンテンツに譲る縦のスペースはありません。その交換がこのモードのすべてです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이 늘 커 보이는 대신, 콘텐츠에 내주는 세로 공간은 없습니다, 그 교환이 이 모드의 전부입니다."
          }
        }
      }
    },
    "제목이 본문 글자와 비교해 어땠나요? 버튼은 손가락으로 정확히 눌렸나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How did the title compare with the body text? Did the buttons register exactly where your finger tapped?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルは本文の文字と比べてどうでしたか？ボタンは指で正確に押せましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이 본문 글자와 비교해 어땠나요? 버튼은 손가락으로 정확히 눌렸나요?"
          }
        }
      }
    },
    "제목이 없습니다. 이 컨트롤이 곧 \"이 화면이 무엇인가\"이기 때문입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no title. This control itself says \"what this screen is.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルがありません。このコントロールこそが「この画面が何か」だからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이 없습니다. 이 컨트롤이 곧 \"이 화면이 무엇인가\"이기 때문입니다."
          }
        }
      }
    },
    "제목이 있어야 할 정중앙을 **검색 필드가 차지**했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The **search field took over** the center, where the title should be."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルがあるべき中央を**検索フィールドが占領**しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이 있어야 할 정중앙을 **검색 필드가 차지**했습니다."
          }
        }
      }
    },
    "제목이 접히는 동안 오른쪽 버튼은 그대로입니다, 액션은 제목의 사정과 무관합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the title collapses, the button on the right stays put. Actions don't depend on what the title is doing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルが折りたたまれる間も、右のボタンはそのままです。アクションはタイトルの事情とは無関係です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이 접히는 동안 오른쪽 버튼은 그대로입니다, 액션은 제목의 사정과 무관합니다."
          }
        }
      }
    },
    "제목이 차지하는 세로 공간이 가장 적습니다. 상세 화면·모달처럼 콘텐츠가 주인공인 화면의 기본값입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title takes the least vertical space. It's the default for screens where content is the star, like detail views and modals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルが占める縦のスペースがいちばん少なくなります。詳細画面やモーダルのように、コンテンツが主役の画面のデフォルトです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이 차지하는 세로 공간이 가장 적습니다. 상세 화면·모달처럼 콘텐츠가 주인공인 화면의 기본값입니다."
          }
        }
      }
    },
    "제주 여름휴가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summer in Maui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "沖縄の夏休み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제주 여름휴가"
          }
        }
      }
    },
    "제한을 넘는 내용은 사라집니다. **몇 줄이면 뜻이 통하는가**가 이 값을 정하는 기준입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content past the limit disappears. **How many lines it takes to make sense** is the criterion for setting this value."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限を超えた内容は消えます。**何行あれば意味が通じるか**が、この値を決める基準です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한을 넘는 내용은 사라집니다. **몇 줄이면 뜻이 통하는가**가 이 값을 정하는 기준입니다."
          }
        }
      }
    },
    "좌우 버튼과 한 줄을 나눠 씁니다. 제목이 길어지면 어떻게 될지 1.2.4에서 확인해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It shares one line with the buttons on either side. Check what happens when the title gets long in 1.2.4."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右のボタンと1行を分け合います。タイトルが長くなったらどうなるか、1.2.4で確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌우 버튼과 한 줄을 나눠 씁니다. 제목이 길어지면 어떻게 될지 1.2.4에서 확인해 보세요."
          }
        }
      }
    },
    "주 사용 방식이면 늘 손에 닿아야 한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it's the main way people use it, it must always be within reach"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主な使い方なら、いつも手が届くべきだ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 사용 방식이면 늘 손에 닿아야 한다"
          }
        }
      }
    },
    "주간 보고": {
      "localizations": {
