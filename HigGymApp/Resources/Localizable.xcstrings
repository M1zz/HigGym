    "폭을 줄여보세요, 자르는 대신 **글자가 작아집니다**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it narrower: instead of truncating, **the text gets smaller**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it narrower: instead of truncating, **the text gets smaller**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅を狭めてみてください。切り詰める代わりに**文字が小さくなります**。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭을 줄여보세요, 자르는 대신 **글자가 작아집니다**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小宽度，**文字会变小**，而不是被截断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小寬度，**文字會變小**，而不是被截斷。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте уже: вместо обрезки **текст становится меньше**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazlo más estrecho: en lugar de truncarse, **el texto se hace más pequeño**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mache es schmaler: Statt abzuschneiden, **wird der Text kleiner**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétrécissez-le : au lieu de tronquer, **le texte devient plus petit**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringilo: invece di troncare, **il testo diventa più piccolo**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estreite: em vez de truncar, **o texto fica menor**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้แคบลง: แทนที่จะถูกตัด **ข้อความจะเล็กลง**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm nó hẹp hơn: thay vì bị cắt, **văn bản nhỏ lại**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zúžte to: místo oříznutí se **text zmenší**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør den smallere: i stedet for at afkorte **bliver teksten mindre**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στένεψέ το: αντί να περικόπτεται, **το κείμενο μικραίνει**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee kapeammaksi: katkaisun sijaan **teksti pienenee**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat lebih sempit: alih-alih memotong, **teks menjadi lebih kecil**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør den smalere: i stedet for å avkorte, **blir teksten mindre**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak het smaller: in plaats van af te kappen **wordt de tekst kleiner**."
          }
        }
      }
    },
    "폭이 모자라면 뒤쪽부터 접힌다, 무엇을 앞에 뒀는가의 문제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When space runs short, items fold from the end. It's about what you put first"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When space runs short, items fold from the end. It's about what you put first"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅が足りなければ後ろから折りたたまれる。何を前に置いたかの問題"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭이 모자라면 뒤쪽부터 접힌다, 무엇을 앞에 뒀는가의 문제"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽度不够时从后面开始折叠，问题在于把什么放在前面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寬度不夠時從後面開始摺疊，問題在於把什麼放在前面"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда не хватает места, элементы сворачиваются с конца. Всё дело в том, что вы поставили первым"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando falta espacio, los elementos se pliegan desde el final. Importa lo que pones primero"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn der Platz knapp wird, falten sich Elemente vom Ende her. Es kommt darauf an, was du an den Anfang stellst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand l'espace manque, les éléments se replient en partant de la fin. Tout dépend de ce que vous mettez en premier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando lo spazio scarseggia, gli elementi si ripiegano dalla fine. Conta che cosa metti per primo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o espaço acaba, os itens dobram a partir do fim. O que importa é o que você coloca primeiro"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อพื้นที่ไม่พอ รายการจะพับจากท้าย สิ่งสำคัญคือสิ่งที่คุณวางไว้ก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thiếu chỗ, các mục gập từ cuối. Vấn đề là bạn đặt cái gì lên đầu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když dojde místo, položky se sbalí od konce. Záleží na tom, co dáte na začátek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når pladsen løber tør, foldes elementer fra enden. Det handler om, hvad du sætter først"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν τελειώνει ο χώρος, τα στοιχεία διπλώνουν από το τέλος. Έχει σημασία τι βάζεις πρώτο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun tila loppuu, kohteet taittuvat lopusta. Kyse on siitä, mitä laitat ensin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ruang menipis, item terlipat dari belakang. Ini soal apa yang kamu taruh lebih dulu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når plassen blir knapp, foldes elementer fra slutten. Det handler om hva du setter først"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de ruimte op raakt, klappen items in vanaf het eind. Het gaat om wat je vooraan zet"
          }
        }
      }
    },
    "폭이 모자라면 시스템은 **뒤쪽부터** ⋯ 안으로 접는다. 그러니 코드에 적는 순서가 곧 우선순위 선언이다. 접기를 막을 게 아니라 무엇이 접혀도 되는지를 정하는 일이다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When width runs short, the system folds items into ⋯ **from the end**. So the order you write them in code is your declaration of priority. The job isn't to prevent folding; it's to decide what can be folded."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When width runs short, the system folds items into ⋯ **from the end**. So the order you write them in code is your declaration of priority. The job isn't to prevent folding; it's to decide what can be folded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅が足りないと、システムは**後ろから** ⋯ の中へ折りたたむ。だからコードに書く順番がそのまま優先順位の宣言になる。折りたたみを防ぐのではなく、何が折りたたまれてもいいかを決める作業だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭이 모자라면 시스템은 **뒤쪽부터** ⋯ 안으로 접는다. 그러니 코드에 적는 순서가 곧 우선순위 선언이다. 접기를 막을 게 아니라 무엇이 접혀도 되는지를 정하는 일이다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽度不够时，系统会**从后面开始**折叠进 ⋯。所以代码里写的顺序就是优先级声明。不该去阻止折叠，而是要决定什么可以被折叠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寬度不夠時，系統會**從後面開始**摺疊進 ⋯。所以程式碼裡寫的順序就是優先順序宣告。不該去阻止摺疊，而是要決定什麼可以被摺疊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда ширины не хватает, система сворачивает элементы в ⋯ **с конца**. Поэтому порядок, в котором вы пишете их в коде, - это объявление приоритета. Задача не в том, чтобы предотвратить сворачивание, а в том, чтобы решить, что можно сворачивать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando falta ancho, el sistema pliega los elementos en ⋯ **desde el final**. Por eso el orden en que los escribes en el código es tu declaración de prioridad. La tarea no es evitar el plegado, sino decidir qué se puede plegar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Breite knapp wird, faltet das System Elemente **vom Ende her** in ⋯. Die Reihenfolge, in der du sie im Code schreibst, ist also deine Prioritätserklärung. Die Aufgabe ist nicht, das Falten zu verhindern, sondern zu entscheiden, was gefaltet werden darf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la largeur manque, le système replie les éléments dans ⋯ **en partant de la fin**. L'ordre dans lequel vous les écrivez dans le code est donc votre déclaration de priorité. Le travail n'est pas d'empêcher le repli ; c'est de décider ce qui peut être replié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la larghezza scarseggia, il sistema ripiega gli elementi in ⋯ **dalla fine**. Quindi l'ordine in cui li scrivi nel codice è la tua dichiarazione di priorità. Il compito non è impedire il ripiegamento; è decidere che cosa può essere ripiegato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a largura acaba, o sistema dobra os itens em ⋯ **a partir do fim**. Então a ordem em que você os escreve no código é a sua declaração de prioridade. O trabalho não é impedir a dobra; é decidir o que pode ser dobrado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อความกว้างไม่พอ ระบบพับรายการเข้า ⋯ **จากท้าย** ดังนั้นลำดับที่คุณเขียนในโค้ดคือคำประกาศลำดับความสำคัญของคุณ งานไม่ใช่การป้องกันการพับ แต่คือการตัดสินว่าอะไรพับได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thiếu chiều rộng, hệ thống gập các mục vào ⋯ **từ cuối**. Vì vậy thứ tự bạn viết trong mã là lời khai báo ưu tiên của bạn. Việc cần làm không phải ngăn gập mà là quyết định cái gì được phép gập."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když dojde šířka, systém sbalí položky do ⋯ **od konce**. Pořadí, v jakém je píšete v kódu, je tedy vaše deklarace priority. Úkolem není sbalení zabránit, ale rozhodnout, co lze sbalit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når bredden løber tør, folder systemet elementer ind i ⋯ **fra enden**. Så den rækkefølge, du skriver dem i i koden, er din erklæring om prioritet. Opgaven er ikke at forhindre sammenfoldning; den er at beslutte, hvad der kan foldes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν τελειώνει το πλάτος, το σύστημα διπλώνει στοιχεία στο ⋯ **από το τέλος**. Έτσι η σειρά με την οποία τα γράφεις στον κώδικα είναι η δήλωση προτεραιότητάς σου. Η δουλειά δεν είναι να αποτρέψεις τη σύμπτυξη· είναι να αποφασίσεις τι μπορεί να διπλωθεί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun leveys loppuu, järjestelmä taittaa kohteet ⋯-valikkoon **lopusta alkaen**. Joten koodiin kirjoittamasi järjestys on prioriteettiilmoituksesi. Tehtävä ei ole estää taittumista, vaan päättää, mitä voi taittaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat lebar menipis, sistem melipat item ke ⋯ **dari belakang**. Jadi urutan yang kamu tulis di kode adalah deklarasi prioritasmu. Tugasnya bukan mencegah pelipatan; melainkan memutuskan apa yang boleh dilipat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når bredden blir knapp, folder systemet elementer inn i ⋯ **fra slutten**. Så rekkefølgen du skriver dem i koden er din deklarasjon av prioritet. Jobben er ikke å hindre folding; den er å bestemme hva som kan foldes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de breedte tekortschiet, klapt het systeem items **vanaf het eind** in ⋯. De volgorde waarin je ze in code schrijft is dus je verklaring van prioriteit. De taak is niet om inklappen te voorkomen; het is beslissen wat mag worden ingeklapt."
          }
        }
      }
    },
