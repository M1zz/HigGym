    "지금 보이는 오른쪽 분리 캡슐은 **검색 role**로 만든 것입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The separate capsule you see on the right is built with the **search role**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The separate capsule you see on the right is built with the **search role**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま見えている右側の分離したカプセルは、**検索role**でつくったものです。"
          }
        },
        "ko": {
          "stringUnit": {
