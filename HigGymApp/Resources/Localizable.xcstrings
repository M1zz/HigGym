    "하단 바가 비어 보이면 미완성처럼 보이기 때문에": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because an empty-looking bottom bar looks unfinished"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because an empty-looking bottom bar looks unfinished"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーが空いていると未完成に見えるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바가 비어 보이면 미완성처럼 보이기 때문에"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为底部栏空着看起来像没做完"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為底部列空著看起來像沒做完"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что пустая нижняя панель выглядит недоделанной"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque una barra inferior que parece vacía parece inacabada"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil eine leer wirkende untere Leiste unfertig aussieht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce qu'une barre du bas qui a l'air vide paraît inachevée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché una barra in basso che sembra vuota sembra non finita"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque uma barra inferior com cara de vazia parece inacabada"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพราะแถบล่างที่ดูว่างเปล่าดูเหมือนยังไม่เสร็จ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì một thanh dưới trông trống thì có vẻ chưa hoàn thiện"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože prázdně vypadající spodní panel vypadá nedodělaně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi en tom-udseende nederste bjælke ser uafsluttet ud"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επειδή μια κάτω γραμμή που φαίνεται άδεια δείχνει ημιτελής"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska tyhjältä näyttävä alapalkki näyttää keskeneräiseltä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena bilah bawah yang tampak kosong terlihat belum selesai"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi en bunnlinje som ser tom ut ser uferdig ut"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat een onderbalk die leeg lijkt onaf oogt"
          }
        }
      }
    },
