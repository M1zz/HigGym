    "툴바를 최대한 비워 미니멀하게 보이려고": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep the toolbar as empty as possible so it looks minimal"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep the toolbar as empty as possible so it looks minimal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーをできるだけ空けてミニマルに見せるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "툴바를 최대한 비워 미니멀하게 보이려고"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了显得极简，把工具栏尽量清空"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了顯得極簡，把工具列儘量清空"
          }
