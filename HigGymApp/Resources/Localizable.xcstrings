            "value": "Vastaus"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoord"
          }
        }
      }
    },
    "정답은 취향이 아니라 **무엇이 식별에 쓰이는가**입니다. 경로는 끝(파일명)이, 제목은 앞이 결정적입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer isn't taste but **what's used to identify it**. For a path, the end (the file name) matters; for a title, the beginning does."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer isn't taste but **what's used to identify it**. For a path, the end (the file name) matters; for a title, the beginning does."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正解は好みではなく、**何が識別に使われるか**です。パスは末尾（ファイル名）が、タイトルは先頭が決め手です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정답은 취향이 아니라 **무엇이 식별에 쓰이는가**입니다. 경로는 끝(파일명)이, 제목은 앞이 결정적입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答案不是喜好，而是**用什么来识别**。路径的结尾（文件名）、标题的开头才是关键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "答案不是喜好，而是**用什麼來識別**。路徑的結尾（檔名）、標題的開頭才是關鍵。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ - не вкус, а **то, по чему это идентифицируется**. Для пути важен конец (имя файла), для заголовка - начало."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta no es cuestión de gusto sino de **lo que sirve para identificarlo**. En una ruta importa el final (el nombre del archivo); en un título, el principio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort ist keine Geschmacksfrage, sondern **was zur Identifikation dient**. Bei einem Pfad zählt das Ende (der Dateiname); bei einem Titel der Anfang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse n'est pas une question de goût mais de **ce qui sert à l'identifier**. Pour un chemin, la fin (le nom du fichier) compte ; pour un titre, c'est le début."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta non è questione di gusto ma di **ciò che serve a identificarlo**. Per un percorso conta la fine (il nome del file); per un titolo, l'inizio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta não é questão de gosto, mas **do que serve para identificar**. Num caminho, o fim (o nome do arquivo) importa; num título, o começo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบไม่ใช่รสนิยม แต่คือ**สิ่งที่ใช้ระบุตัวตน** สำหรับพาธ ส่วนท้าย (ชื่อไฟล์) สำคัญ สำหรับชื่อเรื่อง ส่วนต้นสำคัญ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đáp án không phải khẩu vị mà là **thứ được dùng để nhận diện**. Với đường dẫn, phần cuối (tên tệp) quan trọng; với tiêu đề, phần đầu quan trọng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpověď není otázkou vkusu, ale **toho, co slouží k identifikaci**. U cesty záleží na konci (název souboru), u nadpisu na začátku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret er ikke smag men **det, der bruges til at identificere det**. For en sti er enden (filnavnet) vigtig; for en titel er begyndelsen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απάντηση δεν είναι γούστο αλλά **αυτό που χρησιμοποιείται για την αναγνώριση**. Για μια διαδρομή, το τέλος (το όνομα αρχείου) μετράει· για έναν τίτλο, η αρχή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaus ei ole maku vaan **se, mitä käytetään tunnistamiseen**. Polulla loppu (tiedostonimi) on tärkeä; otsikolla alku."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawabannya bukan selera melainkan **apa yang dipakai untuk mengenalinya**. Untuk jalur, ujungnya (nama file) yang penting; untuk judul, awalnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret er ikke smak, men **hva som brukes til å identifisere det**. For en bane teller slutten (filnavnet); for en tittel teller begynnelsen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord is geen smaak maar **waarmee het wordt geïdentificeerd**. Bij een pad telt het eind (de bestandsnaam); bij een titel het begin."
          }
        }
      }
    },
    "정답을 맞히는 칸이 아닙니다. 방금 손으로 겪은 것을 그대로 적으면 됩니다. **아무 이상 없었다면 그렇게 적어도 됩니다**, 못 느끼고 지나가는 것이 어디인지가 다음 단계에서 더 중요해집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a box for getting the right answer. Just write what you just experienced with your hands. **If nothing felt off, you can write that too.** Where you pass by without noticing matters more in the next step."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a box for getting the right answer. Just write what you just experienced with your hands. **If nothing felt off, you can write that too.** Where you pass by without noticing matters more in the next step."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正解を当てる欄ではありません。いま手で体験したことをそのまま書けば大丈夫です。**何も違和感がなかったなら、そう書いてもかまいません**。気づかずに通り過ぎる場所がどこなのかが、次のステップでより重要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정답을 맞히는 칸이 아닙니다. 방금 손으로 겪은 것을 그대로 적으면 됩니다. **아무 이상 없었다면 그렇게 적어도 됩니다**, 못 느끼고 지나가는 것이 어디인지가 다음 단계에서 더 중요해집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里不是答对的格子。把刚才亲手体验到的如实写下来就行。**如果没觉得有什么不对，就那样写也可以**，漏掉了哪里没感觉到，在下一步里更重要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡不是答對的格子。把剛才親手體驗到的如實寫下來就行。**如果沒覺得有什麼不對，就那樣寫也可以**，漏掉了哪裡沒感覺到，在下一步裡更重要。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не поле для верного ответа. Просто запишите, что вы только что пережили руками. **Если ничего не показалось странным, так и напишите.** Места, мимо которых вы проходите, не замечая, важнее на следующем шаге."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es una casilla para acertar. Solo escribe lo que acabas de vivir con las manos. **Si nada te pareció raro, también puedes escribirlo.** Donde pasas sin darte cuenta importa más en el siguiente paso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein Feld, um die richtige Antwort zu treffen. Schreibe einfach auf, was du gerade mit deinen Händen erlebt hast. **Wenn sich nichts komisch anfühlte, kannst du auch das aufschreiben.** Wo du unbemerkt vorbeigehst, zählt im nächsten Schritt mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci n'est pas une case pour trouver la bonne réponse. Écrivez simplement ce que vous venez de vivre avec vos mains. **Si rien ne vous a paru bizarre, vous pouvez aussi l'écrire.** Les endroits où l'on passe sans rien remarquer comptent davantage à l'étape suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non è un riquadro per dare la risposta giusta. Scrivi solo ciò che hai appena provato con le mani. **Se nulla ti è sembrato strano, puoi scrivere anche questo.** I punti in cui passi senza accorgertene contano di più nel passo successivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta não é uma caixa para dar a resposta certa. Escreva só o que você acabou de sentir com as mãos. **Se nada pareceu estranho, você também pode escrever isso.** O lugar por onde você passa sem perceber importa mais no próximo passo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่ไม่ใช่กล่องสำหรับหาคำตอบที่ถูก แค่เขียนสิ่งที่คุณเพิ่งสัมผัสด้วยมือ **ถ้าไม่รู้สึกแปลกอะไร ก็เขียนอย่างนั้นได้** ที่ที่คุณผ่านไปโดยไม่สังเกตสำคัญกว่าในขั้นตอนถัดไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây không phải ô để tìm đáp án đúng. Chỉ cần viết điều bạn vừa trải nghiệm bằng đôi tay. **Nếu không thấy gì lạ, bạn cũng có thể viết điều đó.** Chỗ bạn lướt qua mà không để ý quan trọng hơn ở bước tiếp theo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto není políčko pro správnou odpověď. Jen napište, co jste právě prožili rukama. **Pokud vám nic nepřipadalo špatně, můžete napsat i to.** Místa, kolem kterých projdete bez povšimnutí, záleží v dalším kroku víc."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke en boks til at få det rigtige svar. Skriv bare det, du lige har oplevet med dine hænder. **Hvis intet føltes forkert, kan du også skrive det.** Det sted, hvor du går forbi uden at bemærke det, betyder mere i næste trin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν είναι πλαίσιο για να βρεις τη σωστή απάντηση. Απλώς γράψε αυτό που μόλις βίωσες με τα χέρια σου. **Αν τίποτα δεν σου φάνηκε περίεργο, μπορείς να γράψεις κι αυτό.** Το σημείο από το οποίο περνάς χωρίς να το προσέξεις μετράει περισσότερο στο επόμενο βήμα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ei ole laatikko oikean vastauksen saamiseksi. Kirjoita vain, mitä juuri koit käsilläsi. **Jos mikään ei tuntunut oudolta, voit kirjoittaa senkin.** Kohdat, joiden ohi kuljet huomaamatta, merkitsevät enemmän seuraavassa vaiheessa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bukan kotak untuk mendapat jawaban yang benar. Cukup tulis yang baru saja kamu alami dengan tanganmu. **Jika tidak ada yang terasa janggal, itu juga boleh ditulis.** Tempat yang kamu lewati tanpa sadar lebih penting di langkah berikutnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke en boks for å få riktig svar. Skriv bare det du nettopp opplevde med hendene. **Hvis ingenting føltes galt, kan du skrive det også.** Der du går forbi uten å legge merke til det betyr mer i neste steg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is geen vak om het juiste antwoord te geven. Schrijf gewoon op wat je net met je handen hebt ervaren. **Als niets raar voelde, mag je dat ook opschrijven.** Waar je zonder het te merken voorbijgaat, telt meer in de volgende stap."
          }
        }
      }
    },
