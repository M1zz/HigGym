          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan yang kamu jawab salah terkumpul di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørsmål du svarer feil på samles her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vragen die je fout hebt, verzamelen zich hier."
          }
        }
      }
    },
    "틀린 문항의 화면을 다시 열어 두 쪽을 나란히 보면 차이가 남습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen the screen for a question you missed and look at both versions side by side. The difference will show."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen the screen for a question you missed and look at both versions side by side. The difference will show."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違えた問題の画面をもう一度開いて両方を並べて見ると、違いがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틀린 문항의 화면을 다시 열어 두 쪽을 나란히 보면 차이가 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开做错的题的界面，把两边并排对比，差别就出来了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟做錯的題的介面，把兩邊並排對比，差別就出來了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте заново экран вопроса, на котором ошиблись, и сравните оба варианта рядом. Разница проявится."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir la pantalla de una pregunta que fallaste y mira ambas versiones una al lado de la otra. Se notará la diferencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Bildschirm zu einer verpassten Frage erneut und sieh dir beide Versionen nebeneinander an. Der Unterschied wird sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez l'écran d'une question manquée et regardez les deux versions côte à côte. La différence se verra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri la schermata di una domanda sbagliata e guarda le due versioni affiancate. La differenza si vedrà."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabra a tela de uma pergunta que você errou e veja as duas versões lado a lado. A diferença vai aparecer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดหน้าจอของข้อที่คุณพลาดอีกครั้ง แล้วดูสองเวอร์ชันเคียงกัน ความต่างจะปรากฏ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở lại màn hình của câu bạn đã sai và nhìn hai phiên bản cạnh nhau. Sự khác biệt sẽ lộ ra."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu otevřete obrazovku k otázce, kterou jste zmeškali, a podívejte se na obě verze vedle sebe. Rozdíl se ukáže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn skærmen igen til et spørgsmål, du ikke fik rigtigt, og se begge versioner side om side. Forskellen vil vise sig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε ξανά την οθόνη για μια ερώτηση που έχασες και δες τις δύο εκδόσεις δίπλα-δίπλα. Η διαφορά θα φανεί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa uudelleen näkymä kysymykselle, jonka menit väärin, ja katso molempia versioita rinnakkain. Ero tulee esiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kembali layar untuk pertanyaan yang kamu lewatkan dan lihat kedua versi berdampingan. Perbedaannya akan terlihat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne skjermen for et spørsmål du bommet på på nytt, og se de to versjonene side om side. Forskjellen vil vise seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open het scherm voor een gemiste vraag opnieuw en bekijk beide versies naast elkaar. Het verschil zal opvallen."
          }
        }
      }
    },
