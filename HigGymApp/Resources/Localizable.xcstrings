    "음악 재생 미니 플레이어처럼 어느 탭에 있든 유지돼야 하는 UI는?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which UI should persist no matter which tab you're on, like a music mini player?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Which UI should persist no matter which tab you're on, like a music mini player?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽のミニプレーヤーのように、どのタブにいても残るべきUIは？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 재생 미니 플레이어처럼 어느 탭에 있든 유지돼야 하는 UI는?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像音乐播放迷你播放器这样，无论在哪个标签都要保持的 UI 用什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像音樂播放迷你播放器這樣，無論在哪個標籤都要保持的 UI 用什麼？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой интерфейс должен сохраняться на любой вкладке, например мини-плеер музыки?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué interfaz debe persistir en cualquier pestaña, como un minirreproductor de música?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Oberfläche sollte in jedem Tab bestehen bleiben, wie ein Musik-Miniplayer?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle interface doit rester visible quel que soit l'onglet où vous êtes, comme un mini-lecteur de musique ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale UI dovrebbe restare qualunque scheda tu stia usando, come un mini player musicale?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual interface deve persistir em qualquer aba em que você esteja, como um mini player de música?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "UI ใดควรคงอยู่ไม่ว่าคุณอยู่แท็บไหน เช่นมินิเพลเยอร์เพลง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "UI nào nên luôn hiện dù bạn ở tab nào, như trình phát nhạc mini?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Které UI by mělo zůstat bez ohledu na kartu, na které jste, jako hudební mini přehrávač?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken brugerflade bør forblive, uanset hvilken fane du er på, som en musik-miniafspiller?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποια διεπαφή πρέπει να παραμένει ανεξάρτητα από την καρτέλα που βρίσκεσαι, όπως ένα μίνι πρόγραμμα αναπαραγωγής μουσικής;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Minkä käyttöliittymän pitäisi säilyä riippumatta siitä, millä välilehdellä olet, kuten musiikin minisoittimen?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "UI mana yang seharusnya bertahan di tab mana pun kamu berada, seperti mini player musik?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilket UI bør bestå uansett hvilken fane du er på, som en musikkminispiller?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke UI moet blijven staan op welk tabblad je ook zit, zoals een mini-muziekspeler?"
          }
        }
      }
    },
