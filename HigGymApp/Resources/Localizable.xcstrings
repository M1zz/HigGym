    "// 기준: 액션이 대상 위에 붙어 있는가?\n.swipeActions { Button(\"삭제\", role: .destructive) { … } }\n.contextMenu { … }": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: Is the action attached to its target?\n.swipeActions { Button(\"Delete\", role: .destructive) { … } }\n.contextMenu { … }"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: Is the action attached to its target?\n.swipeActions { Button(\"Delete\", role: .destructive) { … } }\n.contextMenu { … }"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "// 基準：アクションが対象の上に付いているか？\n.swipeActions { Button(\"削除\", role: .destructive) { … } }\n.contextMenu { … }"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "// 기준: 액션이 대상 위에 붙어 있는가?\n.swipeActions { Button(\"삭제\", role: .destructive) { … } }\n.contextMenu { … }"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "// 标准：操作是不是贴在它的对象上？\n.swipeActions { Button(\"删除\", role: .destructive) { … } }\n.contextMenu { … }"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "// 標準：操作是不是貼在它的物件上？\n.swipeActions { Button(\"刪除\", role: .destructive) { … } }\n.contextMenu { … }"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "// Критерий: находится ли действие прямо на объекте?\n.swipeActions { Button(\"Удалить\", role: .destructive) { … } }\n.contextMenu { … }"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterio: ¿Está la acción unida a su objetivo?\n.swipeActions { Button(\"Eliminar\", role: .destructive) { … } }\n.contextMenu { … }"
          }
