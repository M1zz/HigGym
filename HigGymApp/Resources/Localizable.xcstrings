    "쓸 수 있는 경우는 콘텐츠가 바 아래로 절대 지나가지 않을 때뿐입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can only use it when content never passes under the bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can only use it when content never passes under the bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使えるのは、コンテンツが絶対にバーの下を通らない場合だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓸 수 있는 경우는 콘텐츠가 바 아래로 절대 지나가지 않을 때뿐입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有内容绝不会从栏下方经过时，才能这样用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有內容絕不會從列下方經過時，才能這樣用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так можно делать, только если контент никогда не проходит под панелью."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo puedes usarlo cuando el contenido nunca pasa por debajo de la barra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst es nur nutzen, wenn Inhalt nie unter der Leiste vorbeizieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez l'utiliser que si le contenu ne passe jamais sous la barre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si può usare solo quando il contenuto non passa mai sotto la barra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só dá para usar quando o conteúdo nunca passa por baixo da barra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ได้เฉพาะเมื่อเนื้อหาไม่เคยผ่านใต้แถบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chỉ dùng được khi nội dung không bao giờ đi dưới thanh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použít to můžete, jen když obsah nikdy neprochází pod panelem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan kun bruge det, når indhold aldrig passerer under bjælken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να το χρησιμοποιείς μόνο όταν το περιεχόμενο δεν περνά ποτέ κάτω από τη γραμμή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit käyttää sitä vain, kun sisältö ei koskaan kulje palkin alta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu hanya bisa memakainya ketika konten tidak pernah lewat di bawah bilah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan bare bruke den når innhold aldri passerer under linjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt het alleen gebruiken als inhoud nooit onder de balk langs gaat."
          }
        }
      }
    },
    "아래 값들은 앱이 문자열을 만들지 않습니다. 같은 데이터가 로케일에 따라 다르게 렌더링되는 것을 확인하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app doesn't build the strings for the values below. See how the same data renders differently depending on the locale."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The app doesn't build the strings for the values below. See how the same data renders differently depending on the locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の値は、アプリが文字列を組み立てていません。同じデータがロケールによって違う形で表示されることを確かめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 값들은 앱이 문자열을 만들지 않습니다. 같은 데이터가 로케일에 따라 다르게 렌더링되는 것을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下面这些值，应用并没有拼接字符串。请确认同一份数据会按区域设置渲染成不同的样子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下面這些值，應用程式並沒有拼接字串。請確認同一份資料會按區域設定渲染成不同的樣子。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не собирает строки для значений ниже. Посмотрите, как одни и те же данные по-разному отображаются в зависимости от региона."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no construye las cadenas de los valores de abajo. Mira cómo los mismos datos se muestran de forma distinta según la configuración regional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App baut die Zeichenfolgen für die Werte unten nicht selbst. Sieh, wie dieselben Daten je nach Region unterschiedlich dargestellt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app ne construit pas les chaînes des valeurs ci-dessous. Voyez comment les mêmes données s'affichent différemment selon la région."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non costruisce le stringhe per i valori qui sotto. Guarda come gli stessi dati vengono resi in modo diverso a seconda delle impostazioni internazionali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não monta as strings dos valores abaixo. Veja como os mesmos dados são exibidos de forma diferente conforme o idioma e região."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปไม่สร้างสตริงสำหรับค่าด้านล่าง ดูว่าข้อมูลเดียวกันเรนเดอร์ต่างกันอย่างไรตามภาษาและภูมิภาค"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "App không dựng chuỗi cho các giá trị bên dưới. Xem cùng một dữ liệu được render khác nhau thế nào tùy ngôn ngữ và vùng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace nesestavuje řetězce pro níže uvedené hodnoty. Podívejte se, jak se stejná data vykreslují různě podle lokality."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen bygger ikke strengene for værdierne nedenfor. Se, hvordan de samme data renderes forskelligt afhængigt af landestandarden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή δεν φτιάχνει τις συμβολοσειρές για τις παρακάτω τιμές. Δες πώς τα ίδια δεδομένα αποδίδονται διαφορετικά ανάλογα με τη γλώσσα και περιοχή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus ei rakenna alla olevien arvojen merkkijonoja. Katso, miten samat tiedot renderöityvät eri tavoin kieliasetuksen mukaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi tidak membangun string untuk nilai di bawah. Lihat bagaimana data yang sama dirender secara berbeda tergantung locale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen bygger ikke strengene for verdiene nedenfor. Se hvordan de samme dataene vises ulikt avhengig av locale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app bouwt de tekenreeksen voor de onderstaande waarden niet. Zie hoe dezelfde gegevens anders worden weergegeven afhankelijk van de locale."
          }
        }
      }
    },
    "아래 문단을 **길게 눌러** 보세요, 선택·복사가 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Touch and hold** the paragraph below: you can select and copy."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Touch and hold** the paragraph below: you can select and copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の段落を**長押し**してみてください。選択もコピーもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 문단을 **길게 눌러** 보세요, 선택·복사가 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**长按**下面的段落，可以选择、复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**長按**下面的段落，可以選擇、複製。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Нажмите и удерживайте** абзац ниже: его можно выделить и скопировать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mantén pulsado** el párrafo de abajo: puedes seleccionar y copiar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Berühre und halte** den Absatz unten: Du kannst auswählen und kopieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Maintenez** le paragraphe ci-dessous : vous pouvez le sélectionner et le copier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tieni premuto** sul paragrafo qui sotto: puoi selezionare e copiare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toque e segure** o parágrafo abaixo: dá para selecionar e copiar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**แตะค้าง**ย่อหน้าด้านล่าง: เลือกและคัดลอกได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nhấn giữ** đoạn văn bên dưới: bạn có thể chọn và sao chép."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dotkněte se a podržte** odstavec níže: můžete vybrat a kopírovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tryk og hold** på afsnittet nedenfor: du kan markere og kopiere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Άγγιξε και κράτησε** την παρακάτω παράγραφο: μπορείς να επιλέξεις και να αντιγράψεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pidä painettuna** alla olevaa kappaletta: voit valita ja kopioida."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sentuh dan tahan** paragraf di bawah: kamu bisa memilih dan menyalin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trykk og hold** på avsnittet nedenfor: du kan markere og kopiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Houd ingedrukt** op de onderstaande alinea: je kunt selecteren en kopiëren."
          }
        }
      }
    },
    "아래 상자를 **길게 눌러** 보세요. 스위치를 끄면 같은 동작이 통하지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Touch and hold** the box below. Turn the switch off and the same gesture won't work."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Touch and hold** the box below. Turn the switch off and the same gesture won't work."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のボックスを**長押し**してみてください。スイッチをオフにすると、同じ操作が効きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 상자를 **길게 눌러** 보세요. 스위치를 끄면 같은 동작이 통하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**长按**下面的方框。关掉开关后，同样的操作就不管用了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**長按**下面的方框。關掉開關後，同樣的操作就不管用了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Нажмите и удерживайте** рамку ниже. Выключите переключатель, и тот же жест не сработает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mantén pulsada** la caja de abajo. Apaga el interruptor y el mismo gesto no funciona."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Berühre und halte** das Feld unten. Schalte den Schalter aus, und dieselbe Geste funktioniert nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Maintenez** la case ci-dessous. Désactivez l'interrupteur et le même geste ne fonctionnera pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tieni premuto** sul riquadro qui sotto. Disattiva l'interruttore e lo stesso gesto non funziona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toque e segure** a caixa abaixo. Desligue o interruptor e o mesmo gesto não funciona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**แตะค้าง**กล่องด้านล่าง ปิดสวิตช์แล้วท่าทางเดียวกันจะใช้ไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nhấn giữ** khung bên dưới. Tắt công tắc và cùng cử chỉ sẽ không hoạt động."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dotkněte se a podržte** rámeček níže. Vypněte přepínač a stejné gesto nebude fungovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tryk og hold** på feltet nedenfor. Slå kontakten fra, og den samme bevægelse virker ikke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Άγγιξε και κράτησε** το παρακάτω πλαίσιο. Απενεργοποίησε τον διακόπτη και η ίδια χειρονομία δεν λειτουργεί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Pidä painettuna** alla olevaa ruutua. Kytke kytkin pois, niin sama ele ei toimi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sentuh dan tahan** kotak di bawah. Matikan sakelar dan gerakan yang sama tidak akan berfungsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trykk og hold** på boksen nedenfor. Slå bryteren av, og den samme bevegelsen fungerer ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Houd ingedrukt** op het vak hieronder. Zet de schakelaar uit en hetzelfde gebaar werkt niet."
          }
        }
      }
    },
    "아래 슬라이더로 **글자 크기를 접근성 단계까지** 올려보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the slider below to raise **the text size into the accessibility sizes**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the slider below to raise **the text size into the accessibility sizes**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のスライダーで**文字サイズをアクセシビリティのサイズまで**上げてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 슬라이더로 **글자 크기를 접근성 단계까지** 올려보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用下面的滑块把**字号调到无障碍级别**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用下面的滑塊把**字號調到無障礙級別**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ползунком ниже **увеличьте размер текста до размеров универсального доступа**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el control deslizante de abajo para subir **el tamaño del texto hasta los tamaños de accesibilidad**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze den Schieberegler unten, um **die Textgröße in die Bedienungshilfen-Größen** zu erhöhen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le curseur ci-dessous pour monter **la taille du texte jusqu'aux tailles d'accessibilité**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il cursore qui sotto per portare **la dimensione del testo fino alle dimensioni di accessibilità**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o controle deslizante abaixo para levar **o tamanho do texto até os tamanhos de acessibilidade**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้แถบเลื่อนด้านล่างเพื่อเพิ่ม**ขนาดตัวอักษรไปยังขนาดสำหรับการช่วยการเข้าถึง**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng thanh trượt bên dưới để nâng **cỡ chữ lên các cỡ trợ năng**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí posuvníku níže zvyšte **velikost textu do velikostí přístupnosti**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug skyderen nedenfor til at hæve **tekststørrelsen op i tilgængelighedsstørrelserne**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε το παρακάτω ρυθμιστικό για να ανεβάσεις **το μέγεθος κειμένου στα μεγέθη προσβασιμότητας**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä alla olevaa liukusäädintä nostaaksesi **tekstikoon saavutettavuuskokoihin**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan penggeser di bawah untuk menaikkan **ukuran teks ke ukuran aksesibilitas**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk glidebryteren nedenfor til å øke **tekststørrelsen inn i tilgjengelighetsstørrelsene**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de schuifregelaar hieronder om **de tekstgrootte te verhogen tot de toegankelijkheidsgroottes**."
          }
        }
      }
    },
    "아래 이름·주소 예시에서는 어느 쪽이 맞는지 직접 골라보세요. 정답은 \"무엇이 식별에 쓰이는가\"입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the name and address examples below, pick which one is right yourself. The answer is \"what's used to identify it.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "For the name and address examples below, pick which one is right yourself. The answer is \"what's used to identify it.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の名前と住所の例では、どちらが正しいか自分で選んでみてください。答えは「何が識別に使われるか」です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 이름·주소 예시에서는 어느 쪽이 맞는지 직접 골라보세요. 정답은 \"무엇이 식별에 쓰이는가\"입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下面的姓名、地址示例中，亲自选出哪一边是对的。答案是“用什么来识别”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在下面的姓名、地址示例中，親自選出哪一邊是對的。答案是「用什麼來識別」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На примерах имён и адресов ниже сами выберите, какой вариант верный. Ответ - «по чему это идентифицируют»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los ejemplos de nombre y dirección de abajo, elige tú cuál es el correcto. La respuesta es «lo que sirve para identificarlo»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle bei den Namens- und Adressbeispielen unten selbst, welches richtig ist. Die Antwort lautet: „Was zur Identifikation dient.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les exemples de nom et d'adresse ci-dessous, choisissez vous-même le bon. La réponse est « ce qui sert à l'identifier »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Negli esempi di nomi e indirizzi qui sotto, scegli tu quale è corretto. La risposta è «ciò che serve a identificarlo»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nos exemplos de nome e endereço abaixo, escolha você mesmo qual está certo. A resposta é «o que serve para identificar»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับตัวอย่างชื่อและที่อยู่ด้านล่าง ให้เลือกเองว่าอันไหนถูก คำตอบคือ \"สิ่งที่ใช้ระบุตัวตน\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với các ví dụ tên và địa chỉ bên dưới, hãy tự chọn cái nào đúng. Đáp án là \"thứ được dùng để nhận diện\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U příkladů jmen a adres níže si sami vyberte, který je správný. Odpověď zní „co se používá k identifikaci“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For navne- og adresseeksemplerne nedenfor skal du selv vælge, hvilket der er rigtigt. Svaret er »hvad der bruges til at identificere det.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για τα παρακάτω παραδείγματα ονόματος και διεύθυνσης, διάλεξε μόνος σου ποιο είναι σωστό. Η απάντηση είναι «αυτό που χρησιμοποιείται για την αναγνώριση»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse alla olevista nimi- ja osoite-esimerkeistä itse, kumpi on oikein. Vastaus on ”mitä käytetään tunnistamiseen”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk contoh nama dan alamat di bawah, pilih sendiri mana yang benar. Jawabannya adalah \"apa yang dipakai untuk mengenalinya.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For navne- og adresseeksemplene nedenfor, velg selv hvilket som er riktig. Svaret er «det som brukes til å identifisere det»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies bij de onderstaande voorbeelden van naam en adres zelf welke goed is. Het antwoord is \"waarmee het wordt geïdentificeerd\"."
          }
        }
      }
    },
    "아래는 항상 hard가 맞다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard is always right at the bottom"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard is always right at the bottom"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部は常にhardが正しい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래는 항상 hard가 맞다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下方总是用 hard 才对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下方總是用 hard 才對"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снизу всегда подходит hard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard va siempre justo abajo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard gehört immer ganz nach unten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard est toujours juste en bas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard sta sempre proprio in fondo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard fica sempre bem no fim"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard อยู่ที่ด้านล่างสุดเสมอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard luôn ở ngay phía dưới"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard je vždycky správně dole"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard er altid rigtigt nederst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Hard είναι πάντα σωστό στο κάτω μέρος"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard on aina oikein alhaalla"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard selalu tepat di bagian bawah"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard er alltid riktig nederst"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard zit altijd helemaal onderaan"
          }
        }
      }
    },
    "아래로 쓸어내려 닫아보세요. 큰 시트의 기본 출구입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe down to close it. That's the default way out of a large sheet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe down to close it. That's the default way out of a large sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下にスワイプして閉じてみてください。大きいシートの基本の出口です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래로 쓸어내려 닫아보세요. 큰 시트의 기본 출구입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向下轻扫关闭。这是大弹层的默认出口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向下輕掃關閉。這是大工作表的預設出口。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смахните вниз, чтобы закрыть. Это стандартный выход для большой шторки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia abajo para cerrarla. Esa es la salida por defecto de una hoja large."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach unten zum Schließen. Das ist der Standardausgang eines großen Sheets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez vers le bas pour fermer. C'est la sortie par défaut d'une feuille large."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri verso il basso per chiuderlo. È il modo predefinito di uscire da un foglio grande."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize para baixo para fechar. Essa é a saída padrão de uma folha grande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปัดลงเพื่อปิด นั่นคือทางออกเริ่มต้นของชีต large"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuốt xuống để đóng. Đó là lối thoát mặc định của sheet large."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetím dolů to zavřete. To je výchozí cesta ven z velkého sheetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryg nedad for at lukke den. Det er standardudgangen fra et stort ark."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρε προς τα κάτω για να το κλείσεις. Αυτή είναι η προεπιλεγμένη έξοδος από ένα μεγάλο φύλλο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulje pyyhkäisemällä alas. Se on large-arkin oletusulospääsy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Usap ke bawah untuk menutupnya. Itu jalan keluar bawaan lembar large."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip ned for å lukke det. Det er standardveien ut av et large-ark."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg omlaag om te sluiten. Dat is de standaardmanier om uit een grote sheet te komen."
          }
        }
      }
    },
    "아래로 쓸어내려 보세요, **닫히지 않습니다**. 닫기 버튼만이 출구입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try swiping down: **it won't close**. The Close button is the only way out."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try swiping down: **it won't close**. The Close button is the only way out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下にスワイプしてみてください。**閉じません**。閉じるボタンだけが出口です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래로 쓸어내려 보세요, **닫히지 않습니다**. 닫기 버튼만이 출구입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向下轻扫看看，**关不掉**。只有关闭按钮才是出口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向下輕掃看看，**關不掉**。只有關閉按鈕才是出口。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте смахнуть вниз: **она не закроется**. Единственный выход - кнопка «Закрыть»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a deslizar hacia abajo: **no se cierra**. El botón Cerrar es la única salida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, nach unten zu wischen: **Es schließt sich nicht**. Der Schließen-Button ist der einzige Ausweg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de balayer vers le bas : **elle ne se ferme pas**. Le bouton Fermer est la seule issue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a scorrere verso il basso: **non si chiude**. Il pulsante Chiudi è l'unica via d'uscita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente deslizar para baixo: **não fecha**. O botão Fechar é a única saída."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองปัดลง: **มันไม่ปิด** ปุ่มปิดคือทางออกเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử vuốt xuống: **nó không đóng**. Nút Đóng là lối thoát duy nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste přejet dolů: **nezavře se**. Tlačítko Zavřít je jediná cesta ven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv at stryge nedad: **den lukker ikke**. Knappen Luk er den eneste udvej."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκίμασε να σύρεις προς τα κάτω: **δεν κλείνει**. Το κουμπί Κλείσιμο είναι η μόνη διέξοδος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile pyyhkäistä alas: **se ei sulkeudu**. Sulje-painike on ainoa tie ulos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba usap ke bawah: **tidak akan menutup**. Tombol Tutup adalah satu-satunya jalan keluar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv å sveipe ned: **det lukkes ikke**. Lukk-knappen er den eneste veien ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer omlaag te vegen: **hij sluit niet**. De knop Sluit is de enige uitweg."
          }
        }
      }
    },
