    "전부 눌러보세요. 다 동작하지만, 이 화면에서 **정말 필요한 것이 몇 개인지** 세어 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap them all. They all work, but count **how many this screen really needs**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap them all. They all work, but count **how many this screen really needs**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全部押してみてください。どれも動きますが、この画面で**本当に必要なものがいくつか**数えてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전부 눌러보세요. 다 동작하지만, 이 화면에서 **정말 필요한 것이 몇 개인지** 세어 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部点一遍。都能用，但请数一数这个界面**真正需要几个**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部點一遍。都能用，但請數一數這個介面**真正需要幾個**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите все. Работают все, но посчитайте, **сколько из них этому экрану действительно нужно**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tócalos todos. Todos funcionan, pero cuenta **cuántos necesita realmente esta pantalla**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe alle an. Alle funktionieren, aber zähle, **wie viele dieser Bildschirm wirklich braucht**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez-les tous. Tous fonctionnent, mais comptez **combien cet écran en a vraiment besoin**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccali tutti. Funzionano tutti, ma conta **quanti ne servono davvero a questa schermata**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em todos. Todos funcionam, mas conte **quantos esta tela realmente precisa**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะทั้งหมด ทุกอันใช้งานได้ แต่ลองนับว่า**หน้าจอนี้ต้องการจริง ๆ กี่อัน**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm tất cả. Chúng đều hoạt động, nhưng hãy đếm **màn hình này thật sự cần bao nhiêu**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na všechny. Všechny fungují, ale spočítejte, **kolik jich tato obrazovka skutečně potřebuje**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på dem alle. De virker alle, men tæl **hvor mange denne skærm virkelig behøver**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησέ τα όλα. Λειτουργούν όλα, αλλά μέτρα **πόσα χρειάζεται πραγματικά αυτή η οθόνη**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta niitä kaikkia. Ne kaikki toimivat, mutta laske, **montako tämä näkymä todella tarvitsee**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk semuanya. Semuanya berfungsi, tetapi hitung **berapa banyak yang benar-benar dibutuhkan layar ini**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på alle. Alle fungerer, men tell **hvor mange denne skjermen virkelig trenger**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op alles. Ze werken allemaal, maar tel **hoeveel dit scherm er echt nodig heeft**."
          }
        }
      }
    },
    "전부 맞혔습니다. 다른 유형으로 넘어가 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All correct. Try another type."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All correct. Try another type."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全問正解です。ほかのタイプに進んでみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전부 맞혔습니다. 다른 유형으로 넘어가 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部答对了。去试试其他题型吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部答對了。去試試其他題型吧。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё верно. Попробуйте другой тип."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo correcto. Prueba otro tipo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles richtig. Probiere einen anderen Typ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est correct. Essayez un autre type."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto corretto. Prova un altro tipo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo certo. Tente outro tipo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถูกทั้งหมด ลองชนิดอื่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đúng hết. Thử loại khác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechno správně. Zkuste jiný typ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt rigtigt. Prøv en anden type."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
