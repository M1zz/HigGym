        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'y a-t-il de mal à afficher le nom d'une personne avec `\"\\(firstName) \\(lastName)\"` ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Che cosa non va nel mostrare il nome di una persona come `\"\\(firstName) \\(lastName)\"`?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que há de errado em exibir o nome de uma pessoa como `\"\\(firstName) \\(lastName)\"`?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแสดงชื่อคนเป็น `\"\\(firstName) \\(lastName)\"` มีอะไรผิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị tên người dưới dạng `\"\\(firstName) \\(lastName)\"` có gì sai?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co je špatně na zobrazení jména osoby jako `\"\\(firstName) \\(lastName)\"`?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad er der galt med at vise en persons navn som `\"\\(firstName) \\(lastName)\"`?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τι πάει στραβά με την εμφάνιση του ονόματος ενός ατόμου ως `\"\\(firstName) \\(lastName)\"`;"
          }
        },
        "fi": {
