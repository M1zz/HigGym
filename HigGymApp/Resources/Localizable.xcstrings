    "minimumScaleFactor를 0.3까지 내려야 텍스트가 들어갑니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor has to go down to 0.3 before the text fits."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "minimumScaleFactor has to go down to 0.3 before the text fits."
          }
        },
