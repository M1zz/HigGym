    "항상 보이는 상단 서랍에 두면 세로 한 줄을 상시로 먹고, 손은 화면 위까지 올라가야 한다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting it in an always-visible top drawer permanently takes up a row of vertical space, and your hand has to reach the top of the screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting it in an always-visible top drawer permanently takes up a row of vertical space, and your hand has to reach the top of the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に見える上部のドロワーに置くと縦1行を常に占め、手は画面の上まで伸ばさなければならない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 보이는 상단 서랍에 두면 세로 한 줄을 상시로 먹고, 손은 화면 위까지 올라가야 한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放在始终可见的顶部抽屉里，会一直占掉纵向一行，手还得伸到屏幕上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放在始終可見的頂部抽屜裡，會一直佔掉縱向一行，手還得伸到螢幕上方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если поставить в постоянно видимую верхнюю выдвижную панель, она навсегда займёт строку по вертикали, а руке придётся тянуться вверх экрана."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponerlo en un cajón superior siempre visible ocupa permanentemente una fila de espacio vertical, y tu mano tiene que llegar a lo alto de la pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt man es in eine immer sichtbare obere Schublade, belegt es dauerhaft eine Zeile vertikalen Platz, und deine Hand muss bis an den oberen Bildschirmrand reichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mettre dans un tiroir du haut toujours visible occupe en permanence une ligne d'espace vertical, et votre main doit atteindre le haut de l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metterlo in un cassetto in alto sempre visibile occupa per sempre una riga di spazio verticale, e la mano deve raggiungere la parte alta dello schermo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocá-lo numa gaveta superior sempre visível ocupa para sempre uma linha de espaço vertical, e sua mão precisa chegar ao topo da tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวางไว้ในลิ้นชักด้านบนที่แสดงตลอดกินพื้นที่แนวตั้งหนึ่งแถวถาวร และมือของคุณต้องเอื้อมถึงด้านบนของหน้าจอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt nó trong ngăn trên luôn hiển thị chiếm vĩnh viễn một hàng không gian dọc, và tay bạn phải với lên đầu màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umístit to do vždy viditelné horní zásuvky trvale zabírá řádek svislého místa a vaše ruka musí dosáhnout až k hornímu okraji obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lægge den i en altid synlig øverste skuffe optager permanent en række lodret plads, og din hånd må række op til toppen af skærmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το να το βάλεις σε ένα πάντα ορατό πάνω συρτάρι καταλαμβάνει μόνιμα μια γραμμή κάθετου χώρου, και το χέρι σου πρέπει να φτάσει στην κορυφή της οθόνης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen laittaminen aina näkyvään ylälaatikkoon vie pysyvästi rivin pystytilaa, ja kätesi joutuu kurottamaan näytön yläreunaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menaruhnya di laci atas yang selalu terlihat memakan satu baris ruang vertikal secara permanen, dan tanganmu harus menjangkau bagian atas layar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å legge det i en alltid synlig øvre skuff tar permanent en rad med vertikal plass, og hånden din må strekke seg til toppen av skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het in een altijd zichtbare bovenlade zetten neemt permanent een rij verticale ruimte in, en je hand moet de bovenkant van het scherm bereiken."
          }
        }
      }
    },
