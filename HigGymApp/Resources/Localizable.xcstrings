    "닿기 쉬운 자리 · 안 쓸 때는 비켜 있기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy to reach · out of the way when unused"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Easy to reach · out of the way when unused"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手が届きやすい場所 · 使わないときは控えめに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닿기 쉬운 자리 · 안 쓸 때는 비켜 있기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容易够到的位置 · 不用时让开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "容易夠到的位置 · 不用時讓開"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Легко достать · не мешает, когда не нужно"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fácil de alcanzar · se aparta cuando no se usa"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leicht zu erreichen · aus dem Weg, wenn ungenutzt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facile à atteindre · discret quand il est inutilisé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facile da raggiungere · fuori dai piedi quando non serve"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fácil de alcançar · fora do caminho quando não usado"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอื้อมถึงง่าย · ไม่เกะกะเมื่อไม่ใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dễ với tới · không vướng khi không dùng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snadno dosažitelné · mimo cestu, když se nepoužívá"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem at nå · af vejen, når den ikke bruges"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εύκολα προσβάσιμο · εκτός δρόμου όταν δεν χρησιμοποιείται"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Helposti tavoitettavissa · pois tieltä, kun ei käytössä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudah dijangkau · tidak mengganggu saat tidak dipakai"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lett å nå · ute av veien når den ikke brukes"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Makkelijk te bereiken · uit de weg als het niet wordt gebruikt"
          }
        }
      }
    },
    "대비 증가, 투명도 줄이기, 동작 줄이기, 색상 없이 구별을 켜면 화면이 그에 맞게 바뀝니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Increase Contrast, Reduce Transparency, Reduce Motion, or Differentiate Without Color, and the screen adapts accordingly."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Increase Contrast, Reduce Transparency, Reduce Motion, or Differentiate Without Colour, and the screen adapts accordingly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントラストを上げる、透明度を下げる、視差効果を減らす、カラー以外で区別をオンにすると、画面がそれに合わせて変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대비 증가, 투명도 줄이기, 동작 줄이기, 색상 없이 구별을 켜면 화면이 그에 맞게 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“增强对比度”“降低透明度”“减弱动态效果”“区分颜色”后，界面会据此作出相应调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「增強對比度」「降低透明度」「減弱動態效果」「區分顏色」後，介面會據此作出相應調整。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите «Увеличение контраста», «Уменьшение прозрачности», «Уменьшение движения» или «Без цвета», и экран соответственно изменится."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Aumentar contraste, Reducir transparencia, Reducir movimiento o Diferenciar sin color, y la pantalla se adapta en consecuencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte „Kontrast erhöhen“, „Transparenz reduzieren“, „Bewegung reduzieren“ oder „Ohne Farben unterscheiden“ ein, und der Bildschirm passt sich entsprechend an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Augmenter le contraste, Réduire la transparence, Réduire les animations ou Différencier sans la couleur, et l'écran s'adapte en conséquence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Aumenta contrasto, Riduci trasparenza, Riduci movimento o Distingui senza colore, e la schermata si adatta di conseguenza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Aumentar Contraste, Reduzir Transparência, Reduzir Movimento ou Diferenciar sem Cor, e a tela se adapta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดเพิ่มความคมชัด ลดความโปร่งใส ลดการเคลื่อนไหว หรือแยกความต่างโดยไม่ใช้สี แล้วหน้าจอจะปรับตาม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Tăng độ tương phản, Giảm độ trong suốt, Giảm chuyển động hoặc Phân biệt không dựa vào màu, và màn hình sẽ thích ứng tương ứng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte Zvýšit kontrast, Omezit průhlednost, Omezit pohyb nebo Rozlišení bez barev a obrazovka se tomu přizpůsobí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Øg kontrast, Reducér gennemsigtighed, Reducér bevægelse eller Skeln uden farve til, og skærmen tilpasser sig derefter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποίησε Αύξηση αντίθεσης, Μείωση διαφάνειας, Μείωση κίνησης ή Διαφοροποίηση χωρίς χρώμα και η οθόνη προσαρμόζεται αναλόγως."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke päälle Lisää kontrastia, Vähennä läpinäkyvyyttä, Vähennä liikettä tai Erottele ilman väriä, niin näkymä mukautuu sen mukaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Tingkatkan Kontras, Kurangi Transparansi, Kurangi Gerakan, atau Bedakan Tanpa Warna, dan layar menyesuaikan diri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Øk kontrast, Reduser gjennomsiktighet, Reduser bevegelse eller Skille uten farge, og skjermen tilpasser seg deretter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Verhoog contrast, Verminder transparantie, Verminder beweging of Onderscheid zonder kleur aan, en het scherm past zich dienovereenkomstig aan."
          }
        }
      }
    },
