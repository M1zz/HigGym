    "버튼 색을 더 밝은 흰색으로 바꾼다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the button color a brighter white"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the button colour a brighter white"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンの色をもっと明るい白に変える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼 색을 더 밝은 흰색으로 바꾼다"
