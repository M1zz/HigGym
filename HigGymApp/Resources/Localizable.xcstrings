    "`\"\\(distance) km\"` 로 조립하고 미국이면 변환한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build it as `\"\\(distance) km\"` and convert it yourself for the US"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Build it as `\"\\(distance) km\"` and convert it yourself for the US"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(distance) km\"` で組み立て、アメリカなら自前で変換する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(distance) km\"` 로 조립하고 미국이면 변환한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 `\"\\(distance) km\"` 拼接，如果是美国就进行换算"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 `\"\\(distance) km\"` 拼接，如果是美國就進行換算"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собрать строкой `\"\\(distance) km\"` и конвертировать, если США"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Constrúyelo como `\"\\(distance) km\"` y conviértelo tú mismo para EE. UU."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baue es als `\"\\(distance) km\"` und rechne es für die USA selbst um"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construisez-le en `\"\\(distance) km\"` et convertissez-le vous-même pour les États-Unis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruiscilo come `\"\\(distance) km\"` e convertilo tu per gli Stati Uniti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte como `\"\\(distance) km\"` e converta você mesmo para os EUA"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างเป็น `\"\\(distance) km\"` แล้วแปลงเองสำหรับสหรัฐฯ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xây thành `\"\\(distance) km\"` rồi tự quy đổi cho người dùng ở Mỹ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sestavit to jako `\"\\(distance) km\"` a převádět si to pro USA sami"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Byg den som `\"\\(distance) km\"` og konvertér den selv for USA"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτιάξ' το ως `\"\\(distance) km\"` και μετάτρεψέ το μόνος σου για τις ΗΠΑ"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenna se muodossa `\"\\(distance) km\"` ja muunna itse Yhdysvaltoja varten"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun sebagai `\"\\(distance) km\"` dan konversi sendiri untuk AS"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg den som `\"\\(distance) km\"` og konverter den selv for USA"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw het als `\"\\(distance) km\"` en reken het zelf om voor de VS"
          }
        }
      }
    },
    "`\"\\(km) km\"`, 로케일을 바꿔도 그대로입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: it stays the same even when you change the locale."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: it stays the same even when you change the locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`。ロケールを変えてもそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`, 로케일을 바꿔도 그대로입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`，即使切换区域也保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`，即使切換區域也保持不變。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: остаётся прежним, даже если сменить регион."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: se queda igual aunque cambies la configuración regional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: bleibt gleich, auch wenn du die Region änderst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"` : cela reste identique même quand vous changez de région."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: resta uguale anche quando cambi regione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: continua igual mesmo quando você muda o idioma e região."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: ค่านี้ยังเท่าเดิมแม้เปลี่ยนภาษาและภูมิภาค"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: nó vẫn y nguyên dù bạn đổi ngôn ngữ và vùng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: zůstane stejné, i když změníte lokalitu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: den forbliver den samme, selv når du ændrer landestandard."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: μένει το ίδιο ακόμα και όταν αλλάζεις τη γλώσσα και περιοχή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: se pysyy samana, vaikka vaihdat kieliasetusta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: tetap sama meski kamu mengubah locale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: den forblir den samme selv når du endrer locale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: het blijft hetzelfde, ook als je de locale wijzigt."
          }
        }
      }
    },
    "`.hard` 경계 ↔ 효과 끔(`scrollEdgeEffectHidden`). 사진과 배치는 같습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard` edge ↔ effect off (`scrollEdgeEffectHidden`). Same photo, same layout."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard` edge ↔ effect off (`scrollEdgeEffectHidden`). Same photo, same layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard` の境界 ↔ エフェクトオフ（`scrollEdgeEffectHidden`）。写真もレイアウトも同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard` 경계 ↔ 효과 끔(`scrollEdgeEffectHidden`). 사진과 배치는 같습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard` 边界 ↔ 关闭效果（`scrollEdgeEffectHidden`）。和照片的布局相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard` 邊界 ↔ 關閉效果（`scrollEdgeEffectHidden`）。和照片的佈局相同。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Граница `.hard` ↔ эффект выключен (`scrollEdgeEffectHidden`). Та же фотография, та же раскладка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borde `.hard` ↔ efecto desactivado (`scrollEdgeEffectHidden`). La misma foto, el mismo diseño."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`-Kante ↔ Effekt aus (`scrollEdgeEffectHidden`). Dasselbe Foto, dasselbe Layout."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bord `.hard` ↔ effet désactivé (`scrollEdgeEffectHidden`). Même photo, même disposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bordo `.hard` ↔ effetto disattivato (`scrollEdgeEffectHidden`). Stessa foto, stesso layout."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Borda `.hard` ↔ efeito desligado (`scrollEdgeEffectHidden`). Mesma foto, mesmo layout."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบ `.hard` ↔ ปิดเอฟเฟกต์ (`scrollEdgeEffectHidden`) รูปเดียวกัน เลย์เอาต์เดียวกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cạnh `.hard` ↔ tắt hiệu ứng (`scrollEdgeEffectHidden`). Cùng một ảnh, cùng một bố cục."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okraj `.hard` ↔ efekt vypnutý (`scrollEdgeEffectHidden`). Stejná fotka, stejné rozvržení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`-kant ↔ effekt slået fra (`scrollEdgeEffectHidden`). Samme foto, samme layout."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άκρη `.hard` ↔ εφέ απενεργοποιημένο (`scrollEdgeEffectHidden`). Ίδια φωτογραφία, ίδια διάταξη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`-reuna ↔ efekti pois (`scrollEdgeEffectHidden`). Sama kuva, sama asettelu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepi `.hard` ↔ efek mati (`scrollEdgeEffectHidden`). Foto sama, tata letak sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`-kant ↔ effekt av (`scrollEdgeEffectHidden`). Samme bilde, samme oppsett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`-rand ↔ effect uit (`scrollEdgeEffectHidden`). Dezelfde foto, dezelfde layout."
          }
        }
      }
    },
    "`.hard`, 경계가 스스로 대비를 만듭니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`: the edge creates its own contrast."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`: the edge creates its own contrast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`。境界が自らコントラストを生み出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`, 경계가 스스로 대비를 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`，边界自己制造对比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`，邊界自己製造對比。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`: граница сама создаёт контраст."
          }
