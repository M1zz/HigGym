    "값과 표기를 누가 갖는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who owns the value and the format?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Who owns the value and the format?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値と表記は誰が持つのか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값과 표기를 누가 갖는가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值和写法由谁来持有"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值和寫法由誰來持有"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кому принадлежат значение и запись"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
