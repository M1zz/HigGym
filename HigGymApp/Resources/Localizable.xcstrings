            "value": ".toolbar {\n    ToolbarItemGroup(placement: .topBarLeading) {\n        Button(grid ? \"List\" : \"Grid\", systemImage: grid ? \"list.bullet\" : \"square.grid.2x2\") {\n            grid.toggle()\n        }\n        Menu(\"Sort\", systemImage: \"arrow.up.arrow.down\") { /* sort order */ }\n    }\n    ToolbarItemGroup(placement: .topBarTrailing) {\n        Button(\"Select\", systemImage: \"checkmark.circle\") { selecting.toggle() }\n        Button(\"Share\", systemImage: \"square.and.arrow.up\") { share() }\n    }\n}"
