    "그림으로 구성을 잡았다면, 실행해서 시스템이 그리는 진짜 탭바와 접힘 동작을 확인해보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you've sketched the setup, run it and check the real tab bar the system draws and how it collapses."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you've sketched the setup, run it and check the real tab bar the system draws and how it collapses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図で構成を決めたら、実行してシステムが描く本物のタブバーと折りたたみの動作を確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림으로 구성을 잡았다면, 실행해서 시스템이 그리는 진짜 탭바와 접힘 동작을 확인해보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果用图把结构定下来了，请运行一下，确认系统绘制的真实标签栏和折叠行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果用圖把結構定下來了，請執行一下，確認系統繪製的真實標籤列和摺疊行為。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набросав схему, запустите её и сверьте с настоящей панелью вкладок, которую рисует система, и с тем, как она сворачивается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hayas esbozado la configuración, ejecútala y comprueba la barra de pestañas real que dibuja el sistema y cómo se colapsa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du die Konfiguration skizziert hast, führe sie aus und prüfe die echte Tab-Leiste, die das System zeichnet, und wie sie zusammenklappt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois la configuration esquissée, lancez-la et vérifiez la vraie barre d'onglets que dessine le système et comment elle se replie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta abbozzata la configurazione, eseguila e controlla la vera barra delle schede che disegna il sistema e come si comprime."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de esboçar a configuração, execute e confira a barra de abas real que o sistema desenha e como ela recolhe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อร่างการตั้งค่าเสร็จ ให้รันแล้วตรวจแถบแท็บจริงที่ระบบวาดและวิธีที่มันยุบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đã phác thảo cấu hình, hãy chạy nó và kiểm tra thanh tab thật mà hệ thống vẽ và cách nó thu gọn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile nastavení načrtnete, spusťte ho a zkontrolujte skutečný panel karet, který systém vykreslí, a jak se sbaluje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har skitseret opsætningen, så kør den og tjek den rigtige fanelinje, systemet tegner, og hvordan den klapper sammen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφού σχεδιάσεις τη διάταξη, εκτέλεσέ την και έλεγξε την πραγματική γραμμή καρτελών που σχεδιάζει το σύστημα και πώς συμπτύσσεται."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun olet hahmotellut asetelman, suorita se ja tarkista järjestelmän piirtämä todellinen välilehtipalkki ja se, miten se tiivistyy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah kamu membuat sketsa penataannya, jalankan dan periksa bilah tab asli yang digambar sistem dan bagaimana ia menciut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har skissert oppsettet, kjør det og sjekk den ekte fanelinjen systemet tegner og hvordan den kollapser."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de opzet hebt geschetst, voer hem uit en controleer de echte tabbalk die het systeem tekent en hoe hij inklapt."
          }
        }
      }
    },
    "그림으로 배치를 잡았다면, 실행해서 시스템이 그리는 진짜 툴바와 대조해보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you've sketched the layout, run it and compare it with the real toolbar the system draws."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you've sketched the layout, run it and compare it with the real toolbar the system draws."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図で配置を決めたら、実行してシステムが描く本物のツールバーと見比べてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림으로 배치를 잡았다면, 실행해서 시스템이 그리는 진짜 툴바와 대조해보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果用图把布局定下来了，请运行一下，和系统绘制的真实工具栏对照一下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果用圖把佈局定下來了，請執行一下，和系統繪製的真實工具列對照一下。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набросав раскладку, запустите её и сверьте с настоящей панелью инструментов, которую рисует система."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hayas esbozado el diseño, ejecútalo y compáralo con la barra de herramientas real que dibuja el sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das Layout skizziert hast, führe es aus und vergleiche es mit der echten Symbolleiste, die das System zeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois la disposition esquissée, lancez-la et comparez-la à la vraie barre d'outils que dessine le système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta abbozzato il layout, eseguilo e confrontalo con la vera barra degli strumenti che disegna il sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de esboçar o layout, execute e compare com a barra de ferramentas real que o sistema desenha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อร่างเลย์เอาต์เสร็จ ให้รันแล้วเปรียบเทียบกับแถบเครื่องมือจริงที่ระบบวาด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đã phác thảo bố cục, hãy chạy nó và so sánh với thanh công cụ thật mà hệ thống vẽ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakmile rozvržení načrtnete, spusťte ho a porovnejte se skutečným panelem nástrojů, který systém vykreslí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har skitseret layoutet, så kør det og sammenlign med den rigtige værktøjslinje, systemet tegner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφού σχεδιάσεις τη διάταξη, εκτέλεσέ την και σύγκρινέ την με την πραγματική γραμμή εργαλείων που σχεδιάζει το σύστημα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun olet hahmotellut asettelun, suorita se ja vertaa sitä järjestelmän piirtämään todelliseen työkalupalkkiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah kamu membuat sketsa tata letaknya, jalankan dan bandingkan dengan bilah alat asli yang digambar sistem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du har skissert layouten, kjør den og sammenlign med den ekte verktøylinjen systemet tegner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de layout hebt geschetst, voer hem uit en vergelijk hem met de echte werkbalk die het systeem tekent."
          }
        }
      }
    },
    "그림의 부위를 눌러보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a part of the illustration"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a part of the illustration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図の部分をタップしてみてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림의 부위를 눌러보세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按图中的各个部位"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點圖中的各個部位"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на часть иллюстрации"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una parte de la ilustración"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Teil der Illustration"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une partie de l'illustration"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una parte dell'illustrazione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque numa parte da ilustração"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะส่วนหนึ่งของภาพประกอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm một phần của hình minh họa"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na část ilustrace"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en del af illustrationen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε ένα τμήμα της εικόνας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta kuvituksen osaa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk bagian dari ilustrasi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en del av illustrasjonen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een deel van de illustratie"
          }
        }
      }
    },
    "그림이 아니라 실제로 동작하는 화면, 눌러보고 스크롤해 보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a picture but a working screen: tap and scroll around"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a picture but a working screen: tap and scroll around"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵ではなく実際に動く画面です。タップしたりスクロールしたりしてみてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림이 아니라 실제로 동작하는 화면, 눌러보고 스크롤해 보세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是图，而是真正能运行的界面，点按、滚动试试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是圖，而是真正能執行的介面，輕點、滾動試試"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не картинка, а работающий экран: нажимайте и прокручивайте"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es una imagen sino una pantalla que funciona: toca y desplázate"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Bild, sondern ein funktionierender Bildschirm: tippen und scrollen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas une image mais un écran fonctionnel : touchez et faites défiler"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non un'immagine ma una schermata funzionante: tocca e scorri"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é uma imagem, é uma tela funcionando: toque e role à vontade"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่รูปภาพ แต่เป็นหน้าจอที่ใช้งานได้: แตะและเลื่อนดูได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phải hình ảnh mà là một màn hình hoạt động: chạm và cuộn thử"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne obrázek, ale funkční obrazovka: klepejte a posouvejte"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke et billede, men en fungerende skærm: tryk og scroll rundt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όχι εικόνα αλλά λειτουργική οθόνη: πάτα και κύλα όπου θέλεις"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei kuva vaan toimiva näkymä: napauta ja vieritä ympäriinsä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan gambar melainkan layar yang berfungsi: ketuk dan gulir ke sekeliling"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke et bilde, men en fungerende skjerm: trykk og rull rundt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen plaatje maar een werkend scherm: tik en scroll rond"
          }
        }
      }
    },
    "그만큼 \"떠 있는 유리\" 느낌은 줄어듭니다, 가독성과 재료감을 맞바꾼 구성입니다(8.1.4).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The \"floating glass\" feel is reduced accordingly: this setup trades a sense of material for readability (8.1.4)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The \"floating glass\" feel is reduced accordingly: this setup trades a sense of material for readability (8.1.4)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのぶん「浮いたガラス」の感じは弱まります。読みやすさと素材感を引き換えにした構成です（8.1.4）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그만큼 \"떠 있는 유리\" 느낌은 줄어듭니다, 가독성과 재료감을 맞바꾼 구성입니다(8.1.4)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“悬浮玻璃”的感觉会因此减弱：用可读性换取了材质感（8.1.4）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「懸浮玻璃」的感覺會因此減弱：用可讀性換取了材質感（8.1.4）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ощущение «парящего стекла» соответственно ослабевает: такая схема меняет ощущение материала на читаемость (8.1.4)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensación de «cristal flotante» se reduce en consecuencia: esta configuración cambia sensación de material por legibilidad (8.1.4)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gefühl von „schwebendem Glas“ nimmt entsprechend ab: Diese Konfiguration tauscht Materialgefühl gegen Lesbarkeit (8.1.4)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensation de « verre flottant » est réduite d'autant : cette configuration échange une impression de matière contre de la lisibilité (8.1.4)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sensazione di «vetro fluttuante» si riduce di conseguenza: questa configurazione scambia un senso di materia con la leggibilità (8.1.4)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sensação de «vidro flutuante» diminui de acordo: esta configuração troca sensação de material por legibilidade (8.1.4)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความรู้สึก “กระจกลอย” ลดลงตามนั้น: การตั้งค่านี้แลกความรู้สึกของวัสดุกับความอ่านออก (8.1.4)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm giác \"kính nổi\" giảm đi tương ứng: cấu hình này đánh đổi cảm giác vật liệu lấy khả năng đọc (8.1.4)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocit „vznášejícího se skla“ se tím odpovídajícím způsobem snižuje: toto nastavení vyměňuje pocit materiálu za čitelnost (8.1.4)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornemmelsen af »svævende glas« reduceres tilsvarende: denne opsætning bytter en materialefornemmelse for læsbarhed (8.1.4)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αίσθηση «πλωτού γυαλιού» μειώνεται αναλόγως: αυτή η διάταξη ανταλλάσσει την αίσθηση υλικού με αναγνωσιμότητα (8.1.4)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Kelluvan lasin” tuntu vähenee vastaavasti: tämä asetelma vaihtaa materiaalin tunnun luettavuuteen (8.1.4)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesan \"kaca mengambang\" berkurang sesuai itu: penataan ini menukar rasa material dengan keterbacaan (8.1.4)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«Flytende glass»-følelsen reduseres tilsvarende: dette oppsettet bytter materialfølelse mot lesbarhet (8.1.4)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het \"zwevend glas\"-gevoel wordt dienovereenkomstig minder: deze opzet ruilt materiaalgevoel voor leesbaarheid (8.1.4)."
          }
        }
      }
    },
