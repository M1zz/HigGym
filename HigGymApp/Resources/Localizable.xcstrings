    "액션은 그 대상 위에 붙어야 한다, 어느 쪽이 폴더 전환을 제대로 뒀습니까?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An action should sit on its target. Which one placed the folder switch correctly?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An action should sit on its target. Which one placed the folder switch correctly?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションはその対象の上に付くべきだ。フォルダの切り替えを正しく置いたのはどちらか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액션은 그 대상 위에 붙어야 한다, 어느 쪽이 폴더 전환을 제대로 뒀습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作要贴在它的对象上：哪一边把切换文件夹放对了？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作要貼在它的物件上：哪一邊把切換資料夾放對了？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие должно находиться на своём объекте. В каком варианте переключение папок размещено верно?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una acción debe estar sobre su objetivo. ¿Cuál colocó bien el cambio de carpeta?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aktion sollte auf ihrem Ziel sitzen. Welche hat den Ordnerwechsel richtig platziert?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une action doit se trouver sur sa cible. Lequel a placé correctement le changement de dossier ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'azione dovrebbe stare sul suo bersaglio. Quale ha collocato correttamente l'interruttore della cartella?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ação deve ficar no seu alvo. Qual colocou corretamente a troca de pasta?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำควรอยู่บนเป้าหมายของมัน อันไหนวางสวิตช์โฟลเดอร์ถูกต้อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một hành động nên nằm trên đối tượng của nó. Cái nào đặt nút chuyển thư mục đúng?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akce by měla sedět na svém cíli. Která umístila přepínání složek správně?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En handling bør sidde på sit mål. Hvilken placerede mappeskiftet rigtigt?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ενέργεια πρέπει να βρίσκεται πάνω στον στόχο της. Ποιο τοποθέτησε σωστά τον διακόπτη φακέλου;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toiminnon tulisi olla kohteessaan. Kumpi sijoitti kansionvaihdon oikein?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksi harus berada pada targetnya. Mana yang menempatkan pengalih folder dengan benar?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En handling bør ligge på målet sitt. Hvilken plasserte mappebryteren riktig?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een actie hoort op zijn doel te zitten. Welke plaatste de mapschakelaar goed?"
          }
        }
      }
    },
    "액션은 대상 위에 있어야 무엇을 지우는지가 분명하다. 미는 동작이 한 단계 역할을 해서 오탭도 막는다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the action on its target, it's clear what you're deleting. The swipe also acts as an extra step that prevents mis-taps."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With the action on its target, it's clear what you're deleting. The swipe also acts as an extra step that prevents mis-taps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションが対象の上にあってこそ、何を消すのかがはっきりする。スワイプする動作がワンステップの役割を果たし、誤タップも防ぐ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액션은 대상 위에 있어야 무엇을 지우는지가 분명하다. 미는 동작이 한 단계 역할을 해서 오탭도 막는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作在对象上，删除什么才清楚。滑动这个动作相当于多了一步，也防止了误点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作在物件上，刪除什麼才清楚。滑動這個動作相當於多了一步，也防止了誤點。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда действие на своём объекте, ясно, что именно вы удаляете. Смахивание к тому же работает как дополнительный шаг, защищающий от случайных нажатий."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la acción sobre su objetivo, está claro qué estás eliminando. El deslizamiento también actúa como un paso extra que evita toques erróneos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzt die Aktion auf ihrem Ziel, ist klar, was du löschst. Das Wischen wirkt zudem als zusätzlicher Schritt, der Fehltipper verhindert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l'action sur sa cible, on voit clairement ce que vous supprimez. Le balayage joue aussi le rôle d'étape supplémentaire qui évite les faux touchers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con l'azione sul suo bersaglio, è chiaro che cosa stai eliminando. Lo scorrimento funge anche da passo in più che previene i tocchi accidentali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a ação no próprio alvo, fica claro o que você está excluindo. O deslize também funciona como um passo extra que evita toques errados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อการกระทำอยู่บนเป้าหมาย ก็ชัดเจนว่าคุณกำลังลบอะไร การปัดยังเป็นอีกหนึ่งขั้นที่ป้องกันการแตะพลาดด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với hành động nằm trên đối tượng, rõ ràng bạn đang xóa gì. Cú vuốt cũng đóng vai một bước thêm để ngăn chạm nhầm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S akcí na jejím cíli je jasné, co mažete. Přejetí také působí jako krok navíc, který brání klepnutím omylem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med handlingen på sit mål er det tydeligt, hvad du sletter. Strygningen fungerer også som et ekstra trin, der forhindrer fejltryk."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με την ενέργεια πάνω στον στόχο της, είναι σαφές τι διαγράφεις. Το σύρσιμο λειτουργεί επίσης ως επιπλέον βήμα που εμποδίζει τα κατά λάθος πατήματα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun toiminto on kohteessaan, on selvää, mitä poistat. Pyyhkäisy toimii myös lisäaskeleena, joka estää vahingossa napautukset."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan aksi pada targetnya, jelas apa yang kamu hapus. Usapan juga berfungsi sebagai langkah ekstra yang mencegah salah ketuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med handlingen på målet er det tydelig hva du sletter. Sveipet fungerer også som et ekstra steg som hindrer feiltrykk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met de actie op zijn doel is duidelijk wat je verwijdert. Het vegen werkt ook als extra stap die verkeerd tikken voorkomt."
          }
        }
      }
    },
