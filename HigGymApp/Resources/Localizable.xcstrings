    "카드 번호를 **몇 자 입력한 뒤** 쿠폰함 탭에 갔다가 돌아와 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Type a few digits** of the card number, then go to the Coupons tab and come back."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Type a few digits** of the card number, then go to the Coupons tab and come back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード番号を**数桁入力してから**、クーポンタブに移動して戻ってきてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 번호를 **몇 자 입력한 뒤** 쿠폰함 탭에 갔다가 돌아와 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在卡号里**输入几个数字**后，去优惠券标签页再回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在卡號裡**輸入幾個數字**後，去優惠券標籤頁再回來。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Введите несколько цифр** номера карты, затем перейдите на вкладку «Купоны» и вернитесь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Escribe unas cifras** del número de tarjeta, luego ve a la pestaña Cupones y vuelve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tippe ein paar Ziffern** der Kartennummer ein, gehe dann zum Tab „Gutscheine“ und komm zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Saisissez quelques chiffres** du numéro de carte, puis allez dans l'onglet Coupons et revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Digita qualche cifra** del numero della carta, poi vai alla scheda Coupon e torna indietro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Digite alguns dígitos** do número do cartão, depois vá à aba Cupons e volte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**พิมพ์ตัวเลขสองสามตัว**ของเลขบัตร แล้วไปที่แท็บคูปองและกลับมา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gõ vài chữ số** của số thẻ, rồi sang tab Phiếu giảm giá và quay lại."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Zadejte pár číslic** čísla karty, pak přejděte na kartu Kupóny a vraťte se."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Indtast nogle få cifre** af kortnummeret, gå så til fanen Kuponer, og kom tilbage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Πληκτρολόγησε μερικά ψηφία** του αριθμού κάρτας, μετά πήγαινε στην καρτέλα Κουπόνια και γύρνα πίσω."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kirjoita muutama numero** kortin numerosta, siirry sitten Kupongit-välilehdelle ja palaa takaisin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ketik beberapa digit** nomor kartu, lalu buka tab Kupon dan kembali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Skriv inn noen få sifre** av kortnummeret, gå deretter til Kuponger-fanen og kom tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Typ een paar cijfers** van het kaartnummer, ga dan naar het tabblad Coupons en kom terug."
          }
        }
      }
    },
    "카드 정보를 다시 입력해야 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have to enter your card details again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You have to enter your card details again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード情報をもう一度入力する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 정보를 다시 입력해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新输入银行卡信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要重新輸入銀行卡資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реквизиты карты придётся вводить заново."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes que volver a introducir los datos de la tarjeta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst deine Kartendaten erneut eingeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez ressaisir vos informations de carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi inserire di nuovo i dati della carta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem de inserir os dados do cartão de novo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องกรอกรายละเอียดบัตรอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn phải nhập lại thông tin thẻ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Musíte zadat údaje o kartě znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må indtaste dine kortoplysninger igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει να εισαγάγεις ξανά τα στοιχεία της κάρτας σου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joudut syöttämään korttitietosi uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu harus memasukkan lagi detail kartumu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du må skrive inn kortopplysningene dine på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet je kaartgegevens opnieuw invoeren."
          }
        }
      }
    },
    "카드를 눌러 시트를 열어보세요, 아래에서 위로 올라오는 기본 전환입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a card to open the sheet: the standard transition that slides up from the bottom."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a card to open the sheet: the standard transition that slides up from the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードをタップしてシートを開いてみてください。下から上がってくる標準のトランジションです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드를 눌러 시트를 열어보세요, 아래에서 위로 올라오는 기본 전환입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按卡片打开弹层，这是从下往上升起的默认转场。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點卡片開啟工作表，這是從下往上升起的預設轉場。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на карточку, чтобы открыть шторку: стандартный переход, выезжающий снизу."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tarjeta para abrir la hoja: la transición estándar que sube desde abajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Karte, um das Sheet zu öffnen: der Standardübergang, der von unten hereingleitet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une carte pour ouvrir la feuille : la transition standard qui glisse depuis le bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una scheda per aprire il foglio: la transizione standard che sale dal basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num cartão para abrir a folha: a transição padrão que sobe de baixo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะการ์ดเพื่อเปิดชีต: ทรานซิชันมาตรฐานที่เลื่อนขึ้นจากด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm một thẻ để mở sheet: chuyển cảnh chuẩn trượt lên từ dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na kartu, otevře se sheet: standardní přechod, který vyjede zespodu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et kort for at åbne arket: standardovergangen, der glider op nedefra."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε μια κάρτα για να ανοίξει το φύλλο: η τυπική μετάβαση που ανεβαίνει από κάτω."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta korttia avataksesi arkin: tavallinen siirtymä, joka liukuu ylös alareunasta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kartu untuk membuka lembar: transisi standar yang meluncur naik dari bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et kort for å åpne arket: standardovergangen som glir opp fra bunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een kaart om de sheet te openen: de standaardovergang die van onderaf omhoog schuift."
          }
        }
      }
    },
    "카드를 눌러보세요, 시트가 **그 카드 자리에서 확대**되어 나옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a card: the sheet **zooms out from that card's spot**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a card: the sheet **zooms out from that card's spot**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードをタップしてみてください。シートが**そのカードの位置から拡大して**現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드를 눌러보세요, 시트가 **그 카드 자리에서 확대**되어 나옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按卡片，弹层会**从那张卡片的位置放大**出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點卡片，工作表會**從那張卡片的位置放大**出現。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на карточку: шторка **увеличивается из места этой карточки**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tarjeta: la hoja **sale ampliándose desde el sitio de esa tarjeta**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Karte: Das Sheet **zoomt von der Stelle dieser Karte heraus**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une carte : la feuille **zoome depuis l'emplacement de cette carte**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una scheda: il foglio **si ingrandisce dal punto di quella scheda**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num cartão: a folha **se amplia a partir do lugar daquele cartão**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะการ์ด: ชีต**ซูมออกมาจากตำแหน่งของการ์ดนั้น**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm một thẻ: sheet **phóng ra từ vị trí của thẻ đó**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na kartu: sheet se **přiblíží z místa té karty**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et kort: arket **zoomer ud fra det korts plads**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε μια κάρτα: το φύλλο **κάνει zoom έξω από τη θέση εκείνης της κάρτας**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta korttia: arkki **zoomaa ulos kyseisen kortin paikalta**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kartu: lembar **zoom keluar dari tempat kartu itu**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et kort: arket **zoomer ut fra det kortets plass**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een kaart: de sheet **zoomt uit vanaf de plek van die kaart**."
          }
        }
      }
    },
    "카드를 탭하면 그 카드의 상세 시트가 열립니다. 전환은?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping a card opens that card's detail sheet. Which transition?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping a card opens that card's detail sheet. Which transition?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードをタップすると、そのカードの詳細シートが開きます。トランジションは？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드를 탭하면 그 카드의 상세 시트가 열립니다. 전환은?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按卡片会打开该卡片的详情弹层。转场用什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點卡片會開啟該卡片的詳情工作表。轉場用什麼？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажатие на карточку открывает шторку с её подробностями. Какой переход?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tocar una tarjeta se abre la hoja de detalle de esa tarjeta. ¿Qué transición?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Antippen einer Karte öffnet das Detail-Sheet dieser Karte. Welcher Übergang?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher une carte ouvre la feuille de détail de cette carte. Quelle transition ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccando una scheda si apre il foglio di dettaglio di quella scheda. Quale transizione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar num cartão abre a folha de detalhe desse cartão. Qual transição?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแตะการ์ดเปิดชีตรายละเอียดของการ์ดนั้น ทรานซิชันแบบไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm một thẻ mở sheet chi tiết của thẻ đó. Chuyển cảnh nào?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutí na kartu otevře detailní sheet té karty. Který přechod?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et tryk på et kort åbner det korts detaljeark. Hvilken overgang?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πάτημα μιας κάρτας ανοίγει το φύλλο λεπτομερειών της. Ποια μετάβαση;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortin napauttaminen avaa kortin yksityiskohtaisen arkin. Mikä siirtymä?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengetuk kartu membuka lembar detail kartu itu. Transisi yang mana?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å trykke på et kort åpner detaljarket til det kortet. Hvilken overgang?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je op een kaart tikt, opent de detailsheet van die kaart. Welke overgang?"
          }
        }
      }
    },
