    "축소 한계를 0.3까지 낮추면 어디까지 읽히는지 확인해 보세요. 읽히지 않으면 축소는 실패입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the scale limit to 0.3 and see how far it stays readable. If it can't be read, scaling has failed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the scale limit to 0.3 and see how far it stays readable. If it can't be read, scaling has failed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小の下限を0.3まで下げて、どこまで読めるか確認してみてください。読めなければ縮小は失敗です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축소 한계를 0.3까지 낮추면 어디까지 읽히는지 확인해 보세요. 읽히지 않으면 축소는 실패입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把缩小下限降到 0.3，看看能读到什么程度。读不清，缩小就是失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把縮小下限降到 0.3，看看能讀到什麼程度。讀不清，縮小就是失敗。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опустите предел масштаба до 0,3 и посмотрите, до какой степени остаётся читаемо. Если читать нельзя, масштабирование провалилось."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja el límite de escala a 0,3 y mira hasta dónde sigue siendo legible. Si no se puede leer, el escalado ha fallado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senke das Skalierungslimit auf 0,3 und sieh, wie weit es lesbar bleibt. Lässt es sich nicht lesen, ist die Skalierung gescheitert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abaissez la limite d'échelle à 0,3 et voyez jusqu'où cela reste lisible. Si on ne peut pas lire, la mise à l'échelle a échoué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbassa il limite di scala a 0,3 e guarda fino a dove resta leggibile. Se non si legge, la scalatura ha fallito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe o limite de escala para 0,3 e veja até onde continua legível. Se não dá para ler, a escala falhou."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลดขีดจำกัดการปรับขนาดเหลือ 0.3 แล้วดูว่ายังอ่านออกได้แค่ไหน ถ้าอ่านไม่ออก การปรับขนาดก็ล้มเหลว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạ giới hạn co xuống 0.3 và xem nó còn đọc được đến đâu. Nếu không đọc được, co chữ đã thất bại."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snižte limit škálování na 0,3 a podívejte se, jak daleko zůstává čitelné. Pokud se nedá přečíst, škálování selhalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sænk skaleringsgrænsen til 0,3, og se, hvor langt den forbliver læselig. Hvis den ikke kan læses, har skaleringen fejlet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χαμήλωσε το όριο κλιμάκωσης στο 0,3 και δες μέχρι πού μένει ευανάγνωστο. Αν δεν μπορεί να διαβαστεί, η κλιμάκωση απέτυχε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laske skaalausraja arvoon 0,3 ja katso, kuinka pitkälle se pysyy luettavana. Jos sitä ei voi lukea, skaalaus on epäonnistunut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Turunkan batas skala ke 0,3 dan lihat sejauh mana ia tetap terbaca. Jika tidak bisa dibaca, penskalaan telah gagal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Senk skaleringsgrensen til 0,3 og se hvor langt det forblir lesbart. Hvis det ikke kan leses, har skaleringen sviktet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlaag de schaallimiet naar 0,3 en zie hoe ver het leesbaar blijft. Als het niet te lezen is, is schalen mislukt."
          }
        }
      }
    },
    "축소·분리·자리 확보를 조합해 한 툴바 안에서 공존시키는 게 이 항목의 요지입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The point of this topic is combining scaling, separation, and reserved space so everything coexists in one toolbar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The point of this topic is combining scaling, separation, and reserved space so everything coexists in one toolbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小・分離・スペース確保を組み合わせて、ひとつのツールバーの中で共存させることがこのトピックの要点です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축소·분리·자리 확보를 조합해 한 툴바 안에서 공존시키는 게 이 항목의 요지입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把缩小、分离、预留位置组合起来，让它们在同一个工具栏里共存，这是这一项的要点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把縮小、分離、預留位置組合起來，讓它們在同一個工具列裡共存，這是這一項的要點。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смысл этой темы - совместить масштабирование, разделение и зарезервированное место так, чтобы всё уживалось на одной панели инструментов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sentido de este tema es combinar escalado, separación y espacio reservado para que todo coexista en una barra de herramientas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sinn dieses Themas ist, Skalierung, Trennung und reservierten Platz so zu kombinieren, dass alles in einer Symbolleiste nebeneinander besteht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'objet de cette rubrique est de combiner mise à l'échelle, séparation et espace réservé pour que tout coexiste dans une seule barre d'outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il punto di questo argomento è combinare scalatura, separazione e spazio riservato perché tutto coesista in un'unica barra degli strumenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O objetivo deste tópico é combinar escala, separação e espaço reservado para que tudo conviva numa única barra de ferramentas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประเด็นของหัวข้อนี้คือการรวมการปรับขนาด การแยก และพื้นที่สำรอง เพื่อให้ทุกอย่างอยู่ร่วมกันในแถบเครื่องมือเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ý chính của chủ đề này là kết hợp co chữ, tách biệt và không gian dành sẵn để mọi thứ cùng tồn tại trong một thanh công cụ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smyslem tohoto tématu je kombinovat škálování, oddělení a rezervované místo tak, aby vše koexistovalo v jednom panelu nástrojů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointen med dette emne er at kombinere skalering, adskillelse og reserveret plads, så alt sameksisterer i én værktøjslinje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το νόημα αυτού του θέματος είναι να συνδυάσεις κλιμάκωση, διαχωρισμό και δεσμευμένο χώρο ώστε όλα να συνυπάρχουν σε μία γραμμή εργαλείων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän aiheen pointti on yhdistää skaalaus, erottelu ja varattu tila niin, että kaikki on rinnakkain yhdessä työkalupalkissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Inti topik ini adalah menggabungkan penskalaan, pemisahan, dan ruang yang disisihkan agar semuanya hidup berdampingan dalam satu bilah alat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Poenget med dette emnet er å kombinere skalering, separasjon og reservert plass slik at alt eksisterer sammen i én verktøylinje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kern van dit onderwerp is schalen, scheiden en gereserveerde ruimte combineren zodat alles samen in één werkbalk past."
          }
        }
      }
    },
    "축소가 아니라 설계 문제, 폭을 늘리거나 표기를 줄인다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a design problem, not a scaling one: make it wider or shorten the text"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a design problem, not a scaling one: make it wider or shorten the text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小ではなく設計の問題。幅を広げるか表記を短くする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축소가 아니라 설계 문제, 폭을 늘리거나 표기를 줄인다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是缩小，而是设计问题：增加宽度或缩短写法"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是縮小，而是設計問題：增加寬度或縮短寫法"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это проблема дизайна, а не масштабирования: сделать шире или сократить текст"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un problema de diseño, no de escalado: hazlo más ancho o acorta el texto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein Designproblem, kein Skalierungsproblem: Mache es breiter oder kürze den Text"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un problème de design, pas d'échelle : élargissez ou raccourcissez le texte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un problema di design, non di scalatura: allargalo o accorcia il testo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um problema de design, não de escala: alargue ou encurte o texto"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นปัญหาการออกแบบ ไม่ใช่เรื่องการปรับขนาด: ทำให้กว้างขึ้นหรือย่อข้อความ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là vấn đề thiết kế, không phải co chữ: làm nó rộng hơn hoặc rút ngắn văn bản"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to problém designu, ne škálování: udělejte to širší nebo zkraťte text"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er et designproblem, ikke et skaleringsproblem: gør det bredere eller forkort teksten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι πρόβλημα σχεδιασμού, όχι κλιμάκωσης: κάν' το πλατύτερο ή συντόμευσε το κείμενο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on suunnitteluongelma, ei skaalausongelma: tee siitä leveämpi tai lyhennä tekstiä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini masalah desain, bukan penskalaan: buat lebih lebar atau perpendek teksnya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er et designproblem, ikke et skaleringsproblem: gjør det bredere eller kort ned teksten"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is een ontwerpprobleem, geen schaalprobleem: maak het breder of kort de tekst in"
          }
        }
      }
    },
    "출구가 뒤로가기 하나뿐입니다. 몰입은 얻고 이동성은 잃습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only way out is Back. You gain immersion and lose mobility."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The only way out is Back. You gain immersion and lose mobility."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出口が「戻る」ひとつだけです。没入感は得られますが、移動のしやすさを失います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출구가 뒤로가기 하나뿐입니다. 몰입은 얻고 이동성은 잃습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出口只有返回一个。得到了沉浸，失去了可移动性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出口只有返回一個。得到了沉浸，失去了可移動性。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Единственный выход - «Назад». Вы получаете погружение и теряете подвижность."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La única salida es Atrás. Ganas inmersión y pierdes movilidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der einzige Ausweg ist Zurück. Du gewinnst Immersion und verlierst Beweglichkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seule issue est Retour. Vous gagnez en immersion et perdez en mobilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'unica via d'uscita è Indietro. Guadagni immersione e perdi mobilità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A única saída é Voltar. Você ganha imersão e perde mobilidade."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทางออกเดียวคือย้อนกลับ คุณได้ความดื่มด่ำและเสียความคล่องตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lối thoát duy nhất là Quay lại. Bạn được sự đắm chìm và mất sự linh hoạt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jediná cesta ven je Zpět. Získáte pohlcení a ztratíte pohyblivost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den eneste vej ud er Tilbage. Du får fordybelse og mister mobilitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μόνη διέξοδος είναι το Πίσω. Κερδίζεις εμβύθιση και χάνεις κινητικότητα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainoa tie ulos on Takaisin. Saat immersion ja menetät liikkuvuuden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu-satunya jalan keluar adalah Kembali. Kamu mendapat imersi dan kehilangan mobilitas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den eneste veien ut er Tilbake. Du får oppslukthet og mister mobilitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De enige uitweg is Terug. Je wint onderdompeling en verliest mobiliteit."
          }
        }
      }
    },
