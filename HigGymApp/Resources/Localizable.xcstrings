    "콘텐츠가 바 뒤를 지날 때 컨트롤이 읽히게 하는 층. 최악의 배경에서 검증해야 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layer that keeps controls readable as content passes behind the bar. You have to verify it on the worst background."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The layer that keeps controls readable as content passes behind the bar. You have to verify it on the worst background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツがバーの後ろを通るときにコントロールを読めるようにする層。最悪の背景で検証する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠가 바 뒤를 지날 때 컨트롤이 읽히게 하는 층. 최악의 배경에서 검증해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让内容从栏后经过时控件仍然读得清的一层。必须在最糟糕的背景上验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓內容從列後經過時控制元件仍然讀得清的一層。必須在最糟糕的背景上驗證。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слой, который сохраняет читаемость элементов управления, когда контент проходит за панелью. Проверять нужно на худшем фоне."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La capa que mantiene legibles los controles mientras el contenido pasa por detrás de la barra. Hay que verificarla sobre el peor fondo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ebene, die Steuerelemente lesbar hält, während Inhalt hinter der Leiste vorbeizieht. Du musst es auf dem schlechtesten Hintergrund prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couche qui garde les contrôles lisibles quand le contenu passe derrière la barre. Vous devez la vérifier sur le pire arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo strato che mantiene leggibili i controlli mentre il contenuto passa dietro la barra. Devi verificarlo sullo sfondo peggiore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A camada que mantém os controles legíveis enquanto o conteúdo passa atrás da barra. É preciso verificar sobre o pior fundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชั้นที่ทำให้ตัวควบคุมอ่านออกขณะเนื้อหาผ่านด้านหลังแถบ คุณต้องตรวจบนพื้นหลังที่แย่ที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lớp giữ cho các điều khiển đọc được khi nội dung đi qua phía sau thanh. Bạn phải kiểm chứng nó trên nền tệ nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrstva, která udržuje ovladače čitelné, když obsah prochází za panelem. Musíte to ověřit na nejhorším pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lag, der holder kontroller læselige, mens indhold passerer bag bjælken. Du skal verificere det på den værste baggrund."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το στρώμα που κρατά τους ελέγχους ευανάγνωστους καθώς το περιεχόμενο περνά πίσω από τη γραμμή. Πρέπει να το επαληθεύσεις στο χειρότερο φόντο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerros, joka pitää säätimet luettavina, kun sisältö kulkee palkin takaa. Se on varmistettava pahimmalla taustalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapisan yang menjaga kontrol tetap terbaca saat konten lewat di belakang bilah. Kamu harus memverifikasinya pada latar terburuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laget som holder kontrollene lesbare mens innholdet passerer bak linjen. Du må verifisere det på den verste bakgrunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laag die bedieningselementen leesbaar houdt terwijl inhoud achter de balk langs gaat. Je moet het controleren op de slechtste achtergrond."
          }
        }
      }
    },
    "콘텐츠가 자연스럽게 흘러 사라지는 기본값입니다, 목록·피드처럼 배경이 잔잔한 화면의 표준입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default, where content flows and fades away naturally. It's the standard for screens with calm backgrounds, like lists and feeds."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The default, where content flows and fades away naturally. It's the standard for screens with calm backgrounds, like lists and feeds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツが自然に流れて消えていくデフォルトです。リストやフィードのように背景が穏やかな画面の標準です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠가 자연스럽게 흘러 사라지는 기본값입니다, 목록·피드처럼 배경이 잔잔한 화면의 표준입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容自然流过并消失的默认值，是列表、信息流这类背景平静的界面的标准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容自然流過並消失的預設值，是列表、資訊流這類背景平靜的介面的標準。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартное поведение, когда контент естественно уходит и растворяется. Это норма для экранов со спокойным фоном, вроде списков и лент."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor por defecto, en el que el contenido fluye y se desvanece con naturalidad. Es el estándar de pantallas con fondos tranquilos, como listas y feeds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standard, bei dem Inhalt fließt und natürlich ausblendet. Er ist der Standard für Bildschirme mit ruhigem Hintergrund, wie Listen und Feeds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réglage par défaut, où le contenu s'écoule et s'estompe naturellement. C'est la norme pour les écrans à arrière-plan calme, comme les listes et les flux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il predefinito, in cui il contenuto scorre e svanisce in modo naturale. È lo standard per le schermate con sfondi calmi, come elenchi e feed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão, em que o conteúdo flui e esmaece naturalmente. É o padrão para telas com fundos calmos, como listas e feeds."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าเริ่มต้นที่เนื้อหาไหลและจางหายไปอย่างเป็นธรรมชาติ เป็นมาตรฐานสำหรับหน้าจอที่พื้นหลังสงบ เช่นรายการและฟีด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định, nơi nội dung chảy và mờ dần một cách tự nhiên. Là chuẩn cho các màn hình có nền yên tĩnh, như danh sách và bảng tin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí, kde obsah přirozeně plyne a mizí. Je standardem pro obrazovky s klidným pozadím, jako jsou seznamy a kanály."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standarden, hvor indhold flyder og naturligt toner ud. Det er standarden for skærme med rolige baggrunde, som lister og feeds."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η προεπιλογή, όπου το περιεχόμενο ρέει και σβήνει φυσικά. Είναι το πρότυπο για οθόνες με ήρεμα φόντα, όπως λίστες και ροές."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletus, jossa sisältö virtaa ja häipyy luonnollisesti. Se on standardi rauhallisen taustan näkymille, kuten luetteloille ja syötteille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawaan, tempat konten mengalir dan memudar secara alami. Ini standar untuk layar dengan latar tenang, seperti daftar dan feed."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Standarden, der innholdet flyter og tones bort naturlig. Det er standarden for skjermer med rolige bakgrunner, som lister og feeder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De standaard, waarbij inhoud natuurlijk stroomt en vervaagt. Het is de norm voor schermen met rustige achtergronden, zoals lijsten en feeds."
          }
        }
      }
    },
    "콘텐츠와 바 사이에 hard 경계를 둬서 대비를 배경에 맡기지 않았다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a hard boundary between the content and the bar, so contrast isn't left to the background."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a hard boundary between the content and the bar, so contrast isn't left to the background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツとバーの間に hard の境界を置き、コントラストを背景任せにしなかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠와 바 사이에 hard 경계를 둬서 대비를 배경에 맡기지 않았다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在内容和栏之间设了 hard 边界，对比度不再依赖背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在內容和列之間設了 hard 邊界，對比度不再依賴背景。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте жёсткую границу между контентом и панелью, чтобы не оставлять контраст на волю фона."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon un límite hard entre el contenido y la barra, para que el contraste no dependa del fondo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze eine harte Grenze zwischen Inhalt und Leiste, damit der Kontrast nicht dem Hintergrund überlassen bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez une limite nette entre le contenu et la barre, pour ne pas laisser le contraste dépendre de l'arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti un confine netto tra il contenuto e la barra, così il contrasto non è lasciato allo sfondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponha uma fronteira hard entre o conteúdo e a barra, para que o contraste não fique à mercê do fundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางขอบแข็งระหว่างเนื้อหากับแถบ เพื่อไม่ให้ความตัดกันขึ้นกับพื้นหลัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt một ranh giới hard giữa nội dung và thanh, để độ tương phản không phó mặc cho nền."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte mezi obsah a panel tvrdou hranici, aby se kontrast nenechal na pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt en hård grænse mellem indholdet og bjælken, så kontrasten ikke overlades til baggrunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε ένα σκληρό όριο ανάμεσα στο περιεχόμενο και τη γραμμή, ώστε η αντίθεση να μην αφήνεται στο φόντο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aseta kova raja sisällön ja palkin väliin, jotta kontrasti ei jää taustan varaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh batas hard antara konten dan bilah, sehingga kontras tidak diserahkan pada latar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett en hard grense mellom innholdet og linjen, så kontrasten ikke overlates til bakgrunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een harde grens tussen de inhoud en de balk, zodat contrast niet aan de achtergrond wordt overgelaten."
          }
        }
      }
    },
