        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκίμασε να κυλήσεις: ο τίτλος **δεν συμπτύσσεται** και μένει σε πλήρες μέγεθος στη γραμμή πλοήγησης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile vierittää: otsikko **ei tiivisty** vaan pysyy täysikokoisena navigointipalkissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba gulir: judul **tidak menciut** dan tetap berukuran penuh di bilah navigasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv å rulle: tittelen **kollapser ikke** og forblir i full størrelse i navigasjonslinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer te scrollen: de titel **klapt niet in** en blijft op volle grootte in de navigatiebalk."
          }
        }
      }
    },
    "스크롤해 보세요, 탭바가 접히면서 액세서리가 **그 자리로 내려앉습니다**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try scrolling: as the tab bar minimizes, the accessory **settles into its place**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try scrolling: as the tab bar minimises, the accessory **settles into its place**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールしてみてください。タブバーが縮むと、アクセサリが**その場所に降りてきます**。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤해 보세요, 탭바가 접히면서 액세서리가 **그 자리로 내려앉습니다**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动一下，标签栏折叠，附件**落到它的位置**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動一下，標籤列摺疊，附件**落到它的位置**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите: когда панель вкладок сворачивается, accessory **занимает её место**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a desplazar: al minimizarse la barra de pestañas, el accesorio **se acomoda en su sitio**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche zu scrollen: Während die Tab-Leiste minimiert, **rutscht das Accessory an ihren Platz**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de faire défiler : quand la barre d'onglets se réduit, l'accessoire **vient prendre sa place**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a scorrere: mentre la barra delle schede si riduce, l'accessorio **si sistema al suo posto**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente rolar: enquanto a barra de abas minimiza, o acessório **se acomoda no lugar**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองเลื่อน: เมื่อแถบแท็บย่อลง อุปกรณ์เสริม**เข้าที่ของมัน**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử cuộn: khi thanh tab thu nhỏ, phụ kiện **về đúng chỗ của nó**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste posouvat: jak se panel karet minimalizuje, příslušenství **zapadne na své místo**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv at scrolle: når fanelinjen minimeres, **falder tilbehøret på plads**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκίμασε να κυλήσεις: καθώς η γραμμή καρτελών ελαχιστοποιείται, το εξάρτημα **κάθεται στη θέση του**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile vierittää: kun välilehtipalkki pienenee, accessory **asettuu paikalleen**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba gulir: saat bilah tab menciut, accessory **menempati tempatnya**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv å rulle: når fanelinjen minimeres, **setter accessoryen seg på plass**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer te scrollen: terwijl de tabbalk minimaliseert, **zet het accessoire zich op zijn plek**."
          }
        }
      }
    },
    "스크롤해 보세요, 탭바는 접히고 **검색 캡슐은 남습니다**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try scrolling: the tab bar minimizes and **the search capsule stays**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try scrolling: the tab bar minimises and **the search capsule stays**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールしてみてください。タブバーは縮み、**検索カプセルは残ります**。"
