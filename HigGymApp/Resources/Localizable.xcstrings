            "state": "translated",
            "value": "¿Qué tiene de malo mostrar el nombre de una persona como `\"\\(firstName) \\(lastName)\"`?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist falsch daran, den Namen einer Person als `\"\\(firstName) \\(lastName)\"` anzuzeigen?"
