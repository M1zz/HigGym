    "쓴 글을 저장하고 레슨을 닫습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save what you wrote and close the lesson"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Save what you wrote and close the lesson"
          }
        },
        "ja": {
