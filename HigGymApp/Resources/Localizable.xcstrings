    "무엇을 넣는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What goes in"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What goes in"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を入れるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 넣는가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放什么"
          }
        },
        "zh-Hant": {
          "stringUnit": {
