    "툴바 아이템 넷 ↔ 하나. 공유·별표는 사라진 게 아니라 본문 컨텍스트 메뉴에 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four toolbar items ↔ one. Share and Star didn't disappear; they're in the content's context menu."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Four toolbar items ↔ one. Share and Star didn't disappear; they're in the content's context menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーアイテム4つ ↔ 1つ。共有とスターは消えたのではなく、本文のコンテキストメニューにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "툴바 아이템 넷 ↔ 하나. 공유·별표는 사라진 게 아니라 본문 컨텍스트 메뉴에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏项目四个 ↔ 一个。分享、星标没有消失，而是在正文的上下文菜单里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列項目四個 ↔ 一個。分享、星標沒有消失，而是在正文的上下文選單裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре элемента панели ↔ один. «Поделиться» и «Звезда» не пропали, они в контекстном меню контента."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro elementos de la barra de herramientas ↔ uno. Compartir y Destacar no desaparecieron; están en el menú contextual del contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Symbolleisten-Elemente ↔ eines. Teilen und Markieren sind nicht verschwunden; sie stehen im Kontextmenü des Inhalts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre éléments de barre d'outils ↔ un. Partager et Favori n'ont pas disparu ; ils sont dans le menu contextuel du contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quattro elementi della barra degli strumenti ↔ uno. Condividi e Preferiti non sono spariti; sono nel menu contestuale del contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro itens da barra de ferramentas ↔ um. Compartilhar e Favorito não sumiram; estão no menu de contexto do conteúdo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการแถบเครื่องมือสี่รายการ ↔ หนึ่งรายการ แชร์และติดดาวไม่ได้หายไป อยู่ในเมนูบริบทของเนื้อหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn mục thanh công cụ ↔ một. Chia sẻ và Gắn sao không biến mất; chúng ở trong menu ngữ cảnh của nội dung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtyři položky panelu nástrojů ↔ jedna. Sdílet a Hvězdička nezmizely; jsou v kontextové nabídce obsahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire værktøjslinjeelementer ↔ ét. Del og Stjerne forsvandt ikke; de ligger i indholdets kontekstmenu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τέσσερα στοιχεία γραμμής εργαλείων ↔ ένα. Η Κοινοποίηση και το Αστέρι δεν εξαφανίστηκαν· βρίσκονται στο μενού περιβάλλοντος του περιεχομένου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neljä työkalupalkin kohdetta ↔ yksi. Jaa ja Tähti eivät kadonneet; ne ovat sisällön kontekstivalikossa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Empat item bilah alat ↔ satu. Bagikan dan Bintang tidak hilang; mereka ada di menu konteks konten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire verktøylinjeelementer ↔ ett. Del og Stjerne forsvant ikke; de ligger i innholdets kontekstmeny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier werkbalkitems ↔ één. Deel en Ster zijn niet verdwenen; ze zitten in het contextmenu van de inhoud."
          }
        }
      }
    },
    "툴바 아이템을 네 개에서 두 개로 줄였습니다. 나머지는 오버플로로 접었어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cut the toolbar items from four to two and folded the rest into overflow."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "I cut the toolbar items from four to two and folded the rest into overflow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーアイテムを4つから2つに減らしました。残りはオーバーフローに折りたたんでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "툴바 아이템을 네 개에서 두 개로 줄였습니다. 나머지는 오버플로로 접었어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把工具栏项目从四个减到两个。其余的折叠进了溢出菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把工具列項目從四個減到兩個。其餘的摺疊進了溢位選單。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я сократил элементы панели с четырёх до двух, а остальное свернул в переполнение."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduje los elementos de la barra de herramientas de cuatro a dos y pasé el resto al desbordamiento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe die Symbolleisten-Elemente von vier auf zwei gekürzt und den Rest in den Überlauf gefaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai ramené les éléments de la barre d'outils de quatre à deux et replié le reste dans le débordement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho ridotto gli elementi della barra degli strumenti da quattro a due e ripiegato il resto nell'overflow."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzi os itens da barra de ferramentas de quatro para dois e dobrei o resto no overflow."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันลดรายการแถบเครื่องมือจากสี่เหลือสองและพับที่เหลือเข้าเมนูส่วนเกิน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi rút các mục thanh công cụ từ bốn xuống hai và gập phần còn lại vào mục tràn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snížil jsem položky panelu nástrojů ze čtyř na dvě a zbytek sbalil do přetečení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg skar værktøjslinjens elementer ned fra fire til to og foldede resten ind i overløb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έκοψα τα στοιχεία της γραμμής εργαλείων από τέσσερα σε δύο και δίπλωσα τα υπόλοιπα στο υπερχείλισμα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Karsin työkalupalkin kohteet neljästä kahteen ja taitoin loput ylivuotoon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku memangkas item bilah alat dari empat menjadi dua dan melipat sisanya ke overflow."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg kuttet verktøylinjeelementene fra fire til to og foldet resten inn i overflyt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb de werkbalkitems van vier naar twee teruggebracht en de rest in overflow gevouwen."
          }
        }
      }
    },
    "툴바 아이템이 많아 공간이 모자랍니다. 시스템은 어떻게 처리하나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are too many toolbar items for the space. How does the system handle it?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There are too many toolbar items for the space. How does the system handle it?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーアイテムが多くてスペースが足りません。システムはどう処理しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "툴바 아이템이 많아 공간이 모자랍니다. 시스템은 어떻게 처리하나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具栏项目很多，空间不够。系统会怎么处理？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具列項目很多，空間不夠。系統會怎麼處理？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На панели инструментов слишком много элементов, места не хватает. Как поступает система?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiados elementos en la barra de herramientas para el espacio. ¿Cómo lo gestiona el sistema?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt zu viele Symbolleisten-Elemente für den Platz. Wie geht das System damit um?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a trop d'éléments de barre d'outils pour la place. Comment le système s'en occupe-t-il ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono troppi elementi nella barra degli strumenti per lo spazio. Come li gestisce il sistema?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há itens demais na barra de ferramentas para o espaço. Como o sistema lida com isso?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการแถบเครื่องมือมีมากเกินกว่าพื้นที่ ระบบจัดการอย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có quá nhiều mục thanh công cụ so với không gian. Hệ thống xử lý thế nào?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na panelu nástrojů je příliš mnoho položek na to místo. Jak to systém řeší?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er for mange værktøjslinjeelementer til pladsen. Hvordan håndterer systemet det?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχουν πάρα πολλά στοιχεία γραμμής εργαλείων για τον χώρο. Πώς το χειρίζεται το σύστημα;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalupalkissa on liikaa kohteita tilaan nähden. Miten järjestelmä käsittelee sen?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak item bilah alat untuk ruangnya. Bagaimana sistem menanganinya?"
          }
        },
