            "state": "translated",
            "value": "この画面でいちばんよく行う操作を、下部の右端に置いた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면에서 가장 자주 하는 일을 하단 오른쪽 끝에 뒀다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这个界面最常做的事放在了底部最右端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
