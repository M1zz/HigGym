    "바와 콘텐츠의 경계를 또렷이 나눕니다, 표·폼처럼 구조가 중요한 화면에 맞습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draws a crisp line between bar and content, which suits structured screens like tables and forms."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Draws a crisp line between bar and content, which suits structured screens like tables and forms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーとコンテンツの境界をくっきり分けます。表やフォームのように構造が大切な画面に向いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바와 콘텐츠의 경계를 또렷이 나눕니다, 표·폼처럼 구조가 중요한 화면에 맞습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把栏和内容的边界划分得很清楚，适合表格、表单这类结构重要的界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把列和內容的邊界劃分得很清楚，適合表格、表單這類結構重要的介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проводит чёткую линию между панелью и контентом, что подходит структурным экранам вроде таблиц и форм."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traza una línea nítida entre la barra y el contenido, lo que va bien a pantallas estructuradas como tablas y formularios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieht eine scharfe Linie zwischen Leiste und Inhalt, was zu strukturierten Bildschirmen wie Tabellen und Formularen passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace une ligne nette entre la barre et le contenu, ce qui convient aux écrans structurés comme les tableaux et les formulaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia una linea netta tra barra e contenuto, il che si addice a schermate strutturate come tabelle e moduli."
          }
        }
      }
    },
