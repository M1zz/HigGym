    "화요일 오후 3시로 옮겨도 괜찮을까요? 회의실은 그대로 3층입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could we move it to Tuesday at 3 PM? Still in the 3rd-floor meeting room."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Could we move it to Tuesday at 3 PM? Still in the 3rd-floor meeting room."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "火曜の午後3時に変更しても大丈夫でしょうか？会議室は変わらず3階です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화요일 오후 3시로 옮겨도 괜찮을까요? 회의실은 그대로 3층입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改到周二下午 3 点可以吗？会议室不变，还是 3 楼。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改到週二下午 3 點可以嗎？會議室不變，還是 3 樓。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно перенести на вторник, 15:00? Переговорная всё та же, на 3 этаже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Podríamos pasarlo al martes a las 15:00? Sigue siendo en la sala de reuniones de la 3.ª planta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Können wir es auf Dienstag, 15 Uhr verschieben? Weiterhin im Besprechungsraum im 3. Stock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On peut le décaler à mardi 15 h ? Toujours en salle de réunion du 3e étage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possiamo spostarlo a martedì alle 15:00? Sempre nella sala riunioni al terzo piano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos mudar para terça às 15h? Continua na sala de reuniões do 3º andar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอเลื่อนเป็นวันอังคาร 15:00 น. ได้ไหม ยังเป็นห้องประชุมชั้น 3 เหมือนเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dời sang thứ Ba lúc 15:00 được không? Vẫn ở phòng họp tầng 3."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mohli bychom to přesunout na úterý v 15:00? Pořád ve zasedačce ve 3. patře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan vi flytte det til tirsdag kl. 15? Stadig i mødelokalet på 3. sal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορούμε να το μεταφέρουμε την Τρίτη στις 3 μ.μ.; Πάλι στην αίθουσα συσκέψεων του 3ου ορόφου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voisimmeko siirtää sen tiistaille klo 15? Edelleen 3. kerroksen kokoushuoneessa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisakah kita pindahkan ke Selasa pukul 15.00? Tetap di ruang rapat lantai 3."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan vi flytte det til tirsdag kl. 15? Fortsatt i møterommet i 3. etasje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunnen we het verplaatsen naar dinsdag 15:00 uur? Nog steeds in de vergaderruimte op de derde verdieping."
          }
        }
      }
    },
