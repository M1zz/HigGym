    "기준이 잡혀 있습니다. 틀린 항목만 실습으로 확인해보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've got the criteria down. Check just the ones you missed in the labs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You've got the criteria down. Check just the ones you missed in the labs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準は身についています。間違えた項目だけ実習で確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준이 잡혀 있습니다. 틀린 항목만 실습으로 확인해보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准已经建立。只需通过实践确认错误的条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標準已經建立。只需透過實踐確認錯誤的條目。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Критерии усвоены. Проверьте на практике только те, в которых ошиблись."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya dominas los criterios. Repasa en los laboratorios solo los que fallaste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kriterien sitzen. Prüfe in den Labors nur die, die du verfehlt hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous maîtrisez les critères. Ne vérifiez que ceux que vous avez manqués dans les laboratoires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I criteri li hai capiti. Controlla solo quelli che hai sbagliato nei laboratori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pegou os critérios. Confira só os que errou nos laboratórios."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเข้าใจเกณฑ์แล้ว ตรวจเฉพาะข้อที่พลาดในแล็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã nắm các tiêu chí. Chỉ kiểm tra lại những cái bạn bỏ lỡ trong các lab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritéria už znáte. V labech si ověřte jen ta, která jste zmeškali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har styr på kriterierne. Tjek kun dem, du missede, i labs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχεις κατανοήσει τα κριτήρια. Έλεγξε μόνο όσα έχασες στα εργαστήρια."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kriteerit ovat hallussa. Tarkista laboratorioissa vain ne, jotka menit ohi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah menguasai kriteria. Periksa saja yang terlewat di lab."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har kriteriene på plass. Sjekk bare de du bommet på i laboratoriene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt de criteria onder de knie. Controleer alleen die je in de labs gemist hebt."
          }
        }
      }
    },
    "긴 문장으로 바꾸기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a long sentence"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a long sentence"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い文に変える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 문장으로 바꾸기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换成长句子"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換成長句子"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить на длинное предложение"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar a una frase larga"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu einem langen Satz wechseln"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer à une longue phrase"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a una frase lunga"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude para uma frase longa"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับเป็นประโยคยาว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang một câu dài"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepnout na dlouhou větu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift til en lang sætning"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε σε μακρά πρόταση"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda pitkään lauseeseen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti ke kalimat panjang"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt til en lang setning"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel naar een lange zin"
          }
        }
      }
    },
    "긴 문장으로 바꿔보면 왜 이 도구가 **짧고 반드시 다 보여야 하는 값**(금액·수치) 전용인지 드러납니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a long sentence, and you'll see why this tool is only for **short values that must be shown in full** (amounts, figures)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a long sentence, and you'll see why this tool is only for **short values that must be shown in full** (amounts, figures)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い文に変えてみると、このツールがなぜ**短くて必ず全部見えるべき値**（金額・数値）専用なのかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 문장으로 바꿔보면 왜 이 도구가 **짧고 반드시 다 보여야 하는 값**(금액·수치) 전용인지 드러납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换成长句子后，就能看出为什么这个工具**只用于简短且必须完整显示的值**（金额、数字）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換成長句子後，就能看出為什麼這個工具**只用於簡短且必須完整顯示的值**（金額、數字）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замените на длинное предложение, и станет понятно, почему этот инструмент только для **коротких значений, которые должны быть видны целиком** (суммы, цифры)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a una frase larga y verás por qué esta herramienta es solo para **valores cortos que deben mostrarse completos** (importes, cifras)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zu einem langen Satz, und du siehst, warum dieses Werkzeug nur für **kurze Werte ist, die vollständig angezeigt werden müssen** (Beträge, Zahlen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez à une longue phrase, et vous verrez pourquoi cet outil est réservé aux **valeurs courtes qui doivent s'afficher en entier** (montants, chiffres)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a una frase lunga, e vedrai perché questo strumento è solo per **valori brevi che devono essere mostrati per intero** (importi, cifre)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude para uma frase longa e você verá por que esta ferramenta é só para **valores curtos que precisam ser mostrados por inteiro** (valores monetários, números)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับเป็นประโยคยาว แล้วคุณจะเห็นว่าทำไมเครื่องมือนี้ใช้กับ**ค่าสั้น ๆ ที่ต้องแสดงครบ** (จำนวนเงิน, ตัวเลข) เท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang một câu dài, và bạn sẽ thấy vì sao công cụ này chỉ dành cho **những giá trị ngắn phải hiển thị đầy đủ** (số tiền, con số)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepněte na dlouhou větu a uvidíte, proč je tento nástroj jen pro **krátké hodnoty, které se musí zobrazit celé** (částky, čísla)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift til en lang sætning, og du vil se, hvorfor dette værktøj kun er til **korte værdier, der skal vises fuldt ud** (beløb, tal)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε σε μακρά πρόταση και θα δεις γιατί αυτό το εργαλείο είναι μόνο για **σύντομες τιμές που πρέπει να εμφανίζονται ολόκληρες** (ποσά, αριθμοί)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda pitkään lauseeseen, niin näet, miksi tämä työkalu on vain **lyhyille arvoille, jotka täytyy näyttää kokonaisina** (summat, luvut)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti ke kalimat panjang, dan kamu akan melihat mengapa alat ini hanya untuk **nilai pendek yang harus ditampilkan utuh** (jumlah uang, angka)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt til en lang setning, så ser du hvorfor dette verktøyet bare er for **korte verdier som må vises i sin helhet** (beløp, tall)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel naar een lange zin, en je ziet waarom dit gereedschap alleen is voor **korte waarden die volledig getoond moeten worden** (bedragen, cijfers)."
          }
        }
      }
    },
    "긴 문장을 넣으면 배지가 탭 라벨을 덮습니다. 두세 글자가 한계입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put in a long sentence, and the badge covers the tab label. Two or three characters is the limit."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put in a long sentence, and the badge covers the tab label. Two or three characters is the limit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い文を入れるとバッジがタブのラベルを覆います。2〜3文字が限界です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 문장을 넣으면 배지가 탭 라벨을 덮습니다. 두세 글자가 한계입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放入长句子的话，角标会盖住标签文字。两三个字是极限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放入長句子的話，標記會蓋住標籤文字。兩三個字是極限。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подставьте длинное предложение, и бейдж закроет подпись вкладки. Предел - два-три символа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon una frase larga y la insignia tapa la etiqueta de la pestaña. Dos o tres caracteres es el límite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze einen langen Satz ein, und das Badge verdeckt die Tab-Beschriftung. Zwei oder drei Zeichen sind die Grenze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez une longue phrase, et le badge recouvre le libellé de l'onglet. Deux ou trois caractères, c'est la limite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti una frase lunga e il badge copre l'etichetta della scheda. Due o tre caratteri sono il limite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque uma frase longa e o badge cobre o rótulo da aba. Dois ou três caracteres é o limite."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ประโยคยาวลงไป ป้ายตัวเลขจะทับป้ายชื่อแท็บ สองหรือสามตัวอักษรคือขีดจำกัด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đưa vào một câu dài, và huy hiệu che nhãn tab. Hai hoặc ba ký tự là giới hạn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte dlouhou větu a odznak zakryje popisek karty. Dva nebo tři znaky jsou limit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en lang sætning ind, og badgen dækker fanens etiket. To eller tre tegn er grænsen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε μια μακριά πρόταση και το σήμα καλύπτει την ετικέτα της καρτέλας. Δύο ή τρεις χαρακτήρες είναι το όριο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä pitkä lause, ja merkki peittää välilehden nimikkeen. Kaksi tai kolme merkkiä on raja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kalimat panjang, dan lencana menutupi label tab. Dua atau tiga karakter adalah batasnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn en lang setning, og merket dekker fane-etiketten. To eller tre tegn er grensen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet er een lange zin in, en de badge bedekt het tablabel. Twee of drie tekens is de limiet."
          }
        }
      }
    },
