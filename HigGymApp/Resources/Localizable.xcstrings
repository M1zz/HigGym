    "어두운 사진에서는 둘이 똑같아 보입니다, 그래서 어두운 샘플로만 확인하면 놓칩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over a dark photo the two look identical, which is why you'll miss it if you only test with dark samples."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Over a dark photo the two look identical, which is why you'll miss it if you only test with dark samples."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗い写真では2つがまったく同じに見えます。だから暗いサンプルだけで確かめると見落とします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 사진에서는 둘이 똑같아 보입니다, 그래서 어두운 샘플로만 확인하면 놓칩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色照片上，两者看起来一样，所以只用深色样本检查就会漏掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色照片上，兩者看起來一樣，所以只用深色樣本檢查就會漏掉。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На тёмном фото оба варианта выглядят одинаково, поэтому проверка только на тёмных образцах пропустит проблему."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre una foto oscura los dos se ven idénticos, por eso se te pasará si solo pruebas con muestras oscuras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über einem dunklen Foto sehen die beiden identisch aus, deshalb übersiehst du es, wenn du nur mit dunklen Beispielen testest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur une photo sombre, les deux paraissent identiques, ce qui explique pourquoi vous passerez à côté si vous ne testez qu'avec des échantillons sombres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su una foto scura i due sembrano identici, ed è per questo che te lo perderai se provi solo con campioni scuri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobre uma foto escura os dois parecem idênticos, e é por isso que você vai deixar passar se testar só com amostras escuras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหนือรูปถ่ายสีเข้ม ทั้งสองดูเหมือนกัน นั่นคือเหตุผลที่คุณจะพลาดถ้าทดสอบด้วยตัวอย่างสีเข้มเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên ảnh tối cả hai trông giống hệt nhau, đó là lý do bạn sẽ bỏ sót nếu chỉ thử với mẫu tối."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nad tmavou fotkou vypadají obě stejně, proto to přehlédnete, pokud testujete jen s tmavými vzorky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Over et mørkt foto ser de to ens ud, og derfor overser du det, hvis du kun tester med mørke prøver."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάνω από μια σκοτεινή φωτογραφία τα δύο φαίνονται ίδια, γι' αυτό θα το χάσεις αν δοκιμάζεις μόνο με σκοτεινά δείγματα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumman valokuvan päällä nämä kaksi näyttävät identtisiltä, minkä vuoksi ohitat sen, jos testaat vain tummilla näytteillä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di atas foto gelap keduanya terlihat identik, itulah mengapa kamu akan melewatkannya jika hanya menguji dengan contoh gelap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Over et mørkt bilde ser de to identiske ut, og derfor går du glipp av det hvis du bare tester med mørke eksempler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boven een donkere foto zien de twee er identiek uit, daarom mis je het als je alleen met donkere voorbeelden test."
          }
        }
      }
    },
    "어두운 샘플 한 장으로 확인하고 끄면, 흰 사진이 지나는 몇 초 동안 컨트롤이 실제로 사라진다. 재현이 안 되는 게 아니라 그 조건을 안 만들어 본 것이다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check with one dark sample and call it done, and the controls really do vanish for the few seconds a white photo passes by. It's not that it can't be reproduced; you just never created that condition."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Check with one dark sample and call it done, and the controls really do vanish for the few seconds a white photo passes by. It's not that it can't be reproduced; you just never created that condition."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗いサンプル1枚で確かめて終わらせると、白い写真が通り過ぎる数秒間、コントロールが実際に消える。再現できないのではなく、その条件を作ってみなかっただけだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 샘플 한 장으로 확인하고 끄면, 흰 사진이 지나는 몇 초 동안 컨트롤이 실제로 사라진다. 재현이 안 되는 게 아니라 그 조건을 안 만들어 본 것이다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只用一张深色样本检查就关掉了，白色照片经过的那几秒，控件真的会消失。不是无法复现，而是没去创造那个条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只用一張深色樣本檢查就關掉了，白色照片經過的那幾秒，控制元件真的會消失。不是無法復現，而是沒去創造那個條件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте на одном тёмном образце и выключите - и элементы управления действительно исчезнут на те секунды, пока проходит белая фотография. Это не невоспроизводимо, просто вы не создали такое условие."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compruébalo con una muestra oscura y da el asunto por zanjado, y los controles desaparecen de verdad los segundos que pasa una foto blanca. No es que no se pueda reproducir; simplemente nunca creaste esa condición."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe mit einem dunklen Beispiel und erkläre es für erledigt, und die Steuerelemente verschwinden wirklich für die wenigen Sekunden, in denen ein weißes Foto vorbeizieht. Es ist nicht so, dass es sich nicht reproduzieren lässt; du hast diese Bedingung nur nie hergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez avec un seul échantillon sombre et déclarez que c'est fini, et les contrôles disparaissent vraiment pendant les quelques secondes où passe une photo blanche. Ce n'est pas que cela ne se reproduit pas ; c'est que vous n'avez jamais créé cette condition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla con un solo campione scuro e dai tutto per fatto, e i controlli spariscono davvero per i pochi secondi in cui passa una foto bianca. Non è che non si possa riprodurre; semplicemente non hai mai creato quella condizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique com uma amostra escura e dê por encerrado, e os controles realmente somem durante os poucos segundos em que uma foto branca passa. Não é que não dê para reproduzir; você é que nunca criou essa condição."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจด้วยตัวอย่างสีเข้มอันเดียวแล้วถือว่าเสร็จ ตัวควบคุมก็หายไปจริง ๆ ในไม่กี่วินาทีที่รูปสีขาวผ่านไป ไม่ใช่ว่าทำซ้ำไม่ได้ แค่คุณไม่เคยสร้างเงื่อนไขนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra với một mẫu tối rồi coi như xong, và các điều khiển thật sự biến mất trong vài giây khi một bức ảnh trắng đi qua. Không phải không tái hiện được; chỉ là bạn chưa bao giờ tạo ra điều kiện đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujete s jedním tmavým vzorkem a máte hotovo a ovladače opravdu zmizí na těch pár vteřin, kdy projde bílá fotka. Není to tak, že by se to nedalo zopakovat; tu podmínku jste prostě nikdy nevytvořili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek med én mørk prøve og kald det færdigt, og kontrollerne forsvinder virkelig i de få sekunder, et hvidt foto passerer forbi. Det er ikke, fordi det ikke kan genskabes; du har bare aldrig skabt den betingelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε με ένα σκοτεινό δείγμα και κλείσ' το, και οι έλεγχοι πραγματικά εξαφανίζονται για τα λίγα δευτερόλεπτα που περνά μια λευκή φωτογραφία. Δεν είναι ότι δεν αναπαράγεται· απλώς δεν δημιούργησες ποτέ εκείνη τη συνθήκη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista yhdellä tummalla näytteellä ja pidä asiaa selvänä, niin säätimet todella katoavat sekunneiksi, kun valkoinen valokuva kulkee ohi. Ei ole niin, ettei sitä voisi toistaa; et vain koskaan luonut tuota olosuhdetta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa dengan satu contoh gelap dan anggap selesai, dan kontrol benar-benar lenyap selama beberapa detik saat foto putih lewat. Bukan tidak bisa direproduksi; kamu hanya tidak pernah menciptakan kondisi itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk med ett mørkt eksempel og kall det ferdig, og kontrollene forsvinner virkelig i de sekundene et hvitt bilde passerer. Det er ikke det at det ikke kan gjenskapes; du skapte bare aldri den betingelsen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer met één donker voorbeeld en klaar, en de bedieningselementen verdwijnen echt voor de paar seconden dat een witte foto langskomt. Het is niet dat het niet te reproduceren is; je hebt die omstandigheid nooit gemaakt."
          }
        }
      }
    },
    "어떤 처리가 기준에 맞나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which treatment meets the criterion?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Which treatment meets the criterion?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの処理が基準に合っていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 처리가 기준에 맞나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪种处理符合标准？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪種處理符合標準？"
          }
        },
        "ru": {
