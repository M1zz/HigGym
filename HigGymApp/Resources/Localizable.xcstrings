    "둘을 같은 효과로 통일해야 재질 은유가 유지된다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same effect for both to keep the material metaphor intact"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same effect for both to keep the material metaphor intact"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方を同じエフェクトにそろえてこそ、マテリアルのメタファーが保たれる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘을 같은 효과로 통일해야 재질 은유가 유지된다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两者必须统一成同一种效果，材质的隐喻才得以保持"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩者必須統一成同一種效果，材質的隱喻才得以保持"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте один и тот же эффект для обоих, чтобы сохранить метафору материала"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el mismo efecto en ambas para mantener intacta la metáfora del material"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende für beide denselben Effekt, damit die Materialmetapher intakt bleibt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le même effet pour les deux afin de préserver la métaphore du matériau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa lo stesso effetto per entrambi per mantenere intatta la metafora del materiale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o mesmo efeito nos dois para manter a metáfora do material intacta"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เอฟเฟกต์เดียวกันกับทั้งสองเพื่อรักษาอุปมาของวัสดุ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng cùng một hiệu ứng cho cả hai để giữ nguyên ẩn dụ vật liệu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte stejný efekt pro obě, aby zůstala zachována materiálová metafora"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug samme effekt til begge for at holde materialemetaforen intakt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε το ίδιο εφέ και για τα δύο ώστε να παραμείνει ακέραιη η μεταφορά του υλικού"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä molemmille samaa efektiä, jotta materiaalimetafora pysyy ehjänä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan efek yang sama untuk keduanya agar metafora material tetap utuh"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk samme effekt for begge for å holde materialmetaforen intakt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik hetzelfde effect voor beide om de materiaalmetafoor intact te houden"
          }
        }
      }
    },
    "뒤 화면 · 카드를 눌러보세요 (%lld회)": {
      "localizations": {
