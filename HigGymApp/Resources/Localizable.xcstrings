          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是流行的问题，而是对象与操作结合的问题（8.1.7）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
