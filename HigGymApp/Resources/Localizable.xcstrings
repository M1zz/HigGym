            "value": "サポート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원"
          }
        }
      }
    },
    "지웠습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지웠습니다"
          }
        }
      }
    },
    "지킨 쪽은 값만 들고 있다가 로케일에 맞춰 스스로 표기를 바꿉니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compliant version holds only the value and adapts its format to the locale on its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールを守った側は値だけを持ち、ロケールに合わせて自分で表記を変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지킨 쪽은 값만 들고 있다가 로케일에 맞춰 스스로 표기를 바꿉니다."
          }
        }
      }
    },
    "직접 \"km\"를 문자열로 붙였다면 이 전환은 전부 수동 작업이 됐을 겁니다, 8.1.6.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you had appended \"km\" as a string yourself, this switch would all be manual work (8.1.6)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「km」を文字列で直接付けていたら、この切り替えはすべて手作業になっていたはずです（8.1.6）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 \"km\"를 문자열로 붙였다면 이 전환은 전부 수동 작업이 됐을 겁니다, 8.1.6."
          }
        }
      }
    },
    "직접 만든 고정 높이 헤더(제목·아이콘이 안 커짐) ↔ 시스템 내비바(제목이 커지고 넘치는 건 스스로 접힘).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hand-built fixed-height header (title and icons don't grow) ↔ the system navigation bar (the title grows and overflow folds itself away)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自作の固定高さヘッダー（タイトルもアイコンも大きくならない）↔ システムのナビゲーションバー（タイトルが大きくなり、あふれた分は自動で折りたたまれる）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 고정 높이 헤더(제목·아이콘이 안 커짐) ↔ 시스템 내비바(제목이 커지고 넘치는 건 스스로 접힘)."
          }
        }
      }
    },
    "직접 만든 헤더를 버리고 시스템 내비바로 돌아갔다. 넘치는 아이템은 시스템이 ⋯ 로 접게 뒀다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropped the custom header and went back to the system navigation bar. Let the system fold overflowing items into ⋯."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自作ヘッダーをやめてシステムのナビゲーションバーに戻した。あふれるアイテムはシステムに任せて ⋯ に折りたたませた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 만든 헤더를 버리고 시스템 내비바로 돌아갔다. 넘치는 아이템은 시스템이 ⋯ 로 접게 뒀다."
          }
        }
      }
    },
    "직접 조작": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct manipulation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接操作"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 조작"
          }
        }
      }
    },
    "직접 지정한 고정 회색은 어느 한 배경에서 반드시 깨집니다, 그게 이 항목의 요지입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed gray you pick yourself will always break on some background. That's the point of this topic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で決めた固定のグレーは、どこかの背景で必ず破綻します。それがこのトピックの要点です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 지정한 고정 회색은 어느 한 배경에서 반드시 깨집니다, 그게 이 항목의 요지입니다."
          }
        }
      }
    },
    "직접 해보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it yourself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で試す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 해보기"
          }
        }
      }
    },
    "진입 순간엔 방향감을 주고, 읽기 시작하면 inline으로 접혀 공간을 콘텐츠에 반납합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On entry it gives a sense of place; once you start reading, it collapses to inline and gives the space back to the content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入った瞬間は現在地を伝え、読み始めると inline に折りたたまれてスペースをコンテンツに返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진입 순간엔 방향감을 주고, 읽기 시작하면 inline으로 접혀 공간을 콘텐츠에 반납합니다."
          }
        }
      }
    },
    "진입 시점엔 방향감이 필요하지만 읽기 시작하면 기여가 끝나므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because orientation matters on entry, but once you start reading, its job is done"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入った時点では現在地の手がかりが必要だが、読み始めれば役目を終えるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진입 시점엔 방향감이 필요하지만 읽기 시작하면 기여가 끝나므로"
          }
        }
      }
    },
    "진행 단계": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress steps"
          }
        },
        "ja": {
          "stringUnit": {
