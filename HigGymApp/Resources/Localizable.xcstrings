    "보조 설명, 배경색을 혼합해 렌더링되는지, 고정된 회색인지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary text: is it rendered by blending with the background color, or is it a fixed gray?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary text: is it rendered by blending with the background colour, or is it a fixed grey?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補足の説明。背景色と混ぜてレンダリングされるのか、固定のグレーなのか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 설명, 배경색을 혼합해 렌더링되는지, 고정된 회색인지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助说明，是混合背景色渲染的，还是固定的灰色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助說明，是混合背景色渲染的，還是固定的灰色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вторичный текст: он отрисовывается со смешением с цветом фона или это фиксированный серый?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto secundario: ¿se renderiza mezclándose con el color de fondo o es un gris fijo?"
          }
        }
      }
