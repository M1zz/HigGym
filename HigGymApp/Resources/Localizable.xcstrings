    "결정 하나하나에 이유를 대는 디자이너로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a reason behind every design call"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Have a reason behind every design call"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデザイン判断に、理由を持てる人へ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成为每个决定都能讲出理由的设计师"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "成為每個決定都能講出理由的設計師"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обоснование для каждого дизайн-решения"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten una razón detrás de cada decisión de diseño"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Habe für jede Designentscheidung einen Grund"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayez une raison derrière chaque décision de design"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un motivo a ogni scelta di design"
