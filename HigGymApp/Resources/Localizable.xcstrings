        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일 앱의 받은 편지함에서 **새 메일 작성** 버튼은 어디에 둘까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
