    "편집 중에는 같은 자리가 **완료**로 바뀝니다. 자리는 그대로, 역할만 이어집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While editing, the same spot becomes **Done**. The place stays; only the role carries on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "While editing, the same spot becomes **Done**. The place stays; only the role carries on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中は同じ位置が**完了**に変わります。位置はそのまま、役割だけが引き継がれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 중에는 같은 자리가 **완료**로 바뀝니다. 자리는 그대로, 역할만 이어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑期间，同一个位置会变成**完成**。位置不变，角色接续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯期間，同一個位置會變成**完成**。位置不變，角色接續。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время редактирования то же место становится **«Готово»**. Место остаётся, продолжается лишь роль."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al editar, el mismo sitio pasa a ser **Listo**. El lugar se mantiene; solo cambia la función."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Bearbeiten wird dieselbe Stelle zu **Fertig**. Der Ort bleibt; nur die Rolle wechselt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant la modification, le même emplacement devient **OK**. L'endroit reste ; seul le rôle continue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modifica, lo stesso posto diventa **Fine**. Il posto resta; cambia solo il ruolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a edição, o mesmo lugar vira **Concluir**. O lugar fica; só o papel segue."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะแก้ไข ตำแหน่งเดียวกันกลายเป็น**เสร็จสิ้น** ที่ยังอยู่ แต่บทบาทเป็นตัวที่สืบต่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đang sửa, cùng vị trí đó thành **Xong**. Chỗ vẫn ở đó; chỉ vai trò được tiếp nối."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při úpravách se stejné místo stane **Hotovo**. Místo zůstává; pokračuje jen role."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Under redigering bliver den samme plads til **Færdig**. Stedet består; kun rollen fortsætter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατά την επεξεργασία, το ίδιο σημείο γίνεται **Τέλος**. Η θέση μένει· μόνο ο ρόλος συνεχίζεται."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokatessa sama paikka muuttuu **Valmis**-painikkeeksi. Paikka pysyy; vain rooli jatkuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat mengubah, tempat yang sama menjadi **Selesai**. Tempatnya tetap; hanya perannya yang berlanjut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mens du redigerer, blir samme plass til **Ferdig**. Plassen blir; bare rollen går videre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdens het wijzigen wordt dezelfde plek **Klaar**. De plek blijft; alleen de rol gaat door."
          }
        }
      }
    },
