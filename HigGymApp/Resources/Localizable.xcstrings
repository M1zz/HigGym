            "value": "하단 바"
          }
        }
      }
    },
    "하단 바 (bottom)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottom bar (bottom)"
          }
        },
        "ja": {
          "stringUnit": {
