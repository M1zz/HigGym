    "괜찮습니다, 원칙 7개부터 다시 훑는 것을 권합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's okay. We recommend going back over the 7 principles first."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "That's okay. We recommend going back over the 7 principles first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大丈夫です。7つの原則からもう一度見直すことをおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "괜찮습니다, 원칙 7개부터 다시 훑는 것을 권합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没关系，建议从 7 条原则重新过一遍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒關係，建議從 7 條原則重新過一遍。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего страшного. Для начала рекомендуем заново пройтись по 7 принципам."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pasa nada. Te recomendamos repasar primero los 7 principios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist in Ordnung. Wir empfehlen, zuerst die 7 Prinzipien noch einmal durchzugehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas grave. Nous vous recommandons de revoir d'abord les 7 principes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va bene. Ti consigliamo di ripassare prima i 7 principi."
          }
        }
      }
