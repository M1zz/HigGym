    "셀 수 있고 줄어드는 것에만 붙인다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for things that can be counted and go down"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for things that can be counted and go down"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数えられて、減っていくものにだけ付ける"
