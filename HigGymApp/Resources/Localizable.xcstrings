          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижняя панель - кабина управления"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra inferior es una cabina de controles"
          }
        }
      }
    },
    "하단 바를 만들고 그 안에 완료 버튼": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a bottom bar and put a Done button in it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a bottom bar and put a Done button in it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーを作り、その中に完了ボタンを置く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바를 만들고 그 안에 완료 버튼"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做出底部栏，里面放完成按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做出底部列，裡面放完成按鈕"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать нижнюю панель и положить в неё кнопку «Готово»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer una barra inferior y poner en ella un botón Listo"
          }
        }
      }
    },
    "하단 바에 삭제를 단독으로 두면 엄지가 지나가다 눌러 되돌릴 수 없는 일이 벌어진다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Delete alone in the bottom bar, and a passing thumb can trigger something irreversible."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Delete alone in the bottom bar, and a passing thumb can trigger something irreversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーに削除を単独で置くと、通りがかった親指が押して取り返しのつかないことが起きる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바에 삭제를 단독으로 두면 엄지가 지나가다 눌러 되돌릴 수 없는 일이 벌어진다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把删除单独放在底部栏，拇指经过时会点到，造成无法挽回的后果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把刪除單獨放在底部列，拇指經過時會點到，造成無法挽回的後果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте «Удалить» одиноко в нижнюю панель, и проходящий большой палец может запустить необратимое действие."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon Eliminar solo en la barra inferior y un pulgar al pasar puede disparar algo irreversible."
          }
        }
      }
    },
    "하단 바에 혜택 배너 + 새 글 ↔ 새 글만. 배너는 목록 세 번째 자리로 옮겨졌습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo banner + New post in the bottom bar ↔ New post only. The banner moved to the third spot in the list."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo banner + New post in the bottom bar ↔ New post only. The banner moved to the third spot in the list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーにキャンペーンバナー + 新規投稿 ↔ 新規投稿だけ。バナーはリストの3番目に移りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바에 혜택 배너 + 새 글 ↔ 새 글만. 배너는 목록 세 번째 자리로 옮겨졌습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部栏放优惠横幅 + 新帖 ↔ 只放新帖。横幅被移到了列表的第三个位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "底部列放優惠橫幅 + 新帖 ↔ 只放新帖。橫幅被移到了列表的第三個位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промо-баннер + «Новая запись» в нижней панели ↔ только «Новая запись». Баннер переехал на третье место в списке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner promocional + Nueva publicación en la barra inferior ↔ solo Nueva publicación. El banner pasó al tercer puesto de la lista."
          }
        }
      }
    },
    "하단 바에는 이 화면의 조작(새 글쓰기)만 두고, 프로모션은 콘텐츠 흐름 안으로 넣었다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept only this screen's control (new post) in the bottom bar and moved the promotion into the flow of content."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept only this screen's control (new post) in the bottom bar and moved the promotion into the flow of content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーにはこの画面の操作（新規投稿）だけを置き、プロモーションはコンテンツの流れの中に入れた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바에는 이 화면의 조작(새 글쓰기)만 두고, 프로모션은 콘텐츠 흐름 안으로 넣었다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部栏只放这个界面的操作（写新帖），促销被放进了内容流里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "底部列只放這個介面的操作（寫新帖），促銷被放進了內容流裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В нижней панели оставили только управление этого экрана (новая запись), а промо перенесли в поток контента."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dejó en la barra inferior solo el control de esta pantalla (nueva publicación) y se llevó la promoción al flujo del contenido."
          }
        }
      }
    },
    "하단 바의 **슬라이더**를 끌어보세요, 버튼이 아닌 뷰도 툴바에 들어갑니다.": {
      "localizations": {
        "en": {
