    "전체 화면 커버는 쓸어내려 닫히지 않는다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe down"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe down"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーは下にスワイプしても閉じない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 쓸어내려 닫히지 않는다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏覆盖不能向下轻扫关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕覆蓋不能向下輕掃關閉"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноэкранное покрытие не закрывается смахиванием вниз"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cubierta a pantalla completa no se cierra deslizando hacia abajo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vollbild-Abdeckung schließt sich nicht durch Wischen nach unten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couverture plein écran ne se ferme pas par un balayage vers le bas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copertura a schermo intero non si chiude scorrendo verso il basso"
          }
        }
      }
    },
    "전체 화면 커버는 쓸어내려 닫히지 않는다, 출구는 직접 만들어야 한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe down, so you have to build the exit yourself"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe down, so you have to build the exit yourself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーは下にスワイプしても閉じない。出口は自分でつくる必要がある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 쓸어내려 닫히지 않는다, 출구는 직접 만들어야 한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏覆盖不能向下轻扫关闭，出口要自己做"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕覆蓋不能向下輕掃關閉，出口要自己做"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноэкранное покрытие не закрывается смахиванием вниз, поэтому выход нужно сделать самому"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cubierta a pantalla completa no se cierra deslizando hacia abajo, así que tienes que construir la salida tú mismo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vollbild-Abdeckung schließt sich nicht durch Wischen nach unten, daher musst du den Ausgang selbst bauen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couverture plein écran ne se ferme pas par un balayage vers le bas, donc vous devez construire vous-même la sortie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copertura a schermo intero non si chiude scorrendo verso il basso, quindi l'uscita devi costruirla tu"
          }
        }
      }
    },
    "전체 화면 커버는 일부러 스와이프로 닫히지 않으므로, 출구를 직접 만들어야 한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover deliberately doesn't close with a swipe, so you have to build the exit yourself"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover deliberately doesn't close with a swipe, so you have to build the exit yourself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーはあえてスワイプで閉じないので、出口を自分でつくる必要がある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 일부러 스와이프로 닫히지 않으므로, 출구를 직접 만들어야 한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏覆盖故意不能用滑动关闭，所以出口要自己做"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕覆蓋故意不能用滑動關閉，所以出口要自己做"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноэкранное покрытие намеренно не закрывается смахиванием, поэтому выход нужно сделать самому"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cubierta a pantalla completa no se cierra deslizando a propósito, así que tienes que construir la salida tú mismo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vollbild-Abdeckung schließt sich absichtlich nicht durch Wischen, daher musst du den Ausgang selbst bauen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couverture plein écran ne se ferme volontairement pas par un balayage, donc vous devez construire vous-même la sortie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copertura a schermo intero non si chiude volutamente con lo scorrimento, quindi l'uscita devi costruirla tu"
          }
        }
      }
    },
    "전체 화면 커버는 일부러 쓸어내려 닫히지 않는다. 작성 중인 글을 지키는 대신 출구를 만들 의무가 따라온다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover deliberately doesn't close with a swipe down. Protecting the draft comes with an obligation to build a way out."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover deliberately doesn't close with a swipe down. Protecting the draft comes with an obligation to build a way out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーはあえて下にスワイプしても閉じない。書きかけの文章を守る代わりに、出口をつくる義務がついてくる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 일부러 쓸어내려 닫히지 않는다. 작성 중인 글을 지키는 대신 출구를 만들 의무가 따라온다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏覆盖故意不能向下轻扫关闭。保护正在写的内容，就随之有了必须做出口的义务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕覆蓋故意不能向下輕掃關閉。保護正在寫的內容，就隨之有了必須做出口的義務。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноэкранное покрытие намеренно не закрывается смахиванием вниз. Защита черновика влечёт обязанность построить путь выхода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cubierta a pantalla completa no se cierra deslizando hacia abajo a propósito. Proteger el borrador conlleva la obligación de construir una salida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vollbild-Abdeckung schließt sich absichtlich nicht durch Wischen nach unten. Den Entwurf zu schützen bringt die Pflicht mit sich, einen Ausweg zu bauen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couverture plein écran ne se ferme volontairement pas par un balayage vers le bas. Protéger le brouillon s'accompagne de l'obligation de construire une issue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copertura a schermo intero non si chiude volutamente scorrendo verso il basso. Proteggere la bozza comporta l'obbligo di costruire una via d'uscita."
          }
        }
      }
    },
    "전체 화면 커버는 제스처 닫기가 없는 **강한 모달**입니다. 온보딩·로그인·카메라처럼 “끝내거나 명시적으로 나가라”가 맞는 흐름에만 쓰세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover is a **strong modal** with no gesture to dismiss. Use it only for flows where “finish or leave explicitly” is right, like onboarding, sign-in or the camera."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover is a **strong modal** with no gesture to dismiss. Use it only for flows where “finish or leave explicitly” is right, like onboarding, sign-in or the camera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーはジェスチャーで閉じられない**強いモーダル**です。オンボーディング、ログイン、カメラのように「終えるか、明示的に出るか」が正しいフローにだけ使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 제스처 닫기가 없는 **강한 모달**입니다. 온보딩·로그인·카메라처럼 “끝내거나 명시적으로 나가라”가 맞는 흐름에만 쓰세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏覆盖是没有手势关闭的**强模态**。只用在引导、登录、相机这类“要么完成，要么明确退出”的流程上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕覆蓋是沒有手勢關閉的**強模態**。只用在引導、登入、相機這類「要麼完成，要麼明確退出」的流程上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноэкранное покрытие - это **сильное модальное окно** без жеста закрытия. Используйте его только для сценариев, где подходит «завершите или выйдите явно», например знакомство, вход или камера."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cubierta a pantalla completa es un **modal fuerte** sin gesto para descartarlo. Úsala solo en flujos donde «terminar o salir de forma explícita» es lo correcto, como la bienvenida, el inicio de sesión o la cámara."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vollbild-Abdeckung ist ein **starkes Modal** ohne Geste zum Verwerfen. Nutze sie nur für Abläufe, in denen „beenden oder ausdrücklich verlassen“ richtig ist, etwa Einführung, Anmeldung oder Kamera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couverture plein écran est une **modale forte** sans geste pour la fermer. Utilisez-la seulement pour les parcours où « terminez ou quittez explicitement » est juste, comme l'onboarding, la connexion ou l'appareil photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copertura a schermo intero è un **modale forte** senza gesto per chiuderlo. Usala solo per flussi in cui «finire o uscire esplicitamente» è giusto, come l'introduzione, l'accesso o la fotocamera."
          }
        }
      }
    },
    "전체 화면 편집기에 출구를 직접 만들었다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built an exit into the full-screen editor ourselves."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Built an exit into the full-screen editor ourselves."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンのエディタに出口を自分でつくった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 편집기에 출구를 직접 만들었다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给全屏编辑器自己做了出口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給全螢幕編輯器自己做了出口。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сами встроили в полноэкранный редактор выход."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se construyó una salida en el editor a pantalla completa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Vollbild-Editor selbst einen Ausgang eingebaut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons construit nous-mêmes une sortie dans l'éditeur plein écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo costruito noi un'uscita nell'editor a schermo intero."
          }
        }
      }
    },
    "전체 화면으로 실행": {
