    "목록 맨 아래까지 스크롤해 보세요, 마지막 항목이 바 위에서 멈춥니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll to the very bottom of the list: the last item stops above the bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll to the very bottom of the list: the last item stops above the bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストのいちばん下までスクロールしてみてください。最後の項目がバーの上で止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록 맨 아래까지 스크롤해 보세요, 마지막 항목이 바 위에서 멈춥니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把列表滚动到最底部，最后一项会停在栏的上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把列表滾動到最底部，最後一項會停在列的上方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите список до самого низа: последний элемент останавливается над панелью."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate hasta el final de la lista: el último elemento se detiene sobre la barra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle ganz ans Ende der Liste: Das letzte Element hält über der Leiste an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler tout en bas de la liste : le dernier élément s'arrête au-dessus de la barre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri fino in fondo all'elenco: l'ultimo elemento si ferma sopra la barra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role até o fim da lista: o último item para acima da barra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนไปล่างสุดของรายการ: รายการสุดท้ายหยุดอยู่เหนือแถบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộn đến tận cuối danh sách: mục cuối dừng lại phía trên thanh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte se úplně na konec seznamu: poslední položka se zastaví nad panelem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll helt ned i bunden af listen: det sidste element stopper over bjælken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κύλισε μέχρι το κάτω μέρος της λίστας: το τελευταίο στοιχείο σταματά πάνω από τη γραμμή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieritä luettelon aivan alaosaan: viimeinen kohde pysähtyy palkin yläpuolelle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gulir sampai paling bawah daftar: item terakhir berhenti di atas bilah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rull helt ned i listen: det siste elementet stopper over linjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll helemaal naar de onderkant van de lijst: het laatste item stopt boven de balk."
          }
        }
      }
    },
    "목록에서 **상세 화면으로 들어가기**를 눌러 깊이 들어가 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the list, tap **Go to detail screen** to drill in."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In the list, tap **Go to detail screen** to drill in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストで**詳細画面へ進む**をタップして、深く入ってみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에서 **상세 화면으로 들어가기**를 눌러 깊이 들어가 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表里点按**进入详情界面**，一路深入下去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在列表裡輕點**進入詳情介面**，一路深入下去。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В списке нажмите **«Перейти к подробностям»**, чтобы погрузиться глубже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la lista, toca **Ir a la pantalla de detalle** para entrar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in der Liste auf **Zur Detailansicht**, um hineinzugehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la liste, touchez **Aller à l'écran de détail** pour entrer dedans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell'elenco, tocca **Vai alla schermata di dettaglio** per entrare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na lista, toque em **Ir para a tela de detalhe** para entrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในรายการ แตะ**ไปยังหน้ารายละเอียด**เพื่อเจาะลึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong danh sách, chạm **Đến màn hình chi tiết** để đi sâu vào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V seznamu klepněte na **Přejít na detail**, abyste se prokousali dovnitř."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på **Gå til detaljeskærm** i listen for at gå i dybden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη λίστα, πάτησε **Μετάβαση στην οθόνη λεπτομερειών** για να μπεις βαθύτερα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta luettelossa **Siirry yksityiskohtanäkymään** porautuaksesi sisään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di daftar, ketuk **Buka layar detail** untuk masuk lebih dalam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på **Gå til detaljskjerm** i listen for å bore deg inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik in de lijst op **Ga naar detailscherm** om erin te duiken."
          }
        }
      }
    },
    "목록에선 이동이 주 작업이지만 상세에선 소비가 주 작업입니다, **주 작업이 바뀌면 크롬도 바뀌는** 것이 content-first.\n\n다만 얕은 계층이라면 탭바는 “지금 어디에 있는지”를 보여주는 상시 지도이므로 유지가 기본값입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a list the main task is navigating, but in a detail view it's consuming: **when the main task changes, the chrome changes too**. That's content-first.\n\nStill, in a shallow hierarchy the tab bar is an always-on map of “where you are now,” so keeping it is the default."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In a list the main task is navigating, but in a detail view it's consuming: **when the main task changes, the chrome changes too**. That's content-first.\n\nStill, in a shallow hierarchy the tab bar is an always-on map of “where you are now,” so keeping it is the default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストでは移動が主な作業ですが、詳細では閲覧が主な作業です。**主な作業が変われば、クロームも変わる**のが content-first です。\n\nただし階層が浅いなら、タブバーは「いまどこにいるか」を示す常設の地図なので、残すのが基本です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에선 이동이 주 작업이지만 상세에선 소비가 주 작업입니다, **주 작업이 바뀌면 크롬도 바뀌는** 것이 content-first.\n\n다만 얕은 계층이라면 탭바는 “지금 어디에 있는지”를 보여주는 상시 지도이므로 유지가 기본값입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表里的主要任务是移动，而详情里的主要任务是阅读，**主要任务变了，界面框架也要变**，这就是 content-first。\n\n不过，如果层级很浅，标签栏是显示“我现在在哪里”的常驻地图，默认应该保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列表裡的主要任務是移動，而詳情裡的主要任務是閱讀，**主要任務變了，介面框架也要變**，這就是 content-first。\n\n不過，如果層級很淺，標籤列是顯示「我現在在哪裡」的常駐地圖，預設應該保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В списке главная задача - навигация, а в подробностях - потребление: **когда меняется главная задача, меняется и «хром»**. Это content-first.\n\nОднако при неглубокой иерархии панель вкладок - постоянная карта «где вы сейчас», поэтому по умолчанию её сохраняют."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una lista la tarea principal es navegar, pero en una vista de detalle es consumir: **cuando cambia la tarea principal, cambia también el cromo**. Eso es content-first.\n\nAun así, en una jerarquía poco profunda la barra de pestañas es un mapa siempre activo de «dónde estás ahora», así que mantenerla es lo normal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einer Liste ist die Hauptaufgabe das Navigieren, in einer Detailansicht das Konsumieren: **Ändert sich die Hauptaufgabe, ändert sich auch das Chrome**. Das ist Content-First.\n\nTrotzdem ist die Tab-Leiste in einer flachen Hierarchie eine immer aktive Karte von „wo du jetzt bist“, daher ist es der Standard, sie zu behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans une liste, la tâche principale est de naviguer, mais dans une vue de détail c'est de consommer : **quand la tâche principale change, le chrome change aussi**. C'est le content-first.\n\nCela dit, dans une hiérarchie peu profonde, la barre d'onglets est une carte permanente du « où vous êtes maintenant », donc la garder est le comportement par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In un elenco il compito principale è navigare, ma in una vista di dettaglio è consumare: **quando il compito principale cambia, cambia anche il chrome**. Questo è content-first.\n\nEppure, in una gerarchia poco profonda la barra delle schede è una mappa sempre attiva di «dove sei adesso», quindi tenerla è il comportamento predefinito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Numa lista a tarefa principal é navegar, mas numa vista de detalhe é consumir: **quando a tarefa principal muda, o chrome também muda**. Isso é content-first.\n\nAinda assim, numa hierarquia rasa a barra de abas é um mapa sempre ligado de «onde você está agora», então mantê-la é o comportamento padrão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในรายการ งานหลักคือการนำทาง แต่ในมุมมองรายละเอียด งานหลักคือการอ่านเสพ: **เมื่องานหลักเปลี่ยน ส่วนห่อหุ้มก็เปลี่ยนด้วย** นั่นคือ content-first\n\nถึงอย่างนั้น ในลำดับชั้นที่ตื้น แถบแท็บคือแผนที่ที่เปิดตลอดของ “ตอนนี้คุณอยู่ที่ไหน” การคงไว้จึงเป็นค่าเริ่มต้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong danh sách, tác vụ chính là điều hướng, nhưng trong màn hình chi tiết là thưởng thức: **khi tác vụ chính đổi, lớp vỏ cũng đổi**. Đó là content-first.\n\nTuy vậy, trong thứ bậc nông, thanh tab là tấm bản đồ luôn bật về “bạn đang ở đâu”, nên giữ nó là mặc định."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V seznamu je hlavním úkolem navigace, ale v detailu je to konzumace: **když se změní hlavní úkol, změní se i rámec**. To je content-first.\n\nPřesto v mělké hierarchii je panel karet vždy zapnutou mapou „kde teď jste“, takže jeho ponechání je výchozí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I en liste er hovedopgaven at navigere, men i en detaljevisning er den at forbruge: **når hovedopgaven ændrer sig, ændrer rammen sig også**. Det er content-first.\n\nI et fladt hierarki er fanelinjen dog et altid tændt kort over »hvor du er nu«, så at beholde den er standarden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε μια λίστα η κύρια εργασία είναι η πλοήγηση, ενώ σε μια προβολή λεπτομερειών είναι η κατανάλωση: **όταν αλλάζει η κύρια εργασία, αλλάζει και το chrome**. Αυτό είναι content-first.\n\nΩστόσο, σε μια ρηχή ιεραρχία η γραμμή καρτελών είναι ένας πάντα ενεργός χάρτης του «πού βρίσκεσαι τώρα», οπότε η διατήρησή της είναι η προεπιλογή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettelossa pääasiallinen tehtävä on navigointi, mutta yksityiskohtanäkymässä se on kulutus: **kun pääasiallinen tehtävä muuttuu, myös kehys muuttuu**. Se on content-first.\n\nSilti matalassa hierarkiassa välilehtipalkki on aina päällä oleva kartta ”missä olet nyt”, joten sen säilyttäminen on oletus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di daftar tugas utamanya adalah bernavigasi, tetapi di tampilan detail tugasnya adalah mengonsumsi: **ketika tugas utama berubah, chrome juga berubah**. Itulah content-first.\n\nMeski begitu, pada hierarki dangkal bilah tab adalah peta yang selalu aktif tentang \"di mana kamu sekarang\", jadi mempertahankannya adalah bawaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I en liste er navigering hovedoppgaven, men i en detaljvisning er det å konsumere hovedoppgaven: **når hovedoppgaven endres, endres chrome også**. Det er innhold først.\n\nLikevel er fanelinjen i et grunt hierarki et alltid tilstedeværende kart over «hvor du er nå», så å beholde den er standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In een lijst is navigeren de hoofdtaak, maar in een detailweergave is het consumeren: **als de hoofdtaak verandert, verandert de chrome ook**. Dat is content-first.\n\nToch is de tabbalk in een ondiepe hiërarchie een altijd aanwezige kaart van \"waar je nu bent\", dus hem behouden is de standaard."
          }
        }
      }
    },
    "목록을 **아래로 스크롤**해 보세요, 탭바가 작게 접힙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll down** the list: the tab bar shrinks."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll down** the list: the tab bar shrinks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストを**下にスクロール**してみてください。タブバーが小さく縮まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록을 **아래로 스크롤**해 보세요, 탭바가 작게 접힙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把列表**向下滚动**，标签栏会缩成小小的一条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把列表**向下滾動**，標籤列會縮成小小的一條。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Прокрутите список вниз**: панель вкладок сожмётся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desplázate hacia abajo** por la lista: la barra de pestañas se encoge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scrolle** die Liste **nach unten**: Die Tab-Leiste schrumpft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Faites défiler vers le bas** la liste : la barre d'onglets rétrécit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scorri verso il basso** l'elenco: la barra delle schede si riduce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Role para baixo** a lista: a barra de abas encolhe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**เลื่อนลง**ในรายการ: แถบแท็บหดลง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Cuộn xuống** danh sách: thanh tab thu nhỏ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Posuňte seznam dolů**: panel karet se zmenší."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll ned** i listen: fanelinjen krymper."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Κύλισε προς τα κάτω** τη λίστα: η γραμμή καρτελών μικραίνει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vieritä alas** luettelossa: välilehtipalkki kutistuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gulir ke bawah** daftar: bilah tab menyusut."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rull ned** i listen: fanelinjen krymper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll omlaag** in de lijst: de tabbalk krimpt."
          }
        }
      }
    },
    "목록을 **한참 아래로 내린 뒤** 검색을 해보세요. 검색을 시작하기까지 무엇을 해야 했는지 세어 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll way down** the list, then try searching. Count what you had to do before you could start a search."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll way down** the list, then try searching. Count what you had to do before you could start a search."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストを**かなり下までスクロールしてから**検索してみてください。検索を始めるまでに何をしなければならなかったか数えてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록을 **한참 아래로 내린 뒤** 검색을 해보세요. 검색을 시작하기까지 무엇을 해야 했는지 세어 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把列表**滚到很靠下的位置**之后再搜索。数一数开始搜索之前你都做了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把列表**滾到很靠下的位置**之後再搜尋。數一數開始搜尋之前你都做了什麼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Прокрутите список далеко вниз**, затем попробуйте искать. Посчитайте, что пришлось сделать, прежде чем начать поиск."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desplázate muy abajo** por la lista y luego intenta buscar. Cuenta lo que tuviste que hacer antes de poder empezar a buscar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scrolle weit nach unten** in der Liste und versuche dann zu suchen. Zähle, was du tun musstest, bevor du eine Suche starten konntest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Faites défiler très loin vers le bas** la liste, puis essayez de chercher. Comptez ce que vous avez dû faire avant de pouvoir lancer une recherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scorri molto in basso** l'elenco, poi prova a cercare. Conta che cosa hai dovuto fare prima di poter avviare una ricerca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Role bem para baixo** a lista, depois tente buscar. Conte o que você teve de fazer antes de poder iniciar uma busca."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**เลื่อนลงไปไกล ๆ** ในรายการ แล้วลองค้นหา นับว่าต้องทำอะไรบ้างก่อนจะเริ่มค้นหาได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Cuộn thật xa xuống** danh sách, rồi thử tìm kiếm. Đếm xem bạn phải làm gì trước khi có thể bắt đầu tìm kiếm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Posuňte seznam hodně dolů** a pak zkuste hledat. Spočítejte, co jste museli udělat, než jste mohli začít hledat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll langt ned** i listen, og prøv derefter at søge. Tæl, hvad du skulle gøre, før du kunne begynde en søgning."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Κύλισε πολύ κάτω** στη λίστα και μετά δοκίμασε να αναζητήσεις. Μέτρα τι χρειάστηκε να κάνεις πριν μπορέσεις να ξεκινήσεις αναζήτηση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vieritä luettelo kauas alas** ja yritä sitten hakea. Laske, mitä jouduit tekemään ennen kuin pystyit aloittamaan haun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gulir jauh ke bawah** daftar, lalu coba cari. Hitung apa yang harus kamu lakukan sebelum bisa memulai pencarian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rull langt ned** i listen, og prøv deretter å søke. Tell hva du måtte gjøre før du kunne starte et søk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll ver omlaag** in de lijst en probeer dan te zoeken. Tel wat je moest doen voordat je een zoekopdracht kon starten."
          }
        }
      }
    },
    "목록을 스크롤해도 하단 버튼은 그대로 떠 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even as you scroll the list, the bottom button stays floating in place."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Even as you scroll the list, the bottom button stays floating in place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストをスクロールしても、下部のボタンはそのまま浮いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록을 스크롤해도 하단 버튼은 그대로 떠 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动列表，底部按钮依然悬浮不动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動列表，底部按鈕依然懸浮不動。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даже когда вы прокручиваете список, нижняя кнопка остаётся на месте."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunque desplaces la lista, el botón inferior sigue flotando en su sitio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch wenn du die Liste scrollst, bleibt der untere Button an Ort und Stelle schweben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même quand vous faites défiler la liste, le bouton du bas reste flottant à sa place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche scorrendo l'elenco, il pulsante in basso resta fluttuante al suo posto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesmo rolando a lista, o botão inferior continua flutuando no lugar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แม้เลื่อนรายการ ปุ่มด้านล่างก็ยังลอยอยู่กับที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dù bạn cuộn danh sách, nút ở dưới vẫn nổi tại chỗ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "I když seznam posouváte, spodní tlačítko zůstává plovoucí na místě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Selv når du scroller i listen, bliver den nederste knap svævende på plads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακόμα και καθώς κυλάς τη λίστα, το κάτω κουμπί μένει να επιπλέει στη θέση του."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaikka vierität luetteloa, alapainike pysyy kelluvana paikallaan."
          }
        },
        "id": {
          "stringUnit": {
