    "막아 두면 사용자가 화면을 보며 손으로 옮겨 적고, 그 과정에서 오타가 난다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block it, and people copy it out by hand while looking at the screen, making typos along the way."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Block it, and people copy it out by hand while looking at the screen, making typos along the way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふさいでおくと、ユーザーは画面を見ながら手で書き写し、その過程で入力ミスが起きる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막아 두면 사용자가 화면을 보며 손으로 옮겨 적고, 그 과정에서 오타가 난다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦封住，用户只能看着屏幕手抄，过程中就会出错字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦封住，使用者只能看著螢幕手抄，過程中就會出錯字。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокируйте это, и люди будут переписывать вручную, глядя на экран, и делать при этом опечатки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquéalo y la gente lo copiará a mano mirando la pantalla, con erratas por el camino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiere es, und Menschen kopieren es von Hand ab, während sie auf den Bildschirm schauen, und machen dabei Tippfehler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquez-la, et les gens la recopient à la main en regardant l'écran, avec des fautes de frappe au passage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccala, e le persone la ricopiano a mano guardando lo schermo, facendo errori di battitura lungo la strada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueie, e as pessoas copiam à mão olhando para a tela, errando a digitação pelo caminho."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าบล็อกมัน คนจะคัดลอกออกด้วยมือขณะมองหน้าจอ และพิมพ์ผิดระหว่างทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn nó, và người ta sẽ chép tay trong khi nhìn màn hình, gõ sai trên đường đi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokujte to a lidé to budou ručně opisovat z obrazovky a při tom dělat překlepy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokér det, og folk kopierer det ud i hånden, mens de ser på skærmen, og laver tastefejl undervejs."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπλόκαρέ το και οι άνθρωποι το αντιγράφουν με το χέρι κοιτάζοντας την οθόνη, κάνοντας λάθη πληκτρολόγησης στην πορεία."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Estä se, ja ihmiset kopioivat sen käsin katsoessaan näyttöä ja tekevät samalla kirjoitusvirheitä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokir, dan orang menyalinnya dengan tangan sambil melihat layar, membuat salah ketik di sepanjang jalan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokker det, og folk kopierer det ut for hånd mens de ser på skjermen, og gjør skrivefeil underveis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkeer het, en mensen kopiëren het met de hand over terwijl ze naar het scherm kijken, en maken onderweg typefouten."
          }
        }
      }
    },
    "만든 순서대로 적으면 나중에 추가된 핵심 기능이 접힌다. 큰 기기에서는 다 보이므로 개발 중에는 만나지도 못한다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List them in the order you built them, and the key feature added later ends up folded away. On a large device everything shows, so you never even run into it during development."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "List them in the order you built them, and the key feature added later ends up folded away. On a large device everything shows, so you never even run into it during development."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作った順に並べると、あとから加えた中心機能がしまわれてしまう。大きなデバイスではすべて見えるので、開発中には出会うことすらない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만든 순서대로 적으면 나중에 추가된 핵심 기능이 접힌다. 큰 기기에서는 다 보이므로 개발 중에는 만나지도 못한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按创建顺序写的话，后来加的核心功能会被折叠。大设备上全看得见，所以开发时根本遇不到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按建立順序寫的話，後來加的核心功能會被摺疊。大裝置上全看得見，所以開發時根本遇不到。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если расположить по порядку создания, добавленная позже ключевая функция окажется свёрнутой. На большом устройстве видно всё, так что в разработке вы с этим даже не столкнётесь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los enumeras en el orden en que los construiste, la función clave añadida después acaba plegada. En un dispositivo grande se ve todo, así que ni te lo encuentras durante el desarrollo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt man sie in der Reihenfolge auf, in der man sie gebaut hat, landet die später hinzugefügte Kernfunktion eingeklappt. Auf einem großen Gerät wird alles angezeigt, sodass man in der Entwicklung nie darauf stößt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listez-les dans l'ordre où vous les avez construits, et la fonction clé ajoutée plus tard finit repliée. Sur un grand appareil tout s'affiche, donc vous ne le rencontrez jamais pendant le développement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elencali nell'ordine in cui li hai costruiti, e la funzione chiave aggiunta più tardi finisce ripiegata. Su un dispositivo grande si vede tutto, quindi durante lo sviluppo non te ne accorgi nemmeno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste na ordem em que foram construídos, e a funcionalidade-chave adicionada depois acaba dobrada. Num dispositivo grande tudo aparece, então você nem esbarra nisso durante o desenvolvimento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียงตามลำดับที่คุณสร้าง ฟีเจอร์หลักที่เพิ่มทีหลังจะถูกพับซ่อน บนอุปกรณ์ใหญ่ทุกอย่างแสดงครบ คุณจึงไม่เจอปัญหานี้เลยระหว่างพัฒนา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liệt kê theo thứ tự bạn xây dựng, và tính năng chính được thêm sau cùng bị gập mất. Trên thiết bị lớn mọi thứ đều hiện, nên bạn thậm chí không gặp nó trong lúc phát triển."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypište je v pořadí, v jakém jste je stavěli, a klíčová funkce přidaná později skončí sbalená. Na velkém zařízení je vidět všechno, takže na to při vývoji ani nenarazíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "List dem i den rækkefølge, du byggede dem, og den vigtige funktion, der blev tilføjet senere, ender med at blive foldet væk. På en stor enhed vises alt, så du aldrig støder på det under udviklingen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλ' τα με τη σειρά που τα έφτιαξες και η βασική λειτουργία που προστέθηκε αργότερα καταλήγει διπλωμένη. Σε μεγάλη συσκευή φαίνονται όλα, οπότε δεν το συναντάς ποτέ κατά την ανάπτυξη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Listaa ne rakennusjärjestyksessä, niin myöhemmin lisätty avainominaisuus päätyy taitetuksi pois. Suurella laitteella kaikki näkyy, joten et koskaan edes kohtaa sitä kehityksen aikana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar menurut urutan pembuatan, dan fitur kunci yang ditambahkan belakangan berakhir terlipat. Di perangkat besar semuanya terlihat, jadi kamu bahkan tidak pernah menemuinya saat pengembangan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "List dem i den rekkefølgen du bygde dem, og den viktige funksjonen som ble lagt til senere havner foldet bort. På en stor enhet vises alt, så du støter aldri på det under utvikling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet ze in de volgorde waarin je ze bouwde, en de sleutelfunctie die later werd toegevoegd wordt weggeklapt. Op een groot apparaat is alles zichtbaar, dus je loopt er tijdens de ontwikkeling nooit tegenaan."
          }
        }
      }
    },
    "만들기는 쉬워 보여도, 그 뒤로는 회전·큰 글씨·OS 업데이트를 만날 때마다 직접 고쳐야 한다. 이 화면에서도 큰 글씨에 제목과 아이콘이 따라 커지지 않는다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks easy to build, but from then on you have to fix it yourself every time you hit rotation, Dynamic Type, or an OS update. Even on this screen, the title and icons don't grow with Dynamic Type."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks easy to build, but from then on you have to fix it yourself every time you hit rotation, Dynamic Type, or an OS update. Even on this screen, the title and icons don't grow with Dynamic Type."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作るのは簡単そうに見えても、その後は回転、Dynamic Type（文字サイズ）、OSアップデートに出会うたびに自分で直さなければならない。この画面でも、大きな文字に合わせてタイトルとアイコンが大きくならない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만들기는 쉬워 보여도, 그 뒤로는 회전·큰 글씨·OS 업데이트를 만날 때마다 직접 고쳐야 한다. 이 화면에서도 큰 글씨에 제목과 아이콘이 따라 커지지 않는다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做起来看似容易，但此后每遇到旋转、大字号、系统更新，都得自己动手修。在这个界面里，大字号下标题和图标也不会跟着变大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做起來看似容易，但此後每遇到旋轉、大字號、系統更新，都得自己動手修。在這個介面裡，大字號下標題和圖示也不會跟著變大。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать кажется просто, но потом придётся самому чинить при каждом повороте, крупном шрифте или обновлении ОС. Даже на этом экране заголовок и значки не растут вместе с Dynamic Type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece fácil de construir, pero a partir de ahí tienes que arreglarlo tú mismo cada vez que te topes con una rotación, Dynamic Type o una actualización del sistema. Incluso en esta pantalla, el título y los iconos no crecen con Dynamic Type."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sieht einfach zu bauen aus, aber von da an musst du es jedes Mal selbst reparieren, wenn Drehung, Dynamic Type oder ein OS-Update zuschlagen. Schon auf diesem Bildschirm wachsen Titel und Symbole nicht mit Dynamic Type."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela paraît facile à construire, mais à partir de là il faut le corriger vous-même à chaque rotation, Dynamic Type ou mise à jour du système. Même sur cet écran, le titre et les icônes ne grandissent pas avec Dynamic Type."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra facile da costruire, ma da quel momento in poi devi correggerlo tu a ogni rotazione, Dynamic Type o aggiornamento del sistema. Anche in questa schermata, titolo e icone non crescono con Dynamic Type."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece fácil de construir, mas daí em diante você mesmo tem de consertar a cada rotação, Dynamic Type ou atualização do sistema. Até nesta tela, o título e os ícones não crescem com o Dynamic Type."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูสร้างง่าย แต่ต่อจากนั้นคุณต้องแก้เองทุกครั้งที่เจอการหมุนหน้าจอ Dynamic Type หรืออัปเดต OS แม้แต่หน้าจอนี้ ชื่อเรื่องและไอคอนก็ไม่ขยายตาม Dynamic Type"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trông dễ xây, nhưng từ đó về sau bạn phải tự sửa mỗi lần gặp xoay màn hình, Dynamic Type hoặc cập nhật hệ điều hành. Ngay cả trên màn hình này, tiêu đề và biểu tượng cũng không to lên theo Dynamic Type."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypadá to jednoduše na stavbu, ale od té chvíle to musíte opravovat sami při každé rotaci, každém Dynamic Type nebo aktualizaci OS. Dokonce i na této obrazovce nadpis a ikony s Dynamic Type nerostou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser nemt ud at bygge, men fra da af skal du selv rette det, hver gang du rammer rotation, Dynamic Type eller en OS-opdatering. Selv på denne skærm vokser titlen og ikonerne ikke med Dynamic Type."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φαίνεται εύκολο στην κατασκευή, αλλά από εκεί και πέρα πρέπει να το διορθώνεις μόνος σου κάθε φορά που συναντάς περιστροφή, Dynamic Type ή ενημέρωση λειτουργικού. Ακόμα και σε αυτή την οθόνη, ο τίτλος και τα εικονίδια δεν μεγαλώνουν με το Dynamic Type."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se näyttää helpolta rakentaa, mutta siitä lähtien joudut korjaamaan sen itse aina kun vastaan tulee kierto, Dynamic Type tai käyttöjärjestelmäpäivitys. Jopa tässä näkymässä otsikko ja kuvakkeet eivät kasva Dynamic Typen mukana."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlihat mudah dibuat, tetapi sejak itu kamu harus memperbaikinya sendiri setiap kali menghadapi rotasi, Dynamic Type, atau pembaruan OS. Bahkan di layar ini, judul dan ikon tidak membesar mengikuti Dynamic Type."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser enkelt ut å bygge, men fra da av må du selv fikse det hver gang du treffer rotasjon, Dynamic Type eller en OS-oppdatering. Selv på denne skjermen vokser ikke tittelen og ikonene med Dynamic Type."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lijkt makkelijk te bouwen, maar vanaf dan moet je het zelf repareren elke keer dat je rotatie, Dynamic Type of een OS-update tegenkomt. Zelfs op dit scherm groeien de titel en de icoontjes niet mee met Dynamic Type."
          }
        }
      }
    },
    "맞았습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct"
          }
