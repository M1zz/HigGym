    "정중앙의 **지도 / 목록** 세그먼트를 눌러보세요, 화면 전체가 바뀝니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **Map / List** segment in the center. The whole screen changes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **Map / List** segment in the centre. The whole screen changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央の**マップ / リスト**のセグメントをタップしてみてください。画面全体が切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정중앙의 **지도 / 목록** 세그먼트를 눌러보세요, 화면 전체가 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按正中间的**地图 / 列表**分段：整个界面都变了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點正中間的**地圖 / 列表**分段：整個介面都變了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите сегмент **«Карта / Список»** посередине. Меняется весь экран."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el segmento **Mapa / Lista** del centro. Cambia toda la pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in der Mitte auf das Segment **Karte / Liste**. Der ganze Bildschirm ändert sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le segment **Plan / Liste** au centre. Tout l'écran change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il segmento **Mappa / Elenco** al centro. Cambia l'intera schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no segmento **Mapa / Lista** no centro. A tela inteira muda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเซกเมนต์**แผนที่ / รายการ**ตรงกลาง ทั้งหน้าจอเปลี่ยน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm phân đoạn **Bản đồ / Danh sách** ở giữa. Cả màn hình thay đổi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na segment **Mapa / Seznam** uprostřed. Celá obrazovka se změní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på segmentet **Kort / Liste** i midten. Hele skærmen skifter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε το τμήμα **Χάρτης / Λίστα** στο κέντρο. Αλλάζει ολόκληρη η οθόνη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta keskellä olevaa **Kartta / Luettelo** -segmenttiä. Koko näkymä muuttuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk segmen **Peta / Daftar** di tengah. Seluruh layar berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på **Kart / Liste**-segmentet i midten. Hele skjermen endres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het segment **Kaart / Lijst** in het midden. Het hele scherm verandert."
          }
        }
      }
    },
