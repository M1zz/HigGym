    "사진 격자를 **천천히 스크롤**하면서 상단의 선택·공유 버튼을 계속 읽어보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll slowly** through the photo grid while you keep reading the Select and Share buttons at the top."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scroll slowly** through the photo grid while you keep reading the Select and Share buttons at the top."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のグリッドを**ゆっくりスクロール**しながら、上部の選択・共有ボタンを読み続けてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 격자를 **천천히 스크롤**하면서 상단의 선택·공유 버튼을 계속 읽어보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**慢慢滚动**照片网格，同时一直读顶部的选择、分享按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**慢慢滾動**照片網格，同時一直讀頂部的選擇、分享按鈕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Медленно прокручивайте** сетку фотографий, не переставая читать кнопки «Выбрать» и «Поделиться» вверху."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desplázate despacio** por la cuadrícula de fotos mientras sigues leyendo los botones Seleccionar y Compartir de arriba."
          }
        }
      }
    },
    "사진 보관 방식": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo storage"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo storage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の保存方法"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관 방식"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片的归档方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片的歸檔方式"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Способ хранения фото"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenamiento de fotos"
          }
        }
      }
    },
    "사진 위 버튼은 가장자리 효과를 켜서 대비를 확보합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons over photos turn on the edge effect to secure contrast."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons over photos turn on the edge effect to secure contrast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の上のボタンは、エッジエフェクトをオンにしてコントラストを確保します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 위 버튼은 가장자리 효과를 켜서 대비를 확보합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片上的按钮要开启边缘效果来保证对比度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片上的按鈕要開啟邊緣效果來保證對比度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки над фотографиями включают эффект края, чтобы обеспечить контраст."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones sobre fotos activan el efecto de borde para asegurar el contraste."
          }
        }
      }
    },
    "사진 위에 툴바가 떠 있는 화면에서 버튼 대비가 부족합니다. 어떻게 할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a screen with a toolbar floating over a photo, the buttons lack contrast. What should you do?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On a screen with a toolbar floating over a photo, the buttons lack contrast. What should you do?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の上にツールバーが浮いている画面で、ボタンのコントラストが足りません。どうしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 위에 툴바가 떠 있는 화면에서 버튼 대비가 부족합니다. 어떻게 할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片上悬浮着工具栏的界面里，按钮对比度不够。该怎么办？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片上懸浮著工具列的介面裡，按鈕對比度不夠。該怎麼辦？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране, где над фотографией парит панель инструментов, у кнопок не хватает контраста. Что делать?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una pantalla con una barra de herramientas flotando sobre una foto, los botones no tienen contraste. ¿Qué debes hacer?"
          }
        }
      }
    },
    "사진 전체 화면·영상 재생처럼 몰입이 주 작업일 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When immersion is the main task, like full-screen photos or video playback"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When immersion is the main task, like full-screen photos or video playback"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の全画面表示や動画再生のように、没入が主な作業のとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 전체 화면·영상 재생처럼 몰입이 주 작업일 때"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整张照片全屏、视频播放等以沉浸为主要任务时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整張照片全螢幕、影片播放等以沉浸為主要任務時"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда главная задача - погружение, как при просмотре фото на весь экран или воспроизведении видео"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la inmersión es la tarea principal, como fotos a pantalla completa o reproducción de vídeo"
          }
        }
      }
    },
