    "필터·상태처럼 상단에 상주하는 작은 컨트롤.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small controls that live at the top, like filters and status."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Small controls that live at the top, like filters and status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタや状態のように、上部に常駐する小さなコントロール。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터·상태처럼 상단에 상주하는 작은 컨트롤."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像筛选、状态这样常驻顶部的小控件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像篩選、狀態這樣常駐頂部的小控制元件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небольшие элементы управления, постоянно живущие вверху, например фильтры и состояние."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controles pequeños que viven arriba, como filtros y estado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Steuerelemente, die oben sitzen, wie Filter und Status."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petits contrôles qui vivent en haut, comme les filtres et l'état."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccoli controlli che stanno in alto, come filtri e stato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequenos controles que ficam no topo, como filtros e status."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวควบคุมขนาดเล็กที่อยู่ด้านบน เช่นตัวกรองและสถานะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các điều khiển nhỏ nằm ở trên cùng, như bộ lọc và trạng thái."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Malé ovladače, které žijí nahoře, jako filtry a stav."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Små kontroller, der bor øverst, som filtre og status."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μικροί έλεγχοι που ζουν στην κορυφή, όπως φίλτρα και κατάσταση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pienet säätimet, jotka asuvat ylhäällä, kuten suodattimet ja tila."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol kecil yang berada di atas, seperti filter dan status."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Små kontroller som bor øverst, som filtre og status."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine bedieningselementen die bovenaan wonen, zoals filters en status."
          }
        }
      }
    },
