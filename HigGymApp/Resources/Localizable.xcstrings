    "완료": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
      }
    },
    "완료 + 공유 + 별표를 trailing 클러스터로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done + Share + Star as a trailing cluster"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了 + 共有 + スターをtrailingクラスタに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 + 공유 + 별표를 trailing 클러스터로"
          }
        }
      }
    },
    "완료 · 취소 · 새로고침": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done · Cancel · Refresh"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了 · キャンセル · 更新"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 · 취소 · 새로고침"
          }
        }
      }
    },
    "완료를 고르기 전에 눈이 한 번 멈췄나요? 나머지 버튼들은 무엇을 하는 것 같았나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did your eyes pause before choosing Done? What did you think the other buttons would do?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了を選ぶ前に目が一度止まりましたか？ほかのボタンは何をするものに見えましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료를 고르기 전에 눈이 한 번 멈췄나요? 나머지 버튼들은 무엇을 하는 것 같았나요?"
          }
        }
      }
    },
    "완료를 하단에": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done at the bottom"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了を下部に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
