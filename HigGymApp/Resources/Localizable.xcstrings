    "한 줄에 제목 + 아이템 5개가 함께 있습니다. **제목이 어떻게 줄어드는지** 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One row holds a title + 5 items. Watch **how the title shrinks**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "One row holds a title + 5 items. Watch **how the title shrinks**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行にタイトル + アイテム5つが一緒にあります。**タイトルがどう縮むか**見てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 제목 + 아이템 5개가 함께 있습니다. **제목이 어떻게 줄어드는지** 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一行里同时有标题 + 5 个项目。看看**标题如何缩短**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一行裡同時有標題 + 5 個項目。看看**標題如何縮短**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В одной строке заголовок + 5 элементов. Смотрите, **как сжимается заголовок**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fila lleva un título + 5 elementos. Observa **cómo se encoge el título**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile enthält einen Titel + 5 Elemente. Beobachte, **wie der Titel schrumpft**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une rangée contient un titre + 5 éléments. Observez **comment le titre rétrécit**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga contiene un titolo + 5 elementi. Guarda **come si rimpicciolisce il titolo**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha tem um título + 5 itens. Observe **como o título encolhe**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนึ่งแถวถือชื่อเรื่อง + 5 รายการ ดู**ชื่อเรื่องหดอย่างไร**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một hàng chứa tiêu đề + 5 mục. Quan sát **tiêu đề co lại thế nào**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden řádek drží nadpis + 5 položek. Sledujte, **jak se nadpis zmenšuje**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én række rummer en titel + 5 elementer. Se, **hvordan titlen skrumper**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μία γραμμή κρατά έναν τίτλο + 5 στοιχεία. Πρόσεξε **πώς μικραίνει ο τίτλος**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi rivi pitää otsikon + 5 kohdetta. Katso, **miten otsikko kutistuu**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu baris memuat judul + 5 item. Perhatikan **bagaimana judul menyusut**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én rad rommer en tittel + 5 elementer. Se **hvordan tittelen krymper**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén rij bevat een titel + 5 items. Kijk **hoe de titel krimpt**."
          }
        }
      }
    },
