    "오른쪽 아래에서 새 노트를 만들어 보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new note from the bottom right"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new note from the bottom right"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右下から新しいメモを作ってみてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 아래에서 새 노트를 만들어 보세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在右下角新建一条笔记"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在右下角新建一條筆記"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новую заметку снизу справа"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear una nota nueva desde abajo a la derecha"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Notiz von unten rechts erstellen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer une nouvelle note depuis le bas à droite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una nuova nota dall'angolo in basso a destra"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar uma nova nota a partir do canto inferior direito"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างโน้ตใหม่จากขวาล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo ghi chú mới từ góc dưới bên phải"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořit novou poznámku vpravo dole"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret en ny note nederst til højre"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιούργησε μια νέα σημείωση από κάτω δεξιά"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo uusi muistiinpano oikeasta alakulmasta"
          }
        },
        "id": {
