          }
        }
      }
    },
    "%@\n이 설계 판단은 적절한가요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nIs this design decision appropriate?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nIs this design decision appropriate?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nこの設計判断は適切でしょうか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n이 설계 판단은 적절한가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n这个设计判断恰当吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n這個設計判斷恰當嗎？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nПодходит ли это проектное решение?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n¿Es adecuada esta decisión de diseño?"
          }
        }
      }
    },
