    "새로워 보여서가 아닙니다. 새 배치가 나온 이유가 도달성입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not because it looks new. Reachability is the reason the new layout exists."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not because it looks new. Reachability is the reason the new layout exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく見えるからではありません。新しい配置が生まれた理由は、手の届きやすさです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로워 보여서가 아닙니다. 새 배치가 나온 이유가 도달성입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是因为看起来新。出现新布局的原因是可触达性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是因為看起來新。出現新佈局的原因是可觸達性。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не потому, что выглядит новым. Причина появления новой раскладки - досягаемость."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No porque parezca nuevo. El alcance es la razón de que exista el nuevo diseño."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht, weil es neu aussieht. Erreichbarkeit ist der Grund, warum es das neue Layout gibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non pas parce que cela a l'air neuf. L'accessibilité au pouce est la raison d'être de la nouvelle disposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non perché sembri nuovo. La raggiungibilità è il motivo per cui esiste il nuovo layout."
          }
        }
      }
    },
