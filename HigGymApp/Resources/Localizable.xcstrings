    "본문용 서체 계약이 갱신되었습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contract for the body typeface has been renewed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The contract for the body typeface has been renewed."
          }
        },
