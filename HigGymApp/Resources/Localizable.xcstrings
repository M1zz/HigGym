          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab bar is hidden: Back is the only way out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーを隠しました。「戻る」が唯一の出口です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭바를 숨겼습니다, 뒤로가기가 유일한 출구입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
