            "state": "translated",
            "value": "What to suspect when tabs overflow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブがあふれたときに疑うこと"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭이 넘칠 때 의심할 것"
