    "화면 아래 · 검색 캡슐": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottom of the screen · search capsule"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottom of the screen · search capsule"
          }
        },
        "ja": {
          "stringUnit": {
