            "value": "// Criterio: ¿Es correcto que la gente lea todo lo de una cápsula como «un conjunto»?\nToolbarItemGroup(placement: .topBarLeading) { viewToggle; sort }\nToolbarItem(placement: .topBarTrailing) { Menu { delete } }"
          }
        },
        "de": {
