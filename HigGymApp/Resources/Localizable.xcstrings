    "새 API라서가 아니라, 이 액션의 대상이 제목이기 때문입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not because it's a new API, but because the target of this action is the title."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not because it's a new API, but because the target of this action is the title."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいAPIだからではなく、このアクションの対象がタイトルだからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 API라서가 아니라, 이 액션의 대상이 제목이기 때문입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是因为它是新 API，而是因为这个操作的对象是标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是因為它是新 API，而是因為這個操作的物件是標題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не потому, что это новый API, а потому, что объект этого действия - заголовок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No porque sea una API nueva, sino porque el objetivo de esta acción es el título."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht weil es eine neue API ist, sondern weil das Ziel dieser Aktion der Titel ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non pas parce que c'est une nouvelle API, mais parce que la cible de cette action est le titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non perché sia una nuova API, ma perché il bersaglio di questa azione è il titolo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não porque seja uma API nova, mas porque o alvo desta ação é o título."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่เพราะเป็น API ใหม่ แต่เพราะเป้าหมายของการกระทำนี้คือชื่อเรื่อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phải vì đó là API mới, mà vì đối tượng của hành động này là tiêu đề."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne proto, že je to nové API, ale proto, že cílem této akce je nadpis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke fordi det er et nyt API, men fordi målet for denne handling er titlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όχι επειδή είναι νέο API, αλλά επειδή ο στόχος αυτής της ενέργειας είναι ο τίτλος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei siksi, että se on uusi API, vaan koska tämän toiminnon kohde on otsikko."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan karena ini API baru, melainkan karena target aksi ini adalah judul."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke fordi det er et nytt API, men fordi målet for denne handlingen er tittelen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet omdat het een nieuwe API is, maar omdat het doel van deze actie de titel is."
          }
        }
      }
    },
