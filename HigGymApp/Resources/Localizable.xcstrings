        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque inline fica melhor visualmente"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพราะ inline ดูสวยกว่าในเชิงภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì inline trông đẹp hơn về mặt thị giác"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože inline vypadá vizuálně lépe"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi inline ser bedre ud visuelt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επειδή το inline φαίνεται καλύτερο οπτικά"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska inline näyttää visuaalisesti paremmalta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena inline terlihat lebih bagus secara visual"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi inline ser bedre ut visuelt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat inline er visueel beter uitziet"
          }
        }
      }
    },
