          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравните с 3.4.2 (search role). Одно место меняет смысл."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compáralo con 3.4.2 (rol de búsqueda). Un solo cambio de colocación cambia el significado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche mit 3.4.2 (Suchrolle). Eine einzige Platzierung ändert die Bedeutung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez avec 3.4.2 (rôle de recherche). Un seul placement change le sens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta con 3.4.2 (ruolo di ricerca). Un solo posizionamento cambia il significato."
          }
        }
      }
    },
