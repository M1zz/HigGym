        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악 재생 미니 플레이어처럼 어느 탭에 있든 유지돼야 하는 UI는?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像音乐播放迷你播放器这样，无论在哪个标签都要保持的 UI 用什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像音樂播放迷你播放器這樣，無論在哪個標籤都要保持的 UI 用什麼？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой интерфейс должен сохраняться на любой вкладке, например мини-плеер музыки?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué interfaz debe persistir en cualquier pestaña, como un minirreproductor de música?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
