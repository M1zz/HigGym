          }
        }
      }
    },
    "툴바를 최대한 비워 미니멀하게 보이려고": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep the toolbar as empty as possible so it looks minimal"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To keep the toolbar as empty as possible so it looks minimal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーをできるだけ空けてミニマルに見せるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "툴바를 최대한 비워 미니멀하게 보이려고"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了显得极简，把工具栏尽量清空"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了顯得極簡，把工具列儘量清空"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить панель инструментов максимально пустой, чтобы выглядело минималистично"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener la barra de herramientas lo más vacía posible para que se vea minimalista"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Symbolleiste so leer wie möglich halten, damit sie minimalistisch aussieht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder la barre d'outils aussi vide que possible pour qu'elle paraisse minimaliste"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere la barra degli strumenti il più vuota possibile così sembra minimale"
          }
        }
      }
    },
    "툴바에 아이템이 여럿 있는 상태에서 검색을 시작해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a search while the toolbar has several items."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a search while the toolbar has several items."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーにアイテムが複数ある状態で検索を始めてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "툴바에 아이템이 여럿 있는 상태에서 검색을 시작해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具栏里有多个项目的状态下开始搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在工具列裡有多個項目的狀態下開始搜尋。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните поиск, когда на панели инструментов несколько элементов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza una búsqueda mientras la barra de herramientas tiene varios elementos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte eine Suche, während die Symbolleiste mehrere Elemente hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez une recherche alors que la barre d'outils contient plusieurs éléments."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una ricerca mentre la barra degli strumenti ha diversi elementi."
          }
        }
      }
    },
    "틀렸던 것만 다시": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry missed questions"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry missed questions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違えた問題だけもう一度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틀렸던 것만 다시"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只看做错的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只看做錯的"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторить только ошибки"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar las preguntas falladas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verpasste Fragen wiederholen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenter les questions manquées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova le domande sbagliate"
          }
        }
      }
    },
    "틀린 문제가 생기면 여기 모입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions you get wrong collect here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions you get wrong collect here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違えた問題はここに集まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틀린 문제가 생기면 여기 모입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有做错的题就会聚在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有做錯的題就會聚在這裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы, на которых вы ошиблись, собираются здесь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se reúnen las preguntas que fallas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier sammeln sich Fragen, die du falsch beantwortest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les questions que vous ratez se rassemblent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui si raccolgono le domande a cui rispondi male."
          }
        }
      }
    },
    "틀린 문항의 화면을 다시 열어 두 쪽을 나란히 보면 차이가 남습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen the screen for a question you missed and look at both versions side by side. The difference will show."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen the screen for a question you missed and look at both versions side by side. The difference will show."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "間違えた問題の画面をもう一度開いて両方を並べて見ると、違いがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "틀린 문항의 화면을 다시 열어 두 쪽을 나란히 보면 차이가 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开做错的题的界面，把两边并排对比，差别就出来了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開啟做錯的題的介面，把兩邊並排對比，差別就出來了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте заново экран вопроса, на котором ошиблись, и сравните оба варианта рядом. Разница проявится."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir la pantalla de una pregunta que fallaste y mira ambas versiones una al lado de la otra. Se notará la diferencia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Bildschirm zu einer verpassten Frage erneut und sieh dir beide Versionen nebeneinander an. Der Unterschied wird sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez l'écran d'une question manquée et regardez les deux versions côte à côte. La différence se verra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri la schermata di una domanda sbagliata e guarda le due versioni affiancate. La differenza si vedrà."
          }
        }
      }
    },
