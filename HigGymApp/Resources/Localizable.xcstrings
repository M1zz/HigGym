          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo es correcto ocultar la barra de pestañas en una pantalla de detalle?"
          }
        }
      }
    },
    "탭바를 숨겼습니다, 뒤로가기가 유일한 출구입니다.": {
      "localizations": {
