    "크롬이 물러나야 할 대상. UI는 이걸 돕는 수단이지 주인공이 아닙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the chrome should step back for. UI is a means to support it, not the star."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What the chrome should step back for. UI is a means to support it, not the star."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クロームが引き下がるべき対象。UIはこれを助ける手段であって、主役ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크롬이 물러나야 할 대상. UI는 이걸 돕는 수단이지 주인공이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面框架该退后的对象。UI 是帮助它的手段，不是主角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面框架該退後的物件。UI 是幫助它的手段，不是主角。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, перед чем «хром» должен отступить. Интерфейс - средство для его поддержки, а не главный герой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquello ante lo que el cromo debe retroceder. La interfaz es un medio para apoyarlo, no el protagonista."
          }
        }
      }
    },
    "큰 제목이 성능에 부담을 주므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because large titles are a burden on performance"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because large titles are a burden on performance"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きいタイトルはパフォーマンスの負担になるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 제목이 성능에 부담을 주므로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为大标题会给性能带来负担"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為大標題會給效能帶來負擔"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что крупные заголовки - нагрузка на производительность"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque los títulos grandes son una carga para el rendimiento"
          }
        }
      }
    },
