    "버튼 색을 더 밝은 흰색으로 바꾼다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the button color a brighter white"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the button colour a brighter white"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンの色をもっと明るい白に変える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼 색을 더 밝은 흰색으로 바꾼다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把按钮颜色改成更亮的白色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把按鈕顏色改成更亮的白色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать цвет кнопки более ярким белым"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer el color del botón un blanco más brillante"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Button-Farbe in ein helleres Weiß ändern"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendre la couleur du bouton d'un blanc plus lumineux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendere il colore del pulsante un bianco più luminoso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar a cor do botão um branco mais brilhante"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำสีปุ่มให้เป็นสีขาวที่สว่างขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm màu nút trắng sáng hơn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udělat barvu tlačítek světlejší bílou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør knapfarven til en lysere hvid"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάνε το χρώμα του κουμπιού πιο φωτεινό λευκό"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tee painikkeen väristä kirkkaampi valkoinen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat warna tombol menjadi putih yang lebih terang"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør knappefargen til en lysere hvit"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak de knopkleur een helderder wit"
          }
        }
      }
    },
    "버튼 하나. 몇 개를 어느 자리에 두느냐가 곧 이 화면의 문법입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One button. How many you place, and where, is the grammar of this screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "One button. How many you place, and where, is the grammar of this screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンは1つ。何個をどこに置くかが、そのままこの画面の文法です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼 하나. 몇 개를 어느 자리에 두느냐가 곧 이 화면의 문법입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个按钮。放几个、放在哪个位置，就是这个界面的语法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個按鈕。放幾個、放在哪個位置，就是這個介面的語法。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна кнопка. Сколько их и где они стоят - это грамматика данного экрана."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón. Cuántos pones y dónde es la gramática de esta pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Button. Wie viele du setzt und wo, ist die Grammatik dieses Bildschirms."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bouton. Combien vous en placez, et où, c'est la grammaire de cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pulsante. Quanti ne metti, e dove, è la grammatica di questa schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um botão. Quantos você coloca, e onde, é a gramática desta tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มเดียว จะวางกี่ปุ่มและวางตรงไหนคือไวยากรณ์ของหน้าจอนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nút. Bạn đặt bao nhiêu nút và ở đâu là ngữ pháp của màn hình này."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno tlačítko. Kolik jich umístíte a kam, je gramatikou této obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én knap. Hvor mange du placerer, og hvor, er denne skærms grammatik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα κουμπί. Πόσα βάζεις και πού είναι η γραμματική αυτής της οθόνης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi painike. Se, kuinka monta sijoitat ja minne, on tämän näkymän kielioppia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu tombol. Berapa banyak yang kamu taruh, dan di mana, adalah tata bahasa layar ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én knapp. Hvor mange du plasserer, og hvor, er grammatikken til denne skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén knop. Hoeveel je er plaatst, en waar, is de grammatica van dit scherm."
          }
        }
      }
    },
    "버튼들을 균등하게 축소해 모두 표시한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrink all buttons evenly so they all fit"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrink all buttons evenly so they all fit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを均等に縮小してすべて表示する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼들을 균등하게 축소해 모두 표시한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把按钮等比缩小，全部显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把按鈕等比縮小，全部顯示"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Равномерно уменьшить все кнопки, чтобы поместились все"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir todos los botones por igual para que quepan todos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Buttons gleichmäßig verkleinern, damit alle passen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire tous les boutons uniformément pour qu'ils tiennent tous"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimpicciolire tutti i pulsanti in modo uniforme perché ci stiano tutti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encolher todos os botões por igual para que caibam todos"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย่อทุกปุ่มเท่า ๆ กันให้พอดีทั้งหมด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu nhỏ đều tất cả các nút để chúng vừa hết"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rovnoměrně zmenšit všechna tlačítka, aby se vešla"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krymp alle knapper jævnt, så de alle passer"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σμίκρυνε όλα τα κουμπιά ομοιόμορφα ώστε να χωρούν όλα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pienennä kaikkia painikkeita tasaisesti, jotta kaikki mahtuvat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecilkan semua tombol secara merata agar semuanya muat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krymp alle knappene jevnt slik at alle får plass"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verklein alle knoppen gelijkmatig zodat ze allemaal passen"
          }
        }
      }
    },
    "버튼에 불투명 배경색을 직접 지정한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the buttons an opaque background color directly"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the buttons an opaque background colour directly"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンに不透明な背景色を直接指定する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼에 불투명 배경색을 직접 지정한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给按钮直接指定不透明的背景色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給按鈕直接指定不透明的背景色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задать кнопкам непрозрачный цвет фона напрямую"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar a los botones directamente un color de fondo opaco"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Buttons direkt eine undurchsichtige Hintergrundfarbe geben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donner directement aux boutons une couleur de fond opaque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dare ai pulsanti direttamente un colore di sfondo opaco"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar aos botões diretamente uma cor de fundo opaca"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่สีพื้นหลังทึบให้ปุ่มโดยตรง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho các nút một màu nền đặc trực tiếp"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dát tlačítkům přímo neprůhlednou barvu pozadí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv knapperne direkte en uigennemsigtig baggrundsfarve"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώσε στα κουμπιά ένα αδιαφανές χρώμα φόντου απευθείας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna painikkeille suoraan läpinäkymätön taustaväri"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tombol warna latar buram secara langsung"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi knappene en ugjennomsiktig bakgrunnsfarge direkte"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef de knoppen direct een ondoorzichtige achtergrondkleur"
          }
        }
      }
    },
    "버튼을 눌러 캔버스가 실제로 바뀌는지 확인해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the buttons and check that the canvas really changes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the buttons and check that the canvas really changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを押して、キャンバスが実際に変わるか確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼을 눌러 캔버스가 실제로 바뀌는지 확인해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按按钮，确认画布是否真的变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點按鈕，確認畫布是否真的變化。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопки и проверьте, что холст действительно меняется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca los botones y comprueba que el lienzo realmente cambia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Buttons und prüfe, dass sich die Zeichenfläche wirklich ändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez les boutons et vérifiez que le canevas change vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca i pulsanti e controlla che la tela cambi davvero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nos botões e confira se o canvas realmente muda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มแล้วตรวจว่าแคนวาสเปลี่ยนจริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm các nút và kiểm tra canvas có thật sự thay đổi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na tlačítka a ověřte, že se plátno skutečně mění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på knapperne og tjek, at lærredet virkelig ændrer sig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε τα κουμπιά και έλεγξε ότι ο καμβάς αλλάζει πραγματικά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta painikkeita ja tarkista, että piirtoalue todella muuttuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol dan periksa bahwa kanvas benar-benar berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på knappene og sjekk at lerretet virkelig endres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de knoppen en controleer dat het canvas echt verandert."
          }
        }
      }
    },
    "버튼이 잘 안 보이는 순간이 있었나요? 어떤 사진이 지나갈 때였나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Was there a moment when the buttons were hard to see? What kind of photo was passing behind them?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Was there a moment when the buttons were hard to see? What kind of photo was passing behind them?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンが見えにくい瞬間はありましたか？どんな写真が通り過ぎたときでしたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼이 잘 안 보이는 순간이 있었나요? 어떤 사진이 지나갈 때였나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有没有哪一刻按钮看不清？是哪张照片经过的时候？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有沒有哪一刻按鈕看不清？是哪張照片經過的時候？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Были ли моменты, когда кнопки было трудно разглядеть? Какая фотография проходила за ними?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Hubo un momento en que los botones se veían mal? ¿Qué tipo de foto pasaba por detrás?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gab es einen Moment, in dem die Buttons schwer zu sehen waren? Was für ein Foto zog dahinter vorbei?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y a-t-il eu un moment où les boutons étaient difficiles à voir ? Quel genre de photo passait derrière eux ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è stato un momento in cui i pulsanti erano difficili da vedere? Che tipo di foto passava dietro?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Houve um momento em que os botões ficaram difíceis de ver? Que tipo de foto estava passando atrás deles?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีจังหวะที่ปุ่มมองยากไหม รูปถ่ายแบบไหนผ่านอยู่ด้านหลังมัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có lúc nào các nút khó thấy không? Loại ảnh nào đang đi qua phía sau chúng?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Byla chvíle, kdy byla tlačítka špatně vidět? Jaká fotka za nimi procházela?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Var der et øjeblik, hvor knapperne var svære at se? Hvilken slags foto passerede bag dem?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπήρξε στιγμή που τα κουμπιά ήταν δύσκολο να φανούν; Τι είδους φωτογραφία περνούσε πίσω τους;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oliko hetkiä, jolloin painikkeita oli vaikea nähdä? Millainen valokuva kulki niiden takaa?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah momen ketika tombol sulit dilihat? Foto macam apa yang lewat di belakangnya?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Var det et øyeblikk da knappene var vanskelige å se? Hva slags bilde passerte bak dem?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Was er een moment waarop de knoppen moeilijk te zien waren? Wat voor foto kwam erachter langs?"
          }
        }
      }
    },
