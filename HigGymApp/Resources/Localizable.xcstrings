        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab the person hasn't opened in a long time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーが長く開いていないタブ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
