          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断したレッスンをその段階から開きます。終えたレッスンなら次のレッスンを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멈춘 레슨을 그 단계부터 엽니다. 다 마친 편이면 다음 편을 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从中断的那一步重新打开课程。如果整篇已学完，就打开下一篇。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從中斷的那一步重新開啟課程。如果整篇已學完，就開啟下一篇。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает приостановленный урок с того шага, где вы остановились. Если он пройден до конца, открывает следующий."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre una lección en pausa en el paso donde la dejaste. Si la has terminado, abre la siguiente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet eine pausierte Lektion an der Stelle, wo du aufgehört hast. Ist sie abgeschlossen, wird die nächste geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvre une leçon mise en pause à l'étape où vous vous étiez arrêté. Si vous l'avez terminée, ouvre la suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapre una lezione in pausa al passo in cui eri rimasto. Se l'hai finita, apre la successiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre uma lição pausada no passo em que você parou. Se você a terminou, abre a próxima."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดบทเรียนที่หยุดไว้อีกครั้งที่ขั้นตอนที่คุณค้างไว้ ถ้าเรียนจบแล้ว จะเปิดบทถัดไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở lại bài học đang tạm dừng ở bước bạn bỏ dở. Nếu bạn đã học xong, mở bài tiếp theo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu otevře přerušenou lekci u kroku, kde jste skončili. Pokud jste ji dokončili, otevře další."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genåbner en sat-på-pause-lektion ved det trin, hvor du slap. Hvis du har afsluttet den, åbner den den næste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει ξανά ένα μάθημα που διέκοψες στο βήμα που σταμάτησες. Αν το έχεις τελειώσει, ανοίγει το επόμενο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa keskeytetyn oppitunnin uudelleen vaiheessa, johon jäit. Jos olet suorittanut sen, avaa seuraavan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka kembali pelajaran yang dijeda pada langkah tempat kamu berhenti. Jika sudah selesai, membuka yang berikutnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner en pauset leksjon på trinnet der du slapp. Hvis du har fullført den, åpnes den neste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heropent een gepauzeerde les bij de stap waar je was gebleven. Als je hem hebt afgerond, opent hij de volgende."
          }
        }
      }
    },
