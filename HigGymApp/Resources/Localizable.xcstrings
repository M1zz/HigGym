            "state": "translated",
            "value": ".large, 결과에 집중시킨다"
          }
        }
      }
    },
    ".medium, 배경 지도를 보면서 결과를 본다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ".medium, shows results while the map stays visible"
          }
        },
        "ja": {
