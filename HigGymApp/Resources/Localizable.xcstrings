            "value": "// Criterion: Is it right for people to read everything in one capsule as \"one set\"?\nToolbarItemGroup(placement: .topBarLeading) { viewToggle; sort }\nToolbarItem(placement: .topBarTrailing) { Menu { delete } }"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "// 基準：同じカプセルに入ったものをユーザーが「ひとまとまり」と読んでも正しいか？\nToolbarItemGroup(placement: .topBarLeading) { viewToggle; sort }\nToolbarItem(placement: .topBarTrailing) { Menu { delete } }"
          }
        },
        "ko": {
          "stringUnit": {
