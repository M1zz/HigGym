    },
    "코드·주소·인증번호처럼 **옮겨 적을 일이 있는 텍스트**에는 켜는 편이 맞습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's better to turn it on for **text people need to copy down**, like codes, addresses, and verification codes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's better to turn it on for **text people need to copy down**, like codes, addresses, and verification codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コード、住所、認証番号のように**書き写す必要があるテキスト**では、オンにするのが適切です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드·주소·인증번호처럼 **옮겨 적을 일이 있는 텍스트**에는 켜는 편이 맞습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对代码、地址、验证码这类**需要抄写的文本**，开启更合适。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對程式碼、地址、驗證碼這類**需要抄寫的文字**，開啟更合適。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучше включить для **текста, который людям нужно переписать**, например кодов, адресов и проверочных кодов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conviene activarlo para **texto que la gente necesita apuntar**, como códigos, direcciones y códigos de verificación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist besser, es für **Text einzuschalten, den Menschen sich notieren müssen**, wie Codes, Adressen und Bestätigungscodes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vaut mieux l'activer pour **le texte que les gens doivent noter**, comme les codes, les adresses et les codes de vérification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conviene attivarla per **il testo che le persone devono copiare**, come codici, indirizzi e codici di verifica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É melhor ativá-lo para **o texto que as pessoas precisam anotar**, como códigos, endereços e códigos de verificação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควรเปิดสำหรับ**ข้อความที่คนต้องจดไว้** เช่นรหัส ที่อยู่ และรหัสยืนยัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nên bật nó cho **văn bản người ta cần ghi lại**, như mã, địa chỉ và mã xác minh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lepší to zapnout pro **text, který si lidé potřebují opsat**, jako jsou kódy, adresy a ověřovací kódy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er bedst at slå det til for **tekst, folk skal skrive af**, som koder, adresser og bekræftelseskoder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι καλύτερα να το ενεργοποιείς για **κείμενο που οι άνθρωποι πρέπει να αντιγράφουν**, όπως κωδικούς, διευθύνσεις και κωδικούς επαλήθευσης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kannattaa kytkeä päälle **tekstille, jonka ihmisten täytyy kirjoittaa muistiin**, kuten koodeille, osoitteille ja vahvistuskoodeille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebaiknya nyalakan untuk **teks yang perlu dicatat orang**, seperti kode, alamat, dan kode verifikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er bedre å slå det på for **tekst folk trenger å skrive av**, som koder, adresser og verifiseringskoder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is beter om het aan te zetten voor **tekst die mensen moeten overschrijven**, zoals codes, adressen en verificatiecodes."
          }
        }
      }
    },
