    "라벨을 줄이지 않고 아이콘만 남기는 방식을 검토합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consider keeping only the icons instead of shortening the labels."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Consider keeping only the icons instead of shortening the labels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルを短くするのではなく、アイコンだけを残す方法を検討します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라벨을 줄이지 않고 아이콘만 남기는 방식을 검토합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "考虑不缩减标签，只保留图标的做法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "考慮不縮減標籤，只保留圖示的做法。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подумайте о том, чтобы оставить только значки, а подписи не сокращать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantéate dejar solo los iconos en lugar de acortar las etiquetas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erwäge, nur die Symbole zu behalten, statt die Beschriftungen zu kürzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envisagez de ne garder que les icônes plutôt que de raccourcir les libellés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta di tenere solo le icone invece di accorciare le etichette."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Considere manter só os ícones em vez de encurtar os rótulos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองเก็บไว้แค่ไอคอนแทนการย่อป้ายชื่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cân nhắc chỉ giữ biểu tượng thay vì rút ngắn nhãn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvažte ponechání jen ikon místo zkracování popisků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overvej kun at beholde ikonerne i stedet for at forkorte etiketterne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκέψου να κρατήσεις μόνο τα εικονίδια αντί να κονταίνεις τις ετικέτες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harkitse vain kuvakkeiden säilyttämistä nimikkeiden lyhentämisen sijaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertimbangkan hanya mempertahankan ikon alih-alih memperpendek label."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurder å beholde bare ikonene i stedet for å forkorte etikettene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overweeg alleen de icoontjes te houden in plaats van de labels te verkorten."
          }
        }
      }
    },
    "라벨이 없습니다. 아이콘만 보고 각 탭이 무엇일지 **맞혀보세요**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no labels. Look only at the icons and **guess** what each tab is."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no labels. Look only at the icons and **guess** what each tab is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルがありません。アイコンだけを見て、各タブが何かを**当ててみてください**。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라벨이 없습니다. 아이콘만 보고 각 탭이 무엇일지 **맞혀보세요**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有标签。只看图标，**猜猜**每个标签是什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有標籤。只看圖示，**猜猜**每個標籤是什麼。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписей нет. Смотрите только на значки и **угадайте**, что это за вкладки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay etiquetas. Mira solo los iconos y **adivina** qué es cada pestaña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine Beschriftungen. Sieh nur auf die Symbole und **rate**, was jeder Tab ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de libellés. Regardez seulement les icônes et **devinez** ce qu'est chaque onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono etichette. Guarda solo le icone e **indovina** che cos'è ogni scheda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há rótulos. Olhe só os ícones e **adivinhe** o que é cada aba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีป้ายชื่อ ดูแค่ไอคอนแล้ว**เดา**ว่าแต่ละแท็บคืออะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nhãn. Chỉ nhìn các biểu tượng và **đoán** mỗi tab là gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejsou tu žádné popisky. Dívejte se jen na ikony a **hádejte**, co která karta je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen etiketter. Se kun på ikonerne og **gæt**, hvad hver fane er."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ετικέτες. Κοίτα μόνο τα εικονίδια και **μάντεψε** τι είναι κάθε καρτέλα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimikkeitä ei ole. Katso vain kuvakkeita ja **arvaa**, mikä välilehti on mikä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada label. Lihat ikonnya saja dan **tebak** tiap tab itu apa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingen etiketter. Se bare på ikonene og **gjett** hva hver fane er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen labels. Kijk alleen naar de icoontjes en **raad** wat elk tabblad is."
          }
        }
      }
    },
    "라벨이 잘리지 않고, 손가락이 옆 탭을 건드리지도 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels aren't truncated, and your finger doesn't brush the neighboring tab."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels aren't truncated, and your finger doesn't brush the neighbouring tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルが切り詰められず、指が隣のタブに触れることもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라벨이 잘리지 않고, 손가락이 옆 탭을 건드리지도 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签不会被截断，手指也不会碰到旁边的标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤不會被截斷，手指也不會碰到旁邊的標籤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписи не обрезаются, и палец не задевает соседнюю вкладку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas no se truncan y tu dedo no roza la pestaña vecina."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschriftungen werden nicht abgeschnitten, und dein Finger streift nicht den Nachbar-Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les libellés ne sont pas tronqués, et votre doigt n'effleure pas l'onglet voisin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le etichette non sono troncate, e il dito non sfiora la scheda vicina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os rótulos não são truncados e seu dedo não encosta na aba ao lado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้ายชื่อไม่ถูกตัด และนิ้วของคุณไม่เฉียดแท็บข้าง ๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhãn không bị cắt, và ngón tay bạn không quệt vào tab bên cạnh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Popisky nejsou oříznuté a prst nezavadí o sousední kartu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketterne er ikke afkortet, og din finger strejfer ikke fanen ved siden af."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ετικέτες δεν περικόπτονται και το δάχτυλό σου δεν αγγίζει την διπλανή καρτέλα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimikkeitä ei katkaista, eikä sormesi hipaise viereistä välilehteä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Label tidak terpotong, dan jarimu tidak menyentuh tab di sebelahnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etikettene kuttes ikke, og fingeren din streifer ikke fanen ved siden av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels worden niet afgekapt, en je vinger raakt het tabblad ernaast niet."
          }
        }
      }
    },
