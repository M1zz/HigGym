          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä epäillä, kun välilehdet ylivuotavat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang dicurigai saat tab meluap"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva du bør mistenke når faner flyter over"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je moet vermoeden als tabbladen overlopen"
          }
        }
      }
    },
    "탭이 둘뿐입니다, 하단 바 전체를 두 목적지가 나눠 씁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are only two tabs: two destinations share the whole bottom bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There are only two tabs: two destinations share the whole bottom bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブが2つだけです。下部のバー全体を2つの行き先で分け合っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭이 둘뿐입니다, 하단 바 전체를 두 목적지가 나눠 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签只有两个，整个底部栏由两个目的地分着用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤只有兩個，整個底部列由兩個目的地分著用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладок только две: два места назначения делят всю нижнюю панель."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hay dos pestañas: dos destinos comparten toda la barra inferior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nur zwei Tabs: Zwei Ziele teilen sich die ganze untere Leiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a que deux onglets : deux destinations se partagent toute la barre du bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono solo due schede: due destinazioni condividono l'intera barra in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há só duas abas: dois destinos dividem toda a barra inferior."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีแค่สองแท็บ: สองจุดหมายใช้แถบล่างทั้งแถบร่วมกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có hai tab: hai điểm đến chia nhau cả thanh dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jsou tu jen dvě karty: dva cíle sdílejí celý spodní panel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er kun to faner: to destinationer deler hele den nederste bjælke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχουν μόνο δύο καρτέλες: δύο προορισμοί μοιράζονται ολόκληρη την κάτω γραμμή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välilehtiä on vain kaksi: kaksi määränpäätä jakaa koko alapalkin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ada dua tab: dua tujuan berbagi seluruh bilah bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er bare to faner: to destinasjoner deler hele bunnlinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn maar twee tabbladen: twee bestemmingen delen de hele onderbalk."
          }
        }
      }
    },
    "탭이 둘인데 한쪽을 거의 안 쓴다면, 그건 탭이 아니라 화면 안의 전환일 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If there are two tabs and one is barely used, it may be a switch within a screen, not a tab."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If there are two tabs and one is barely used, it may be a switch within a screen, not a tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブが2つなのに片方をほとんど使わないなら、それはタブではなく画面内の切り替えかもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭이 둘인데 한쪽을 거의 안 쓴다면, 그건 탭이 아니라 화면 안의 전환일 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有两个标签，而其中一个几乎不用的话，那可能不是标签，而是界面内的切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有兩個標籤，而其中一個幾乎不用的話，那可能不是標籤，而是介面內的切換。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вкладок две, а одной почти не пользуются, то это, возможно, переключатель внутри экрана, а не вкладка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hay dos pestañas y una apenas se usa, puede ser un interruptor dentro de una pantalla, no una pestaña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt es zwei Tabs und einer wird kaum genutzt, ist es womöglich ein Schalter innerhalb eines Bildschirms und kein Tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il y a deux onglets et que l'un est à peine utilisé, c'est peut-être un interrupteur dans un écran, pas un onglet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ci sono due schede e una è usata a malapena, potrebbe essere un interruttore dentro una schermata, non una scheda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se há duas abas e uma é quase não usada, pode ser uma troca dentro de uma tela, não uma aba."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้ามีสองแท็บและอันหนึ่งแทบไม่ได้ใช้ อาจเป็นสวิตช์ในหน้าจอ ไม่ใช่แท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu có hai tab và một cái hầu như không dùng, đó có thể là một công tắc trong màn hình, không phải tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud jsou dvě karty a jedna se skoro nepoužívá, může jít o přepínač uvnitř obrazovky, ne o kartu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis der er to faner, og den ene næsten ikke bruges, kan det være en kontakt inde i en skærm, ikke en fane."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν υπάρχουν δύο καρτέλες και η μία σχεδόν δεν χρησιμοποιείται, μπορεί να είναι εναλλαγή μέσα σε οθόνη, όχι καρτέλα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos välilehtiä on kaksi ja toista käytetään tuskin lainkaan, se voi olla näkymän sisäinen kytkin, ei välilehti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ada dua tab dan satu hampir tidak dipakai, itu mungkin sakelar di dalam layar, bukan tab."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det er to faner og den ene knapt brukes, kan det være en bryter inne i en skjerm, ikke en fane."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als er twee tabbladen zijn en één nauwelijks wordt gebruikt, is het misschien een schakelaar binnen een scherm, geen tabblad."
          }
        }
      }
    },
    "터치 타깃이 아주 넉넉합니다. 두 세계를 오가는 앱이라면 이 이상 필요하지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The touch targets are very generous. For an app that moves between two worlds, you don't need more than this."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The touch targets are very generous. For an app that moves between two worlds, you don't need more than this."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチターゲットがとても広々としています。2つの世界を行き来するアプリなら、これ以上は必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 타깃이 아주 넉넉합니다. 두 세계를 오가는 앱이라면 이 이상 필요하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控目标非常宽裕。如果是在两个世界之间往返的应用，再多也不需要了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸控目標非常寬裕。如果是在兩個世界之間往返的應用程式，再多也不需要了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Области касания очень просторные. Для приложения, которое переключается между двумя мирами, больше не нужно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetivos táctiles son muy generosos. Para una app que se mueve entre dos mundos, no necesitas más que esto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Touch-Ziele sind sehr großzügig. Für eine App, die zwischen zwei Welten wechselt, brauchst du nicht mehr als das."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cibles tactiles sont très généreuses. Pour une app qui navigue entre deux mondes, vous n'avez pas besoin de plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I bersagli del tocco sono molto generosi. Per un'app che si muove tra due mondi, non serve di più."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alvos de toque são muito generosos. Para um app que circula entre dois mundos, não precisa de mais que isso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป้าสัมผัสกว้างขวางมาก สำหรับแอปที่เคลื่อนระหว่างสองโลก ไม่ต้องการมากกว่านี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng chạm rất rộng rãi. Với app chuyển giữa hai thế giới, bạn không cần hơn thế."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotykové plochy jsou velmi štědré. Pro aplikaci, která se pohybuje mezi dvěma světy, víc než tohle nepotřebujete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Berøringsfladerne er meget generøse. For en app, der bevæger sig mellem to verdener, behøver du ikke mere end dette."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι στόχοι αφής είναι πολύ γενναιόδωροι. Για μια εφαρμογή που κινείται ανάμεσα σε δύο κόσμους, δεν χρειάζεσαι περισσότερα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosketuskohteet ovat hyvin runsaat. Sovellukselle, joka liikkuu kahden maailman välillä, et tarvitse enempää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Target sentuh sangat lega. Untuk aplikasi yang berpindah antara dua dunia, kamu tidak butuh lebih dari ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Berøringsmålene er svært romslige. For en app som beveger seg mellom to verdener trenger du ikke mer enn dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanraakdoelen zijn heel ruim. Voor een app die tussen twee werelden beweegt heb je niet meer nodig dan dit."
          }
        }
      }
    },
