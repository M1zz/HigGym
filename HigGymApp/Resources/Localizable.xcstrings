    "새로워 보여서가 아닙니다. 새 배치가 나온 이유가 도달성입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not because it looks new. Reachability is the reason the new layout exists."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not because it looks new. Reachability is the reason the new layout exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しく見えるからではありません。新しい配置が生まれた理由は、手の届きやすさです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로워 보여서가 아닙니다. 새 배치가 나온 이유가 도달성입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是因为看起来新。出现新布局的原因是可触达性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是因為看起來新。出現新佈局的原因是可觸達性。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не потому, что выглядит новым. Причина появления новой раскладки - досягаемость."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No porque parezca nuevo. El alcance es la razón de que exista el nuevo diseño."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht, weil es neu aussieht. Erreichbarkeit ist der Grund, warum es das neue Layout gibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non pas parce que cela a l'air neuf. L'accessibilité au pouce est la raison d'être de la nouvelle disposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non perché sembri nuovo. La raggiungibilità è il motivo per cui esiste il nuovo layout."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não porque pareça novo. A alcançabilidade é o motivo de o novo layout existir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่เพราะดูใหม่ แต่ความเอื้อมถึงคือเหตุผลที่เลย์เอาต์ใหม่นี้มีอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phải vì trông mới. Khả năng với tới là lý do bố cục mới này tồn tại."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne proto, že vypadá nově. Důvodem, proč nové rozvržení existuje, je dosažitelnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke fordi det ser nyt ud. Rækkevidde er grunden til, at det nye layout findes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όχι επειδή φαίνεται νέο. Η εμβέλεια είναι ο λόγος που υπάρχει η νέα διάταξη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei siksi, että se näyttää uudelta. Ulottuvuus on syy, miksi uusi asettelu on olemassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bukan karena terlihat baru. Keterjangkauan adalah alasan tata letak baru itu ada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke fordi det ser nytt ut. Rekkevidde er grunnen til at det nye oppsettet finnes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet omdat het er nieuw uitziet. Bereikbaarheid is de reden dat de nieuwe layout bestaat."
          }
        }
      }
    },
