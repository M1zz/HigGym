        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa arti pengelompokan ke dalam satu kapsul"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva gruppering i én kapsel betyr"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat groeperen in één capsule betekent"
          }
        }
      }
    },
    "한 캡슐에 묶인 것들은 사용자가 한 세트로 읽는다, 어느 쪽이 이 문법을 지켰습니까?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People read everything in one capsule as a set. Which version follows this grammar?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "People read everything in one capsule as a set. Which version follows this grammar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつのカプセルにまとめたものを、ユーザーはひとつのセットとして読みます。どちらがこの文法を守っていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 캡슐에 묶인 것들은 사용자가 한 세트로 읽는다, 어느 쪽이 이 문법을 지켰습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个胶囊里的东西，用户会读作一组：哪一边守住了这套语法？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一個膠囊裡的東西，使用者會讀作一組：哪一邊守住了這套語法？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Люди читают всё в одной капсуле как набор. Какой вариант следует этой грамматике?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La gente lee todo lo de una cápsula como un conjunto. ¿Qué versión sigue esta gramática?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen lesen alles in einer Kapsel als Set. Welche Version folgt dieser Grammatik?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gens lisent tout ce qui est dans une capsule comme un ensemble. Quelle version suit cette grammaire ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le persone leggono tutto ciò che sta in una capsula come un insieme. Quale versione segue questa grammatica?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas leem tudo numa cápsula como um conjunto. Qual versão segue esta gramática?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คนอ่านทุกอย่างในแคปซูลเดียวเป็นชุด เวอร์ชันไหนทำตามไวยากรณ์นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người ta đọc mọi thứ trong một capsule như một bộ. Phiên bản nào theo ngữ pháp này?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidé čtou všechno v jedné kapsli jako sadu. Která verze tuto gramatiku dodržuje?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk læser alt i én kapsel som et sæt. Hvilken version følger denne grammatik?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι άνθρωποι διαβάζουν ό,τι υπάρχει σε μία κάψουλα ως σύνολο. Ποια έκδοση ακολουθεί αυτή τη γραμματική;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmiset lukevat kaiken yhdessä kapselissa kokonaisuutena. Mikä versio noudattaa tätä kielioppia?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang membaca semua isi satu kapsul sebagai satu set. Versi mana yang mengikuti tata bahasa ini?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk leser alt i én kapsel som et sett. Hvilken versjon følger denne grammatikken?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen lezen alles in één capsule als een set. Welke versie volgt deze grammatica?"
          }
        }
      }
    },
    "한 편에 결정 하나를 다룹니다. 처음 만지는 화면은 일부러 가이드라인을 어긴 쪽입니다. 어색하다면 제대로 느낀 것이니 버그로 여기지 마세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each lesson covers one decision. The first screen you touch breaks the guidelines on purpose. If it feels off, you sensed it right, so don't take it for a bug."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Each lesson covers one decision. The first screen you touch breaks the guidelines on purpose. If it feels off, you sensed it right, so don't take it for a bug."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1本のレッスンでひとつの決定を扱います。最初に触る画面は、わざとガイドラインを破っています。違和感があれば正しく感じ取れているので、バグだと思わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 편에 결정 하나를 다룹니다. 처음 만지는 화면은 일부러 가이드라인을 어긴 쪽입니다. 어색하다면 제대로 느낀 것이니 버그로 여기지 마세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每篇讲一个决定。第一次摸到的界面是故意违反指南的一边。如果觉得别扭，说明你感觉对了，不要当成 bug。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每篇講一個決定。第一次摸到的介面是故意違反指南的一邊。如果覺得彆扭，說明你感覺對了，不要當成 bug。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый урок посвящён одному решению. Первый экран, которого вы касаетесь, нарушает рекомендации намеренно. Если он кажется неудобным, вы всё почувствовали верно, не принимайте это за ошибку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada lección trata una decisión. La primera pantalla que tocas rompe las pautas a propósito. Si te resulta rara, lo has percibido bien, así que no lo tomes por un error."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Lektion behandelt eine Entscheidung. Der erste Bildschirm, den du berührst, bricht die Richtlinien absichtlich. Fühlt er sich falsch an, hast du es richtig gespürt, halte es also nicht für einen Fehler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque leçon porte sur une décision. Le premier écran que vous touchez enfreint volontairement les consignes. Si cela vous paraît bizarre, vous l'avez bien senti, donc ne le prenez pas pour un bogue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni lezione tratta una decisione. La prima schermata che tocchi infrange le linee guida di proposito. Se ti sembra strana, hai percepito bene, quindi non scambiarla per un bug."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada lição trata de uma decisão. A primeira tela em que você toca quebra as diretrizes de propósito. Se pareceu estranha, você sentiu certo, então não confunda com um bug."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละบทเรียนครอบคลุมการตัดสินใจหนึ่งอย่าง หน้าจอแรกที่คุณแตะฝ่าฝืนแนวทางโดยตั้งใจ ถ้ารู้สึกแปลก แสดงว่าคุณรู้สึกถูกแล้ว อย่าเข้าใจผิดว่าเป็นบั๊ก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bài học xoay quanh một quyết định. Màn hình đầu tiên bạn chạm vào cố ý phá vỡ hướng dẫn. Nếu thấy lạ, bạn đã cảm nhận đúng, nên đừng nhầm nó là lỗi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá lekce pokrývá jedno rozhodnutí. První obrazovka, které se dotknete, záměrně porušuje zásady. Pokud vám připadá špatně, vycítili jste to správně, tak to nepovažujte za chybu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver lektion dækker én beslutning. Den første skærm, du rører ved, bryder med vilje retningslinjerne. Hvis det føles forkert, har du mærket det rigtigt, så tag det ikke for en fejl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε μάθημα καλύπτει μία απόφαση. Η πρώτη οθόνη που αγγίζεις παραβιάζει σκόπιμα τις οδηγίες. Αν σου φανεί περίεργη, το ένιωσες σωστά, οπότε μην τη θεωρήσεις σφάλμα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen oppitunti käsittelee yhtä päätöstä. Ensimmäinen koskettamasi näkymä rikkoo ohjeita tarkoituksella. Jos se tuntuu oudolta, aistit oikein, joten älä pidä sitä virheenä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pelajaran membahas satu keputusan. Layar pertama yang kamu sentuh sengaja melanggar pedoman. Jika terasa janggal, kamu merasakannya dengan benar, jadi jangan anggap itu bug."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver leksjon dekker én beslutning. Den første skjermen du berører bryter retningslinjene med vilje. Hvis det føles galt, merket du det riktig, så ikke ta det for en feil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke les behandelt één beslissing. Het eerste scherm dat je aanraakt breekt de richtlijnen met opzet. Als het niet goed voelt, voelde je het goed aan, dus zie het niet aan voor een bug."
          }
        }
      }
    },
    "한 편에 결정 하나입니다. **직접 써보고 → 느낀 것을 적고 → 이유를 확인하고 → 어긴 화면과 비교하고 → 배운 것을 남깁니다.** 쓰는 칸이 있어야 남기 때문에 순서를 건너뛸 수 없게 두었습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One decision per lesson. **Try it → write down what you felt → see why → compare with the broken version → note what you learned.** Writing is what makes it stick, so you can't skip steps."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "One decision per lesson. **Try it → write down what you felt → see why → compare with the broken version → note what you learned.** Writing is what makes it stick, so you can't skip steps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1本のレッスンでひとつの決定。**実際に触る → 感じたことを書く → 理由を確かめる → ルールを破った画面と比べる → 学んだことを残す**。書く欄があってこそ身につくので、順番を飛ばせないようにしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 편에 결정 하나입니다. **직접 써보고 → 느낀 것을 적고 → 이유를 확인하고 → 어긴 화면과 비교하고 → 배운 것을 남깁니다.** 쓰는 칸이 있어야 남기 때문에 순서를 건너뛸 수 없게 두었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每篇讲一个决定。**亲手试用 → 写下感受 → 确认原因 → 与违反规则的界面对比 → 留下所学。**有写的栏才能留得下，所以步骤不能跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每篇講一個決定。**親手試用 → 寫下感受 → 確認原因 → 與違反規則的介面對比 → 留下所學。**有寫的列才能留得下，所以步驟不能跳過。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно решение на урок. **Попробуйте → запишите, что почувствовали → узнайте причину → сравните с нарушающим вариантом → зафиксируйте усвоенное.** Запись помогает закрепить, поэтому шаги нельзя пропускать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una decisión por lección. **Pruébalo → anota lo que sentiste → entiende por qué → compara con la versión rota → apunta lo que aprendiste.** Escribir es lo que hace que se fije, así que no puedes saltarte pasos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Entscheidung pro Lektion. **Ausprobieren → aufschreiben, was du gespürt hast → verstehen warum → mit der fehlerhaften Version vergleichen → festhalten, was du gelernt hast.** Schreiben ist es, was das Gelernte festigt, daher kannst du keine Schritte überspringen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une décision par leçon. **Essayez → écrivez ce que vous avez ressenti → comprenez pourquoi → comparez avec la version fautive → notez ce que vous avez appris.** C'est l'écriture qui fait retenir, donc on ne peut pas sauter d'étapes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una decisione per lezione. **Prova → scrivi cosa hai sentito → scopri perché → confronta con la versione sbagliata → annota cosa hai imparato.** Scrivere è ciò che fa restare, quindi non puoi saltare passi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma decisão por lição. **Experimente → anote o que sentiu → entenda o porquê → compare com a versão quebrada → registre o que aprendeu.** Escrever é o que faz fixar, então você não pode pular passos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนึ่งบทเรียนหนึ่งการตัดสินใจ **ลองดู → จดสิ่งที่รู้สึก → ดูเหตุผล → เปรียบเทียบกับเวอร์ชันที่พัง → จดสิ่งที่เรียนรู้** การเขียนคือสิ่งที่ทำให้จำได้ คุณจึงข้ามขั้นตอนไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bài một quyết định. **Thử → ghi lại cảm nhận → xem lý do → so với phiên bản hỏng → ghi điều đã học.** Viết ra là thứ giúp nhớ lâu, nên bạn không thể bỏ bước."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno rozhodnutí na lekci. **Vyzkoušet → zapsat, co jste cítili → zjistit proč → porovnat s rozbitou verzí → poznamenat, co jste se naučili.** Zapisování je to, co to utuží, takže kroky nelze přeskočit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én beslutning pr. lektion. **Prøv det → skriv ned, hvad du følte → se hvorfor → sammenlign med den ødelagte version → noter, hvad du lærte.** At skrive er det, der får det til at sidde fast, så du kan ikke springe trin over."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μία απόφαση ανά μάθημα. **Δοκίμασέ το → γράψε τι ένιωσες → δες γιατί → σύγκρινε με την κατεστραμμένη έκδοση → σημείωσε τι έμαθες.** Η γραφή είναι αυτή που το κάνει να μείνει, οπότε δεν μπορείς να παραλείψεις βήματα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi päätös oppituntia kohti. **Kokeile → kirjoita muistiin, mitä tunsit → katso miksi → vertaa rikkinäiseen versioon → merkitse, mitä opit.** Kirjoittaminen saa asian jäämään mieleen, joten vaiheita ei voi ohittaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu keputusan per pelajaran. **Coba → tulis yang kamu rasakan → lihat mengapa → bandingkan dengan versi rusak → catat yang kamu pelajari.** Menulis yang membuatnya melekat, jadi kamu tidak bisa melewati langkah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én beslutning per leksjon. **Prøv det → skriv ned hva du følte → se hvorfor → sammenlign med den ødelagte versjonen → noter hva du lærte.** Å skrive er det som får det til å feste seg, så du kan ikke hoppe over trinn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén beslissing per les. **Probeer het → schrijf op wat je voelde → zie waarom → vergelijk met de kapotte versie → noteer wat je leerde.** Schrijven maakt dat het blijft hangen, dus je kunt geen stappen overslaan."
          }
        }
      }
    },
