        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tila säilyy välilehtien yli"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status ini bertahan di semua tab"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tilstanden består på tvers av faner"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze status blijft behouden over tabbladen heen"
          }
        }
      }
    },
    "탭을 하나씩 눌러보세요, 아이콘과 한 단어 제목이 함께 있는 표준형입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the tabs one by one: it's the standard style, with an icon and a one-word title."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the tabs one by one: it's the standard style, with an icon and a one-word title."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを一つずつ押してみてください。アイコンと一語のタイトルが並んだ標準形です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭을 하나씩 눌러보세요, 아이콘과 한 단어 제목이 함께 있는 표준형입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐个点按标签，这是图标加单字标题的标准形态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐個輕點標籤，這是圖示加單字標題的標準形態。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимайте вкладки по очереди: это стандартный вид со значком и заголовком из одного слова."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca las pestañas una a una: es el estilo estándar, con un icono y un título de una palabra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe die Tabs nacheinander an: Es ist der Standardstil, mit einem Symbol und einem Titel aus einem Wort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez les onglets un par un : c'est le style standard, avec une icône et un titre d'un mot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca le schede una per una: è lo stile standard, con un'icona e un titolo di una parola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nas abas uma a uma: é o estilo padrão, com um ícone e um título de uma palavra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะแท็บทีละอัน: เป็นสไตล์มาตรฐาน มีไอคอนและชื่อหนึ่งคำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm từng tab: đó là kiểu chuẩn, với biểu tượng và tiêu đề một từ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepejte na karty jednu po druhé: je to standardní styl s ikonou a jednoslovným nadpisem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på fanerne én ad gangen: det er standardstilen med et ikon og en titel på ét ord."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε τις καρτέλες μία προς μία: είναι το τυπικό στυλ, με εικονίδιο και τίτλο μίας λέξης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta välilehtiä yksi kerrallaan: se on vakiotyyli, jossa on kuvake ja yhden sanan otsikko."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tab satu per satu: ini gaya standar, dengan ikon dan judul satu kata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på fanene én etter én: det er standardstilen, med et ikon og en enordstittel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik de tabbladen één voor één aan: het is de standaardstijl, met een icoon en een titel van één woord."
          }
        }
      }
    },
    "탭이 5개를 넘을 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When there are more than 5 tabs"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When there are more than 5 tabs"
          }
        },
        "ja": {
          "stringUnit": {
