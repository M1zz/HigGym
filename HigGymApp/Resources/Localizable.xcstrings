            "value": "Crash rate this week: 0.12%, down 0.04 points from last week."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Crash rate this week: 0.12%, down 0.04 points from last week."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週のクラッシュ率は0.12%、先週より0.04ポイント改善。"
