    "작업 흐름 순서대로 정렬하면 논리적으로는 맞지만, 손의 습관과는 어긋난다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordering by workflow is logical, but it goes against the habits of the hand."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordering by workflow is logical, but it goes against the habits of the hand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業の流れの順に並べると論理的には正しいが、手の習慣とは食い違う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 흐름 순서대로 정렬하면 논리적으로는 맞지만, 손의 습관과는 어긋난다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按工作流顺序排列，逻辑上没错，但与手的习惯相悖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按工作流順序排列，邏輯上沒錯，但與手的習慣相悖。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядочение по ходу работы логично, но противоречит привычкам руки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar por flujo de trabajo es lógico, pero va contra los hábitos de la mano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Arbeitsablauf zu ordnen ist logisch, geht aber gegen die Gewohnheiten der Hand."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordonner selon le déroulement est logique, mais cela va à l'encontre des habitudes de la main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinare secondo il flusso di lavoro è logico, ma va contro le abitudini della mano."
          }
        }
      }
    },
    "잘려도 뜻이 통하는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does it still make sense when truncated?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Does it still make sense when truncated?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り詰めても意味が通じるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘려도 뜻이 통하는가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被截断后意思还通吗"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被截斷後意思還通嗎"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся ли смысл при обрезке?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sigue teniendo sentido al truncarlo?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergibt es abgeschnitten noch Sinn?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela garde-t-il un sens une fois tronqué ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ancora senso se troncato?"
          }
        }
      }
    },
    "잘려도 뜻이 통하는가로 도구를 고른다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the tool by whether it still makes sense when truncated"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the tool by whether it still makes sense when truncated"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り詰めても意味が通じるかで手段を選ぶ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘려도 뜻이 통하는가로 도구를 고른다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按“被截断后意思还通不通”来选工具"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按「被截斷後意思還通不通」來選工具"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте инструмент по тому, остаётся ли смысл при обрезке"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la herramienta según si sigue teniendo sentido al truncarse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle das Werkzeug danach, ob es abgeschnitten noch Sinn ergibt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'outil selon que cela garde un sens une fois tronqué"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli lo strumento in base a se ha ancora senso troncato"
