            "state": "translated",
            "value": "// fullScreenCover se nezavře přejetím prstem dolů. Cestu ven si musíte vytvořit sami.\n.fullScreenCover(isPresented: $editing) {\n    EditorView()\n        .toolbar {\n            ToolbarItem(placement: .topBarLeading) { Button(\"Zrušit\") { editing = false } }\n            ToolbarItem(placement: .topBarTrailing) { Button(\"Hotovo\") { save() } }\n        }\n}"
          }
        },
        "da": {
