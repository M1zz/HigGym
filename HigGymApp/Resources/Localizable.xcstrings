    "유행이 아니라 대상-액션 결합의 문제입니다(8.1.7).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not a trend. It's about tying actions to their targets (8.1.7)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not a trend. It's about tying actions to their targets (8.1.7)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流行ではなく、対象とアクションの結びつきの問題です（8.1.7）。"
