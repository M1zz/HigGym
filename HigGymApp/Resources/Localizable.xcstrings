    "온보딩·로그인 흐름에 fullScreenCover를 쓰는 이유는?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why use fullScreenCover for onboarding and sign-in flows?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Why use fullScreenCover for onboarding and sign-in flows?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンボーディングやログインのフローにfullScreenCoverを使う理由は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온보딩·로그인 흐름에 fullScreenCover를 쓰는 이유는?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新手引导、登录流程为什么用 fullScreenCover？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新手引導、登入流程為什麼用 fullScreenCover？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему для знакомства и входа используют fullScreenCover?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué usar fullScreenCover para los flujos de primeros pasos y de inicio de sesión?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum fullScreenCover für Einführungs- und Anmeldeabläufe verwenden?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi utiliser fullScreenCover pour les parcours d'onboarding et de connexion ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché usare fullScreenCover per i flussi di introduzione e di accesso?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que usar fullScreenCover para fluxos de introdução e de login?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไมจึงใช้ fullScreenCover สำหรับออนบอร์ดดิ้งและขั้นตอนลงชื่อเข้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao dùng fullScreenCover cho onboarding và luồng đăng nhập?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proč u úvodního provedení a přihlášení používat fullScreenCover?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor bruge fullScreenCover til introduktions- og login-flow?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γιατί να χρησιμοποιείς fullScreenCover για ροές εισαγωγής και σύνδεσης;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksi käyttää fullScreenCoveria perehdytys- ja kirjautumiskuluissa?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengapa memakai fullScreenCover untuk alur orientasi dan masuk akun?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor bruke fullScreenCover for onboarding og påloggingsflyter?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom fullScreenCover gebruiken voor onboarding- en aanmeldflows?"
          }
        }
      }
    },
    "옮겨 적을 값에는 길을 낸다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give values people copy a way out"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Give values people copy a way out"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き写す値には道をつくる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옮겨 적을 값에는 길을 낸다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为需要抄写的值开一条路"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為需要抄寫的值開一條路"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дайте путь для значений, которые копируют"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale una salida a los valores que la gente copia"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Werten, die Menschen kopieren, einen Ausweg"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donner une issue aux valeurs que les gens copient"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai una via d'uscita ai valori che le persone copiano"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê uma saída aos valores que as pessoas copiam"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้ทางออกแก่ค่าที่คนคัดลอก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho giá trị người ta sao chép một lối thoát"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte hodnotám, které lidé kopírují, cestu ven"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv værdier, folk kopierer, en vej ud"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δώσε διέξοδο στις τιμές που αντιγράφουν οι άνθρωποι"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna arvoille, joita ihmiset kopioivat, ulospääsy"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri nilai yang disalin orang sebuah jalan keluar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi verdier folk kopierer en vei ut"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef waarden die mensen kopiëren een uitweg"
          }
        }
      }
    },
    "옮겨 적을 값인데 선택이 막혀 있으면, 사용자가 눈으로 받아 적는다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a value people need to copy can't be selected, they copy it down by eye"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If a value people need to copy can't be selected, they copy it down by eye"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き写す値なのに選択できないと、ユーザーは目で見て書き写すことになる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옮겨 적을 값인데 선택이 막혀 있으면, 사용자가 눈으로 받아 적는다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明明是需要抄写的值，却禁止了选择，用户就只能靠眼睛看着抄"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明明是需要抄寫的值，卻禁止了選擇，使用者就只能靠眼睛看著抄"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если значение, которое нужно переписать, нельзя выделить, человек переписывает его глазами"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un valor que la gente necesita copiar no se puede seleccionar, lo copian a ojo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt sich ein Wert, den Menschen kopieren müssen, nicht auswählen, schreiben sie ihn nach Augenmaß ab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une valeur que les gens doivent copier ne peut pas être sélectionnée, ils la recopient à l'œil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un valore che le persone devono copiare non si può selezionare, lo ricopiano a occhio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um valor que as pessoas precisam copiar não pode ser selecionado, elas o copiam a olho"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าค่าที่คนต้องคัดลอกเลือกไม่ได้ พวกเขาจะจดตามสายตา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu giá trị người ta cần sao chép không chọn được, họ chép bằng mắt"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud hodnotu, kterou lidé potřebují zkopírovat, nelze vybrat, opisují ji očima"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis en værdi, folk skal kopiere, ikke kan markeres, skriver de den af med øjet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν μια τιμή που χρειάζεται να αντιγράψουν οι άνθρωποι δεν μπορεί να επιλεγεί, την αντιγράφουν με το μάτι"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos arvoa, jonka ihmisten täytyy kopioida, ei voi valita, he kirjoittavat sen silmämääräisesti"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika nilai yang perlu disalin orang tidak bisa dipilih, mereka menyalinnya dengan mata"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis en verdi folk trenger å kopiere ikke kan markeres, kopierer de den ned for øyet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een waarde die mensen moeten kopiëren niet kan worden geselecteerd, schrijven ze hem op het oog over"
          }
        }
      }
    },
    "옮겨 적을 일이 있는 값에는 선택·복사를 연다, 어느 쪽입니까? (본문을 길게 눌러보세요)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which one opens selection and copy for values people need to copy? (Try long-pressing the text)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Which one opens selection and copy for values people need to copy? (Try long-pressing the text)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き写す必要のある値には選択とコピーを開く。どちらですか？（本文を長押ししてみてください）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옮겨 적을 일이 있는 값에는 선택·복사를 연다, 어느 쪽입니까? (본문을 길게 눌러보세요)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对有抄写需求的值，要开放选择、复制：哪一边？（长按正文试试）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對有抄寫需求的值，要開放選擇、複製：哪一邊？（長按正文試試）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где открыто выделение и копирование для значений, которые нужно переписать? (Нажмите и удерживайте текст)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál abre la selección y la copia para los valores que la gente necesita copiar? (Prueba a mantener pulsado el texto)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche öffnet Auswahl und Kopieren für Werte, die Menschen kopieren müssen? (Versuche, den Text lange zu drücken)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
