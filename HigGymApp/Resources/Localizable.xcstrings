    "닫기 버튼이 없습니다. 쓸어내려도 그대로입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no close button. Swiping down doesn't do anything either."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no close button. Swiping down doesn't do anything either."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じるボタンがありません。下にスワイプしてもそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기 버튼이 없습니다. 쓸어내려도 그대로입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有关闭按钮。向下轻扫也没有反应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有關閉按鈕。向下輕掃也沒有反應。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки закрытия нет. Смахивание вниз тоже ничего не делает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay botón de cierre. Deslizar hacia abajo tampoco hace nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keinen Schließen-Button. Auch Wischen nach unten bewirkt nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de bouton de fermeture. Balayer vers le bas ne fait rien non plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è un pulsante di chiusura. Anche scorrere verso il basso non fa nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há botão de fechar. Deslizar para baixo também não faz nada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีปุ่มปิด การปัดลงก็ไม่ทำอะไรเช่นกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nút đóng. Vuốt xuống cũng không làm gì."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není tam tlačítko zavření. Přejetí dolů také nic nedělá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen lukkeknap. At stryge nedad gør heller ingenting."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει κουμπί κλεισίματος. Ούτε το σύρσιμο προς τα κάτω κάνει κάτι."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulkupainiketta ei ole. Alaspäin pyyhkäisykään ei tee mitään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tombol tutup. Mengusap ke bawah juga tidak melakukan apa-apa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ingen lukkeknapp. Å sveipe ned gjør heller ingenting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen sluitknop. Omlaag vegen doet ook niets."
          }
        }
      }
    },
    "닫기 버튼이 없으면 나갈 길이 없어, 사용자에게는 앱이 멈춘 것처럼 보인다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no close button, there's no way out, and to the user the app looks frozen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With no close button, there's no way out, and to the user the app looks frozen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じるボタンがないと出口がなく、ユーザーにはアプリが固まったように見える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기 버튼이 없으면 나갈 길이 없어, 사용자에게는 앱이 멈춘 것처럼 보인다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有关闭按钮就没有出路，在用户看来应用就像卡住了一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有關閉按鈕就沒有出路，在使用者看來應用程式就像卡住了一樣。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без кнопки закрытия выхода нет, и пользователю кажется, что приложение зависло."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin botón de cierre, no hay salida, y para el usuario la app parece congelada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Schließen-Button gibt es keinen Ausweg, und für den Nutzer wirkt die App eingefroren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans bouton de fermeture, il n'y a aucune issue, et pour l'utilisateur l'app semble figée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza pulsante di chiusura non c'è via d'uscita, e per l'utente l'app sembra bloccata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem botão de fechar, não há saída, e para o usuário o app parece travado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อไม่มีปุ่มปิดก็ไม่มีทางออก และสำหรับผู้ใช้แอปดูเหมือนค้าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nút đóng thì không có lối thoát, và với người dùng, app trông như bị treo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez tlačítka zavření nevede cesta ven a uživateli aplikace připadá zamrzlá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden lukkeknap er der ingen udvej, og for brugeren ser appen frosset ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς κουμπί κλεισίματος δεν υπάρχει διέξοδος, και για τον χρήστη η εφαρμογή φαίνεται παγωμένη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman sulkupainiketta ei ole ulospääsyä, ja käyttäjälle sovellus näyttää jumittuneelta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa tombol tutup, tidak ada jalan keluar, dan bagi pengguna aplikasi tampak membeku."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten lukkeknapp finnes det ingen vei ut, og for brukeren ser appen frosset ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder sluitknop is er geen uitweg, en voor de gebruiker lijkt de app bevroren."
          }
        }
      }
    },
    "닫는 방법은 화면 안의 명시적인 버튼뿐입니다. 그래서 그 버튼이 반드시 있어야 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only way to close it is an explicit button on the screen. That's why that button must be there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The only way to close it is an explicit button on the screen. That's why that button must be there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる方法は画面内の明示的なボタンだけです。だからそのボタンは必ずなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫는 방법은 화면 안의 명시적인 버튼뿐입니다. 그래서 그 버튼이 반드시 있어야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭的方式只有界面里明确的按钮。所以那个按钮必须存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉的方式只有介面裡明確的按鈕。所以那個按鈕必須存在。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть можно только явной кнопкой на экране. Поэтому эта кнопка обязательно должна быть."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La única forma de cerrarla es un botón explícito en pantalla. Por eso ese botón tiene que estar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der einzige Weg zum Schließen ist ein ausdrücklicher Button auf dem Bildschirm. Deshalb muss dieser Button da sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seule façon de la fermer est un bouton explicite à l'écran. C'est pourquoi ce bouton doit être là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'unico modo per chiuderlo è un pulsante esplicito sullo schermo. Ecco perché quel pulsante deve esserci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A única forma de fechar é um botão explícito na tela. Por isso esse botão precisa estar lá."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทางเดียวที่จะปิดได้คือปุ่มที่ชัดเจนบนหน้าจอ นั่นคือเหตุผลที่ต้องมีปุ่มนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách duy nhất để đóng là một nút rõ ràng trên màn hình. Đó là lý do nút đó phải có."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jediným způsobem zavření je výslovné tlačítko na obrazovce. Proto tam to tlačítko musí být."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den eneste måde at lukke den på er en eksplicit knap på skærmen. Derfor skal den knap være der."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο μόνος τρόπος να κλείσει είναι ένα ρητό κουμπί στην οθόνη. Γι' αυτό πρέπει να υπάρχει εκείνο το κουμπί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainoa tapa sulkea se on näytöllä oleva nimenomainen painike. Siksi sen painikkeen täytyy olla siinä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu-satunya cara menutupnya adalah tombol eksplisit di layar. Itulah mengapa tombol itu harus ada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den eneste måten å lukke den på er en eksplisitt knapp på skjermen. Derfor må den knappen være der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De enige manier om het te sluiten is een expliciete knop op het scherm. Daarom moet die knop er zijn."
          }
        }
      }
    },
    "닫는 방법을 찾았나요? 빨간 점선 버튼은 이 교재가 넣은 비상구입니다, 그게 없었다면 어떻게 했을까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you find a way to close it? The red dashed button is an emergency exit this course added. Without it, what would you have done?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you find a way to close it? The red dashed button is an emergency exit this course added. Without it, what would you have done?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる方法は見つかりましたか？赤い点線のボタンは、この教材が入れた非常口です。それがなかったらどうしていたでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫는 방법을 찾았나요? 빨간 점선 버튼은 이 교재가 넣은 비상구입니다, 그게 없었다면 어떻게 했을까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你找到关闭的方法了吗？红色虚线按钮是本教材放入的紧急出口，如果没有它，你会怎么办？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你找到關閉的方法了嗎？紅色虛線按鈕是本教材放入的緊急出口，如果沒有它，你會怎麼辦？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нашли способ закрыть? Красная пунктирная кнопка - аварийный выход, добавленный в этот курс. Что бы вы делали без неё?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Encontraste una forma de cerrarla? El botón rojo de línea discontinua es una salida de emergencia que añadió este curso. Sin él, ¿qué habrías hecho?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du einen Weg gefunden, es zu schließen? Der rot gestrichelte Button ist ein Notausgang, den dieser Kurs hinzugefügt hat. Was hättest du ohne ihn getan?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous trouvé un moyen de la fermer ? Le bouton rouge en pointillés est une issue de secours ajoutée par ce cours. Sans lui, qu'auriez-vous fait ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai trovato un modo per chiuderlo? Il pulsante rosso tratteggiato è un'uscita di emergenza aggiunta da questo corso. Senza, che cosa avresti fatto?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você achou um jeito de fechar? O botão vermelho tracejado é uma saída de emergência que este curso acrescentou. Sem ele, o que você teria feito?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเจอวิธีปิดไหม ปุ่มเส้นประสีแดงคือทางออกฉุกเฉินที่คอร์สนี้เพิ่มไว้ ถ้าไม่มีมัน คุณจะทำอย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có tìm ra cách đóng không? Nút gạch đứt màu đỏ là lối thoát khẩn cấp mà khóa học này thêm vào. Không có nó, bạn sẽ làm gì?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Našli jste způsob, jak to zavřít? Červené čárkované tlačítko je nouzový východ, který tento kurz přidal. Co byste dělali bez něj?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fandt du en måde at lukke den på? Den røde stiplede knap er en nødudgang, som dette kursus har tilføjet. Hvad ville du have gjort uden den?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρήκες τρόπο να το κλείσεις; Το κόκκινο διακεκομμένο κουμπί είναι μια έξοδος κινδύνου που πρόσθεσε αυτό το μάθημα. Χωρίς αυτό, τι θα έκανες;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Löysitkö tavan sulkea se? Punainen katkoviivapainike on tämän kurssin lisäämä hätäuloskäynti. Mitä olisit tehnyt ilman sitä?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah kamu menemukan cara menutupnya? Tombol putus-putus merah adalah pintu darurat yang ditambahkan kursus ini. Tanpa itu, apa yang akan kamu lakukan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant du en måte å lukke den på? Den røde stiplede knappen er en nødutgang dette kurset la til. Uten den, hva ville du ha gjort?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vond je een manier om het te sluiten? De rode gestippelde knop is een nooduitgang die deze cursus heeft toegevoegd. Wat had je zonder die knop gedaan?"
          }
        }
      }
    },
    "닫으면 원래 썸네일 자리로 돌아갑니다. 목록에서의 위치를 잃지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing returns it to the original thumbnail's spot. You don't lose your place in the list."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing returns it to the original thumbnail's spot. You don't lose your place in the list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じると元のサムネイルの位置に戻ります。リストでの位置を失いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫으면 원래 썸네일 자리로 돌아갑니다. 목록에서의 위치를 잃지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后会回到原来缩略图的位置。你不会丢失在列表中的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後會回到原來縮圖的位置。你不會丟失在列表中的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При закрытии он возвращается на место исходной миниатюры. Вы не теряете место в списке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar vuelve al sitio de la miniatura original. No pierdes tu posición en la lista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Schließen kehrt es an den Platz der ursprünglichen Vorschau zurück. Du verlierst deine Stelle in der Liste nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fermeture ramène à l'emplacement de la vignette d'origine. Vous ne perdez pas votre place dans la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo, torna al punto della miniatura originale. Non perdi il tuo posto nell'elenco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar devolve ao lugar da miniatura original. Você não perde seu lugar na lista."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิดมันจะกลับไปที่ตำแหน่งของภาพย่อเดิม คุณไม่เสียตำแหน่งในรายการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng thì nó trở về vị trí của hình thu nhỏ ban đầu. Bạn không mất vị trí trong danh sách."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavřením se vrátí na místo původní miniatury. Neztratíte své místo v seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukning fører tilbage til den oprindelige miniatures plads. Du mister ikke din plads i listen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλείσιμο επιστρέφει στη θέση της αρχικής μικρογραφίας. Δεν χάνεις τη θέση σου στη λίστα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulkeminen palauttaa sen alkuperäisen pikkukuvan paikalle. Et menetä paikkaasi luettelossa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menutup mengembalikannya ke tempat thumbnail asal. Kamu tidak kehilangan posisimu di daftar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å lukke returnerer den til det opprinnelige miniatyrbildets plass. Du mister ikke plassen din i listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluiten brengt het terug naar de plek van de oorspronkelijke thumbnail. Je verliest je plek in de lijst niet."
          }
        }
      }
    },
    "닫을 때도 원래 카드로 돌아갑니다, \"내가 누른 그것\"이라는 감각이 유지됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing also returns it to the original card, keeping the sense of \"the thing I tapped.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing also returns it to the original card, keeping the sense of \"the thing I tapped.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じるときも元のカードに戻ります。「自分がタップしたもの」という感覚が保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫을 때도 원래 카드로 돌아갑니다, \"내가 누른 그것\"이라는 감각이 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时也会回到原来的卡片，“我点的就是它”的感觉得以保持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉時也會回到原來的卡片，「我點的就是它」的感覺得以保持。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При закрытии он тоже возвращается к исходной карточке, сохраняя ощущение «то, на что я нажал»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar también vuelve a la tarjeta original, conservando la sensación de «lo que toqué»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Schließen kehrt es auch zur ursprünglichen Karte zurück und bewahrt das Gefühl von „das, was ich angetippt habe“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fermeture ramène aussi à la carte d'origine, en gardant le sentiment de « ce que j'ai touché »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo, torna anche alla carta originale, mantenendo la sensazione di «quello che ho toccato»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar também devolve ao cartão original, mantendo a sensação de «aquilo em que toquei»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิดมันก็กลับไปที่การ์ดเดิมเช่นกัน คงความรู้สึกของ \"สิ่งที่ฉันแตะ\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng cũng đưa nó về thẻ ban đầu, giữ cảm giác \"thứ tôi đã chạm\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavření také vrátí na původní kartu a zachová pocit „toho, na co jsem klepl(a)“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukning fører også tilbage til det oprindelige kort og bevarer fornemmelsen af »det, jeg trykkede på.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κλείσιμο επιστρέφει επίσης στην αρχική κάρτα, διατηρώντας την αίσθηση του «αυτού που πάτησα»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulkeminen palauttaa sen myös alkuperäiseen korttiin, säilyttäen tunteen ”siitä, jota napautin”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menutup juga mengembalikannya ke kartu asal, menjaga rasa \"yang tadi kuketuk.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å lukke returnerer den også til det opprinnelige kortet, og bevarer følelsen av «det jeg trykket på»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluiten brengt het ook terug naar de oorspronkelijke kaart, waardoor het gevoel van \"het ding waarop ik tikte\" blijft."
          }
        }
      }
    },
    "답보다 내 문장이 먼저": {
