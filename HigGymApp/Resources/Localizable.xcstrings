    "%@에 %lld개, 그룹당 2~3개가 적정입니다. 그 이상은 overflow(⋯)나 하단 바로 분산하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has %lld items. Two or three per group is right. Spread anything beyond that into overflow (⋯) or the bottom bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has %lld items. Two or three per group is right. Spread anything beyond that into overflow (⋯) or the bottom bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に%lld個あります。グループあたり2〜3個が適量です。それ以上はoverflow（⋯）や下部のバーに分散させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@에 %2$lld개, 그룹당 2~3개가 적정입니다. 그 이상은 overflow(⋯)나 하단 바로 분산하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中放 %2$lld 个，每组 2 到 3 个比较合适。超出的请分散到溢出菜单（⋯）或底部栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中放 %2$lld 個，每組 2 到 3 個比較合適。超出的請分散到溢位選單（⋯）或底部列。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%1$@» %2$lld шт. Оптимально 2-3 в группе. Остальное вынесите в меню переполнения (⋯) или в нижнюю панель."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiene %2$lld elementos. Lo adecuado son dos o tres por grupo. Lo que sobre, repártelo en el desbordamiento (⋯) o en la barra inferior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat %2$lld Elemente. Zwei oder drei pro Gruppe sind richtig. Alles darüber hinaus gehört in den Überlauf (⋯) oder die untere Leiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contient %2$lld éléments. Deux ou trois par groupe, c'est ce qu'il faut. Répartissez le reste dans le menu de débordement (⋯) ou la barre du bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha %2$lld elementi. Due o tre per gruppo vanno bene. Distribuisci il resto nel menu di overflow (⋯) o nella barra in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tem %2$lld itens. Dois ou três por grupo é o certo. Espalhe o que passar disso no overflow (⋯) ou na barra inferior."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ มี %2$lld รายการ กลุ่มละสองถึงสามรายการกำลังพอดี ส่วนที่เกินให้กระจายไปไว้ในเมนูเพิ่มเติม (⋯) หรือแถบด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ có %2$lld mục. Mỗi nhóm hai hoặc ba mục là vừa. Phần vượt quá hãy chuyển sang mục tràn (⋯) hoặc thanh dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: počet položek %2$lld. Správně jsou dvě nebo tři na skupinu. Zbytek rozložte do přetečení (⋯) nebo do spodního panelu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: antal elementer %2$lld. To eller tre pr. gruppe er rigtigt. Fordel resten i overløbet (⋯) eller i den nederste bjælke."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ έχει %2$lld στοιχεία. Δύο ή τρία ανά ομάδα είναι σωστό. Μοίρασε τα υπόλοιπα στο υπερχείλισμα (⋯) ή στη γραμμή κάτω."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: kohteita %2$lld. Kaksi tai kolme ryhmää kohti on sopiva määrä. Jaa loput ylivuotoon (⋯) tai alapalkkiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ memiliki %2$lld item. Dua atau tiga per grup sudah tepat. Sebarkan sisanya ke overflow (⋯) atau bilah bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ har %2$lld elementer. To eller tre per gruppe er passe. Spre alt utover det i overflyt (⋯) eller bunnlinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heeft %2$lld items. Twee of drie per groep is goed. Verdeel alles daarboven over overflow (⋯) of de onderbalk."
          }
        }
      }
    },
    "%@에 서로 다른 역할 %lld종이 한 묶음입니다. 관련 없는 액션을 기계적으로 한 캡슐에 넣으면 “한 세트”라는 신호가 거짓이 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ groups %lld different roles together. Mechanically putting unrelated actions in one capsule makes the “this is a set” signal a lie."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ groups %lld different roles together. Mechanically putting unrelated actions in one capsule makes the “this is a set” signal a lie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で役割の異なる%lld種類が1つにまとめられています。関係のないアクションを機械的に1つのカプセルに入れると、「ひとまとまり」というシグナルが嘘になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@에 서로 다른 역할 %2$lld종이 한 묶음입니다. 관련 없는 액션을 기계적으로 한 캡슐에 넣으면 “한 세트”라는 신호가 거짓이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中有 %2$lld 种不同角色被放进了同一组。机械地把无关操作塞进一个胶囊，会让“同一组”这个信号变成假信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中有 %2$lld 種不同角色被放進了同一組。機械地把無關操作塞進一個膠囊，會讓「同一組」這個訊號變成假資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%1$@» собрано %2$lld разных по роли элементов. Если механически класть несвязанные действия в одну капсулу, сигнал «один набор» становится ложным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ agrupa %2$lld funciones distintas. Meter de forma mecánica acciones sin relación en una cápsula hace que la señal de «esto es un conjunto» sea mentira."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fasst %2$lld verschiedene Aufgaben zusammen. Wer artfremde Aktionen mechanisch in eine Kapsel packt, macht das Signal „das ist ein Set“ zur Lüge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ regroupe %2$lld rôles différents. Mettre mécaniquement des actions sans rapport dans une même capsule transforme le signal « ceci est un ensemble » en mensonge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ raggruppa %2$lld ruoli diversi. Mettere meccanicamente azioni non correlate in una capsula trasforma il segnale «questo è un insieme» in una bugia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ agrupa %2$lld papéis diferentes. Colocar mecanicamente ações sem relação numa cápsula faz o sinal de «isto é um conjunto» virar mentira."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ รวมบทบาทที่ต่างกัน %2$lld แบบไว้ด้วยกัน การยัดการกระทำที่ไม่เกี่ยวข้องกันไว้ในแคปซูลเดียวแบบกลไก ทำให้สัญญาณ “นี่คือชุดเดียวกัน” กลายเป็นเรื่องโกหก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gộp %2$lld vai trò khác nhau vào một nhóm. Nhét máy móc các hành động không liên quan vào một capsule khiến tín hiệu “đây là một bộ” trở thành lời nói dối."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ spojuje různé role (počet: %2$lld). Mechanické vložení nesouvisejících akcí do jedné kapsle z hlášení „toto je sada“ dělá lež."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ samler forskellige roller (antal: %2$lld). Lægger du mekanisk urelaterede handlinger i én kapsel, bliver signalet »dette er et sæt« til en løgn."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ ομαδοποιεί %2$lld διαφορετικούς ρόλους. Αν βάζεις μηχανικά άσχετες ενέργειες σε μία κάψουλα, το σήμα «αυτό είναι ένα σύνολο» γίνεται ψέμα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ryhmittelee yhteen %2$lld erilaista roolia. Kun toisiinsa liittymättömiä toimintoja pannaan koneellisesti samaan kapseliin, ”tämä on yksi kokonaisuus” -viesti muuttuu valheeksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mengelompokkan %2$lld peran berbeda sekaligus. Memasukkan aksi yang tidak berkaitan ke satu kapsul secara mekanis membuat sinyal \"ini satu set\" menjadi dusta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ grupperer %2$lld ulike roller. Å mekanisk legge urelaterte handlinger i én kapsel gjør signalet «dette er et sett» til en løgn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ groepeert %2$lld verschillende rollen. Ongerelateerde acties mechanisch in één capsule stoppen maakt het signaal \"dit is een set\" een leugen."
          }
        }
      }
    },
    "%@에서 **삭제**가 다른 도구와 한 캡슐로 묶였습니다. 같은 캡슐 = 한 세트라서, 성격이 다른 파괴적 액션이 섞이면 묶음이 거짓 정보가 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, **Delete** shares a capsule with other tools. Same capsule means one set, so mixing in a destructive action of a different nature turns the grouping into false information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, **Delete** shares a capsule with other tools. Same capsule means one set, so mixing in a destructive action of a different nature turns the grouping into false information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で**削除**がほかのツールと同じカプセルにまとめられています。同じカプセルはひとまとまりを意味するので、性質の違う破壊的なアクションが混ざると、そのまとまりが誤った情報になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 **삭제**가 다른 도구와 한 캡슐로 묶였습니다. 같은 캡슐 = 한 세트라서, 성격이 다른 파괴적 액션이 섞이면 묶음이 거짓 정보가 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 里的**删除**和其他工具被放进了同一个胶囊。同一胶囊意味着同一组，性质不同的破坏性操作混在一起，这个分组就成了假信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 裡的**刪除**和其他工具被放進了同一個膠囊。同一膠囊意味著同一組，性質不同的破壞性操作混在一起，這個分組就成了假資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%@» **удаление** объединено с другими инструментами в одной капсуле. Одна капсула значит один набор, поэтому примесь разрушительных действий делает группу ложной информацией."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, **Eliminar** comparte cápsula con otras herramientas. La misma cápsula significa un mismo conjunto, así que mezclar una acción destructiva de distinta naturaleza convierte la agrupación en información falsa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ teilt sich **Löschen** eine Kapsel mit anderen Werkzeugen. Gleiche Kapsel heißt ein Set, daher macht das Daruntermischen einer andersartigen destruktiven Aktion die Gruppierung zu einer falschen Information."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans %@, **Supprimer** partage une capsule avec d'autres outils. Une même capsule signifie un seul ensemble, donc y mêler une action destructive de nature différente fait du regroupement une fausse information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, **Elimina** condivide una capsula con altri strumenti. Stessa capsula significa un solo insieme, quindi mescolare un'azione distruttiva di natura diversa trasforma il raggruppamento in un'informazione falsa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %@, **Excluir** divide a cápsula com outras ferramentas. Mesma cápsula significa um só conjunto, então misturar uma ação destrutiva de natureza diferente transforma o agrupamento em informação falsa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน %@ ปุ่ม**ลบ**อยู่ในแคปซูลเดียวกับเครื่องมืออื่น แคปซูลเดียวกันหมายถึงชุดเดียวกัน การปนการกระทำที่ทำลายข้อมูลซึ่งมีลักษณะต่างกันเข้าไปจึงทำให้การจัดกลุ่มกลายเป็นข้อมูลเท็จ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong %@, **Xóa** dùng chung capsule với các công cụ khác. Cùng capsule nghĩa là cùng một bộ, nên trộn thêm hành động phá hủy có bản chất khác biến việc nhóm thành thông tin sai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V %@ sdílí **Smazat** kapsli s dalšími nástroji. Stejná kapsle znamená jednu sadu, takže přimíchání destruktivní akce jiné povahy z uskupení dělá nepravdivou informaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I %@ deler **Slet** kapsel med andre værktøjer. Samme kapsel betyder ét sæt, så en destruktiv handling af en anden art gør grupperingen til falsk information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο %@, η **Διαγραφή** μοιράζεται κάψουλα με άλλα εργαλεία. Ίδια κάψουλα σημαίνει ένα σύνολο, οπότε η ανάμειξη μιας καταστροφικής ενέργειας διαφορετικής φύσης κάνει την ομαδοποίηση ψευδή πληροφορία."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteessa %@ **Poista** jakaa kapselin muiden työkalujen kanssa. Sama kapseli tarkoittaa yhtä kokonaisuutta, joten erilaisen, tuhoavan toiminnon sekoittaminen mukaan tekee ryhmittelystä väärää tietoa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di %@, **Hapus** berbagi kapsul dengan alat lain. Kapsul yang sama berarti satu set, jadi mencampurkan aksi destruktif yang sifatnya berbeda membuat pengelompokan menjadi informasi palsu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I %@ deler **Slett** kapsel med andre verktøy. Samme kapsel betyr ett sett, så å blande inn en destruktiv handling av en annen art gjør grupperingen til falsk informasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ deelt **Verwijder** een capsule met andere gereedschappen. Dezelfde capsule betekent één set, dus een destructieve actie van andere aard erbij stoppen maakt van de groepering valse informatie."
          }
        }
      }
    },
