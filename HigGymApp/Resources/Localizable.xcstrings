    "도구를 골라 눌러보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a tool and tap it"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a tool and tap it"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールを選んでタップしてみてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구를 골라 눌러보세요"
          }
        },
        "zh-Hans": {
