    "하단 스위치로 \"필요한 것만\" 구성과 비교해 보세요. 같은 화면이 얼마나 조용해지는지 봅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the switch at the bottom to compare with the \"only what's needed\" setup. See how much quieter the same screen gets."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the switch at the bottom to compare with the \"only what's needed\" setup. See how much quieter the same screen gets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のスイッチで「必要なものだけ」の構成と比べてみてください。同じ画面がどれだけ静かになるかを見ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 스위치로 \"필요한 것만\" 구성과 비교해 보세요. 같은 화면이 얼마나 조용해지는지 봅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用底部的开关与“只留必要的”配置做比较。看看同一个界面安静了多少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用底部的開關與「只留必要的」配置做比較。看看同一個介面安靜了多少。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключателем внизу сравните с конфигурацией «только нужное». Посмотрите, насколько тише становится тот же экран."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el interruptor de abajo para comparar con la configuración de «solo lo necesario». Mira cuánto se calma la misma pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze den Schalter unten, um mit der Konfiguration „nur das Nötige“ zu vergleichen. Sieh, wie viel ruhiger derselbe Bildschirm wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l'interrupteur du bas pour comparer avec la configuration « uniquement le nécessaire ». Voyez à quel point le même écran devient plus calme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l'interruttore in basso per confrontare con la configurazione «solo ciò che serve». Guarda quanto diventa più calma la stessa schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o interruptor embaixo para comparar com a configuração «só o necessário». Veja o quanto a mesma tela fica mais calma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สวิตช์ด้านล่างเพื่อเปรียบเทียบกับการตั้งค่า \"เฉพาะที่จำเป็น\" ดูว่าหน้าจอเดียวกันเงียบลงแค่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng công tắc ở dưới để so sánh với cấu hình \"chỉ những gì cần thiết\". Xem cùng màn hình yên tĩnh hơn bao nhiêu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomocí přepínače dole porovnejte s nastavením „jen to nutné“. Podívejte se, o kolik se tatáž obrazovka zklidní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug kontakten nederst til at sammenligne med opsætningen »kun det nødvendige«. Se, hvor meget roligere den samme skærm bliver."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε τον διακόπτη κάτω για να συγκρίνεις με τη διάταξη «μόνο όσα χρειάζονται». Δες πόσο πιο ήσυχη γίνεται η ίδια οθόνη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä alhaalla olevaa kytkintä verrataksesi ”vain tarvittava” -asetelmaan. Katso, kuinka paljon hiljaisemmaksi sama näkymä muuttuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan sakelar di bawah untuk membandingkan dengan penataan \"hanya yang dibutuhkan\". Lihat betapa lebih tenangnya layar yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk bryteren nederst til å sammenligne med oppsettet «bare det som trengs». Se hvor mye roligere den samme skjermen blir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de schakelaar onderaan om te vergelijken met de opzet \"alleen wat nodig is\". Zie hoeveel rustiger hetzelfde scherm wordt."
          }
        }
      }
    },
    "하단 시스템의 풀 구성입니다, 탭 + 검색 캡슐 + 액세서리 + 최소화.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full bottom system: tabs + search capsule + accessory + minimize."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The full bottom system: tabs + search capsule + accessory + minimise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部システムのフル構成です。タブ + 検索カプセル + アクセサリ + 最小化。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 시스템의 풀 구성입니다, 탭 + 검색 캡슐 + 액세서리 + 최소화."
          }
        },
        "zh-Hans": {
