          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché usare safeAreaBar quando costruisci una barra di controllo personalizzata in basso?"
          }
        }
      }
    },
    "코드·주소·인증번호처럼 **옮겨 적을 일이 있는 텍스트**에는 켜는 편이 맞습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's better to turn it on for **text people need to copy down**, like codes, addresses, and verification codes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's better to turn it on for **text people need to copy down**, like codes, addresses, and verification codes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コード、住所、認証番号のように**書き写す必要があるテキスト**では、オンにするのが適切です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드·주소·인증번호처럼 **옮겨 적을 일이 있는 텍스트**에는 켜는 편이 맞습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对代码、地址、验证码这类**需要抄写的文本**，开启更合适。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對程式碼、地址、驗證碼這類**需要抄寫的文字**，開啟更合適。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучше включить для **текста, который людям нужно переписать**, например кодов, адресов и проверочных кодов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conviene activarlo para **texto que la gente necesita apuntar**, como códigos, direcciones y códigos de verificación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist besser, es für **Text einzuschalten, den Menschen sich notieren müssen**, wie Codes, Adressen und Bestätigungscodes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vaut mieux l'activer pour **le texte que les gens doivent noter**, comme les codes, les adresses et les codes de vérification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conviene attivarla per **il testo che le persone devono copiare**, come codici, indirizzi e codici di verifica."
          }
        }
      }
    },
    "콘텐츠": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Content"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контент"
          }
        },
        "es": {
          "stringUnit": {
