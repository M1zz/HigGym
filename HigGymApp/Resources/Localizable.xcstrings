    "정렬과 표시 옵션을 바꾸면 목록이 **실제로** 바뀝니다. 메뉴는 창고가 아니라 조작 장치입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the sort and display options **actually** changes the list. A menu is a set of controls, not a storage closet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the sort and display options **actually** changes the list. A menu is a set of controls, not a storage closet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並べ替えと表示オプションを変えると、リストが**実際に**変わります。メニューは倉庫ではなく操作装置です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정렬과 표시 옵션을 바꾸면 목록이 **실제로** 바뀝니다. 메뉴는 창고가 아니라 조작 장치입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改变排序和显示选项，列表会**真的**变化。菜单不是仓库，而是操作装置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改變排序和顯示選項，列表會**真的**變化。選單不是倉庫，而是操作裝置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение параметров сортировки и отображения **действительно** меняет список. Меню - это пульт управления, а не кладовка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar las opciones de orden y visualización **sí** cambia la lista. Un menú es un conjunto de controles, no un trastero."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ändern der Sortier- und Anzeigeoptionen ändert die Liste **wirklich**. Ein Menü ist eine Menge von Steuerelementen, keine Abstellkammer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer les options de tri et d'affichage change **vraiment** la liste. Un menu est un ensemble de contrôles, pas un débarras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare le opzioni di ordinamento e di visualizzazione cambia **davvero** l'elenco. Un menu è un insieme di controlli, non un ripostiglio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudar as opções de ordenação e exibição **realmente** muda a lista. Um menu é um conjunto de controles, não um armário de despejo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนการเรียงและตัวเลือกการแสดงผล**เปลี่ยนรายการจริง** เมนูคือชุดตัวควบคุม ไม่ใช่ห้องเก็บของ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi tùy chọn sắp xếp và hiển thị **thật sự** thay đổi danh sách. Menu là một bộ điều khiển, không phải tủ chứa đồ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změna řazení a možností zobrazení **skutečně** mění seznam. Nabídka je sada ovladačů, ne komora na úložiště."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændring af sorterings- og visningsindstillinger **ændrer** faktisk listen. En menu er et sæt kontroller, ikke et opbevaringsskab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αλλαγή των επιλογών ταξινόμησης και προβολής **πραγματικά** αλλάζει τη λίστα. Ένα μενού είναι σύνολο ελέγχων, όχι αποθήκη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lajittelun ja näyttövalintojen muuttaminen **todella** muuttaa luetteloa. Valikko on joukko säätimiä, ei varastokomero."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengubah opsi urutan dan tampilan **benar-benar** mengubah daftar. Menu adalah kumpulan kontrol, bukan lemari penyimpanan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å endre sorterings- og visningsalternativene endrer **faktisk** listen. En meny er et sett med kontroller, ikke et oppbevaringsrom."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wijzigen van sorteer- en weergaveopties verandert **echt** de lijst. Een menu is een set bedieningselementen, geen opbergkast."
          }
        }
      }
    },
