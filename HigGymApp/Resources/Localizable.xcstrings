          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вероятность, что это поможет задаче данного экрана прямо сейчас (частота использования)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probabilidad de que ayude ahora mismo con la tarea de esta pantalla (frecuencia de uso)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie wahrscheinlich es ist, jetzt bei der Aufgabe dieses Bildschirms zu helfen (Nutzungshäufigkeit)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
