          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactar es un botón de la barra de herramientas inferior. Las pestañas son solo para destinos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfassen ist ein Button der unteren Symbolleiste. Tabs sind nur für Ziele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédiger est un bouton de la barre d'outils du bas. Les onglets sont réservés aux destinations."
