    "하단 바에 삭제를 단독으로 두면 엄지가 지나가다 눌러 되돌릴 수 없는 일이 벌어진다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Delete alone in the bottom bar, and a passing thumb can trigger something irreversible."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Delete alone in the bottom bar, and a passing thumb can trigger something irreversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーに削除を単独で置くと、通りがかった親指が押して取り返しのつかないことが起きる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바에 삭제를 단독으로 두면 엄지가 지나가다 눌러 되돌릴 수 없는 일이 벌어진다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把删除单独放在底部栏，拇指经过时会点到，造成无法挽回的后果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把刪除單獨放在底部列，拇指經過時會點到，造成無法挽回的後果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте «Удалить» одиноко в нижнюю панель, и проходящий большой палец может запустить необратимое действие."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon Eliminar solo en la barra inferior y un pulgar al pasar puede disparar algo irreversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze Löschen allein in die untere Leiste, und ein vorbeistreifender Daumen kann etwas Unumkehrbares auslösen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez Supprimer seul dans la barre du bas, et un pouce de passage peut déclencher quelque chose d'irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti Elimina da solo nella barra in basso e un pollice di passaggio può far scattare qualcosa di irreversibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque Excluir sozinho na barra inferior, e um polegar de passagem pode disparar algo irreversível."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางลบไว้ลำพังในแถบล่าง แล้วนิ้วโป้งที่ผ่านไปอาจกระตุ้นสิ่งที่ย้อนกลับไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt Xóa một mình ở thanh dưới, và một ngón cái lướt qua có thể kích hoạt điều không thể hoàn tác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte Smazat samotné do spodního panelu a procházející palec může spustit něco nevratného."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt Slet alene i den nederste bjælke, og en forbipasserende tommelfinger kan udløse noget uigenkaldeligt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε τη Διαγραφή μόνη της στην κάτω γραμμή και ένας αντίχειρας που περνά μπορεί να πυροδοτήσει κάτι μη αναστρέψιμο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita Poista yksinään alapalkkiin, ja ohi kulkeva peukalo voi laukaista jotain peruuttamatonta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh Hapus sendirian di bilah bawah, dan ibu jari yang lewat bisa memicu sesuatu yang tidak bisa dibatalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg Slett alene i bunnlinjen, og en forbipasserende tommel kan utløse noe som ikke kan angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Verwijder alleen in de onderbalk, en een voorbijkomende duim kan iets onomkeerbaars activeren."
          }
        }
      }
    },
    "하단 바에 혜택 배너 + 새 글 ↔ 새 글만. 배너는 목록 세 번째 자리로 옮겨졌습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo banner + New post in the bottom bar ↔ New post only. The banner moved to the third spot in the list."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Promo banner + New post in the bottom bar ↔ New post only. The banner moved to the third spot in the list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーにキャンペーンバナー + 新規投稿 ↔ 新規投稿だけ。バナーはリストの3番目に移りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바에 혜택 배너 + 새 글 ↔ 새 글만. 배너는 목록 세 번째 자리로 옮겨졌습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部栏放优惠横幅 + 新帖 ↔ 只放新帖。横幅被移到了列表的第三个位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "底部列放優惠橫幅 + 新帖 ↔ 只放新帖。橫幅被移到了列表的第三個位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промо-баннер + «Новая запись» в нижней панели ↔ только «Новая запись». Баннер переехал на третье место в списке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner promocional + Nueva publicación en la barra inferior ↔ solo Nueva publicación. El banner pasó al tercer puesto de la lista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbebanner + Neuer Beitrag in der unteren Leiste ↔ nur Neuer Beitrag. Das Banner rückte an die dritte Stelle der Liste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bannière promo + Nouvelle publication dans la barre du bas ↔ Nouvelle publication seule. La bannière est passée à la troisième place de la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner promozionale + Nuovo post nella barra in basso ↔ solo Nuovo post. Il banner è passato al terzo posto dell'elenco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner promocional + Nova publicação na barra inferior ↔ só Nova publicação. O banner foi para o terceiro lugar da lista."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แบนเนอร์โปรโมชัน + โพสต์ใหม่ในแถบล่าง ↔ โพสต์ใหม่อย่างเดียว แบนเนอร์ย้ายไปอยู่ตำแหน่งที่สามในรายการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu ngữ khuyến mãi + Bài đăng mới ở thanh dưới ↔ chỉ Bài đăng mới. Biểu ngữ chuyển xuống vị trí thứ ba trong danh sách."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Propagační banner + Nový příspěvek ve spodním panelu ↔ jen Nový příspěvek. Banner se přesunul na třetí místo v seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamebanner + Nyt opslag i den nederste bjælke ↔ kun Nyt opslag. Banneret flyttede til tredjepladsen i listen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner προώθησης + Νέα ανάρτηση στην κάτω γραμμή ↔ μόνο Νέα ανάρτηση. Το banner μετακινήθηκε στην τρίτη θέση της λίστας."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainosbanneri + Uusi julkaisu alapalkissa ↔ vain Uusi julkaisu. Banneri siirtyi luettelon kolmanteen paikkaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner promo + Postingan baru di bilah bawah ↔ hanya Postingan baru. Banner dipindah ke tempat ketiga di daftar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kampanjebanner + Nytt innlegg i bunnlinjen ↔ bare Nytt innlegg. Banneret flyttet til tredje plass i listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Promobanner + Nieuw bericht in de onderbalk ↔ alleen Nieuw bericht. De banner verhuisde naar de derde plek in de lijst."
          }
        }
      }
    },
    "하단 바에는 이 화면의 조작(새 글쓰기)만 두고, 프로모션은 콘텐츠 흐름 안으로 넣었다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept only this screen's control (new post) in the bottom bar and moved the promotion into the flow of content."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept only this screen's control (new post) in the bottom bar and moved the promotion into the flow of content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーにはこの画面の操作（新規投稿）だけを置き、プロモーションはコンテンツの流れの中に入れた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바에는 이 화면의 조작(새 글쓰기)만 두고, 프로모션은 콘텐츠 흐름 안으로 넣었다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部栏只放这个界面的操作（写新帖），促销被放进了内容流里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "底部列只放這個介面的操作（寫新帖），促銷被放進了內容流裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В нижней панели оставили только управление этого экрана (новая запись), а промо перенесли в поток контента."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dejó en la barra inferior solo el control de esta pantalla (nueva publicación) y se llevó la promoción al flujo del contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der unteren Leiste nur das Steuerelement dieses Bildschirms (Neuer Beitrag) behalten und die Werbung in den Inhaltsfluss verlegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'a gardé dans la barre du bas que le contrôle de cet écran (nouvelle publication) et déplacé la promotion dans le flux du contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella barra in basso è rimasto solo il controllo di questa schermata (nuovo post) e la promozione è passata nel flusso del contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manteve na barra inferior só o controle desta tela (nova publicação) e levou a promoção para dentro do fluxo de conteúdo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไว้ในแถบล่างเฉพาะตัวควบคุมของหน้าจอนี้ (โพสต์ใหม่) และย้ายโปรโมชันเข้าไปในกระแสเนื้อหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ giữ điều khiển của màn hình này (bài đăng mới) ở thanh dưới và chuyển khuyến mãi vào dòng nội dung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve spodním panelu ponechán jen ovladač této obrazovky (nový příspěvek) a propagace přesunuta do toku obsahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdt kun denne skærms kontrol (nyt opslag) i den nederste bjælke og flyttede reklamen ind i indholdets flow."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτησε στην κάτω γραμμή μόνο τον έλεγχο αυτής της οθόνης (νέα ανάρτηση) και μετέφερε την προώθηση στη ροή του περιεχομένου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piti alapalkissa vain tämän näkymän säätimen (uusi julkaisu) ja siirsi mainoksen sisällön virtaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya mempertahankan kontrol layar ini (postingan baru) di bilah bawah dan memindahkan promosi ke alur konten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdt bare denne skjermens kontroll (nytt innlegg) i bunnlinjen og flyttet kampanjen inn i innholdsflyten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het bedieningselement van dit scherm (nieuw bericht) in de onderbalk gehouden en de promotie verplaatst naar de inhoudsstroom."
          }
        }
      }
    },
    "하단 바의 **슬라이더**를 끌어보세요, 버튼이 아닌 뷰도 툴바에 들어갑니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the **slider** in the bottom bar: views that aren't buttons can go in a toolbar too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the **slider** in the bottom bar: views that aren't buttons can go in a toolbar too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部のバーの**スライダー**を動かしてみてください。ボタン以外のビューもツールバーに入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바의 **슬라이더**를 끌어보세요, 버튼이 아닌 뷰도 툴바에 들어갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动底部栏的**滑块**，不是按钮的视图也能放进工具栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動底部列的**滑塊**，不是按鈕的檢視也能放進工具列。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните **ползунок** в нижней панели: представления, не являющиеся кнопками, тоже могут стоять на панели инструментов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el **control deslizante** de la barra inferior: las vistas que no son botones también pueden ir en una barra de herramientas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe den **Schieberegler** in der unteren Leiste: Ansichten, die keine Buttons sind, können auch in eine Symbolleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser le **curseur** dans la barre du bas : des vues qui ne sont pas des boutons peuvent aussi aller dans une barre d'outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il **cursore** nella barra in basso: anche le viste che non sono pulsanti possono stare in una barra degli strumenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o **controle deslizante** na barra inferior: views que não são botões também podem ir numa barra de ferramentas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลาก**แถบเลื่อน**ในแถบล่าง: view ที่ไม่ใช่ปุ่มก็วางในแถบเครื่องมือได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo **thanh trượt** ở thanh dưới: các view không phải nút cũng có thể đặt trong thanh công cụ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhněte **posuvník** ve spodním panelu: do panelu nástrojů mohou jít i view, která nejsou tlačítka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk i **skyderen** i den nederste bjælke: visninger, der ikke er knapper, kan også sidde i en værktøjslinje."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρε το **ρυθμιστικό** στην κάτω γραμμή: και προβολές που δεν είναι κουμπιά μπορούν να μπουν σε γραμμή εργαλείων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä alapalkin **liukusäädintä**: näkymät, jotka eivät ole painikkeita, voivat mennä myös työkalupalkkiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret **penggeser** di bilah bawah: tampilan yang bukan tombol juga bisa masuk bilah alat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra **glidebryteren** i bunnlinjen: visninger som ikke er knapper kan også ligge i en verktøylinje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep de **schuifregelaar** in de onderbalk: weergaven die geen knoppen zijn kunnen ook in een werkbalk."
          }
        }
      }
    },
