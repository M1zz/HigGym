          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište kteroukoli z možností **Kim · Design · Build**. Opravdu to filtruje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv en af **Kim · Design · Build**. Det filtrerer faktisk."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πληκτρολόγησε οποιοδήποτε από **Kim · Σχεδιασμός · Κατασκευή**. Φιλτράρει πραγματικά."
          }
        },
        "fi": {
