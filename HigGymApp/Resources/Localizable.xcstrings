            "value": "正解しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제를 맞혔습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答对了题目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
