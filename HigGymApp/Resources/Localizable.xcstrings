    "읽을 때마다 줄고 0이면 사라집니다 (남은 수 %lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drops each time you read, gone at 0 (%lld left)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Drops each time you read, gone at 0 (%lld left)"
