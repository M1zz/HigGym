    "거리": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "距離"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거리"
          }
        }
      }
    },
    "거리 값을 화면에 표시하려 합니다. 미국 사용자에게는 마일로 보여야 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You want to show a distance value on screen. US users should see it in miles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "距離の値を画面に表示しようとしています。アメリカのユーザーにはマイルで表示されるべきです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거리 값을 화면에 표시하려 합니다. 미국 사용자에게는 마일로 보여야 합니다."
          }
        }
      }
    },
    "건너뛰고 이유 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip and see why"
          }
        },
        "ja": {
