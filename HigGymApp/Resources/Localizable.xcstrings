            "state": "translated",
            "value": "Mikä on vialla, kun henkilön nimi näytetään muodossa `\"\\(firstName) \\(lastName)\"`?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang salah dengan menampilkan nama seseorang sebagai `\"\\(firstName) \\(lastName)\"`?"
