    "nonmodal 시트로 띄운다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Present it as a nonmodal sheet"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Present it as a nonmodal sheet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非モーダルのシートで表示する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "nonmodal 시트로 띄운다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 nonmodal 弹层显示"
          }
        },
        "zh-Hant": {
