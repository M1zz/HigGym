            "state": "translated",
            "value": "아래로 쓸어내려 보세요, 닫히지 않습니다"
          }
        }
      }
    },
    "아래로 쓸어내려 보세요, 닫히지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
