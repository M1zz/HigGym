            "state": "translated",
            "value": "O alcance vale apenas para ações inofensivas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเอื้อมถึงใช้กับการกระทำที่ไม่เป็นอันตรายเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với tới chỉ áp dụng cho các hành động vô hại"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosah se týká jen neškodných akcí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rækkevidde gælder kun for harmløse handlinger"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εμβέλεια ισχύει μόνο για αβλαβείς ενέργειες"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulottuvuus koskee vain vaarattomia toimintoja"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keterjangkauan hanya berlaku untuk aksi yang tidak berbahaya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekkevidde gjelder bare ufarlige handlinger"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereikbaarheid geldt alleen voor onschuldige acties"
          }
        }
      }
    },
    "도움말": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Help"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルプ"
          }
        },
        "ko": {
