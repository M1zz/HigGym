    "행 오른쪽 · 수정 시각": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right side of the row · modified time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行の右側・更新時刻"
          }
        },
        "ko": {
