    "쓰던 기능은 평생 그대로입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you use stays free for life"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you use stays free for life"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使っていた機能は、ずっとそのままです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用过的功能终身照常使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用過的功能終身照常使用"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, чем вы пользуетесь, остаётся бесплатным навсегда"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que usas sigue siendo gratis para siempre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du nutzt, bleibt dauerhaft kostenlos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous utilisez reste gratuit à vie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che usi resta gratuito per sempre"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você usa continua grátis para sempre"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่คุณใช้ยังฟรีตลอดชีวิต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ bạn đang dùng vẫn miễn phí trọn đời"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vše, co používáte, zůstává zdarma navždy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, du bruger, forbliver gratis for evigt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι χρησιμοποιείς παραμένει δωρεάν για πάντα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki käyttämäsi pysyy ilmaisena ikuisesti"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang kamu pakai tetap gratis seumur hidup"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt du bruker forblir gratis for livet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wat je gebruikt blijft voor altijd gratis"
          }
        }
      }
    },
    "이번 버전부터 새로 받는 분께는 일부가 유료로 바뀝니다. 그동안 함께해 주신 분은 결제 없이 모든 레슨과 자료를 계속 씁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting with this version, part of the app is paid for new downloads. If you've been with us, you keep every lesson and resource with no purchase."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting with this version, part of the app is paid for new downloads. If you've been with us, you keep every lesson and resource with no purchase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンから、新しくダウンロードする方には一部が有料になります。これまで使ってくださった方は、購入なしですべてのレッスンと資料を使い続けられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这个版本起，新下载的用户有一部分内容将改为付费。此前一直陪伴我们的用户，无需付费，继续使用所有课程和资料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從這個版本起，新下載的使用者有一部分內容將改為付費。此前一直陪伴我們的使用者，無需付費，繼續使用所有課程和資料。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начиная с этой версии, часть приложения становится платной для новых загрузок. Если вы с нами давно, все уроки и материалы остаются у вас без покупки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de esta versión, una parte de la app es de pago para las descargas nuevas. Si ya estabas con nosotros, conservas todas las lecciones y recursos sin comprar nada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab dieser Version ist ein Teil der App für neue Downloads kostenpflichtig. Wenn du schon dabei warst, behältst du jede Lektion und jeden Inhalt ohne Kauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir de cette version, une partie de l'app est payante pour les nouveaux téléchargements. Si vous êtes avec nous depuis un moment, vous gardez chaque leçon et ressource sans achat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A partire da questa versione, una parte dell'app è a pagamento per i nuovi download. Se sei con noi da prima, mantieni ogni lezione e risorsa senza alcun acquisto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir desta versão, parte do app é paga para novos downloads. Se você já está com a gente, mantém todas as lições e recursos sem nenhuma compra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มจากเวอร์ชันนี้ บางส่วนของแอปมีค่าใช้จ่ายสำหรับการดาวน์โหลดใหม่ ถ้าคุณอยู่กับเรามาก่อน คุณยังได้ทุกบทเรียนและทรัพยากรโดยไม่ต้องซื้อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu từ phiên bản này, một phần app tính phí với các lượt tải mới. Nếu bạn đã đồng hành cùng chúng tôi, bạn giữ mọi bài học và tài nguyên mà không cần mua."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od této verze je část aplikace pro nová stažení placená. Pokud jste s námi byli dřív, zachováte si každou lekci a zdroj bez nákupu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra denne version er en del af appen betalt for nye downloads. Hvis du har været med os, beholder du alle lektioner og ressourcer uden køb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από αυτή την έκδοση, μέρος της εφαρμογής είναι επί πληρωμή για νέες λήψεις. Αν ήσουν μαζί μας, κρατάς κάθε μάθημα και πόρο χωρίς αγορά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tästä versiosta alkaen osa sovelluksesta on maksullinen uusille latauksille. Jos olet ollut mukana, säilytät jokaisen oppitunnin ja resurssin ilman ostoa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dari versi ini, sebagian aplikasi berbayar untuk unduhan baru. Jika kamu sudah bersama kami, kamu mempertahankan setiap pelajaran dan sumber daya tanpa pembelian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra og med denne versjonen er en del av appen betalt for nye nedlastinger. Hvis du har vært med oss, beholder du alle leksjoner og ressurser uten kjøp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanaf deze versie is een deel van de app betaald voor nieuwe downloads. Als je er al bij was, behoud je elke les en elke bron zonder aankoop."
          }
        }
      }
    },
    "주간, 월간 구독이나 평생 이용권으로 모든 레슨과 자료를 엽니다. 무료로 해 본 그 방식 그대로입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A weekly or monthly subscription, or a lifetime purchase, unlocks every lesson and resource, in the same format you tried for free."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A weekly or monthly subscription, or a lifetime purchase, unlocks every lesson and resource, in the same format you tried for free."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週間・月額プラン、または買い切りで、すべてのレッスンと資料が開きます。無料で試したのと同じやり方です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过每周、每月订阅或终身使用权，解锁所有课程和资料。方式与你免费试用时完全一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過每週、每月訂閱或終身使用權，解鎖所有課程和資料。方式與你免費試用時完全一樣。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недельная или месячная подписка либо пожизненная покупка открывает все уроки и материалы в том же формате, который вы пробовали бесплатно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suscripción semanal o mensual, o una compra de por vida, desbloquea todas las lecciones y recursos, en el mismo formato que probaste gratis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wochen- oder Monatsabo oder ein Einmalkauf schaltet jede Lektion und jeden Inhalt frei, im selben Format, das du kostenlos ausprobiert hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement hebdomadaire ou mensuel, ou un achat à vie, débloque chaque leçon et ressource, dans le même format que celui que vous avez essayé gratuitement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abbonamento settimanale o mensile, o un acquisto a vita, sblocca ogni lezione e risorsa, nello stesso formato che hai provato gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma assinatura semanal ou mensal, ou uma compra vitalícia, desbloqueia todas as lições e recursos, no mesmo formato que você experimentou de graça."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกรายสัปดาห์หรือรายเดือน หรือการซื้อแบบตลอดชีพ ปลดล็อกทุกบทเรียนและทรัพยากร ในรูปแบบเดียวกับที่คุณลองฟรี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký theo tuần hoặc theo tháng, hoặc mua trọn đời, mở khóa mọi bài học và tài nguyên, theo đúng định dạng bạn đã thử miễn phí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Týdenní nebo měsíční předplatné nebo doživotní nákup odemkne každou lekci a zdroj ve stejné podobě, kterou jste zkoušeli zdarma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ugentligt eller månedligt abonnement eller et livstidskøb låser alle lektioner og ressourcer op, i det samme format, som du prøvede gratis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια εβδομαδιαία ή μηνιαία συνδρομή, ή μια αγορά εφ' όρου ζωής, ξεκλειδώνει κάθε μάθημα και πόρο, στην ίδια μορφή που δοκίμασες δωρεάν."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viikko- tai kuukausitilaus tai elinikäinen osto avaa jokaisen oppitunnin ja resurssin samassa muodossa, jota kokeilit ilmaiseksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan mingguan atau bulanan, atau pembelian seumur hidup, membuka setiap pelajaran dan sumber daya, dalam format yang sama seperti yang kamu coba gratis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ukentlig eller månedlig abonnement, eller et livstidskjøp, låser opp alle leksjoner og ressurser, i samme format som du prøvde gratis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een wekelijks of maandelijks abonnement, of een eenmalige aankoop voor altijd, ontgrendelt elke les en elke bron, in hetzelfde formaat dat je gratis hebt geprobeerd."
          }
        }
      }
    },
    "구독은 언제든 해지할 수 있고, 평생 이용권은 한 번 결제로 끝납니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel a subscription anytime. The lifetime purchase is a one-time payment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel a subscription anytime. The lifetime purchase is a one-time payment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランはいつでも解約でき、買い切りは一度の支払いで終わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅可随时取消，终身使用权一次付费即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱可隨時取消，終身使用權一次付費即可。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписку можно отменить в любой момент. Пожизненная покупка - разовый платёж."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela la suscripción cuando quieras. La compra de por vida es un pago único."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst ein Abo jederzeit kündigen. Der Einmalkauf ist eine einmalige Zahlung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résiliez un abonnement à tout moment. L'achat à vie est un paiement unique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla un abbonamento in qualsiasi momento. L'acquisto a vita è un pagamento una tantum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele uma assinatura a qualquer momento. A compra vitalícia é um pagamento único."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการสมัครสมาชิกได้ทุกเมื่อ การซื้อแบบตลอดชีพเป็นการชำระครั้งเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy gói đăng ký bất cứ lúc nào. Mua trọn đời là thanh toán một lần."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplatné můžete kdykoli zrušit. Doživotní nákup je jednorázová platba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opsig et abonnement når som helst. Livstidskøbet er en engangsbetaling."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακύρωσε μια συνδρομή οποιαδήποτε στιγμή. Η αγορά εφ' όρου ζωής είναι εφάπαξ πληρωμή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruuta tilaus milloin tahansa. Elinikäinen osto on kertamaksu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batalkan langganan kapan saja. Pembelian seumur hidup adalah pembayaran satu kali."
