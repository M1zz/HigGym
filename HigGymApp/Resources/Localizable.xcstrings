        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque una cápsula inferior parece un diseño más moderno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil eine untere Kapsel wie ein moderneres Design aussieht"
