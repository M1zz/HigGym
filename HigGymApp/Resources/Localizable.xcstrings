        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ควรสงสัยเมื่อแท็บล้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều cần nghi ngờ khi tab bị tràn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co podezírat, když karty přetékají"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad man bør mistænke, når faner løber over"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
