          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyzkoušet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv det"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκίμασέ το"
          }
        },
        "fi": {
          "stringUnit": {
