      }
    },
    "사막": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Desert"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "砂漠"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사막"
          }
        }
      }
    },
    "사용법 다시 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the tour again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方をもう一度見る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용법 다시 보기"
          }
        }
      }
    },
    "사용자 이름을 표시할 때 `\"\\(firstName) \\(lastName)\"` 의 문제는?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's wrong with displaying a person's name as `\"\\(firstName) \\(lastName)\"`?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー名を表示するときの `\"\\(firstName) \\(lastName)\"` の問題は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 이름을 표시할 때 `\"\\(firstName) \\(lastName)\"` 의 문제는?"
          }
        }
      }
    },
    "사용자가 오래 안 들어간 탭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab the person hasn't opened in a long time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーが長く開いていないタブ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자가 오래 안 들어간 탭"
          }
        }
      }
    },
    "사용자가 화면을 보며 손으로 옮겨 적고 있다면 그건 기능이 빠진 것입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If people are copying things out by hand while looking at the screen, a feature is missing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーが画面を見ながら手で書き写しているなら、それは機能が欠けているということです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자가 화면을 보며 손으로 옮겨 적고 있다면 그건 기능이 빠진 것입니다."
          }
        }
      }
    },
    "사용자는 메뉴를 읽지 않는다. 열고 **대략의 위치로 손을 뻗는다.** 그 자리에 되돌릴 수 없는 항목이 균일한 모습으로 섞여 있으면 손이 멈출 이유가 없다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People don't read menus. They open one and **reach for the rough location.** If an irreversible item sits there looking just like everything else, nothing makes the hand stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーはメニューを読まない。開いて**だいたいの位置に手を伸ばす**。そこに取り消せない項目が同じ見た目で混ざっていれば、手が止まる理由はない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자는 메뉴를 읽지 않는다. 열고 **대략의 위치로 손을 뻗는다.** 그 자리에 되돌릴 수 없는 항목이 균일한 모습으로 섞여 있으면 손이 멈출 이유가 없다."
          }
        }
      }
    },
    "사용자는 툴바를 그림이 아니라 **선택지 목록**으로 읽는다. 넷이 나란히 있으면 매번 넷 중에서 고르는 일이 되고, 매번 누르는 완료 하나가 셋 사이에 묻힌다. 기능을 없앤 게 아니라 자리를 옮긴 것이다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People read a toolbar not as a picture but as **a list of choices**. Put four side by side and every time becomes a choice among four, and the Done you tap every time gets buried among the other three. The features weren't removed, just moved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーはツールバーを絵ではなく**選択肢のリスト**として読む。4つが並んでいれば毎回4つの中から選ぶことになり、毎回押す完了が残りの3つに埋もれる。機能をなくしたのではなく、場所を移したのだ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자는 툴바를 그림이 아니라 **선택지 목록**으로 읽는다. 넷이 나란히 있으면 매번 넷 중에서 고르는 일이 되고, 매번 누르는 완료 하나가 셋 사이에 묻힌다. 기능을 없앤 게 아니라 자리를 옮긴 것이다."
          }
        }
