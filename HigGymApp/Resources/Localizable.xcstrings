          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนภาษาและภูมิภาคด้านล่างเป็น **en_US**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi ngôn ngữ và vùng bên dưới sang **en_US**."
          }
        },
        "cs": {
