    "인셋 + 스크롤 가장자리 효과를 시스템이 대주므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because the system provides the inset and scroll edge effect"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because the system provides the inset and scroll edge effect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インセットとスクロールエッジエフェクトをシステムが用意してくれるので"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인셋 + 스크롤 가장자리 효과를 시스템이 대주므로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为系统提供内边距 + 滚动边缘效果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為系統提供內邊距 + 滾動邊緣效果"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что отступы и эффект края прокрутки предоставляет система"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque el sistema aporta el margen y el efecto de borde de desplazamiento"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil das System den Abstand und den Scroll-Kanteneffekt liefert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce que le système fournit la marge et l'effet de bord de défilement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché è il sistema a fornire l'inset e l'effetto sul bordo di scorrimento"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque o sistema fornece o recuo e o efeito de borda de rolagem"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพราะระบบจัดหาระยะขอบและเอฟเฟกต์ขอบเลื่อนให้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì hệ thống cung cấp phần đệm và hiệu ứng cạnh cuộn"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože systém poskytuje odsazení i okrajový efekt posouvání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi systemet leverer indrykningen og scroll-kanteffekten"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επειδή το σύστημα παρέχει την εσοχή και το εφέ άκρης κύλισης"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska järjestelmä tarjoaa sisennyksen ja vierityksen reunaefektin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena sistem menyediakan inset dan efek tepi gulir"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi systemet gir innrykket og rullekanteffekten"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat het systeem de inset en het scrollrandeffect levert"
          }
        }
      }
    },
