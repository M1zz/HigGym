        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только с ретроспективой"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las que tienen retrospectiva"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die mit Rückblick"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement celles avec une rétrospective"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quelli con una retrospettiva"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as que têm retrospectiva"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะที่มีการทบทวน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ những mục có phần nhìn lại"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen ty s retrospektivou"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun dem med et tilbageblik"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο όσα έχουν αναδρομή"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain ne, joilla on retrospektiivi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya yang punya retrospektif"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare de med tilbakeblikk"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen met een terugblik"
          }
        }
      }
    },
    "회의 일정이 다음 주 화요일 오후 3시로 변경되었습니다. 준비 자료는 미리 공유 부탁드립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting has been moved to next Tuesday at 3 PM. Please share any prep materials ahead of time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The meeting has been moved to next Tuesday at 3 PM. Please share any prep materials ahead of time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議の日程が来週火曜の午後3時に変更されました。準備資料は事前に共有をお願いします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 일정이 다음 주 화요일 오후 3시로 변경되었습니다. 준비 자료는 미리 공유 부탁드립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会议日程已改到下周二下午 3 点。请提前分享准备资料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會議日程已改到下週二下午 3 點。請提前分享準備資料。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встреча перенесена на следующий вторник, 15:00. Пожалуйста, заранее поделитесь материалами для подготовки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reunión se ha movido al próximo martes a las 15:00. Comparte con antelación cualquier material de preparación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Meeting wurde auf nächsten Dienstag, 15 Uhr verschoben. Bitte teilt Vorbereitungsunterlagen vorab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réunion a été déplacée à mardi prochain, 15 h. Merci de partager vos documents de préparation à l'avance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riunione è stata spostata a martedì prossimo alle 15:00. Condividete in anticipo eventuali materiali di preparazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reunião foi remarcada para a próxima terça-feira às 15h. Compartilhem antecipadamente qualquer material de preparação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประชุมถูกเลื่อนเป็นวันอังคารหน้า 15:00 น. ช่วยแชร์เอกสารเตรียมประชุมล่วงหน้าด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc họp đã được dời sang thứ Ba tuần sau lúc 15:00. Vui lòng chia sẻ tài liệu chuẩn bị trước."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Schůzka byla přesunuta na příští úterý v 15:00. Sdílejte prosím materiály k přípravě předem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mødet er flyttet til næste tirsdag kl. 15. Del gerne forberedelsesmateriale på forhånd."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συνάντηση μετατέθηκε για την επόμενη Τρίτη στις 15:00. Παρακαλώ μοιραστείτε το υλικό προετοιμασίας εκ των προτέρων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokous on siirretty ensi tiistaille klo 15. Jakakaa valmistelumateriaalit etukäteen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapat dipindah ke Selasa depan pukul 15.00. Mohon bagikan materi persiapan sebelumnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Møtet er flyttet til neste tirsdag kl. 15. Del gjerne forberedelsesmateriell på forhånd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergadering is verplaatst naar volgende week dinsdag om 15:00 uur. Deel voorbereidend materiaal graag vooraf."
          }
        }
      }
    },
