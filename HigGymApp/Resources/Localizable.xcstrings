    "진입 순간엔 방향감을 주고, 읽기 시작하면 inline으로 접혀 공간을 콘텐츠에 반납합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On entry it gives a sense of place; once you start reading, it collapses to inline and gives the space back to the content."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "On entry it gives a sense of place; once you start reading, it collapses to inline and gives the space back to the content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入った瞬間は現在地を伝え、読み始めると inline に折りたたまれてスペースをコンテンツに返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진입 순간엔 방향감을 주고, 읽기 시작하면 inline으로 접혀 공간을 콘텐츠에 반납합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入时提供方向感，开始阅读后折叠为 inline，把空间还给内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入時提供方向感，開始閱讀後摺疊為 inline，把空間還給內容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При входе даёт чувство места; когда вы начинаете читать, сворачивается в inline и возвращает место контенту."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al entrar da sensación de lugar; cuando empiezas a leer, se colapsa a inline y devuelve el espacio al contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Einstieg gibt er ein Ortsgefühl; sobald du zu lesen beginnst, klappt er zu inline zusammen und gibt den Platz an den Inhalt zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'arrivée, il donne un sens du lieu ; dès que vous commencez à lire, il se replie en inline et rend l'espace au contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All'ingresso dà un senso di luogo; quando inizi a leggere si comprime in linea e restituisce lo spazio al contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na entrada dá senso de lugar; quando você começa a ler, recolhe para inline e devolve o espaço ao conteúdo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนเข้ามามันให้ความรู้สึกถึงสถานที่ พอเริ่มอ่านมันยุบเป็น inline และคืนพื้นที่ให้เนื้อหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lúc vào, nó cho cảm giác về vị trí; khi bạn bắt đầu đọc, nó thu gọn thành inline và trả không gian lại cho nội dung."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při vstupu dává smysl pro místo; jakmile začnete číst, sbalí se do inline a vrátí místo obsahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved indgangen giver den en fornemmelse af sted; når du begynder at læse, falder den sammen til inline og giver pladsen tilbage til indholdet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατά την είσοδο δίνει αίσθηση θέσης· μόλις αρχίσεις να διαβάζεις, συμπτύσσεται σε inline και επιστρέφει τον χώρο στο περιεχόμενο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saapuessa se antaa paikantuntua; kun alat lukea, se tiivistyy inline-muotoon ja antaa tilan takaisin sisällölle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat masuk ia memberi rasa tempat; begitu kamu mulai membaca, ia menciut ke inline dan mengembalikan ruang ke konten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved ankomst gir den en følelse av sted; når du begynner å lese, kollapser den til inline og gir plassen tilbake til innholdet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij binnenkomst geeft het een gevoel van plaats; zodra je begint te lezen, klapt het in naar inline en geeft het de ruimte terug aan de inhoud."
          }
        }
      }
    },
    "진입 시점엔 방향감이 필요하지만 읽기 시작하면 기여가 끝나므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because orientation matters on entry, but once you start reading, its job is done"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because orientation matters on entry, but once you start reading, its job is done"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入った時点では現在地の手がかりが必要だが、読み始めれば役目を終えるため"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진입 시점엔 방향감이 필요하지만 읽기 시작하면 기여가 끝나므로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入时需要方向感，但开始阅读后它的贡献就结束了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入時需要方向感，但開始閱讀後它的貢獻就結束了"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что при входе важна ориентация, а когда вы начинаете читать, её роль закончена"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque la orientación importa al entrar, pero cuando empiezas a leer, su trabajo ha terminado"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil Orientierung beim Einstieg zählt, aber ihre Aufgabe erledigt ist, sobald du zu lesen beginnst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce que l'orientation compte à l'arrivée, mais une fois la lecture commencée, son travail est fait"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché l'orientamento conta all'ingresso, ma quando inizi a leggere il suo compito è finito"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque a orientação importa na entrada, mas quando você começa a ler, o trabalho dela terminou"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพราะการรู้ทิศทางสำคัญตอนเข้ามา แต่พอเริ่มอ่าน หน้าที่ของมันก็จบแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì định hướng quan trọng lúc vào, nhưng khi bạn bắt đầu đọc, nhiệm vụ của nó đã xong"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože orientace záleží při vstupu, ale jakmile začnete číst, jeho práce je hotová"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi orientering betyder noget ved indgangen, men når du begynder at læse, er dens opgave løst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επειδή ο προσανατολισμός μετράει κατά την είσοδο, αλλά μόλις αρχίσεις να διαβάζεις, η δουλειά του έχει τελειώσει"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska suuntautuminen on tärkeää saapuessa, mutta kun alat lukea, sen työ on tehty"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena orientasi penting saat masuk, tetapi begitu kamu mulai membaca, tugasnya selesai"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi orientering betyr noe ved ankomst, men når du begynner å lese, er jobben gjort"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat oriëntatie bij binnenkomst telt, maar zodra je begint te lezen zijn taak erop zit"
          }
        }
      }
    },
