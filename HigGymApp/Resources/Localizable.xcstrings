          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подставляйте длинные имена и заголовки, чтобы проверить, предусматривал ли макет такой текст."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia por nombres y títulos largos para ver si el diseño anticipó el texto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze lange Namen und lange Titel ein, um zu sehen, ob das Layout den Text vorausgesehen hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez des noms et des titres longs pour voir si la disposition avait anticipé le texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci nomi e titoli lunghi per vedere se il layout aveva previsto il testo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque por nomes e títulos longos para ver se o layout antecipou o texto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับชื่อยาว ๆ และชื่อเรื่องยาว ๆ เข้าไป เพื่อดูว่าเลย์เอาต์คาดการณ์ข้อความไว้หรือไม่"
