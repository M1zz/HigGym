            "state": "translated",
            "value": "What you write collects in Notes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書いたものはノートにたまります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓴 글은 노트에 쌓입니다"
          }
        },
