    "액세서리를 눌러 확장 화면을 열어보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the accessory to open the expanded view."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the accessory to open the expanded view."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセサリをタップして、展開された画面を開いてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액세서리를 눌러 확장 화면을 열어보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按附件，打开展开界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點附件，開啟展開介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите accessory, чтобы открыть развёрнутый экран."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el accesorio para abrir la vista ampliada."
          }
        }
      }
    },
    "액션 두 개만 남았습니다. 화면이 조용해지고 시선이 콘텐츠로 돌아옵니다, 8.1.1.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only two actions left. The screen quiets down and your eyes return to the content, 8.1.1."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only two actions left. The screen quiets down and your eyes return to the content, 8.1.1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションが2つだけになりました。画面が静かになり、視線がコンテンツに戻ります（8.1.1）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액션 두 개만 남았습니다. 화면이 조용해지고 시선이 콘텐츠로 돌아옵니다, 8.1.1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只剩下两个操作。界面安静下来，视线回到了内容上，8.1.1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只剩下兩個操作。介面安靜下來，視線回到了內容上，8.1.1。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось только два действия. Экран успокаивается, и взгляд возвращается к контенту, 8.1.1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quedan dos acciones. La pantalla se calma y la vista vuelve al contenido, 8.1.1."
          }
        }
      }
    },
    "액션 이름의 길이": {
      "localizations": {
