    "결제 중에도 탭바가 살아 있음 ↔ 탭바를 숨기고 취소에 확인을 붙임.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab bar stays live during checkout ↔ tab bar hidden and Cancel asks for confirmation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab bar stays live during checkout ↔ tab bar hidden and Cancel asks for confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い中もタブバーが生きている ↔ タブバーを隠し、キャンセルに確認を付けた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 중에도 탭바가 살아 있음 ↔ 탭바를 숨기고 취소에 확인을 붙임."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支付过程中标签栏仍然存在 ↔ 隐藏标签栏，并在取消时加以确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款過程中標籤列仍然存在 ↔ 隱藏標籤列，並在取消時加以確認。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок остаётся активной при оформлении ↔ панель вкладок скрыта, а отмена просит подтверждения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas sigue activa durante el pago ↔ barra de pestañas oculta y Cancelar pide confirmación."
          }
        }
      }
    },
    "결제 확인": {
      "localizations": {
