        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você troca de pasta **tocando no título**. Por que não há um botão separado?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสลับโฟลเดอร์ด้วยการ**แตะชื่อเรื่อง** ทำไมจึงไม่มีปุ่มแยก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chuyển thư mục bằng cách **chạm tiêu đề**. Vì sao không có nút riêng?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Složky přepínáte **klepnutím na nadpis**. Proč tu není samostatné tlačítko?"
          }
        },
        "da": {
          "stringUnit": {
