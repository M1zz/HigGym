        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบใช้น้อย จึงถูกซ่อนไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa hiếm khi được dùng, nên nó bị cất đi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat se používá zřídka, proto bylo schováno"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet bruges sjældent, så det blev gemt væk"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Διαγραφή χρησιμοποιείται σπάνια, οπότε κρύφτηκε"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistoa käytetään harvoin, joten se piilotettiin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus jarang dipakai, jadi disimpan"
