          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "違反規則的一邊把「5km」「李欣」這樣的**寫法寫死成了字串**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В нарушающем варианте **запись зашита в строки**, например «5km» и «Анна Смирнова»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión rota **fija el formato en cadenas**, como «5km» y «Olivia Kim»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die fehlerhafte Version **brennt die Formatierung in Zeichenfolgen ein**, wie „5km“ und „Olivia Kim“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version fautive **code en dur le formatage dans des chaînes**, comme « 5km » et « Olivia Kim »."
          }
        },
        "it": {
