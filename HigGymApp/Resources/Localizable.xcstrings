    "글자가 읽히지 않는 지점이 있었나요? 어두운 구역과 무엇이 달랐나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Was there a spot where the text became unreadable? How was it different from the dark areas?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Was there a spot where the text became unreadable? How was it different from the dark areas?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字が読めなくなる場所はありましたか？暗い場所と何が違いましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자가 읽히지 않는 지점이 있었나요? 어두운 구역과 무엇이 달랐나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有没有读不清文字的地方？和较暗的区域有什么不同？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有沒有讀不清文字的地方？和較暗的區域有什麼不同？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Были ли места, где текст становился нечитаемым? Чем это отличалось от тёмных областей?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Hubo algún sitio donde el texto se volvió ilegible? ¿Qué lo diferenciaba de las zonas oscuras?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gab es eine Stelle, an der der Text unlesbar wurde? Wie unterschied sie sich von den dunklen Bereichen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y a-t-il eu un endroit où le texte est devenu illisible ? En quoi était-ce différent des zones sombres ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è stato un punto in cui il testo è diventato illeggibile? In che cosa era diverso dalle zone scure?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Houve algum ponto em que o texto ficou ilegível? Como foi diferente das áreas escuras?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีจุดที่ข้อความอ่านไม่ออกไหม ต่างจากบริเวณมืดอย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có chỗ nào mà văn bản trở nên không đọc được không? Nó khác với những vùng tối thế nào?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bylo místo, kde se text stal nečitelným? Jak se lišilo od tmavých oblastí?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Var der et sted, hvor teksten blev ulæselig? Hvordan adskilte det sig fra de mørke områder?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπήρχε σημείο όπου το κείμενο έγινε δυσανάγνωστο; Πώς διέφερε από τις σκοτεινές περιοχές;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oliko kohtaa, jossa teksti muuttui lukukelvottomaksi? Miten se erosi tummista alueista?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Adakah tempat teks menjadi tidak terbaca? Apa bedanya dengan area gelap?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Var det et sted der teksten ble uleselig? Hvordan var det annerledes enn de mørke områdene?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Was er een plek waar de tekst onleesbaar werd? Hoe verschilde dat van de donkere gebieden?"
          }
        }
      }
    },
    "글자가 커져도 값이 남는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does the value survive when the text gets bigger?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Does the value survive when the text gets bigger?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字が大きくなっても値は残るか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자가 커져도 값이 남는가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字变大后，数值还在吗"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字變大後，數值還在嗎"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся ли значение, когда текст становится крупнее?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sobrevive el valor cuando el texto se hace más grande?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt der Wert erhalten, wenn der Text größer wird?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur survit-elle quand le texte grossit ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore sopravvive quando il testo diventa più grande?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor sobrevive quando o texto fica maior?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่ายังอยู่รอดไหมเมื่อตัวอักษรใหญ่ขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị có còn sống sót khi chữ to lên không?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přežije hodnota, když se text zvětší?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlever værdien, når teksten bliver større?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιβιώνει η τιμή όταν μεγαλώνει το κείμενο;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilyykö arvo, kun teksti suurenee?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah nilainya bertahan saat teks membesar?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlever verdien når teksten blir større?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overleeft de waarde als de tekst groter wordt?"
          }
        }
      }
    },
    "글자가 커지면 한 줄 고정은 값을 지우기 시작한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As text grows, a fixed single line starts erasing the value"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "As text grows, a fixed single line starts erasing the value"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字が大きくなると、1行固定は値を消し始める"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자가 커지면 한 줄 고정은 값을 지우기 시작한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字变大后，固定一行会开始抹掉数值"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字變大後，固定一行會開始抹掉數值"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При росте текста фиксированная одна строка начинает стирать значение"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A medida que el texto crece, una sola línea fija empieza a borrar el valor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wächst der Text, beginnt eine feste einzelne Zeile, den Wert auszulöschen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À mesure que le texte grossit, une seule ligne fixe se met à effacer la valeur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Man mano che il testo cresce, una riga fissa comincia a cancellare il valore"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À medida que o texto cresce, uma linha única fixa começa a apagar o valor"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อตัวอักษรโตขึ้น บรรทัดเดียวที่คงที่จะเริ่มลบค่าทิ้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi chữ to ra, một dòng cố định bắt đầu xóa mất giá trị"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak text roste, pevný jeden řádek začne hodnotu mazat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når teksten vokser, begynder en fast enkelt linje at udviske værdien"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καθώς το κείμενο μεγαλώνει, μια σταθερή μία γραμμή αρχίζει να σβήνει την τιμή"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstin kasvaessa kiinteä yksi rivi alkaa pyyhkiä arvoa pois"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat teks membesar, satu baris tetap mulai menghapus nilainya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når teksten vokser, begynner en fast enkelt linje å viske ut verdien"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naarmate tekst groeit, begint een vaste enkele regel de waarde uit te wissen"
          }
        }
      }
    },
    "글자로 못 하는 말(사진·상태 점)을 해야 할 때만 씁니다, 대부분의 화면은 텍스트 제목으로 충분합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use it only when you need to say something words can't (a photo, a status dot). For most screens, a text title is enough."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use it only when you need to say something words can't (a photo, a status dot). For most screens, a text title is enough."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字では伝えられないこと（写真・状態を示す点）を伝える必要があるときだけ使います。ほとんどの画面はテキストのタイトルで十分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자로 못 하는 말(사진·상태 점)을 해야 할 때만 씁니다, 대부분의 화면은 텍스트 제목으로 충분합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在需要表达文字说不了的话（照片、状态圆点）时才用，大多数界面用文字标题就足够了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在需要表達文字說不了的話（照片、狀態圓點）時才用，大多數介面用文字標題就足夠了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте, только когда нужно сказать то, что не выразить словами (фото, индикатор состояния). Для большинства экранов хватает текстового заголовка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsalo solo cuando necesites decir algo que las palabras no pueden (una foto, un punto de estado). Para la mayoría de pantallas, basta un título de texto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze es nur, wenn du etwas sagen musst, was Worte nicht können (ein Foto, ein Statuspunkt). Für die meisten Bildschirme genügt ein Texttitel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'en usez que lorsque vous devez dire quelque chose que les mots ne peuvent pas dire (une photo, un point d'état). Pour la plupart des écrans, un titre textuel suffit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usalo solo quando devi dire qualcosa che le parole non possono (una foto, un punto di stato). Per la maggior parte delle schermate basta un titolo testuale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use apenas quando precisar dizer algo que palavras não dizem (uma foto, um ponto de status). Para a maioria das telas, um título em texto basta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะเมื่อต้องบอกสิ่งที่คำพูดบอกไม่ได้ (รูปถ่าย, จุดสถานะ) สำหรับหน้าจอส่วนใหญ่ ชื่อเรื่องที่เป็นข้อความก็พอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng khi bạn cần nói điều mà lời không nói được (một bức ảnh, một chấm trạng thái). Với hầu hết màn hình, tiêu đề dạng chữ là đủ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte ho jen tehdy, když potřebujete říct něco, co slova nezvládnou (fotka, stavová tečka). Pro většinu obrazovek stačí textový nadpis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug det kun, når du skal sige noget, ord ikke kan (et foto, en statusprik). På de fleste skærme er en teksttitel nok."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησέ το μόνο όταν χρειάζεται να πεις κάτι που οι λέξεις δεν μπορούν (μια φωτογραφία, μια κουκκίδα κατάστασης). Για τις περισσότερες οθόνες, ένας τίτλος κειμένου αρκεί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä sitä vain, kun tarvitset sanoa jotain, mitä sanat eivät voi (valokuva, tilapiste). Useimmissa näkymissä tekstiotsikko riittää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan hanya saat kamu perlu mengatakan sesuatu yang tak bisa dikatakan kata-kata (foto, titik status). Untuk sebagian besar layar, judul teks sudah cukup."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk den bare når du trenger å si noe ord ikke kan (et bilde, en statusprikk). For de fleste skjermer er en teksttittel nok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik het alleen als je iets moet zeggen wat woorden niet kunnen (een foto, een statusstip). Voor de meeste schermen is een teksttitel genoeg."
          }
        }
      }
    },
