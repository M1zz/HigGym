      }
    },
    "작성을 탭이 아니라 하단 툴바 버튼으로 두고, 탭에는 목적지만 남겼다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made Compose a bottom toolbar button instead of a tab, and left only destinations in the tabs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Made Compose a bottom toolbar button instead of a tab, and left only destinations in the tabs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成をタブではなく下部ツールバーのボタンにし、タブには行き先だけを残した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성을 탭이 아니라 하단 툴바 버튼으로 두고, 탭에는 목적지만 남겼다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把撰写做成底部工具栏按钮，而不是标签，标签里只留目的地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把撰寫做成底部工具列按鈕，而不是標籤，標籤裡只留目的地。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Написать» сделали кнопкой нижней панели инструментов вместо вкладки, а во вкладках оставили только места назначения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hizo de Redactar un botón de la barra de herramientas inferior en lugar de una pestaña, y en las pestañas solo se dejaron destinos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfassen zu einem Button der unteren Symbolleiste statt zu einem Tab gemacht und in den Tabs nur Ziele gelassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédiger est devenu un bouton de la barre d'outils du bas au lieu d'un onglet, et il ne reste que des destinations dans les onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha reso Scrivi un pulsante della barra degli strumenti in basso invece di una scheda, lasciando nelle schede solo le destinazioni."
          }
        }
      }
    },
    "작성이 하단 툴바 버튼 ↔ 가짜 탭. 탭 개수도 함께 달라집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose as a bottom toolbar button ↔ a fake tab. The number of tabs changes too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose as a bottom toolbar button ↔ a fake tab. The number of tabs changes too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成が下部ツールバーのボタン ↔ 偽のタブ。タブの数も一緒に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성이 하단 툴바 버튼 ↔ 가짜 탭. 탭 개수도 함께 달라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写是底部工具栏按钮 ↔ 假标签。标签的数量也随之不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫是底部工具列按鈕 ↔ 假標籤。標籤的數量也隨之不同。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Написать» как кнопка нижней панели ↔ фальшивая вкладка. Число вкладок тоже меняется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactar como botón de la barra de herramientas inferior ↔ una pestaña falsa. El número de pestañas también cambia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfassen als Button der unteren Symbolleiste ↔ ein Schein-Tab. Auch die Zahl der Tabs ändert sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédiger en bouton de la barre d'outils du bas ↔ un faux onglet. Le nombre d'onglets change aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi come pulsante della barra degli strumenti in basso ↔ una scheda finta. Cambia anche il numero di schede."
          }
        }
      }
    },
    "작성이 하단으로 내려왔습니다. 같은 과제를 다시 해보고 엄지의 이동 거리를 비교하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose moved to the bottom. Do the same task again and compare how far your thumb travels."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose moved to the bottom. Do the same task again and compare how far your thumb travels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成が下に降りてきました。同じ課題をもう一度やって、親指の移動距離を比べてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성이 하단으로 내려왔습니다. 같은 과제를 다시 해보고 엄지의 이동 거리를 비교하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写移到了底部。请重做同一个任务，比较拇指的移动距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫移到了底部。請重做同一個任務，比較拇指的移動距離。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Написать» переехало вниз. Выполните то же задание ещё раз и сравните, как далеко движется большой палец."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactar pasó abajo. Repite la misma tarea y compara cuánto recorre tu pulgar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfassen nach unten verlegt. Führe dieselbe Aufgabe noch einmal aus und vergleiche, wie weit dein Daumen wandert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédiger est passé en bas. Refaites la même tâche et comparez la distance parcourue par votre pouce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi spostato in basso. Rifai lo stesso compito e confronta quanta strada fa il tuo pollice."
          }
        }
      }
    },
