            "value": "Du ramte rigtigt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το βρήκες σωστά"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sait sen oikein"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu benar"
          }
        },
        "nb": {
