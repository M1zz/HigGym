    "액션 두 개만 남았습니다. 화면이 조용해지고 시선이 콘텐츠로 돌아옵니다, 8.1.1.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only two actions left. The screen quiets down and your eyes return to the content, 8.1.1."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only two actions left. The screen quiets down and your eyes return to the content, 8.1.1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションが2つだけになりました。画面が静かになり、視線がコンテンツに戻ります（8.1.1）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "액션 두 개만 남았습니다. 화면이 조용해지고 시선이 콘텐츠로 돌아옵니다, 8.1.1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只剩下两个操作。界面安静下来，视线回到了内容上，8.1.1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只剩下兩個操作。介面安靜下來，視線回到了內容上，8.1.1。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось только два действия. Экран успокаивается, и взгляд возвращается к контенту, 8.1.1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quedan dos acciones. La pantalla se calma y la vista vuelve al contenido, 8.1.1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur noch zwei Aktionen. Der Bildschirm wird ruhiger, und deine Augen kehren zum Inhalt zurück, 8.1.1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste que deux actions. L'écran se calme et le regard revient au contenu, 8.1.1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano solo due azioni. La schermata si quieta e lo sguardo torna al contenuto, 8.1.1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restam só duas ações. A tela se acalma e seus olhos voltam ao conteúdo, 8.1.1."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหลือการกระทำแค่สอง หน้าจอสงบลงและสายตากลับไปที่เนื้อหา 8.1.1"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ còn hai hành động. Màn hình dịu xuống và mắt bạn quay lại nội dung, 8.1.1."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývají jen dvě akce. Obrazovka se zklidní a oči se vrátí k obsahu, 8.1.1."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun to handlinger tilbage. Skærmen falder til ro, og dine øjne vender tilbage til indholdet, 8.1.1."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έμειναν μόνο δύο ενέργειες. Η οθόνη ησυχάζει και τα μάτια σου επιστρέφουν στο περιεχόμενο, 8.1.1."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain kaksi toimintoa jäljellä. Näkymä rauhoittuu ja katseesi palaa sisältöön, 8.1.1."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dua aksi yang tersisa. Layar menjadi tenang dan matamu kembali ke konten, 8.1.1."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare to handlinger igjen. Skjermen blir roligere, og blikket vender tilbake til innholdet, 8.1.1."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog maar twee acties over. Het scherm wordt rustiger en je ogen keren terug naar de inhoud, 8.1.1."
          }
        }
      }
    },
