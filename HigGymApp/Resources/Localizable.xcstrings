        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 \"km\"를 문자열로 붙였다면 이 전환은 전부 수동 작업이 됐을 겁니다, 8.1.6."
          }
        },
        "zh-Hans": {
          "stringUnit": {
