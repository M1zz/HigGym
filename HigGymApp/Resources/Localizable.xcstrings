    "목록의 행을 왼쪽으로 밀어보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a row in the list to the left"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a row in the list to the left"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストの行を左にスワイプしてみてください"
