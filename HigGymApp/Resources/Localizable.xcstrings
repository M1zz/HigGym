          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor hører ofte åbnede indgange hjemme?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πού πάνε τα σημεία εισόδου που ανοίγονται συχνά;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Minne usein avattavat sisäänkäynnit kuuluvat?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di mana pintu masuk yang sering dibuka ditaruh?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor havner hyppig åpnede innganger?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar komen vaak geopende ingangen?"
          }
        }
      }
    },
    "자주 여는 입구는 엄지에 가깝게, 그리고 안 쓰는 순간에 자리를 차지하지 않게, 어느 쪽입니까?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which one keeps a frequently opened entry point near the thumb without taking up space when it's not in use?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Which one keeps a frequently opened entry point near the thumb without taking up space when it's not in use?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく開く入口は親指の近くに、そして使わない間は場所を取らないように。どちらですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 여는 입구는 엄지에 가깝게, 그리고 안 쓰는 순간에 자리를 차지하지 않게, 어느 쪽입니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常开的入口要靠近拇指，并且不用的时候不占位置：哪一边？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常開的入口要靠近拇指，並且不用的時候不佔位置：哪一邊？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой вариант держит часто открываемую точку входа рядом с большим пальцем и не занимает место, когда она не нужна?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál mantiene cerca del pulgar un punto de entrada que se abre con frecuencia sin ocupar espacio cuando no se usa?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche hält einen häufig geöffneten Einstiegspunkt nahe am Daumen, ohne Platz zu belegen, wenn er nicht genutzt wird?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lequel garde un point d'entrée souvent ouvert près du pouce sans prendre de place quand il ne sert pas ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale tiene un punto d'ingresso aperto di frequente vicino al pollice senza occupare spazio quando non serve?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual mantém um ponto de entrada aberto com frequência perto do polegar sem ocupar espaço quando não está em uso?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อันไหนทำให้จุดเข้าที่เปิดบ่อยอยู่ใกล้นิ้วโป้งโดยไม่กินพื้นที่เมื่อไม่ใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cái nào giữ một lối vào hay mở gần ngón cái mà không chiếm chỗ khi không dùng?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Který udržuje často otevíraný vstupní bod u palce, aniž by zabíral místo, když se nepoužívá?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken holder en ofte åbnet indgang nær tommelfingeren uden at fylde, når den ikke bruges?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποιο κρατά ένα συχνά ανοιγόμενο σημείο εισόδου κοντά στον αντίχειρα χωρίς να καταλαμβάνει χώρο όταν δεν χρησιμοποιείται;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpi pitää usein avattavan sisäänkäynnin peukalon lähellä viemättä tilaa, kun sitä ei käytetä?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mana yang menjaga pintu masuk yang sering dibuka dekat ibu jari tanpa memakan ruang saat tidak dipakai?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken holder en hyppig åpnet inngang nær tommelen uten å ta plass når den ikke brukes?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke houdt een vaak geopende ingang dicht bij de duim zonder ruimte in te nemen als hij niet in gebruik is?"
          }
        }
      }
    },
    "자주 여는 입구라 엄지에 가까워야 하고, 안 쓰는 순간에는 세로 공간을 먹지 않아야 한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a frequently opened entry point, so it should be near the thumb and shouldn't eat vertical space when not in use"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a frequently opened entry point, so it should be near the thumb and shouldn't eat vertical space when not in use"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく開く入口なので親指の近くにあるべきで、使わない間は縦のスペースを食わないようにすべきだ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 여는 입구라 엄지에 가까워야 하고, 안 쓰는 순간에는 세로 공간을 먹지 않아야 한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是常开的入口，所以要靠近拇指，不用的时候又不能占用纵向空间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是常開的入口，所以要靠近拇指，不用的時候又不能佔用縱向空間"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это часто открываемая точка входа, поэтому она должна быть рядом с большим пальцем и не есть вертикальное место, когда не нужна"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un punto de entrada que se abre con frecuencia, así que debe estar cerca del pulgar y no comer espacio vertical cuando no se usa"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein häufig geöffneter Einstiegspunkt, daher sollte er nahe am Daumen sitzen und keinen vertikalen Platz fressen, wenn er nicht genutzt wird"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un point d'entrée souvent ouvert, donc il doit être près du pouce et ne pas manger d'espace vertical quand il ne sert pas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un punto d'ingresso aperto di frequente, quindi dovrebbe stare vicino al pollice e non mangiare spazio verticale quando non serve"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um ponto de entrada aberto com frequência, então deve ficar perto do polegar e não deve consumir espaço vertical quando não está em uso"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นจุดเข้าที่เปิดบ่อย จึงควรอยู่ใกล้นิ้วโป้งและไม่กินพื้นที่แนวตั้งเมื่อไม่ใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó là một lối vào hay mở, nên nó phải gần ngón cái và không được ăn không gian dọc khi không dùng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to často otevíraný vstupní bod, takže by měl být blízko palce a neměl by žrát svislé místo, když se nepoužívá"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en ofte åbnet indgang, så den bør være nær tommelfingeren og ikke æde lodret plads, når den ikke bruges"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι σημείο εισόδου που ανοίγεται συχνά, οπότε πρέπει να είναι κοντά στον αντίχειρα και να μην τρώει κάθετο χώρο όταν δεν χρησιμοποιείται"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on usein avattava sisäänkäynti, joten sen pitäisi olla lähellä peukaloa eikä sen pitäisi syödä pystytilaa, kun se ei ole käytössä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini pintu masuk yang sering dibuka, jadi seharusnya dekat ibu jari dan tidak memakan ruang vertikal saat tidak dipakai"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er en hyppig åpnet inngang, så den bør være nær tommelen og ikke ta vertikal plass når den ikke brukes"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is een vaak geopende ingang, dus hij hoort dicht bij de duim te zijn en mag geen verticale ruimte opeten als hij niet in gebruik is"
          }
        }
      }
    },
    "자주·반복해서 누르는 액션은 엄지에 가깝게, 어느 쪽이 이 기준을 지켰습니까?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions you tap often and repeatedly belong near the thumb. Which one follows this criterion?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions you tap often and repeatedly belong near the thumb. Which one follows this criterion?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻繁に繰り返し押すアクションは親指の近くに。どちらがこの基準を守っていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주·반복해서 누르는 액션은 엄지에 가깝게, 어느 쪽이 이 기준을 지켰습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经常、反复点按的操作要靠近拇指：哪一边守住了这个标准？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經常、反覆輕點的操作要靠近拇指：哪一邊守住了這個標準？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия, которые нажимают часто и повторно, должны быть рядом с большим пальцем. Какой вариант следует этому критерию?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones que tocas a menudo y repetidamente van cerca del pulgar. ¿Cuál sigue este criterio?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktionen, die du oft und wiederholt antippst, gehören nahe an den Daumen. Welche folgt diesem Kriterium?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions que vous touchez souvent et de façon répétée vont près du pouce. Laquelle suit ce critère ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni che tocchi spesso e ripetutamente vanno vicino al pollice. Quale segue questo criterio?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações que você toca com frequência e repetidamente ficam perto do polegar. Qual segue este critério?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำที่แตะบ่อยและซ้ำ ๆ อยู่ใกล้นิ้วโป้ง อันไหนทำตามเกณฑ์นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hành động bạn chạm thường xuyên và lặp lại thuộc về gần ngón cái. Cái nào theo tiêu chí này?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akce, na které klepete často a opakovaně, patří k palci. Která toto kritérium dodržuje?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlinger, du trykker på ofte og gentagne gange, hører til nær tommelfingeren. Hvilken følger dette kriterium?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ενέργειες που πατάς συχνά και επανειλημμένα ανήκουν κοντά στον αντίχειρα. Ποιο ακολουθεί αυτό το κριτήριο;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toiminnot, joita napautat usein ja toistuvasti, kuuluvat peukalon lähelle. Kumpi noudattaa tätä kriteeriä?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksi yang sering dan berulang kamu ketuk ditaruh dekat ibu jari. Mana yang mengikuti kriteria ini?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlinger du trykker på ofte og gjentatte ganger hører hjemme nær tommelen. Hvilken følger dette kriteriet?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Acties waarop je vaak en herhaaldelijk tikt horen bij de duim. Welke volgt dit criterium?"
          }
        }
      }
    },
