          "stringUnit": {
            "state": "translated",
            "value": "Archivia ed Elimina vanno dentro il menu Altro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivar e Excluir vão dentro do menu Mais."
