    ".navigationTitle(folder.name)\n.toolbarTitleDisplayMode(.inline)\n.toolbarTitleMenu {\n    Picker(\"폴더\", selection: $folder) { /* 폴더 목록 */ }\n    Divider()\n    Button(\"이름 변경\", systemImage: \"pencil\") { renaming = true }\n}": {
