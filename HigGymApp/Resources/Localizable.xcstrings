        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更換資料夾的方式是**輕點標題**。為什麼不另設按鈕？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку меняют **нажатием на заголовок**. Почему нет отдельной кнопки?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambias de carpeta **tocando el título**. ¿Por qué no hay un botón aparte?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wechselst Ordner, indem du **den Titel antippst**. Warum gibt es keinen separaten Button?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous changez de dossier en **touchant le titre**. Pourquoi n'y a-t-il pas de bouton séparé ?"
          }
        },
        "it": {
          "stringUnit": {
