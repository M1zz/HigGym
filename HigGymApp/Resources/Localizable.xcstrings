          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "68개 항목을 관통하는 판단 기준"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贯穿 68 个条目的判断标准"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貫穿 68 個條目的判斷標準"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Критерии оценки, общие для 68 тем"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
