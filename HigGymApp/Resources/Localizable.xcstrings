    "지난 워크숍 사진 중에서 열 장만 골라주시면 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just pick ten photos from the last workshop."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Just pick ten photos from the last workshop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のワークショップの写真から10枚だけ選んでもらえれば大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 워크숍 사진 중에서 열 장만 골라주시면 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需要从上次研讨会的照片里挑出十张就行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需要從上次研討會的照片裡挑出十張就行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите всего десять фотографий с последнего воркшопа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige diez fotos del último taller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Such einfach zehn Fotos vom letzten Workshop aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez simplement dix photos du dernier atelier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli solo dieci foto dell'ultimo workshop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta escolher dez fotos do último workshop."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกรูปสิบรูปจากเวิร์กช็อปครั้งที่แล้วก็พอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ cần chọn mười ảnh từ buổi workshop trước."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostě vyberte deset fotek z posledního workshopu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg bare ti fotos fra sidste workshop."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απλώς διάλεξε δέκα φωτογραφίες από το τελευταίο εργαστήριο."
          }
        },
        "fi": {
          "stringUnit": {
