    "스타일을 abbreviated로 바꾸면 이니셜만 남습니다. 아바타에 쓰는 그 값입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the style to abbreviated and only the initials remain. That's the value you use for avatars."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the style to abbreviated and only the initials remain. That's the value you use for avatars."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイルをabbreviatedに変えると、イニシャルだけが残ります。アバターに使うのはこの値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스타일을 abbreviated로 바꾸면 이니셜만 남습니다. 아바타에 쓰는 그 값입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把样式改成 abbreviated，就只剩下首字母。就是头像上用的那个值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把樣式改成 abbreviated，就只剩下首字母。就是頭像上用的那個值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключите стиль на abbreviated, и останутся только инициалы. Это значение вы используете для аватаров."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el estilo a abbreviated y solo quedan las iniciales. Ese es el valor que usas para los avatares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle den Stil auf abbreviated, und nur die Initialen bleiben. Das ist der Wert, den du für Avatare verwendest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez le style sur abbreviated et il ne reste que les initiales. C'est la valeur à utiliser pour les avatars."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa lo stile ad abbreviato e restano solo le iniziali. È il valore che usi per gli avatar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude o estilo para abbreviated e só ficam as iniciais. É o valor que você usa para avatares."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับรูปแบบเป็น abbreviated แล้วจะเหลือแค่ตัวย่อ นั่นคือค่าที่ใช้กับอวาตาร์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển kiểu sang abbreviated và chỉ còn lại chữ cái đầu. Đó là giá trị bạn dùng cho avatar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepněte styl na abbreviated a zůstanou jen iniciály. To je hodnota, kterou používáte pro avatary."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift stilen til abbreviated, og kun initialerne bliver tilbage. Det er den værdi, du bruger til avatarer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε το στυλ σε abbreviated και μένουν μόνο τα αρχικά. Αυτή είναι η τιμή που χρησιμοποιείς για avatar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda tyyliksi abbreviated, niin jäljelle jäävät vain nimikirjaimet. Se on arvo, jota käytät avatareille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti gaya ke abbreviated dan hanya inisial yang tersisa. Itulah nilai yang kamu pakai untuk avatar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt stilen til abbreviated, så er det bare initialene som er igjen. Det er verdien du bruker for avatarer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de stijl op abbreviated en alleen de initialen blijven over. Dat is de waarde die je voor avatars gebruikt."
          }
        }
      }
    },
