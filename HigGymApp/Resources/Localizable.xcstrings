    "화면에 나갈 문자열을 앱이 직접 조립했습니다`\"\\(km)km\"`, `\"\\(family)\\(given)\"`.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app assembled on-screen strings by hand: `\"\\(km)km\"`, `\"\\(family)\\(given)\"`."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The app assembled on-screen strings by hand: `\"\\(km)km\"`, `\"\\(family)\\(given)\"`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に出す文字列をアプリが自分で組み立てました: `\"\\(km)km\"`、`\"\\(family)\\(given)\"`。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 나갈 문자열을 앱이 직접 조립했습니다`\"\\(km)km\"`, `\"\\(family)\\(given)\"`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用自己拼接了要显示在屏幕上的字符串：`\"\\(km)km\"`、`\"\\(family)\\(given)\"`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式自己拼接了要顯示在螢幕上的字串：`\"\\(km)km\"`、`\"\\(family)\\(given)\"`。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение собрало строки для экрана вручную: `\"\\(km)km\"`, `\"\\(family)\\(given)\"`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app montó a mano las cadenas de la pantalla: `\"\\(km)km\"`, `\"\\(family)\\(given)\"`."
