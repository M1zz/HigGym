    ".safeAreaBar(edge: .top) {\n    VStack(alignment: .leading, spacing: 6) {\n        Text(\"보관함\").font(.title3.bold())\n        FilterChips(selection: $filter)\n    }\n}": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
