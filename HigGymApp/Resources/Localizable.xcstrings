    "기준이 잡혀 있습니다. 틀린 항목만 실습으로 확인해보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've got the criteria down. Check just the ones you missed in the labs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You've got the criteria down. Check just the ones you missed in the labs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準は身についています。間違えた項目だけ実習で確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준이 잡혀 있습니다. 틀린 항목만 실습으로 확인해보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准已经建立。只需通过实践确认错误的条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標準已經建立。只需透過實踐確認錯誤的條目。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Критерии усвоены. Проверьте на практике только те, в которых ошиблись."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya dominas los criterios. Repasa en los laboratorios solo los que fallaste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kriterien sitzen. Prüfe in den Labors nur die, die du verfehlt hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous maîtrisez les critères. Ne vérifiez que ceux que vous avez manqués dans les laboratoires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I criteri li hai capiti. Controlla solo quelli che hai sbagliato nei laboratori."
          }
        }
      }
    },
    "긴 문장으로 바꾸기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a long sentence"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a long sentence"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い文に変える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 문장으로 바꾸기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换成长句子"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換成長句子"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменить на длинное предложение"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar a una frase larga"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu einem langen Satz wechseln"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer à une longue phrase"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a una frase lunga"
          }
        }
      }
    },
    "긴 문장으로 바꿔보면 왜 이 도구가 **짧고 반드시 다 보여야 하는 값**(금액·수치) 전용인지 드러납니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a long sentence, and you'll see why this tool is only for **short values that must be shown in full** (amounts, figures)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a long sentence, and you'll see why this tool is only for **short values that must be shown in full** (amounts, figures)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い文に変えてみると、このツールがなぜ**短くて必ず全部見えるべき値**（金額・数値）専用なのかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 문장으로 바꿔보면 왜 이 도구가 **짧고 반드시 다 보여야 하는 값**(금액·수치) 전용인지 드러납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换成长句子后，就能看出为什么这个工具**只用于简短且必须完整显示的值**（金额、数字）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換成長句子後，就能看出為什麼這個工具**只用於簡短且必須完整顯示的值**（金額、數字）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замените на длинное предложение, и станет понятно, почему этот инструмент только для **коротких значений, которые должны быть видны целиком** (суммы, цифры)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a una frase larga y verás por qué esta herramienta es solo para **valores cortos que deben mostrarse completos** (importes, cifras)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zu einem langen Satz, und du siehst, warum dieses Werkzeug nur für **kurze Werte ist, die vollständig angezeigt werden müssen** (Beträge, Zahlen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez à une longue phrase, et vous verrez pourquoi cet outil est réservé aux **valeurs courtes qui doivent s'afficher en entier** (montants, chiffres)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a una frase lunga, e vedrai perché questo strumento è solo per **valori brevi che devono essere mostrati per intero** (importi, cifre)."
          }
        }
      }
    },
    "긴 문장을 넣으면 배지가 탭 라벨을 덮습니다. 두세 글자가 한계입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put in a long sentence, and the badge covers the tab label. Two or three characters is the limit."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put in a long sentence, and the badge covers the tab label. Two or three characters is the limit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い文を入れるとバッジがタブのラベルを覆います。2〜3文字が限界です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 문장을 넣으면 배지가 탭 라벨을 덮습니다. 두세 글자가 한계입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放入长句子的话，角标会盖住标签文字。两三个字是极限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放入長句子的話，標記會蓋住標籤文字。兩三個字是極限。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подставьте длинное предложение, и бейдж закроет подпись вкладки. Предел - два-три символа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon una frase larga y la insignia tapa la etiqueta de la pestaña. Dos o tres caracteres es el límite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze einen langen Satz ein, und das Badge verdeckt die Tab-Beschriftung. Zwei oder drei Zeichen sind die Grenze."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez une longue phrase, et le badge recouvre le libellé de l'onglet. Deux ou trois caractères, c'est la limite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti una frase lunga e il badge copre l'etichetta della scheda. Due o tre caratteri sono il limite."
          }
        }
      }
    },
