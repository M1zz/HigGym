    "시스템 영역. 상단 배치를 정할 때 실제로 쓸 수 있는 폭을 좌우합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System area. It determines how much width you actually have when planning the top layout."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "System area. It determines how much width you actually have when planning the top layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム領域。上部の配置を決めるとき、実際に使える幅を左右します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 영역. 상단 배치를 정할 때 실제로 쓸 수 있는 폭을 좌우합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统区域。它决定了安排顶部布局时实际可用的宽度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統區域。它決定了安排頂部佈局時實際可用的寬度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная область. Она определяет, какая ширина реально доступна при планировании верхней раскладки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Área del sistema. Determina cuánto ancho tienes realmente al planificar el diseño superior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systembereich. Er bestimmt, wie viel Breite du beim Planen des oberen Layouts tatsächlich hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone système. Elle détermine la largeur dont vous disposez réellement pour planifier la disposition du haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Area di sistema. Determina quanta larghezza hai davvero quando pianifichi il layout in alto."
          }
        }
      }
    },
