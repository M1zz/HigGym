            "value": "Các chủ đề cần ôn lại"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Témata k opakování"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Emner at gense"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέματα για επανάληψη"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kertaa nämä aiheet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Topik untuk ditinjau ulang"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Emner å se på igjen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderwerpen om te herzien"
          }
        }
      }
    },
    "다시 아래로 당기면 나타납니다. \"필요할 때만 꺼내는\" 기본 동작입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down again and it reappears. That's the default \"bring it out only when needed\" behavior."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down again and it reappears. That's the default \"bring it out only when needed\" behaviour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度下に引くと現れます。「必要なときだけ出す」デフォルトの動作です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 아래로 당기면 나타납니다. \"필요할 때만 꺼내는\" 기본 동작입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再往下拉就会出现。这是“需要时才调出”的默认行为。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再往下拉就會出現。這是「需要時才調出」的預設行為。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните вниз ещё раз, и он появится снова. Это стандартное поведение «показывать только по требованию»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a tirar hacia abajo y reaparece. Es el comportamiento por defecto de «sacarlo solo cuando haga falta»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe noch einmal nach unten, und es erscheint wieder. Das ist das Standardverhalten „nur bei Bedarf herausziehen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez à nouveau vers le bas et elle réapparaît. C'est le comportement par défaut « ne la sortir qu'au besoin »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira giù di nuovo e riappare. È il comportamento predefinito «tiralo fuori solo quando serve»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe para baixo de novo e ela reaparece. Esse é o comportamento padrão «trazer só quando precisar»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงลงอีกครั้งแล้วมันจะกลับมา นั่นคือพฤติกรรมเริ่มต้นแบบ \"เอาออกมาเมื่อจำเป็น\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo xuống lần nữa là nó hiện lại. Đó là hành vi mặc định \"chỉ kéo ra khi cần\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhněte znovu a objeví se. To je výchozí chování „vytáhnout, jen když je potřeba“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk ned igen, og den dukker op igen. Det er standardadfærden »træk den frem, kun når der er brug for den.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τράβηξε προς τα κάτω ξανά και εμφανίζεται πάλι. Αυτή είναι η προεπιλεγμένη συμπεριφορά «βγάζε το μόνο όταν χρειάζεται»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä alas uudelleen, niin se ilmestyy takaisin. Se on oletuskäytös ”tuo esiin vain tarvittaessa”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik turun lagi dan ia muncul kembali. Itu perilaku bawaan \"keluarkan hanya saat dibutuhkan\"."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra ned igjen, så dukker den opp på nytt. Det er standardoppførselen «trekk den frem bare når det trengs»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek weer omlaag en hij verschijnt opnieuw. Dat is het standaardgedrag \"haal het alleen tevoorschijn als het nodig is\"."
          }
        }
      }
    },
    "다시 아래로 당기면 원래 크기로 돌아옵니다. 콘텐츠를 볼 때는 물러나고, 시작 지점에선 존재감을 갖습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down again and it returns to its original size. It steps back while you view content and has presence at the starting point."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down again and it returns to its original size. It steps back while you view content and has presence at the starting point."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度下に引くと元の大きさに戻ります。コンテンツを見るときは控えめになり、開始地点では存在感を持ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 아래로 당기면 원래 크기로 돌아옵니다. 콘텐츠를 볼 때는 물러나고, 시작 지점에선 존재감을 갖습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再往下拉就会恢复原来的大小。看内容时退后，在起点处则有存在感。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再往下拉就會恢復原來的大小。看內容時退後，在起點處則有存在感。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните вниз ещё раз, и размер вернётся. Он отступает, пока вы смотрите контент, и заметен в начальной точке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a tirar hacia abajo y regresa a su tamaño original. Se aparta mientras ves el contenido y tiene presencia en el punto de partida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe noch einmal nach unten, und es kehrt zur ursprünglichen Größe zurück. Es tritt zurück, während du Inhalte ansiehst, und hat am Ausgangspunkt Präsenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez à nouveau vers le bas et elle retrouve sa taille d'origine. Elle s'efface pendant que vous regardez le contenu et s'impose au point de départ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira giù di nuovo e torna alla dimensione originale. Si fa da parte mentre guardi il contenuto e ha presenza nel punto di partenza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe para baixo de novo e volta ao tamanho original. Ela recua enquanto você vê o conteúdo e tem presença no ponto de partida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดึงลงอีกครั้งแล้วมันจะกลับเป็นขนาดเดิม ถอยออกไปตอนดูเนื้อหา และมีตัวตนที่จุดเริ่มต้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo xuống lần nữa và nó trở về kích thước ban đầu. Nó lùi lại khi bạn xem nội dung và hiện diện ở điểm xuất phát."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhněte znovu a vrátí se do původní velikosti. Při prohlížení obsahu ustupuje a ve výchozím bodě má přítomnost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk ned igen, og den vender tilbage til sin oprindelige størrelse. Den træder tilbage, mens du ser indhold, og har tilstedeværelse ved udgangspunktet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τράβηξε προς τα κάτω ξανά και επιστρέφει στο αρχικό του μέγεθος. Υποχωρεί ενώ βλέπεις περιεχόμενο και έχει παρουσία στο σημείο εκκίνησης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä alas uudelleen, niin se palaa alkuperäiseen kokoonsa. Se väistyy sisältöä katsoessasi ja on läsnä lähtöpisteessä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik turun lagi dan ia kembali ke ukuran semula. Ia mundur saat kamu melihat konten dan hadir di titik awal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra ned igjen, så går den tilbake til opprinnelig størrelse. Den trer tilbake mens du ser på innhold og har tilstedeværelse ved utgangspunktet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek weer omlaag en hij keert terug naar zijn oorspronkelijke grootte. Hij treedt terug terwijl je inhoud bekijkt en heeft aanwezigheid bij het beginpunt."
          }
        }
      }
    },
    "다시 위로 올려 원래 배치로 돌아오는 것까지 확인해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also check that scrolling back up returns it to the original layout."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Also check that scrolling back up returns it to the original layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上にスクロールして元の配置に戻るところまで確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 위로 올려 원래 배치로 돌아오는 것까지 확인해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请再向上滑回去，确认恢复到原来的布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再向上滑回去，確認恢復到原來的佈局。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте также, что при прокрутке обратно вверх возвращается исходная раскладка."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba también que al desplazar de nuevo hacia arriba vuelve al diseño original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe auch, dass es beim Zurückscrollen nach oben zum ursprünglichen Layout zurückkehrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez aussi qu'en remontant, elle retrouve la disposition d'origine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla anche che, scorrendo di nuovo verso l'alto, torni al layout originale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira também que rolar de volta para cima restaura o layout original."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจด้วยว่าเลื่อนกลับขึ้นแล้วกลับสู่เลย์เอาต์เดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cũng kiểm tra xem cuộn ngược lên có đưa về bố cục ban đầu không."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontrolujte také, že posunutím zpět nahoru se vrátí původní rozvržení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek også, at scrolling tilbage op bringer det oprindelige layout tilbage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έλεγξε επίσης ότι η κύλιση προς τα πάνω επαναφέρει την αρχική διάταξη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista myös, että ylös vieritys palauttaa alkuperäisen asettelun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa juga bahwa menggulir kembali ke atas mengembalikan tata letak semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk også at det å rulle tilbake opp gir tilbake den opprinnelige layouten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer ook dat terugscrollen de oorspronkelijke layout herstelt."
          }
        }
      }
    },
    "다시 위로 올리면 원래대로 펼쳐집니다. 읽는 동안엔 물러나고, 이동하려 하면 돌아옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll back up and it expands again. It steps back while you read and comes back when you want to move on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll back up and it expands again. It steps back while you read and comes back when you want to move on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度上にスクロールすると元どおり広がります。読んでいる間は控えめになり、移動しようとすると戻ってきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 위로 올리면 원래대로 펼쳐집니다. 읽는 동안엔 물러나고, 이동하려 하면 돌아옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再向上滑就会恢复展开。阅读时退后，想要导航时就回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再向上滑就會恢復展開。閱讀時退後，想要導覽時就回來。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите обратно вверх, и он снова раскроется. Он отступает, пока вы читаете, и возвращается, когда вы хотите перейти дальше."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate de nuevo hacia arriba y se expande otra vez. Se aparta mientras lees y vuelve cuando quieres seguir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle wieder nach oben, und es dehnt sich erneut aus. Es tritt zurück, während du liest, und kommt wieder, wenn du weitermachen willst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remontez et elle se déploie à nouveau. Elle s'efface pendant que vous lisez et revient quand vous voulez passer à autre chose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri di nuovo verso l'alto e si espande ancora. Si fa da parte mentre leggi e torna quando vuoi andare avanti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role de volta para cima e ela se expande de novo. Recua enquanto você lê e volta quando você quer seguir adiante."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนกลับขึ้นแล้วมันจะขยายอีกครั้ง ถอยออกไปตอนอ่าน และกลับมาเมื่อคุณอยากไปต่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộn ngược lên và nó mở rộng lại. Nó lùi lại khi bạn đọc và quay lại khi bạn muốn đi tiếp."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte zpět nahoru a znovu se rozbalí. Při čtení ustupuje a vrací se, když chcete jít dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll tilbage op, og den udvides igen. Den træder tilbage, mens du læser, og kommer tilbage, når du vil videre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κύλισε ξανά προς τα πάνω και επεκτείνεται πάλι. Υποχωρεί όσο διαβάζεις και επιστρέφει όταν θέλεις να προχωρήσεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieritä takaisin ylös, niin se laajenee uudelleen. Se väistyy lukiessasi ja palaa, kun haluat jatkaa eteenpäin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gulir kembali ke atas dan ia mengembang lagi. Ia mundur saat kamu membaca dan kembali saat kamu ingin melanjutkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rull tilbake opp, så utvides den igjen. Den trer tilbake mens du leser og kommer tilbake når du vil gå videre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll terug omhoog en hij klapt weer uit. Hij treedt terug terwijl je leest en komt terug als je verder wilt."
          }
        }
      }
    },
    "다시 풀기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度解く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 풀기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新做"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新做"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решить заново"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        },
