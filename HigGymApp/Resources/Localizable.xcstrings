          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下にスワイプしてみてください。閉じません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래로 쓸어내려 보세요, 닫히지 않습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
