    "iOS 26 대응 브랜치를 main 에 머지했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I merged the iOS 26 support branch into main."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "I merged the iOS 26 support branch into main."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26対応ブランチを main にマージしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 대응 브랜치를 main 에 머지했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已把适配 iOS 26 的分支合并到 main。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已把適配 iOS 26 的分支合併到 main。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я влил ветку с поддержкой iOS 26 в main."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He fusionado la rama de compatibilidad con iOS 26 en main."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe den Branch für die iOS-26-Unterstützung in main gemergt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai fusionné la branche de prise en charge d'iOS 26 dans main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho fatto il merge del branch di supporto a iOS 26 in main."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiz o merge do branch de suporte ao iOS 26 na main."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันรวมบรานช์รองรับ iOS 26 เข้า main แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã gộp nhánh hỗ trợ iOS 26 vào main."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sloučil jsem větev s podporou iOS 26 do main."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har flettet iOS 26-supportgrenen ind i main."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγχώνευσα το branch υποστήριξης iOS 26 στο main."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
