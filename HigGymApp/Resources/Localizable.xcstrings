            "state": "translated",
            "value": "因為工具列位置不夠，只好藏起來"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На панели инструментов не хватило места, поэтому пришлось спрятать"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No había suficiente sitio en la barra de herramientas, así que no tuve más remedio que ocultarla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Symbolleiste war nicht genug Platz, also blieb mir nichts übrig, als sie auszublenden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y avait pas assez de place dans la barre d'outils, donc je n'ai pas eu d'autre choix que de la masquer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella barra degli strumenti non c'era abbastanza spazio, quindi non ho avuto scelta che nasconderlo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não havia espaço suficiente na barra de ferramentas, então não tive escolha a não ser escondê-la"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ในแถบเครื่องมือไม่พอ ฉันจึงไม่มีทางเลือกนอกจากซ่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh công cụ không đủ chỗ, nên tôi không còn cách nào ngoài ẩn đi"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V panelu nástrojů nebylo dost místa, takže jsem ho musel skrýt"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der var ikke plads nok i værktøjslinjen, så jeg havde intet valg end at skjule den"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπήρχε αρκετός χώρος στη γραμμή εργαλείων, οπότε δεν είχα άλλη επιλογή από το να την κρύψω"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkalupalkissa ei ollut tarpeeksi tilaa, joten minun oli pakko piilottaa se"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
