          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer la marque « Je l'ai faite »"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella il segno «L'ho fatto anch'io»"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar a marca «já cometi isso»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างเครื่องหมาย “ฉันเคยทำ”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa dấu “tôi từng mắc lỗi này”"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrušit označení „udělal(a) jsem to“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryd mærket »det har jeg gjort«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκκαθάριση της επισήμανσης «το έκανα αυτό»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista ”olen tehnyt tämän” -merkintä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus tanda \"aku pernah melakukan ini\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern merket «Jeg har gjort dette»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wis de markering \"Dit heb ik gedaan\""
          }
        }
      }
