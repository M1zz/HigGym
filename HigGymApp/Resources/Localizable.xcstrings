            "value": "// 이렇게 했다\nScrollView { PhotoGrid() }\n    .scrollEdgeEffectHidden(true, for: .top)\n\n// 이렇게 고쳤다\nScrollView { PhotoGrid() }\n    .scrollEdgeEffectStyle(.hard, for: .top)"
          }
