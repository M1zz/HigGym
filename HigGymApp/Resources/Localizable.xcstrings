    "아래에서 로케일을 **en_US**로 바꿔보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the locale below to **en_US**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the locale below to **en_US**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下でロケールを**en_US**に変えてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 로케일을 **en_US**로 바꿔보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下面把区域设置改成 **en_US**。"
