    "거리 값을 화면에 표시하려 합니다. 미국 사용자에게는 마일로 보여야 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You want to show a distance value on screen. US users should see it in miles."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You want to show a distance value on screen. US users should see it in miles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "距離の値を画面に表示しようとしています。アメリカのユーザーにはマイルで表示されるべきです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거리 값을 화면에 표시하려 합니다. 미국 사용자에게는 마일로 보여야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要在界面上显示距离值。对美国用户应显示为英里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要在介面上顯示距離值。對美國使用者應顯示為英里。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно показать расстояние на экране. Пользователям из США его нужно показывать в милях."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quieres mostrar un valor de distancia en pantalla. Los usuarios de EE. UU. deberían verlo en millas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du willst einen Entfernungswert auf dem Bildschirm zeigen. Nutzer in den USA sollten ihn in Meilen sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voulez afficher une valeur de distance à l'écran. Les utilisateurs américains doivent la voir en miles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi mostrare un valore di distanza sullo schermo. Gli utenti statunitensi dovrebbero vederlo in miglia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você quer mostrar um valor de distância na tela. Usuários dos EUA devem vê-lo em milhas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยากแสดงค่าระยะทางบนหน้าจอ ผู้ใช้ในสหรัฐฯ ควรเห็นเป็นไมล์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn hiển thị giá trị khoảng cách trên màn hình. Người dùng Mỹ nên thấy bằng dặm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete na obrazovce zobrazit hodnotu vzdálenosti. Uživatelé v USA by ji měli vidět v mílích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil vise en afstandsværdi på skærmen. Brugere i USA skal se den i miles."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις να δείξεις μια τιμή απόστασης στην οθόνη. Οι χρήστες των ΗΠΑ πρέπει να τη βλέπουν σε μίλια."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluat näyttää etäisyysarvon näytöllä. Yhdysvaltalaisten käyttäjien tulisi nähdä se maileina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu ingin menampilkan nilai jarak di layar. Pengguna AS seharusnya melihatnya dalam mil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil vise en avstandsverdi på skjermen. Amerikanske brukere skal se den i miles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wilt een afstandswaarde op het scherm tonen. Amerikaanse gebruikers moeten hem in mijlen zien."
          }
        }
      }
    },
