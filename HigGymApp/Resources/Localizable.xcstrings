    "가두지 않는 것이 언제나 친절은 아니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not trapping people isn't always kind"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not trapping people isn't always kind"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じ込めないことが、いつも親切とは限らない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가두지 않는 것이 언제나 친절은 아니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不把人困住，并不总是一种体贴"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不把人困住，並不總是一種體貼"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не запирать человека - не всегда доброта"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No atrapar a la gente no siempre es amable"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menschen nicht festzuhalten ist nicht immer freundlich"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas piéger les gens n'est pas toujours bienveillant"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non intrappolare le persone non è sempre gentile"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não prender as pessoas nem sempre é gentil"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การไม่ขังคนไว้ไม่ได้หมายถึงความใจดีเสมอไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không nhốt người ta không phải lúc nào cũng tử tế"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nezamykat lidi není vždy laskavé"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At undgå at fange folk er ikke altid venligt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το να μην παγιδεύεις τους ανθρώπους δεν είναι πάντα ευγενικό"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihmisten ansaan jättämättä jättäminen ei aina ole ystävällistä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak menjebak orang tidak selalu baik hati"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å ikke fange folk er ikke alltid snilt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensen niet insluiten is niet altijd vriendelijk"
          }
        }
      }
    },
    "가로 바는 세로 공간을 아낍니다. 캔버스처럼 세로가 아까운 화면의 도구 배치입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A horizontal bar saves vertical space. It's the tool layout for screens like a canvas, where vertical space is precious."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A horizontal bar saves vertical space. It's the tool layout for screens like a canvas, where vertical space is precious."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横向きのバーは縦のスペースを節約します。キャンバスのように縦の余白が惜しい画面向けのツール配置です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로 바는 세로 공간을 아낍니다. 캔버스처럼 세로가 아까운 화면의 도구 배치입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横向栏节省纵向空间。这是画布这类纵向空间宝贵的界面的工具布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "橫向列節省縱向空間。這是畫布這類縱向空間寶貴的介面的工具佈局。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Горизонтальная панель экономит вертикальное место. Это раскладка инструментов для экранов вроде холста, где вертикальное место дорого."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra horizontal ahorra espacio vertical. Es la disposición de herramientas para pantallas como un lienzo, donde el espacio vertical es precioso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine horizontale Leiste spart vertikalen Platz. Es ist das Werkzeuglayout für Bildschirme wie eine Zeichenfläche, auf denen vertikaler Platz kostbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre horizontale économise l'espace vertical. C'est la disposition d'outils pour des écrans comme un canevas, où l'espace vertical est précieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra orizzontale risparmia spazio verticale. È il layout degli strumenti per schermate come una tela da disegno, dove lo spazio verticale è prezioso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra horizontal economiza espaço vertical. É o layout de ferramentas para telas como um canvas, em que o espaço vertical é precioso."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแนวนอนช่วยประหยัดพื้นที่แนวตั้ง เป็นเลย์เอาต์เครื่องมือสำหรับหน้าจอแบบแคนวาส ที่พื้นที่แนวตั้งมีค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thanh ngang tiết kiệm không gian dọc. Đó là bố cục công cụ cho các màn hình như canvas, nơi không gian dọc rất quý."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodorovný panel šetří svislý prostor. Je to rozvržení nástrojů pro obrazovky jako plátno, kde je svislý prostor drahý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En vandret bjælke sparer lodret plads. Det er værktøjslayoutet til skærme som et lærred, hvor lodret plads er kostbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια οριζόντια γραμμή εξοικονομεί κάθετο χώρο. Είναι η διάταξη εργαλείων για οθόνες όπως ένας καμβάς, όπου ο κάθετος χώρος είναι πολύτιμος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaakasuuntainen palkki säästää pystytilaa. Se on työkaluasettelu näkymille, kuten piirtoalueelle, joilla pystytila on kallista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah horizontal menghemat ruang vertikal. Ini tata letak alat untuk layar seperti kanvas, tempat ruang vertikal berharga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En horisontal linje sparer vertikal plass. Det er verktøyoppsettet for skjermer som et lerret, der vertikal plass er dyrebar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een horizontale balk bespaart verticale ruimte. Het is de gereedschapsopstelling voor schermen als een canvas, waar verticale ruimte kostbaar is."
          }
        }
      }
    },
    "가로 스크롤 카드처럼 높이가 균일해야 하는 그리드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grids that need uniform heights, like horizontally scrolling cards"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Grids that need uniform heights, like horizontally scrolling cards"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横スクロールのカードのように、高さをそろえる必要があるグリッド"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로 스크롤 카드처럼 높이가 균일해야 하는 그리드"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像横向滚动卡片那样，需要高度一致的网格"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像橫向滾動卡片那樣，需要高度一致的網格"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетки, которым нужна одинаковая высота, например горизонтально прокручиваемые карточки"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuadrículas que necesitan alturas uniformes, como tarjetas de desplazamiento horizontal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Raster, die einheitliche Höhen brauchen, etwa horizontal scrollende Karten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les grilles qui ont besoin de hauteurs uniformes, comme des cartes à défilement horizontal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Griglie che richiedono altezze uniformi, come carte a scorrimento orizzontale"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grades que precisam de alturas uniformes, como cartões de rolagem horizontal"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กริดที่ต้องการความสูงเท่ากัน เช่นการ์ดที่เลื่อนแนวนอน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưới cần chiều cao đồng đều, như các thẻ cuộn ngang"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mřížky, které potřebují jednotnou výšku, jako vodorovně posouvané karty"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitre, der kræver ensartede højder, som vandret scrollende kort"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πλέγματα που χρειάζονται ομοιόμορφα ύψη, όπως οριζόντια κυλιόμενες κάρτες"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruudukot, jotka tarvitsevat tasaiset korkeudet, kuten vaakasuunnassa vieritettävät kortit"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisi yang butuh tinggi seragam, seperti kartu yang digulir horizontal"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutenett som trenger jevn høyde, som horisontalt rullende kort"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasters die gelijke hoogtes nodig hebben, zoals horizontaal scrollende kaarten"
          }
        }
      }
    },
    "가로 화면·iPad의 세로 도구 막대. 인셋과 가장자리 효과를 시스템이 대줍니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A vertical tool bar for landscape and iPad. The system provides the insets and the edge effect."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A vertical tool bar for landscape and iPad. The system provides the insets and the edge effect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横画面やiPadの縦型ツールバー。インセットとエッジエフェクトはシステムが用意してくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로 화면·iPad의 세로 도구 막대. 인셋과 가장자리 효과를 시스템이 대줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横屏和 iPad 上的竖向工具栏。内边距和边缘效果由系统提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "橫向螢幕和 iPad 上的豎向工具列。內邊距和邊緣效果由系統提供。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вертикальная панель инструментов для альбомной ориентации и iPad. Отступы и эффект края даёт система."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra de herramientas vertical para horizontal y iPad. El sistema aporta los márgenes y el efecto de borde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vertikale Werkzeugleiste für Querformat und iPad. Das System liefert die Abstände und den Kanteneffekt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre d'outils verticale pour le mode paysage et l'iPad. Le système fournit les marges et l'effet de bord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una barra degli strumenti verticale per l'orientamento orizzontale e l'iPad. Il sistema fornisce i margini e l'effetto sul bordo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma barra de ferramentas vertical para paisagem e iPad. O sistema fornece os recuos e o efeito de borda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบเครื่องมือแนวตั้งสำหรับแนวนอนและ iPad ระบบจัดหาระยะขอบและเอฟเฟกต์ขอบให้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thanh công cụ dọc cho chế độ ngang và iPad. Hệ thống cung cấp phần đệm và hiệu ứng cạnh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svislý panel nástrojů pro šířku a iPad. Systém zajišťuje odsazení i okrajový efekt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En lodret værktøjsbjælke til liggende format og iPad. Systemet leverer indrykningerne og kanteffekten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια κάθετη γραμμή εργαλείων για οριζόντιο προσανατολισμό και iPad. Το σύστημα παρέχει τις εσοχές και το εφέ άκρης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pystysuuntainen työkalupalkki vaaka-asentoon ja iPadille. Järjestelmä tarjoaa sisennykset ja reunaefektin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah alat vertikal untuk lanskap dan iPad. Sistem menyediakan inset dan efek tepinya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En vertikal verktøylinje for landskap og iPad. Systemet gir innrykkene og kanteffekten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een verticale gereedschapsbalk voor landscape en iPad. Het systeem levert de insets en het randeffect."
          }
        }
      }
    },
    "가운데 **작성 탭**을 눌러보세요. 시트를 닫고 나서 지금 어느 탭에 있는지 확인하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **Compose tab** in the middle. After closing the sheet, check which tab you're on."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **Compose tab** in the middle. After closing the sheet, check which tab you're on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央の**作成タブ**をタップしてみてください。シートを閉じたあと、今どのタブにいるか確かめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 **작성 탭**을 눌러보세요. 시트를 닫고 나서 지금 어느 탭에 있는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点中间的**撰写标签**。关闭弹层后，确认自己现在在哪个标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點中間的**撰寫標籤**。關閉工作表後，確認自己現在在哪個標籤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите **вкладку «Написать»** посередине. После закрытия шторки проверьте, на какой вы вкладке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la **pestaña Redactar** del medio. Tras cerrar la hoja, comprueba en qué pestaña estás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in der Mitte auf den **Tab „Verfassen“**. Prüfe nach dem Schließen des Sheets, in welchem Tab du bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l'**onglet Rédiger** au milieu. Après avoir fermé la feuille, vérifiez sur quel onglet vous êtes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la **scheda Scrivi** al centro. Dopo aver chiuso il foglio, controlla su quale scheda ti trovi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na **aba Escrever** no meio. Depois de fechar a folha, confira em qual aba você está."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ**แท็บเขียน**ตรงกลาง หลังปิดชีตแล้วตรวจดูว่าตอนนี้คุณอยู่แท็บไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm **tab Soạn** ở giữa. Sau khi đóng sheet, kiểm tra xem bạn đang ở tab nào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na **kartu Napsat** uprostřed. Po zavření sheetu zkontrolujte, na které kartě jste."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på **fanen Skriv** i midten. Når du har lukket arket, så tjek, hvilken fane du er på."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε την **καρτέλα Σύνταξη** στη μέση. Αφού κλείσεις το φύλλο, έλεγξε σε ποια καρτέλα βρίσκεσαι."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta keskellä olevaa **Kirjoita-välilehteä**. Tarkista arkin sulkemisen jälkeen, millä välilehdellä olet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk **tab Tulis** di tengah. Setelah menutup lembar, periksa kamu berada di tab mana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på **Skriv-fanen** i midten. Etter at du har lukket arket, sjekk hvilken fane du er på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het tabblad **Opstellen** in het midden. Controleer na het sluiten van de sheet op welk tabblad je zit."
          }
        }
      }
    },
    "가운데를 접어 양 끝(루트와 파일명)을 남겼습니다, 정보 가치가 있는 쪽을 보존하는 선택입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The middle is collapsed to keep both ends (the root and the file name), a choice that preserves the parts that carry information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The middle is collapsed to keep both ends (the root and the file name), a choice that preserves the parts that carry information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央を省略して両端（ルートとファイル名）を残しました。情報価値のある部分を残す選択です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데를 접어 양 끝(루트와 파일명)을 남겼습니다, 정보 가치가 있는 쪽을 보존하는 선택입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "折叠中间，保留两端（根目录和文件名），选择保留的是信息价值更高的一侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摺疊中間，保留兩端（根目錄和檔名），選擇保留的是資訊價值更高的一側。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Середина свёрнута, чтобы сохранить оба конца (корень и имя файла): выбор в пользу той части, где сосредоточена информация."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El medio se colapsa para conservar ambos extremos (la raíz y el nombre del archivo), una elección que preserva las partes que llevan información."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitte wird zusammengeklappt, um beide Enden zu erhalten (die Wurzel und den Dateinamen), eine Wahl, die die informationstragenden Teile bewahrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le milieu est replié pour garder les deux extrémités (la racine et le nom du fichier), un choix qui préserve les parties porteuses d'information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il centro viene compresso per mantenere entrambe le estremità (la radice e il nome del file), una scelta che preserva le parti che portano informazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O meio é recolhido para manter as duas pontas (a raiz e o nome do arquivo), uma escolha que preserva as partes que carregam informação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนกลางถูกยุบเพื่อรักษาทั้งสองปลาย (รากและชื่อไฟล์) เป็นการเลือกที่เก็บส่วนที่มีข้อมูลไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần giữa được thu gọn để giữ cả hai đầu (gốc và tên tệp), một lựa chọn bảo toàn những phần mang thông tin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Střed je sbalený, aby zůstaly oba konce (kořen a název souboru), což je volba zachovávající části, které nesou informaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Midten er klappet sammen for at bevare begge ender (roden og filnavnet), et valg der bevarer de dele, der bærer information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μέση συμπτύσσεται για να κρατηθούν και τα δύο άκρα (η ρίζα και το όνομα αρχείου), μια επιλογή που διατηρεί τα μέρη που φέρουν πληροφορία."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskiosa on tiivistetty molempien päiden (juuren ja tiedostonimen) säilyttämiseksi, valinta joka säilyttää tietoa kantavat osat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian tengah diciutkan untuk mempertahankan kedua ujung (akar dan nama file), pilihan yang menjaga bagian yang membawa informasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Midten er kollapset for å beholde begge ender (roten og filnavnet), et valg som bevarer delene som bærer informasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het midden is ingeklapt om beide uiteinden te behouden (de root en de bestandsnaam), een keuze die de delen die informatie dragen bewaart."
          }
        }
      }
    },
    "가장 밝은/복잡한 콘텐츠가 바 뒤를 지날 때 컨트롤이 읽히는지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the controls stay readable as the brightest, busiest content passes behind the bar"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the controls stay readable as the brightest, busiest content passes behind the bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も明るく複雑なコンテンツがバーの後ろを通るときに、コントロールが読めるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 밝은/복잡한 콘텐츠가 바 뒤를 지날 때 컨트롤이 읽히는지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最亮或最复杂的内容从栏后面经过时，控件还读得清吗"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最亮或最複雜的內容從列後面經過時，控制元件還讀得清嗎"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаются ли элементы управления читаемыми, когда за панелью проходит самый яркий и сложный контент"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los controles siguen siendo legibles mientras el contenido más brillante y cargado pasa por detrás de la barra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob die Steuerelemente lesbar bleiben, wenn der hellste, unruhigste Inhalt hinter der Leiste vorbeizieht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les contrôles restent lisibles quand le contenu le plus lumineux et le plus chargé passe derrière la barre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se i controlli restano leggibili mentre dietro la barra passa il contenuto più luminoso e più carico"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os controles continuam legíveis quando o conteúdo mais claro e mais carregado passa atrás da barra"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวควบคุมยังอ่านออกหรือไม่เมื่อเนื้อหาที่สว่างและวุ่นวายที่สุดผ่านไปด้านหลังแถบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các điều khiển có còn đọc được khi nội dung sáng nhất, rối nhất đi qua phía sau thanh không"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zda ovládací prvky zůstanou čitelné, když za panelem projde nejjasnější a nejrušnější obsah"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Om kontrollerne forbliver læselige, når det lyseste, mest urolige indhold passerer bag bjælken"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν οι έλεγχοι παραμένουν ευανάγνωστοι καθώς το φωτεινότερο και πιο φορτωμένο περιεχόμενο περνά πίσω από τη γραμμή"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysyvätkö säätimet luettavina, kun kirkkain ja vilkkain sisältö kulkee palkin takaa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah kontrol tetap terbaca saat konten paling terang dan paling ramai lewat di belakang bilah"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Om kontrollene forblir lesbare når det lyseste, travleste innholdet passerer bak linjen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of de bedieningselementen leesbaar blijven als de helderste, drukste inhoud achter de balk langskomt"
          }
        }
      }
    },
    "가장 아름다웠던 상태를 지키려다, 흰 사진·눈밭·강 위를 지날 때마다 컨트롤이 사라진다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In trying to protect its most beautiful state, the controls vanish every time they pass over a white photo, a snowfield, or a river."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In trying to protect its most beautiful state, the controls vanish every time they pass over a white photo, a snowfield, or a river."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん美しい状態を守ろうとして、白い写真や雪原、川の上を通るたびにコントロールが消える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 아름다웠던 상태를 지키려다, 흰 사진·눈밭·강 위를 지날 때마다 컨트롤이 사라진다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了守住最漂亮的状态，每次经过白色照片、雪地、河面，控件都会消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了守住最漂亮的狀態，每次經過白色照片、雪地、河面，控制元件都會消失。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пытаясь сохранить самый красивый вид, мы получаем исчезновение элементов управления каждый раз, когда за ними проходит белая фотография, снежное поле или река."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al intentar proteger su estado más bello, los controles desaparecen cada vez que pasan sobre una foto blanca, un campo nevado o un río."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Versuch, ihren schönsten Zustand zu schützen, verschwinden die Steuerelemente jedes Mal, wenn sie über ein weißes Foto, ein Schneefeld oder einen Fluss laufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En voulant protéger son état le plus beau, les contrôles disparaissent chaque fois qu'ils passent sur une photo blanche, un champ de neige ou une rivière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel tentativo di proteggere il suo stato più bello, i controlli spariscono ogni volta che passano sopra una foto bianca, un campo di neve o un fiume."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao tentar proteger seu estado mais bonito, os controles somem toda vez que passam sobre uma foto branca, um campo de neve ou um rio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพราะพยายามปกป้องสภาพที่สวยที่สุดของตัวเอง ตัวควบคุมจึงหายไปทุกครั้งที่ผ่านรูปสีขาว ทุ่งหิมะ หรือแม่น้ำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi cố bảo vệ trạng thái đẹp nhất của mình, các điều khiển biến mất mỗi khi đi qua ảnh trắng, cánh đồng tuyết hoặc dòng sông."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při snaze ochránit svůj nejkrásnější stav ovládací prvky zmizí pokaždé, když přejdou přes bílou fotku, sněhové pole nebo řeku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I forsøget på at beskytte sin smukkeste tilstand forsvinder kontrollerne hver gang, de passerer over et hvidt foto, en snemark eller en flod."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στην προσπάθεια να προστατευτεί η πιο όμορφη κατάστασή του, οι έλεγχοι εξαφανίζονται κάθε φορά που περνούν πάνω από μια λευκή φωτογραφία, ένα χιονισμένο τοπίο ή ένα ποτάμι."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yrittäessään suojella kauneinta tilaansa säätimet katoavat joka kerta, kun ne ylittävät valkoisen valokuvan, lumikentän tai joen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam upaya melindungi keadaan paling indahnya, kontrol lenyap setiap kali melewati foto putih, hamparan salju, atau sungai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I forsøket på å beskytte sin peneste tilstand forsvinner kontrollene hver gang de passerer over et hvitt bilde, et snøfelt eller en elv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In een poging om de mooiste toestand te beschermen verdwijnen de bedieningselementen elke keer dat ze over een witte foto, een sneeuwveld of een rivier gaan."
          }
        }
      }
    },
    "가장 오른쪽 아이템부터 잘라 버린다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuts off items starting from the rightmost one"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuts off items starting from the rightmost one"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん右のアイテムから切り捨てる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 오른쪽 아이템부터 잘라 버린다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从最右边的项目开始截掉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從最右邊的項目開始截掉"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отрезает элементы, начиная с самого правого"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta elementos empezando por el de más a la derecha"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneidet Elemente ab, beginnend mit dem ganz rechten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe les éléments en commençant par celui le plus à droite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Taglia gli elementi a partire dal più a destra"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta os itens começando pelo mais à direita"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัดรายการเริ่มจากรายการขวาสุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắt các mục bắt đầu từ mục ngoài cùng bên phải"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odřezává položky počínaje tou zcela vpravo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afskærer elementer fra det yderste til højre"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κόβει στοιχεία ξεκινώντας από το δεξιότερο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkaisee kohteita oikeanpuoleisimmasta alkaen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memotong item mulai dari yang paling kanan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutter elementer med start fra det ytterste til høyre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapt items af, te beginnen met de meest rechtse"
          }
        }
      }
    },
    "가장 오른쪽 탭을 한 손으로 눌러보세요. 옆 탭을 잘못 누르지 않는지도요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the rightmost tab with one hand. Also check that you don't hit the tab next to it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the rightmost tab with one hand. Also check that you don't hit the tab next to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん右のタブを片手でタップしてみてください。隣のタブを誤ってタップしないかも確かめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 오른쪽 탭을 한 손으로 눌러보세요. 옆 탭을 잘못 누르지 않는지도요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用单手点最右边的标签，也看看会不会误点到旁边的标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用單手點最右邊的標籤，也看看會不會誤點到旁邊的標籤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите самую правую вкладку одной рукой. Заодно проверьте, не попадаете ли вы по соседней."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la pestaña de más a la derecha con una sola mano. Comprueba también que no tocas la pestaña de al lado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe mit einer Hand auf den ganz rechten Tab. Prüfe auch, dass du nicht den Nachbar-Tab erwischst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l'onglet tout à droite d'une seule main. Vérifiez aussi que vous ne touchez pas l'onglet voisin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca con una mano la scheda all'estrema destra. Controlla anche di non colpire la scheda accanto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na aba mais à direita com uma mão. Confira também que você não atinge a aba ao lado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะแท็บขวาสุดด้วยมือเดียว และตรวจด้วยว่าไม่ได้โดนแท็บข้าง ๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm tab ngoài cùng bên phải bằng một tay. Kiểm tra luôn xem bạn có chạm nhầm tab bên cạnh không."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte jednou rukou na kartu zcela vpravo. Zkontrolujte také, že nezasáhnete sousední kartu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på den yderste fane til højre med én hånd. Tjek også, at du ikke rammer fanen ved siden af."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε την τελευταία δεξιά καρτέλα με το ένα χέρι. Έλεγξε και ότι δεν πατάς την διπλανή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta oikeanpuoleisinta välilehteä yhdellä kädellä. Tarkista myös, ettet osu viereiseen välilehteen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tab paling kanan dengan satu tangan. Periksa juga bahwa kamu tidak mengenai tab di sebelahnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på fanen lengst til høyre med én hånd. Sjekk også at du ikke treffer fanen ved siden av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik met één hand op het meest rechtse tabblad. Controleer ook dat je het tabblad ernaast niet raakt."
          }
        }
      }
    },
    "가장 자주 쓰는 **작성**이 화면 맨 위에 있습니다. 한 손으로 5번 눌러보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Compose**, the most-used action, sits at the very top of the screen. Tap it 5 times with one hand."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Compose**, the most-used action, sits at the very top of the screen. Tap it 5 times with one hand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最もよく使う**作成**が画面のいちばん上にあります。片手で5回タップしてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 자주 쓰는 **작성**이 화면 맨 위에 있습니다. 한 손으로 5번 눌러보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最常用的**撰写**在屏幕最上方。用单手点 5 次试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最常用的**撰寫**在螢幕最上方。用單手點 5 次試試。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**«Написать»**, самое частое действие, стоит в самом верху экрана. Нажмите его 5 раз одной рукой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Redactar**, la acción más usada, está en lo más alto de la pantalla. Tócala 5 veces con una sola mano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Verfassen**, die am häufigsten genutzte Aktion, sitzt ganz oben auf dem Bildschirm. Tippe sie mit einer Hand 5-mal an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rédiger**, l'action la plus utilisée, se trouve tout en haut de l'écran. Touchez-la 5 fois d'une seule main."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scrivi**, l'azione più usata, sta in cima alla schermata. Toccala 5 volte con una mano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Escrever**, a ação mais usada, fica no alto da tela. Toque nela 5 vezes com uma mão."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**เขียน** การกระทำที่ใช้มากที่สุด อยู่บนสุดของหน้าจอ ลองแตะ 5 ครั้งด้วยมือเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Soạn**, hành động dùng nhiều nhất, nằm trên cùng màn hình. Chạm nó 5 lần bằng một tay."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Napsat**, nejpoužívanější akce, je úplně nahoře na obrazovce. Klepněte na ni 5krát jednou rukou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Skriv**, den mest brugte handling, sidder helt øverst på skærmen. Tryk på den 5 gange med én hånd."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το **Σύνταξη**, η πιο χρησιμοποιούμενη ενέργεια, βρίσκεται στην κορυφή της οθόνης. Πάτησέ το 5 φορές με το ένα χέρι."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kirjoita**, eniten käytetty toiminto, on aivan näkymän yläreunassa. Napauta sitä 5 kertaa yhdellä kädellä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tulis**, aksi yang paling sering dipakai, berada di paling atas layar. Ketuk 5 kali dengan satu tangan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Skriv**, den mest brukte handlingen, ligger helt øverst på skjermen. Trykk på den 5 ganger med én hånd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Opstellen**, de meest gebruikte actie, staat helemaal bovenaan het scherm. Tik er 5 keer op met één hand."
          }
        }
      }
    },
    "가장 자주 하는 일은 어디에 두는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do you put the thing people do most?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do you put the thing people do most?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばんよく行う操作はどこに置くか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 자주 하는 일은 어디에 두는가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把最常做的事放在哪里"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把最常做的事放在哪裡"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Куда ставить то, что делают чаще всего?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde pones lo que la gente hace más?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin kommt das, was Menschen am häufigsten tun?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où place-t-on ce que les gens font le plus ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove metti ciò che le persone fanno di più?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde você coloca o que as pessoas mais fazem?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณวางสิ่งที่คนทำมากที่สุดไว้ที่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đặt thứ người ta làm nhiều nhất ở đâu?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kam dáte to, co lidé dělají nejčastěji?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor lægger du det, folk gør mest?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πού βάζεις αυτό που κάνουν οι άνθρωποι περισσότερο;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mihin laitat sen, mitä ihmiset tekevät eniten?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di mana kamu menaruh hal yang paling sering dilakukan orang?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor plasserer du det folk gjør mest?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
