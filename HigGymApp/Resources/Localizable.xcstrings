          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บทที่ %1$lld เป็นต้นไปเป็นส่วนของ Pro ทำบทที่เหลืออีก %2$lld บทในแบบเดียวกับที่เพิ่งทำ"
