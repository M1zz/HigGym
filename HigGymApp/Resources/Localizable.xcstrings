    "단축어와 Spotlight에서 멈춘 레슨을 바로 열거나 노트를 펼칠 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the lesson you paused or your notes right from Shortcuts and Spotlight."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the lesson you paused or your notes right from Shortcuts and Spotlight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットやSpotlightから、途中のレッスンをすぐに開いたり、ノートを表示したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어와 Spotlight에서 멈춘 레슨을 바로 열거나 노트를 펼칠 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以通过快捷指令和 Spotlight 直接打开中断的课程，或展开笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以透過快捷指令和 Spotlight 直接開啟中斷的課程，或展開筆記。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывайте приостановленный урок или заметки прямо из «Команд» и Spotlight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la lección que dejaste a medias o tus notas directamente desde Atajos y Spotlight."
          }
        },
        "de": {
          "stringUnit": {
