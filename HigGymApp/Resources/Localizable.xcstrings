    "1층에 새로 생긴 곳 가보실 분?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone want to try the new place on the first floor?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone want to try the new place on the first floor?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1階に新しくできたお店、行ってみたい人いますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1층에 새로 생긴 곳 가보실 분?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一楼新开了一家，有人想去看看吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一樓新開了一家，有人想去看看嗎？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто хочет сходить в новое место на первом этаже?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Alguien quiere probar el sitio nuevo de la planta baja?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat jemand Lust, das neue Lokal im Erdgeschoss auszuprobieren?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un veut essayer le nouvel endroit au rez-de-chaussée ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno vuole provare il nuovo locale al piano terra?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém quer experimentar o lugar novo no primeiro andar?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใครอยากลองร้านใหม่ที่ชั้นหนึ่งบ้าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có ai muốn thử quán mới ở tầng một không?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Má někdo chuť vyzkoušet nové místo v prvním patře?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er der nogen, der har lyst til at prøve det nye sted i stuen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλει κανείς να δοκιμάσουμε το νέο μαγαζί στον πρώτο όροφο;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluaako joku kokeilla uutta paikkaa ensimmäisessä kerroksessa?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada yang mau coba tempat baru di lantai satu?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Er det noen som vil prøve det nye stedet i første etasje?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft iemand zin om de nieuwe plek op de eerste verdieping te proberen?"
          }
        }
      }
    },
