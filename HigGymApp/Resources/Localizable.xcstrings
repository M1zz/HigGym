        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rutas comparten un prefijo común al principio, así que ver solo el principio no permite distinguir los elementos. La información está en ambos extremos, así que colapsa el medio con **.middle**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfade haben am Anfang ein gemeinsames Präfix, daher lassen sich Elemente nicht unterscheiden, wenn man nur den Anfang sieht. Die Information steckt an beiden Enden, also klappe die Mitte mit **.middle** zusammen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chemins partagent un préfixe commun au début, donc voir seulement le début ne permet pas de les distinguer. L'information est aux deux extrémités, donc repliez le milieu avec **.middle**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I percorsi condividono un prefisso comune all'inizio, quindi vedere solo l'inizio non permette di distinguere gli elementi. L'informazione sta alle due estremità, quindi comprimi il centro con **.middle**."
          }
