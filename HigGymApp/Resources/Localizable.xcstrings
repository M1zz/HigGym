    "단축어와 Spotlight에서 멈춘 레슨을 바로 열거나 노트를 펼칠 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the lesson you paused or your notes right from Shortcuts and Spotlight."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the lesson you paused or your notes right from Shortcuts and Spotlight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットやSpotlightから、途中のレッスンをすぐに開いたり、ノートを表示したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어와 Spotlight에서 멈춘 레슨을 바로 열거나 노트를 펼칠 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以通过快捷指令和 Spotlight 直接打开中断的课程，或展开笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以透過快捷指令和 Spotlight 直接開啟中斷的課程，或展開筆記。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывайте приостановленный урок или заметки прямо из «Команд» и Spotlight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la lección que dejaste a medias o tus notas directamente desde Atajos y Spotlight."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die pausierte Lektion oder deine Notizen direkt aus Kurzbefehle und Spotlight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la leçon mise en pause ou vos notes directement depuis Raccourcis et Spotlight."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la lezione che hai messo in pausa o le tue note direttamente da Comandi rapidi e Spotlight."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a lição que você pausou ou suas notas direto pelos Atalhos e pelo Spotlight."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดบทเรียนที่หยุดไว้หรือโน้ตของคุณได้จาก Shortcuts และ Spotlight โดยตรง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở bài học đang dở hoặc ghi chú của bạn ngay từ Phím tắt và Spotlight."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete lekci, kterou jste přerušili, nebo své poznámky přímo ze Zkratek a Spotlightu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn den lektion, du satte på pause, eller dine noter direkte fra Genveje og Spotlight."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το μάθημα που σταμάτησες ή τις σημειώσεις σου κατευθείαν από τις Συντομεύσεις και το Spotlight."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa keskeyttämäsi oppitunti tai muistiinpanosi suoraan Pikakomennoista ja Spotlightista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka pelajaran yang kamu jeda atau catatanmu langsung dari Pintasan dan Spotlight."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne leksjonen du satte på pause eller notatene dine rett fra Snarveier og Spotlight."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de les die je op pauze zette of je notities direct vanuit Opdrachten en Spotlight."
          }
        }
      }
    },
