            "value": "El texto grande de accesibilidad está activado"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großer Text der Bedienungshilfen ist eingeschaltet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le grand texte d'accessibilité est activé"
          }
        },
        "it": {
