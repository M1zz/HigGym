            "state": "translated",
            "value": "右"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
