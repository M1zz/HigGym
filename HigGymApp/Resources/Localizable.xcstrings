            "value": "Ennen kuin rakennat järjestelmäpalkin uudelleen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum kamu membangun ulang bilah sistem"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Før du bygger om en systemlinje"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voordat je een systeembalk opnieuw bouwt"
          }
        }
      }
    },
    "시스템 영역. 상단 배치를 정할 때 실제로 쓸 수 있는 폭을 좌우합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System area. It determines how much width you actually have when planning the top layout."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "System area. It determines how much width you actually have when planning the top layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム領域。上部の配置を決めるとき、実際に使える幅を左右します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 영역. 상단 배치를 정할 때 실제로 쓸 수 있는 폭을 좌우합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统区域。它决定了安排顶部布局时实际可用的宽度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統區域。它決定了安排頂部佈局時實際可用的寬度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная область. Она определяет, какая ширина реально доступна при планировании верхней раскладки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Área del sistema. Determina cuánto ancho tienes realmente al planificar el diseño superior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systembereich. Er bestimmt, wie viel Breite du beim Planen des oberen Layouts tatsächlich hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone système. Elle détermine la largeur dont vous disposez réellement pour planifier la disposition du haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Area di sistema. Determina quanta larghezza hai davvero quando pianifichi il layout in alto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Área do sistema. Determina quanta largura você realmente tem ao planejar o layout superior."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ระบบ เป็นตัวกำหนดว่าคุณมีความกว้างจริงเท่าไรตอนวางแผนเลย์เอาต์ด้านบน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vùng hệ thống. Nó quyết định bạn thật sự có bao nhiêu chiều rộng khi lên kế hoạch bố cục phía trên."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Systémová oblast. Určuje, kolik šířky skutečně máte při plánování horního rozvržení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemområde. Det afgør, hvor meget bredde du faktisk har, når du planlægger det øverste layout."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Περιοχή συστήματος. Καθορίζει πόσο πλάτος έχεις πραγματικά όταν σχεδιάζεις την πάνω διάταξη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmäalue. Se määrittää, kuinka paljon leveyttä sinulla todella on ylhäällä olevaa asettelua suunnitellessa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Area sistem. Ia menentukan seberapa banyak lebar yang benar-benar kamu miliki saat merencanakan tata letak atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemområde. Det bestemmer hvor mye bredde du faktisk har når du planlegger den øvre layouten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeemgebied. Het bepaalt hoeveel breedte je werkelijk hebt bij het plannen van de bovenste layout."
          }
        }
      }
    },
