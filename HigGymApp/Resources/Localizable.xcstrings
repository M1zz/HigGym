            "state": "translated",
            "value": "La versión 2.4.0 ya está disponible en la App Store."
          }
        }
      }
    },
    "버튼 색을 더 밝은 흰색으로 바꾼다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the button color a brighter white"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Make the button colour a brighter white"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンの色をもっと明るい白に変える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼 색을 더 밝은 흰색으로 바꾼다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把按钮颜色改成更亮的白色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把按鈕顏色改成更亮的白色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделать цвет кнопки более ярким белым"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer el color del botón un blanco más brillante"
          }
        }
      }
    },
    "버튼 하나. 몇 개를 어느 자리에 두느냐가 곧 이 화면의 문법입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One button. How many you place, and where, is the grammar of this screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "One button. How many you place, and where, is the grammar of this screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンは1つ。何個をどこに置くかが、そのままこの画面の文法です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼 하나. 몇 개를 어느 자리에 두느냐가 곧 이 화면의 문법입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个按钮。放几个、放在哪个位置，就是这个界面的语法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個按鈕。放幾個、放在哪個位置，就是這個介面的語法。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна кнопка. Сколько их и где они стоят - это грамматика данного экрана."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un botón. Cuántos pones y dónde es la gramática de esta pantalla."
          }
        }
      }
    },
    "버튼들을 균등하게 축소해 모두 표시한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrink all buttons evenly so they all fit"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrink all buttons evenly so they all fit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを均等に縮小してすべて表示する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼들을 균등하게 축소해 모두 표시한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把按钮等比缩小，全部显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把按鈕等比縮小，全部顯示"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Равномерно уменьшить все кнопки, чтобы поместились все"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir todos los botones por igual para que quepan todos"
          }
        }
      }
    },
    "버튼에 불투명 배경색을 직접 지정한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the buttons an opaque background color directly"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the buttons an opaque background colour directly"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンに不透明な背景色を直接指定する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼에 불투명 배경색을 직접 지정한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给按钮直接指定不透明的背景色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給按鈕直接指定不透明的背景色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
