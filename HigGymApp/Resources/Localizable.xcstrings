            "state": "translated",
            "value": "用 lineLimit(2) 排成兩行"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенести на две строки через lineLimit(2)"
          }
        },
        "es": {
