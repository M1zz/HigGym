    "제목 옆 **⌄** 를 눌러보세요, 제목 자체가 메뉴 버튼입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **⌄** next to the title. The title itself is a menu button."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **⌄** next to the title. The title itself is a menu button."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの横の「⌄」をタップしてみてください。タイトルそのものがメニューボタンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 옆 **⌄** 를 눌러보세요, 제목 자체가 메뉴 버튼입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按标题旁的 **⌄**：标题本身就是菜单按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點標題旁的 **⌄**：標題本身就是選單按鈕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите **⌄** рядом с заголовком. Сам заголовок - кнопка меню."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el **⌄** junto al título. El propio título es un botón de menú."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das **⌄** neben dem Titel. Der Titel selbst ist ein Menü-Button."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le **⌄** à côté du titre. Le titre lui-même est un bouton de menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il **⌄** accanto al titolo. Il titolo stesso è un pulsante di menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no **⌄** ao lado do título. O próprio título é um botão de menu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ **⌄** ข้างชื่อเรื่อง ชื่อเรื่องเองคือปุ่มเมนู"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm **⌄** bên cạnh tiêu đề. Chính tiêu đề là một nút menu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na **⌄** vedle nadpisu. Samotný nadpis je tlačítko nabídky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på **⌄** ved siden af titlen. Selve titlen er en menuknap."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε το **⌄** δίπλα στον τίτλο. Ο ίδιος ο τίτλος είναι κουμπί μενού."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta otsikon vieressä olevaa **⌄**. Otsikko itse on valikkopainike."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk **⌄** di sebelah judul. Judul itu sendiri adalah tombol menu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på **⌄** ved siden av tittelen. Selve tittelen er en menyknapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de **⌄** naast de titel. De titel zelf is een menuknop."
          }
        }
      }
    },
    "제목 옆의 **⌄** 를 누르면 메뉴가 열립니다. 폴더를 바꾸면 제목과 목록이 같이 바뀝니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **⌄** next to the title to open a menu. Change the folder, and the title and list change together."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **⌄** next to the title to open a menu. Change the folder, and the title and list change together."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルの横の「⌄」をタップするとメニューが開きます。フォルダを変えると、タイトルとリストが一緒に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 옆의 **⌄** 를 누르면 메뉴가 열립니다. 폴더를 바꾸면 제목과 목록이 같이 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按标题旁的 **⌄** 会打开菜单。切换文件夹，标题和列表会一起变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點標題旁的 **⌄** 會開啟選單。切換資料夾，標題和列表會一起變。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите **⌄** рядом с заголовком, чтобы открыть меню. Смените папку, и заголовок и список изменятся вместе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el **⌄** junto al título para abrir un menú. Cambia la carpeta y el título y la lista cambian juntos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das **⌄** neben dem Titel, um ein Menü zu öffnen. Ändere den Ordner, und Titel und Liste ändern sich gemeinsam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le **⌄** à côté du titre pour ouvrir un menu. Changez de dossier, et le titre et la liste changent ensemble."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il **⌄** accanto al titolo per aprire un menu. Cambia la cartella e titolo ed elenco cambiano insieme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no **⌄** ao lado do título para abrir um menu. Mude a pasta e o título e a lista mudam juntos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ **⌄** ข้างชื่อเรื่องเพื่อเปิดเมนู เปลี่ยนโฟลเดอร์ แล้วชื่อเรื่องและรายการเปลี่ยนไปด้วยกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm **⌄** bên cạnh tiêu đề để mở menu. Đổi thư mục, và tiêu đề cùng danh sách đổi theo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na **⌄** vedle nadpisu otevřete nabídku. Změňte složku a nadpis a seznam se změní společně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på **⌄** ved siden af titlen for at åbne en menu. Skift mappe, og titel og liste ændres sammen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε το **⌄** δίπλα στον τίτλο για να ανοίξεις ένα μενού. Άλλαξε φάκελο και ο τίτλος και η λίστα αλλάζουν μαζί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta otsikon vieressä olevaa **⌄** avataksesi valikon. Vaihda kansiota, niin otsikko ja luettelo muuttuvat yhdessä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk **⌄** di sebelah judul untuk membuka menu. Ganti folder, dan judul serta daftar berubah bersama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på **⌄** ved siden av tittelen for å åpne en meny. Bytt mappe, så endres tittelen og listen sammen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de **⌄** naast de titel om een menu te openen. Wijzig de map en de titel en lijst veranderen samen."
          }
        }
      }
    },
