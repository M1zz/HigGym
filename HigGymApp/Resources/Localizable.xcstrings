        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε το εργαλείο ανάλογα με το αν βγάζει ακόμα νόημα όταν περικοπεί"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse työkalu sen mukaan, onko sillä vielä järkeä katkaistuna"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
