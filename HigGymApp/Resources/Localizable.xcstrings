            "value": "書いた内容を保存してレッスンを閉じます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓴 글을 저장하고 레슨을 닫습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存你写的文字并关闭课程"
