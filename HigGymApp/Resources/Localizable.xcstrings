        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στην κατεστραμμένη έκδοση, εκτίμησε με το μάτι τι ποσοστό της οθόνης καταλαμβάνει το πραγματικό περιεχόμενο."
          }
        },
        "fi": {
          "stringUnit": {
