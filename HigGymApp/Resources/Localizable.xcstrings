    "겪어본 실수 표시 지우기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the “I've made this” mark"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the “I've made this” mark"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経験済みの印を消す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "겪어본 실수 표시 지우기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除“踩过的坑”标记"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除「踩過的坑」標記"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снять отметку «со мной бывало»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar la marca de «lo he cometido»"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
