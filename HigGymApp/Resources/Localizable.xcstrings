          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "68 témat s příklady, 7 zásad a vaše poznámky zůstávají zdarma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De 68 emner med eksempler, 7 principper og dine noter forbliver gratis."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα 68 θέματα με παραδείγματα, οι 7 αρχές και οι σημειώσεις σου παραμένουν δωρεάν."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "68 aihetta esimerkkeineen, 7 periaatetta ja muistiinpanosi pysyvät ilmaisina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "68 topik dengan contoh, 7 prinsip, dan catatanmu tetap gratis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De 68 emnene med eksempler, 7 prinsipper og notatene dine forblir gratis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De 68 onderwerpen met voorbeelden, 7 principes en je notities blijven gratis."
          }
        }
      }
    },
    "계정이 없고, 쓴 글은 기기 안에만 남습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account. What you write stays on your device."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No account. What you write stays on your device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは不要で、書いた内容は端末の中だけに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账户，你写的内容只保存在设备里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有帳號，你寫的內容只儲存在裝置裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта. Написанное остаётся на вашем устройстве."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta. Lo que escribes se queda en tu dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto. Was du schreibst, bleibt auf deinem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte. Ce que vous écrivez reste sur votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account. Quello che scrivi resta sul tuo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta. O que você escreve fica no seu dispositivo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องมีบัญชี สิ่งที่คุณเขียนอยู่บนอุปกรณ์ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần tài khoản. Những gì bạn viết ở lại trên thiết bị của bạn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný účet. To, co napíšete, zůstává na vašem zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto. Det, du skriver, bliver på din enhed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς λογαριασμό. Ό,τι γράφεις μένει στη συσκευή σου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tiliä. Kirjoittamasi pysyy laitteellasi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akun. Yang kamu tulis tetap di perangkatmu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto. Det du skriver forblir på enheten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account. Wat je schrijft blijft op je apparaat."
          }
        }
      }
    },
