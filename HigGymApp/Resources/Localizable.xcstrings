    "3조 2항만 문구를 다듬었습니다. 확인 후 회신 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I only reworded Section 3, Clause 2. Please review and get back to me."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "I only reworded Section 3, Clause 2. Please review and get back to me."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "第3条第2項の文言だけ整えました。ご確認のうえ、ご返信ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3조 2항만 문구를 다듬었습니다. 확인 후 회신 주세요."
