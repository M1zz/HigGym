            "value": "La cápsula separada que ves a la derecha está construida con el **rol de búsqueda**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die separate Kapsel, die du rechts siehst, ist mit der **Suchrolle** gebaut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
