    "결제 내역의 **금액을 하나씩 소리 내어 읽어** 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try **reading each amount aloud** in the payment history."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try **reading each amount aloud** in the payment history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お支払い履歴の**金額をひとつずつ声に出して読んで**みてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 내역의 **금액을 하나씩 소리 내어 읽어** 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请把支付记录里的**每一笔金额逐个读出声**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請把付款記錄裡的**每一筆金額逐個讀出聲**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте **прочитать каждую сумму вслух** в истории платежей."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a **leer cada importe en voz alta** en el historial de pagos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche, im Zahlungsverlauf **jeden Betrag laut vorzulesen**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de **lire chaque montant à voix haute** dans l'historique des paiements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a **leggere ad alta voce ogni importo** nella cronologia dei pagamenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente **ler cada valor em voz alta** no histórico de pagamentos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลอง**อ่านออกเสียงแต่ละจำนวนเงิน**ในประวัติการชำระเงิน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử **đọc to từng số tiền** trong lịch sử thanh toán."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkuste si v historii plateb **přečíst každou částku nahlas**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv at **læse hvert beløb højt** i betalingshistorikken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκίμασε να **διαβάσεις δυνατά κάθε ποσό** στο ιστορικό πληρωμών."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile **lukea jokainen summa ääneen** maksuhistoriassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba **bacakan setiap jumlah dengan lantang** di riwayat pembayaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv å **lese hvert beløp høyt** i betalingshistorikken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer **elk bedrag hardop te lezen** in de betalingsgeschiedenis."
          }
        }
      }
    },
    "결제 시트 열기": {
      "localizations": {
