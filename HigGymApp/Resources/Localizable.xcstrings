    "위아래 **양쪽 모두** 커스텀 바입니다. 수직 방향의 풀 구성입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Both** top and bottom are custom bars. The full vertical setup."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Both** top and bottom are custom bars. The full vertical setup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下**両方**がカスタムバーです。縦方向のフル構成です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래 **양쪽 모두** 커스텀 바입니다. 수직 방향의 풀 구성입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下**两边都是**自定义栏。这是纵向方向上的完整配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下**兩邊都是**自定義列。這是縱向方向上的完整配置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И **верх, и низ** - пользовательские панели. Полная вертикальная конфигурация."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tanto** arriba como abajo son barras personalizadas. La configuración vertical completa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sowohl** oben als auch unten sind eigene Leisten. Die vollständige vertikale Konfiguration."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le haut et le bas sont **tous deux** des barres personnalisées. La configuration verticale complète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Entrambe**, in alto e in basso, sono barre personalizzate. La configurazione verticale completa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tanto** o topo quanto a parte de baixo são barras personalizadas. A configuração vertical completa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ทั้ง**ด้านบนและด้านล่างเป็นแถบที่กำหนดเอง การตั้งค่าแนวตั้งเต็มรูปแบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Cả** trên lẫn dưới đều là thanh tùy chỉnh. Cấu hình dọc đầy đủ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Oba**, horní i dolní, jsou vlastní panely. Plné svislé nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Både** top og bund er brugerdefinerede bjælker. Den fulde lodrette opsætning."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Και** η κορυφή και το κάτω μέρος είναι προσαρμοσμένες γραμμές. Η πλήρης κάθετη διάταξη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sekä** ylä- että alaosa ovat mukautettuja palkkeja. Täysi pystysuuntainen asetelma."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Baik** atas maupun bawah adalah bilah kustom. Penataan vertikal penuh."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Både** topp og bunn er egendefinerte linjer. Det fulle vertikale oppsettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Zowel** boven als onder zijn aangepaste balken. De volledige verticale opzet."
          }
        }
      }
    },
    "위아래 역할이 다르므로 달라도 된다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Top and bottom have different roles, so they can differ"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Top and bottom have different roles, so they can differ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下で役割が違うので、違ってもよい"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래 역할이 다르므로 달라도 된다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下角色不同，所以可以不同"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下角色不同，所以可以不同"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У верха и низа разные роли, поэтому они могут отличаться"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba y abajo tienen funciones distintas, así que pueden ser distintos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben und unten haben verschiedene Aufgaben, daher dürfen sie sich unterscheiden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le haut et le bas ont des rôles différents, donc ils peuvent différer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alto e basso hanno ruoli diversi, quindi possono essere diversi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Topo e parte de baixo têm papéis diferentes, então podem ser diferentes"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้านบนกับด้านล่างมีบทบาทต่างกัน จึงต่างกันได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên và dưới có vai trò khác nhau, nên có thể khác nhau"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Horní a dolní mají různé role, takže se mohou lišit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Top og bund har forskellige roller, så de må gerne være forskellige"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κορυφή και το κάτω μέρος έχουν διαφορετικούς ρόλους, οπότε μπορούν να διαφέρουν"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ylä- ja alaosalla on eri roolit, joten ne voivat erota"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atas dan bawah punya peran berbeda, jadi boleh berbeda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Topp og bunn har ulike roller, så de kan være forskjellige"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boven en onder hebben verschillende rollen, dus ze mogen verschillen"
          }
        }
      }
    },
    "위아래가 같은 효과로 통일되어야 콘텐츠가 **“두 유리 사이를 지나는 하나의 면”**으로 읽힙니다.\n\n위는 soft인데 아래만 hard면 한 화면 안에서 재질 은유가 깨집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when top and bottom share the same effect does the content read as **“one surface passing between two sheets of glass.”**\n\nIf the top is soft and only the bottom is hard, the material metaphor breaks within a single screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when top and bottom share the same effect does the content read as **“one surface passing between two sheets of glass.”**\n\nIf the top is soft and only the bottom is hard, the material metaphor breaks within a single screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下が同じエフェクトでそろってはじめて、コンテンツは「**2枚のガラスの間を通るひとつの面**」として読めます。\n\n上はsoftなのに下だけhardだと、ひとつの画面の中でマテリアルの比喩が崩れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래가 같은 효과로 통일되어야 콘텐츠가 **“두 유리 사이를 지나는 하나의 면”**으로 읽힙니다.\n\n위는 soft인데 아래만 hard면 한 화면 안에서 재질 은유가 깨집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下必须统一成同一种效果，内容才会被读成**“穿过两块玻璃之间的一个面”**。\n\n上面是 soft 而下面只有 hard，同一个界面里材质的隐喻就破了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下必須統一成同一種效果，內容才會被讀成**「穿過兩塊玻璃之間的一個面」**。\n\n上面是 soft 而下面只有 hard，同一個介面裡材質的隱喻就破了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только когда верх и низ используют один и тот же эффект, содержимое читается как **«единая поверхность, проходящая между двумя стёклами»**.\n\nЕсли сверху soft, а только снизу hard, метафора материала ломается в пределах одного экрана."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuando arriba y abajo comparten el mismo efecto el contenido se lee como **«una superficie que pasa entre dos láminas de cristal»**.\n\nSi arriba es soft y solo abajo es hard, la metáfora del material se rompe dentro de una misma pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn oben und unten denselben Effekt teilen, liest sich der Inhalt als **„eine Fläche, die zwischen zwei Glasscheiben hindurchzieht“.**\n\nIst oben soft und nur unten hard, bricht die Materialmetapher innerhalb eines einzigen Bildschirms."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est que lorsque le haut et le bas partagent le même effet que le contenu se lit comme **« une seule surface passant entre deux plaques de verre ».**\n\nSi le haut est soft et que seul le bas est hard, la métaphore du matériau se brise au sein d'un seul écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quando alto e basso condividono lo stesso effetto il contenuto si legge come **«un'unica superficie che passa tra due lastre di vetro»**.\n\nSe l'alto è morbido e solo il basso è netto, la metafora del materiale si rompe in una sola schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só quando o topo e a parte de baixo compartilham o mesmo efeito o conteúdo é lido como **«uma única superfície passando entre duas lâminas de vidro».**\n\nSe o topo é soft e só a parte de baixo é hard, a metáfora do material se quebra dentro de uma única tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะเมื่อด้านบนและด้านล่างใช้เอฟเฟกต์เดียวกัน เนื้อหาจึงถูกอ่านเป็น**“พื้นผิวเดียวที่ผ่านระหว่างกระจกสองแผ่น”**\n\nถ้าด้านบนเป็น soft และเฉพาะด้านล่างเป็น hard อุปมาของวัสดุจะพังภายในหน้าจอเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khi trên và dưới dùng cùng một hiệu ứng thì nội dung mới được đọc là **“một bề mặt đi giữa hai tấm kính.”**\n\nNếu phía trên là soft và chỉ phía dưới là hard, ẩn dụ vật liệu vỡ ngay trong một màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jen když horní a dolní sdílejí stejný efekt, obsah se čte jako **„jeden povrch procházející mezi dvěma skly.“**\n\nPokud je horní soft a hard jen dolní, materiálová metafora se rozbije uvnitř jedné obrazovky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun når top og bund deler samme effekt, læses indholdet som **»én flade, der passerer mellem to glasplader.«**\n\nHvis toppen er blød og kun bunden er hård, brydes materialemetaforen på en enkelt skærm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο όταν η κορυφή και το κάτω μέρος μοιράζονται το ίδιο εφέ διαβάζεται το περιεχόμενο ως **«μία επιφάνεια που περνά ανάμεσα σε δύο τζάμια».**\n\nΑν η κορυφή είναι soft και μόνο το κάτω μέρος είναι hard, η μεταφορά του υλικού παραβιάζεται μέσα σε μία οθόνη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasta kun ylä- ja alaosalla on sama efekti, sisältö luetaan **”yhtenä pintana, joka kulkee kahden lasilevyn välissä”.**\n\nJos yläosa on soft ja vain alaosa hard, materiaalimetafora hajoaa yhden näkymän sisällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ketika atas dan bawah berbagi efek yang sama, konten terbaca sebagai **\"satu permukaan yang lewat di antara dua lembar kaca.\"**\n\nJika atas soft dan hanya bawah yang hard, metafora material rusak dalam satu layar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare når topp og bunn deler samme effekt, leses innholdet som **«én overflate som passerer mellom to glassplater».**\n\nHvis toppen er myk og bare bunnen er hard, brytes materialmetaforen innenfor én enkelt skjerm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen als boven en onder hetzelfde effect delen, leest de inhoud als **\"één oppervlak dat tussen twee glasplaten door gaat.\"**\n\nAls de bovenkant zacht is en alleen de onderkant hard, breekt de materiaalmetafoor binnen één scherm."
          }
        }
      }
    },
    "위에는 필터 바, 아래에는 컨트롤 바가 함께 있는 화면입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen with a filter bar at the top and a control bar at the bottom."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen with a filter bar at the top and a control bar at the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上にフィルタバー、下にコントロールバーがある画面です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에는 필터 바, 아래에는 컨트롤 바가 함께 있는 화면입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是上面有筛选栏、下面有控制栏的界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是上面有篩選列、下面有控制列的介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран с панелью фильтров сверху и панелью управления снизу."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pantalla con una barra de filtros arriba y una barra de control abajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bildschirm mit einer Filterleiste oben und einer Steuerleiste unten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écran avec une barre de filtres en haut et une barre de contrôle en bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una schermata con una barra dei filtri in alto e una barra di controllo in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tela com uma barra de filtros no topo e uma barra de controles embaixo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอที่มีแถบตัวกรองด้านบนและแถบควบคุมด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một màn hình có thanh bộ lọc ở trên và thanh điều khiển ở dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovka s lištou filtrů nahoře a ovládacím panelem dole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En skærm med en filterbjælke øverst og en kontrolbjælke nederst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια οθόνη με γραμμή φίλτρων στην κορυφή και γραμμή ελέγχων στο κάτω μέρος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkymä, jonka yläosassa on suodatinpalkki ja alaosassa ohjauspalkki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar dengan bilah filter di atas dan bilah kontrol di bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En skjerm med en filterlinje øverst og en kontrolllinje nederst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een scherm met een filterbalk bovenaan en een bedieningsbalk onderaan."
          }
        }
      }
