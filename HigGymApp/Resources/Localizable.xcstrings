    "내보내기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기"
          }
        }
      }
    },
    "내용": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용"
          }
        }
      }
    },
    "내용 오류나 다뤄 줬으면 하는 화면이 있으면 알려 주세요. 메일에는 기기 모델과 iOS 버전을 함께 적어 주시면 빨리 확인할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let us know about errors in the content or screens you'd like covered. Including your device model and iOS version in the email helps us look into it quickly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容の誤りや取り上げてほしい画面があれば教えてください。メールにデバイスのモデルとiOSのバージョンを書いていただくと、早く確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용 오류나 다뤄 줬으면 하는 화면이 있으면 알려 주세요. 메일에는 기기 모델과 iOS 버전을 함께 적어 주시면 빨리 확인할 수 있습니다."
          }
        }
      }
    },
    "내용이 커지면 어떻게 되는지도 확인해 보세요. 커스텀 높이는 내용과 어긋나기 쉽습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also check what happens when the content grows. Custom heights easily fall out of sync with the content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が増えたらどうなるかも確かめてみてください。カスタムの高さは内容とずれやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 커지면 어떻게 되는지도 확인해 보세요. 커스텀 높이는 내용과 어긋나기 쉽습니다."
          }
        }
      }
    },
    "너비": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Width"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너비"
          }
        }
      }
    },
    "너비를 wide · abbreviated · narrow로 바꿔가며 같은 값의 표기 차이를 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the width between wide · abbreviated · narrow to see how the same value is written differently."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅をwide · abbreviated · narrowと切り替えながら、同じ値の表記の違いを見てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너비를 wide · abbreviated · narrow로 바꿔가며 같은 값의 표기 차이를 보세요."
          }
        }
      }
    },
    "넘치는 아이템을 overflow 메뉴(⋯)로 접는다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fold overflowing items into the overflow menu (⋯)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あふれたアイテムをoverflowメニュー（⋯）にまとめる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넘치는 아이템을 overflow 메뉴(⋯)로 접는다"
          }
        }
      }
    },
    "넘칠 때의 처리": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handling overflow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あふれたときの処理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넘칠 때의 처리"
          }
        }
      }
    },
    "넘침": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overflows"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はみ出す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넘침"
          }
        }
      }
    },
    "네 개, 대부분의 앱이 도달하는 균형점입니다. 눌러 옮겨 다녀 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four, the balance point most apps arrive at. Tap around to move between them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4つ。ほとんどのアプリがたどり着くバランスです。タップして行き来してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 개, 대부분의 앱이 도달하는 균형점입니다. 눌러 옮겨 다녀 보세요."
          }
        }
      }
    },
    "네 자리가 한 화면에 다 있습니다, 왼쪽 묶음 · 중앙 컨트롤 · 오른쪽 액션 · 하단 바.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All four spots are on one screen: left group · center control · right action · bottom bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4つの場所がひとつの画面にすべてあります。左のまとまり · 中央のコントロール · 右のアクション · 下部のバー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 자리가 한 화면에 다 있습니다, 왼쪽 묶음 · 중앙 컨트롤 · 오른쪽 액션 · 하단 바."
          }
        }
      }
    },
    "네 자리를 다 채웠습니다. 다 동작하지만, 이 화면에서 정말 필요한 것이 몇 개인지 세어 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All four spots are filled. Everything works, but count how many this screen really needs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4つの場所をすべて埋めました。どれも動きますが、この画面で本当に必要なのはいくつか数えてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 자리를 다 채웠습니다. 다 동작하지만, 이 화면에서 정말 필요한 것이 몇 개인지 세어 보세요."
          }
        }
      }
    },
    "노을": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunset"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕焼け"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노을"
          }
        }
      }
    },
    "노트": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트"
          }
        }
      }
    },
    "노트 검색": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search notes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモを検索"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트 검색"
          }
        }
      }
    },
    "노트 상세 · 본문": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note detail · body"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの詳細 · 本文"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트 상세 · 본문"
          }
        }
      }
    },
    "노트 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモなし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트 없음"
          }
        }
      }
    },
    "노트 탭에서 다시 읽고, 텍스트나 마크다운 파일로 내보낼 수 있습니다. 진도와 노트는 이 기기에만 저장되고 어디로도 보내지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reread them in the Notes tab, or export them as text or Markdown files. Your progress and notes are stored only on this device and never sent anywhere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートタブで読み返したり、テキストやMarkdownファイルとして書き出したりできます。進み具合とノートはこのデバイスにだけ保存され、どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트 탭에서 다시 읽고, 텍스트나 마크다운 파일로 내보낼 수 있습니다. 진도와 노트는 이 기기에만 저장되고 어디로도 보내지 않습니다."
          }
        }
      }
    },
    "노트를 **세 개 만들어** 보세요. 한 손으로, 기기를 고쳐 쥐지 말고 해보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try **creating three notes**. Use one hand, without adjusting your grip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモを**3つ作って**みてください。片手で、デバイスを持ち直さずにやってみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 **세 개 만들어** 보세요. 한 손으로, 기기를 고쳐 쥐지 말고 해보세요."
          }
        }
      }
    },
    "노트를 **하나 지워** 보세요. 그다음 새 노트를 만들려면 어디를 눌러야 할지도 찾아보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try **deleting a note**. Then find where you'd tap to create a new one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモを**1つ削除して**みてください。そのあと、新しいメモを作るにはどこをタップすればいいかも探してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 **하나 지워** 보세요. 그다음 새 노트를 만들려면 어디를 눌러야 할지도 찾아보세요."
          }
        }
      }
    },
    "노트를 앱 밖으로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take your notes out of the app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートをアプリの外へ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 앱 밖으로"
          }
        }
      }
    },
    "노트를 열고, 쓰고, 밀어서 지우고, 검색해 보세요. 이 시트를 내려도 앱은 그대로 동작합니다. 그다음 아래 결정을 하나씩 눌러 **왜 그 자리인지** 확인하세요, 누르면 그 자리에 테두리가 켜집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a note, write, swipe to delete, and search. You can pull down this sheet and the app keeps working. Then tap each decision below to see **why it's in that spot**; tapping lights up an outline around it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモを開いて、書いて、スワイプで削除して、検索してみてください。このシートを下げてもアプリはそのまま動きます。それから下の決定をひとつずつタップして、**なぜその場所なのか**確かめてください。タップするとその場所に枠が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 열고, 쓰고, 밀어서 지우고, 검색해 보세요. 이 시트를 내려도 앱은 그대로 동작합니다. 그다음 아래 결정을 하나씩 눌러 **왜 그 자리인지** 확인하세요, 누르면 그 자리에 테두리가 켜집니다."
          }
        }
      }
    },
    "노트를 텍스트로 복사했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied notes as text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートをテキストとしてコピーしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 텍스트로 복사했습니다"
          }
        }
      }
    },
    "높이 단계가 둘인데 그랩바를 껐습니다. 끌어올릴 수 있다는 어포던스가 사라져 사용자가 large 단계의 존재를 모릅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are two height steps, but the grabber is off. Without the affordance that says it can be pulled up, people don't know the large step exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高さの段階が2つあるのにグラバーをオフにしました。引き上げられるというアフォーダンスが消え、ユーザーはlargeの段階があることに気づきません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높이 단계가 둘인데 그랩바를 껐습니다. 끌어올릴 수 있다는 어포던스가 사라져 사용자가 large 단계의 존재를 모릅니다."
          }
        }
      }
    },
    "높이 방식을 **height(250) ↔ fraction(0.3)** 로 바꿔가며 열어보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open it while switching the height method between **height(250) ↔ fraction(0.3)**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高さの指定方法を**height(250) ↔ fraction(0.3**)と切り替えながら開いてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높이 방식을 **height(250) ↔ fraction(0.3)** 로 바꿔가며 열어보세요."
          }
        }
      }
    },
    "누구나 아는 소수의 아이콘(홈·검색)에만 쓸 수 있는 형태입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This form only works for the few icons everyone knows (Home, Search)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰もが知っている少数のアイコン（ホーム・検索）にしか使えない形です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구나 아는 소수의 아이콘(홈·검색)에만 쓸 수 있는 형태입니다."
          }
        }
      }
    },
    "누르려던 탭이 눌렸나요? 라벨은 끝까지 보였나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did the tab you meant to tap get tapped? Were the labels visible in full?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしようとしたタブがタップされましたか？ラベルは最後まで見えましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르려던 탭이 눌렸나요? 라벨은 끝까지 보였나요?"
          }
        }
      }
    },
    "눈 덮인 지역": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow-covered area"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雪に覆われた地域"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈 덮인 지역"
          }
        }
      }
    },
    "눌렀던 것과 열린 것이 **같은 것임을 모션으로 증명**하는 장치입니다. 공간적 연속성이 유지되어 “어디서 왔는지”를 설명할 필요가 없습니다.\n\nstandard는 출처 정보를 버리므로, 출처가 의미 있을 때는 zoom이 정답입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a device that **proves through motion that what you tapped and what opened are the same thing**. Spatial continuity is preserved, so there's no need to explain “where it came from.”\n\nstandard throws away where it came from, so when the origin matters, zoom is the answer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしたものと開いたものが**同じものであることをモーションで証明する**仕組みです。空間的な連続性が保たれるので、「どこから来たのか」を説明する必要がありません。\n\nstandardは出どころの情報を捨てるので、出どころに意味があるときはzoomが正解です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눌렀던 것과 열린 것이 **같은 것임을 모션으로 증명**하는 장치입니다. 공간적 연속성이 유지되어 “어디서 왔는지”를 설명할 필요가 없습니다.\n\nstandard는 출처 정보를 버리므로, 출처가 의미 있을 때는 zoom이 정답입니다."
          }
        }
      }
    },
    "눌렀던 것과 열린 것이 **같은 것임을 모션으로 증명**합니다. 공간적 연속성이 유지되어 “어디서 왔는지”를 설명할 필요가 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It **proves through motion that what you tapped and what opened are the same thing**. Spatial continuity is preserved, so there's no need to explain “where it came from.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップしたものと開いたものが**同じものであることをモーションで証明**します。空間的な連続性が保たれるので、「どこから来たのか」を説明する必要がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눌렀던 것과 열린 것이 **같은 것임을 모션으로 증명**합니다. 공간적 연속성이 유지되어 “어디서 왔는지”를 설명할 필요가 없습니다."
          }
        }
      }
    },
    "다 읽어도 **1** 그대로 (읽은 수 %lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still **1** after reading everything (read: %lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全部読んでも**1**のまま（既読 %lld）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 읽어도 **1** 그대로 (읽은 수 %lld)"
          }
        }
      }
    },
    "다 읽은 뒤 배지는 어떻게 됐나요? 이런 앱을 며칠 쓰면 어떤 습관이 생길까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happened to the badge after you read everything? What habit would you form after using an app like this for a few days?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全部読んだあと、バッジはどうなりましたか？こんなアプリを数日使ったら、どんな習慣が身につくでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 읽은 뒤 배지는 어떻게 됐나요? 이런 앱을 며칠 쓰면 어떤 습관이 생길까요?"
          }
        }
      }
    },
    "다 해봤어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've tried it all"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全部試しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다 해봤어요"
          }
        }
      }
    },
    "다른 말로 검색해 보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try searching for something else"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の言葉で検索してみてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 말로 검색해 보세요"
          }
        }
      }
    },
    "다른 카드도 눌러보세요. 시작점이 매번 다릅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap other cards too. The starting point is different every time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのカードもタップしてみてください。始まる位置が毎回違います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 카드도 눌러보세요. 시작점이 매번 다릅니다."
          }
        }
      }
    },
    "다른 폴더로 전환": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to another folder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のフォルダに切り替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 폴더로 전환"
          }
        }
      }
    },
    "다른 항목과 같은 그룹 안에": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the same group as other items"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの項目と同じグループの中に"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 항목과 같은 그룹 안에"
          }
        }
      }
    },
    "다시 보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度見てください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 보세요"
          }
        }
      }
    },
    "다시 볼 항목": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topics to revisit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見直すトピック"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 볼 항목"
          }
        }
      }
    },
    "다시 아래로 당기면 나타납니다. \"필요할 때만 꺼내는\" 기본 동작입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down again and it reappears. That's the default \"bring it out only when needed\" behavior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度下に引くと現れます。「必要なときだけ出す」デフォルトの動作です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 아래로 당기면 나타납니다. \"필요할 때만 꺼내는\" 기본 동작입니다."
          }
        }
      }
    },
    "다시 아래로 당기면 원래 크기로 돌아옵니다. 콘텐츠를 볼 때는 물러나고, 시작 지점에선 존재감을 갖습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down again and it returns to its original size. It steps back while you view content and has presence at the starting point."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度下に引くと元の大きさに戻ります。コンテンツを見るときは控えめになり、開始地点では存在感を持ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 아래로 당기면 원래 크기로 돌아옵니다. 콘텐츠를 볼 때는 물러나고, 시작 지점에선 존재감을 갖습니다."
          }
        }
      }
    },
    "다시 위로 올려 원래 배치로 돌아오는 것까지 확인해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also check that scrolling back up returns it to the original layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上にスクロールして元の配置に戻るところまで確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 위로 올려 원래 배치로 돌아오는 것까지 확인해 보세요."
          }
        }
      }
    },
    "다시 위로 올리면 원래대로 펼쳐집니다. 읽는 동안엔 물러나고, 이동하려 하면 돌아옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll back up and it expands again. It steps back while you read and comes back when you want to move on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度上にスクロールすると元どおり広がります。読んでいる間は控えめになり、移動しようとすると戻ってきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 위로 올리면 원래대로 펼쳐집니다. 읽는 동안엔 물러나고, 이동하려 하면 돌아옵니다."
          }
        }
      }
    },
