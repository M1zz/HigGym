            "value": "// Kriterium: Ist es richtig, dass Menschen alles in einer Kapsel als „ein Set“ lesen?\nToolbarItemGroup(placement: .topBarLeading) { viewToggle; sort }\nToolbarItem(placement: .topBarTrailing) { Menu { delete } }"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "// Critère : est-il juste que les gens lisent tout ce qui est dans une capsule comme « un seul ensemble » ?\nToolbarItemGroup(placement: .topBarLeading) { viewToggle; sort }\nToolbarItem(placement: .topBarTrailing) { Menu { delete } }"
          }
        },
