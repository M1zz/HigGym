          }
        }
      }
    },
    "복습할 문제가 없습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No questions to review"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復習する問題はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복습할 문제가 없습니다"
          }
        }
      }
    },
    "복잡한 배경에서 투명도(미학)를 포기하고 불투명 배경으로 가독성을 확보했습니다, “예쁜데 안 읽힌다”에 대한 공식 탈출구입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a busy background, it gives up translucency (aesthetics) and secures legibility with an opaque background: the official way out of “pretty but unreadable.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複雑な背景では透明感（美しさ）をあきらめ、不透明な背景で読みやすさを確保しました。「きれいだけど読めない」に対する公式の脱出口です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복잡한 배경에서 투명도(미학)를 포기하고 불투명 배경으로 가독성을 확보했습니다, “예쁜데 안 읽힌다”에 대한 공식 탈출구입니다."
          }
        }
      }
    },
    "복제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複製"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복제"
          }
        }
      }
    },
    "본문": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문"
          }
        }
      }
    },
    "본문 68개 항목의 **잘못된 예 154개**를 실수 단위로 추려 100편으로 묶었습니다. 실수마다 그때는 왜 그게 맞아 보였는지, 판단 기준이 무엇인지, 그리고 **직접 어겨볼 화면**이 붙습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We distilled the **154 bad examples** across the 68 topics in the main text into individual mistakes and bundled them into 100. Each mistake comes with why it looked right at the time, what the criterion is, and **a screen where you break the rule yourself**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文68トピックの**悪い例154個**をミス単位にまとめ、100本に仕立てました。ミスごとに、なぜそのときは正しく見えたのか、判断の基準は何か、そして**自分で破ってみる画面**が付いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문 68개 항목의 **잘못된 예 154개**를 실수 단위로 추려 100편으로 묶었습니다. 실수마다 그때는 왜 그게 맞아 보였는지, 판단 기준이 무엇인지, 그리고 **직접 어겨볼 화면**이 붙습니다."
          }
        }
      }
    },
    "본문 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show full text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文を見る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문 보기"
          }
        }
      }
    },
    "본문 상세 화면": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body detail screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の詳細画面"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문 상세 화면"
          }
        }
      }
    },
    "본문 선택·복사가 열린 쪽 ↔ 막힌 쪽입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body text selection and copy: open ↔ blocked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の選択・コピーが開いている側 ↔ ふさがれている側です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문 선택·복사가 열린 쪽 ↔ 막힌 쪽입니다."
          }
        }
      }
    },
    "본문용 서체 계약이 갱신되었습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The contract for the body typeface has been renewed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文用書体の契約が更新されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문용 서체 계약이 갱신되었습니다."
          }
        }
      }
    },
    "본문은 문장이라 잘려도 앞부분으로 뜻이 통하고, 전문은 상세 화면이 담당합니다. 목록의 목적(훑기)에 맞게 높이를 계약으로 고정한 정석입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The body is a sentence, so even truncated it makes sense from the beginning, and the detail screen carries the full text. Fixing the height by contract to suit the list's purpose (scanning) is the textbook approach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文は文章なので切り詰められても冒頭で意味が通じ、全文は詳細画面が担います。リストの目的（ざっと見ること）に合わせて高さを契約として固定した、正攻法です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문은 문장이라 잘려도 앞부분으로 뜻이 통하고, 전문은 상세 화면이 담당합니다. 목록의 목적(훑기)에 맞게 높이를 계약으로 고정한 정석입니다."
          }
        }
      }
    },
    "본문을 길게 눌러 선택·복사할 수 있게 열어 뒀다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left the body text open so it can be long-pressed to select and copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文を長押しで選択・コピーできるように開けておいた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문을 길게 눌러 선택·복사할 수 있게 열어 뒀다."
          }
        }
      }
    },
