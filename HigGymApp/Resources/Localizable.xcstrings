    "전체 화면 커버는 쓸어내려 닫히지 않는다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe down"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe down"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーは下にスワイプしても閉じない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 쓸어내려 닫히지 않는다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏覆盖不能向下轻扫关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕覆蓋不能向下輕掃關閉"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноэкранное покрытие не закрывается смахиванием вниз"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cubierta a pantalla completa no se cierra deslizando hacia abajo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vollbild-Abdeckung schließt sich nicht durch Wischen nach unten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couverture plein écran ne se ferme pas par un balayage vers le bas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copertura a schermo intero non si chiude scorrendo verso il basso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cobertura em tela cheia não fecha ao deslizar para baixo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen cover ไม่ปิดด้วยการปัดลง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen cover không đóng khi vuốt xuống"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover na celou obrazovku se nezavře přejetím dolů"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et fuldskærmsdæksel lukker ikke ved et stryg nedad"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα κάλυμμα πλήρους οθόνης δεν κλείνει με σύρσιμο προς τα κάτω"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoruudun peite ei sulkeudu pyyhkäisemällä alas"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penutup layar penuh tidak menutup dengan usapan ke bawah"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et helskjermdekke lukkes ikke med et sveip ned"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dekking op volledig scherm sluit niet met een veeg omlaag"
          }
        }
      }
    },
    "전체 화면 커버는 쓸어내려 닫히지 않는다, 출구는 직접 만들어야 한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe down, so you have to build the exit yourself"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-screen cover doesn't close with a swipe down, so you have to build the exit yourself"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーンカバーは下にスワイプしても閉じない。出口は自分でつくる必要がある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 커버는 쓸어내려 닫히지 않는다, 출구는 직접 만들어야 한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏覆盖不能向下轻扫关闭，出口要自己做"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全螢幕覆蓋不能向下輕掃關閉，出口要自己做"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноэкранное покрытие не закрывается смахиванием вниз, поэтому выход нужно сделать самому"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cubierta a pantalla completa no se cierra deslizando hacia abajo, así que tienes que construir la salida tú mismo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vollbild-Abdeckung schließt sich nicht durch Wischen nach unten, daher musst du den Ausgang selbst bauen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une couverture plein écran ne se ferme pas par un balayage vers le bas, donc vous devez construire vous-même la sortie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copertura a schermo intero non si chiude scorrendo verso il basso, quindi l'uscita devi costruirla tu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cobertura em tela cheia não fecha ao deslizar para baixo, então você mesmo precisa construir a saída"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen cover ไม่ปิดด้วยการปัดลง คุณจึงต้องสร้างทางออกเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-screen cover không đóng khi vuốt xuống, nên bạn phải tự làm lối thoát"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover na celou obrazovku se nezavře přejetím dolů, takže cestu ven musíte postavit sami"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et fuldskærmsdæksel lukker ikke ved et stryg nedad, så du må selv bygge udgangen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα κάλυμμα πλήρους οθόνης δεν κλείνει με σύρσιμο προς τα κάτω, οπότε πρέπει να φτιάξεις μόνος σου την έξοδο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoruudun peite ei sulkeudu pyyhkäisemällä alas, joten poistumistie on rakennettava itse"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penutup layar penuh tidak menutup dengan usapan ke bawah, jadi kamu harus membuat jalan keluarnya sendiri"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et helskjermdekke lukkes ikke med et sveip ned, så du må bygge utgangen selv"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dekking op volledig scherm sluit niet met een veeg omlaag, dus je moet de uitgang zelf bouwen"
          }
        }
      }
    },
    "전체 화면 커버는 일부러 스와이프로 닫히지 않으므로, 출구를 직접 만들어야 한다": {
