    "ko_KR은 **성 → 이름**, en_US는 **이름 → 성**. 순서를 앱이 정하지 않는다는 게 요지입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR is **family name → given name**, en_US is **given name → family name**. The point is that the app doesn't decide the order."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR is **family name → given name**, en_US is **given name → family name**. The point is that the app doesn't decide the order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KRは**姓 → 名**、en_USは**名 → 姓**。順序をアプリが決めないことが要点です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR은 **성 → 이름**, en_US는 **이름 → 성**. 순서를 앱이 정하지 않는다는 게 요지입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR 是**姓 → 名**，en_US 是**名 → 姓**。要点是顺序不由应用决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR 是**姓 → 名**，en_US 是**名 → 姓**。要點是順序不由應用程式決定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR - это **фамилия → имя**, en_US - **имя → фамилия**. Суть в том, что порядок не определяет приложение."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR es **apellido → nombre**, en_US es **nombre → apellido**. Lo importante es que la app no decide el orden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR ist **Familienname → Vorname**, en_US ist **Vorname → Familienname**. Der Punkt ist, dass die App die Reihenfolge nicht festlegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR est **nom de famille → prénom**, en_US est **prénom → nom de famille**. L'essentiel est que l'app ne décide pas de l'ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR è **cognome → nome**, en_US è **nome → cognome**. Il punto è che l'app non decide l'ordine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR é **sobrenome → nome**, en_US é **nome → sobrenome**. O ponto é que o app não decide a ordem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR คือ **นามสกุล → ชื่อ** ส่วน en_US คือ **ชื่อ → นามสกุล** ประเด็นคือแอปไม่ได้เป็นผู้กำหนดลำดับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR là **họ → tên**, en_US là **tên → họ**. Điểm mấu chốt là app không quyết định thứ tự."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR je **příjmení → křestní jméno**, en_US je **křestní jméno → příjmení**. Jde o to, že pořadí nerozhoduje aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR er **efternavn → fornavn**, en_US er **fornavn → efternavn**. Pointen er, at appen ikke bestemmer rækkefølgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ko_KR είναι **επώνυμο → όνομα**, το en_US είναι **όνομα → επώνυμο**. Το νόημα είναι ότι η εφαρμογή δεν αποφασίζει τη σειρά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR on **sukunimi → etunimi**, en_US on **etunimi → sukunimi**. Pointti on, ettei sovellus päätä järjestystä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR adalah **nama keluarga → nama depan**, en_US adalah **nama depan → nama keluarga**. Intinya aplikasi tidak menentukan urutannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR er **familienavn → fornavn**, en_US er **fornavn → familienavn**. Poenget er at appen ikke bestemmer rekkefølgen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ko_KR is **achternaam → voornaam**, en_US is **voornaam → achternaam**. Het punt is dat de app de volgorde niet bepaalt."
          }
        }
      }
    },
