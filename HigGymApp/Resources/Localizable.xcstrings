            "value": "มื้อค่ำวันเกิดแม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bữa tối sinh nhật mẹ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Maminčina narozeninová večeře"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mors fødselsdagsmiddag"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείπνο για τα γενέθλια της μαμάς"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äidin syntymäpäiväillallinen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Makan malam ulang tahun Ibu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Middag på morens bursdag"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verjaardagsdiner van mama"
          }
        }
      }
    },
    "엄지를 거의 움직이지 않고 닿습니다. iOS 26이 검색을 아래로 내린 이유입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your thumb reaches it with almost no movement. That's why iOS 26 moved search to the bottom."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your thumb reaches it with almost no movement. That's why iOS 26 moved search to the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "親指をほとんど動かさずに届きます。iOS 26が検索を下に移した理由です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄지를 거의 움직이지 않고 닿습니다. iOS 26이 검색을 아래로 내린 이유입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拇指几乎不用动就够得到。这就是 iOS 26 把搜索移到下方的原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拇指幾乎不用動就夠得到。這就是 iOS 26 把搜尋移到下方的原因。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большой палец достаёт почти без движения. Поэтому iOS 26 опустила поиск вниз."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pulgar llega casi sin moverse. Por eso iOS 26 llevó la búsqueda abajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Daumen erreicht es fast ohne Bewegung. Deshalb hat iOS 26 die Suche nach unten verlegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre pouce l'atteint presque sans bouger. C'est pourquoi iOS 26 a déplacé la recherche vers le bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pollice la raggiunge quasi senza muoversi. Per questo iOS 26 ha spostato la ricerca in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu polegar chega lá quase sem se mover. Por isso o iOS 26 moveu a busca para baixo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นิ้วโป้งของคุณเอื้อมถึงโดยแทบไม่ต้องขยับ นั่นคือเหตุผลที่ iOS 26 ย้ายการค้นหาลงด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngón cái bạn với tới mà gần như không phải di chuyển. Đó là lý do iOS 26 chuyển tìm kiếm xuống dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Palec k tomu dosáhne téměř bez pohybu. Proto iOS 26 přesunulo hledání dolů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din tommelfinger når den næsten uden bevægelse. Derfor flyttede iOS 26 søgningen ned."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αντίχειράς σου το φτάνει σχεδόν χωρίς κίνηση. Γι' αυτό το iOS 26 μετέφερε την αναζήτηση κάτω."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peukalosi yltää siihen lähes ilman liikettä. Siksi iOS 26 siirsi haun alas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibu jarimu menjangkaunya nyaris tanpa bergerak. Itulah mengapa iOS 26 memindahkan pencarian ke bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tommelen din når den med nesten ingen bevegelse. Derfor flyttet iOS 26 søk til bunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je duim bereikt het met bijna geen beweging. Daarom verplaatste iOS 26 zoeken naar de onderkant."
          }
        }
      }
    },
    "엄지에 가까운 자리라 자주 쓰는 액션을 둡니다, 1.1.4와 같은 근거(8.1.2)입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's close to the thumb, so frequent actions go here: the same basis as 1.1.4 (8.1.2)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's close to the thumb, so frequent actions go here: the same basis as 1.1.4 (8.1.2)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "親指に近い場所なので、よく使うアクションを置きます。1.1.4と同じ根拠（8.1.2）です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엄지에 가까운 자리라 자주 쓰는 액션을 둡니다, 1.1.4와 같은 근거(8.1.2)입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠近拇指的位置，所以放常用操作，与 1.1.4 的依据相同（8.1.2）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靠近拇指的位置，所以放常用操作，與 1.1.4 的依據相同（8.1.2）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это рядом с большим пальцем, поэтому сюда ставят частые действия: то же основание, что у 1.1.4 (8.1.2)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está cerca del pulgar, así que las acciones frecuentes van aquí: la misma base que 1.1.4 (8.1.2)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es liegt nahe am Daumen, daher gehören häufige Aktionen hierher: dieselbe Grundlage wie 1.1.4 (8.1.2)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est près du pouce, donc les actions fréquentes vont ici : même fondement que 1.1.4 (8.1.2)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È vicino al pollice, quindi le azioni frequenti vanno qui: stessa base di 1.1.4 (8.1.2)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica perto do polegar, então as ações frequentes vão aqui: a mesma base de 1.1.4 (8.1.2)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยู่ใกล้นิ้วโป้ง การกระทำที่ใช้บ่อยจึงมาอยู่ที่นี่: หลักการเดียวกับ 1.1.4 (8.1.2)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó gần ngón cái, nên các hành động thường xuyên đặt ở đây: cùng cơ sở với 1.1.4 (8.1.2)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je blízko palce, takže sem patří časté akce: stejný základ jako 1.1.4 (8.1.2)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er tæt på tommelfingeren, så hyppige handlinger hører til her: samme grundlag som 1.1.4 (8.1.2)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι κοντά στον αντίχειρα, οπότε οι συχνές ενέργειες πάνε εδώ: ίδια βάση με το 1.1.4 (8.1.2)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on lähellä peukaloa, joten usein toistuvat toiminnot kuuluvat tänne: sama peruste kuin kohdassa 1.1.4 (8.1.2)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekat dengan ibu jari, jadi aksi yang sering dipakai ditaruh di sini: dasar yang sama dengan 1.1.4 (8.1.2)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er nær tommelen, så hyppige handlinger hører hjemme her: samme begrunnelse som 1.1.4 (8.1.2)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het zit dicht bij de duim, dus frequente acties gaan hier: dezelfde basis als 1.1.4 (8.1.2)."
          }
        }
      }
    },
