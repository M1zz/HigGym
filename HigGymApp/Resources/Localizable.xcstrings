        }
      }
    },
    "스크롤해도 검색바가 **사라지지 않습니다**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The search bar **doesn't disappear**, even when you scroll."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The search bar **doesn't disappear**, even when you scroll."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールしても検索バーが**消えません**。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤해도 검색바가 **사라지지 않습니다**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动时搜索栏**不会消失**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動時搜尋列**不會消失**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка поиска **не исчезает**, даже когда вы прокручиваете."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de búsqueda **no desaparece**, aunque te desplaces."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suchleiste **verschwindet nicht**, auch wenn du scrollst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre de recherche **ne disparaît pas**, même quand vous faites défiler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra di ricerca **non scompare**, anche quando scorri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de busca **não desaparece**, mesmo quando você rola."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบค้นหา**ไม่หายไป** แม้คุณเลื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tìm kiếm **không biến mất**, kể cả khi bạn cuộn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledávací pole **nezmizí**, ani když posouváte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Søgelinjen **forsvinder ikke**, selv når du scroller."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή αναζήτησης **δεν εξαφανίζεται**, ακόμα και όταν κυλάς."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakupalkki **ei katoa** vieritettäessäkään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah pencarian **tidak menghilang**, bahkan saat kamu menggulir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Søkefeltet **forsvinner ikke**, selv når du ruller."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De zoekbalk **verdwijnt niet**, ook niet als je scrolt."
          }
        }
      }
    },
    "스크롤해도 이 바는 접히지 않습니다. 대형 제목과의 차이를 1.2.1과 비교해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bar doesn't collapse when you scroll. Compare the difference from a large title with 1.2.1."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This bar doesn't collapse when you scroll. Compare the difference from a large title with 1.2.1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールしてもこのバーは折りたたまれません。大きいタイトルとの違いを1.2.1と比べてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤해도 이 바는 접히지 않습니다. 대형 제목과의 차이를 1.2.1과 비교해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动时这个栏也不会折叠。请与 1.2.1 对比它和大标题的差别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動時這個列也不會摺疊。請與 1.2.1 對比它和大標題的差別。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта панель не сворачивается при прокрутке. Сравните её отличие от крупного заголовка в 1.2.1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta barra no se colapsa al desplazar. Compara la diferencia con un título grande en 1.2.1."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Leiste klappt beim Scrollen nicht zusammen. Vergleiche den Unterschied zu einem großen Titel mit 1.2.1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette barre ne se replie pas au défilement. Comparez la différence avec un grand titre en 1.2.1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa barra non si comprime quando scorri. Confronta la differenza con un titolo grande in 1.2.1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta barra não recolhe quando você rola. Compare a diferença com um título grande em 1.2.1."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบนี้ไม่ยุบเมื่อเลื่อน เปรียบเทียบความต่างจากชื่อเรื่องขนาดใหญ่ใน 1.2.1"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh này không thu gọn khi bạn cuộn. So sánh sự khác biệt với tiêu đề lớn ở 1.2.1."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento panel se při posouvání nesbalí. Porovnejte rozdíl proti velkému nadpisu v 1.2.1."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne bjælke klapper ikke sammen, når du scroller. Sammenlign forskellen fra en stor titel med 1.2.1."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η γραμμή δεν συμπτύσσεται όταν κυλάς. Σύγκρινε τη διαφορά από έναν μεγάλο τίτλο με το 1.2.1."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä palkki ei tiivisty vieritettäessä. Vertaa eroa suureen otsikkoon kohdassa 1.2.1."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah ini tidak menciut saat digulir. Bandingkan perbedaannya dengan judul besar di 1.2.1."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne linjen kollapser ikke når du ruller. Sammenlign forskjellen fra en stor tittel med 1.2.1."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze balk klapt niet in als je scrolt. Vergelijk het verschil met een grote titel in 1.2.1."
          }
        }
      }
    },
    "스크롤해도 제목이 변하지 않습니다, 처음부터 가장 작은 형태입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title doesn't change when you scroll: it's in its smallest form from the start."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The title doesn't change when you scroll: it's in its smallest form from the start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールしてもタイトルは変わりません。最初からいちばん小さい形です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤해도 제목이 변하지 않습니다, 처음부터 가장 작은 형태입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动时标题不变，从一开始就是最小的形态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動時標題不變，從一開始就是最小的形態。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок при прокрутке не меняется: с самого начала он в самой маленькой форме."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título no cambia al desplazar: está desde el principio en su forma más pequeña."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel ändert sich beim Scrollen nicht: Er ist von Anfang an in seiner kleinsten Form."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre ne change pas au défilement : il est dans sa plus petite forme dès le départ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo non cambia quando scorri: è nella sua forma più piccola fin dall'inizio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título não muda quando você rola: está na menor forma desde o início."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องไม่เปลี่ยนเมื่อเลื่อน: มันอยู่ในรูปที่เล็กที่สุดตั้งแต่ต้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề không đổi khi bạn cuộn: nó ở dạng nhỏ nhất ngay từ đầu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadpis se při posouvání nemění: od začátku je v nejmenší podobě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlen ændrer sig ikke, når du scroller: den er i sin mindste form fra start."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο τίτλος δεν αλλάζει όταν κυλάς: είναι στη μικρότερη μορφή του από την αρχή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsikko ei muutu vieritettäessä: se on alusta asti pienimmässä muodossaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul tidak berubah saat digulir: ia dalam bentuk terkecilnya sejak awal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tittelen endres ikke når du ruller: den er i sin minste form fra starten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De titel verandert niet als je scrolt: hij staat vanaf het begin in zijn kleinste vorm."
          }
        }
      }
    },
    "스크롤해서 카드가 상단 바 아래로 들어가는 순간을 보세요, 경계 없이 **번지듯** 사라집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll and watch the moment a card slides under the top bar: it fades away **like a blur**, with no hard edge."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll and watch the moment a card slides under the top bar: it fades away **like a blur**, with no hard edge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールして、カードが上部のバーの下に入る瞬間を見てください。境界なしに**にじむように**消えていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤해서 카드가 상단 바 아래로 들어가는 순간을 보세요, 경계 없이 **번지듯** 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动一下，观察卡片进入顶部栏下方的瞬间：它没有边界，而是**晕开般**消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動一下，觀察卡片進入頂部列下方的瞬間：它沒有邊界，而是**暈開般**消失。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите и посмотрите на момент, когда карточка уходит под верхнюю панель: она исчезает **как размытие**, без жёсткой границы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate y observa el momento en que una tarjeta se desliza bajo la barra superior: se desvanece **como un desenfoque**, sin borde duro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle und beobachte den Moment, in dem eine Karte unter die obere Leiste gleitet: Sie blendet **wie ein Weichzeichner** aus, ohne harte Kante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler et observez le moment où une carte glisse sous la barre du haut : elle s'estompe **comme un flou**, sans bord net."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri e osserva il momento in cui una scheda scivola sotto la barra in alto: svanisce **come una sfocatura**, senza bordo netto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role e observe o instante em que um cartão desliza sob a barra superior: ele esmaece **como um desfoque**, sem borda dura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนแล้วดูจังหวะที่การ์ดเลื่อนเข้าใต้แถบด้านบน: มันจางหายไป**เหมือนเบลอ** โดยไม่มีขอบแข็ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộn và xem khoảnh khắc một thẻ trượt xuống dưới thanh trên: nó mờ dần **như bị làm nhòe**, không có cạnh cứng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posouvejte a sledujte okamžik, kdy karta klouže pod horním panelem: mizí **jako rozmazání**, bez ostrého okraje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll og se det øjeblik, et kort glider under den øverste bjælke: det toner ud **som en sløring**, uden hård kant."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κύλισε και πρόσεξε τη στιγμή που μια κάρτα γλιστρά κάτω από την πάνω γραμμή: σβήνει **σαν θόλωμα**, χωρίς σκληρή άκρη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieritä ja katso hetkeä, jolloin kortti liukuu yläpalkin alle: se häipyy **kuin sumennus**, ilman teräviä reunoja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gulir dan perhatikan saat kartu meluncur di bawah bilah atas: ia memudar **seperti kabur**, tanpa tepi keras."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rull og se øyeblikket et kort glir under den øvre linjen: det tones bort **som en uskarphet**, uten hard kant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll en kijk naar het moment dat een kaart onder de bovenbalk schuift: hij vervaagt **als een blur**, zonder harde rand."
          }
        }
      }
    },
    "스크롤해서 콘텐츠가 두 바 사이에서만 움직이는지 확인해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll and check that the content moves only between the two bars."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll and check that the content moves only between the two bars."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールして、コンテンツが2つのバーのあいだだけで動くか確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤해서 콘텐츠가 두 바 사이에서만 움직이는지 확인해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动一下，确认内容是否只在两个栏之间移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動一下，確認內容是否只在兩個列之間移動。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите и проверьте, что контент движется только между двумя панелями."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate y comprueba que el contenido se mueve solo entre las dos barras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle und prüfe, dass sich der Inhalt nur zwischen den beiden Leisten bewegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler et vérifiez que le contenu ne se déplace qu'entre les deux barres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri e verifica che il contenuto si muova solo tra le due barre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role e confira se o conteúdo se move só entre as duas barras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนแล้วตรวจว่าเนื้อหาเคลื่อนเฉพาะระหว่างสองแถบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộn và kiểm tra nội dung chỉ chuyển động giữa hai thanh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte a ověřte, že se obsah pohybuje jen mezi oběma panely."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll og tjek, at indholdet kun bevæger sig mellem de to bjælker."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κύλισε και έλεγξε ότι το περιεχόμενο κινείται μόνο ανάμεσα στις δύο γραμμές."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieritä ja tarkista, että sisältö liikkuu vain kahden palkin välissä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gulir dan periksa bahwa konten hanya bergerak di antara kedua bilah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rull og sjekk at innholdet bare beveger seg mellom de to linjene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll en controleer dat de inhoud alleen tussen de twee balken beweegt."
          }
        }
      }
    },
