          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermen bak · Trykk på kortene (%lld trykk)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scherm erachter · Tik op de kaarten (%lld tikken)"
          }
        }
      }
