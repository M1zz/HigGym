          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "// Critère : l'action est-elle attachée à sa cible ?\n.swipeActions { Button(\"Supprimer\", role: .destructive) { … } }\n.contextMenu { … }"
          }
