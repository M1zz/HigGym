          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun arvo ja sen muoto laitetaan samaan merkkijonoon, sovellus päätyy omistamaan kieliasetuksen säännöt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menaruh nilai dan formatnya dalam satu string berarti aplikasi akhirnya memiliki aturan locale"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å legge verdien og formatet i én streng betyr at appen ender opp med å eie locale-reglene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De waarde en het formaat in één string zetten betekent dat de app uiteindelijk de regels van de locale bezit"
          }
        }
      }
    },
    "값과 표기를 한 문자열에 담지 않는 것, 값은 앱이, 표기는 로케일이 정합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't put the value and its format in one string. The app decides the value, the locale decides the format."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't put the value and its format in one string. The app decides the value, the locale decides the format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値と表記をひとつの文字列に入れないこと。値はアプリが、表記はロケールが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값과 표기를 한 문자열에 담지 않는 것, 값은 앱이, 표기는 로케일이 정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把数值和写法装进同一个字符串：数值由应用决定，写法由区域设置决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把數值和寫法裝進同一個字串：數值由應用程式決定，寫法由區域設定決定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не кладите значение и запись в одну строку. Значение определяет приложение, запись определяет регион."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pongas el valor y su formato en una sola cadena. La app decide el valor, la configuración regional decide el formato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Packe den Wert und sein Format nicht in eine Zeichenfolge. Die App bestimmt den Wert, die Region bestimmt das Format."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mettez pas la valeur et son format dans une seule chaîne. L'app décide de la valeur, la région décide du format."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non mettere il valore e il suo formato in una sola stringa. L'app decide il valore, la regione decide il formato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não coloque o valor e seu formato numa só string. O app decide o valor, a região decide o formato."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าใส่ค่าและรูปแบบไว้ในสตริงเดียว แอปตัดสินค่า ส่วนภาษาและภูมิภาคตัดสินรูปแบบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng đặt giá trị và định dạng của nó vào một chuỗi. App quyết định giá trị, ngôn ngữ và vùng quyết định định dạng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávejte hodnotu a její formát do jednoho řetězce. Aplikace rozhoduje o hodnotě, lokalita o formátu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg ikke værdien og dens format i én streng. Appen bestemmer værdien, landestandarden bestemmer formatet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μη βάζεις την τιμή και τη μορφή της σε μία συμβολοσειρά. Η εφαρμογή αποφασίζει την τιμή, η γλώσσα και περιοχή αποφασίζει τη μορφή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä laita arvoa ja sen muotoa samaan merkkijonoon. Sovellus päättää arvon, kieliasetus päättää muodon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan taruh nilai dan formatnya dalam satu string. Aplikasi menentukan nilainya, locale menentukan formatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke legg verdien og formatet i én streng. Appen bestemmer verdien, locale bestemmer formatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de waarde en het formaat niet in één string. De app beslist de waarde, de locale beslist het formaat."
          }
        }
      }
    },
    "값과 표기를 한 문자열에 담지 않는다, **이 두 화면은 영어(en_US) 기기**입니다. 어느 쪽이 로케일을 따라갑니까?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't put the value and its format in one string. **Both of these screens are on an English (en_US) device.** Which one follows the locale?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't put the value and its format in one string. **Both of these screens are on an English (en_US) device.** Which one follows the locale?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値と表記をひとつの文字列に入れない。**この2つの画面は英語（en_US）のデバイスです**。どちらがロケールに従っていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값과 표기를 한 문자열에 담지 않는다, **이 두 화면은 영어(en_US) 기기**입니다. 어느 쪽이 로케일을 따라갑니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把数值和写法装进同一个字符串，**这两个界面是英语（en_US）设备**。哪一个跟随了区域设置？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把數值和寫法裝進同一個字串，**這兩個介面是英語（en_US）裝置**。哪一個跟隨了區域設定？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не кладите значение и запись в одну строку. **Оба эти экрана работают на устройстве с английским (en_US).** Какой из них следует региону?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pongas el valor y su formato en una sola cadena. **Estas dos pantallas están en un dispositivo en inglés (en_US).** ¿Cuál sigue la configuración regional?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Packe den Wert und sein Format nicht in eine Zeichenfolge. **Beide Bildschirme laufen auf einem englischen Gerät (en_US).** Welcher folgt der Region?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne mettez pas la valeur et son format dans une seule chaîne. **Ces deux écrans sont sur un appareil en anglais (en_US).** Lequel suit la région ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non mettere il valore e il suo formato in una sola stringa. **Entrambe queste schermate sono su un dispositivo in inglese (en_US).** Quale segue la regione?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não coloque o valor e seu formato numa só string. **Ambas as telas estão num dispositivo em inglês (en_US).** Qual delas segue a região?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าใส่ค่าและรูปแบบไว้ในสตริงเดียว **หน้าจอทั้งสองนี้อยู่บนอุปกรณ์ภาษาอังกฤษ (en_US)** อันไหนทำตามภาษาและภูมิภาค"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng đặt giá trị và định dạng của nó vào một chuỗi. **Cả hai màn hình này đều trên thiết bị tiếng Anh (en_US).** Cái nào theo ngôn ngữ và vùng?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedávejte hodnotu a její formát do jednoho řetězce. **Obě tyto obrazovky jsou na anglickém zařízení (en_US).** Která se řídí lokalitou?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg ikke værdien og dens format i én streng. **Begge disse skærme er på en engelsk (en_US) enhed.** Hvilken følger landestandarden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μη βάζεις την τιμή και τη μορφή της σε μία συμβολοσειρά. **Και οι δύο αυτές οθόνες βρίσκονται σε αγγλική (en_US) συσκευή.** Ποια ακολουθεί τη γλώσσα και περιοχή;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älä laita arvoa ja sen muotoa samaan merkkijonoon. **Molemmat näkymät ovat englanninkielisellä (en_US) laitteella.** Kumpi noudattaa kieliasetusta?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan taruh nilai dan formatnya dalam satu string. **Kedua layar ini ada di perangkat berbahasa Inggris (en_US).** Mana yang mengikuti locale?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke legg verdien og formatet i én streng. **Begge disse skjermene er på en engelsk (en_US) enhet.** Hvilken følger locale?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de waarde en het formaat niet in één string. **Beide schermen staan op een Engels (en_US) apparaat.** Welke volgt de locale?"
          }
        }
      }
    },
    "값만 들고 있다가 로케일에 맞춰 표기를 시스템에 맡깁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It holds only the value and lets the system format it for the locale."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It holds only the value and lets the system format it for the locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値だけを持ち、ロケールに合わせた表記はシステムに任せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값만 들고 있다가 로케일에 맞춰 표기를 시스템에 맡깁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只保存数值，写法按区域设置交给系统。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只儲存數值，寫法按區域設定交給系統。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранит только значение и поручает системе оформить запись под регион."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda solo el valor y deja que el sistema lo formatee según la configuración regional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er hält nur den Wert und lässt das System ihn für die Region formatieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne garde que la valeur et laisse le système la formater selon la région."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene solo il valore e lascia che sia il sistema a formattarlo per la regione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda só o valor e deixa o sistema formatá-lo para a região."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บแค่ค่า และให้ระบบจัดรูปแบบตามภาษาและภูมิภาค"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó chỉ giữ giá trị và để hệ thống định dạng theo ngôn ngữ và vùng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drží jen hodnotu a formátování pro lokalitu nechává na systému."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den rummer kun værdien og lader systemet formatere den efter landestandarden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατά μόνο την τιμή και αφήνει το σύστημα να τη μορφοποιήσει για τη γλώσσα και περιοχή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pitää sisällään vain arvon ja antaa järjestelmän muotoilla sen kieliasetuksen mukaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia hanya menyimpan nilai dan membiarkan sistem memformatnya sesuai locale."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den holder bare verdien og lar systemet formatere den for locale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bevat alleen de waarde en laat het systeem het opmaken voor de locale."
          }
        }
      }
    },
    "값에 따라 화면 전체가 바뀌므로 “화면의 정체성”, principal 자리의 문법과 일치합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole screen changes with the value, so it's “the screen's identity,” which matches the grammar of the principal position."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole screen changes with the value, so it's “the screen's identity,” which matches the grammar of the principal position."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値によって画面全体が変わるので「画面のアイデンティティ」であり、principalの位置の文法と一致します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값에 따라 화면 전체가 바뀌므로 “화면의 정체성”, principal 자리의 문법과 일치합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面整体随数值而变，所以是“界面身份”，与 principal 位置的语法一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "介面整體隨數值而變，所以是「介面身份」，與 principal 位置的語法一致。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь экран меняется вместе со значением, поэтому это «идентичность экрана», что совпадает с грамматикой места principal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la pantalla cambia con el valor, así que es «la identidad de la pantalla», lo que coincide con la gramática de la posición principal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ganze Bildschirm ändert sich mit dem Wert, also ist er „die Identität des Bildschirms“, was genau zur Grammatik der principal-Position passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout l'écran change avec la valeur, c'est donc « l'identité de l'écran », ce qui correspond à la grammaire de la position principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intera schermata cambia con il valore, quindi è «l'identità della schermata», il che corrisponde alla grammatica della posizione principal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela inteira muda com o valor, então é «a identidade da tela», o que combina com a gramática da posição principal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทั้งหน้าจอเปลี่ยนไปตามค่า จึงเป็น “ตัวตนของหน้าจอ” ซึ่งตรงกับไวยากรณ์ของตำแหน่ง principal"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ màn hình thay đổi theo giá trị, nên đó là “danh tính màn hình”, khớp với ngữ pháp của vị trí principal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celá obrazovka se mění s hodnotou, takže jde o „identitu obrazovky“, což odpovídá gramatice umístění principal."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele skærmen ændrer sig med værdien, så det er »skærmens identitet«, som matcher principal-placeringens grammatik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολόκληρη η οθόνη αλλάζει με την τιμή, οπότε είναι «η ταυτότητα της οθόνης», που ταιριάζει με τη γραμματική της θέσης principal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko näkymä muuttuu arvon mukana, joten se on ”näkymän identiteetti”, mikä vastaa principal-paikan kielioppia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seluruh layar berubah mengikuti nilainya, jadi ini \"identitas layar\", yang cocok dengan tata bahasa posisi principal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele skjermen endres med verdien, så det er «skjermens identitet», som matcher grammatikken til principal-plasseringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het hele scherm verandert met de waarde, dus het is \"de identiteit van het scherm\", wat past bij de grammatica van de principal-positie."
          }
        }
      }
    },
    "값은 앱이, 표기는 로케일이": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app owns the value, the locale owns the format"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The app owns the value, the locale owns the format"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はアプリが、表記はロケールが"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 앱이, 표기는 로케일이"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值归应用，写法归区域设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值歸應用程式，寫法歸區域設定"
          }
        },
        "ru": {
