            "value": "large (default)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "large（標準）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "large(기본)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "large（默认）"
          }
        },
        "zh-Hant": {
