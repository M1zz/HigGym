      }
    },
    "파일 경로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File path"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルパス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 경로"
          }
        }
      }
    },
    "파일 경로 `/Users/leeo/Documents/…/report.pdf` 를 한 줄에 표시할 때 truncation은?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How should truncation work when showing the file path `/Users/leeo/Documents/…/report.pdf` on one line?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルパス `/Users/leeo/Documents/…/report.pdf` を1行で表示するとき、truncation はどうしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 경로 `/Users/leeo/Documents/…/report.pdf` 를 한 줄에 표시할 때 truncation은?"
          }
        }
      }
    },
    "파일 경로에서는 middle이 이깁니다, 앞(위치)과 뒤(파일명) 둘 다 살아남기 때문입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For file paths, middle wins, because both the start (location) and the end (file name) survive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルパスでは middle が勝ちます。先頭（場所）と末尾（ファイル名）の両方が残るからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 경로에서는 middle이 이깁니다, 앞(위치)과 뒤(파일명) 둘 다 살아남기 때문입니다."
          }
        }
      }
    },
    "파일 하나의 **⋯ 메뉴를 열고 이름 변경**을 눌러보세요. 메뉴를 읽지 말고 빠르게 눌러보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the **⋯ menu on a file and tap Rename**. Don't read the menu, just tap quickly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの⋯**メニューを開いて「名前を変更**」を押してみてください。メニューを読まずに素早く押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 하나의 **⋯ 메뉴를 열고 이름 변경**을 눌러보세요. 메뉴를 읽지 말고 빠르게 눌러보세요."
          }
        }
      }
    },
    "판단 기준": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Criterion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判断基準"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판단 기준"
          }
        }
      }
    },
    "판단 기준은 취향이 아니라 \"이 배경에서 위의 글자가 읽히는가\"입니다(8.1.4).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The test isn't taste; it's \"can the text on top be read against this background?\" (8.1.4)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判断基準は好みではなく、「この背景の上で文字が読めるか」です（8.1.4）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판단 기준은 취향이 아니라 \"이 배경에서 위의 글자가 읽히는가\"입니다(8.1.4)."
          }
        }
      }
    },
    "판단은 서지만 근거가 흔들립니다. 아래 항목의 본문을 다시 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your judgment holds, but your reasoning is shaky. Reread the topic below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判断は合っていますが、根拠が揺らいでいます。下のトピックの本文をもう一度読んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판단은 서지만 근거가 흔들립니다. 아래 항목의 본문을 다시 보세요."
          }
        }
      }
    },
    "판별": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Judgment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判別"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판별"
          }
        }
      }
    },
    "판정 근거": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basis for the verdict"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判定の根拠"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판정 근거"
          }
        }
      }
    },
    "편의를 준 게 아니라 불일치를 허용한 것이 된다. 사용자는 시트에 적힌 금액을 보고 결제했는데 청구는 다른 금액으로 된다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't convenience; it's allowing a mismatch. The user paid after seeing the amount on the sheet, but gets charged a different amount."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "便利にしたのではなく、不一致を許したことになる。ユーザーはシートに書かれた金額を見て支払ったのに、請求は別の金額になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편의를 준 게 아니라 불일치를 허용한 것이 된다. 사용자는 시트에 적힌 금액을 보고 결제했는데 청구는 다른 금액으로 된다."
          }
        }
      }
    },
    "편집": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집"
          }
        }
      }
    },
    "편집 모드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集モード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 모드"
          }
        }
      }
    },
    "편집 완료": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done editing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集完了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 완료"
          }
        }
      }
    },
    "편집 중에는 같은 자리가 **완료**로 바뀝니다. 자리는 그대로, 역할만 이어집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While editing, the same spot becomes **Done**. The place stays; only the role carries on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中は同じ位置が**完了**に変わります。位置はそのまま、役割だけが引き継がれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 중에는 같은 자리가 **완료**로 바뀝니다. 자리는 그대로, 역할만 이어집니다."
          }
        }
      }
    },
    "편집기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기"
          }
        }
      }
    },
    "편집기에 취소·완료가 있는 쪽 ↔ 출구가 없는 쪽입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An editor with Cancel and Done ↔ one with no way out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタにキャンセルと完了がある側 ↔ 出口がない側です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기에 취소·완료가 있는 쪽 ↔ 출구가 없는 쪽입니다."
          }
        }
      }
    },
    "포맷터가 이미 모든 로케일을 알고 있습니다. 두 벌을 만들 이유가 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The formatter already knows every locale. There's no reason to build two versions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマッタはすでにすべてのロケールを知っています。2通り作る理由はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포맷터가 이미 모든 로케일을 알고 있습니다. 두 벌을 만들 이유가 없습니다."
          }
        }
      }
    },
    "폭 %lldpt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Width %lldpt"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅 %lldpt"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭 %lldpt"
          }
        }
      }
    },
    "폭 %lldpt · Dynamic Type %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "폭 %1$lldpt · Dynamic Type %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Width %lldpt · Dynamic Type %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅 %lldpt・Dynamic Type %@"
          }
        }
      }
    },
    "폭을 줄여보세요, 자르는 대신 **글자가 작아집니다**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it narrower: instead of truncating, **the text gets smaller**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅を狭めてみてください。切り詰める代わりに**文字が小さくなります**。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭을 줄여보세요, 자르는 대신 **글자가 작아집니다**."
          }
        }
      }
    },
    "폭이 모자라면 뒤쪽부터 접힌다, 무엇을 앞에 뒀는가의 문제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When space runs short, items fold from the end. It's about what you put first"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅が足りなければ後ろから折りたたまれる。何を前に置いたかの問題"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭이 모자라면 뒤쪽부터 접힌다, 무엇을 앞에 뒀는가의 문제"
          }
        }
      }
    },
    "폭이 모자라면 시스템은 **뒤쪽부터** ⋯ 안으로 접는다. 그러니 코드에 적는 순서가 곧 우선순위 선언이다. 접기를 막을 게 아니라 무엇이 접혀도 되는지를 정하는 일이다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When width runs short, the system folds items into ⋯ **from the end**. So the order you write them in code is your declaration of priority. The job isn't to prevent folding; it's to decide what can be folded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅が足りないと、システムは**後ろから** ⋯ の中へ折りたたむ。だからコードに書く順番がそのまま優先順位の宣言になる。折りたたみを防ぐのではなく、何が折りたたまれてもいいかを決める作業だ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폭이 모자라면 시스템은 **뒤쪽부터** ⋯ 안으로 접는다. 그러니 코드에 적는 순서가 곧 우선순위 선언이다. 접기를 막을 게 아니라 무엇이 접혀도 되는지를 정하는 일이다."
          }
        }
      }
    },
    "폰트를 더 좁은 것으로 바꾼다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a narrower font"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より幅の狭いフォントに変える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폰트를 더 좁은 것으로 바꾼다"
          }
        }
      }
    },
    "폴더": {
      "localizations": {
