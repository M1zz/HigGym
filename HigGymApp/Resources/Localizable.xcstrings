    "soft는 콘텐츠를 부드럽게 흐리는 대신 대비 확보력이 약합니다. 사진 위라면 hard 또는 두꺼운 material 쪽이 안전합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "soft blurs content gently but is weaker at securing contrast. Over photos, hard or a thicker material is the safer choice."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "soft blurs content gently but is weaker at securing contrast. Over photos, hard or a thicker material is the safer choice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "softはコンテンツをやわらかくぼかす代わりに、コントラストを確保する力が弱くなります。写真の上なら、hardか厚めのmaterialのほうが安全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "soft는 콘텐츠를 부드럽게 흐리는 대신 대비 확보력이 약합니다. 사진 위라면 hard 또는 두꺼운 material 쪽이 안전합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "soft 会把内容柔和地模糊，但保证对比度的能力较弱。在照片上，用 hard 或厚 material 更稳妥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "soft 會把內容柔和地模糊，但保證對比度的能力較弱。在照片上，用 hard 或厚 material 更穩妥。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "soft мягко размывает контент, но слабее обеспечивает контраст. Над фотографиями надёжнее hard или более толстый материал."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "soft difumina el contenido con suavidad, pero asegura peor el contraste. Sobre fotos, hard o un material más grueso es la opción más segura."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "soft verwischt Inhalte sanft, sichert aber den Kontrast schlechter. Über Fotos ist hard oder ein dickeres Material die sicherere Wahl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "soft floute le contenu en douceur mais sécurise moins bien le contraste. Sur des photos, hard ou un matériau plus épais est le choix le plus sûr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "soft sfoca il contenuto con delicatezza ma garantisce meno il contrasto. Sulle foto, hard o un materiale più spesso è la scelta più sicura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "soft desfoca o conteúdo suavemente, mas garante menos contraste. Sobre fotos, hard ou um material mais grosso é a escolha mais segura."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "soft เบลอเนื้อหาอย่างนุ่มนวล แต่รักษาความตัดกันได้อ่อนกว่า บนรูปถ่าย hard หรือวัสดุที่หนากว่าปลอดภัยกว่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "soft làm mờ nội dung nhẹ nhàng nhưng đảm bảo độ tương phản yếu hơn. Trên ảnh, hard hoặc vật liệu dày hơn là lựa chọn an toàn hơn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "soft obsah jemně rozmaže, ale hůře zajišťuje kontrast. Na fotkách je bezpečnější volbou hard nebo tlustší materiál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "soft slører indhold blidt, men er svagere til at sikre kontrast. Over fotos er hard eller et tykkere materiale det sikrere valg."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το soft θολώνει το περιεχόμενο απαλά αλλά είναι πιο αδύναμο στην εξασφάλιση αντίθεσης. Πάνω σε φωτογραφίες, το hard ή ένα παχύτερο υλικό είναι η ασφαλέστερη επιλογή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "soft sumentaa sisältöä pehmeästi, mutta kontrastin varmistamisessa se on heikompi. Valokuvien päällä hard tai paksumpi materiaali on turvallisempi valinta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "soft mengaburkan konten dengan lembut tetapi lebih lemah dalam menjamin kontras. Di atas foto, hard atau material yang lebih tebal adalah pilihan yang lebih aman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "soft gjør innholdet mykt uskarpt, men er svakere til å sikre kontrast. Over bilder er hard eller et tykkere material det tryggere valget."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "soft vervaagt inhoud zacht, maar is zwakker in het veiligstellen van contrast. Over foto's is hard of een dikker materiaal de veiligere keuze."
          }
        }
      }
    },
