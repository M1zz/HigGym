    },
    "// 기준: 이 UI 요소를 지웠을 때 사용자가 못 하게 되는 일이 있는가?\n// 없다면 지운다.": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: If you removed this UI element, is there anything people could no longer do?\n// If not, remove it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: If you removed this UI element, is there anything people could no longer do?\n// If not, remove it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "// 基準：このUI要素を消したとき、ユーザーができなくなることはあるか？\n// なければ消す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "// 기준: 이 UI 요소를 지웠을 때 사용자가 못 하게 되는 일이 있는가?\n// 없다면 지운다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "// 标准：删掉这个界面元素后，用户会有做不了的事吗？\n// 没有的话就删掉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "// 標準：刪掉這個介面元素後，使用者會有做不了的事嗎？\n// 沒有的話就刪掉。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "// Критерий: если убрать этот элемент интерфейса, потеряет ли пользователь возможность что-то сделать?\n// Если нет, удаляем."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterio: Si quitaras este elemento de la interfaz, ¿habría algo que la gente ya no pudiera hacer?\n// Si no, quítalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriterium: Wenn du dieses UI-Element entferntest, könnten Menschen dann etwas nicht mehr tun?\n// Wenn nicht, entferne es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "// Critère : si vous retiriez cet élément d'interface, y a-t-il quelque chose que les gens ne pourraient plus faire ?\n// Sinon, retirez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterio: se togliessi questo elemento dell'interfaccia, ci sarebbe qualcosa che le persone non potrebbero più fare?\n// In caso contrario, toglilo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "// Critério: se você removesse este elemento da interface, haveria algo que as pessoas não poderiam mais fazer?\n// Se não, remova."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "// เกณฑ์: ถ้าเอา UI นี้ออก มีอะไรที่คนทำไม่ได้อีกหรือไม่\n// ถ้าไม่มี ให้เอาออก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "// Tiêu chí: Nếu bỏ phần tử UI này đi, có việc gì người ta không còn làm được không?\n// Nếu không, hãy bỏ nó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kritérium: Kdybyste tento prvek UI odstranili, existuje něco, co by lidé už nemohli udělat?\n// Pokud ne, odstraňte ho."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriterium: Hvis du fjernede dette UI-element, er der så noget, folk ikke længere kunne gøre?\n// Hvis ikke, så fjern det."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "// Κριτήριο: Αν αφαιρούσες αυτό το στοιχείο διεπαφής, θα υπήρχε κάτι που οι άνθρωποι δεν θα μπορούσαν πια να κάνουν;\n// Αν όχι, αφαίρεσέ το."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriteeri: Jos tämä käyttöliittymän elementti poistettaisiin, jäisikö jokin ihmisiltä tekemättä?\n// Jos ei, poista se."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriteria: Jika elemen UI ini dihapus, adakah yang tidak bisa lagi dilakukan orang?\n// Jika tidak ada, hapus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriterium: Hvis du fjernet dette UI-elementet, er det noe folk ikke lenger kunne gjøre?\n// Hvis ikke, fjern det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterium: Als je dit UI-element weghaalde, is er dan iets dat mensen niet meer zouden kunnen doen?\n// Zo niet, haal het weg."
          }
        }
      }
    },
    "// 기준: 이 액션을 하루에 몇 번 누르는가?\n// 자주 누를수록 아래로.\nToolbarItem(placement: .bottomBar) { ComposeButton() }": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: How many times a day is this action tapped?\n// The more often, the lower it goes.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: How many times a day is this action tapped?\n// The more often, the lower it goes.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "// 基準：このアクションを1日に何回押すか？\n// よく押すものほど下へ。\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "// 기준: 이 액션을 하루에 몇 번 누르는가?\n// 자주 누를수록 아래로.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "// 标准：这个操作一天会点几次？\n// 点得越频繁，越要往下放。\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "// 標準：這個操作一天會點幾次？\n// 點得越頻繁，越要往下放。\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "// Критерий: сколько раз в день нажимают это действие?\n// Чем чаще, тем ниже.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterio: ¿Cuántas veces al día se toca esta acción?\n// Cuanto más a menudo, más abajo va.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriterium: Wie oft am Tag wird diese Aktion angetippt?\n// Je öfter, desto weiter unten.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "// Critère : combien de fois par jour cette action est-elle touchée ?\n// Plus c'est souvent, plus elle descend.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterio: quante volte al giorno viene toccata questa azione?\n// Più spesso, più in basso.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "// Critério: quantas vezes por dia esta ação é tocada?\n// Quanto mais vezes, mais para baixo ela vai.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "// เกณฑ์: การกระทำนี้ถูกแตะวันละกี่ครั้ง\n// ยิ่งบ่อย ยิ่งอยู่ต่ำ\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "// Tiêu chí: Hành động này được chạm bao nhiêu lần một ngày?\n// Càng thường xuyên, càng nằm thấp.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kritérium: Kolikrát denně se tato akce klepne?\n// Čím častěji, tím níž leží.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriterium: Hvor mange gange om dagen trykkes der på denne handling?\n// Jo oftere, jo lavere ligger den.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "// Κριτήριο: Πόσες φορές την ημέρα πατιέται αυτή η ενέργεια;\n// Όσο πιο συχνά, τόσο πιο χαμηλά πηγαίνει.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriteeri: Kuinka monta kertaa päivässä tätä toimintoa napautetaan?\n// Mitä useammin, sitä alemmas.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriteria: Berapa kali sehari aksi ini diketuk?\n// Semakin sering, semakin rendah letaknya.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriterium: Hvor mange ganger om dagen trykkes denne handlingen?\n// Jo oftere, desto lavere havner den.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterium: Hoe vaak per dag wordt op deze actie getikt?\n// Hoe vaker, hoe lager hij komt.\nToolbarItem(placement: .bottomBar) { ComposeButton() }"
          }
        }
      }
    },
    "// 기준: 최악의 배경에서도 컨트롤이 읽히는가?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: Can the controls be read even against the worst background?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: Can the controls be read even against the worst background?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "// 基準：最悪の背景でもコントロールが読めるか？\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "// 기준: 최악의 배경에서도 컨트롤이 읽히는가?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "// 标准：在最糟糕的背景上，控件还读得清吗？\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "// 標準：在最糟糕的背景上，控制元件還讀得清嗎？\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "// Критерий: читается ли элемент управления на худшем фоне?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterio: ¿Se pueden leer los controles incluso sobre el peor fondo?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriterium: Lassen sich die Steuerelemente selbst vor dem schlechtesten Hintergrund lesen?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "// Critère : les contrôles restent-ils lisibles même sur le pire arrière-plan ?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterio: i controlli restano leggibili anche sullo sfondo peggiore?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "// Critério: os controles podem ser lidos mesmo sobre o pior fundo?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "// เกณฑ์: ตัวควบคุมยังอ่านออกแม้บนพื้นหลังที่แย่ที่สุดหรือไม่\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "// Tiêu chí: Các điều khiển có đọc được ngay cả trên nền tệ nhất không?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kritérium: Dají se ovládací prvky přečíst i na nejhorším pozadí?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriterium: Kan kontrollerne læses, selv mod den værste baggrund?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "// Κριτήριο: Διαβάζονται οι έλεγχοι ακόμα και πάνω στο χειρότερο φόντο;\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriteeri: Voiko säätimet lukea pahimmallakin taustalla?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriteria: Apakah kontrol bisa dibaca bahkan pada latar terburuk?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriterium: Kan kontrollene leses selv mot den verste bakgrunnen?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterium: Zijn de bedieningselementen te lezen, zelfs tegen de slechtste achtergrond?\n.scrollEdgeEffectStyle(.hard, for: .top)\n.toolbarBackground(.thickMaterial, for: .navigationBar)"
          }
        }
      }
    },
    "// 선언 순서 = 우선순위. 폭이 모자라면 뒤쪽부터 ⋯ 로 접힌다.\n// 이렇게 했다\nForEach([별표, 깃발, 프린트, 이동, 저장]) { … }\n// 이렇게 고쳤다\nForEach([저장, 이동, 별표, 깃발, 프린트]) { … }": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "// Declaration order = priority. When width runs out, items fold into ⋯ from the end.\n// Before\nForEach([star, flag, print, move, save]) { … }\n// After\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "// Declaration order = priority. When width runs out, items fold into ⋯ from the end.\n// Before\nForEach([star, flag, print, move, save]) { … }\n// After\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "// 宣言の順序 = 優先順位。幅が足りないと、後ろから ⋯ に折りたたまれる。\n// 修正前\nForEach([star, flag, print, move, save]) { … }\n// 修正後\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "// 선언 순서 = 우선순위. 폭이 모자라면 뒤쪽부터 ⋯ 로 접힌다.\n// 이렇게 했다\nForEach([별표, 깃발, 프린트, 이동, 저장]) { … }\n// 이렇게 고쳤다\nForEach([저장, 이동, 별표, 깃발, 프린트]) { … }"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "// 声明顺序 = 优先级。宽度不够时，从后面开始折叠进 ⋯。\n// 原来的做法\nForEach([星标, 旗标, 打印, 移动, 存储]) { … }\n// 改后的做法\nForEach([存储, 移动, 星标, 旗标, 打印]) { … }"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "// 宣告順序 = 優先順序。寬度不夠時，從後面開始摺疊進 ⋯。\n// 原來的做法\nForEach([星標, 旗標, 列印, 移動, 儲存]) { … }\n// 改後的做法\nForEach([儲存, 移動, 星標, 旗標, 列印]) { … }"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "// Порядок объявления = приоритет. Если ширины не хватает, элементы с конца сворачиваются в ⋯.\n// Как сделали\nForEach([звезда, флажок, печать, перенос, сохранить]) { … }\n// Как исправили\nForEach([сохранить, перенос, звезда, флажок, печать]) { … }"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "// El orden de declaración = la prioridad. Cuando se acaba el ancho, los elementos se pliegan en ⋯ desde el final.\n// Antes\nForEach([star, flag, print, move, save]) { … }\n// Después\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "// Deklarationsreihenfolge = Priorität. Wenn die Breite ausgeht, falten sich Elemente vom Ende her in ⋯.\n// Vorher\nForEach([star, flag, print, move, save]) { … }\n// Nachher\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "// Ordre de déclaration = priorité. Quand la largeur manque, les éléments se replient dans ⋯ à partir de la fin.\n// Avant\nForEach([star, flag, print, move, save]) { … }\n// Après\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "// Ordine di dichiarazione = priorità. Quando la larghezza finisce, gli elementi si ripiegano in ⋯ dalla fine.\n// Prima\nForEach([star, flag, print, move, save]) { … }\n// Dopo\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "// Ordem de declaração = prioridade. Quando a largura acaba, os itens dobram para ⋯ a partir do fim.\n// Antes\nForEach([star, flag, print, move, save]) { … }\n// Depois\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "// ลำดับการประกาศ = ลำดับความสำคัญ เมื่อความกว้างไม่พอ รายการจะพับเข้า ⋯ จากท้าย\n// ก่อน\nForEach([star, flag, print, move, save]) { … }\n// หลัง\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "// Thứ tự khai báo = mức ưu tiên. Khi hết chiều rộng, các mục gập vào ⋯ từ cuối.\n// Trước\nForEach([star, flag, print, move, save]) { … }\n// Sau\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "// Pořadí deklarace = priorita. Když dojde šířka, položky se od konce skládají do ⋯.\n// Před\nForEach([star, flag, print, move, save]) { … }\n// Po\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "// Deklarationsrækkefølge = prioritet. Når bredden slipper op, folder elementer sig ind i ⋯ fra enden.\n// Før\nForEach([star, flag, print, move, save]) { … }\n// Efter\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "// Σειρά δήλωσης = προτεραιότητα. Όταν τελειώνει το πλάτος, τα στοιχεία διπλώνουν στο ⋯ από το τέλος.\n// Πριν\nForEach([star, flag, print, move, save]) { … }\n// Μετά\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "// Ilmoitusjärjestys = prioriteetti. Kun leveys loppuu, kohteet taittuvat ⋯ -valikkoon lopusta alkaen.\n// Ennen\nForEach([star, flag, print, move, save]) { … }\n// Jälkeen\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "// Urutan deklarasi = prioritas. Saat lebar habis, item terlipat ke ⋯ dari belakang.\n// Sebelum\nForEach([star, flag, print, move, save]) { … }\n// Sesudah\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "// Deklarasjonsrekkefølge = prioritet. Når bredden tar slutt, folder elementer seg inn i ⋯ fra slutten.\n// Før\nForEach([star, flag, print, move, save]) { … }\n// Etter\nForEach([save, move, star, flag, print]) { … }"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "// Declaratievolgorde = prioriteit. Als de breedte op is, klappen items van achteren in ⋯.\n// Voor\nForEach([star, flag, print, move, save]) { … }\n// Na\nForEach([save, move, star, flag, print]) { … }"
          }
        }
      }
    },
