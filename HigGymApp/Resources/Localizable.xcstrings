    "너비를 wide · abbreviated · narrow로 바꿔가며 같은 값의 표기 차이를 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the width between wide · abbreviated · narrow to see how the same value is written differently."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the width between wide · abbreviated · narrow to see how the same value is written differently."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幅をwide · abbreviated · narrowと切り替えながら、同じ値の表記の違いを見てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너비를 wide · abbreviated · narrow로 바꿔가며 같은 값의 표기 차이를 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把宽度在 wide · abbreviated · narrow 之间切换，观察同一个值在写法上的差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把寬度在 wide · abbreviated · narrow 之間切換，觀察同一個值在寫法上的差異。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключайте ширину между wide · abbreviated · narrow, чтобы увидеть, как по-разному записывается одно и то же значение."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el ancho entre wide · abbreviated · narrow para ver cómo se escribe el mismo valor de forma distinta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle die Breite zwischen wide · abbreviated · narrow, um zu sehen, wie derselbe Wert unterschiedlich geschrieben wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternez la largeur entre wide · abbreviated · narrow pour voir comment la même valeur s'écrit différemment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna la larghezza tra wide · abbreviated · narrow per vedere come lo stesso valore viene scritto in modo diverso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne a largura entre wide · abbreviated · narrow para ver como o mesmo valor é escrito de formas diferentes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับความกว้างระหว่าง wide · abbreviated · narrow เพื่อดูว่าค่าเดียวกันเขียนต่างกันอย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển độ rộng giữa wide · abbreviated · narrow để xem cùng một giá trị được viết khác nhau thế nào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínejte šířku mezi wide · abbreviated · narrow a uvidíte, jak se stejná hodnota zapisuje jinak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift bredden mellem wide · abbreviated · narrow for at se, hvordan den samme værdi skrives forskelligt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε το πλάτος μεταξύ wide · abbreviated · narrow για να δεις πώς γράφεται διαφορετικά η ίδια τιμή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda leveyttä wide · abbreviated · narrow välillä nähdäksesi, miten sama arvo kirjoitetaan eri tavoin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti lebar antara wide · abbreviated · narrow untuk melihat bagaimana nilai yang sama ditulis secara berbeda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt bredden mellom wide · abbreviated · narrow for å se hvordan samme verdi skrives ulikt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel de breedte tussen wide · abbreviated · narrow om te zien hoe dezelfde waarde anders wordt geschreven."
          }
        }
      }
    },
    "넘치는 아이템을 overflow 메뉴(⋯)로 접는다": {
      "localizations": {
