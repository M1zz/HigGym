    "탭바 대신 상단 searchable을 쓴다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use searchable at the top instead of a tab bar"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use searchable at the top instead of a tab bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブバーの代わりに上部の searchable を使う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭바 대신 상단 searchable을 쓴다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
