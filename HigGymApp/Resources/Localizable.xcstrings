    "스타일을 abbreviated로 바꾸면 이니셜만 남습니다. 아바타에 쓰는 그 값입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the style to abbreviated and only the initials remain. That's the value you use for avatars."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the style to abbreviated and only the initials remain. That's the value you use for avatars."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイルをabbreviatedに変えると、イニシャルだけが残ります。アバターに使うのはこの値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스타일을 abbreviated로 바꾸면 이니셜만 남습니다. 아바타에 쓰는 그 값입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把样式改成 abbreviated，就只剩下首字母。就是头像上用的那个值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把樣式改成 abbreviated，就只剩下首字母。就是頭像上用的那個值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключите стиль на abbreviated, и останутся только инициалы. Это значение вы используете для аватаров."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el estilo a abbreviated y solo quedan las iniciales. Ese es el valor que usas para los avatares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle den Stil auf abbreviated, und nur die Initialen bleiben. Das ist der Wert, den du für Avatare verwendest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez le style sur abbreviated et il ne reste que les initiales. C'est la valeur à utiliser pour les avatars."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa lo stile ad abbreviato e restano solo le iniziali. È il valore che usi per gli avatar."
          }
        }
      }
    },
