    "같은 기능을 오른쪽 버튼으로 뺐다면, 화면 정체와 액션이 따로 놀았을 겁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the same feature had been pulled out into a button on the right, the screen's identity and the action would have drifted apart."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If the same feature had been pulled out into a button on the right, the screen's identity and the action would have drifted apart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ機能を右側のボタンに分けていたら、画面のアイデンティティとアクションがばらばらになっていたでしょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 기능을 오른쪽 버튼으로 뺐다면, 화면 정체와 액션이 따로 놀았을 겁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果把同样的功能挪到右边的按钮，界面身份和操作就会各行其是。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果把同樣的功能挪到右邊的按鈕，介面身份和操作就會各行其是。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если бы ту же функцию вынесли в кнопку справа, идентичность экрана и действие разошлись бы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la misma función se hubiera sacado a un botón a la derecha, la identidad de la pantalla y la acción se habrían separado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wäre dieselbe Funktion in einen Button rechts ausgelagert worden, hätten sich die Identität des Bildschirms und die Aktion voneinander entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la même fonction avait été sortie dans un bouton à droite, l'identité de l'écran et l'action se seraient éloignées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la stessa funzione fosse stata portata fuori in un pulsante a destra, l'identità della schermata e l'azione si sarebbero allontanate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a mesma funcionalidade tivesse sido extraída para um botão à direita, a identidade da tela e a ação teriam se afastado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าฟีเจอร์เดียวกันถูกดึงออกมาเป็นปุ่มทางขวา ตัวตนของหน้าจอกับการกระทำก็จะห่างกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu cùng tính năng đó được kéo ra thành một nút bên phải, danh tính màn hình và hành động đã tách xa nhau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdyby byla stejná funkce vytažena do tlačítka vpravo, identita obrazovky a akce by se od sebe vzdálily."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis den samme funktion var trukket ud i en knap til højre, ville skærmens identitet og handlingen være drevet fra hinanden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν η ίδια λειτουργία είχε τραβηχτεί σε ένα κουμπί στα δεξιά, η ταυτότητα της οθόνης και η ενέργεια θα είχαν απομακρυνθεί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sama ominaisuus olisi vedetty oikealla olevaan painikkeeseen, näkymän identiteetti ja toiminto olisivat ajautuneet erilleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika fitur yang sama ditarik keluar menjadi tombol di kanan, identitas layar dan aksinya akan menjauh satu sama lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis samme funksjon hadde vært trukket ut til en knapp til høyre, ville skjermens identitet og handlingen drevet fra hverandre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dezelfde functie naar een knop rechts was gehaald, waren de identiteit van het scherm en de actie uit elkaar gedreven."
          }
        }
      }
    },
    "같은 뷰를 `overlay`로 얹었다면 첫 항목이 그 밑에 깔렸을 겁니다. 그 차이가 이 API의 전부입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the same view had been layered on with `overlay`, the first item would have ended up underneath it. That difference is the whole point of this API."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If the same view had been layered on with `overlay`, the first item would have ended up underneath it. That difference is the whole point of this API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じビューを`overlay`で重ねていたら、最初の項目がその下に隠れていたでしょう。その違いがこのAPIのすべてです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 뷰를 `overlay`로 얹었다면 첫 항목이 그 밑에 깔렸을 겁니다. 그 차이가 이 API의 전부입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果用 `overlay` 叠上同样的视图，第一项就会被压在下面。这个差别就是这个 API 的全部。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果用 `overlay` 疊上同樣的檢視，第一項就會被壓在下面。這個差別就是這個 API 的全部。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если бы то же представление наложили через `overlay`, первый элемент оказался бы под ним. В этом различии и состоит суть этого API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la misma vista se hubiera superpuesto con `overlay`, el primer elemento habría acabado debajo. Esa diferencia es todo el sentido de esta API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wäre dieselbe Ansicht mit `overlay` darübergelegt worden, wäre das erste Element darunter gelandet. Dieser Unterschied ist der ganze Sinn dieser API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la même vue avait été superposée avec `overlay`, le premier élément aurait fini dessous. Cette différence est tout l'intérêt de cette API."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la stessa vista fosse stata sovrapposta con `overlay`, il primo elemento sarebbe finito sotto. Quella differenza è tutto il senso di questa API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a mesma view tivesse sido sobreposta com `overlay`, o primeiro item teria ficado por baixo dela. Essa diferença é todo o sentido desta API."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้า view เดียวกันถูกซ้อนด้วย `overlay` รายการแรกจะไปอยู่ใต้มัน ความต่างนั้นคือประเด็นทั้งหมดของ API นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu cùng view đó được chồng lên bằng `overlay`, mục đầu tiên đã nằm bên dưới nó. Sự khác biệt đó là toàn bộ ý nghĩa của API này."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdyby byl stejný view nasazen pomocí `overlay`, první položka by skončila pod ním. Tento rozdíl je celý smysl tohoto API."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det samme view var lagt på med `overlay`, ville det første element være endt under det. Den forskel er hele pointen med dette API."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν η ίδια προβολή είχε στρωθεί με `overlay`, το πρώτο στοιχείο θα είχε καταλήξει από κάτω της. Αυτή η διαφορά είναι όλο το νόημα αυτού του API."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos sama näkymä olisi lisätty `overlay`-tavalla, ensimmäinen kohde olisi jäänyt sen alle. Tuo ero on koko tämän API:n pointti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika tampilan yang sama ditumpuk dengan `overlay`, item pertama akan berakhir di bawahnya. Perbedaan itulah inti dari API ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis samme visning hadde vært lagt oppå med `overlay`, ville det første elementet endt opp under den. Den forskjellen er hele poenget med dette API-et."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dezelfde weergave met `overlay` erbovenop was gelegd, was het eerste item eronder terechtgekomen. Dat verschil is het hele punt van deze API."
          }
        }
      }
    },
    "같은 액션이 오른쪽 위에 있었다면 한 손으로 몇 번이나 눌렀을지 상상해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine how many times you'd have stretched with one hand if the same action were in the top right."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine how many times you'd have stretched with one hand if the same action were in the top right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じアクションが右上にあったら、片手で何度手を伸ばしていたか想像してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 액션이 오른쪽 위에 있었다면 한 손으로 몇 번이나 눌렀을지 상상해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想象一下，如果同样的操作放在右上角，单手要点多少次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想象一下，如果同樣的操作放在右上角，單手要點多少次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представьте, сколько раз вам пришлось бы тянуться одной рукой, если бы то же действие стояло справа вверху."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagina cuántas veces te habrías estirado con una sola mano si la misma acción estuviera arriba a la derecha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell dir vor, wie oft du dich mit einer Hand gestreckt hättest, wenn dieselbe Aktion oben rechts wäre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginez combien de fois vous vous seriez étiré d'une seule main si la même action était en haut à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagina quante volte ti saresti allungato con una mano se la stessa azione fosse in alto a destra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine quantas vezes você teria se esticado com uma mão se a mesma ação estivesse no canto superior direito."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองนึกว่าคุณต้องเอื้อมด้วยมือเดียวกี่ครั้ง ถ้าการกระทำเดียวกันอยู่มุมขวาบน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tưởng tượng bạn phải với tay bao nhiêu lần bằng một tay nếu cùng hành động đó nằm ở trên cùng bên phải."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Představte si, kolikrát byste se natahovali jednou rukou, kdyby byla stejná akce vpravo nahoře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forestil dig, hvor mange gange du ville have strakt dig med én hånd, hvis den samme handling sad øverst til højre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φαντάσου πόσες φορές θα είχες τεντωθεί με το ένα χέρι αν η ίδια ενέργεια ήταν πάνω δεξιά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvittele, kuinka monta kertaa olisit kurottanut yhdellä kädellä, jos sama toiminto olisi oikeassa yläkulmassa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayangkan berapa kali kamu harus meregang dengan satu tangan jika aksi yang sama ada di kanan atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenk deg hvor mange ganger du ville strukket deg med én hånd hvis samme handling lå øverst til høyre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je voor hoe vaak je met één hand had moeten reiken als dezelfde actie rechtsboven stond."
          }
        }
      }
    },
    "같은 캡슐에 있으면 사용자는 **한 세트**로 읽습니다. 묶음 자체가 의미라서, 성격이 다른 것을 넣으면 묶음이 거짓 정보가 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When things share a capsule, people read them as **one set**. The grouping itself carries meaning, so putting something of a different kind inside turns the group into false information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When things share a capsule, people read them as **one set**. The grouping itself carries meaning, so putting something of a different kind inside turns the group into false information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じカプセルに入っていると、ユーザーは**ひとつのセット**として読みます。まとまり自体が意味を持つので、性質の違うものを入れると、まとまりが嘘の情報になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 캡슐에 있으면 사용자는 **한 세트**로 읽습니다. 묶음 자체가 의미라서, 성격이 다른 것을 넣으면 묶음이 거짓 정보가 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一个胶囊里，用户会把它们读作**一组**。分组本身就是含义，所以放进性质不同的东西，分组就成了假信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一個膠囊裡，使用者會把它們讀作**一組**。分組本身就是含義，所以放進性質不同的東西，分組就成了假資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если элементы в одной капсуле, люди читают их как **один набор**. Сама группировка несёт смысл, поэтому если положить внутрь что-то иного рода, группа становится ложной информацией."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando varias cosas comparten una cápsula, la gente las lee como **un conjunto**. La propia agrupación tiene significado, así que meter dentro algo de otro tipo convierte el grupo en información falsa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Dinge sich eine Kapsel teilen, lesen Menschen sie als **ein Set**. Die Gruppierung selbst trägt Bedeutung, daher macht es die Gruppe zu falscher Information, wenn man etwas Andersartiges hineinsetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand des éléments partagent une capsule, les gens les lisent comme **un seul ensemble**. Le regroupement porte lui-même du sens, donc y mettre quelque chose d'un autre type fait du groupe une fausse information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando delle cose condividono una capsula, le persone le leggono come **un solo insieme**. Il raggruppamento stesso porta significato, quindi metterci dentro qualcosa di diverso trasforma il gruppo in un'informazione falsa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando as coisas dividem uma cápsula, as pessoas as leem como **um só conjunto**. O próprio agrupamento carrega significado, então colocar algo de outro tipo ali dentro transforma o grupo em informação falsa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อหลายอย่างอยู่ในแคปซูลเดียวกัน คนจะอ่านว่าเป็น**ชุดเดียว** การจัดกลุ่มเองมีความหมาย ดังนั้นการใส่ของต่างชนิดเข้าไปจึงทำให้กลุ่มกลายเป็นข้อมูลเท็จ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi các thứ dùng chung một capsule, người ta đọc chúng như **một bộ**. Bản thân việc nhóm mang ý nghĩa, nên đặt thứ khác loại vào trong biến nhóm thành thông tin sai."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když věci sdílejí kapsli, lidé je čtou jako **jednu sadu**. Samo seskupení nese význam, takže vložení něčeho jiného druhu dovnitř dělá ze skupiny nepravdivou informaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når ting deler en kapsel, læser folk dem som **ét sæt**. Selve grupperingen bærer betydning, så en anden slags ting derinde gør gruppen til falsk information."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν κάποια πράγματα μοιράζονται μια κάψουλα, οι άνθρωποι τα διαβάζουν ως **ένα σύνολο**. Η ίδια η ομαδοποίηση φέρει νόημα, οπότε το να βάλεις μέσα κάτι διαφορετικού είδους κάνει την ομάδα ψευδή πληροφορία."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun asiat jakavat kapselin, ihmiset lukevat ne **yhdeksi kokonaisuudeksi**. Ryhmittelyllä itsellään on merkitys, joten erilaisen asian laittaminen sisään tekee ryhmästä väärää tietoa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketika beberapa hal berbagi kapsul, orang membacanya sebagai **satu set**. Pengelompokan itu sendiri membawa makna, jadi menaruh sesuatu yang berbeda jenis di dalamnya mengubah grup menjadi informasi palsu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når ting deler en kapsel, leser folk dem som **ett sett**. Selve grupperingen bærer mening, så å putte noe av en annen art inni gjør gruppen til falsk informasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dingen een capsule delen, lezen mensen ze als **één set**. De groepering zelf draagt betekenis, dus iets van een andere soort erin zetten maakt van de groep valse informatie."
          }
        }
      }
    },
    "개수": {
      "localizations": {
