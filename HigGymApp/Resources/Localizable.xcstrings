          }
        }
      }
    },
    "접근성 점검": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility check"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの点検"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근성 점검"
          }
        }
      }
    },
    "접근성 최대": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Largest accessibility size"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ最大"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근성 최대"
          }
        }
      }
    },
    "접근성 최대 글씨에서 내용이 잘립니다. 기본 크기에서만 확인하고 넘어가면 이 상태가 그대로 출시됩니다, 검증 기준은 가장 나쁜 조건입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the largest accessibility text size, content gets cut off. If you only check at the default size and move on, it ships exactly like this. Test against the worst case."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの最大の文字サイズで内容が切れます。標準サイズだけ確認して進むと、この状態のままリリースされます。検証の基準は最悪の条件です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근성 최대 글씨에서 내용이 잘립니다. 기본 크기에서만 확인하고 넘어가면 이 상태가 그대로 출시됩니다, 검증 기준은 가장 나쁜 조건입니다."
          }
        }
      }
    },
    "접근성 큰 글씨 설정을 켠 상태입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility large text is turned on"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティの大きな文字をオンにした状態です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근성 큰 글씨 설정을 켠 상태입니다"
          }
        }
      }
    },
    "접기는 시스템이 최소 터치 크기를 지키는 방식입니다. 막을 게 아니라 **순서를 설계**하면 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folding is how the system keeps minimum touch sizes. Don't block it, just **design the order**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみは、システムが最小タップサイズを守るための方法です。止めるのではなく**順番を設計**すればよいのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접기는 시스템이 최소 터치 크기를 지키는 방식입니다. 막을 게 아니라 **순서를 설계**하면 됩니다."
          }
        }
      }
    },
    "접히는 순서는 선언 순서를 따릅니다, 자주 쓰는 것을 앞에 둬야 하는 이유입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items fold in declaration order, which is why frequently used ones should go first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれる順番は宣言順に従います。よく使うものを前に置くべき理由です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접히는 순서는 선언 순서를 따릅니다, 자주 쓰는 것을 앞에 둬야 하는 이유입니다."
          }
        }
      }
    },
    "접힌 상태에서 검색을 눌러보세요. 읽는 중에도 검색만은 한 손에 닿습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Search while it's collapsed. Even while reading, Search stays within one-handed reach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれた状態で検索をタップしてみてください。読んでいる間も、検索だけは片手で届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힌 상태에서 검색을 눌러보세요. 읽는 중에도 검색만은 한 손에 닿습니다."
          }
        }
      }
    },
    "접힌 상태에서도 재생·일시정지는 그대로 눌립니다. 기능을 잃지 않고 자리만 줄입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when collapsed, play and pause still work. It takes up less room without losing any function."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれた状態でも、再生・一時停止はそのまま押せます。機能を失わずに場所だけを小さくします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힌 상태에서도 재생·일시정지는 그대로 눌립니다. 기능을 잃지 않고 자리만 줄입니다."
          }
        }
      }
    },
    "접힌 상태에서도 탭은 그대로 눌립니다. 사라지는 게 아니라 **작아지는** 것입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even when collapsed, the tabs still respond. They don't disappear, they **get smaller**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれた状態でも、タブはそのまま押せます。消えるのではなく**小さくなる**のです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힌 상태에서도 탭은 그대로 눌립니다. 사라지는 게 아니라 **작아지는** 것입니다."
          }
        }
      }
    },
    "접힐 때 액세서리가 사라지지 않고 **탭바 자리로 승격**됩니다, “이동 < 상태”라는 우선순위 역전을 시스템이 자동 처리합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it collapses, the accessory doesn't disappear. It's **promoted into the tab bar's spot**, and the system handles the priority flip (“navigation < status”) for you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたまれるとき、アクセサリは消えずに**タブバーの位置へ昇格**します。「移動 < 状態」という優先順位の逆転をシステムが自動で処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접힐 때 액세서리가 사라지지 않고 **탭바 자리로 승격**됩니다, “이동 < 상태”라는 우선순위 역전을 시스템이 자동 처리합니다."
          }
        }
      }
    },
    "정답": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正解"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정답"
          }
        }
      }
    },
    "정답은 취향이 아니라 **무엇이 식별에 쓰이는가**입니다. 경로는 끝(파일명)이, 제목은 앞이 결정적입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer isn't taste but **what's used to identify it**. For a path, the end (the file name) matters; for a title, the beginning does."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正解は好みではなく、**何が識別に使われるか**です。パスは末尾（ファイル名）が、タイトルは先頭が決め手です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정답은 취향이 아니라 **무엇이 식별에 쓰이는가**입니다. 경로는 끝(파일명)이, 제목은 앞이 결정적입니다."
          }
        }
      }
    },
    "정답을 맞히는 칸이 아닙니다. 방금 손으로 겪은 것을 그대로 적으면 됩니다. **아무 이상 없었다면 그렇게 적어도 됩니다**, 못 느끼고 지나가는 것이 어디인지가 다음 단계에서 더 중요해집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a box for getting the right answer. Just write what you just experienced with your hands. **If nothing felt off, you can write that too.** Where you pass by without noticing matters more in the next step."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正解を当てる欄ではありません。いま手で体験したことをそのまま書けば大丈夫です。**何も違和感がなかったなら、そう書いてもかまいません**。気づかずに通り過ぎる場所がどこなのかが、次のステップでより重要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정답을 맞히는 칸이 아닙니다. 방금 손으로 겪은 것을 그대로 적으면 됩니다. **아무 이상 없었다면 그렇게 적어도 됩니다**, 못 느끼고 지나가는 것이 어디인지가 다음 단계에서 더 중요해집니다."
          }
        }
      }
    },
    "정답입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正解です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정답입니다"
          }
        }
      }
    },
    "정렬": {
      "localizations": {
