    "현재 위치 표시. 이게 있어야 깊이 들어가도 “나는 이 탭 안에 있다”는 맥락이 유지됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows where you are. This is what keeps the context \"I'm inside this tab\" even when you go deep."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows where you are. This is what keeps the context \"I'm inside this tab\" even when you go deep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在地の表示。これがあるから、深く入っても「自分はこのタブの中にいる」という文脈が保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치 표시. 이게 있어야 깊이 들어가도 “나는 이 탭 안에 있다”는 맥락이 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示当前位置。有了它，即使深入其中，“我在这个标签里”的上下文也能保持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示當前位置。有了它，即使深入其中，「我在這個標籤裡」的上下文也能保持。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает, где вы находитесь. Именно это сохраняет контекст «я внутри этой вкладки», даже когда вы заходите глубоко."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra dónde estás. Esto es lo que mantiene el contexto «estoy dentro de esta pestaña» incluso cuando entras en profundidad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, wo du bist. Das hält den Kontext „Ich bin in diesem Tab“ aufrecht, selbst wenn du tief hineingehst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montre où vous êtes. C'est ce qui maintient le contexte « je suis dans cet onglet » même quand vous allez en profondeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra dove sei. È ciò che mantiene il contesto «sono dentro questa scheda» anche quando vai in profondità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra onde você está. É o que mantém o contexto «estou dentro desta aba» mesmo quando você vai fundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงว่าคุณอยู่ที่ไหน นี่คือสิ่งที่รักษาบริบท \"ฉันอยู่ในแท็บนี้\" แม้คุณลงลึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị bạn đang ở đâu. Đây là thứ giữ bối cảnh \"tôi đang ở trong tab này\" ngay cả khi bạn đi sâu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukazuje, kde jste. To je to, co drží kontext „jsem uvnitř této karty“, i když jdete hluboko."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser, hvor du er. Det er det, der bevarer konteksten »jeg er inde i denne fane«, selv når du går dybt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείχνει πού βρίσκεσαι. Αυτό κρατά το πλαίσιο «είμαι μέσα σε αυτή την καρτέλα» ακόμα και όταν πας βαθιά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää, missä olet. Tämä pitää yllä kontekstin ”olen tämän välilehden sisällä” myös syvälle mentäessä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan di mana kamu berada. Inilah yang menjaga konteks \"aku di dalam tab ini\" bahkan saat kamu masuk dalam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser hvor du er. Dette er det som bevarer konteksten «jeg er inne i denne fanen» selv når du går dypt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont waar je bent. Dit houdt de context \"ik zit in dit tabblad\" in stand, ook als je diep gaat."
          }
        }
      }
    },
