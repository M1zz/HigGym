          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周崩溃率 0.12%，比上周改善 0.04 个百分点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週崩潰率 0.12%，比上週改善 0.04 個百分點。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доля сбоев на этой неделе: 0,12 %, на 0,04 п. п. лучше, чем на прошлой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasa de fallos esta semana: 0,12 %, 0,04 puntos menos que la semana pasada."
          }
        },
        "de": {
