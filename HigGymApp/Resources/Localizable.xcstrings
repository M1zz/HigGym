    "바와 콘텐츠의 경계를 또렷이 나눕니다, 표·폼처럼 구조가 중요한 화면에 맞습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draws a crisp line between bar and content, which suits structured screens like tables and forms."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Draws a crisp line between bar and content, which suits structured screens like tables and forms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーとコンテンツの境界をくっきり分けます。表やフォームのように構造が大切な画面に向いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바와 콘텐츠의 경계를 또렷이 나눕니다, 표·폼처럼 구조가 중요한 화면에 맞습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把栏和内容的边界划分得很清楚，适合表格、表单这类结构重要的界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把列和內容的邊界劃分得很清楚，適合表格、表單這類結構重要的介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проводит чёткую линию между панелью и контентом, что подходит структурным экранам вроде таблиц и форм."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traza una línea nítida entre la barra y el contenido, lo que va bien a pantallas estructuradas como tablas y formularios."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieht eine scharfe Linie zwischen Leiste und Inhalt, was zu strukturierten Bildschirmen wie Tabellen und Formularen passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace une ligne nette entre la barre et le contenu, ce qui convient aux écrans structurés comme les tableaux et les formulaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia una linea netta tra barra e contenuto, il che si addice a schermate strutturate come tabelle e moduli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traça uma linha nítida entre a barra e o conteúdo, o que combina com telas estruturadas como tabelas e formulários."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาดเส้นคมชัดระหว่างแถบกับเนื้อหา เหมาะกับหน้าจอมีโครงสร้างอย่างตารางและฟอร์ม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ một đường sắc nét giữa thanh và nội dung, phù hợp với các màn hình có cấu trúc như bảng và biểu mẫu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakreslí ostrou čáru mezi panelem a obsahem, což se hodí na strukturované obrazovky jako tabulky a formuláře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegner en skarp linje mellem bjælke og indhold, hvilket passer til strukturerede skærme som tabeller og formularer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σχεδιάζει μια καθαρή γραμμή ανάμεσα στη γραμμή και το περιεχόμενο, κάτι που ταιριάζει σε δομημένες οθόνες όπως πίνακες και φόρμες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirtää terävän viivan palkin ja sisällön väliin, mikä sopii jäsennellyille näkymille, kuten taulukoille ja lomakkeille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggambar garis tajam antara bilah dan konten, yang cocok untuk layar terstruktur seperti tabel dan formulir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegner en skarp linje mellom linje og innhold, som passer for strukturerte skjermer som tabeller og skjemaer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekent een scherpe lijn tussen balk en inhoud, wat past bij gestructureerde schermen zoals tabellen en formulieren."
          }
        }
      }
    },
