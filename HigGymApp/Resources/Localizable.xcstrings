    "최악의 배경에서 컨트롤이 읽히는지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether controls are readable on the worst background"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether controls are readable on the worst background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最悪の背景でもコントロールが読めるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최악의 배경에서 컨트롤이 읽히는지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最糟糕的背景上，控件还读得清吗"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最糟糕的背景上，控制元件還讀得清嗎"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
