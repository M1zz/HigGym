          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ampliar la barra de herramientas a dos filas"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Symbolleiste auf zwei Zeilen erweitern"
          }
        },
        "fr": {
          "stringUnit": {
