    "다른 카드도 눌러보세요. 시작점이 매번 다릅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap other cards too. The starting point is different every time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap other cards too. The starting point is different every time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのカードもタップしてみてください。始まる位置が毎回違います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 카드도 눌러보세요. 시작점이 매번 다릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也点点别的卡片。每次的起点都不一样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也點點別的卡片。每次的起點都不一樣。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и на другие карточки. Каждый раз начальная точка другая."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca también otras tarjetas. El punto de partida es distinto cada vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auch andere Karten an. Der Ausgangspunkt ist jedes Mal anders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez aussi d'autres cartes. Le point de départ est différent à chaque fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca anche altre carte. Il punto di partenza è diverso ogni volta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nos outros cartões também. O ponto de partida é diferente a cada vez."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะการ์ดใบอื่นด้วย จุดเริ่มต้นต่างกันทุกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm các thẻ khác nữa. Điểm xuất phát mỗi lần một khác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte i na další karty. Výchozí bod je pokaždé jiný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk også på andre kort. Udgangspunktet er forskelligt hver gang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε και άλλες κάρτες. Το σημείο εκκίνησης είναι διαφορετικό κάθε φορά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta myös muita kortteja. Lähtökohta on joka kerta eri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kartu lain juga. Titik awalnya berbeda setiap kali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på andre kort også. Utgangspunktet er forskjellig hver gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik ook op andere kaarten. Het vertrekpunt is elke keer anders."
          }
        }
      }
    },
