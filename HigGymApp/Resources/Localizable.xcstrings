    "멈춘 레슨을 그 단계부터 엽니다. 다 마친 편이면 다음 편을 엽니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopens a paused lesson at the step where you left off. If you've finished it, opens the next one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopens a paused lesson at the step where you left off. If you've finished it, opens the next one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断したレッスンをその段階から開きます。終えたレッスンなら次のレッスンを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멈춘 레슨을 그 단계부터 엽니다. 다 마친 편이면 다음 편을 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从中断的那一步重新打开课程。如果整篇已学完，就打开下一篇。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從中斷的那一步重新開啟課程。如果整篇已學完，就開啟下一篇。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает приостановленный урок с того шага, где вы остановились. Если он пройден до конца, открывает следующий."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre una lección en pausa en el paso donde la dejaste. Si la has terminado, abre la siguiente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet eine pausierte Lektion an der Stelle, wo du aufgehört hast. Ist sie abgeschlossen, wird die nächste geöffnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvre une leçon mise en pause à l'étape où vous vous étiez arrêté. Si vous l'avez terminée, ouvre la suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapre una lezione in pausa al passo in cui eri rimasto. Se l'hai finita, apre la successiva."
          }
        }
      }
    },
