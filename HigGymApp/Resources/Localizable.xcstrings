    "사용자 이름을 표시할 때 `\"\\(firstName) \\(lastName)\"` 의 문제는?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's wrong with displaying a person's name as `\"\\(firstName) \\(lastName)\"`?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What's wrong with displaying a person's name as `\"\\(firstName) \\(lastName)\"`?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー名を表示するときの `\"\\(firstName) \\(lastName)\"` の問題は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 이름을 표시할 때 `\"\\(firstName) \\(lastName)\"` 의 문제는?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示用户姓名时，`\"\\(firstName) \\(lastName)\"` 的问题是什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示使用者姓名時，`\"\\(firstName) \\(lastName)\"` 的問題是什麼？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что не так с отображением имени человека как `\"\\(firstName) \\(lastName)\"`?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué tiene de malo mostrar el nombre de una persona como `\"\\(firstName) \\(lastName)\"`?"
          }
        }
      }
    },
    "사용자가 오래 안 들어간 탭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab the person hasn't opened in a long time"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A tab the person hasn't opened in a long time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーが長く開いていないタブ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자가 오래 안 들어간 탭"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户很久没进入的标签"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
