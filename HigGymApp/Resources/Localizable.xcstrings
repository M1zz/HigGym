    "그때는 왜 맞아 보였는지까지 읽습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Including why each one seemed right at the time"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Including why each one seemed right at the time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜその時は正しく見えたのかまで読めます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连“当时为什么觉得对”也一并读到"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連「當時為什麼覺得對」也一併讀到"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включая то, почему каждая тогда казалась верной"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluido por qué cada uno parecía correcto en su momento"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschließlich dessen, warum jeder damals richtig aussah"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y compris pourquoi chacune semblait juste à l'époque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compreso perché ognuno sembrava giusto allora"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluindo por que cada um parecia certo na época"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวมถึงเหตุผลที่แต่ละข้อดูถูกต้องในตอนนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gồm cả lý do mỗi lỗi từng có vẻ đúng lúc đó"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Včetně toho, proč se každá tehdy zdála správná"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inklusive hvorfor hver især virkede rigtig dengang"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμπεριλαμβανομένου του γιατί το καθένα φαινόταν σωστό τότε"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukaan lukien miksi kukin tuntui silloin oikealta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Termasuk mengapa masing-masing tampak benar saat itu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkludert hvorfor hver enkelt virket riktig den gangen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclusief waarom elk ervan toen goed leek"
          }
        }
      }
    },
