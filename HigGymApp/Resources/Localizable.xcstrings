    "편집기에 취소·완료가 있는 쪽 ↔ 출구가 없는 쪽입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An editor with Cancel and Done ↔ one with no way out."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An editor with Cancel and Done ↔ one with no way out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタにキャンセルと完了がある側 ↔ 出口がない側です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기에 취소·완료가 있는 쪽 ↔ 출구가 없는 쪽입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器带有取消、完成的一边 ↔ 没有出口的一边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯器帶有取消、完成的一邊 ↔ 沒有出口的一邊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактор с «Отменой» и «Готово» ↔ без выхода."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un editor con Cancelar y Listo ↔ uno sin salida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Editor mit Abbrechen und Fertig ↔ einer ohne Ausweg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un éditeur avec Annuler et OK ↔ un sans issue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un editor con Annulla e Fine ↔ uno senza via d'uscita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um editor com Cancelar e Concluir ↔ um sem saída."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวแก้ไขที่มียกเลิกและเสร็จสิ้น ↔ อันที่ไม่มีทางออก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một trình soạn thảo có Hủy và Xong ↔ một cái không có lối thoát."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor se Zrušit a Hotovo ↔ takový, ze kterého není cesta ven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En editor med Annuller og Færdig ↔ en uden vej ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας επεξεργαστής με Ακύρωση και Τέλος ↔ ένας χωρίς διέξοδο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Editori, jossa on Peruuta ja Valmis ↔ editori ilman ulospääsyä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor dengan Batal dan Selesai ↔ yang tanpa jalan keluar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En editor med Avbryt og Ferdig ↔ en uten vei ut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een editor met Annuleer en Klaar ↔ een zonder uitweg."
          }
        }
      }
    },
    "포맷터가 이미 모든 로케일을 알고 있습니다. 두 벌을 만들 이유가 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The formatter already knows every locale. There's no reason to build two versions."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The formatter already knows every locale. There's no reason to build two versions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーマッタはすでにすべてのロケールを知っています。2通り作る理由はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포맷터가 이미 모든 로케일을 알고 있습니다. 두 벌을 만들 이유가 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格式化器早已了解所有区域设置，没有理由做两套。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格式化器早已了解所有區域設定，沒有理由做兩套。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форматировщик уже знает все регионы. Нет причин делать две версии."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formateador ya conoce todas las configuraciones regionales. No hay motivo para construir dos versiones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Formatierer kennt bereits jede Region. Es gibt keinen Grund, zwei Versionen zu bauen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le formateur connaît déjà toutes les régions. Il n'y a aucune raison de construire deux versions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formatter conosce già ogni regione. Non c'è motivo di costruire due versioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O formatter já conhece todas as regiões. Não há motivo para construir duas versões."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวจัดรูปแบบรู้จักทุกภาษาและภูมิภาคอยู่แล้ว ไม่มีเหตุผลต้องสร้างสองเวอร์ชัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatter đã biết mọi ngôn ngữ và vùng. Không có lý do gì phải làm hai phiên bản."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Formátovač už zná všechny lokality. Není důvod stavět dvě verze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatereren kender allerede alle landestandarder. Der er ingen grund til at bygge to versioner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο μορφοποιητής γνωρίζει ήδη κάθε γλώσσα και περιοχή. Δεν υπάρχει λόγος να φτιάξεις δύο εκδόσεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muotoilija tuntee jo kaikki kieliasetukset. Ei ole syytä rakentaa kahta versiota."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatter sudah mengenal setiap locale. Tidak ada alasan membuat dua versi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatereren kjenner allerede alle locales. Det er ingen grunn til å bygge to versjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De formatter kent al elke locale. Er is geen reden om twee versies te bouwen."
          }
        }
      }
    },
