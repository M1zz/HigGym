    "실행한 뒤 스크롤해 콘텐츠가 바 뒤를 지나가게 해보세요. 판정 기준은 가장 좋은 조건이 아니라 가장 나쁜 조건입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run it, then scroll so content passes behind the bar. Judge by the worst conditions, not the best."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Run it, then scroll so content passes behind the bar. Judge by the worst conditions, not the best."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行したらスクロールして、コンテンツがバーの後ろを通るようにしてみてください。判定の基準は最良の条件ではなく、最悪の条件です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행한 뒤 스크롤해 콘텐츠가 바 뒤를 지나가게 해보세요. 판정 기준은 가장 좋은 조건이 아니라 가장 나쁜 조건입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行之后滚动，让内容从栏后经过。判定的标准不是最好的条件，而是最糟糕的条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行之後滾動，讓內容從列後經過。判定的標準不是最好的條件，而是最糟糕的條件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите, затем прокручивайте так, чтобы контент проходил за панелью. Оценивайте по худшим условиям, а не по лучшим."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecútalo y luego desplázate para que el contenido pase por detrás de la barra. Juzga por las peores condiciones, no por las mejores."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe es aus und scrolle dann so, dass Inhalt hinter der Leiste vorbeizieht. Beurteile nach den schlechtesten Bedingungen, nicht den besten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez-le, puis faites défiler pour que le contenu passe derrière la barre. Jugez selon les pires conditions, pas les meilleures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguila, poi scorri in modo che il contenuto passi dietro la barra. Giudica in base alle condizioni peggiori, non alle migliori."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute e depois role para que o conteúdo passe atrás da barra. Julgue pelas piores condições, não pelas melhores."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รันแล้วเลื่อนให้เนื้อหาผ่านด้านหลังแถบ ตัดสินจากสภาวะที่แย่ที่สุด ไม่ใช่ดีที่สุด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy nó, rồi cuộn để nội dung đi qua phía sau thanh. Đánh giá theo điều kiện tệ nhất, không phải tốt nhất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spusťte to, pak posouvejte, aby obsah procházel za panelem. Posuzujte podle nejhorších podmínek, ne nejlepších."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kør det, og scroll derefter, så indhold passerer bag bjælken. Bedøm efter de værste forhold, ikke de bedste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτέλεσέ το και μετά κύλισε ώστε το περιεχόμενο να περνά πίσω από τη γραμμή. Κρίνε με τις χειρότερες συνθήκες, όχι με τις καλύτερες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorita se ja vieritä sitten niin, että sisältö kulkee palkin takaa. Arvioi pahimpien olosuhteiden mukaan, ei parhaiden."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan, lalu gulir agar konten lewat di belakang bilah. Nilai berdasarkan kondisi terburuk, bukan terbaik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjør den, og rull slik at innhold passerer bak linjen. Døm etter de verste forholdene, ikke de beste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer het uit en scroll zodat inhoud achter de balk langs gaat. Oordeel naar de slechtste omstandigheden, niet naar de beste."
          }
        }
      }
    },
    "심사 제출은 다음 주 월요일로 잡습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll aim to submit for review next Monday."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll aim to submit for review next Monday."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "審査への提出は来週の月曜日に予定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심사 제출은 다음 주 월요일로 잡습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把提交审核定在下周一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把提交稽核定在下週一。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправим на проверку в следующий понедельник."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intentaremos enviarlo a revisión el próximo lunes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir peilen an, es nächsten Montag zur Prüfung einzureichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous viserons une soumission pour validation lundi prochain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cercheremo di inviarla in revisione lunedì prossimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos tentar enviar para revisão na próxima segunda-feira."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราตั้งเป้าส่งรีวิวภายในวันจันทร์หน้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đặt mục tiêu gửi duyệt vào thứ Hai tới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příští pondělí se pokusíme odeslat ke kontrole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sigter mod at indsende til gennemgang næste mandag."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στοχεύουμε να υποβάλουμε για έλεγχο την επόμενη Δευτέρα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyrimme lähettämään sen tarkastettavaksi ensi maanantaina."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan berusaha mengirimkannya untuk ditinjau Senin depan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi tar sikte på å sende inn til gjennomgang neste mandag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We streven ernaar om volgende maandag in te dienen voor beoordeling."
          }
        }
      }
    },
