    "메모 편집 화면입니다. 이 화면에서 사용자가 할 수 있는 의미 있는 액션은 **완료** 하나뿐입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a note editing screen. The only meaningful action a person can take here is **Done**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a note editing screen. The only meaningful action a person can take here is **Done**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモの編集画面です。この画面でユーザーができる意味のあるアクションは**完了**だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모 편집 화면입니다. 이 화면에서 사용자가 할 수 있는 의미 있는 액션은 **완료** 하나뿐입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是备忘录编辑界面。用户在这个界面里能做的有意义的操作，只有**完成**一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是備忘錄編輯介面。使用者在這個介面裡能做的有意義的操作，只有**完成**一個。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это экран редактирования заметки. Единственное осмысленное действие здесь - **«Готово»**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una pantalla de edición de notas. La única acción significativa que se puede hacer aquí es **Listo**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Bildschirm zum Bearbeiten von Notizen. Die einzige sinnvolle Aktion, die man hier ausführen kann, ist **Fertig**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un écran de modification de note. La seule action vraiment utile ici est **OK**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una schermata di modifica di una nota. L'unica azione davvero utile che si può compiere qui è **Fine**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma tela de edição de nota. A única ação realmente útil que uma pessoa pode fazer aqui é **Concluir**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือหน้าจอแก้ไขโน้ต การกระทำเดียวที่มีความหมายที่คนทำได้ที่นี่คือ**เสร็จสิ้น**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là màn hình sửa ghi chú. Hành động có ý nghĩa duy nhất người ta có thể làm ở đây là **Xong**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je obrazovka úpravy poznámky. Jediná smysluplná akce, kterou tu člověk může provést, je **Hotovo**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en skærm til redigering af noter. Den eneste meningsfulde handling, en person kan foretage her, er **Færdig**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι μια οθόνη επεξεργασίας σημείωσης. Η μόνη ουσιαστική ενέργεια που μπορεί να κάνει κάποιος εδώ είναι το **Τέλος**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on muistiinpanojen muokkausnäkymä. Ainoa merkityksellinen toiminto, jonka ihminen voi tässä tehdä, on **Valmis**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini layar penyuntingan catatan. Satu-satunya aksi bermakna yang bisa dilakukan orang di sini adalah **Selesai**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er en skjerm for redigering av notater. Den eneste meningsfulle handlingen en person kan ta her er **Ferdig**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is een scherm voor het bewerken van notities. De enige betekenisvolle actie die iemand hier kan doen is **Klaar**."
          }
        }
      }
    },
