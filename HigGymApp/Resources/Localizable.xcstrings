    "hard 경계 + **두꺼운 재료** 배경입니다. 바 뒤가 거의 비치지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard edge + a **thick material** background. Almost nothing shows through behind the bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard edge + a **thick material** background. Almost nothing shows through behind the bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hardの境界 + **厚いマテリアル**の背景です。バーの背後はほとんど透けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "hard 경계 + **두꺼운 재료** 배경입니다. 바 뒤가 거의 비치지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hard 边界加**厚材质**背景。栏后面几乎透不出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "hard 邊界加**厚材質**背景。列後面幾乎透不出來。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жёсткая граница + фон из **толстого материала**. За панелью почти ничего не просвечивает."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un borde hard + un fondo de **material grueso**. Casi nada se transparenta detrás de la barra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine harte Kante + ein **dicker Materialhintergrund**. Hinter der Leiste scheint fast nichts durch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bord hard + un fond en **matériau épais**. Presque rien ne transparaît derrière la barre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bordo hard + uno sfondo in **materiale spesso**. Dietro la barra non traspare quasi nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma borda hard + um fundo de **material grosso**. Quase nada aparece por trás da barra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบแบบ hard + พื้นหลัง**วัสดุแบบหนา** แทบไม่มีอะไรทะลุผ่านด้านหลังแถบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cạnh hard + nền **vật liệu dày**. Gần như không có gì lộ ra phía sau thanh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvrdý okraj + podklad z **tlustého materiálu**. Za panelem skoro nic neprosvítá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En hård kant + en baggrund af **tykt materiale**. Næsten intet skinner igennem bag bjælken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια σκληρή άκρη + φόντο από **παχύ υλικό**. Σχεδόν τίποτα δεν διαφαίνεται πίσω από τη γραμμή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard-reuna + **paksu materiaali** taustana. Palkin takaa ei näy läpi juuri mitään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepi hard + latar **material tebal**. Hampir tidak ada yang tembus di belakang bilah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En hard kant + en **tykk material**-bakgrunn. Nesten ingenting skinner gjennom bak linjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een harde rand + een **dikke materiaal**achtergrond. Er schijnt bijna niets door achter de balk."
          }
        }
      }
    },
    "hard 경계 + 두꺼운 재료. 재료감은 줄었지만 어느 배경에서도 읽힙니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard edge + thick material. Less of a material feel, but readable on any background."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A hard edge + thick material. Less of a material feel, but readable on any background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hardの境界 + 厚いマテリアル。素材感は減りましたが、どんな背景でも読めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "hard 경계 + 두꺼운 재료. 재료감은 줄었지만 어느 배경에서도 읽힙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hard 边界加厚材质。材质感减弱了，但在任何背景上都读得清。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "hard 邊界加厚材質。材質感減弱了，但在任何背景上都讀得清。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жёсткая граница + толстый материал. Ощущение материала слабее, но читается на любом фоне."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un borde hard + material grueso. Menos sensación de material, pero legible sobre cualquier fondo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine harte Kante + dickes Material. Weniger Materialgefühl, aber auf jedem Hintergrund lesbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bord hard + un matériau épais. Moins d'effet de matière, mais lisible sur n'importe quel arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bordo hard + materiale spesso. Meno effetto materia, ma leggibile su qualsiasi sfondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma borda hard + material grosso. Menos sensação de material, mas legível em qualquer fundo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบแบบ hard + วัสดุแบบหนา ความรู้สึกของวัสดุน้อยลง แต่อ่านออกบนทุกพื้นหลัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cạnh hard + vật liệu dày. Ít cảm giác vật liệu hơn, nhưng đọc được trên mọi nền."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvrdý okraj + tlustý materiál. Méně pocitu materiálu, ale čitelné na jakémkoli pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En hård kant + tykt materiale. Mindre materialefornemmelse, men læseligt på enhver baggrund."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκληρή άκρη + παχύ υλικό. Λιγότερη αίσθηση υλικού, αλλά ευανάγνωστο σε οποιοδήποτε φόντο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard-reuna + paksu materiaali. Vähemmän materiaalin tuntua, mutta luettava millä tahansa taustalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepi hard + material tebal. Kesan material berkurang, tetapi terbaca di latar apa pun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En hard kant + tykt material. Mindre materialfølelse, men lesbar på enhver bakgrunn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een harde rand + dik materiaal. Minder materiaalgevoel, maar leesbaar op elke achtergrond."
          }
        }
      }
    },
    "hard는 경계를 또렷하게 나누지만, 사진처럼 밝기가 출렁이는 배경에서는 그것만으로 부족할 수 있습니다. 두꺼운 material을 함께 켜고 비교해보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard draws a crisp edge, but on a background whose brightness swings around, like a photo, that alone may not be enough. Turn on a thick material too and compare."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard draws a crisp edge, but on a background whose brightness swings around, like a photo, that alone may not be enough. Turn on a thick material too and compare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hardは境界をくっきり分けますが、写真のように明るさが揺れ動く背景では、それだけでは足りないことがあります。厚いmaterialも一緒にオンにして比べてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "hard는 경계를 또렷하게 나누지만, 사진처럼 밝기가 출렁이는 배경에서는 그것만으로 부족할 수 있습니다. 두꺼운 material을 함께 켜고 비교해보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hard 会把边界划分得很清楚，但在照片这种亮度起伏很大的背景上，光靠它可能不够。请同时打开厚 material 做比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "hard 會把邊界劃分得很清楚，但在照片這種亮度起伏很大的背景上，光靠它可能不夠。請同時開啟厚 material 做比較。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard чётко проводит границу, но на фоне с сильными перепадами яркости, как на фото, этого может не хватить. Включите ещё и толстый материал и сравните."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard dibuja un borde nítido, pero sobre un fondo cuyo brillo oscila, como una foto, eso solo puede no bastar. Activa también un material grueso y compara."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard zeichnet eine scharfe Kante, aber auf einem Hintergrund, dessen Helligkeit stark schwankt, wie bei einem Foto, reicht das allein womöglich nicht. Schalte auch ein dickes Material dazu und vergleiche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard trace un bord net, mais sur un arrière-plan dont la luminosité varie beaucoup, comme une photo, cela peut ne pas suffire. Activez aussi un matériau épais et comparez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard traccia un bordo netto, ma su uno sfondo la cui luminosità oscilla molto, come una foto, da solo può non bastare. Attiva anche un materiale spesso e confronta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard desenha uma borda nítida, mas num fundo cujo brilho oscila, como uma foto, isso sozinho pode não bastar. Ative também um material grosso e compare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard วาดขอบที่คมชัด แต่บนพื้นหลังที่ความสว่างแกว่งไปมาอย่างรูปถ่าย ลำพังอาจไม่พอ ลองเปิดวัสดุแบบหนาด้วยแล้วเปรียบเทียบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard vẽ một cạnh sắc nét, nhưng trên nền có độ sáng dao động mạnh như ảnh, riêng nó có thể chưa đủ. Hãy bật thêm vật liệu dày rồi so sánh."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard nakreslí ostrý okraj, ale na pozadí s kolísavým jasem, jako je fotka, to samo o sobě nemusí stačit. Zapněte i tlustý materiál a porovnejte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard tegner en skarp kant, men på en baggrund, hvis lysstyrke svinger, som et foto, er det måske ikke nok alene. Slå også et tykt materiale til og sammenlign."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το hard σχεδιάζει καθαρή άκρη, αλλά σε φόντο με έντονα μεταβαλλόμενη φωτεινότητα, όπως μια φωτογραφία, μπορεί να μην αρκεί μόνο του. Ενεργοποίησε και παχύ υλικό και σύγκρινε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard piirtää terävän reunan, mutta taustalla, jonka kirkkaus vaihtelee, kuten valokuvassa, se yksin ei ehkä riitä. Kytke päälle myös paksu materiaali ja vertaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard menggambar tepi yang tajam, tetapi pada latar yang kecerahannya berubah-ubah seperti foto, itu saja mungkin tidak cukup. Nyalakan juga material tebal dan bandingkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard tegner en skarp kant, men på en bakgrunn der lysstyrken svinger, som et bilde, er ikke det alene nok. Slå på et tykt material også og sammenlign."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hard tekent een scherpe rand, maar op een achtergrond waarvan de helderheid schommelt, zoals een foto, is dat alleen misschien niet genoeg. Zet ook een dik materiaal aan en vergelijk."
          }
        }
      }
    },
