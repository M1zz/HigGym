            "value": "Bottom of the screen · search capsule"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面下部・検索カプセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 아래 · 검색 캡슐"
          }
        },
        "zh-Hans": {
          "stringUnit": {
