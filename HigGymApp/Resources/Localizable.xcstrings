    "`scrollEdgeEffectHidden(true)`, 흰 사진에서 버튼이 사라집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`scrollEdgeEffectHidden(true)`: on a white photo, the buttons disappear."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "`scrollEdgeEffectHidden(true)`: on a white photo, the buttons disappear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`scrollEdgeEffectHidden(true)`。白い写真の上でボタンが消えてしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`scrollEdgeEffectHidden(true)`, 흰 사진에서 버튼이 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`scrollEdgeEffectHidden(true)`，在白色照片上按钮会消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "`scrollEdgeEffectHidden(true)`，在白色照片上按鈕會消失。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "`scrollEdgeEffectHidden(true)`: на белой фотографии кнопки исчезают."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "`scrollEdgeEffectHidden(true)`: sobre una foto blanca, los botones desaparecen."
          }
        }
      }
    },
