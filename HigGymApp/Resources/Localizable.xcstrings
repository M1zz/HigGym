    },
    "한 번 결제로 모두 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock everything with one purchase"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入ですべて開く"
