    "채우기 위한 버튼이 아니라, 없으면 나갈 수 없는 버튼입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't there to fill space. Without it, there's no way out."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't there to fill space. Without it, there's no way out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "埋めるためのボタンではなく、ないと抜け出せないボタンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채우기 위한 버튼이 아니라, 없으면 나갈 수 없는 버튼입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是为了填满而放的按钮，而是没有它就出不去的按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是為了填滿而放的按鈕，而是沒有它就出不去的按鈕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она нужна не для заполнения места. Без неё выхода нет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está para llenar espacio. Sin él, no hay salida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht da, um Platz zu füllen. Ohne es gibt es keinen Ausweg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'est pas là pour remplir l'espace. Sans lui, il n'y a aucune issue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è lì per riempire lo spazio. Senza, non c'è via d'uscita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está ali para preencher espaço. Sem ela, não há saída."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้มีไว้เติมพื้นที่ ถ้าไม่มี ก็ไม่มีทางออก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó không có để lấp chỗ. Không có nó, không có lối thoát."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není tu proto, aby vyplňovalo místo. Bez něj nevede cesta ven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er der ikke for at fylde. Uden den er der ingen vej ud."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι εκεί για να γεμίζει χώρο. Χωρίς αυτό, δεν υπάρχει διέξοδος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei ole siellä täyttämässä tilaa. Ilman sitä ulospääsyä ei ole."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
