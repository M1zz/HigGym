          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindahkan Hapus ke paling akhir di bawah pemisah dan memberinya `role: .destructive`."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttet Slett helt til slutt under en skillelinje og ga den `role: .destructive`."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder helemaal aan het eind onder een scheidingslijn gezet en `role: .destructive` gegeven."
          }
        }
      }
    },
    "삭제를 툴바가 아니라 행 위에 뒀다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Delete on the row, not in the toolbar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Put Delete on the row, not in the toolbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除をツールバーではなく行の上に置いた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제를 툴바가 아니라 행 위에 뒀다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把删除放在行上，而不是工具栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把刪除放在行上，而不是工具列。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Удалить» поместили на строку, а не на панель инструментов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon Eliminar en la fila, no en la barra de herramientas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze Löschen auf die Zeile, nicht in die Symbolleiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez Supprimer sur la ligne, pas dans la barre d'outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti Elimina sulla riga, non nella barra degli strumenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque Excluir na linha, não na barra de ferramentas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางลบไว้บนแถว ไม่ใช่ในแถบเครื่องมือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt Xóa trên dòng, không phải trên thanh công cụ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejte Smazat na řádek, ne na panel nástrojů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg Slet på rækken, ikke i værktøjslinjen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βάλε τη Διαγραφή στη γραμμή, όχι στη γραμμή εργαλείων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laita Poista riville, ei työkalupalkkiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Taruh Hapus pada baris, bukan di bilah alat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg Slett på raden, ikke i verktøylinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Verwijder op de rij, niet in de werkbalk."
          }
        }
      }
    },
    "삭제하려면 먼저 아래에서 **대상을 고르고**, 다시 위 메뉴에서 삭제를 눌러야 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To delete, you first have to **pick a target** below, then go back up to the menu and tap Delete."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To delete, you first have to **pick a target** below, then go back up to the menu and tap Delete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除するには、まず下で**対象を選び**、もう一度上のメニューで削除を押す必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하려면 먼저 아래에서 **대상을 고르고**, 다시 위 메뉴에서 삭제를 눌러야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除，得先在下方**选中对象**，再从上方菜单里点删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除，得先在下方**選中物件**，再從上方選單裡點刪除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы удалить, сначала нужно **выбрать объект** ниже, затем вернуться вверх к меню и нажать «Удалить»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para eliminar, primero tienes que **elegir un objetivo** abajo, volver al menú de arriba y tocar Eliminar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Löschen musst du zuerst unten **ein Ziel wählen**, dann zurück zum Menü oben gehen und auf Löschen tippen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour supprimer, il faut d'abord **choisir une cible** plus bas, puis remonter au menu et toucher Supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per eliminare, devi prima **scegliere un bersaglio** qui sotto, poi tornare al menu in alto e toccare Elimina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para excluir, você primeiro precisa **escolher um alvo** abaixo, depois voltar ao menu e tocar em Excluir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในการลบ คุณต้อง**เลือกเป้าหมาย**ด้านล่างก่อน แล้วกลับขึ้นไปที่เมนูและแตะลบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xóa, trước hết bạn phải **chọn một đối tượng** bên dưới, rồi quay lên menu và chạm Xóa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li smazat, musíte nejdřív **vybrat cíl** níže, pak se vrátit nahoru do nabídky a klepnout na Smazat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at slette skal du først **vælge et mål** nedenfor, derefter gå op til menuen igen og trykke på Slet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να διαγράψεις, πρέπει πρώτα να **διαλέξεις έναν στόχο** παρακάτω και μετά να γυρίσεις πάνω στο μενού και να πατήσεις Διαγραφή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaaksesi sinun on ensin **valittava kohde** alta, sitten palattava ylös valikkoon ja napautettava Poista."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menghapus, kamu harus **memilih target** di bawah dulu, lalu kembali ke menu dan mengetuk Hapus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å slette må du først **velge et mål** nedenfor, deretter gå tilbake opp til menyen og trykke på Slett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om te verwijderen moet je eerst hieronder **een doel kiezen**, dan terug omhoog naar het menu en op Verwijder tikken."
          }
        }
      }
    },
