        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Efek tepi adalah pengaman, bukan hiasan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanteffekten er et sikkerhetsnett, ikke dekorasjon"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het randeffect is een vangnet, geen decoratie"
          }
        }
      }
    },
    "가장자리 효과는 콘텐츠가 유리 아래로 지나가는 순간을 위한 **가독성 장치**다. 판정은 우리가 고른 샘플이 아니라 사용자가 가진 가장 밝은 사진에서 한다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edge effect is a **readability device** for the moment content passes under the glass. Judge it not by the sample we picked but by the brightest photo the user owns."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The edge effect is a **readability device** for the moment content passes under the glass. Judge it not by the sample we picked but by the brightest photo the user owns."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジエフェクトは、コンテンツがガラスの下を通る瞬間のための**読みやすさの仕組み**だ。判定は自分たちが選んだサンプルではなく、ユーザーが持っている最も明るい写真で行う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장자리 효과는 콘텐츠가 유리 아래로 지나가는 순간을 위한 **가독성 장치**다. 판정은 우리가 고른 샘플이 아니라 사용자가 가진 가장 밝은 사진에서 한다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "边缘效果是为内容从玻璃下方经过的那一刻准备的**可读性装置**。判定要看用户手里最亮的照片，而不是我们挑的样本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊緣效果是為內容從玻璃下方經過的那一刻準備的**可讀性裝置**。判定要看使用者手裡最亮的照片，而不是我們挑的樣本。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эффект края - **средство читаемости** на тот момент, когда контент проходит под стеклом. Судить о нём нужно не по выбранному нами образцу, а по самой яркой фотографии пользователя."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El efecto de borde es un **recurso de legibilidad** para el momento en que el contenido pasa bajo el cristal. Júzgalo no por la muestra que elegimos, sino por la foto más brillante que tenga el usuario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kanteneffekt ist ein **Mittel zur Lesbarkeit** für den Moment, in dem Inhalt unter dem Glas vorbeizieht. Beurteile ihn nicht an dem Beispiel, das wir gewählt haben, sondern am hellsten Foto, das der Nutzer besitzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'effet de bord est un **dispositif de lisibilité** pour le moment où le contenu passe sous le verre. Jugez-le non pas d'après l'exemple que nous avons choisi, mais d'après la photo la plus lumineuse que possède l'utilisateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'effetto sul bordo è un **dispositivo di leggibilità** per il momento in cui il contenuto passa sotto il vetro. Giudicalo non in base all'esempio che abbiamo scelto ma alla foto più luminosa che l'utente possiede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O efeito de borda é um **dispositivo de legibilidade** para o momento em que o conteúdo passa sob o vidro. Julgue não pela amostra que escolhemos, mas pela foto mais clara que o usuário tem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอฟเฟกต์ขอบเป็น**กลไกเพื่อความอ่านออก**ในจังหวะที่เนื้อหาผ่านใต้กระจก ตัดสินไม่ใช่จากตัวอย่างที่เราเลือก แต่จากรูปถ่ายที่สว่างที่สุดที่ผู้ใช้มี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiệu ứng cạnh là một **thiết bị bảo đảm khả năng đọc** cho khoảnh khắc nội dung đi dưới kính. Đừng đánh giá bằng mẫu chúng ta chọn, mà bằng bức ảnh sáng nhất người dùng có."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okrajový efekt je **pomůcka čitelnosti** pro chvíli, kdy obsah projde pod sklem. Posuzujte ho ne podle vzorku, který jsme vybrali, ale podle nejjasnější fotky, kterou uživatel vlastní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanteffekten er et **læsbarhedsværktøj** i det øjeblik, indhold passerer under glasset. Bedøm den ikke efter den prøve, vi valgte, men efter det lyseste foto, brugeren ejer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το εφέ άκρης είναι **μηχανισμός αναγνωσιμότητας** για τη στιγμή που το περιεχόμενο περνά κάτω από το γυαλί. Κρίνε το όχι με το δείγμα που διαλέξαμε εμείς αλλά με τη φωτεινότερη φωτογραφία που διαθέτει ο χρήστης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reunaefekti on **luettavuuden apuväline** hetkelle, jolloin sisältö kulkee lasin alta. Arvioi se kirkkaimman käyttäjän omistaman valokuvan perusteella, ei meidän valitsemamme esimerkin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Efek tepi adalah **alat keterbacaan** untuk saat konten lewat di bawah kaca. Nilai bukan dari contoh yang kita pilih, melainkan dari foto paling terang yang dimiliki pengguna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanteffekten er et **lesbarhetsverktøy** for øyeblikket innhold passerer under glasset. Vurder den ikke etter eksempelet vi valgte, men etter det lyseste bildet brukeren eier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het randeffect is een **leesbaarheidshulpmiddel** voor het moment dat inhoud onder het glas langskomt. Beoordeel het niet aan de hand van het voorbeeld dat wij kozen, maar aan de helderste foto die de gebruiker bezit."
          }
        }
      }
    },
    "각 탭의 화면 하단에 각각 구현한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build it separately at the bottom of each tab's screen"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Build it separately at the bottom of each tab's screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各タブの画面下部にそれぞれ実装する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 탭의 화면 하단에 각각 구현한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个标签的界面底部各自实现"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每個標籤的介面底部各自實作"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делать отдельно внизу экрана каждой вкладки"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construirla por separado en la parte inferior de la pantalla de cada pestaña"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihn separat unten auf dem Bildschirm jedes Tabs bauen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La construire séparément en bas de l'écran de chaque onglet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruirla separatamente in fondo alla schermata di ogni scheda"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Construa separadamente na parte de baixo da tela de cada aba"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างแยกกันที่ด้านล่างของหน้าจอในแต่ละแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xây riêng ở cuối màn hình của từng tab"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sestavit zvlášť dole na obrazovce každé karty"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Byg den separat nederst på hver fanes skærm"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτιάξ' το ξεχωριστά στο κάτω μέρος της οθόνης κάθε καρτέλας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakenna se erikseen jokaisen välilehden näkymän alaosaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun secara terpisah di bagian bawah layar setiap tab"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygg den separat nederst på hver fanes skjerm"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw het apart onderaan het scherm van elk tabblad"
          }
        }
      }
    },
    "감춘 게 아니라 **더 닿기 쉬운 자리**로 옮긴 것입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't hidden, it's been moved to **a spot that's easier to reach**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't hidden, it's been moved to **a spot that's easier to reach**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠したのではなく、**より手が届きやすい場所**に移したのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감춘 게 아니라 **더 닿기 쉬운 자리**로 옮긴 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是藏起来了，而是移到了**更容易够到的位置**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是藏起來了，而是移到了**更容易夠到的位置**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он не спрятан, а перенесён **в место, до которого проще дотянуться**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está oculto, se ha movido a **un sitio más fácil de alcanzar**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht versteckt, sondern an **eine leichter erreichbare Stelle** verlegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle n'est pas cachée, elle a été déplacée vers **un endroit plus facile à atteindre**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è nascosta, è stata spostata in **un punto più facile da raggiungere**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está escondido, foi movido para **um lugar mais fácil de alcançar**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันไม่ได้ถูกซ่อน แต่ย้ายไปอยู่ใน**ตำแหน่งที่เอื้อมถึงง่ายกว่า**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó không bị ẩn, nó được chuyển đến **một vị trí dễ với tới hơn**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není skrytý, byl přesunut na **místo, které je snazší dosáhnout**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er ikke skjult, den er flyttet til **et sted, der er nemmere at nå**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι κρυμμένο, έχει μετακινηθεί σε **ένα σημείο που προσεγγίζεται ευκολότερα**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitä ei ole piilotettu, se on siirretty **helpommin tavoitettavaan paikkaan**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia tidak disembunyikan, ia dipindahkan ke **tempat yang lebih mudah dijangkau**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er ikke skjult, den er flyttet til **et sted som er lettere å nå**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is niet verborgen, het is verplaatst naar **een plek die makkelijker te bereiken is**."
          }
        }
      }
    },
    "감춘 게 아닙니다, ⌄ 표시로 누를 수 있다는 사실을 분명히 알립니다(1.2.5).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't hidden: the ⌄ mark makes it clear that you can tap it (1.2.5)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't hidden: the ⌄ mark makes it clear that you can tap it (1.2.5)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠したのではありません。⌄の印で、タップできることをはっきり伝えています（1.2.5）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감춘 게 아닙니다, ⌄ 표시로 누를 수 있다는 사실을 분명히 알립니다(1.2.5)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是藏起来了，⌄ 标记明确告诉你可以点按（1.2.5）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是藏起來了，⌄ 標記明確告訴你可以輕點（1.2.5）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он не спрятан: значок ⌄ ясно показывает, что на него можно нажать (1.2.5)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está oculto: la marca ⌄ deja claro que se puede tocar (1.2.5)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht versteckt: Das Zeichen ⌄ macht deutlich, dass man es antippen kann (1.2.5)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle n'est pas cachée : le symbole ⌄ montre clairement qu'on peut la toucher (1.2.5)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è nascosta: il simbolo ⌄ rende chiaro che puoi toccarla (1.2.5)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está escondido: a marca ⌄ deixa claro que dá para tocar (1.2.5)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันไม่ได้ถูกซ่อน: เครื่องหมาย ⌄ ทำให้ชัดว่าแตะได้ (1.2.5)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó không bị ẩn: dấu ⌄ cho thấy rõ bạn có thể chạm vào (1.2.5)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není skrytý: značka ⌄ dává jasně najevo, že na něj lze klepnout (1.2.5)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er ikke skjult: ⌄-mærket gør det klart, at du kan trykke på den (1.2.5)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι κρυμμένο: το σημάδι ⌄ κάνει σαφές ότι μπορείς να το πατήσεις (1.2.5)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitä ei ole piilotettu: ⌄-merkki tekee selväksi, että sitä voi napauttaa (1.2.5)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia tidak disembunyikan: tanda ⌄ membuat jelas bahwa bisa diketuk (1.2.5)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er ikke skjult: ⌄-merket gjør det tydelig at du kan trykke på den (1.2.5)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is niet verborgen: het teken ⌄ maakt duidelijk dat je erop kunt tikken (1.2.5)."
          }
        }
      }
    },
