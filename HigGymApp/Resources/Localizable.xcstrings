    "보조 설명, 배경색을 혼합해 렌더링되는지, 고정된 회색인지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary text: is it rendered by blending with the background color, or is it a fixed gray?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Secondary text: is it rendered by blending with the background colour, or is it a fixed grey?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補足の説明。背景色と混ぜてレンダリングされるのか、固定のグレーなのか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 설명, 배경색을 혼합해 렌더링되는지, 고정된 회색인지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助说明，是混合背景色渲染的，还是固定的灰色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助說明，是混合背景色渲染的，還是固定的灰色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вторичный текст: он отрисовывается со смешением с цветом фона или это фиксированный серый?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto secundario: ¿se renderiza mezclándose con el color de fondo o es un gris fijo?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekundärtext: Wird er durch Einmischen der Hintergrundfarbe gerendert, oder ist es ein festes Grau?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte secondaire : est-il rendu en se mélangeant à la couleur de fond, ou est-ce un gris fixe ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo secondario: viene reso miscelandolo con il colore di sfondo o è un grigio fisso?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto secundário: é renderizado misturando com a cor de fundo ou é um cinza fixo?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความรอง: เรนเดอร์โดยผสมกับสีพื้นหลัง หรือเป็นสีเทาคงที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản phụ: nó được render bằng cách hòa với màu nền, hay là một màu xám cố định?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekundární text: vykresluje se prolnutím s barvou pozadí, nebo je to pevná šedá?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekundær tekst: renderes den ved at blande med baggrundsfarven, eller er den en fast grå?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δευτερεύον κείμενο: αποδίδεται με ανάμειξη με το χρώμα φόντου ή είναι σταθερό γκρι;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toissijainen teksti: piirretäänkö se sekoittamalla taustaväriin vai onko se kiinteä harmaa?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks sekunder: apakah dirender dengan memadukan warna latar, atau abu-abu tetap?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekundærtekst: rendres den ved å blandes med bakgrunnsfargen, eller er den en fast grå?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Secundaire tekst: wordt die weergegeven door te mengen met de achtergrondkleur, of is het een vaste grijstint?"
          }
        }
      }
    },
