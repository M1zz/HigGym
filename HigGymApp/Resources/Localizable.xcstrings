    "`lineLimit(1) + minimumScaleFactor(0.4)` ↔ `lineLimit(2...3)`. 값도 글자 크기도 같습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`lineLimit(1) + minimumScaleFactor(0.4)` ↔ `lineLimit(2...3)`. Same values, same text size."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "`lineLimit(1) + minimumScaleFactor(0.4)` ↔ `lineLimit(2...3)`. Same values, same text size."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`lineLimit(1) + minimumScaleFactor(0.4)` ↔ `lineLimit(2...3)`。値も文字サイズも同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`lineLimit(1) + minimumScaleFactor(0.4)` ↔ `lineLimit(2...3)`. 값도 글자 크기도 같습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`lineLimit(1) + minimumScaleFactor(0.4)` ↔ `lineLimit(2...3)`。数值和字号都相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "`lineLimit(1) + minimumScaleFactor(0.4)` ↔ `lineLimit(2...3)`。數值和字號都相同。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "`lineLimit(1) + minimumScaleFactor(0.4)` ↔ `lineLimit(2...3)`. Те же значения, тот же размер текста."
