            "state": "translated",
            "value": "// fullScreenCover lukker ikke ved at stryge nedad. Du skal selv bygge udgangen.\n.fullScreenCover(isPresented: $editing) {\n    EditorView()\n        .toolbar {\n            ToolbarItem(placement: .topBarLeading) { Button(\"Annuller\") { editing = false } }\n            ToolbarItem(placement: .topBarTrailing) { Button(\"Færdig\") { save() } }\n        }\n}"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "// Το fullScreenCover δεν κλείνει με σύρσιμο προς τα κάτω. Πρέπει να φτιάξεις μόνος σου την έξοδο.\n.fullScreenCover(isPresented: $editing) {\n    EditorView()\n        .toolbar {\n            ToolbarItem(placement: .topBarLeading) { Button(\"Ακύρωση\") { editing = false } }\n            ToolbarItem(placement: .topBarTrailing) { Button(\"Τέλος\") { save() } }\n        }\n}"
