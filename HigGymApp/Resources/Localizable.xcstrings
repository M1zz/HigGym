    "한 유리 캡슐(클러스터)에 묶어도 되는 조합은?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which combination can share one glass capsule (cluster)?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Which combination can share one glass capsule (cluster)?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつのガラスカプセル（クラスタ）にまとめてもいい組み合わせは？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 유리 캡슐(클러스터)에 묶어도 되는 조합은?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪种组合可以放进同一个玻璃胶囊（集群）？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪種組合可以放進同一個玻璃膠囊（叢集）？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какую комбинацию можно поместить в одну стеклянную капсулу (кластер)?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué combinación puede compartir una cápsula de cristal (grupo)?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Kombination kann sich eine Glaskapsel (Gruppe) teilen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle combinaison peut partager une capsule de verre (cluster) ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quale combinazione può condividere una capsula di vetro (gruppo)?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual combinação pode dividir uma cápsula de vidro (grupo)?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชุดใดใช้แคปซูลกระจก (กลุ่ม) ร่วมกันได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổ hợp nào có thể dùng chung một capsule kính (cụm)?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Která kombinace může sdílet jednu skleněnou kapsli (cluster)?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken kombination kan dele én glaskapsel (klynge)?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποιος συνδυασμός μπορεί να μοιραστεί μία κάψουλα γυαλιού (ομάδα);"
