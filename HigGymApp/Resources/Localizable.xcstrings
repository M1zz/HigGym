          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Удалить» перенесено со строки (смахивание) ↔ в отдельную кнопку нижней панели."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar movido de la fila (deslizar) ↔ a un botón independiente en la barra inferior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen von der Zeile (Wischen) ↔ in einen eigenständigen Button in der unteren Leiste verlegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer déplacé de la ligne (balayage) ↔ vers un bouton autonome dans la barre du bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina spostato dalla riga (scorrimento) ↔ a un pulsante autonomo nella barra in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir movido da linha (deslizar) ↔ para um botão independente na barra inferior."
