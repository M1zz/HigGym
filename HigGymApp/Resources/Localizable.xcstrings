    "줄 수를 1 → 3으로 올려보며, 어느 줄 수에서 뜻이 통하는지 판단해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise the line count from 1 to 3 and judge at which count it makes sense."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise the line count from 1 to 3 and judge at which count it makes sense."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行数を1 → 3と上げながら、何行で意味が通じるか判断してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄 수를 1 → 3으로 올려보며, 어느 줄 수에서 뜻이 통하는지 판단해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把行数从 1 调到 3，判断在几行时意思才讲得通。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把行數從 1 調到 3，判斷在幾行時意思才講得通。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимайте число строк с 1 до 3 и оценивайте, при каком числе смысл понятен."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube el número de líneas de 1 a 3 y juzga con cuántas tiene sentido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe die Zeilenzahl von 1 auf 3 und beurteile, bei welcher Zahl es Sinn ergibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez le nombre de lignes de 1 à 3 et jugez à partir de quel nombre cela a du sens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta il numero di righe da 1 a 3 e valuta con quale numero ha senso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente a contagem de linhas de 1 para 3 e julgue em qual contagem faz sentido."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มจำนวนบรรทัดจาก 1 เป็น 3 แล้วตัดสินว่าที่จำนวนเท่าไรจึงมีความหมาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tăng số dòng từ 1 lên 3 và đánh giá ở số dòng nào thì hiểu được."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvyšte počet řádků z 1 na 3 a posuďte, při kterém počtu to dává smysl."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hæv antallet af linjer fra 1 til 3, og vurder ved hvilket antal det giver mening."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αύξησε τον αριθμό γραμμών από 1 σε 3 και κρίνε σε ποιον αριθμό βγάζει νόημα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nosta rivimäärää 1:stä 3:een ja arvioi, millä määrällä sillä on järkeä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Naikkan jumlah baris dari 1 ke 3 dan nilai pada jumlah berapa ia masuk akal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Øk linjeantallet fra 1 til 3 og vurder ved hvilket antall det gir mening."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhoog het aantal regels van 1 naar 3 en beoordeel bij welk aantal het logisch is."
          }
        }
      }
    },
