          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동"
          }
        }
      }
    },
    "이렇게 고쳤다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How we fixed it"
          }
        },
        "ja": {
