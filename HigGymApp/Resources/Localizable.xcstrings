    "긴 이름·긴 제목으로 바꿔가며, 레이아웃이 텍스트를 예상하고 있었는지 확인하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap in long names and long titles to see whether the layout anticipated the text."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap in long names and long titles to see whether the layout anticipated the text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い名前や長いタイトルに変えながら、レイアウトがテキストを想定していたか確かめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 이름·긴 제목으로 바꿔가며, 레이아웃이 텍스트를 예상하고 있었는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换成长名称、长标题，确认布局是否预见了文字的长度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換成長名稱、長標題，確認佈局是否預見了文字的長度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подставляйте длинные имена и заголовки, чтобы проверить, предусматривал ли макет такой текст."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia por nombres y títulos largos para ver si el diseño anticipó el texto."
          }
        }
      }
    },
