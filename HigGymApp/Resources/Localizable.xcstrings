    "// 기준: 값과 표기를 같은 문자열에 담고 있지 않은가?\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: Are you storing the value and its format in the same string?\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: Are you storing the value and its format in the same string?\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "// 基準：値と表記を同じ文字列に入れていないか？\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "// 기준: 값과 표기를 같은 문자열에 담고 있지 않은가?\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "// 标准：数值和写法是不是装在了同一个字符串里？\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "// 標準：數值和寫法是不是裝在了同一個字串裡？\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "// Критерий: не хранятся ли значение и его запись в одной строке?\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterio: ¿Guardas el valor y su formato en la misma cadena?\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "// Kriterium: Speicherst du den Wert und sein Format in derselben Zeichenfolge?\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "// Critère : stockez-vous la valeur et son format dans la même chaîne ?\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterio: stai memorizzando il valore e il suo formato nella stessa stringa?\nText(distance.formatted(.measurement(width: .wide).locale(locale)))\nText(name.formatted(.name(style: .medium).locale(locale)))"
          }
        }
      }
    },
    "// 기준: 같은 캡슐에 든 것들을 사용자가 \"한 세트\"로 읽어도 맞는가?\nToolbarItemGroup(placement: .topBarLeading) { 보기전환; 정렬 }\nToolbarItem(placement: .topBarTrailing) { Menu { 삭제 } }": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: Is it right for people to read everything in one capsule as \"one set\"?\nToolbarItemGroup(placement: .topBarLeading) { viewToggle; sort }\nToolbarItem(placement: .topBarTrailing) { Menu { delete } }"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterion: Is it right for people to read everything in one capsule as \"one set\"?\nToolbarItemGroup(placement: .topBarLeading) { viewToggle; sort }\nToolbarItem(placement: .topBarTrailing) { Menu { delete } }"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "// 基準：同じカプセルに入ったものをユーザーが「ひとまとまり」と読んでも正しいか？\nToolbarItemGroup(placement: .topBarLeading) { viewToggle; sort }\nToolbarItem(placement: .topBarTrailing) { Menu { delete } }"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "// 기준: 같은 캡슐에 든 것들을 사용자가 \"한 세트\"로 읽어도 맞는가?\nToolbarItemGroup(placement: .topBarLeading) { 보기전환; 정렬 }\nToolbarItem(placement: .topBarTrailing) { Menu { 삭제 } }"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "// 标准：同一个胶囊里的东西，用户当作“一组”来读，对不对？\nToolbarItemGroup(placement: .topBarLeading) { 切换视图; 排序 }\nToolbarItem(placement: .topBarTrailing) { Menu { 删除 } }"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "// 標準：同一個膠囊裡的東西，使用者當作「一組」來讀，對不對？\nToolbarItemGroup(placement: .topBarLeading) { 切換檢視; 排序 }\nToolbarItem(placement: .topBarTrailing) { Menu { 刪除 } }"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "// Критерий: верно ли, что пользователь прочтёт всё в одной капсуле как «один набор»?\nToolbarItemGroup(placement: .topBarLeading) { смена вида; сортировка }\nToolbarItem(placement: .topBarTrailing) { Menu { удалить } }"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "// Criterio: ¿Es correcto que la gente lea todo lo de una cápsula como «un conjunto»?\nToolbarItemGroup(placement: .topBarLeading) { viewToggle; sort }\nToolbarItem(placement: .topBarTrailing) { Menu { delete } }"
          }
        },
        "de": {
          "stringUnit": {
