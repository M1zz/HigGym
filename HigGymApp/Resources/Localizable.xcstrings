        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เช่น ไม่เป็นไรเหนือรูปถ่ายสีเข้ม แต่พอรูปสีขาวเลื่อนขึ้นมา ข้อความก็หายไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VD: Trên ảnh tối thì ổn, nhưng khi ảnh trắng cuộn lên, chữ biến mất."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "např. Nad tmavými fotkami to bylo v pořádku, ale když se posunula bílá fotka, text zmizel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. Det var fint over mørke fotos, men da et hvidt foto scrollede op, forsvandt teksten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "π.χ. Ήταν εντάξει πάνω από σκοτεινές φωτογραφίες, αλλά όταν κύλησε προς τα πάνω μια λευκή φωτογραφία, το κείμενο εξαφανίστηκε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
