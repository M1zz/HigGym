    "위는 soft, 아래는 hard 가장자리 효과를 쓰려고 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You want a soft edge effect at the top and a hard one at the bottom."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You want a soft edge effect at the top and a hard one at the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上はsoft、下はhardのエッジエフェクトを使おうとしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위는 soft, 아래는 hard 가장자리 효과를 쓰려고 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上面想用 soft，下面想用 hard 的边缘效果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上面想用 soft，下面想用 hard 的邊緣效果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен мягкий эффект края сверху и жёсткий снизу."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quieres un efecto de borde soft arriba y uno hard abajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du willst oben einen weichen Kanteneffekt und unten einen harten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voulez un effet de bord soft en haut et un hard en bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi un effetto sul bordo morbido in alto e uno netto in basso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você quer um efeito de borda soft no topo e um hard embaixo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณต้องการเอฟเฟกต์ขอบแบบ soft ที่ด้านบนและแบบ hard ที่ด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn hiệu ứng cạnh soft ở trên và hard ở dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete měkký okrajový efekt nahoře a tvrdý dole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil have en blød kanteffekt øverst og en hård nederst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλεις ένα απαλό εφέ άκρης στην κορυφή και ένα σκληρό στο κάτω μέρος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluat soft-reunaefektin yläreunaan ja hard-efektin alareunaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu ingin efek tepi soft di atas dan hard di bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vil ha en myk kanteffekt øverst og en hard nederst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wilt een zacht randeffect bovenaan en een hard onderaan."
          }
        }
      }
    },
    "위로 끌어올려 보세요. **더 커지지 않습니다**, 선언한 detent가 하나뿐이기 때문입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag it up. **It won't get any taller**, because only one detent was declared."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag it up. **It won't get any taller**, because only one detent was declared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上に引き上げてみてください。**これ以上大きくなりません**。宣言したdetentが1つだけだからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위로 끌어올려 보세요. **더 커지지 않습니다**, 선언한 detent가 하나뿐이기 때문입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上拖动看看。**不会更大**，因为声明的 detent 只有一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向上拖動看看。**不會更大**，因為宣告的 detent 只有一個。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяните вверх. **Выше она не поднимется**, потому что объявлен только один detent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrástrala hacia arriba. **No crecerá más**, porque solo se declaró un detent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe es nach oben. **Es wird nicht höher**, weil nur ein Detent deklariert wurde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez vers le haut. **Elle ne grandira pas davantage**, car un seul detent a été déclaré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascinalo su. **Non diventa più alto**, perché è stato dichiarato un solo detent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para cima. **Ela não fica mais alta**, porque só um detent foi declarado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากขึ้น **มันจะไม่สูงขึ้นอีก** เพราะประกาศ detent ไว้แค่อันเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo nó lên. **Nó không cao thêm**, vì chỉ có một detent được khai báo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Táhněte nahoru. **Už nebude vyšší**, protože byl deklarován jen jeden detent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk den op. **Den bliver ikke højere**, fordi der kun blev erklæret én detent."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρε το προς τα πάνω. **Δεν θα ψηλώσει άλλο**, επειδή δηλώθηκε μόνο ένα detent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä sitä ylös. **Se ei kasva korkeammaksi**, koska vain yksi detent julistettiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik naik. **Ia tidak akan menjadi lebih tinggi**, karena hanya satu detent yang dideklarasikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra den opp. **Den blir ikke høyere**, fordi bare én detent ble deklarert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep omhoog. **Hij wordt niet hoger**, want er is maar één detent gedeclareerd."
          }
        }
      }
    },
