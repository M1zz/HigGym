    "NavigationStack {\n    List { NavigationLink(\"상세\") { DetailView() } }\n}\n// 아무것도 하지 않으면 탭바는 계속 보인다": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NavigationStack {\n    List { NavigationLink(\"Details\") { DetailView() } }\n}\n// If you do nothing, the tab bar stays visible"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "NavigationStack {\n    List { NavigationLink(\"Details\") { DetailView() } }\n}\n// If you do nothing, the tab bar stays visible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NavigationStack {\n    List { NavigationLink(\"詳細\") { DetailView() } }\n}\n// 何もしなければタブバーは表示されたまま"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NavigationStack {\n    List { NavigationLink(\"상세\") { DetailView() } }\n}\n// 아무것도 하지 않으면 탭바는 계속 보인다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NavigationStack {\n    List { NavigationLink(\"详情\") { DetailView() } }\n}\n// 什么都不做，标签栏就会一直显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NavigationStack {\n    List { NavigationLink(\"詳情\") { DetailView() } }\n}\n// 什麼都不做，標籤列就會一直顯示"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NavigationStack {\n    List { NavigationLink(\"Подробнее\") { DetailView() } }\n}\n// Если ничего не делать, панель вкладок остаётся на месте"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NavigationStack {\n    List { NavigationLink(\"Detalles\") { DetailView() } }\n}\n// Si no haces nada, la barra de pestañas sigue visible"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NavigationStack {\n    List { NavigationLink(\"Details\") { DetailView() } }\n}\n// Wenn du nichts tust, bleibt die Tab-Leiste sichtbar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NavigationStack {\n    List { NavigationLink(\"Détails\") { DetailView() } }\n}\n// Si vous ne faites rien, la barre d'onglets reste visible"
