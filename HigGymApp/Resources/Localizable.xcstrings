          }
        }
      }
    },
    "운송장": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡番号"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운송장"
          }
        }
      }
    },
    "운송장 번호": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking number"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡番号"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운송장 번호"
          }
        }
      }
    },
    "운송장 번호처럼 다른 앱으로 옮겨질 값이 본문에 있다. 옮길 방법이 없으면 사용자가 눈으로 받아 적는다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text contains a value, like a tracking number, that will move to another app. With no way to move it, people copy it down by eye."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡番号のように、ほかのアプリへ移す値が本文にある。移す手段がなければ、ユーザーは目で見て書き写す。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운송장 번호처럼 다른 앱으로 옮겨질 값이 본문에 있다. 옮길 방법이 없으면 사용자가 눈으로 받아 적는다."
          }
        }
      }
    },
    "원래대로 되돌렸습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored to original"
          }
        },
        "ja": {
