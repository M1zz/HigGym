            "state": "translated",
            "value": "Implementation effort"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Implementation effort"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実装の難しさ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구현 난이도"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实现难度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實作難度"
          }
        },
        "ru": {
          "stringUnit": {
