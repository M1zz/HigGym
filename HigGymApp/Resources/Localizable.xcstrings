          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάζεις φάκελο **πατώντας τον τίτλο**. Γιατί δεν υπάρχει ξεχωριστό κουμπί;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihdat kansiota **napauttamalla otsikkoa**. Miksi erillistä painiketta ei ole?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu mengganti folder dengan **mengetuk judul**. Mengapa tidak ada tombol terpisah?"
