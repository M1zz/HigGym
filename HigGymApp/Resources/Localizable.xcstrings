    ".toolbar {\n    ToolbarItemGroup(placement: .topBarTrailing) {\n        ForEach(actions.prefix(count)) { action in\n            Button(action.name, systemImage: action.symbol) { run(action) }\n        }\n    }\n}\n// 폭이 모자라면 시스템이 뒤쪽부터 ··· 메뉴로 접는다.": {
