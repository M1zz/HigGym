          }
        }
      }
    },
    "증상에서 기준까지, 어쩌다 이 실수를 하게 됐는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From symptom to criterion: how this mistake happened"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "症状から基準まで、なぜこのミスをしてしまったのか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "증상에서 기준까지, 어쩌다 이 실수를 하게 됐는가"
          }
        }
      }
    },
    "지금 가입하면 3개월 무료": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign up now and get 3 months free"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今なら登録で3か月無料"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 가입하면 3개월 무료"
          }
        }
      }
    },
    "지금 구성은 자리·묶음의 문법과 도달성 기준을 모두 지키고 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setup follows both the grammar of placement and grouping and the reachability criterion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまの構成は、位置とまとまりの文法と、届きやすさの基準をどちらも守っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 구성은 자리·묶음의 문법과 도달성 기준을 모두 지키고 있습니다."
          }
        }
      }
    },
    "지금 단색 배경에서는 멀쩡해 보입니다. 배경을 **사진**이나 **흰 배경**으로 바꿔 같은 설정을 다시 확인해보세요, 그게 실제 검증 조건입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks fine on this solid background. Switch the background to a **photo** or **white** and check the same settings again. That's the real test condition."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまの単色の背景では問題なく見えます。背景を**写真**や**白**に変えて、同じ設定をもう一度確認してみてください。それが実際の検証条件です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 단색 배경에서는 멀쩡해 보입니다. 배경을 **사진**이나 **흰 배경**으로 바꿔 같은 설정을 다시 확인해보세요, 그게 실제 검증 조건입니다."
          }
        }
      }
    },
    "지금 보는 건 고친 화면입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're looking at the fixed version"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま見ているのは直した画面です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 보는 건 고친 화면입니다"
          }
        }
      }
    },
    "지금 보는 건 어긴 화면입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're looking at the broken version"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま見ているのはルールを破った画面です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 보는 건 어긴 화면입니다"
          }
        }
      }
    },
    "지금 보이는 오른쪽 분리 캡슐은 **검색 role**로 만든 것입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The separate capsule you see on the right is built with the **search role**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま見えている右側の分離したカプセルは、**検索role**でつくったものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 보이는 오른쪽 분리 캡슐은 **검색 role**로 만든 것입니다."
          }
        }
      }
    },
    "지금 어느 단계인지 시트 안에 표시됩니다. 손이 아니라 시스템이 단계를 정합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current step is shown inside the sheet. The system, not your hand, sets the step."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまどのステップかがシートの中に表示されます。手ではなくシステムがステップを決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 어느 단계인지 시트 안에 표시됩니다. 손이 아니라 시스템이 단계를 정합니다."
          }
        }
      }
    },
    "지금 어디에 있고 어디로 갈 수 있는지 보여주는 **상시 지도**. 3~5개가 안전 범위입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An **always-on map** of where you are and where you can go. Three to five items is the safe range."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまどこにいて、どこへ行けるかを示す**常設の地図**。3〜5個が安全な範囲です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 어디에 있고 어디로 갈 수 있는지 보여주는 **상시 지도**. 3~5개가 안전 범위입니다."
          }
        }
      }
    },
    "지금 이 화면의 과업에 기여할 확률(사용 빈도)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How likely it is to help with this screen's task right now (frequency of use)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまこの画面のタスクに役立つ確率（使用頻度）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 이 화면의 과업에 기여할 확률(사용 빈도)"
          }
        }
      }
    },
    "지금 폭에서는 내용이 온전히 들어갑니다. 폭을 줄이거나 Dynamic Type을 키워 한계 조건을 만들어보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this width the content fits completely. Narrow the width or increase Dynamic Type to create an edge case."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまの幅では内容がきちんと収まります。幅を狭めるかDynamic Typeを大きくして、限界の条件をつくってみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 폭에서는 내용이 온전히 들어갑니다. 폭을 줄이거나 Dynamic Type을 키워 한계 조건을 만들어보세요."
          }
        }
      }
    },
    "지난 7일": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last 7 days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去7日間"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 7일"
          }
        }
      }
    },
    "지난 워크숍 사진 중에서 열 장만 골라주시면 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just pick ten photos from the last workshop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のワークショップの写真から10枚だけ選んでもらえれば大丈夫です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 워크숍 사진 중에서 열 장만 골라주시면 됩니다."
          }
        }
      }
    },
    "지난달": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last month"
          }
        },
        "ja": {
          "stringUnit": {
