      }
    },
    "가독성 > 미학": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readability > aesthetics"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みやすさ > 美しさ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가독성 > 미학"
          }
        }
      }
    },
    "가두지 않는 것이 언제나 친절은 아니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not trapping people isn't always kind"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じ込めないことが、いつも親切とは限らない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가두지 않는 것이 언제나 친절은 아니다"
          }
        }
      }
    },
    "가로 바는 세로 공간을 아낍니다. 캔버스처럼 세로가 아까운 화면의 도구 배치입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A horizontal bar saves vertical space. It's the tool layout for screens like a canvas, where vertical space is precious."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横向きのバーは縦のスペースを節約します。キャンバスのように縦の余白が惜しい画面向けのツール配置です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로 바는 세로 공간을 아낍니다. 캔버스처럼 세로가 아까운 화면의 도구 배치입니다."
          }
        }
      }
    },
    "가로 스크롤 카드처럼 높이가 균일해야 하는 그리드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grids that need uniform heights, like horizontally scrolling cards"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横スクロールのカードのように、高さをそろえる必要があるグリッド"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로 스크롤 카드처럼 높이가 균일해야 하는 그리드"
          }
        }
      }
    },
    "가로 화면·iPad의 세로 도구 막대. 인셋과 가장자리 효과를 시스템이 대줍니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A vertical tool bar for landscape and iPad. The system provides the insets and the edge effect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横画面やiPadの縦型ツールバー。インセットとエッジエフェクトはシステムが用意してくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로 화면·iPad의 세로 도구 막대. 인셋과 가장자리 효과를 시스템이 대줍니다."
          }
        }
      }
    },
    "가운데 **작성 탭**을 눌러보세요. 시트를 닫고 나서 지금 어느 탭에 있는지 확인하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **Compose tab** in the middle. After closing the sheet, check which tab you're on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央の**作成タブ**をタップしてみてください。シートを閉じたあと、今どのタブにいるか確かめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데 **작성 탭**을 눌러보세요. 시트를 닫고 나서 지금 어느 탭에 있는지 확인하세요."
          }
        }
      }
    },
    "가운데를 접어 양 끝(루트와 파일명)을 남겼습니다, 정보 가치가 있는 쪽을 보존하는 선택입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The middle is collapsed to keep both ends (the root and the file name), a choice that preserves the parts that carry information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央を省略して両端（ルートとファイル名）を残しました。情報価値のある部分を残す選択です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가운데를 접어 양 끝(루트와 파일명)을 남겼습니다, 정보 가치가 있는 쪽을 보존하는 선택입니다."
          }
        }
      }
    },
    "가장 밝은/복잡한 콘텐츠가 바 뒤를 지날 때 컨트롤이 읽히는지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether the controls stay readable as the brightest, busiest content passes behind the bar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も明るく複雑なコンテンツがバーの後ろを通るときに、コントロールが読めるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 밝은/복잡한 콘텐츠가 바 뒤를 지날 때 컨트롤이 읽히는지"
          }
        }
      }
    },
    "가장 아름다웠던 상태를 지키려다, 흰 사진·눈밭·강 위를 지날 때마다 컨트롤이 사라진다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In trying to protect its most beautiful state, the controls vanish every time they pass over a white photo, a snowfield, or a river."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん美しい状態を守ろうとして、白い写真や雪原、川の上を通るたびにコントロールが消える。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 아름다웠던 상태를 지키려다, 흰 사진·눈밭·강 위를 지날 때마다 컨트롤이 사라진다."
          }
        }
      }
    },
    "가장 오른쪽 아이템부터 잘라 버린다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuts off items starting from the rightmost one"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん右のアイテムから切り捨てる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 오른쪽 아이템부터 잘라 버린다"
          }
        }
      }
    },
    "가장 오른쪽 탭을 한 손으로 눌러보세요. 옆 탭을 잘못 누르지 않는지도요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the rightmost tab with one hand. Also check that you don't hit the tab next to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん右のタブを片手でタップしてみてください。隣のタブを誤ってタップしないかも確かめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 오른쪽 탭을 한 손으로 눌러보세요. 옆 탭을 잘못 누르지 않는지도요."
          }
        }
      }
    },
    "가장 자주 쓰는 **작성**이 화면 맨 위에 있습니다. 한 손으로 5번 눌러보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Compose**, the most-used action, sits at the very top of the screen. Tap it 5 times with one hand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最もよく使う**作成**が画面のいちばん上にあります。片手で5回タップしてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 자주 쓰는 **작성**이 화면 맨 위에 있습니다. 한 손으로 5번 눌러보세요."
          }
        }
      }
    },
    "가장 자주 하는 일은 어디에 두는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do you put the thing people do most?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばんよく行う操作はどこに置くか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 자주 하는 일은 어디에 두는가"
          }
        }
      }
    },
    "가장 중요한 기능이라 가장 잘 보이는 자리에 뒀다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the most important feature, so I put it where it's most visible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん重要な機能なので、いちばん目立つ場所に置いた"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 중요한 기능이라 가장 잘 보이는 자리에 뒀다"
          }
        }
      }
    },
    "가장 큰 글씨에서 하단 바 라벨이 잘리는 문제가 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the largest text size, the bottom bar labels get cut off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大の文字サイズで、下部のバーのラベルが切れてしまう問題があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 큰 글씨에서 하단 바 라벨이 잘리는 문제가 있습니다."
          }
        }
      }
    },
    "가장 큰 기기에서 확인하면 문제를 만나지 못한다. 작은 기기·긴 라벨·큰 글씨가 겹칠 때만 드러난다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test on the biggest device and you'll never hit the problem. It only shows up when a small device, long labels, and large text combine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いちばん大きいデバイスで確認しても問題には出会わない。小さいデバイス、長いラベル、大きい文字が重なったときにだけ現れる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 큰 기기에서 확인하면 문제를 만나지 못한다. 작은 기기·긴 라벨·큰 글씨가 겹칠 때만 드러난다."
          }
        }
      }
    },
    "가장자리 효과": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edge effect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジエフェクト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장자리 효과"
          }
        }
      }
    },
    "가장자리 효과는 스크롤되는 콘텐츠와 떠 있는 컨트롤이 만나는 지점을 어떻게 처리할지에 대한 계약입니다. 콘텐츠가 유리 아래로 지나갈 때 글자가 컨트롤과 겹쳐 읽히지 않는 순간을 막는 것이 목적이며, 배경이 밝을수록 더 강한 처리가 필요합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edge effect is a contract for how to handle the point where scrolling content meets floating controls. Its purpose is to prevent moments when text passing under the glass overlaps the controls and becomes unreadable, and the brighter the background, the stronger the treatment it needs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジエフェクトは、スクロールするコンテンツと浮いているコントロールが出会う地点をどう処理するかの約束です。コンテンツがガラスの下を通るとき、文字がコントロールと重なって読めなくなる瞬間を防ぐのが目的で、背景が明るいほど強い処理が必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장자리 효과는 스크롤되는 콘텐츠와 떠 있는 컨트롤이 만나는 지점을 어떻게 처리할지에 대한 계약입니다. 콘텐츠가 유리 아래로 지나갈 때 글자가 컨트롤과 겹쳐 읽히지 않는 순간을 막는 것이 목적이며, 배경이 밝을수록 더 강한 처리가 필요합니다."
          }
        }
      }
    },
    "가장자리 효과는 시스템 바에만 적용된다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edge effect applies only to system bars"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジエフェクトはシステムバーにしか適用されない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장자리 효과는 시스템 바에만 적용된다"
          }
        }
      }
    },
    "가장자리 효과는 장식이 아니라 **가독성 장치**입니다. 판정은 언제나 최악의 배경에서 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edge effect isn't decoration, it's a **readability device**. Always judge it against the worst background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジエフェクトは飾りではなく**読みやすさのための仕組み**です。判定はいつも最悪の背景で行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장자리 효과는 장식이 아니라 **가독성 장치**입니다. 판정은 언제나 최악의 배경에서 합니다."
          }
        }
      }
    },
    "가장자리 효과는 장식이 아니라 안전장치": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edge effect is a safeguard, not decoration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジエフェクトは飾りではなく安全装置"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장자리 효과는 장식이 아니라 안전장치"
          }
        }
      }
    },
    "가장자리 효과는 콘텐츠가 유리 아래로 지나가는 순간을 위한 **가독성 장치**다. 판정은 우리가 고른 샘플이 아니라 사용자가 가진 가장 밝은 사진에서 한다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edge effect is a **readability device** for the moment content passes under the glass. Judge it not by the sample we picked but by the brightest photo the user owns."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジエフェクトは、コンテンツがガラスの下を通る瞬間のための**読みやすさの仕組み**だ。判定は自分たちが選んだサンプルではなく、ユーザーが持っている最も明るい写真で行う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장자리 효과는 콘텐츠가 유리 아래로 지나가는 순간을 위한 **가독성 장치**다. 판정은 우리가 고른 샘플이 아니라 사용자가 가진 가장 밝은 사진에서 한다."
          }
        }
      }
    },
    "각 탭의 화면 하단에 각각 구현한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build it separately at the bottom of each tab's screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各タブの画面下部にそれぞれ実装する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 탭의 화면 하단에 각각 구현한다"
          }
        }
      }
    },
    "감춘 게 아니라 **더 닿기 쉬운 자리**로 옮긴 것입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't hidden, it's been moved to **a spot that's easier to reach**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠したのではなく、**より手が届きやすい場所**に移したのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감춘 게 아니라 **더 닿기 쉬운 자리**로 옮긴 것입니다."
          }
        }
      }
    },
    "감춘 게 아닙니다, ⌄ 표시로 누를 수 있다는 사실을 분명히 알립니다(1.2.5).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't hidden: the ⌄ mark makes it clear that you can tap it (1.2.5)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隠したのではありません。⌄の印で、タップできることをはっきり伝えています（1.2.5）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감춘 게 아닙니다, ⌄ 표시로 누를 수 있다는 사실을 분명히 알립니다(1.2.5)."
          }
        }
      }
    },
    "값 %@ km": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Value %@ km"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値 %@ km"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값 %@ km"
          }
        }
      }
    },
    "값 타입에 축소를 적용했습니다, 자르지 않고 줄여 정보를 보존하는 올바른 선택입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaling is applied to the value type, the right choice, because it shrinks instead of cutting and keeps the information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値のタイプに縮小を適用しました。切らずに縮めて情報を保つ、正しい選択です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값 타입에 축소를 적용했습니다, 자르지 않고 줄여 정보를 보존하는 올바른 선택입니다."
          }
        }
      }
    },
    "값, 잘리면 다른 시간이 된다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A value: cut it and it becomes a different time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値。切れると別の時刻になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값, 잘리면 다른 시간이 된다"
          }
        }
      }
    },
    "값, 잘리면 틀린 금액이 된다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A value: cut it and it becomes the wrong amount"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値。切れると間違った金額になる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값, 잘리면 틀린 금액이 된다"
          }
        }
      }
    },
    "값, 정보 가치가 양 끝에 있다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A value: the information is at both ends"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値。情報の価値が両端にある"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값, 정보 가치가 양 끝에 있다"
          }
        }
      }
    },
    "값, 표기 규칙이 문화권마다 다르다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A value: formatting rules differ by locale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値。表記のルールがロケールごとに違う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값, 표기 규칙이 문화권마다 다르다"
          }
        }
      }
    },
    "값과 표기를 누가 갖는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who owns the value and the format?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値と表記は誰が持つのか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값과 표기를 누가 갖는가"
          }
        }
      }
    },
    "값과 표기를 한 문자열에 담으면 문화권 규칙을 앱이 소유하게 된다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting the value and its format in one string means the app ends up owning the locale's rules"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値と表記をひとつの文字列に入れると、ロケールのルールをアプリが握ることになる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값과 표기를 한 문자열에 담으면 문화권 규칙을 앱이 소유하게 된다"
          }
        }
      }
    },
    "값과 표기를 한 문자열에 담지 않는 것, 값은 앱이, 표기는 로케일이 정합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't put the value and its format in one string. The app decides the value, the locale decides the format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値と表記をひとつの文字列に入れないこと。値はアプリが、表記はロケールが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값과 표기를 한 문자열에 담지 않는 것, 값은 앱이, 표기는 로케일이 정합니다."
          }
        }
      }
    },
    "값과 표기를 한 문자열에 담지 않는다, **이 두 화면은 영어(en_US) 기기**입니다. 어느 쪽이 로케일을 따라갑니까?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't put the value and its format in one string. **Both of these screens are on an English (en_US) device.** Which one follows the locale?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値と表記をひとつの文字列に入れない。**この2つの画面は英語（en_US）のデバイスです**。どちらがロケールに従っていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값과 표기를 한 문자열에 담지 않는다, **이 두 화면은 영어(en_US) 기기**입니다. 어느 쪽이 로케일을 따라갑니까?"
          }
        }
      }
    },
    "값만 들고 있다가 로케일에 맞춰 표기를 시스템에 맡깁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It holds only the value and lets the system format it for the locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値だけを持ち、ロケールに合わせた表記はシステムに任せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값만 들고 있다가 로케일에 맞춰 표기를 시스템에 맡깁니다."
          }
        }
      }
    },
    "값에 따라 화면 전체가 바뀌므로 “화면의 정체성”, principal 자리의 문법과 일치합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole screen changes with the value, so it's “the screen's identity,” which matches the grammar of the principal position."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値によって画面全体が変わるので「画面のアイデンティティ」であり、principalの位置の文法と一致します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값에 따라 화면 전체가 바뀌므로 “화면의 정체성”, principal 자리의 문법과 일치합니다."
          }
        }
      }
    },
    "값은 앱이, 표기는 로케일이": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app owns the value, the locale owns the format"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値はアプリが、表記はロケールが"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 앱이, 표기는 로케일이"
          }
        }
      }
    },
    "강릉 바다 드라이브": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coastal drive in Big Sur"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "伊豆の海岸ドライブ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강릉 바다 드라이브"
          }
        }
      }
    },
    "강태민": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyler Kang"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "山本 蓮"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강태민"
          }
        }
      }
    },
    "같은 기능을 오른쪽 버튼으로 뺐다면, 화면 정체와 액션이 따로 놀았을 겁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the same feature had been pulled out into a button on the right, the screen's identity and the action would have drifted apart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ機能を右側のボタンに分けていたら、画面のアイデンティティとアクションがばらばらになっていたでしょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 기능을 오른쪽 버튼으로 뺐다면, 화면 정체와 액션이 따로 놀았을 겁니다."
          }
        }
      }
    },
    "같은 뷰를 `overlay`로 얹었다면 첫 항목이 그 밑에 깔렸을 겁니다. 그 차이가 이 API의 전부입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the same view had been layered on with `overlay`, the first item would have ended up underneath it. That difference is the whole point of this API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じビューを`overlay`で重ねていたら、最初の項目がその下に隠れていたでしょう。その違いがこのAPIのすべてです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 뷰를 `overlay`로 얹었다면 첫 항목이 그 밑에 깔렸을 겁니다. 그 차이가 이 API의 전부입니다."
          }
        }
      }
    },
    "같은 액션이 오른쪽 위에 있었다면 한 손으로 몇 번이나 눌렀을지 상상해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagine how many times you'd have stretched with one hand if the same action were in the top right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じアクションが右上にあったら、片手で何度手を伸ばしていたか想像してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 액션이 오른쪽 위에 있었다면 한 손으로 몇 번이나 눌렀을지 상상해 보세요."
          }
        }
      }
    },
    "같은 캡슐에 있으면 사용자는 **한 세트**로 읽습니다. 묶음 자체가 의미라서, 성격이 다른 것을 넣으면 묶음이 거짓 정보가 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When things share a capsule, people read them as **one set**. The grouping itself carries meaning, so putting something of a different kind inside turns the group into false information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じカプセルに入っていると、ユーザーは**ひとつのセット**として読みます。まとまり自体が意味を持つので、性質の違うものを入れると、まとまりが嘘の情報になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 캡슐에 있으면 사용자는 **한 세트**로 읽습니다. 묶음 자체가 의미라서, 성격이 다른 것을 넣으면 묶음이 거짓 정보가 됩니다."
          }
        }
      }
    },
    "개수": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개수"
          }
        }
      }
    },
    "개수가 아니라 상태가 정보일 때(NEW·LIVE) 쓰는 형태입니다. 긴 문자열은 탭 레이아웃을 침범하므로 짧게 유지하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this form when the information is a state rather than a count (NEW, LIVE). Long strings intrude on the tab layout, so keep it short."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数ではなく状態が情報であるとき（NEW・LIVE）に使う形です。長い文字列はタブのレイアウトを侵すので、短く保ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개수가 아니라 상태가 정보일 때(NEW·LIVE) 쓰는 형태입니다. 긴 문자열은 탭 레이아웃을 침범하므로 짧게 유지하세요."
          }
        }
      }
    },
    "개인": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인"
          }
        }
      }
    },
    "갤러리": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gallery"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャラリー"
          }
        },
        "ko": {
          "stringUnit": {
