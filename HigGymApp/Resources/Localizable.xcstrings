    "직접 지정한 고정 회색은 어느 한 배경에서 반드시 깨집니다, 그게 이 항목의 요지입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed gray you pick yourself will always break on some background. That's the point of this topic."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed grey you pick yourself will always break on some background. That's the point of this topic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で決めた固定のグレーは、どこかの背景で必ず破綻します。それがこのトピックの要点です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 지정한 고정 회색은 어느 한 배경에서 반드시 깨집니다, 그게 이 항목의 요지입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接指定的固定灰色，一定会在某个背景上失效，这就是这一项的要点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接指定的固定灰色，一定會在某個背景上失效，這就是這一項的要點。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фиксированный серый, выбранный вами, обязательно сломается на каком-нибудь фоне. В этом суть темы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gris fijo que eliges tú siempre fallará sobre algún fondo. Ese es el sentido de este tema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein festes Grau, das du selbst wählst, bricht immer auf irgendeinem Hintergrund. Das ist der Kern dieses Themas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gris fixe que vous choisissez vous-même finira toujours par casser sur un arrière-plan. C'est tout l'objet de cette rubrique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grigio fisso scelto da te si romperà sempre su qualche sfondo. Questo è il punto di questo argomento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cinza fixo escolhido por você sempre quebra em algum fundo. Esse é o ponto deste tópico."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีเทาตายตัวที่คุณเลือกเองจะพังบนพื้นหลังใดพื้นหลังหนึ่งเสมอ นั่นคือประเด็นของหัวข้อนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một màu xám cố định bạn tự chọn sẽ luôn hỏng trên một nền nào đó. Đó là ý chính của chủ đề này."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pevná šedá, kterou si zvolíte sami, se vždy na nějakém pozadí rozbije. V tom je smysl tohoto tématu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En fast grå, du selv vælger, vil altid fejle på en eller anden baggrund. Det er pointen med dette emne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα σταθερό γκρι που διαλέγεις μόνος σου θα χαλάσει πάντα σε κάποιο φόντο. Αυτό είναι το νόημα αυτού του θέματος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Itse valittu kiinteä harmaa rikkoutuu aina jollain taustalla. Se on tämän aiheen pointti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Abu-abu tetap yang kamu pilih sendiri akan selalu rusak pada suatu latar. Itulah inti topik ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En fast grå du velger selv vil alltid svikte på en eller annen bakgrunn. Det er poenget med dette emnet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vast grijs dat je zelf kiest, breekt altijd op een of andere achtergrond. Dat is de kern van dit onderwerp."
          }
        }
      }
    },
