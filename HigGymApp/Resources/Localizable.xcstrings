    "빈 자리는 실패가 아니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty space is not a failure"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty space is not a failure"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いた場所は失敗ではない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 자리는 실패가 아니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空位不是失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空位不是失敗"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустое место - это не провал"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio vacío no es un fracaso"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leerer Raum ist kein Misserfolg"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace vide n'est pas un échec"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio vuoto non è un fallimento"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço vazio não é um fracasso"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ว่างไม่ใช่ความล้มเหลว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng trống không phải là thất bại"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prázdné místo není selhání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tom plads er ikke en fiasko"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κενός χώρος δεν είναι αποτυχία"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjä tila ei ole epäonnistuminen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang kosong bukan kegagalan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tom plass er ikke en feil"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ruimte is geen mislukking"
          }
        }
      }
    },
    "빈 자리는 실패가 아닙니다. 채우기 위해 넣은 것은 대개 군더더기입니다(8.1.1).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty space is not a failure. Things added just to fill it are usually clutter (8.1.1)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty space is not a failure. Things added just to fill it are usually clutter (8.1.1)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いた場所は失敗ではありません。埋めるために入れたものは、たいてい余計なものです（8.1.1）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 자리는 실패가 아닙니다. 채우기 위해 넣은 것은 대개 군더더기입니다(8.1.1)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空位不是失败。为了填满而放进去的，大多是多余的东西（8.1.1）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空位不是失敗。為了填滿而放進去的，大多是多餘的東西（8.1.1）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустое место - не провал. То, что добавлено лишь ради заполнения, обычно оказывается лишним (8.1.1)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio vacío no es un fracaso. Lo que se añade solo para llenarlo suele ser desorden (8.1.1)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leerer Raum ist kein Misserfolg. Was nur zum Füllen hinzugefügt wird, ist meist Unordnung (8.1.1)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace vide n'est pas un échec. Ce que l'on ajoute juste pour le remplir est généralement du fouillis (8.1.1)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio vuoto non è un fallimento. Ciò che si aggiunge solo per riempirlo di solito è disordine (8.1.1)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço vazio não é um fracasso. O que se adiciona só para preenchê-lo costuma ser bagunça (8.1.1)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ว่างไม่ใช่ความล้มเหลว สิ่งที่เพิ่มเข้ามาเพียงเพื่อเติมมักเป็นความรก (8.1.1)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng trống không phải là thất bại. Những thứ thêm vào chỉ để lấp nó thường là sự lộn xộn (8.1.1)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prázdné místo není selhání. Věci přidané jen proto, aby ho vyplnily, jsou obvykle zbytečné (8.1.1)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tom plads er ikke en fiasko. Ting, der blot tilføjes for at fylde den, er som regel rod (8.1.1)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κενός χώρος δεν είναι αποτυχία. Ό,τι προστίθεται μόνο για να τον γεμίσει είναι συνήθως ακαταστασία (8.1.1)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjä tila ei ole epäonnistuminen. Sen täyttämiseksi lisätyt asiat ovat yleensä sotkua (8.1.1)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang kosong bukan kegagalan. Hal yang ditambahkan hanya untuk mengisinya biasanya hanya kekacauan (8.1.1)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tom plass er ikke en feil. Ting lagt til bare for å fylle den er som regel rot (8.1.1)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ruimte is geen mislukking. Wat alleen wordt toegevoegd om haar te vullen is meestal rommel (8.1.1)."
          }
        }
      }
    },
    "빈도": {
      "localizations": {
        "en": {
          "stringUnit": {
