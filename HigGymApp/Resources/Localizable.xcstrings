    "lineLimit(2)로 두 줄로 흘린다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap it onto two lines with lineLimit(2)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrap it onto two lines with lineLimit(2)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "lineLimit(2)で2行に折り返す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "lineLimit(2)로 두 줄로 흘린다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 lineLimit(2) 排成两行"
          }
        },
        "zh-Hant": {
