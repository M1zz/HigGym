          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taux de plantage cette semaine : 0,12 %, en baisse de 0,04 point par rapport à la semaine dernière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasso di crash di questa settimana: 0,12%, in calo di 0,04 punti rispetto alla settimana scorsa."
          }
        }
      }
    },
