    "%@\n\n**기준**, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n**Criterion:** %@"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n**Criterion:** %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n**基準**：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@\n\n**기준**, %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n**标准**，%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n**標準**，%2$@"
          }
        },
        "ru": {
