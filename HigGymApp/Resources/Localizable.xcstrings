    "Dynamic Type 최대 크기에서 하단 바 라벨이 잘립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the largest Dynamic Type size, the bottom bar labels get truncated."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "At the largest Dynamic Type size, the bottom bar labels get truncated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Typeの最大サイズで、下部のバーのラベルが切り詰められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Type 최대 크기에서 하단 바 라벨이 잘립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dynamic Type 的最大字号下，底部栏的标签被截断了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dynamic Type 的最大字號下，底部列的標籤被截斷了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При максимальном размере Dynamic Type подписи нижней панели обрезаются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el tamaño más grande de Dynamic Type, las etiquetas de la barra inferior se truncan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der größten Dynamic-Type-Größe werden die Beschriftungen der unteren Leiste abgeschnitten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la plus grande taille Dynamic Type, les libellés de la barre du bas sont tronqués."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla dimensione massima di Dynamic Type, le etichette della barra in basso vengono troncate."
          }
        }
      }
    },
