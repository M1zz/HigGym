            "value": "下部のバーは操作のためのコックピットだ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 바는 조작을 위한 콕핏이다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "底部栏是用于操作的驾驶舱"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
