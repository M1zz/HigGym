    "선택·복사가 됩니다. 복사 버튼도 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can select and copy. There's a copy button too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can select and copy. There's a copy button too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択もコピーもできます。コピーボタンもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택·복사가 됩니다. 복사 버튼도 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以选择、复制。也有复制按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以選擇、複製。也有複製按鈕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно выделять и копировать. Есть и кнопка копирования."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seleccionar y copiar. También hay un botón de copiar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auswählen und kopieren. Es gibt auch einen Kopieren-Button."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez sélectionner et copier. Il y a aussi un bouton de copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi selezionare e copiare. C'è anche un pulsante di copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode selecionar e copiar. Há também um botão de copiar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกและคัดลอกได้ มีปุ่มคัดลอกด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể chọn và sao chép. Cũng có nút sao chép."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete vybírat a kopírovat. Je tu i tlačítko kopírovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan markere og kopiere. Der er også en kopiknap."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να επιλέξεις και να αντιγράψεις. Υπάρχει και κουμπί αντιγραφής."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit valita ja kopioida. Mukana on myös kopiointipainike."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa memilih dan menyalin. Ada juga tombol salin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan markere og kopiere. Det finnes også en kopieringsknapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt selecteren en kopiëren. Er is ook een kopieerknop."
          }
        }
      }
    },
