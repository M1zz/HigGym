          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把区域设置在 ko_KR ↔ en_US 之间切换，**姓和名的顺序**会颠倒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
