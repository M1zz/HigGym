    "`\"\\(distance) km\"` 로 조립하고 미국이면 변환한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build it as `\"\\(distance) km\"` and convert it yourself for the US"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(distance) km\"` で組み立て、アメリカなら自前で変換する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(distance) km\"` 로 조립하고 미국이면 변환한다"
          }
        }
      }
    },
    "`\"\\(km) km\"`, 로케일을 바꿔도 그대로입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`: it stays the same even when you change the locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`。ロケールを変えてもそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`\"\\(km) km\"`, 로케일을 바꿔도 그대로입니다."
          }
        }
      }
    },
    "`.hard` 경계 ↔ 효과 끔(`scrollEdgeEffectHidden`). 사진과 배치는 같습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard` edge ↔ effect off (`scrollEdgeEffectHidden`). Same photo, same layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard` の境界 ↔ エフェクトオフ（`scrollEdgeEffectHidden`）。写真もレイアウトも同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard` 경계 ↔ 효과 끔(`scrollEdgeEffectHidden`). 사진과 배치는 같습니다."
          }
        }
      }
    },
    "`.hard`, 경계가 스스로 대비를 만듭니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`: the edge creates its own contrast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`。境界が自らコントラストを生み出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`.hard`, 경계가 스스로 대비를 만듭니다."
          }
        }
      }
    },
    "`.ultraThinMaterial` + 흰 글자 ↔ `.thickMaterial` + 테두리. 지도와 배치는 같습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`.ultraThinMaterial` + white text ↔ `.thickMaterial` + border. Same map, same layout."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`.ultraThinMaterial` + 白い文字 ↔ `.thickMaterial` + 枠線。地図もレイアウトも同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`.ultraThinMaterial` + 흰 글자 ↔ `.thickMaterial` + 테두리. 지도와 배치는 같습니다."
          }
        }
      }
    },
    "`Measurement`, mi로 따라옵니다.": {
      "localizations": {
