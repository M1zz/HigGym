        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộn và một **cạnh sắc nét** xuất hiện dưới thanh. Nội dung và thanh được tách bạch rõ ràng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte a pod panelem se objeví **ostrý okraj**. Obsah a panel jsou čistě odděleny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll, og en **skarp kant** dukker op under bjælken. Indhold og bjælke er rent adskilt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κύλισε και εμφανίζεται μια **καθαρή άκρη** κάτω από τη γραμμή. Το περιεχόμενο και η γραμμή χωρίζονται καθαρά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieritä, niin palkin alle ilmestyy **terävä reuna**. Sisältö ja palkki erottuvat siististi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gulir dan **tepi tajam** muncul di bawah bilah. Konten dan bilah terpisah dengan bersih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rull, så dukker en **skarp kant** opp under linjen. Innhold og linje skilles rent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll en er verschijnt een **scherpe rand** onder de balk. Inhoud en balk zijn netjes gescheiden."
          }
        }
      }
    },
    "스크롤하면 숨고 당기면 나타나는 기본 드로어, 필요할 때만 공간을 씁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The standard drawer that hides on scroll and reappears when you pull, using space only when needed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The standard drawer that hides on scroll and reappears when you pull, using space only when needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールすると隠れ、引っ張ると現れる標準のドロワー。必要なときだけスペースを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤하면 숨고 당기면 나타나는 기본 드로어, 필요할 때만 공간을 씁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动时隐藏、下拉时出现的默认抽屉，只在需要时占用空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動時隱藏、下拉時出現的預設抽屜，只在需要時佔用空間。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стандартная выдвижная панель, которая прячется при прокрутке и появляется при протягивании вниз, занимая место только когда нужна."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cajón estándar que se oculta al desplazar y reaparece al tirar, usando espacio solo cuando hace falta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Standardschublade, die beim Scrollen verschwindet und beim Ziehen wieder erscheint und nur bei Bedarf Platz braucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tiroir standard qui se cache au défilement et réapparaît quand on tire, n'utilisant de la place qu'au besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cassetto standard che si nasconde allo scorrimento e ricompare quando tiri, usando spazio solo quando serve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gaveta padrão que se esconde ao rolar e reaparece quando você puxa, usando espaço só quando necessário."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิ้นชักมาตรฐานที่ซ่อนเมื่อเลื่อนและกลับมาเมื่อดึง ใช้พื้นที่เมื่อจำเป็นเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn chuẩn ẩn khi cuộn và hiện lại khi bạn kéo, chỉ dùng không gian khi cần."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardní zásuvka, která se při posouvání schová a při tažení znovu objeví, takže zabírá místo jen tehdy, když je potřeba."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardskuffen, der skjuler sig ved scrolling og dukker op igen, når du trækker, og kun bruger plads, når det er nødvendigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το τυπικό συρτάρι που κρύβεται στην κύλιση και εμφανίζεται ξανά όταν τραβάς, χρησιμοποιώντας χώρο μόνο όταν χρειάζεται."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavallinen laatikko, joka piiloutuu vieritettäessä ja ilmestyy uudelleen vedettäessä, käyttäen tilaa vain tarvittaessa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laci standar yang bersembunyi saat digulir dan muncul kembali saat ditarik, memakai ruang hanya saat dibutuhkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardskuffen som skjules ved rulling og dukker opp igjen når du drar, og bruker plass bare når det trengs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De standaardlade die verdwijnt bij scrollen en terugkomt als je trekt, en alleen ruimte gebruikt wanneer nodig."
          }
        }
      }
    },
    "스크롤하면 캡슐이 어떻게 반응하는지도 보세요.": {
