          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличить lineLimit и пустить текст на несколько строк"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube lineLimit y deja que el texto salte de línea"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "lineLimit erhöhen und den Text über mehrere Zeilen umbrechen lassen"
          }
        },
        "fr": {
