            "value": "Отрезает элементы, начиная с самого правого"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta elementos empezando por el de más a la derecha"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneidet Elemente ab, beginnend mit dem ganz rechten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupe les éléments en commençant par celui le plus à droite"
