    "상단에는 제목이 있어서 검색을 넣을 자리가 없었다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title was at the top, so there was no room for search"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The title was at the top, so there was no room for search"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部にはタイトルがあって、検索を入れる場所がなかった"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단에는 제목이 있어서 검색을 넣을 자리가 없었다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部有标题，没有地方放搜索"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂部有標題，沒有地方放搜尋"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверху стоял заголовок, поэтому места для поиска не было"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título estaba arriba, así que no quedaba sitio para la búsqueda"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel war oben, daher blieb kein Platz für die Suche"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le titre était en haut, donc il n'y avait pas de place pour la recherche"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo era in alto, quindi non restava spazio per la ricerca"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O título estava no topo, então não havia espaço para a busca"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องอยู่ด้านบน จึงไม่มีที่ให้การค้นหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề ở trên cùng nên không còn chỗ cho tìm kiếm"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadpis byl nahoře, takže nezbylo místo na hledání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlen sad øverst, så der var ikke plads til søgning"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο τίτλος ήταν στην κορυφή, οπότε δεν υπήρχε χώρος για αναζήτηση"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsikko oli ylhäällä, joten haulle ei jäänyt tilaa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judulnya di atas, jadi tidak ada tempat untuk pencarian"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tittelen var øverst, så det var ikke plass til søk"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De titel stond bovenaan, dus er was geen ruimte voor zoeken"
          }
        }
      }
    },
    "상단에는 확정 액션 하나만 남기고 도구는 넣지 않았다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept only the one committing action at the top and put no tools there."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept only the one committing action at the top and put no tools there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部には確定のアクション1つだけを残し、道具は入れなかった。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단에는 확정 액션 하나만 남기고 도구는 넣지 않았다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部只留下一个确认操作，没有放工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂部只留下一個確認操作，沒有放工具。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверху оставили только одно подтверждающее действие, а инструментов не ставили."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dejó arriba solo la acción de confirmación y no se puso ahí ninguna herramienta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben nur die eine bestätigende Aktion behalten und dort keine Werkzeuge platziert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'a gardé en haut que l'unique action de validation et n'y a mis aucun outil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In alto è rimasta solo l'unica azione di conferma e nessuno strumento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manteve no topo só a única ação de confirmação e não pôs ferramentas ali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไว้เฉพาะการกระทำเพื่อยืนยันอย่างเดียวที่ด้านบน และไม่วางเครื่องมือไว้ที่นั่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ giữ một hành động xác nhận ở trên cùng và không đặt công cụ nào ở đó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahoře ponechána jen jedna potvrzující akce a žádné nástroje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdt kun den ene bekræftende handling øverst og lagde ingen værktøjer der."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτησε στην κορυφή μόνο τη μία δεσμευτική ενέργεια και δεν έβαλε εργαλεία εκεί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piti ylhäällä vain yhden sitovan toiminnon eikä laittanut sinne työkaluja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya mempertahankan satu aksi komit di atas dan tidak menaruh alat di sana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdt bare den ene bekreftende handlingen øverst og la ingen verktøy der."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de ene vastleggende actie bovenaan gehouden en daar geen hulpmiddelen geplaatst."
          }
        }
      }
    },
    "상단으로 올리면 누를 때마다 기기를 고쳐 쥐게 되고, 그만큼 덜 쓰인다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move it to the top and people have to shift their grip every time they tap it, so it gets used that much less."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Move it to the top and people have to shift their grip every time they tap it, so it gets used that much less."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部に移すと押すたびにデバイスを持ち直すことになり、その分使われなくなる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단으로 올리면 누를 때마다 기기를 고쳐 쥐게 되고, 그만큼 덜 쓰인다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放到顶部，每次点按都要换握姿，用的次数也就更少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放到頂部，每次輕點都要換握姿，用的次數也就更少。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимите его наверх, и людям придётся каждый раз перехватывать устройство при нажатии, поэтому им будут пользоваться реже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llévalo arriba y la gente tiene que cambiar el agarre cada vez que lo toca, así que se usa mucho menos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlegt man es nach oben, müssen Menschen bei jedem Antippen den Griff wechseln, sodass es entsprechend seltener genutzt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez-la en haut et les gens doivent changer de prise à chaque toucher, donc elle est d'autant moins utilisée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostalo in alto e le persone devono cambiare la presa a ogni tocco, quindi lo usano molto meno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova para o topo e as pessoas precisam mudar a pegada a cada toque, então usam muito menos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายไปด้านบน แล้วคนต้องเปลี่ยนการจับทุกครั้งที่แตะ จึงถูกใช้น้อยลงตามนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển nó lên trên thì người ta phải đổi cách cầm mỗi lần chạm, nên nó ít được dùng đi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přesuňte to nahoru a lidé musejí při každém klepnutí měnit úchop, takže se to používá o to méně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyt det til toppen, og folk må ændre greb hver gang, de trykker på det, så det bruges så meget mindre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετακίνησέ το πάνω και οι άνθρωποι πρέπει να αλλάζουν πιάσιμο κάθε φορά που το πατούν, οπότε χρησιμοποιείται τόσο λιγότερο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirrä se ylös, niin ihmisten täytyy vaihtaa otetta joka kerta napauttaessaan sitä, joten sitä käytetään sitä vähemmän."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan ke atas dan orang harus mengubah genggaman setiap kali mengetuknya, sehingga ia dipakai lebih jarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytt den øverst, og folk må skifte grep hver gang de trykker på den, så den brukes desto mindre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats het naar boven en mensen moeten elke keer hun greep verschuiven als ze erop tikken, dus wordt het veel minder gebruikt."
          }
        }
      }
    },
    "상단의 필터 칩은 시스템 툴바가 아니라 **직접 만든 바**입니다. 눌러서 목록을 걸러보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filter chips at the top aren't a system toolbar, they're **a custom-built bar**. Tap them to filter the list."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The filter chips at the top aren't a system toolbar, they're **a custom-built bar**. Tap them to filter the list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部のフィルタチップはシステムのツールバーではなく、**自作のバー**です。押してリストを絞り込んでみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단의 필터 칩은 시스템 툴바가 아니라 **직접 만든 바**입니다. 눌러서 목록을 걸러보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部的筛选标签不是系统工具栏，而是**自己做的栏**。点按它来筛选列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂部的篩選標籤不是系統工具列，而是**自己做的列**。輕點它來篩選列表。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фильтры-чипы вверху - это не системная панель инструментов, а **самодельная панель**. Нажимайте на них, чтобы фильтровать список."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chips de filtro de arriba no son una barra de herramientas del sistema, son **una barra construida a medida**. Tócalos para filtrar la lista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Filter-Chips oben sind keine Systemleiste, sondern **eine selbstgebaute Leiste**. Tippe sie an, um die Liste zu filtern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les puces de filtre en haut ne sont pas une barre d'outils système, c'est **une barre construite sur mesure**. Touchez-les pour filtrer la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I chip di filtro in alto non sono una barra degli strumenti di sistema, sono **una barra costruita su misura**. Toccali per filtrare l'elenco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os chips de filtro no topo não são uma barra de ferramentas do sistema, são **uma barra construída sob medida**. Toque neles para filtrar a lista."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชิปตัวกรองด้านบนไม่ใช่แถบเครื่องมือของระบบ แต่เป็น**แถบที่สร้างเอง** แตะเพื่อกรองรายการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chip bộ lọc ở trên cùng không phải thanh công cụ hệ thống, chúng là **một thanh tự xây**. Chạm vào để lọc danh sách."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrační čipy nahoře nejsou systémový panel nástrojů, je to **vlastní panel**. Klepněte na ně a seznam se vyfiltruje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filterchipsene øverst er ikke en systemværktøjslinje, de er **en selvbygget bjælke**. Tryk på dem for at filtrere listen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα φίλτρα στην κορυφή δεν είναι γραμμή εργαλείων του συστήματος, είναι **μια προσαρμοσμένη γραμμή**. Πάτησέ τα για να φιλτράρεις τη λίστα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ylhäällä olevat suodatinchipit eivät ole järjestelmän työkalupalkki, vaan **mukautettu palkki**. Napauta niitä suodattaaksesi luetteloa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chip filter di atas bukan bilah alat sistem, melainkan **bilah buatan sendiri**. Ketuk untuk menyaring daftar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filterbrikkene øverst er ikke en systemverktøylinje, de er **en egendefinert linje**. Trykk på dem for å filtrere listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De filterchips bovenaan zijn geen systeemwerkbalk, het is **een zelfgebouwde balk**. Tik erop om de lijst te filteren."
          }
        }
      }
    },
    "상단이 비면 허전해서 버튼을 채운 것이다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The top felt empty, so it was filled with buttons"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The top felt empty, so it was filled with buttons"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部が空いていると物足りないので、ボタンで埋めたのだ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단이 비면 허전해서 버튼을 채운 것이다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部空着觉得空，所以填上了按钮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂部空著覺得空，所以填上了按鈕"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверху показалось пусто, поэтому заполнили кнопками"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba se veía vacío, así que se llenó de botones"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben wirkte es leer, also wurde es mit Buttons gefüllt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le haut paraissait vide, donc on l'a rempli de boutons"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alto sembrava vuoto, quindi è stato riempito di pulsanti"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O topo parecia vazio, então foi preenchido com botões"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้านบนรู้สึกว่าง จึงเติมด้วยปุ่ม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phía trên thấy trống nên được lấp bằng các nút"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahoře bylo prázdno, tak se zaplnilo tlačítky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Toppen føltes tom, så den blev fyldt med knapper"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κορυφή έμοιαζε άδεια, οπότε γέμισε με κουμπιά"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yläosa tuntui tyhjältä, joten se täytettiin painikkeilla"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian atas terasa kosong, jadi diisi dengan tombol"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Toppen føltes tom, så den ble fylt med knapper"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bovenkant voelde leeg, dus is hij gevuld met knoppen"
          }
        }
      }
    },
    "상단이 제목으로 차 있어서 남는 자리가 아래뿐이었다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The top was taken up by the title, so the only space left was at the bottom"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The top was taken up by the title, so the only space left was at the bottom"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部がタイトルで埋まっていて、残る場所が下しかなかった"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단이 제목으로 차 있어서 남는 자리가 아래뿐이었다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部被标题占满了，剩下的位置只有下面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂部被標題佔滿了，剩下的位置只有下面"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верх был занят заголовком, поэтому оставалось только место внизу"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte superior la ocupaba el título, así que el único espacio que quedaba estaba abajo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben nahm der Titel den Platz ein, sodass nur unten noch Platz blieb"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le haut était occupé par le titre, donc il ne restait de la place qu'en bas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alto era occupato dal titolo, quindi lo spazio rimasto era solo in basso"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O topo estava ocupado pelo título, então o único espaço que sobrou era embaixo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้านบนถูกชื่อเรื่องยึดไว้ จึงเหลือที่ว่างแค่ด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phía trên bị tiêu đề chiếm, nên chỉ còn chỗ ở dưới"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Horní část zabíral nadpis, takže zbylo místo jen dole"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Toppen var optaget af titlen, så den eneste plads, der var tilbage, var nederst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κορυφή καταλήφθηκε από τον τίτλο, οπότε ο μόνος χώρος που έμεινε ήταν κάτω"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yläosan vei otsikko, joten ainoa jäljelle jäänyt tila oli alhaalla"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian atas dipakai judul, jadi satu-satunya ruang tersisa ada di bawah"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Toppen var tatt av tittelen, så den eneste plassen igjen var nederst"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bovenkant werd ingenomen door de titel, dus bleef alleen onderaan ruimte over"
          }
        }
      }
    },
    "상단이 확정 액션 하나 ↔ 삭제·정렬·편집 한 캡슐로 바뀌었습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The top changed from one committing action ↔ to Delete, Sort and Edit in one capsule."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The top changed from one committing action ↔ to Delete, Sort and Edit in one capsule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上部が確定のアクション1つ ↔ 削除・並べ替え・編集の1つのカプセルに変わりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상단이 확정 액션 하나 ↔ 삭제·정렬·편집 한 캡슐로 바뀌었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顶部变成：一个确认操作 ↔ 删除、排序、编辑放在一个胶囊里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頂部變成：一個確認操作 ↔ 刪除、排序、編輯放在一個膠囊裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верх изменился: одно подтверждающее действие ↔ «Удалить», «Сортировка» и «Изменить» в одной капсуле."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte superior pasó de una acción de confirmación ↔ a Eliminar, Ordenar y Editar en una cápsula."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben wechselte von einer bestätigenden Aktion ↔ zu Löschen, Sortieren und Bearbeiten in einer Kapsel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le haut est passé d'une seule action de validation ↔ à Supprimer, Trier et Modifier dans une capsule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'alto è passato da un'unica azione di conferma ↔ a Elimina, Ordina e Modifica in una capsula."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O topo mudou de uma única ação de confirmação ↔ para Excluir, Ordenar e Editar numa cápsula."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้านบนเปลี่ยนจากการกระทำเพื่อยืนยันอย่างเดียว ↔ เป็นลบ เรียงลำดับ และแก้ไขในแคปซูลเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phía trên đổi từ một hành động xác nhận ↔ sang Xóa, Sắp xếp và Sửa trong một capsule."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahoře se změnila jedna potvrzující akce ↔ na Smazat, Seřadit a Upravit v jedné kapsli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Toppen ændrede sig fra én bekræftende handling ↔ til Slet, Sortér og Rediger i én kapsel."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κορυφή άλλαξε από μία δεσμευτική ενέργεια ↔ σε Διαγραφή, Ταξινόμηση και Επεξεργασία σε μία κάψουλα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yläosa muuttui yhdestä sitovasta toiminnosta ↔ Poista, Lajittele ja Muokkaa yhdessä kapselissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian atas berubah dari satu aksi komit ↔ menjadi Hapus, Urutkan, dan Ubah dalam satu kapsul."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Toppen endret seg fra én bekreftende handling ↔ til Slett, Sorter og Rediger i én kapsel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bovenkant veranderde van één vastleggende actie ↔ naar Verwijder, Sorteer en Wijzig in één capsule."
          }
        }
      }
    },
