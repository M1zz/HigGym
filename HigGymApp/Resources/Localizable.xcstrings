    "결제 중에도 탭바가 살아 있음 ↔ 탭바를 숨기고 취소에 확인을 붙임.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab bar stays live during checkout ↔ tab bar hidden and Cancel asks for confirmation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab bar stays live during checkout ↔ tab bar hidden and Cancel asks for confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い中もタブバーが生きている ↔ タブバーを隠し、キャンセルに確認を付けた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 중에도 탭바가 살아 있음 ↔ 탭바를 숨기고 취소에 확인을 붙임."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支付过程中标签栏仍然存在 ↔ 隐藏标签栏，并在取消时加以确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款過程中標籤列仍然存在 ↔ 隱藏標籤列，並在取消時加以確認。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель вкладок остаётся активной при оформлении ↔ панель вкладок скрыта, а отмена просит подтверждения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de pestañas sigue activa durante el pago ↔ barra de pestañas oculta y Cancelar pide confirmación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab-Leiste bleibt beim Bezahlen aktiv ↔ Tab-Leiste ausgeblendet und Abbrechen fragt nach Bestätigung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre d'onglets active pendant le paiement ↔ barre d'onglets masquée et Annuler demande confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra delle schede attiva durante il pagamento ↔ barra delle schede nascosta e Annulla chiede conferma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra de abas ativa durante a finalização ↔ barra de abas oculta e Cancelar pede confirmação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบแท็บยังใช้งานได้ระหว่างชำระเงิน ↔ ซ่อนแถบแท็บและยกเลิกจะขอยืนยัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh tab vẫn hoạt động trong lúc thanh toán ↔ thanh tab bị ẩn và Hủy hỏi xác nhận."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel karet zůstává aktivní během platby ↔ panel karet skrytý a Zrušit se ptá na potvrzení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen forbliver aktiv under betaling ↔ fanelinjen skjult og Annuller beder om bekræftelse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η γραμμή καρτελών μένει ενεργή κατά το ταμείο ↔ η γραμμή καρτελών κρυμμένη και η Ακύρωση ζητά επιβεβαίωση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välilehtipalkki pysyy aktiivisena kassalla ↔ välilehtipalkki piilotettu ja Peruuta pyytää vahvistuksen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah tab tetap aktif saat pembayaran ↔ bilah tab disembunyikan dan Batal meminta konfirmasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanelinjen er aktiv under kassen ↔ fanelinjen skjult og Avbryt ber om bekreftelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabbalk blijft actief tijdens afrekenen ↔ tabbalk verborgen en Annuleer vraagt om bevestiging."
          }
        }
      }
    },
