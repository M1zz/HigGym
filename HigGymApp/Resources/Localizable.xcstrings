    "내용 오류나 다뤄 줬으면 하는 화면이 있으면 알려 주세요. 메일에는 기기 모델과 iOS 버전을 함께 적어 주시면 빨리 확인할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let us know about errors in the content or screens you'd like covered. Including your device model and iOS version in the email helps us look into it quickly."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Let us know about errors in the content or screens you'd like covered. Including your device model and iOS version in the email helps us look into it quickly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容の誤りや取り上げてほしい画面があれば教えてください。メールにデバイスのモデルとiOSのバージョンを書いていただくと、早く確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용 오류나 다뤄 줬으면 하는 화면이 있으면 알려 주세요. 메일에는 기기 모델과 iOS 버전을 함께 적어 주시면 빨리 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果发现内容有误，或者希望我们讲解某个界面，请告诉我们。邮件里附上设备型号和 iOS 版本，我们能更快确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果發現內容有誤，或者希望我們講解某個介面，請告訴我們。郵件裡附上裝置型號和 iOS 版本，我們能更快確認。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщите нам об ошибках в содержимом или об экранах, которые стоит разобрать. Если указать в письме модель устройства и версию iOS, мы быстрее разберёмся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos los errores en el contenido o las pantallas que te gustaría que cubriéramos. Incluir en el correo el modelo de tu dispositivo y la versión de iOS nos ayuda a investigarlo rápido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile uns Fehler im Inhalt oder Bildschirme mit, die wir behandeln sollen. Gib in der E-Mail Gerätemodell und iOS-Version an, damit wir schnell nachgehen können."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalez-nous les erreurs de contenu ou les écrans que vous aimeriez voir traités. Indiquer le modèle de votre appareil et la version d'iOS dans l'e-mail nous aide à enquêter rapidement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facci sapere errori nei contenuti o schermate che vorresti vedere trattate. Indicare nell'e-mail il modello del dispositivo e la versione di iOS ci aiuta a verificare in fretta."
          }
        }
      }
    },
    "내용이 커지면 어떻게 되는지도 확인해 보세요. 커스텀 높이는 내용과 어긋나기 쉽습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also check what happens when the content grows. Custom heights easily fall out of sync with the content."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Also check what happens when the content grows. Custom heights easily fall out of sync with the content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が増えたらどうなるかも確かめてみてください。カスタムの高さは内容とずれやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 커지면 어떻게 되는지도 확인해 보세요. 커스텀 높이는 내용과 어긋나기 쉽습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也请确认内容变大后会怎样。自定义高度很容易和内容错位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也請確認內容變大後會怎樣。自定義高度很容易和內容錯位。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте и то, что будет, когда содержимое вырастет. Пользовательская высота легко расходится с содержимым."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba también qué ocurre cuando el contenido crece. Las alturas personalizadas se desfasan fácilmente del contenido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe auch, was passiert, wenn der Inhalt wächst. Eigene Höhen geraten leicht aus dem Takt mit dem Inhalt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez aussi ce qui se passe quand le contenu grossit. Les hauteurs personnalisées se désynchronisent facilement du contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla anche cosa succede quando il contenuto cresce. Le altezze personalizzate si disallineano facilmente dal contenuto."
          }
        }
      }
    },
