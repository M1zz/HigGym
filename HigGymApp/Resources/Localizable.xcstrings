    "실제 렌더링": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actual rendering"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の表示"
          }
