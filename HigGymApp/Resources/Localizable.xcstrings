          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välilehti, jota ihminen ei ole avannut pitkään aikaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab yang sudah lama tidak dibuka orang itu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En fane personen ikke har åpnet på lenge"
