            "state": "translated",
            "value": "頻度"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頻率"
          }
        },
        "ru": {
