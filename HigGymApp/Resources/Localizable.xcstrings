            "state": "translated",
            "value": "Questo stato persiste tra le schede"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este estado persiste entre as abas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถานะนี้คงอยู่ข้ามแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái này được giữ qua các tab"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento stav přetrvává napříč kartami"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tilstand består på tværs af faner"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η κατάσταση διατηρείται σε όλες τις καρτέλες"
