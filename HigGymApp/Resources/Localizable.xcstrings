    "임시 컨텍스트 전환. 얼마나 덮느냐(detent)가 곧 “원본과의 관계”를 말합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary context switch. How much it covers (the detent) tells you its “relationship to the original.”"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary context switch. How much it covers (the detent) tells you its “relationship to the original.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的なコンテキストの切り替え。どれだけ覆うか（detent）が、そのまま「元の画面との関係」を表します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 컨텍스트 전환. 얼마나 덮느냐(detent)가 곧 “원본과의 관계”를 말합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时切换上下文。覆盖多少（detent）本身就在说“与原件的关系”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "臨時切換上下文。覆蓋多少（detent）本身就在說「與原件的關係」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временное переключение контекста. То, насколько он закрывает (detent), говорит о его «отношении к оригиналу»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cambio temporal de contexto. Cuánto cubre (el detent) te dice su «relación con el original»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein vorübergehender Kontextwechsel. Wie viel er abdeckt (der Detent), verrät seine „Beziehung zum Original“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un changement de contexte temporaire. L'étendue qu'il recouvre (le detent) indique sa « relation avec l'original »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cambio di contesto temporaneo. Quanto copre (il detent) ti dice la sua «relazione con l'originale»."
          }
        }
      }
    },
