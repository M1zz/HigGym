    "날짜를 문자열로 조립하지 않고 값으로 들고 있다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds the date as a value instead of assembling it into a string."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Holds the date as a value instead of assembling it into a string."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付を文字列で組み立てず、値として持っている。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜를 문자열로 조립하지 않고 값으로 들고 있다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不把日期拼成字符串，而是保存为值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不把日期拼成字串，而是儲存為值。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранит дату как значение, а не собирает её в строку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la fecha como valor en lugar de montarla en una cadena."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält das Datum als Wert, statt es zu einer Zeichenfolge zusammenzusetzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde la date comme une valeur au lieu de l'assembler dans une chaîne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene la data come valore invece di assemblarla in una stringa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda a data como valor em vez de montá-la numa string."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บวันที่เป็นค่า แทนที่จะประกอบเป็นสตริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ ngày dưới dạng giá trị thay vì ghép thành chuỗi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drží datum jako hodnotu místo sestavování do řetězce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rummer datoen som en værdi i stedet for at sætte den sammen til en streng."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατά την ημερομηνία ως τιμή αντί να τη συναρμολογεί σε συμβολοσειρά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitää päivämäärän arvona sen sijaan, että kokoaisi sen merkkijonoksi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan tanggal sebagai nilai alih-alih merangkainya menjadi string."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holder datoen som en verdi i stedet for å sette den sammen til en streng."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart de datum als waarde in plaats van hem in een string samen te stellen."
          }
        }
      }
    },
    "남긴 것은 이 화면에서 실제로 쓰는 액션뿐입니다. 콘텐츠가 화면의 주인으로 돌아왔습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All that's left are the actions this screen actually uses. The content is back in charge of the screen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All that's left are the actions this screen actually uses. The content is back in charge of the screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残したのはこの画面で実際に使うアクションだけです。コンテンツが画面の主役に戻りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남긴 것은 이 화면에서 실제로 쓰는 액션뿐입니다. 콘텐츠가 화면의 주인으로 돌아왔습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留下的只有这个界面里真正会用到的操作。内容重新成为界面的主角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留下的只有這個介面裡真正會用到的操作。內容重新成為介面的主角。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остались только действия, которые этот экран действительно использует. Контент снова хозяин экрана."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quedan las acciones que esta pantalla realmente usa. El contenido vuelve a mandar en la pantalla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übrig bleiben nur die Aktionen, die dieser Bildschirm wirklich nutzt. Der Inhalt führt den Bildschirm wieder an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste que les actions que cet écran utilise vraiment. Le contenu reprend la main sur l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano solo le azioni che questa schermata usa davvero. Il contenuto torna a comandare la schermata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobram só as ações que esta tela realmente usa. O conteúdo volta a comandar a tela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เหลือเพียงการกระทำที่หน้าจอนี้ใช้จริง เนื้อหากลับมาเป็นผู้คุมหน้าจออีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ còn lại những hành động màn hình này thật sự dùng. Nội dung lại là người làm chủ màn hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývají jen akce, které tato obrazovka skutečně používá. Obsah znovu vládne obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbage er kun de handlinger, denne skærm faktisk bruger. Indholdet har igen styringen over skærmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απομένουν μόνο οι ενέργειες που χρησιμοποιεί πραγματικά αυτή η οθόνη. Το περιεχόμενο ξαναπαίρνει τον έλεγχο της οθόνης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäljelle jäävät vain toiminnot, joita tämä näkymä todella käyttää. Sisältö on taas näkymän vastuulla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang tersisa hanyalah aksi yang benar-benar dipakai layar ini. Konten kembali memegang kendali layar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det som er igjen er handlingene denne skjermen faktisk bruker. Innholdet har overtatt skjermen igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat overblijft zijn de acties die dit scherm echt gebruikt. De inhoud heeft het scherm weer in handen."
          }
        }
      }
    },
    "남는 자리를 채운 게 아니라, 그 자리를 이 액션에 준 것입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not filling a leftover spot, it's giving that spot to this action."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not filling a leftover spot, it's giving that spot to this action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いた場所を埋めたのではなく、その場所をこのアクションに与えたのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남는 자리를 채운 게 아니라, 그 자리를 이 액션에 준 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是把剩下的位置填满，而是把那个位置交给了这个操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不是把剩下的位置填滿，而是把那個位置交給了這個操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не заполнение оставшегося места, а передача этого места данному действию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está rellenando un sitio sobrante, le está dando ese sitio a esta acción."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es füllt keinen übrig gebliebenen Platz, sondern gibt diesen Platz dieser Aktion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un emplacement restant que l'on remplit, c'est cet emplacement que l'on donne à cette action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sta riempiendo un posto avanzato, sta dando quel posto a questa azione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está preenchendo um lugar que sobrou, está entregando esse lugar a esta ação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้เติมตำแหน่งที่เหลือ แต่มอบตำแหน่งนั้นให้การกระทำนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó không lấp một vị trí còn thừa, nó trao vị trí đó cho hành động này."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevyplňuje to zbylé místo, dává to místo této akci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fylder ikke en overskydende plads, den giver pladsen til denne handling."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν γεμίζει μια θέση που περίσσεψε, δίνει αυτή τη θέση σε αυτή την ενέργεια."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei täytä ylijäänyttä paikkaa, vaan antaa paikan tälle toiminnolle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia tidak mengisi tempat sisa, ia memberikan tempat itu kepada aksi ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fyller ikke en overskuddsplass, den gir plassen til denne handlingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vult geen overgebleven plek, het geeft die plek aan deze actie."
          }
        }
      }
    },
    "남은 콘텐츠 영역이 얼마나 좁아졌는지 보세요, 바를 하나 더 놓을 때마다 치르는 비용입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See how much the remaining content area has shrunk. That's the cost of every extra bar you add."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "See how much the remaining content area has shrunk. That's the cost of every extra bar you add."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残ったコンテンツ領域がどれだけ狭くなったか見てください。バーをひとつ増やすたびに払うコストです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 콘텐츠 영역이 얼마나 좁아졌는지 보세요, 바를 하나 더 놓을 때마다 치르는 비용입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看剩下的内容区域变窄了多少：每多放一个栏都要付出这个代价。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看剩下的內容區域變窄了多少：每多放一個列都要付出這個代價。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, насколько сузилась оставшаяся область контента. Такова цена каждой дополнительной панели."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira cuánto se ha reducido el área de contenido restante. Ese es el coste de cada barra extra que añades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wie stark der verbleibende Inhaltsbereich geschrumpft ist. Das ist der Preis jeder zusätzlichen Leiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez de combien la zone de contenu restante a rétréci. C'est le coût de chaque barre supplémentaire que vous ajoutez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda quanto si è ristretta l'area di contenuto rimasta. È il costo di ogni barra in più che aggiungi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja quanto a área de conteúdo restante encolheu. Esse é o custo de cada barra extra que você adiciona."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูว่าพื้นที่เนื้อหาที่เหลือหดลงเท่าไร นั่นคือต้นทุนของทุกแถบที่เพิ่มเข้ามา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem vùng nội dung còn lại đã co lại bao nhiêu. Đó là cái giá của mỗi thanh bạn thêm vào."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se, o kolik se zmenšila zbývající plocha obsahu. To je cena každého dalšího panelu, který přidáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvor meget det resterende indholdsområde er skrumpet. Det er prisen for hver ekstra bjælke, du tilføjer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δες πόσο έχει μικρύνει η υπόλοιπη περιοχή περιεχομένου. Αυτό είναι το κόστος κάθε επιπλέον γραμμής που προσθέτεις."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso, kuinka paljon jäljellä oleva sisältöalue on kutistunut. Se on jokaisen lisäämäsi palkin hinta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat seberapa banyak area konten yang tersisa menyusut. Itulah biaya setiap bilah tambahan yang kamu tambahkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hvor mye av innholdsområdet som er igjen. Det er kostnaden for hver ekstra linje du legger til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijk hoeveel het resterende inhoudsgebied is gekrompen. Dat zijn de kosten van elke extra balk die je toevoegt."
          }
        }
      }
    },
    "내 바와 시스템 바가 같은 아래쪽을 나눠 쓰고 있다는 점도 확인해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also notice that your bar and the system bar are sharing the same bottom edge."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Also notice that your bar and the system bar are sharing the same bottom edge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のバーとシステムのバーが同じ下部を分け合っている点も確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 바와 시스템 바가 같은 아래쪽을 나눠 쓰고 있다는 점도 확인해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也请确认一下：你自己的栏和系统栏共用着同一块下方区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也請確認一下：你自己的列和系統列共用著同一塊下方區域。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратите внимание, что ваша панель и системная делят одну и ту же нижнюю границу."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fíjate también en que tu barra y la barra del sistema comparten el mismo borde inferior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beachte auch, dass deine Leiste und die Systemleiste denselben unteren Rand teilen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remarquez aussi que votre barre et la barre système partagent le même bord inférieur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota anche che la tua barra e la barra di sistema condividono lo stesso bordo inferiore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Note também que a sua barra e a barra do sistema estão dividindo a mesma borda inferior."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สังเกตด้วยว่าแถบของคุณกับแถบระบบใช้ขอบล่างเดียวกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cũng để ý rằng thanh của bạn và thanh hệ thống đang dùng chung mép dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všimněte si také, že váš panel a systémový panel sdílejí stejný spodní okraj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læg også mærke til, at din bjælke og systembjælken deler den samme nederste kant."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσεξε επίσης ότι η δική σου γραμμή και η γραμμή συστήματος μοιράζονται την ίδια κάτω άκρη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huomaa myös, että palkkisi ja järjestelmäpalkki jakavat saman alareunan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perhatikan juga bahwa bilahmu dan bilah sistem berbagi tepi bawah yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg også merke til at linjen din og systemlinjen deler samme nedre kant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk ook op dat jouw balk en de systeembalk dezelfde onderrand delen."
          }
        }
      }
    },
