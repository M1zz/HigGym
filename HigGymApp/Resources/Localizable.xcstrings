            "state": "translated",
            "value": "Når det er mer enn 5 faner"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer er meer dan 5 tabbladen zijn"
          }
        }
      }
    },
    "탭이 가리키는 목적지가 없습니다. \"어디로 가는가\"에 답을 못 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab doesn't point to any destination. It can't answer \"where am I going?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab doesn't point to any destination. It can't answer \"where am I going?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブが指す行き先がありません。「どこへ行くのか」に答えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭이 가리키는 목적지가 없습니다. \"어디로 가는가\"에 답을 못 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签没有指向的目的地，回答不了“要去哪里”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤沒有指向的目的地，回答不了「要去哪裡」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка не указывает ни на какое место назначения. Она не отвечает на вопрос «куда я иду?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña no apunta a ningún destino. No puede responder a «¿adónde voy?»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tab zeigt auf kein Ziel. Er kann „Wohin gehe ich?“ nicht beantworten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'onglet ne mène à aucune destination. Il ne peut pas répondre à « où vais-je ? »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda non punta a nessuna destinazione. Non sa rispondere a «dove sto andando?»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aba não aponta para nenhum destino. Não consegue responder «para onde vou?»"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แท็บไม่ชี้ไปยังจุดหมายใด มันตอบ \"ฉันจะไปไหน\" ไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab không trỏ đến điểm đến nào. Nó không trả lời được \"tôi đang đi đâu?\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta nevede k žádnému cíli. Neodpoví na „kam jdu?“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanen peger ikke på nogen destination. Den kan ikke svare på »hvor skal jeg hen?«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η καρτέλα δεν δείχνει σε κανέναν προορισμό. Δεν μπορεί να απαντήσει «πού πηγαίνω;»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välilehti ei osoita mihinkään määränpäähän. Se ei osaa vastata kysymykseen ”minne olen menossa?”"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab tidak menunjuk ke tujuan mana pun. Ia tidak bisa menjawab \"ke mana aku pergi?\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanen peker ikke til noen destinasjon. Den kan ikke svare på «hvor skal jeg?»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het tabblad wijst naar geen enkele bestemming. Het kan \"waar ga ik heen?\" niet beantwoorden."
          }
        }
      }
    },
    "탭이 넘칠 때 의심할 것": {
      "localizations": {
        "en": {
