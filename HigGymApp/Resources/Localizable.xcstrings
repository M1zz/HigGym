    "줄을 몇 개 추가한 뒤 왼쪽 **실행취소 / 다시실행**을 눌러보세요, 실제로 되돌아갑니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a few lines, then tap **Undo / Redo** on the left. It really goes back."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a few lines, then tap **Undo / Redo** on the left. It really goes back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行をいくつか追加してから、左の**取り消す / やり直す**をタップしてみてください。実際に元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄을 몇 개 추가한 뒤 왼쪽 **실행취소 / 다시실행**을 눌러보세요, 실제로 되돌아갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加几行之后，点按左侧的**撤销 / 重做**，真的会撤回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增幾行之後，輕點左側的**撤銷 / 重做**，真的會撤回。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте несколько строк, а затем нажмите **«Отменить / Повторить»** слева. Всё действительно откатывается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade unas líneas y luego toca **Deshacer / Rehacer** a la izquierda. De verdad retrocede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein paar Zeilen hinzu und tippe dann links auf **Widerrufen / Wiederholen**. Es geht wirklich zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez quelques lignes, puis touchez **Annuler / Rétablir** à gauche. Il revient vraiment en arrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qualche riga, poi tocca **Annulla / Ripeti** a sinistra. Torna davvero indietro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione algumas linhas, depois toque em **Desfazer / Refazer** à esquerda. Ele realmente volta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มสองสามเส้น แล้วแตะ**เลิกทำ / ทำซ้ำ**ทางซ้าย มันย้อนกลับจริง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm vài dòng, rồi chạm **Hoàn tác / Làm lại** bên trái. Nó thật sự quay lại."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte pár řádků, pak vlevo klepněte na **Zpět / Opakovat**. Opravdu to vrací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj et par linjer, og tryk så på **Fortryd / Gentag** til venstre. Det går virkelig tilbage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε μερικές γραμμές και μετά πάτησε **Αναίρεση / Επανάληψη** στα αριστερά. Πράγματι γυρίζει πίσω."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää muutama rivi ja napauta sitten vasemmalla **Kumoa / Tee uudelleen**. Se todella palaa taaksepäin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah beberapa baris, lalu ketuk **Urungkan / Ulangi** di kiri. Ia benar-benar kembali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til noen linjer, og trykk deretter på **Angre / Gjør om** til venstre. Den går faktisk tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een paar regels toe en tik dan links op **Maak ongedaan / Opnieuw**. Het gaat echt terug."
          }
        }
      }
    },
    "중앙 세그먼트로 화면을 바꾸고, 오른쪽 **⋯** 메뉴도 열어보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch screens with the center segment, and open the **⋯** menu on the right too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch screens with the centre segment, and open the **⋯** menu on the right too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央のセグメントで画面を切り替え、右の「⋯」メニューも開いてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중앙 세그먼트로 화면을 바꾸고, 오른쪽 **⋯** 메뉴도 열어보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用中间的分段切换界面，也打开右侧的 **⋯** 菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用中間的分段切換介面，也開啟右側的 **⋯** 選單。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключайте экраны центральным сегментом и откройте также меню **⋯** справа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de pantalla con el segmento central y abre también el menú **⋯** de la derecha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle die Bildschirme mit dem Segment in der Mitte und öffne auch das Menü **⋯** rechts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez d'écran avec le segment du centre, et ouvrez aussi le menu **⋯** à droite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia schermata con il segmento centrale e apri anche il menu **⋯** a destra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque de tela com o segmento central e abra também o menu **⋯** à direita."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับหน้าจอด้วยเซกเมนต์กลาง และเปิดเมนู **⋯** ทางขวาด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển màn hình bằng phân đoạn ở giữa, và mở cả menu **⋯** bên phải."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínejte obrazovky prostředním segmentem a otevřete i nabídku **⋯** vpravo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift skærm med segmentet i midten, og åbn også menuen **⋯** til højre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε οθόνες με το κεντρικό τμήμα και άνοιξε και το μενού **⋯** στα δεξιά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda näkymiä keskisegmentillä ja avaa myös oikealla oleva **⋯**-valikko."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti layar dengan segmen tengah, dan buka juga menu **⋯** di kanan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt skjerm med midtsegmentet, og åpne også **⋯**-menyen til høyre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel van scherm met het middelste segment en open ook het menu **⋯** rechts."
          }
        }
      }
    },
