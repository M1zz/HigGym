          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Scrivi**, l'azione più usata, sta in cima alla schermata. Toccala 5 volte con una mano."
          }
        }
      }
    },
    "가장 자주 하는 일은 어디에 두는가": {
