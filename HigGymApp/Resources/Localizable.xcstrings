          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอฟเฟกต์ขอบใช้กับแถบระบบเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiệu ứng cạnh chỉ áp dụng cho thanh hệ thống"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okrajový efekt platí jen pro systémové panely"
          }
        },
        "da": {
