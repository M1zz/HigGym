    "**%@**처럼 자주 반복하는 액션을 하단에 둔 것은 빈도·높이 반비례 기준에 맞습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting a frequently repeated action like **%@** at the bottom follows the rule that frequency and height are inversely related."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting a frequently repeated action like **%@** at the bottom follows the rule that frequency and height are inversely related."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@**のように頻繁に繰り返すアクションを下部に置くのは、頻度と高さを反比例させる基準に合っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**%@**처럼 자주 반복하는 액션을 하단에 둔 것은 빈도·높이 반비례 기준에 맞습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把像 **%@** 这样频繁重复的操作放在底部，符合“频率与高度成反比”的标准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把像 **%@** 這樣頻繁重複的操作放在底部，符合「頻率與高度成反比」的標準。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размещение внизу часто повторяемого действия вроде **%@** соответствует правилу «частота обратно пропорциональна высоте»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Poner una acción que se repite con frecuencia como **%@** abajo sigue la regla de que frecuencia y altura son inversamente proporcionales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine häufig wiederholte Aktion wie **%@** unten zu platzieren folgt der Regel, dass Häufigkeit und Höhe umgekehrt zusammenhängen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placer en bas une action fréquemment répétée comme **%@** respecte la règle selon laquelle fréquence et hauteur sont inversement liées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettere in basso un'azione molto ripetuta come **%@** segue la regola secondo cui frequenza e altezza sono inversamente legate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Colocar embaixo uma ação muito repetida como **%@** segue a regra de que frequência e altura são inversamente relacionadas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวางการกระทำที่ทำซ้ำบ่อยอย่าง **%@** ไว้ด้านล่างเป็นไปตามกฎที่ว่าความถี่กับความสูงควรสวนทางกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt một hành động lặp lại thường xuyên như **%@** ở dưới cùng là theo đúng quy tắc tần suất và độ cao tỉ lệ nghịch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umístit často opakovanou akci jako **%@** dolů odpovídá pravidlu, že frekvence a výška jsou v nepřímém vztahu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At placere en ofte gentaget handling som **%@** nederst følger reglen om, at frekvens og højde er omvendt forbundet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το να βάζεις μια ενέργεια που επαναλαμβάνεται συχνά όπως το **%@** κάτω ακολουθεί τον κανόνα ότι η συχνότητα και το ύψος σχετίζονται αντίστροφα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Usein toistuvan toiminnon, kuten **%@**, sijoittaminen alas noudattaa sääntöä, jonka mukaan käyttötiheys ja korkeus ovat kääntäen verrannollisia."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menaruh aksi yang sering berulang seperti **%@** di bawah mengikuti aturan bahwa frekuensi dan ketinggian berbanding terbalik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å plassere en handling som gjentas ofte, som **%@**, nederst følger regelen om at frekvens og høyde er omvendt relatert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vaak herhaalde actie als **%@** onderaan zetten volgt de regel dat frequentie en hoogte omgekeerd evenredig zijn."
          }
        }
      }
    },
    "**Dynamic Type**을 키우면 같은 폭에서 더 빨리 잘립니다. 잘림은 폰트 크기의 함수이기도 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn up **Dynamic Type** and text truncates sooner at the same width. Truncation is also a function of font size."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn up **Dynamic Type** and text truncates sooner at the same width. Truncation is also a function of font size."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dynamic Type**を大きくすると、同じ幅でもより早く切り詰められます。切り詰めはフォントサイズの関数でもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dynamic Type**을 키우면 같은 폭에서 더 빨리 잘립니다. 잘림은 폰트 크기의 함수이기도 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大 **Dynamic Type** 后，同样的宽度会更快被截断。截断也是字号的函数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大 **Dynamic Type** 後，同樣的寬度會更快被截斷。截斷也是字號的函式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При увеличении **Dynamic Type** текст обрезается быстрее при той же ширине. Обрезка зависит и от размера шрифта."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube **Dynamic Type** y el texto se trunca antes con el mismo ancho. El truncamiento también depende del tamaño de fuente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhe **Dynamic Type**, und Text wird bei gleicher Breite früher abgeschnitten. Auch das Abschneiden hängt von der Schriftgröße ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentez la **taille dynamique du texte** et le texte est tronqué plus tôt à largeur égale. La troncature dépend aussi de la taille de police."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta **Dynamic Type** e il testo viene troncato prima a parità di larghezza. Anche il troncamento dipende dalla dimensione del carattere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente o **Dynamic Type** e o texto trunca mais cedo na mesma largura. O truncamento também depende do tamanho da fonte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่ม **Dynamic Type** แล้วข้อความจะถูกตัดเร็วขึ้นที่ความกว้างเท่าเดิม การตัดข้อความจึงเป็นฟังก์ชันของขนาดตัวอักษรด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tăng **Dynamic Type** thì văn bản bị cắt sớm hơn ở cùng một độ rộng. Việc cắt cũng là một hàm của cỡ chữ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvyšte **Dynamic Type** a text se při stejné šířce ořízne dřív. Ořezávání je také funkcí velikosti písma."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skru op for **Dynamic Type**, og teksten afkortes tidligere ved samme bredde. Afkortning er også en funktion af skriftstørrelsen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αύξησε το **Dynamic Type** και το κείμενο περικόπτεται νωρίτερα στο ίδιο πλάτος. Η περικοπή εξαρτάται και από το μέγεθος γραμματοσειράς."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurenna **Dynamic Typea**, niin teksti katkeaa aiemmin samalla leveydellä. Katkeaminen riippuu myös fonttikoosta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbesar **Dynamic Type** dan teks terpotong lebih cepat pada lebar yang sama. Pemotongan juga merupakan fungsi dari ukuran font."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skru opp **Dynamic Type**, og teksten avkortes tidligere ved samme bredde. Avkorting er også en funksjon av skriftstørrelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet **Dynamic Type** hoger en tekst wordt bij dezelfde breedte eerder afgekapt. Afkappen is ook een functie van de lettergrootte."
          }
        }
      }
    },
    "**tail · middle · head**를 바꿔가며 같은 경로를 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between **tail · middle · head** and watch the same path."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch between **tail · middle · head** and watch the same path."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**tail · middle · head**を切り替えながら、同じパスを見てください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**tail · middle · head**를 바꿔가며 같은 경로를 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换 **tail · middle · head**，观察同一条路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換 **tail · middle · head**，觀察同一條路徑。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключайте **tail · middle · head** и смотрите на один и тот же путь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia entre **tail · middle · head** y observa la misma ruta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zwischen **tail · middle · head** und beobachte denselben Pfad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternez entre **tail · middle · head** et observez le même chemin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa tra **tail · middle · head** e osserva lo stesso percorso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne entre **tail · middle · head** e observe o mesmo caminho."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับระหว่าง **tail · middle · head** แล้วดูเส้นทางเดียวกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển giữa **tail · middle · head** và xem cùng một đường dẫn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínejte mezi **tail · middle · head** a sledujte stejnou cestu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift mellem **tail · middle · head** og se den samme sti."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εναλλάξου μεταξύ **tail · middle · head** και παρακολούθησε την ίδια διαδρομή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda **tail · middle · head** -tilojen välillä ja katso samaa polkua."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih antara **tail · middle · head** dan perhatikan jalur yang sama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt mellom **tail · middle · head** og se på den samme banen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel tussen **tail · middle · head** en kijk naar hetzelfde pad."
          }
        }
      }
    },
    "**“몇 개인지가 행동을 결정할 때”**만 붙입니다. 전부에 달면 인터럽트 가치가 인플레이션됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a badge only **“when the count changes what people do.”** Put one on everything and the value of an interruption gets inflated."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a badge only **“when the count changes what people do.”** Put one on everything and the value of an interruption gets inflated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**「数が行動を左右するとき**」だけ付けます。すべてに付けると、割り込みの価値がインフレを起こします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**“몇 개인지가 행동을 결정할 때”**만 붙입니다. 전부에 달면 인터럽트 가치가 인플레이션됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有“数量本身决定行动时”才加上。如果全都加，打断的价值就会通货膨胀。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有「數量本身決定行動時」才加上。如果全都加，打斷的價值就會通貨膨脹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставьте только **«когда число определяет действие»**. Если вешать везде, ценность прерывания обесценивается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una insignia solo **«cuando la cantidad cambia lo que hace la gente»**. Ponla en todo y el valor de una interrupción se infla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergib ein Badge nur, **„wenn die Anzahl ändert, was Menschen tun“.** Setzt man überall eines, wird der Wert einer Unterbrechung aufgebläht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'ajoutez un badge que **« lorsque le nombre change ce que font les gens »**. Mettez-en partout et la valeur d'une interruption est gonflée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un badge solo **«quando il numero cambia ciò che le persone fanno»**. Mettilo ovunque e il valore di un'interruzione si gonfia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um badge só **«quando a contagem muda o que as pessoas fazem».** Coloque em tudo e o valor de uma interrupção fica inflado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ป้ายตัวเลข**“เมื่อจำนวนนั้นเปลี่ยนสิ่งที่คนทำ”** เท่านั้น ถ้าใส่ทุกที่ คุณค่าของการขัดจังหวะจะเฟ้อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thêm huy hiệu **“khi con số thay đổi việc người ta làm.”** Gắn lên mọi thứ thì giá trị của sự gián đoạn bị thổi phồng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odznak přidejte jen tehdy, **„když počet mění to, co lidé dělají“.** Dejte ho na všechno a hodnota vyrušení se nafoukne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj kun en badge **»når antallet ændrer, hvad folk gør.«** Sæt en på alt, og værdien af en afbrydelse bliver pustet op."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε σήμα μόνο **«όταν ο αριθμός αλλάζει αυτό που κάνουν οι άνθρωποι».** Βάλε σε όλα και η αξία μιας διακοπής φουσκώνει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää merkki vain, **”kun määrä muuttaa sitä, mitä ihmiset tekevät”.** Jos laitat sen kaikkeen, keskeytyksen arvo paisuu liikaa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan lencana hanya **\"ketika jumlahnya mengubah apa yang dilakukan orang.\"** Pasang di semuanya, dan nilai sebuah interupsi menggelembung."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et merke bare **«når antallet endrer hva folk gjør».** Sett ett på alt, og verdien av en avbrytelse blir oppblåst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg alleen een badge toe **\"als het aantal verandert wat mensen doen.\"** Zet er een op alles en de waarde van een onderbreking wordt opgeblazen."
          }
        }
      }
    },
    "**“이 UI 요소가 지금 이 순간 과업에 기여하는가?”**, Large 타이틀은 진입 순간 “여기가 어디인지”를 알려주며 기여하지만, 읽기 시작하면 기여가 끝납니다.\n\n그 순간 공간을 콘텐츠에 반납하는 것이 Content-First. 기여 여부를 순간마다 다시 묻는 동작입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**“Is this UI element contributing to the task right now?”** A large title contributes when you arrive by telling you “where you are,” but once you start reading, its contribution ends.\n\nGiving that space back to the content at that moment is Content-First. It's the habit of asking, moment by moment, whether something still contributes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**“Is this UI element contributing to the task right now?”** A large title contributes when you arrive by telling you “where you are,” but once you start reading, its contribution ends.\n\nGiving that space back to the content at that moment is Content-First. It's the habit of asking, moment by moment, whether something still contributes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**「このUI要素は、今この瞬間のタスクに貢献しているか？」** 大きいタイトルは、画面に入った瞬間に「ここがどこか」を伝えて貢献しますが、読み始めればその貢献は終わります。\n\nその瞬間にスペースをコンテンツへ返すのがContent-Firstです。貢献しているかどうかを瞬間ごとに問い直す動作なのです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**“이 UI 요소가 지금 이 순간 과업에 기여하는가?”**, Large 타이틀은 진입 순간 “여기가 어디인지”를 알려주며 기여하지만, 읽기 시작하면 기여가 끝납니다.\n\n그 순간 공간을 콘텐츠에 반납하는 것이 Content-First. 기여 여부를 순간마다 다시 묻는 동작입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**“这个界面元素此刻对任务有贡献吗？”**，大标题在进入时告诉用户“这里是哪里”，是有贡献的，但一开始阅读，它的贡献就结束了。\n\n此刻把空间还给内容，就是 Content-First。也就是每一刻都重新追问它是否还有贡献。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**「這個介面元素此刻對任務有貢獻嗎？」**，大標題在進入時告訴使用者「這裡是哪裡」，是有貢獻的，但一開始閱讀，它的貢獻就結束了。\n\n此刻把空間還給內容，就是 Content-First。也就是每一刻都重新追問它是否還有貢獻。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**«Вносит ли этот элемент интерфейса вклад в задачу прямо сейчас?»** Крупный заголовок при входе подсказывает «где я» и тем полезен, но когда начинается чтение, его вклад заканчивается.\n\nВозвращать в этот момент место контенту - это Content-First: вопрос о вкладе задаётся заново в каждый момент."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**«¿Está contribuyendo ahora mismo este elemento de la interfaz a la tarea?»** Un título grande contribuye al llegar, al decirte «dónde estás», pero en cuanto empiezas a leer, su aportación termina.\n\nDevolver ese espacio al contenido en ese momento es Content-First. Es el hábito de preguntarse, momento a momento, si algo sigue aportando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**„Trägt dieses UI-Element gerade jetzt zur Aufgabe bei?“** Ein großer Titel trägt beim Ankommen bei, indem er dir sagt, „wo du bist“, doch sobald du zu lesen beginnst, endet sein Beitrag.\n\nIn diesem Moment den Platz an den Inhalt zurückzugeben ist Content-First. Es ist die Gewohnheit, Moment für Moment zu fragen, ob etwas noch beiträgt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**« Cet élément d'interface contribue-t-il à la tâche en ce moment ? »** Un grand titre contribue à l'arrivée en disant « où vous êtes », mais dès que vous commencez à lire, sa contribution prend fin.\n\nRendre cet espace au contenu à ce moment-là, c'est le Content-First. C'est l'habitude de se demander, à chaque instant, si quelque chose contribue encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**«Questo elemento dell'interfaccia contribuisce al compito adesso?»** Un titolo grande contribuisce all'arrivo dicendoti «dove sei», ma una volta iniziata la lettura il suo contributo finisce.\n\nRestituire quello spazio al contenuto in quel momento è Content-First. È l'abitudine di chiedersi, momento per momento, se qualcosa contribuisce ancora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**«Este elemento da interface contribui para a tarefa agora?»** Um título grande contribui quando você chega, dizendo «onde você está», mas assim que começa a ler, a contribuição acaba.\n\nDevolver esse espaço ao conteúdo naquele momento é Content-First. É o hábito de perguntar, a cada momento, se algo ainda contribui."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**“องค์ประกอบ UI นี้ช่วยงานตรงหน้าอยู่หรือไม่”** ชื่อเรื่องขนาดใหญ่ช่วยได้ตอนเข้ามา เพราะบอกว่า “คุณอยู่ที่ไหน” แต่พอเริ่มอ่าน บทบาทของมันก็จบลง\n\nการคืนพื้นที่นั้นให้เนื้อหาในจังหวะนั้นคือ Content-First เป็นนิสัยที่ถามอยู่ทุกขณะว่าสิ่งนี้ยังช่วยอยู่หรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**“Phần tử UI này có đang đóng góp cho tác vụ lúc này không?”** Tiêu đề lớn đóng góp khi bạn vừa đến, bằng cách cho biết “bạn đang ở đâu”, nhưng một khi bắt đầu đọc, đóng góp của nó chấm dứt.\n\nTrả lại không gian đó cho nội dung vào lúc ấy chính là Content-First. Đó là thói quen hỏi, từng khoảnh khắc, xem một thứ có còn đóng góp hay không."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**„Přispívá tento prvek UI právě teď k úkolu?“** Velký nadpis přispívá, když přijdete, protože říká „kde jste“, ale jakmile začnete číst, jeho příspěvek končí.\n\nVrátit v tu chvíli toto místo obsahu je Content-First. Je to zvyk ptát se v každém okamžiku, zda něco stále přispívá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**»Bidrager dette UI-element til opgaven lige nu?«** En stor titel bidrager, når du ankommer, ved at fortælle dig »hvor du er«, men når du begynder at læse, er dens bidrag slut.\n\nAt give den plads tilbage til indholdet i det øjeblik er Content-First. Det er vanen at spørge, øjeblik for øjeblik, om noget stadig bidrager."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**«Συμβάλλει αυτό το στοιχείο διεπαφής στην εργασία αυτή τη στιγμή;»** Ένας μεγάλος τίτλος συμβάλλει όταν φτάνεις, λέγοντάς σου «πού βρίσκεσαι», αλλά μόλις αρχίσεις να διαβάζεις, η συμβολή του τελειώνει.\n\nΤο να δίνεις αυτό τον χώρο πίσω στο περιεχόμενο εκείνη τη στιγμή είναι Content-First. Είναι η συνήθεια να ρωτάς, στιγμή προς στιγμή, αν κάτι εξακολουθεί να συμβάλλει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**”Edistääkö tämä käyttöliittymän elementti tehtävää juuri nyt?”** Suuri otsikko edistää saapuessasi kertomalla, ”missä olet”, mutta kun alat lukea, sen vaikutus päättyy.\n\nTilan palauttaminen sisällölle sillä hetkellä on Content-First. Se on tapa kysyä hetki hetkeltä, edistääkö jokin vielä tehtävää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**\"Apakah elemen UI ini berkontribusi pada tugas saat ini?\"** Judul besar berkontribusi saat kamu tiba dengan memberi tahu \"di mana kamu berada\", tetapi begitu kamu mulai membaca, kontribusinya berakhir.\n\nMengembalikan ruang itu ke konten pada saat itu adalah Content-First. Ini kebiasaan bertanya, dari momen ke momen, apakah sesuatu masih berkontribusi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**«Bidrar dette UI-elementet til oppgaven akkurat nå?»** En stor tittel bidrar når du kommer inn ved å fortelle deg «hvor du er», men når du begynner å lese, tar bidraget slutt.\n\nÅ gi det rommet tilbake til innholdet i det øyeblikket er innhold først. Det er vanen å spørre, øyeblikk for øyeblikk, om noe fortsatt bidrar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**\"Draagt dit UI-element nu bij aan de taak?\"** Een grote titel draagt bij als je aankomt door je te vertellen \"waar je bent\", maar zodra je begint te lezen, houdt die bijdrage op.\n\nDie ruimte op dat moment teruggeven aan de inhoud is Content-First. Het is de gewoonte om moment voor moment te vragen of iets nog bijdraagt."
          }
        }
      }
    },
    "**가장 오른쪽 탭**을 한 손으로 눌러보세요. 라벨도 읽어보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **rightmost tab** with one hand. Read the labels, too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the **rightmost tab** with one hand. Read the labels, too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**いちばん右のタブ**を片手で押してみてください。ラベルも読んでみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**가장 오른쪽 탭**을 한 손으로 눌러보세요. 라벨도 읽어보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用单手点按**最右边的标签**，再读一读标签文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用單手輕點**最右邊的標籤**，再讀一讀標籤文字。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите **самую правую вкладку** одной рукой. Прочитайте и подпись."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca la **pestaña de más a la derecha** con una sola mano. Lee también las etiquetas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe mit einer Hand auf den **ganz rechten Tab**. Lies auch die Beschriftungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez **l'onglet tout à droite** d'une seule main. Lisez aussi les libellés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca con una mano **la scheda all'estrema destra**. Leggi anche le etichette."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na **aba mais à direita** com uma mão. Leia os rótulos também."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะ**แท็บขวาสุด**ด้วยมือเดียว แล้วอ่านป้ายชื่อด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào **tab ngoài cùng bên phải** bằng một tay. Đọc cả các nhãn nữa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte jednou rukou na **kartu zcela vpravo**. Přečtěte si i popisky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på den **yderste fane til højre** med én hånd. Læs også etiketterne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε την **τελευταία δεξιά καρτέλα** με το ένα χέρι. Διάβασε και τις ετικέτες."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta **oikeanpuoleisinta välilehteä** yhdellä kädellä. Lue myös nimikkeet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk **tab paling kanan** dengan satu tangan. Baca juga labelnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på **fanen lengst til høyre** med én hånd. Les etikettene også."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik met één hand op het **meest rechtse tabblad**. Lees ook de labels."
          }
        }
      }
    },
    "**검색으로 운송장을 찾아** 보세요. 그다음 검색을 비우고 목록으로 돌아와 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Find a tracking number using search.** Then clear the search and go back to the list."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "**Find a tracking number using search.** Then clear the search and go back to the list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**検索で追跡番号を探して**みてください。そのあと検索を消して、リストに戻ってみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**검색으로 운송장을 찾아** 보세요. 그다음 검색을 비우고 목록으로 돌아와 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请**用搜索找到运单**。然后清空搜索，回到列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請**用搜尋找到運單**。然後清空搜尋，回到列表。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Найдите посылку через поиск.** Затем очистите поиск и вернитесь к списку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Busca un número de seguimiento con la búsqueda.** Luego borra la búsqueda y vuelve a la lista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Suche über die Suche nach einer Sendungsnummer.** Lösche dann die Suche und geh zurück zur Liste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Retrouvez un numéro de suivi grâce à la recherche.** Puis effacez la recherche et revenez à la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trova un numero di tracciamento usando la ricerca.** Poi cancella la ricerca e torna all'elenco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Encontre um código de rastreio usando a busca.** Depois limpe a busca e volte para a lista."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ใช้การค้นหาหาเลขพัสดุ** แล้วล้างการค้นหาและกลับไปที่รายการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tìm số vận đơn bằng tìm kiếm.** Rồi xóa tìm kiếm và quay lại danh sách."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Najděte číslo zásilky pomocí hledání.** Pak hledání smažte a vraťte se do seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Find et sporingsnummer ved hjælp af søgning.** Ryd derefter søgningen og gå tilbage til listen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "**Βρες έναν αριθμό αποστολής με την αναζήτηση.** Μετά καθάρισε την αναζήτηση και γύρνα στη λίστα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Etsi seurantanumero haulla.** Tyhjennä sitten haku ja palaa luetteloon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Temukan nomor pelacakan dengan pencarian.** Lalu hapus pencarian dan kembali ke daftar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Finn et sporingsnummer ved hjelp av søk.** Tøm deretter søket og gå tilbake til listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Zoek een trackingnummer met zoeken.** Wis daarna de zoekopdracht en ga terug naar de lijst."
          }
        }
      }
    },
    "**공간 예약**을 껐다 켜보세요, 목록의 행 높이가 들썩이는지, 고정되는지 보입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn **Reserve space** off and on: you'll see whether the list's row heights jump around or stay fixed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn **Reserve space** off and on: you'll see whether the list's row heights jump around or stay fixed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**スペースを確保**をオフ・オンしてみてください。リストの行の高さが揺れるか、固定されるかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**공간 예약**을 껐다 켜보세요, 목록의 행 높이가 들썩이는지, 고정되는지 보입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把**空间预留**关掉再打开，看看列表的行高是在跳动还是保持固定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把**空間預留**關掉再開啟，看看列表的行高是在跳動還是保持固定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите и выключите **резервирование места**: видно, прыгает ли высота строк в списке или остаётся фиксированной."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva y activa **Reservar espacio**: verás si las alturas de las filas de la lista saltan o se quedan fijas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte **Platz reservieren** aus und an: Du siehst, ob die Zeilenhöhen der Liste springen oder fest bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez puis activez **Réserver l'espace** : vous verrez si la hauteur des lignes de la liste saute ou reste fixe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva e disattiva **Riserva spazio**: vedrai se le altezze delle righe dell'elenco saltano o restano fisse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative e ative **Reservar espaço**: você verá se a altura das linhas da lista salta ou fica fixa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดและปิด**สำรองพื้นที่** แล้วคุณจะเห็นว่าความสูงของแถวในรายการกระโดดไปมาหรือคงที่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật và tắt **Dành sẵn không gian**: bạn sẽ thấy chiều cao dòng của danh sách nhảy lung tung hay đứng yên."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Rezervaci místa** vypněte a zapněte: uvidíte, zda výšky řádků seznamu poskakují, nebo zůstávají pevné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå **Reservér plads** fra og til: du kan se, om listens rækkehøjder hopper rundt eller forbliver faste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποίησε και ενεργοποίησε το **Δέσμευση χώρου**: θα δεις αν τα ύψη των γραμμών της λίστας πηδούν ή μένουν σταθερά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kytke **Varaa tila** pois ja päälle: näet, hyppivätkö luettelon rivien korkeudet vai pysyvätkö ne kiinteinä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan dan nyalakan **Sisihkan ruang**: kamu akan melihat apakah tinggi baris daftar melompat-lompat atau tetap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå **Reserver plass** av og på: du ser om radhøydene i listen hopper rundt eller holder seg faste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet **Ruimte reserveren** uit en aan: je ziet of de rijhoogtes van de lijst heen en weer springen of vast blijven."
          }
        }
      }
    },
    "**김 · 디자인 · 빌드** 중 아무거나 쳐보세요. 진짜로 걸러집니다.": {
      "localizations": {
