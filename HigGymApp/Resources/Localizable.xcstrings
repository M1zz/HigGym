        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第一個標籤右上角的**紅色 3** 就是標記。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Красная 3** справа вверху первой вкладки - это бейдж."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El **3 rojo** de arriba a la derecha de la primera pestaña es la insignia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die **rote 3** oben rechts am ersten Tab ist das Badge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le **3 rouge** en haut à droite du premier onglet est le badge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il **3 rosso** in alto a destra della prima scheda è il badge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O **3 vermelho** no canto superior direito da primeira aba é o badge."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**เลข 3 สีแดง**ที่มุมขวาบนของแท็บแรกคือป้ายตัวเลข"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Số 3 màu đỏ** ở trên cùng bên phải của tab đầu tiên là huy hiệu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Červená 3** vpravo nahoře na první kartě je odznak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det **røde 3-tal** øverst til højre på den første fane er badgen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το **κόκκινο 3** πάνω δεξιά στην πρώτη καρτέλα είναι το σήμα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäisen välilehden oikeassa yläkulmassa oleva **punainen 3** on merkki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "**Angka 3 merah** di kanan atas tab pertama adalah lencananya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det **røde 3-tallet** øverst til høyre på den første fanen er merket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De **rode 3** rechtsboven op het eerste tabblad is de badge."
          }
        }
      }
    },
