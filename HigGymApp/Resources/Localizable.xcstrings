    "금액 불일치, 표시 ₩%@ / 청구 ₩%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount mismatch: shown ₩%@ / charged ₩%@"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount mismatch: shown ₩%@ / charged ₩%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額の不一致：表示 ₩%@ / 請求 ₩%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "금액 불일치, 표시 ₩%1$@ / 청구 ₩%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额不一致，显示 ¥%1$@ / 扣款 ¥%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金額不一致，顯示 NT$%1$@ / 扣款 NT$%2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Суммы расходятся: показано %1$@ ₽ / списано %2$@ ₽"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe no coincide: mostrado %1$@ € / cobrado %2$@ €"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betrag stimmt nicht überein: angezeigt %1$@ € / abgebucht %2$@ €"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montant discordant : affiché %1$@ € / débité %2$@ €"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importo non corrispondente: mostrato %1$@ € / addebitato %2$@ €"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divergência de valor: exibido R$ %1$@ / cobrado R$ %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเงินไม่ตรงกัน: แสดง ฿%1$@ / เรียกเก็บ ฿%2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số tiền không khớp: hiển thị %1$@ ₫ / bị tính %2$@ ₫"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesoulad částky: zobrazeno %1$@ Kč / účtováno %2$@ Kč"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beløbsafvigelse: vist %1$@ kr. / opkrævet %2$@ kr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ασυμφωνία ποσού: εμφανίστηκε %1$@ € / χρεώθηκε %2$@ €"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Summa ei täsmää: näytetty %1$@ € / veloitettu %2$@ €"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah tidak cocok: ditampilkan Rp%1$@ / ditagih Rp%2$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beløpsavvik: vist kr %1$@ / belastet kr %2$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedrag komt niet overeen: getoond € %1$@ / afgeschreven € %2$@"
          }
        }
      }
    },
    "금액을 정확히 읽을 수 있었나요? 못 읽었다면 이 화면은 사용자에게 무엇이라고 말한 걸까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could you read the amount exactly? If not, what was this screen telling the user?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Could you read the amount exactly? If not, what was this screen telling the user?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額を正確に読めましたか？読めなかったなら、この画面はユーザーに何と言ったのでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액을 정확히 읽을 수 있었나요? 못 읽었다면 이 화면은 사용자에게 무엇이라고 말한 걸까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你能准确读出金额吗？如果读不出来，这个界面对用户说了什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你能準確讀出金額嗎？如果讀不出來，這個介面對使用者說了什麼？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смогли ли вы точно прочитать сумму? Если нет, что этот экран сообщал пользователю?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Pudiste leer el importe exactamente? Si no, ¿qué le estaba diciendo esta pantalla al usuario?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konntest du den Betrag genau lesen? Wenn nicht, was hat dieser Bildschirm dem Nutzer gesagt?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous pu lire exactement le montant ? Sinon, que disait cet écran à l'utilisateur ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai potuto leggere esattamente l'importo? In caso contrario, che cosa diceva questa schermata all'utente?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você conseguiu ler o valor exatamente? Se não, o que esta tela estava dizendo ao usuário?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอ่านจำนวนเงินได้ตรงเป๊ะไหม ถ้าไม่ได้ หน้าจอนี้กำลังบอกอะไรผู้ใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có đọc chính xác được số tiền không? Nếu không, màn hình này đang nói gì với người dùng?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokázali jste přesně přečíst částku? Pokud ne, co tato obrazovka sdělovala uživateli?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne du læse beløbet præcist? Hvis ikke, hvad fortalte denne skærm brugeren?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπόρεσες να διαβάσεις το ποσό με ακρίβεια; Αν όχι, τι έλεγε αυτή η οθόνη στον χρήστη;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pystyitkö lukemaan summan tarkasti? Jos et, mitä tämä näkymä kertoi käyttäjälle?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisakah kamu membaca jumlahnya dengan tepat? Jika tidak, apa yang disampaikan layar ini kepada pengguna?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne du lese beløpet nøyaktig? Hvis ikke, hva fortalte denne skjermen brukeren?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon je het bedrag precies lezen? Zo niet, wat vertelde dit scherm de gebruiker?"
          }
        }
      }
    },
    "기능은 양쪽이 똑같습니다. 달라진 건 **묶는 방법**뿐입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The features are identical on both sides. The only thing that changed is **how they're grouped**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The features are identical on both sides. The only thing that changed is **how they're grouped**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機能はどちらも同じです。変わったのは**まとめ方**だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기능은 양쪽이 똑같습니다. 달라진 건 **묶는 방법**뿐입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两边的功能完全一样。变的只有**分组的方式**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩邊的功能完全一樣。變的只有**分組的方式**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функции с обеих сторон одинаковы. Изменилось только **то, как они сгруппированы**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones son idénticas en ambos lados. Lo único que cambió es **cómo están agrupadas**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Funktionen sind auf beiden Seiten identisch. Das Einzige, was sich geändert hat, ist **wie sie gruppiert sind**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctions sont identiques des deux côtés. La seule chose qui a changé, c'est **la façon dont elles sont regroupées**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzioni sono identiche da entrambi i lati. L'unica cosa cambiata è **il modo in cui sono raggruppate**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As funcionalidades são idênticas dos dois lados. A única coisa que mudou é **como estão agrupadas**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟีเจอร์ทั้งสองฝั่งเหมือนกันทุกอย่าง สิ่งเดียวที่เปลี่ยนไปคือ**วิธีจัดกลุ่ม**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tính năng ở hai bên giống hệt nhau. Điều duy nhất thay đổi là **cách chúng được nhóm**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkce jsou na obou stranách stejné. Změnilo se jen to, **jak jsou seskupeny**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktionerne er identiske på begge sider. Det eneste, der er ændret, er **hvordan de er grupperet**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λειτουργίες είναι ίδιες και στις δύο πλευρές. Το μόνο που άλλαξε είναι **ο τρόπος που ομαδοποιούνται**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ominaisuudet ovat molemmin puolin samat. Ainoa, mikä muuttui, on **ryhmittelytapa**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiturnya identik di kedua sisi. Satu-satunya yang berubah adalah **cara pengelompokannya**."
          }
        },
        "nb": {
