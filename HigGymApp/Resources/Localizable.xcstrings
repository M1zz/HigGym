    "선택·복사가 됩니다. 복사 버튼도 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can select and copy. There's a copy button too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can select and copy. There's a copy button too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択もコピーもできます。コピーボタンもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택·복사가 됩니다. 복사 버튼도 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以选择、复制。也有复制按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以選擇、複製。也有複製按鈕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно выделять и копировать. Есть и кнопка копирования."
          }
