    "처음부터 함께해 주셔서 모든 기능을 평생 그대로 씁니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been here from the start, so everything stays unlocked for life."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been here from the start, so everything stays unlocked for life."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初から使ってくださったので、すべての機能をずっとそのまま使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢从一开始就一路相伴，所有功能终身照常使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感謝從一開始就一路相伴，所有功能終身照常使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы с нами с самого начала, поэтому всё остаётся открытым навсегда."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás aquí desde el principio, así que todo permanece desbloqueado para siempre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist von Anfang an dabei, daher bleibt alles dauerhaft freigeschaltet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes là depuis le début, donc tout reste débloqué à vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sei dall'inizio, quindi tutto resta sbloccato per sempre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está aqui desde o começo, então tudo continua desbloqueado para sempre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอยู่กับเรามาตั้งแต่ต้น ทุกอย่างจึงปลดล็อกตลอดชีวิต"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đồng hành từ đầu, nên mọi thứ được mở khóa trọn đời."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste tu od začátku, takže vše zůstává odemčeno navždy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har været her fra begyndelsen, så alt forbliver låst op for evigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είσαι εδώ από την αρχή, οπότε όλα παραμένουν ξεκλείδωτα για πάντα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet ollut mukana alusta asti, joten kaikki pysyy avattuna elinikäisesti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah di sini sejak awal, jadi semuanya tetap terbuka seumur hidup."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har vært her fra begynnelsen, så alt forblir åpent for livet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent er vanaf het begin bij, dus alles blijft voor altijd ontgrendeld."
          }
        }
      }
    },
    "모든 레슨과 자료가 열려 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every lesson and resource is unlocked."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Every lesson and resource is unlocked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのレッスンと資料が開いています。"
          }
        },
