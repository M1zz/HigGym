    "인터넷 이전 신청, 우편물 주소 변경, 관리비 정산": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer internet service, forward mail, settle building fees"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer internet service, forward mail, settle building fees"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネット回線の移転手続き、郵便物の転送届、管理費の精算"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷 이전 신청, 우편물 주소 변경, 관리비 정산"
          }
        },
        "zh-Hans": {
