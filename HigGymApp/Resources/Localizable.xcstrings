          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต่อสัญญาแบบอักษรของเนื้อความใหม่แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thỏa thuận về phông chữ nội dung đã được làm mới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smlouva o typu písma pro text byla obnovena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrakten for brødtekstens skrifttype er blevet fornyet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το συμβόλαιο για τη γραμματοσειρά του κειμένου ανανεώθηκε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Leipätekstin fonttisopimus on uusittu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrak untuk jenis huruf isi telah diperbarui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrakten for brødtekstskrifttypen er fornyet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het contract voor het lettertype van de hoofdtekst is vernieuwd."
          }
        }
      }
    },
    "본문은 문장이라 잘려도 앞부분으로 뜻이 통하고, 전문은 상세 화면이 담당합니다. 목록의 목적(훑기)에 맞게 높이를 계약으로 고정한 정석입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The body is a sentence, so even truncated it makes sense from the beginning, and the detail screen carries the full text. Fixing the height by contract to suit the list's purpose (scanning) is the textbook approach."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The body is a sentence, so even truncated it makes sense from the beginning, and the detail screen carries the full text. Fixing the height by contract to suit the list's purpose (scanning) is the textbook approach."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文は文章なので切り詰められても冒頭で意味が通じ、全文は詳細画面が担います。リストの目的（ざっと見ること）に合わせて高さを契約として固定した、正攻法です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문은 문장이라 잘려도 앞부분으로 뜻이 통하고, 전문은 상세 화면이 담당합니다. 목록의 목적(훑기)에 맞게 높이를 계약으로 고정한 정석입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正文是句子，即使被截断，开头部分也能表达意思，全文由详情界面负责。按列表的目的（浏览）把高度固定为约定，这是标准做法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正文是句子，即使被截斷，開頭部分也能表達意思，全文由詳情介面負責。按列表的目的（瀏覽）把高度固定為約定，這是標準做法。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной текст - это предложение, поэтому даже обрезанный он понятен по началу, а полный текст показывает экран подробностей. Фиксировать высоту договорённостью в соответствии с назначением списка (быстрый просмотр) - классический приём."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cuerpo es una frase, así que incluso truncado tiene sentido desde el principio, y la pantalla de detalle lleva el texto completo. Fijar la altura por contrato para ajustarse al propósito de la lista (escanear) es el enfoque de manual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text ist ein Satz, ergibt also auch abgeschnitten von seinem Anfang her noch Sinn, und der Detailbildschirm trägt den Volltext. Die Höhe per Vertrag auf den Zweck der Liste (Überfliegen) abzustimmen ist der Lehrbuchansatz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le corps est une phrase, donc même tronqué il a du sens dès le début, et l'écran de détail porte le texte complet. Fixer la hauteur par contrat selon l'objectif de la liste (survol) est l'approche classique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il corpo è una frase, quindi anche troncato ha senso dall'inizio, e la schermata di dettaglio contiene il testo completo. Fissare l'altezza per contratto in base allo scopo dell'elenco (la scansione) è l'approccio da manuale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O corpo é uma frase, então mesmo truncado faz sentido desde o começo, e a tela de detalhe traz o texto completo. Fixar a altura por contrato de acordo com o propósito da lista (varredura) é a abordagem de manual."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อความเป็นประโยค ต่อให้ถูกตัดก็ยังมีความหมายตั้งแต่ต้น และหน้ารายละเอียดมีข้อความเต็ม การกำหนดความสูงด้วยสัญญาให้เหมาะกับจุดประสงค์ของรายการ (การไล่ดู) คือแนวทางตามตำรา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung là một câu, nên dù bị cắt vẫn hiểu được từ phần đầu, và màn hình chi tiết chứa toàn văn. Cố định chiều cao theo thỏa thuận cho phù hợp mục đích của danh sách (lướt qua) là cách làm điển hình."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text je věta, takže i oříznutý dává smysl od začátku a detailní obrazovka nese plné znění. Fixovat výšku smlouvou podle účelu seznamu (rychlé procházení) je učebnicový přístup."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brødteksten er en sætning, så selv afkortet giver den mening fra begyndelsen, og detaljeskærmen bærer den fulde tekst. At fastlåse højden ved kontrakt, så den passer til listens formål (skimning), er den klassiske tilgang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το κείμενο είναι πρόταση, οπότε ακόμα και περικομμένο βγάζει νόημα από την αρχή, και η οθόνη λεπτομερειών φέρει το πλήρες κείμενο. Η δέσμευση του ύψους με συμβόλαιο ώστε να ταιριάζει στον σκοπό της λίστας (σάρωση) είναι η κλασική προσέγγιση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisältö on lause, joten katkaistunakin sillä on järkeä alusta alkaen, ja yksityiskohtanäkymä kantaa koko tekstin. Korkeuden kiinnittäminen sopimuksella luettelon tarkoitukseen (silmäily) sopivaksi on oppikirjaratkaisu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi adalah kalimat, jadi meski terpotong ia masuk akal dari awalnya, dan layar detail memuat teks lengkap. Mengunci tinggi dengan kontrak agar sesuai tujuan daftar (menyisir) adalah pendekatan buku teks."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brødteksten er en setning, så selv avkortet gir den mening fra begynnelsen, og detaljskjermen bærer hele teksten. Å fastsette høyden ved kontrakt for å passe listens formål (skanning) er lærebokmetoden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoofdtekst is een zin, dus zelfs afgekapt is hij vanaf het begin begrijpelijk, en het detailscherm toont de volledige tekst. De hoogte contractueel vastleggen op het doel van de lijst (scannen) is de standaardaanpak."
          }
        }
      }
    },
    "본문을 길게 눌러 선택·복사할 수 있게 열어 뒀다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left the body text open so it can be long-pressed to select and copy."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Left the body text open so it can be long-pressed to select and copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文を長押しで選択・コピーできるように開けておいた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문을 길게 눌러 선택·복사할 수 있게 열어 뒀다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开放了长按正文进行选择、复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開放了長按正文進行選擇、複製。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основной текст оставили открытым для выделения и копирования долгим нажатием."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dejó el texto del cuerpo abierto para poder mantener pulsado, seleccionar y copiar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Fließtext offen gelassen, sodass man lange drücken, auswählen und kopieren kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le corps du texte a été laissé ouvert pour qu'on puisse le sélectionner et le copier par appui long."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il corpo del testo è stato lasciato aperto, così si può tenere premuto per selezionarlo e copiarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixou o corpo do texto aberto para poder ser pressionado e segurado para selecionar e copiar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดข้อความเนื้อความไว้ให้กดค้างเพื่อเลือกและคัดลอกได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nội dung mở sẵn để có thể nhấn giữ chọn và sao chép."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Text ponechán otevřený, aby šel dlouhým stiskem vybrat a zkopírovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lod brødteksten stå åben, så den kan trykkes længe på for at markere og kopiere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άφησε το κείμενο ανοιχτό ώστε να μπορεί να επιλεγεί και να αντιγραφεί με παρατεταμένο πάτημα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätti sisältötekstin auki, jotta sitä voi valita ja kopioida pitkällä painalluksella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membiarkan teks isi terbuka sehingga bisa ditekan lama untuk memilih dan menyalin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lot brødteksten stå åpen, slik at den kan trykkes og holdes for å markere og kopiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hoofdtekst opengelaten zodat je er lang op kunt drukken om te selecteren en te kopiëren."
          }
        }
      }
    },
