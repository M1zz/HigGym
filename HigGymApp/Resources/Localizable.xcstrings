            "state": "translated",
            "value": "ลองเพราะเมนูชื่อเรื่องเป็นของใหม่ใน iOS 26"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó được thử vì menu tiêu đề là mới trong iOS 26"
          }
        },
        "cs": {
          "stringUnit": {
