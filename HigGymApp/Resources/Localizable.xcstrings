          }
        }
      }
    },
    "탭바를 상세 화면에서 숨기는 것이 맞는 경우는?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When is it right to hide the tab bar on a detail screen?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When is it right to hide the tab bar on a detail screen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面でタブバーを隠すのが正しいのはどんな場合？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭바를 상세 화면에서 숨기는 것이 맞는 경우는?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在详情界面隐藏标签栏，什么情况下才对？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
