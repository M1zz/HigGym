    "%@에 %lld개, 그룹당 2~3개가 적정입니다. 그 이상은 overflow(⋯)나 하단 바로 분산하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has %lld items. Two or three per group is right. Spread anything beyond that into overflow (⋯) or the bottom bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has %lld items. Two or three per group is right. Spread anything beyond that into overflow (⋯) or the bottom bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に%lld個あります。グループあたり2〜3個が適量です。それ以上はoverflow（⋯）や下部のバーに分散させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@에 %2$lld개, 그룹당 2~3개가 적정입니다. 그 이상은 overflow(⋯)나 하단 바로 분산하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中放 %2$lld 个，每组 2 到 3 个比较合适。超出的请分散到溢出菜单（⋯）或底部栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中放 %2$lld 個，每組 2 到 3 個比較合適。超出的請分散到溢位選單（⋯）或底部列。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%1$@» %2$lld шт. Оптимально 2-3 в группе. Остальное вынесите в меню переполнения (⋯) или в нижнюю панель."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiene %2$lld elementos. Lo adecuado son dos o tres por grupo. Lo que sobre, repártelo en el desbordamiento (⋯) o en la barra inferior."
          }
        }
      }
    },
    "%@에 서로 다른 역할 %lld종이 한 묶음입니다. 관련 없는 액션을 기계적으로 한 캡슐에 넣으면 “한 세트”라는 신호가 거짓이 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ groups %lld different roles together. Mechanically putting unrelated actions in one capsule makes the “this is a set” signal a lie."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ groups %lld different roles together. Mechanically putting unrelated actions in one capsule makes the “this is a set” signal a lie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で役割の異なる%lld種類が1つにまとめられています。関係のないアクションを機械的に1つのカプセルに入れると、「ひとまとまり」というシグナルが嘘になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@에 서로 다른 역할 %2$lld종이 한 묶음입니다. 관련 없는 액션을 기계적으로 한 캡슐에 넣으면 “한 세트”라는 신호가 거짓이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中有 %2$lld 种不同角色被放进了同一组。机械地把无关操作塞进一个胶囊，会让“同一组”这个信号变成假信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中有 %2$lld 種不同角色被放進了同一組。機械地把無關操作塞進一個膠囊，會讓「同一組」這個訊號變成假資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%1$@» собрано %2$lld разных по роли элементов. Если механически класть несвязанные действия в одну капсулу, сигнал «один набор» становится ложным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ agrupa %2$lld funciones distintas. Meter de forma mecánica acciones sin relación en una cápsula hace que la señal de «esto es un conjunto» sea mentira."
          }
        }
      }
    },
    "%@에서 **삭제**가 다른 도구와 한 캡슐로 묶였습니다. 같은 캡슐 = 한 세트라서, 성격이 다른 파괴적 액션이 섞이면 묶음이 거짓 정보가 됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, **Delete** shares a capsule with other tools. Same capsule means one set, so mixing in a destructive action of a different nature turns the grouping into false information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, **Delete** shares a capsule with other tools. Same capsule means one set, so mixing in a destructive action of a different nature turns the grouping into false information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で**削除**がほかのツールと同じカプセルにまとめられています。同じカプセルはひとまとまりを意味するので、性質の違う破壊的なアクションが混ざると、そのまとまりが誤った情報になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 **삭제**가 다른 도구와 한 캡슐로 묶였습니다. 같은 캡슐 = 한 세트라서, 성격이 다른 파괴적 액션이 섞이면 묶음이 거짓 정보가 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 里的**删除**和其他工具被放进了同一个胶囊。同一胶囊意味着同一组，性质不同的破坏性操作混在一起，这个分组就成了假信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 裡的**刪除**和其他工具被放進了同一個膠囊。同一膠囊意味著同一組，性質不同的破壞性操作混在一起，這個分組就成了假資訊。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%@» **удаление** объединено с другими инструментами в одной капсуле. Одна капсула значит один набор, поэтому примесь разрушительных действий делает группу ложной информацией."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %@, **Eliminar** comparte cápsula con otras herramientas. La misma cápsula significa un mismo conjunto, así que mezclar una acción destructiva de distinta naturaleza convierte la agrupación en información falsa."
          }
        }
      }
    },
