            "value": "Käyttötiheys"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekuensi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekvens"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequentie"
          }
        }
      }
    },
    "빈도 문제가 아닙니다. 자주 쓰더라도 되돌릴 수 없으면 한 단계 멀리 둡니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not about frequency. Even if it's used often, an irreversible action goes one step away."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not about frequency. Even if it's used often, an irreversible action goes one step away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度の問題ではありません。よく使うとしても、取り消せないなら一段遠くに置きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도 문제가 아닙니다. 자주 쓰더라도 되돌릴 수 없으면 한 단계 멀리 둡니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是频率的问题。即使经常用，无法撤销的操作也要再远一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是頻率的問題。即使經常用，無法撤銷的操作也要再遠一步。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дело не в частоте. Даже если им часто пользуются, необратимое действие ставят на шаг дальше."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No va de frecuencia. Aunque se use a menudo, una acción irreversible va a un paso de distancia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es geht nicht um Häufigkeit. Selbst wenn sie oft genutzt wird, liegt eine nicht umkehrbare Aktion einen Schritt entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas une question de fréquence. Même si elle est très utilisée, une action irréversible va un cran plus loin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è questione di frequenza. Anche se è usata spesso, un'azione irreversibile va un passo più in là."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é questão de frequência. Mesmo que seja muito usada, uma ação irreversível fica a um passo de distância."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่เกี่ยวกับความถี่ ต่อให้ใช้บ่อย การกระทำที่ย้อนกลับไม่ได้ก็อยู่ห่างหนึ่งขั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phải về tần suất. Dù được dùng nhiều, hành động không thể hoàn tác vẫn để cách một bước."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejde o frekvenci. I když se nevratná akce používá často, jde o krok dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det handler ikke om frekvens. Selv hvis den bruges ofte, flyttes en uigenkaldelig handling ét skridt væk."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν αφορά τη συχνότητα. Ακόμα κι αν χρησιμοποιείται συχνά, μια μη αναστρέψιμη ενέργεια πηγαίνει ένα βήμα μακριά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyse ei ole käyttötiheydestä. Vaikka sitä käytettäisiin usein, peruuttamaton toiminto menee askeleen päähän."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bukan soal frekuensi. Meski sering dipakai, aksi yang tidak bisa dibatalkan ditaruh berjarak satu langkah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det handler ikke om frekvens. Selv om den brukes ofte, holdes en handling som ikke kan angres ett steg unna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gaat niet om frequentie. Ook als het vaak wordt gebruikt, hoort een onomkeerbare actie een stap verder weg."
          }
        }
      }
    },
    "빈도가 낮은 액션(설정)은 어디에 있는 게 맞는지도 함께 생각해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also think about where a rarely used action (Settings) belongs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Also think about where a rarely used action (Settings) belongs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度の低いアクション（設定）がどこにあるべきかも、あわせて考えてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도가 낮은 액션(설정)은 어디에 있는 게 맞는지도 함께 생각해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也请一并想想：频率低的操作（设置）放在哪里才对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也請一併想想：頻率低的操作（設定）放在哪裡才對。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подумайте и о том, где должно быть редко используемое действие («Настройки»)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piensa también dónde encaja una acción poco usada (Ajustes)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überlege auch, wohin eine selten genutzte Aktion (Einstellungen) gehört."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensez aussi à l'endroit où va une action rarement utilisée (Réglages)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensa anche a dove dovrebbe stare un'azione usata raramente (Impostazioni)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pense também em onde uma ação pouco usada (Ajustes) deve ficar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองคิดด้วยว่าการกระทำที่ใช้น้อย (การตั้งค่า) ควรอยู่ที่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cũng hãy nghĩ xem hành động hiếm dùng (Cài đặt) thuộc về đâu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamyslete se i nad tím, kam patří zřídka používaná akce (Nastavení)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tænk også på, hvor en sjældent brugt handling (Indstillinger) hører hjemme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σκέψου επίσης πού ανήκει μια σπάνια ενέργεια (Ρυθμίσεις)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieti myös, minne harvoin käytetty toiminto (Asetukset) kuuluu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikirkan juga di mana aksi yang jarang dipakai (Pengaturan) seharusnya berada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenk også på hvor en sjelden brukt handling (Innstillinger) hører hjemme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedenk ook waar een zelden gebruikte actie (Instellingen) hoort."
          }
        }
      }
    },
    "빈도가 높을수록 엄지에 가깝게. 목록 화면에서 반복되는 액션은 새 노트 하나뿐이라 그 자리를 그것에 줬다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The more frequent, the closer to the thumb. On the list screen, the only repeated action is New Note, so that spot went to it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The more frequent, the closer to the thumb. On the list screen, the only repeated action is New Note, so that spot went to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度が高いほど親指の近くに。リスト画面で繰り返されるアクションは新規メモだけなので、その場所をそれに与えた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도가 높을수록 엄지에 가깝게. 목록 화면에서 반복되는 액션은 새 노트 하나뿐이라 그 자리를 그것에 줬다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频率越高，越靠近拇指。列表界面里反复出现的操作只有新建笔记一个，所以把那个位置给了它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頻率越高，越靠近拇指。列表介面裡反覆出現的操作只有新建筆記一個，所以把那個位置給了它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем чаще, тем ближе к большому пальцу. На экране списка единственное повторяемое действие - «Новая заметка», поэтому это место отдали ему."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más frecuente, más cerca del pulgar. En la pantalla de lista, la única acción repetida es Nueva nota, así que ese sitio fue para ella."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je häufiger, desto näher am Daumen. Auf dem Listenbildschirm ist die einzige wiederholte Aktion „Neue Notiz“, daher ging dieser Platz an sie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus c'est fréquent, plus c'est près du pouce. Sur l'écran de liste, la seule action répétée est Nouvelle note, donc cet emplacement lui est revenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più è frequente, più vicina al pollice. Nella schermata dell'elenco l'unica azione ripetuta è Nuova nota, quindi quel posto è andato a lei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais frequente, mais perto do polegar. Na tela da lista, a única ação repetida é Nova nota, então aquele lugar foi para ela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยิ่งบ่อยก็ยิ่งใกล้นิ้วโป้ง บนหน้ารายการ การกระทำที่ซ้ำเพียงอย่างเดียวคือโน้ตใหม่ ตำแหน่งนั้นจึงเป็นของมัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Càng thường xuyên, càng gần ngón cái. Trên màn hình danh sách, hành động lặp lại duy nhất là Ghi chú mới, nên vị trí đó dành cho nó."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čím častější, tím blíž k palci. Na obrazovce seznamu je jedinou opakovanou akcí Nová poznámka, takže to místo dostala ona."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo hyppigere, desto tættere på tommelfingeren. På listeskærmen er den eneste gentagne handling Ny note, så den plads gik til den."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσο πιο συχνά, τόσο πιο κοντά στον αντίχειρα. Στην οθόνη λίστας, η μόνη επαναλαμβανόμενη ενέργεια είναι η Νέα σημείωση, οπότε εκείνη η θέση πήγε σε αυτήν."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä useammin, sitä lähemmäs peukaloa. Luettelonäkymässä ainoa toistuva toiminto on Uusi muistiinpano, joten paikka annettiin sille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakin sering, semakin dekat ke ibu jari. Di layar daftar, satu-satunya aksi yang berulang adalah Catatan Baru, jadi tempat itu diberikan kepadanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jo hyppigere, desto nærmere tommelen. På listeskjermen er den eneste gjentatte handlingen Nytt notat, så den plassen gikk til den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe vaker, hoe dichter bij de duim. Op het lijstscherm is de enige herhaalde actie Nieuwe notitie, dus die plek ging naar die actie."
          }
        }
      }
    },
    "빈도와 높이는 반비례한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency and height are inversely related"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency and height are inversely related"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度と高さは反比例する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도와 높이는 반비례한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频率与高度成反比"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頻率與高度成反比"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частота и высота обратно пропорциональны"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frecuencia y altura son inversamente proporcionales"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufigkeit und Höhe hängen umgekehrt zusammen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquence et hauteur sont inversement liées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequenza e altezza sono inversamente legate"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequência e altura são inversamente relacionadas"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความถี่กับความสูงสวนทางกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tần suất và độ cao tỉ lệ nghịch"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekvence a výška jsou v nepřímém vztahu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekvens og højde er omvendt forbundet"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συχνότητα και το ύψος σχετίζονται αντίστροφα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttötiheys ja korkeus ovat kääntäen verrannollisia"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekuensi dan ketinggian berbanding terbalik"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekvens og høyde er omvendt relatert"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequentie en hoogte zijn omgekeerd evenredig"
          }
        }
      }
    },
    "빈도와 높이는 반비례해야 합니다. 목록에서 반복되는 액션은 새 노트 하나뿐입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency and height should be inversely related. On the list, the only repeated action is New Note."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequency and height should be inversely related. On the list, the only repeated action is New Note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頻度と高さは反比例すべきです。リストで繰り返されるアクションは新規メモだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈도와 높이는 반비례해야 합니다. 목록에서 반복되는 액션은 새 노트 하나뿐입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频率与高度应成反比。列表里反复出现的操作只有新建笔记一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頻率與高度應成反比。列表裡反覆出現的操作只有新建筆記一個。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частота и высота должны быть обратно пропорциональны. В списке единственное повторяемое действие - «Новая заметка»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frecuencia y altura deberían ser inversamente proporcionales. En la lista, la única acción repetida es Nueva nota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufigkeit und Höhe sollten umgekehrt zusammenhängen. In der Liste ist die einzige wiederholte Aktion „Neue Notiz“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquence et hauteur doivent être inversement liées. Dans la liste, la seule action répétée est Nouvelle note."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequenza e altezza dovrebbero essere inversamente legate. Nell'elenco l'unica azione ripetuta è Nuova nota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequência e altura devem ser inversamente relacionadas. Na lista, a única ação repetida é Nova nota."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความถี่กับความสูงควรสวนทางกัน บนรายการ การกระทำที่ซ้ำเพียงอย่างเดียวคือโน้ตใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tần suất và độ cao nên tỉ lệ nghịch. Trên danh sách, hành động lặp lại duy nhất là Ghi chú mới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekvence a výška by měly být v nepřímém vztahu. V seznamu je jedinou opakovanou akcí Nová poznámka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekvens og højde bør være omvendt forbundet. På listen er den eneste gentagne handling Ny note."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συχνότητα και το ύψος πρέπει να σχετίζονται αντίστροφα. Στη λίστα, η μόνη επαναλαμβανόμενη ενέργεια είναι η Νέα σημείωση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttötiheyden ja korkeuden pitäisi olla kääntäen verrannollisia. Luettelossa ainoa toistuva toiminto on Uusi muistiinpano."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekuensi dan ketinggian seharusnya berbanding terbalik. Di daftar, satu-satunya aksi yang berulang adalah Catatan Baru."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekvens og høyde bør være omvendt relatert. I listen er den eneste gjentatte handlingen Nytt notat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequentie en hoogte moeten omgekeerd evenredig zijn. In de lijst is de enige herhaalde actie Nieuwe notitie."
          }
        }
      }
    },
