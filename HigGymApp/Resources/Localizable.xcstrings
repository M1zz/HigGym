    "레슨 %lld편, 실수 %lld편, 실습실, 퀴즈 전부. 주간 · 월간 구독 또는 평생 이용권.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lessons, %2$lld mistakes, every lab and quiz. Weekly, monthly, or lifetime."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lessons, %2$lld mistakes, every lab and quiz. Weekly, monthly, or lifetime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レッスン%1$lld編、ミス%2$lld編、実習室、クイズのすべて。週間・月額プランまたは買い切り。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "레슨 %1$lld편, 실수 %2$lld편, 실습실, 퀴즈 전부. 주간 · 월간 구독 또는 평생 이용권."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 节课程、%2$lld 篇失误、练习室、测验全部包含。每周、每月订阅或终身使用权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 節課程、%2$lld 篇失誤、練習室、測驗全部包含。每週、每月訂閱或終身使用權。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уроков: %1$lld, ошибок: %2$lld, все практикумы и викторины. Неделя, месяц или навсегда."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lecciones, %2$lld errores, todos los laboratorios y cuestionarios. Semanal, mensual o de por vida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Lektionen, %2$lld Fehler, alle Labors und Quizze. Wöchentlich, monatlich oder einmalig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld leçons, %2$lld erreurs, tous les laboratoires et quiz. Hebdomadaire, mensuel ou à vie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lezioni, %2$lld errori, ogni laboratorio e quiz. Settimanale, mensile o a vita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lições, %2$lld erros, todos os laboratórios e quizzes. Semanal, mensal ou vitalício."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld บทเรียน %2$lld ข้อผิดพลาด ทุกแล็บและแบบทดสอบ รายสัปดาห์ รายเดือน หรือตลอดชีพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld bài học, %2$lld lỗi, mọi lab và bài kiểm tra. Theo tuần, theo tháng hoặc trọn đời."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lekce: %1$lld, chyby: %2$lld, každý lab a kvíz. Týdně, měsíčně nebo doživotně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lektioner, %2$lld fejl, alle labs og quizzer. Ugentligt, månedligt eller livstid."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld μαθήματα, %2$lld λάθη, κάθε εργαστήριο και κουίζ. Εβδομαδιαία, μηνιαία ή εφ' όρου ζωής."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld oppituntia, %2$lld virhettä, kaikki laboratoriot ja tietovisat. Viikoittain, kuukausittain tai elinikäisenä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld pelajaran, %2$lld kesalahan, setiap lab dan kuis. Mingguan, bulanan, atau seumur hidup."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld leksjoner, %2$lld feil, alle laboratorier og quizer. Ukentlig, månedlig eller livstid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld lessen, %2$lld fouten, elk lab en elke quiz. Wekelijks, maandelijks of voor altijd."
          }
        }
      }
    }
  },
  "version": "1.0"
