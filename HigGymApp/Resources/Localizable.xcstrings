    "Text(body)\n    .lineLimit(2...4)\n\nText(subtitle)\n    .lineLimit(3, reservesSpace: true)   // 짧아도 3줄만큼 자리를 잡아둔다": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text(body)\n    .lineLimit(2...4)\n\nText(subtitle)\n    .lineLimit(3, reservesSpace: true)   // reserves room for 3 lines even when short"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Text(body)\n    .lineLimit(2...4)\n\nText(subtitle)\n    .lineLimit(3, reservesSpace: true)   // 短くても3行分のスペースを確保しておく"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Text(body)\n    .lineLimit(2...4)\n\nText(subtitle)\n    .lineLimit(3, reservesSpace: true)   // 짧아도 3줄만큼 자리를 잡아둔다"
          }
        }
      }
    },
    "VStack {\n    Text(\"제목\").foregroundStyle(.primary)\n    Text(\"보조 설명\").foregroundStyle(.secondary)   // vibrancy\n    Text(\"보조 설명\").foregroundStyle(Color(white: 0.6))  // 고정 회색\n}\n.padding()\n.background(.regularMaterial, in: .rect(cornerRadius: 16))": {
      "comment": "On-screen SwiftUI code sample. Translate only Korean comments and string literals; keep Swift code as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VStack {\n    Text(\"Title\").foregroundStyle(.primary)\n    Text(\"Supporting text\").foregroundStyle(.secondary)   // vibrancy\n    Text(\"Supporting text\").foregroundStyle(Color(white: 0.6))  // fixed gray\n}\n.padding()\n.background(.regularMaterial, in: .rect(cornerRadius: 16))"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VStack {\n    Text(\"タイトル\").foregroundStyle(.primary)\n    Text(\"補足説明\").foregroundStyle(.secondary)   // vibrancy\n    Text(\"補足説明\").foregroundStyle(Color(white: 0.6))  // 固定のグレー\n}\n.padding()\n.background(.regularMaterial, in: .rect(cornerRadius: 16))"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VStack {\n    Text(\"제목\").foregroundStyle(.primary)\n    Text(\"보조 설명\").foregroundStyle(.secondary)   // vibrancy\n    Text(\"보조 설명\").foregroundStyle(Color(white: 0.6))  // 고정 회색\n}\n.padding()\n.background(.regularMaterial, in: .rect(cornerRadius: 16))"
          }
        }
      }
    },
