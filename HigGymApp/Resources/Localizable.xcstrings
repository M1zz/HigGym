    "저장을 어디서 찾았나요? 한 번 저장하는 데 몇 번의 동작이 필요했나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did you find Save? How many steps did one save take?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did you find Save? How many steps did one save take?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存はどこで見つかりましたか？1回保存するのに何回の操作が必要でしたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장을 어디서 찾았나요? 한 번 저장하는 데 몇 번의 동작이 필요했나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是在哪里找到存储的？存储一次需要几个动作？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是在哪裡找到儲存的？儲存一次需要幾個動作？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где вы нашли «Сохранить»? Сколько шагов занимало одно сохранение?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde encontraste Guardar? ¿Cuántos pasos llevó un guardado?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo hast du Sichern gefunden? Wie viele Schritte brauchte ein Sichern?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où avez-vous trouvé Enregistrer ? Combien d'étapes a demandé un enregistrement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove hai trovato Salva? Quanti passi ha richiesto un salvataggio?"
          }
        }
      }
    },
