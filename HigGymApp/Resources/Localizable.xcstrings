    "오른쪽 아래에서 새 노트를 만들어 보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new note from the bottom right"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new note from the bottom right"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右下から新しいメモを作ってみてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 아래에서 새 노트를 만들어 보세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在右下角新建一条笔记"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
