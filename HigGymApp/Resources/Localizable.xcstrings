    "로케일을 바꾸면 **표기가 따라옵니다**. 앱 코드는 한 줄도 바뀌지 않았습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the locale and **the format follows**. Not a single line of app code changed."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the locale and **the format follows**. Not a single line of app code changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロケールを変えると**表記がついてきます**。アプリのコードは1行も変わっていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로케일을 바꾸면 **표기가 따라옵니다**. 앱 코드는 한 줄도 바뀌지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换区域设置后，**写法会跟着变**。应用代码一行都没有改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換區域設定後，**寫法會跟著變**。應用程式碼一行都沒有改。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смените регион, и **запись последует за ним**. Ни одна строка кода приложения не изменилась."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la configuración regional y **el formato la sigue**. Ni una línea de código de la app ha cambiado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere die Region, und **das Format folgt**. Nicht eine einzige Zeile App-Code hat sich geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez la région et **le format suit**. Pas une seule ligne de code de l'app n'a changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la regione e **il formato la segue**. Non è cambiata nemmeno una riga di codice dell'app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude o idioma e região e **o formato acompanha**. Nem uma linha de código do app mudou."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนภาษาและภูมิภาคแล้ว**รูปแบบก็ตามมา** โค้ดแอปไม่เปลี่ยนแม้แต่บรรทัดเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi ngôn ngữ và vùng và **định dạng theo sau**. Không một dòng mã app nào thay đổi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změňte lokalitu a **formát ji následuje**. Ani řádek kódu aplikace se nezměnil."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændr landestandard, og **formatet følger med**. Ikke en eneste linje app-kode ændrede sig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε τη γλώσσα και περιοχή και **η μορφή ακολουθεί**. Ούτε μία γραμμή κώδικα της εφαρμογής δεν άλλαξε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda kieliasetusta, niin **muoto seuraa mukana**. Yhtäkään sovelluskoodin riviä ei muutettu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah locale dan **format mengikuti**. Tidak ada satu baris pun kode aplikasi yang berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endre locale, og **formatet følger med**. Ikke én linje med appkode ble endret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verander de locale en **het formaat volgt**. Geen enkele regel appcode veranderde."
          }
        }
      }
    },
    "로케일을 바꿔도 그대로입니다, 표기를 앱이 이미 정해버렸기 때문입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays the same even when the locale changes, because the app has already decided the format."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays the same even when the locale changes, because the app has already decided the format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロケールを変えてもそのままです。表記をアプリがすでに決めてしまっているからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로케일을 바꿔도 그대로입니다, 표기를 앱이 이미 정해버렸기 때문입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换区域设置也不变，因为应用早已把写法定死了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換區域設定也不變，因為應用程式早已把寫法定死了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся прежним даже при смене региона, потому что приложение уже определило запись."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda igual aunque cambie la configuración regional, porque la app ya ha decidido el formato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es bleibt gleich, auch wenn sich die Region ändert, weil die App das Format bereits festgelegt hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela reste identique même quand la région change, car l'app a déjà décidé du format."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta uguale anche quando la regione cambia, perché l'app ha già deciso il formato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua igual mesmo quando o idioma e região mudam, porque o app já decidiu o formato."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังเหมือนเดิมแม้เปลี่ยนภาษาและภูมิภาค เพราะแอปตัดสินรูปแบบไว้แล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó giữ nguyên ngay cả khi đổi ngôn ngữ và vùng, vì app đã quyết định sẵn định dạng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zůstává stejné, i když se změní lokalita, protože aplikace už formát rozhodla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forbliver den samme, selv når landestandarden ændres, fordi appen allerede har bestemt formatet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μένει ίδιο ακόμα και όταν αλλάζει η γλώσσα και περιοχή, επειδή η εφαρμογή έχει ήδη αποφασίσει τη μορφή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pysyy samana, vaikka kieliasetus muuttuu, koska sovellus on jo päättänyt muodon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia tetap sama meski locale berubah, karena aplikasi sudah memutuskan formatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forblir den samme selv når locale endres, fordi appen allerede har bestemt formatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het blijft hetzelfde, ook als de locale verandert, omdat de app het formaat al heeft bepaald."
          }
        }
      }
    },
    "로케일을 읽어 if 문으로 단위를 분기한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the locale and branch on the unit with an if statement"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the locale and branch on the unit with an if statement"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロケールを読み取り、if 文で単位を分岐する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로케일을 읽어 if 문으로 단위를 분기한다"
