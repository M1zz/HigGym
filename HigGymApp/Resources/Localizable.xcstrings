          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le **⋯** en haut à droite : il contient icônes · séparateurs · sous-menus · interrupteurs · suppression, le tout en un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri **⋯** in alto a destra: contiene icone · divisori · sottomenu · interruttori · elimina, tutto in uno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o **⋯** no topo à direita: tem ícones · divisores · submenus · interruptores · excluir, tudo em um só."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด **⋯** ที่ขวาบน: มีไอคอน · เส้นคั่น · เมนูย่อย · สวิตช์ · ลบ รวมอยู่ด้วยกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở **⋯** ở trên cùng bên phải: nó có biểu tượng · đường phân cách · menu con · công tắc · xóa, tất cả trong một."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete **⋯** vpravo nahoře: má ikony · oddělovače · podnabídky · přepínače · smazání, vše v jednom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn **⋯** øverst til højre: den har ikoner · skillelinjer · undermenuer · kontakter · slet, alt sammen i ét."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε το **⋯** πάνω δεξιά: έχει εικονίδια · διαχωριστικά · υπομενού · διακόπτες · διαγραφή, όλα μαζί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa oikeassa yläkulmassa oleva **⋯**: siinä on kuvakkeet · erottimet · alavalikot · kytkimet · poisto, kaikki yhdessä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
