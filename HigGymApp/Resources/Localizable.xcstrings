    "Dynamic Type 최대 크기에서 하단 바 라벨이 잘립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the largest Dynamic Type size, the bottom bar labels get truncated."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "At the largest Dynamic Type size, the bottom bar labels get truncated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Typeの最大サイズで、下部のバーのラベルが切り詰められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Type 최대 크기에서 하단 바 라벨이 잘립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dynamic Type 的最大字号下，底部栏的标签被截断了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dynamic Type 的最大字號下，底部列的標籤被截斷了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При максимальном размере Dynamic Type подписи нижней панели обрезаются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el tamaño más grande de Dynamic Type, las etiquetas de la barra inferior se truncan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der größten Dynamic-Type-Größe werden die Beschriftungen der unteren Leiste abgeschnitten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la plus grande taille Dynamic Type, les libellés de la barre du bas sont tronqués."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla dimensione massima di Dynamic Type, le etichette della barra in basso vengono troncate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No maior tamanho de Dynamic Type, os rótulos da barra inferior são truncados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่ขนาด Dynamic Type ใหญ่สุด ป้ายชื่อบนแถบด้านล่างจะถูกตัด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở cỡ Dynamic Type lớn nhất, nhãn thanh dưới bị cắt."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při největší velikosti Dynamic Type se popisky ve spodním panelu ořezávají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved den største Dynamic Type-størrelse bliver etiketterne i den nederste bjælke afkortet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο μεγαλύτερο μέγεθος Dynamic Type, οι ετικέτες της κάτω γραμμής περικόπτονται."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suurimmalla Dynamic Type -koolla alapalkin nimikkeet katkeavat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada ukuran Dynamic Type terbesar, label bilah bawah terpotong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved den største Dynamic Type-størrelsen blir etikettene i bunnlinjen avkortet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij de grootste Dynamic Type-grootte worden de labels van de onderbalk afgekapt."
          }
        }
      }
    },
