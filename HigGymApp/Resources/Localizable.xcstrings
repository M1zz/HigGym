    "여기까지 쌓았다면 하단은 포화 상태입니다. 더 넣을 자리는 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you've stacked up this much, the bottom is saturated. There's no room left."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you've stacked up this much, the bottom is saturated. There's no room left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここまで積み上げたなら、下部は飽和状態です。もう入れる場所はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기까지 쌓았다면 하단은 포화 상태입니다. 더 넣을 자리는 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "堆到这里，底部已经饱和，没有再放东西的位置了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "堆到這裡，底部已經飽和，沒有再放東西的位置了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы накопили столько, низ насыщен. Места больше нет."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si has apilado tanto, la parte inferior está saturada. No queda sitio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du so viel gestapelt, ist der untere Bereich gesättigt. Es ist kein Platz mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez empilé autant, le bas est saturé. Il ne reste plus de place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai impilato così tanto, il fondo è saturo. Non c'è più spazio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você empilhou tanto, o fundo está saturado. Não há mais espaço."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าซ้อนมาถึงขนาดนี้ ด้านล่างก็อิ่มตัวแล้ว ไม่เหลือที่ว่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đã chất đến mức này thì phía dưới đã bão hòa. Không còn chỗ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud jste nahromadili tolik, spodek je nasycený. Nezbývá místo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har stablet så meget, er bunden mættet. Der er ikke mere plads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν έχεις στοιβάξει τόσα, το κάτω μέρος είναι κορεσμένο. Δεν έχει μείνει χώρος."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos olet pinonnut näin paljon, alaosa on kyllästetty. Tilaa ei ole enää."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika kamu sudah menumpuk sebanyak ini, bagian bawah sudah jenuh. Tidak ada ruang lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du har stablet opp så mye, er bunnen mettet. Det er ikke plass igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je zoveel hebt opgestapeld, is de onderkant verzadigd. Er is geen ruimte meer."
          }
        }
      }
    },
    "여기까지 왔다면 대개 정보 구조를 다시 짜야 한다는 신호입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting here is usually a sign you need to rethink the information architecture."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting here is usually a sign you need to rethink the information architecture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここまで来たら、たいていは情報構造を組み直すべきだというサインです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기까지 왔다면 대개 정보 구조를 다시 짜야 한다는 신호입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到了这一步，通常说明信息结构需要重新设计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到了這一步，通常說明資訊結構需要重新設計。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы дошли до этого, обычно пора пересмотреть информационную архитектуру."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegar hasta aquí suele ser señal de que hay que replantear la arquitectura de la información."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier anzukommen ist meist ein Zeichen, dass du die Informationsarchitektur überdenken musst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En arriver là est généralement le signe qu'il faut repenser l'architecture de l'information."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivare a questo punto di solito è il segno che devi ripensare l'architettura dell'informazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegar aqui costuma ser sinal de que é preciso repensar a arquitetura da informação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การมาถึงจุดนี้มักเป็นสัญญาณว่าต้องคิดสถาปัตยกรรมข้อมูลใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đến mức này thường là dấu hiệu bạn cần nghĩ lại kiến trúc thông tin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dojít až sem je obvykle znamení, že je třeba znovu promyslet informační architekturu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At nå hertil er som regel et tegn på, at du må gentænke informationsarkitekturen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το να φτάσεις εδώ είναι συνήθως σημάδι ότι πρέπει να ξανασκεφτείς την αρχιτεκτονική πληροφορίας."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänne päätyminen on yleensä merkki siitä, että tietoarkkitehtuuri pitää miettiä uudelleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampai di sini biasanya tanda kamu perlu memikirkan ulang arsitektur informasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å havne her er vanligvis et tegn på at du bør tenke over informasjonsarkitekturen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier komen is meestal een teken dat je de informatiearchitectuur moet heroverwegen."
          }
        }
      }
    },
