          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de baixo da tela · cápsula de busca"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้านล่างของหน้าจอ · แคปซูลค้นหา"
          }
        },
        "vi": {
