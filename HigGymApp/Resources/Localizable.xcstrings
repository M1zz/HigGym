    "액세서리를 눌러 확장 화면을 열어보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the accessory to open the expanded view."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the accessory to open the expanded view."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセサリをタップして、展開された画面を開いてみてください。"
