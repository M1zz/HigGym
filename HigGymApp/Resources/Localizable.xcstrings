        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пять элементов уже заполнили всю правую сторону. Попробуйте сделать заголовок длиннее."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco elementos ya llenan el lado derecho. Prueba a alargar el título."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Elemente füllen die rechte Seite bereits. Versuche, den Titel länger zu machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq éléments remplissent déjà le côté droit. Essayez d'allonger le titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
