            "value": "バージョン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전"
          }
        }
      }
    },
    "버전 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "ja": {
