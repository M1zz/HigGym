    "이 화면이 무엇인지 말하는 장치. 인터랙티브 컨트롤로 대체하면 자리의 문법이 깨집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It tells you what this screen is. Replacing it with an interactive control breaks the grammar of placement."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It tells you what this screen is. Replacing it with an interactive control breaks the grammar of placement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面が何かを伝える仕掛け。インタラクティブなコントロールに置き換えると、位置の文法が崩れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면이 무엇인지 말하는 장치. 인터랙티브 컨트롤로 대체하면 자리의 문법이 깨집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明这个界面是什么的装置。若换成交互控件，位置的语法就被破坏了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說明這個介面是什麼的裝置。若換成互動控制元件，位置的語法就被破壞了。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он говорит, что это за экран. Если заменить его интерактивным элементом, грамматика места нарушается."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice qué es esta pantalla. Sustituirlo por un control interactivo rompe la gramática de la colocación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sagt dir, was dieser Bildschirm ist. Es durch ein interaktives Steuerelement zu ersetzen, bricht die Platzierungsgrammatik."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dit ce qu'est cet écran. Le remplacer par un contrôle interactif brise la grammaire du placement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti dice che cos'è questa schermata. Sostituirlo con un controllo interattivo infrange la grammatica della collocazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz o que é esta tela. Substituí-lo por um controle interativo quebra a gramática de posicionamento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันบอกว่าหน้าจอนี้คืออะไร การแทนที่ด้วยตัวควบคุมแบบโต้ตอบทำลายไวยากรณ์ของการวางตำแหน่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó cho bạn biết màn hình này là gì. Thay nó bằng một điều khiển tương tác sẽ phá vỡ ngữ pháp vị trí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Říká vám, co je tato obrazovka. Nahrazení interaktivním ovladačem porušuje gramatiku umístění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fortæller, hvad denne skærm er. Erstattes den med en interaktiv kontrol, brydes placeringens grammatik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σου λέει τι είναι αυτή η οθόνη. Το να τη αντικαταστήσεις με διαδραστικό έλεγχο παραβιάζει τη γραμματική της τοποθέτησης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kertoo, mikä tämä näkymä on. Sen korvaaminen vuorovaikutteisella säätimellä rikkoo sijoituksen kieliopin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia memberi tahu layar ini apa. Menggantinya dengan kontrol interaktif merusak tata bahasa penempatan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forteller deg hva denne skjermen er. Å erstatte den med en interaktiv kontroll bryter plasseringsgrammatikken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vertelt wat dit scherm is. Het vervangen door een interactieve bediening breekt de grammatica van plaatsing."
          }
        }
      }
    },
