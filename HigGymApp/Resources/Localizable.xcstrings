    "문자열 보간이 성능에 불리하다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "String interpolation is bad for performance"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "String interpolation is bad for performance"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字列補間はパフォーマンスに不利だ"
