        }
      }
    },
    "선택된 탭만 틴트로 강조됩니다. \"지금 어디에 있는가\"를 색으로 말합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the selected tab gets the tint. Color says \"where you are right now.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the selected tab gets the tint. Colour says \"where you are right now.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択中のタブだけがティントで強調されます。「今どこにいるか」を色で伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 탭만 틴트로 강조됩니다. \"지금 어디에 있는가\"를 색으로 말합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有选中的标签用着色强调。用颜色来说“我现在在哪里”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有選中的標籤用著色強調。用顏色來說「我現在在哪裡」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только выбранная вкладка подсвечена оттенком. Цвет говорит, «где вы сейчас»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la pestaña seleccionada lleva el tinte. El color dice «dónde estás ahora mismo»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der ausgewählte Tab bekommt die Tönung. Farbe sagt: „Hier bist du gerade.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul l'onglet sélectionné reçoit la teinte. La couleur dit « où vous êtes en ce moment »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la scheda selezionata riceve la tinta. Il colore dice «dove sei adesso»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só a aba selecionada recebe a cor de destaque. A cor diz «onde você está agora»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เฉพาะแท็บที่เลือกเท่านั้นที่ได้สี สีบอกว่า \"ตอนนี้คุณอยู่ที่ไหน\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tab đã chọn được tô màu. Màu nói \"lúc này bạn đang ở đâu\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstín dostane jen vybraná karta. Barva říká „kde právě jste“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun den valgte fane får farvetonen. Farven siger »hvor du er lige nu.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο η επιλεγμένη καρτέλα παίρνει το χρώμα απόχρωσης. Το χρώμα λέει «πού βρίσκεσαι τώρα»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain valittu välilehti saa sävyn. Väri sanoo ”missä olet juuri nyt”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya tab terpilih yang mendapat warna sentuh. Warna berkata \"di mana kamu sekarang.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare den valgte fanen får fargetonen. Farge sier «hvor du er akkurat nå»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het geselecteerde tabblad krijgt de tint. Kleur zegt \"waar je nu bent\"."
          }
        }
      }
    },
