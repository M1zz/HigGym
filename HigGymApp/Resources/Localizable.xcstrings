    "기준이 잡혀 있습니다. 틀린 항목만 실습으로 확인해보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've got the criteria down. Check just the ones you missed in the labs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You've got the criteria down. Check just the ones you missed in the labs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基準は身についています。間違えた項目だけ実習で確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준이 잡혀 있습니다. 틀린 항목만 실습으로 확인해보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标准已经建立。只需通过实践确认错误的条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標準已經建立。只需透過實踐確認錯誤的條目。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Критерии усвоены. Проверьте на практике только те, в которых ошиблись."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya dominas los criterios. Repasa en los laboratorios solo los que fallaste."
          }
        }
      }
    },
    "긴 문장으로 바꾸기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to a long sentence"
          }
        },
        "en-GB": {
