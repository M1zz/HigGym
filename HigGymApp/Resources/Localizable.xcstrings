            "value": "// fullScreenCover ไม่ปิดด้วยการปัดลง ต้องสร้างทางออกเอง\n.fullScreenCover(isPresented: $editing) {\n    EditorView()\n        .toolbar {\n            ToolbarItem(placement: .topBarLeading) { Button(\"ยกเลิก\") { editing = false } }\n            ToolbarItem(placement: .topBarTrailing) { Button(\"เสร็จสิ้น\") { save() } }\n        }\n}"
