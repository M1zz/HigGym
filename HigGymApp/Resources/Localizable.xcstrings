    "선택 사항이 아니라 필수입니다. 없으면 앱이 멈춘 것처럼 보입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's required, not optional. Without it, the app looks frozen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意ではなく必須です。なければアプリが止まったように見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이 아니라 필수입니다. 없으면 앱이 멈춘 것처럼 보입니다."
          }
        }
      }
    },
    "선택 상태가 원래 탭으로 되돌아가는 순간 사용자는 자기가 뭘 잘못 눌렀다고 느낀다. 가장 좋은 자리를 쓰고 신뢰를 잃는다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moment the selection snaps back to the original tab, people feel they tapped the wrong thing. You spend the best spot and lose their trust."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択状態が元のタブに戻った瞬間、ユーザーは自分が何か押し間違えたと感じる。いちばん良い場所を使って、信頼を失う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 상태가 원래 탭으로 되돌아가는 순간 사용자는 자기가 뭘 잘못 눌렀다고 느낀다. 가장 좋은 자리를 쓰고 신뢰를 잃는다."
          }
        }
      }
    },
    "선택 안 함": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択なし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 안 함"
          }
        }
      }
    },
    "선택·복사가 됩니다. 복사 버튼도 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can select and copy. There's a copy button too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択もコピーもできます。コピーボタンもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택·복사가 됩니다. 복사 버튼도 있습니다."
          }
        }
      }
    },
    "선택된 탭": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected tab"
          }
