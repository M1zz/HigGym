    "읽힘과 미학이 충돌하면 읽힘이 이긴다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When legibility and aesthetics clash, legibility wins"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When legibility and aesthetics clash, legibility wins"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みやすさと美しさがぶつかったら、読みやすさが勝つ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽힘과 미학이 충돌하면 읽힘이 이긴다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可读性与美观冲突时，可读性获胜"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可讀性與美觀衝突時，可讀性獲勝"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда читаемость и эстетика конфликтуют, побеждает читаемость"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando legibilidad y estética chocan, gana la legibilidad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Lesbarkeit und Ästhetik kollidieren, gewinnt die Lesbarkeit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand lisibilité et esthétique s'opposent, la lisibilité l'emporte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando leggibilità ed estetica si scontrano, vince la leggibilità"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando legibilidade e estética se chocam, vence a legibilidade"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อความอ่านออกชนกับความสวยงาม ความอ่านออกชนะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi khả năng đọc và thẩm mỹ va chạm, khả năng đọc thắng"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když se čitelnost a estetika střetnou, čitelnost vítězí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når læselighed og æstetik støder sammen, vinder læseligheden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν η αναγνωσιμότητα και η αισθητική συγκρούονται, κερδίζει η αναγνωσιμότητα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun luettavuus ja estetiikka ovat ristiriidassa, luettavuus voittaa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketika keterbacaan dan estetika bertabrakan, keterbacaan menang"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når lesbarhet og estetikk kolliderer, vinner lesbarhet"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als leesbaarheid en esthetiek botsen, wint leesbaarheid"
          }
        }
      }
    },
