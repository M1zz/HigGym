          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пример: при прокрутке большой палец задел баннер. Две кнопки рядом, и «Новая запись» казалась зажатой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
