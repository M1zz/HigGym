    "비모달(뒤 조작 가능) ↔ 모달 + 시트 안 주문 요약. 결제하기를 누르면 결과가 아래에 남습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (background usable) ↔ modal, with an order summary inside the sheet. Tap Pay and the result stays below."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (background usable) ↔ modal, with an order summary inside the sheet. Tap Pay and the result stays below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非モーダル（背後を操作できる）↔ モーダル＋シート内の注文概要。「支払う」を押すと結果が下に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비모달(뒤 조작 가능) ↔ 모달 + 시트 안 주문 요약. 결제하기를 누르면 결과가 아래에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非模态（可操作后面）↔ 模态 + 弹层内订单摘要。点支付后，结果会留在下方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非模態（可操作後面）↔ 模態 + 工作表內訂單摘要。點付款後，結果會留在下方。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неблокирующая (фон доступен) ↔ модальная, со сводкой заказа внутри шторки. Нажмите «Оплатить», и результат останется ниже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No modal (fondo utilizable) ↔ modal, con un resumen del pedido dentro de la hoja. Toca Pagar y el resultado queda debajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichtmodal (Hintergrund nutzbar) ↔ modal, mit einer Bestellübersicht im Sheet. Tippe auf Bezahlen, und das Ergebnis bleibt unten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (arrière-plan utilisable) ↔ modal, avec un récapitulatif de commande dans la feuille. Touchez Payer et le résultat reste en dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodale (sfondo utilizzabile) ↔ modale, con un riepilogo dell'ordine dentro il foglio. Tocca Paga e il risultato resta sotto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (fundo utilizável) ↔ modal, com um resumo do pedido dentro da folha. Toque em Pagar e o resultado fica embaixo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (ใช้พื้นหลังได้) ↔ โมดัล โดยมีสรุปคำสั่งซื้อในชีต แตะจ่ายเงินแล้วผลลัพธ์จะอยู่ด้านล่าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (nền dùng được) ↔ modal, với bản tóm tắt đơn hàng trong sheet. Chạm Thanh toán và kết quả nằm ở dưới."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (pozadí použitelné) ↔ modal, se souhrnem objednávky uvnitř sheetu. Klepněte na Zaplatit a výsledek zůstane dole."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (baggrunden kan bruges) ↔ modal, med en ordreoversigt inde i arket. Tryk på Betal, og resultatet bliver nedenunder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (το φόντο χρησιμοποιείται) ↔ modal, με σύνοψη παραγγελίας μέσα στο φύλλο. Πάτησε Πληρωμή και το αποτέλεσμα μένει από κάτω."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (tausta käytettävissä) ↔ modaali, jossa tilausyhteenveto on arkin sisällä. Napauta Maksa, niin tulos jää alle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (latar bisa dipakai) ↔ modal, dengan ringkasan pesanan di dalam lembar. Ketuk Bayar dan hasilnya tetap di bawah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal (bakgrunnen kan brukes) ↔ modal, med en ordresammenstilling inne i arket. Trykk på Betal, så blir resultatet liggende under."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodaal (achtergrond bruikbaar) ↔ modaal, met een besteloverzicht in de sheet. Tik op Betaal en het resultaat blijft eronder staan."
          }
        }
      }
    },
    "비모달, 뒤를 만질 수 있게": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, so you can touch what's behind"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, so you can touch what's behind"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非モーダル、背後に触れられるように"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비모달, 뒤를 만질 수 있게"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非模态，后面也能操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非模態，後面也能操作"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неблокирующая, чтобы можно было трогать то, что позади"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No modal, así que puedes tocar lo de detrás"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichtmodal, daher kannst du anfassen, was dahinter liegt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, donc vous pouvez toucher ce qui est derrière"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodale, quindi puoi toccare ciò che sta dietro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, então você pode tocar no que está atrás"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal จึงแตะสิ่งที่อยู่ด้านหลังได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, nên bạn chạm được thứ phía sau"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, takže můžete sáhnout na to, co je vzadu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, så du kan røre ved det, der er bagved"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, οπότε μπορείς να αγγίξεις ό,τι βρίσκεται πίσω"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, joten voit koskettaa taustaa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, jadi kamu bisa menyentuh yang ada di belakang"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodal, så du kan røre det som er bak"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonmodaal, dus je kunt aanraken wat erachter zit"
          }
        }
      }
    },
    "비모달이 좋았던 화면들에는 공통점이 있다, **뒤에서 무엇을 하든 시트 내용이 흔들리지 않는다.** 확정하는 시트는 반대다. 뒤를 열어두는 순간 표시된 값과 청구될 값이 갈라질 창이 열린다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screens where nonmodal worked all had one thing in common: **whatever happens behind, the sheet's content doesn't shift.** A sheet that commits something is the opposite. The moment you open up the background, you open a window for the displayed value and the charged value to drift apart."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The screens where nonmodal worked all had one thing in common: **whatever happens behind, the sheet's content doesn't shift.** A sheet that commits something is the opposite. The moment you open up the background, you open a window for the displayed value and the charged value to drift apart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非モーダルがうまくいった画面には共通点がある。**背後で何をしても、シートの内容が揺らがない**。確定するシートはその逆だ。背後を開けた瞬間、表示された値と請求される値が食い違う隙が生まれる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비모달이 좋았던 화면들에는 공통점이 있다, **뒤에서 무엇을 하든 시트 내용이 흔들리지 않는다.** 확정하는 시트는 반대다. 뒤를 열어두는 순간 표시된 값과 청구될 값이 갈라질 창이 열린다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非模态好用的界面有个共同点：**不管在后面做什么，弹层内容都不受影响。**确认类的弹层则相反。一旦让后面保持开放，显示的值和实际扣款的值就有了分叉的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非模態好用的介面有個共同點：**不管在後面做什麼，工作表內容都不受影響。**確認類的工作表則相反。一旦讓後面保持開放，顯示的值和實際扣款的值就有了分叉的視窗。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У экранов, где неблокирующий режим сработал, было общее: **что бы ни происходило позади, содержимое шторки не смещается.** Шторка, которая что-то подтверждает, - наоборот. В момент, когда вы открываете фон, появляется окно, в котором показанное и списанное значения могут разойтись."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pantallas donde lo no modal funcionaba tenían algo en común: **pase lo que pase detrás, el contenido de la hoja no cambia.** Una hoja que confirma algo es lo contrario. En el momento en que abres el fondo, abres una ventana para que el valor mostrado y el valor cobrado se separen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirme, bei denen nichtmodal funktionierte, hatten alle eine Gemeinsamkeit: **Was auch immer dahinter geschieht, der Inhalt des Sheets verschiebt sich nicht.** Ein Sheet, das etwas verbindlich macht, ist das Gegenteil. In dem Moment, in dem du den Hintergrund freigibst, öffnest du ein Fenster dafür, dass angezeigter und abgebuchter Wert auseinanderdriften."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les écrans où le nonmodal fonctionnait avaient tous un point commun : **quoi qu'il se passe derrière, le contenu de la feuille ne bouge pas.** Une feuille qui valide quelque chose est l'inverse. Au moment où vous ouvrez l'arrière-plan, vous ouvrez une fenêtre pour que la valeur affichée et la valeur débitée divergent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schermate in cui il nonmodale funzionava avevano una cosa in comune: **qualunque cosa accada dietro, il contenuto del foglio non cambia.** Un foglio che conferma qualcosa è l'opposto. Nel momento in cui apri lo sfondo, apri una finestra in cui il valore mostrato e quello addebitato possono divergere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As telas em que o nonmodal funcionou tinham uma coisa em comum: **aconteça o que acontecer atrás, o conteúdo da folha não muda.** Uma folha que confirma algo é o oposto. No instante em que você libera o fundo, abre uma janela para o valor exibido e o valor cobrado se afastarem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอที่ nonmodal ใช้ได้ผลล้วนมีจุดร่วมเดียวกัน: **ไม่ว่าเกิดอะไรขึ้นด้านหลัง เนื้อหาของชีตก็ไม่ขยับ** ชีตที่ยืนยันบางอย่างตรงข้ามกัน ทันทีที่เปิดพื้นหลัง คุณก็เปิดช่องให้ค่าที่แสดงกับค่าที่เรียกเก็บคลาดเคลื่อนกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các màn hình mà nonmodal hoạt động tốt đều có một điểm chung: **dù xảy ra gì phía sau, nội dung của sheet không dịch chuyển.** Một sheet xác nhận điều gì đó thì ngược lại. Ngay khi bạn mở nền ra, bạn mở một cửa sổ cho giá trị hiển thị và giá trị bị tính lệch nhau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovky, kde nonmodal fungoval, měly jedno společné: **ať se vzadu děje cokoli, obsah sheetu se neposune.** Sheet, který něco potvrzuje, je opak. Ve chvíli, kdy pozadí otevřete, otevřete okno, kudy se zobrazená a účtovaná hodnota mohou rozejít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De skærme, hvor nonmodal virkede, havde alle én ting til fælles: **uanset hvad der sker bagved, flytter arkets indhold sig ikke.** Et ark, der bekræfter noget, er det modsatte. I det øjeblik du åbner baggrunden, åbner du et vindue for, at den viste værdi og den opkrævede værdi kan drive fra hinanden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι οθόνες όπου το nonmodal δούλεψε είχαν κάτι κοινό: **ό,τι κι αν γίνεται πίσω, το περιεχόμενο του φύλλου δεν μετατοπίζεται.** Ένα φύλλο που δεσμεύει κάτι είναι το αντίθετο. Τη στιγμή που ανοίγεις το φόντο, ανοίγεις ένα παράθυρο για να αποκλίνουν η εμφανιζόμενη τιμή και η χρεωμένη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkymillä, joilla nonmodal toimi, oli yksi yhteinen piirre: **mitä tahansa takana tapahtuukin, arkin sisältö ei muutu.** Jotain sitovan arkin kohdalla asia on päinvastoin. Heti kun avaat taustan, avaat ikkunan sille, että näytetty arvo ja veloitettu arvo ajautuvat erilleen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layar tempat nonmodal berhasil punya satu kesamaan: **apa pun yang terjadi di belakang, isi lembar tidak bergeser.** Lembar yang melakukan komit adalah kebalikannya. Begitu kamu membuka latar, kamu membuka jendela bagi nilai yang ditampilkan dan nilai yang ditagih untuk menyimpang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermene der nonmodal fungerte hadde én ting til felles: **uansett hva som skjer bak, forskyves ikke arkets innhold.** Et ark som forplikter noe er det motsatte. I det øyeblikket du åpner bakgrunnen, åpner du et vindu der den viste verdien og den belastede verdien kan drive fra hverandre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De schermen waar nonmodaal werkte hadden één ding gemeen: **wat er ook achter gebeurt, de inhoud van de sheet verschuift niet.** Een sheet die iets vastlegt is het tegenovergestelde. Zodra je de achtergrond openzet, open je een venster waarin de getoonde waarde en de afgerekende waarde uit elkaar kunnen lopen."
          }
        }
      }
    },
    "비모달입니다, 시트를 연 채로 뒤의 카드를 만져보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's nonmodal: keep the sheet open and try touching the cards behind it."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's nonmodal: keep the sheet open and try touching the cards behind it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非モーダルです。シートを開いたまま、背後のカードに触れてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비모달입니다, 시트를 연 채로 뒤의 카드를 만져보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是非模态，保持弹层打开，操作一下后面的卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是非模態，保持工作表開啟，操作一下後面的卡片。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это неблокирующий режим: оставьте шторку открытой и попробуйте трогать карточки позади."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es no modal: deja la hoja abierta e intenta tocar las tarjetas de detrás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nichtmodal: Lass das Sheet offen und versuche, die Karten dahinter zu berühren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est nonmodal : gardez la feuille ouverte et essayez de toucher les cartes derrière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È nonmodale: tieni aperto il foglio e prova a toccare le schede dietro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É nonmodal: mantenha a folha aberta e tente tocar nos cartões atrás dela."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันเป็น nonmodal: เปิดชีตค้างไว้แล้วลองแตะการ์ดด้านหลัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó là nonmodal: giữ sheet mở và thử chạm các thẻ phía sau."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to nonmodal: nechte sheet otevřený a zkuste sáhnout na karty za ním."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er nonmodalt: hold arket åbent og prøv at røre ved kortene bagved."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι nonmodal: κράτα το φύλλο ανοιχτό και δοκίμασε να αγγίξεις τις κάρτες πίσω του."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on nonmodal: pidä arkki auki ja kokeile koskettaa sen takana olevia kortteja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini nonmodal: biarkan lembar terbuka dan coba sentuh kartu di belakangnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er nonmodal: la arket stå åpent og prøv å røre kortene bak det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is nonmodaal: laat de sheet open en probeer de kaarten erachter aan te raken."
          }
        }
      }
    },
