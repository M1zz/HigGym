        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성을 탭이 아니라 하단 툴바 버튼으로 두고, 탭에는 목적지만 남겼다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把撰写做成底部工具栏按钮，而不是标签，标签里只留目的地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
