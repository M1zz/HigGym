    "스크롤하면 큰 커스텀 헤더가 접히고, 내비바 안의 작은 커스텀 제목만 남습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll and the big custom header collapses, leaving only the small custom title in the navigation bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll and the big custom header collapses, leaving only the small custom title in the navigation bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールすると大きなカスタムヘッダーが折りたたまれ、ナビゲーションバーの中の小さなカスタムタイトルだけが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤하면 큰 커스텀 헤더가 접히고, 내비바 안의 작은 커스텀 제목만 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动时大号自定义标题区折叠，只留下导航栏里的小号自定义标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動時大號自定義標題區摺疊，只留下導覽列裡的小號自定義標題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутите, и большой пользовательский заголовок сворачивается, оставляя в панели навигации только маленький пользовательский заголовок."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplázate y el gran encabezado personalizado se colapsa, dejando solo el pequeño título personalizado en la barra de navegación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle, und der große eigene Kopfbereich klappt zusammen, sodass nur der kleine eigene Titel in der Navigationsleiste bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler et le grand en-tête personnalisé se replie, ne laissant que le petit titre personnalisé dans la barre de navigation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri e la grande intestazione personalizzata si comprime, lasciando nella barra di navigazione solo il piccolo titolo personalizzato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role e o grande cabeçalho personalizado recolhe, deixando só o pequeno título personalizado na barra de navegação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลื่อนแล้วส่วนหัวแบบกำหนดเองขนาดใหญ่จะยุบ เหลือเพียงชื่อเรื่องแบบกำหนดเองขนาดเล็กในแถบนำทาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộn và header tùy chỉnh lớn thu gọn, chỉ còn tiêu đề tùy chỉnh nhỏ trong thanh điều hướng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posuňte a velká vlastní hlavička se sbalí a v navigačním panelu zůstane jen malý vlastní nadpis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll, og den store brugerdefinerede header klapper sammen, så kun den lille brugerdefinerede titel bliver tilbage i navigationslinjen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κύλισε και η μεγάλη προσαρμοσμένη κεφαλίδα συμπτύσσεται, αφήνοντας μόνο τον μικρό προσαρμοσμένο τίτλο στη γραμμή πλοήγησης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vieritä, niin iso mukautettu otsikko tiivistyy jättäen vain pienen mukautetun otsikon navigointipalkkiin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gulir dan header kustom besar menciut, menyisakan hanya judul kustom kecil di bilah navigasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rull, så kollapser den store egendefinerte headeren og lar bare den lille egendefinerte tittelen bli igjen i navigasjonslinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll en de grote aangepaste kop klapt in, zodat alleen de kleine aangepaste titel in de navigatiebalk overblijft."
          }
        }
      }
    },
    "스크롤해 보세요, 제목이 **접히지 않고** 내비바 안에 큰 크기 그대로 남습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try scrolling: the title **doesn't collapse** and stays full size in the navigation bar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try scrolling: the title **doesn't collapse** and stays full size in the navigation bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールしてみてください。タイトルが**折りたたまれず**、ナビゲーションバーの中に大きいサイズのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤해 보세요, 제목이 **접히지 않고** 내비바 안에 큰 크기 그대로 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动一下，标题**不会折叠**，仍以大号留在导航栏里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滾動一下，標題**不會摺疊**，仍以大號留在導覽列裡。"
