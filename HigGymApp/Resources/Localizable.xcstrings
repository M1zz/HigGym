    "유행이 아니라 대상-액션 결합의 문제입니다(8.1.7).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not a trend. It's about tying actions to their targets (8.1.7)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not a trend. It's about tying actions to their targets (8.1.7)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流行ではなく、対象とアクションの結びつきの問題です（8.1.7）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유행이 아니라 대상-액션 결합의 문제입니다(8.1.7)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是流行的问题，而是对象与操作结合的问题（8.1.7）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是流行的問題，而是物件與操作結合的問題（8.1.7）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не мода. Речь о связи действий с их объектами (8.1.7)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es una moda. Se trata de unir las acciones a sus objetivos (8.1.7)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Trend. Es geht darum, Aktionen an ihre Ziele zu binden (8.1.7)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas une mode. Il s'agit de relier les actions à leurs cibles (8.1.7)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è una moda. Si tratta di legare le azioni ai loro bersagli (8.1.7)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é moda. Trata-se de ligar as ações aos seus alvos (8.1.7)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่เทรนด์ แต่เป็นการผูกการกระทำเข้ากับเป้าหมาย (8.1.7)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó không phải xu hướng. Đó là gắn hành động với đối tượng của chúng (8.1.7)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není to trend. Jde o to, vázat akce na jejich cíle (8.1.7)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke en trend. Det handler om at knytte handlinger til deres mål (8.1.7)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι τάση. Αφορά τη σύνδεση των ενεργειών με τους στόχους τους (8.1.7)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei ole trendi. Kyse on toimintojen sitomisesta kohteisiinsa (8.1.7)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bukan tren. Ini soal mengikat aksi pada targetnya (8.1.7)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke en trend. Det handler om å knytte handlinger til målene sine (8.1.7)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is geen trend. Het gaat erom acties aan hun doel te binden (8.1.7)."
          }
        }
      }
