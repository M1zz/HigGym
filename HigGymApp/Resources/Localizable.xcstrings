          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aku menggabungkan cabang dukungan iOS 26 ke main."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har flettet iOS 26-støttegrenen inn i main."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb de iOS 26-ondersteuningsbranch in main gemerged."
          }
        }
      }
    },
    "iOS 26에서 검색 탭을 둘 때의 표준은?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's the standard for a search tab in iOS 26?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What's the standard for a search tab in iOS 26?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26で検索タブを置くときの標準は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26에서 검색 탭을 둘 때의 표준은?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 26 中放置搜索标签的标准做法是？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 26 中放置搜尋標籤的標準做法是？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой стандарт для вкладки поиска в iOS 26?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuál es el estándar para una pestaña de búsqueda en iOS 26?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ist der Standard für einen Such-Tab in iOS 26?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est la norme pour un onglet de recherche dans iOS 26 ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual è lo standard per una scheda di ricerca in iOS 26?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual é o padrão para uma aba de busca no iOS 26?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มาตรฐานของแท็บค้นหาใน iOS 26 คืออะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuẩn của tab tìm kiếm trong iOS 26 là gì?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaký je standard pro kartu hledání v iOS 26?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad er standarden for en søgefane i iOS 26?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ποιο είναι το πρότυπο για μια καρτέλα αναζήτησης στο iOS 26;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä on hakuvälilehden vakiotapa iOS 26:ssa?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa standar untuk tab pencarian di iOS 26?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva er standarden for en søkefane i iOS 26?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat is de standaard voor een zoektabblad in iOS 26?"
          }
        }
      }
    },
    "iOS 26에서 검색은 “모드 진입”이라 툴바 안에서도 별도 형태를 갖습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS 26, search is “entering a mode,” so it takes its own distinct form even inside the toolbar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS 26, search is “entering a mode,” so it takes its own distinct form even inside the toolbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26では検索は「モードに入ること」なので、ツールバーの中でも独自の形を持ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26에서 검색은 “모드 진입”이라 툴바 안에서도 별도 형태를 갖습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 26 中，搜索是“进入一种模式”，所以在工具栏里也有单独的形态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 26 中，搜尋是「進入一種模式」，所以在工具列裡也有單獨的形態。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В iOS 26 поиск - это «вход в режим», поэтому и в панели инструментов у него отдельная форма."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iOS 26, buscar es «entrar en un modo», así que adopta una forma propia y distinta incluso dentro de la barra de herramientas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS 26 ist Suchen „einen Modus betreten“, daher nimmt sie auch innerhalb der Symbolleiste eine eigene, abgesetzte Form an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans iOS 26, la recherche est « l'entrée dans un mode », donc elle prend sa propre forme distincte, même dans la barre d'outils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS 26 la ricerca è «entrare in una modalità», quindi assume una forma distinta anche dentro la barra degli strumenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iOS 26, a busca é «entrar num modo», então ela assume uma forma própria e distinta mesmo dentro da barra de ferramentas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน iOS 26 การค้นหาคือ “การเข้าสู่โหมด” จึงมีรูปแบบเฉพาะของตัวเองแม้อยู่ในแถบเครื่องมือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong iOS 26, tìm kiếm là “vào một chế độ”, nên nó có hình thức riêng biệt ngay cả bên trong thanh công cụ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V iOS 26 je hledání „vstup do režimu“, takže má vlastní odlišnou podobu i uvnitř panelu nástrojů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I iOS 26 er søgning »at gå ind i en tilstand«, så den får sin egen tydelige form selv inde i værktøjslinjen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο iOS 26, η αναζήτηση είναι «είσοδος σε λειτουργία», οπότε παίρνει τη δική της διακριτή μορφή ακόμα και μέσα στη γραμμή εργαλείων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26:ssa haku on ”tilaan siirtymistä”, joten se saa oman erillisen muotonsa myös työkalupalkin sisällä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iOS 26, pencarian adalah \"masuk ke sebuah mode\", jadi ia mengambil bentuknya sendiri yang berbeda bahkan di dalam bilah alat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I iOS 26 er søk å «gå inn i en modus», så det får sin egen distinkte form selv inne i verktøylinjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS 26 is zoeken \"een modus betreden\", dus het krijgt zelfs binnen de werkbalk zijn eigen vorm."
          }
        }
      }
    },
    "iOS 26이 검색을 아래로 내린 것과 같은 이유입니다, 도달성, 그리고 상시 점유 회피.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the same reason iOS 26 moved search to the bottom: reachability, and avoiding permanent use of space."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's the same reason iOS 26 moved search to the bottom: reachability, and avoiding permanent use of space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26が検索を下に移したのと同じ理由です。届きやすさ、そして常にスペースを占有しないためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26이 검색을 아래로 내린 것과 같은 이유입니다, 도달성, 그리고 상시 점유 회피."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和 iOS 26 把搜索移到下方是同一个理由：易触达，以及避免常驻占位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "和 iOS 26 把搜尋移到下方是同一個理由：易觸達，以及避免常駐佔位。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Причина та же, по которой iOS 26 опустила поиск вниз: досягаемость и отказ от постоянного занятия места."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la misma razón por la que iOS 26 llevó la búsqueda abajo: alcance, y evitar el uso permanente de espacio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist derselbe Grund, aus dem iOS 26 die Suche nach unten verlegt hat: Erreichbarkeit und kein dauerhafter Platzverbrauch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est la même raison pour laquelle iOS 26 a déplacé la recherche vers le bas : l'accessibilité au pouce et l'évitement d'une occupation permanente de l'espace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È lo stesso motivo per cui iOS 26 ha spostato la ricerca in basso: raggiungibilità ed evitare un uso permanente dello spazio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o mesmo motivo pelo qual o iOS 26 moveu a busca para baixo: alcance e evitar o uso permanente de espaço."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นเหตุผลเดียวกับที่ iOS 26 ย้ายการค้นหาลงด้านล่าง: เอื้อมถึงง่าย และไม่กินพื้นที่ถาวร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng lý do iOS 26 chuyển tìm kiếm xuống dưới: với tay dễ, và không chiếm không gian vĩnh viễn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to stejný důvod, proč iOS 26 přesunulo hledání dolů: dosažitelnost a vyhnutí se trvalému zabírání místa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er samme grund til, at iOS 26 flyttede søgningen ned: rækkevidde og at undgå permanent brug af plads."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι ο ίδιος λόγος για τον οποίο το iOS 26 μετέφερε την αναζήτηση κάτω: προσβασιμότητα με τον αντίχειρα και αποφυγή μόνιμης χρήσης χώρου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on sama syy, miksi iOS 26 siirsi haun alas: ulottuvuus ja tilan pysyvän käytön välttäminen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alasannya sama dengan mengapa iOS 26 memindahkan pencarian ke bawah: keterjangkauan, dan menghindari pemakaian ruang secara permanen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er den samme grunnen til at iOS 26 flyttet søk til bunnen: rekkevidde, og å unngå permanent bruk av plass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is dezelfde reden waarom iOS 26 zoeken naar beneden verplaatste: bereikbaarheid, en permanent ruimtegebruik vermijden."
          }
        }
      }
    },
    "iOS 27의 `.prominent` 는 이 자리를 검색이 아닌 탭에도 열어줍니다, 예: \"만들기\".": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS 27, `.prominent` opens this spot to tabs other than search too, for example \"Create\"."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS 27, `.prominent` opens this spot to tabs other than search too, for example \"Create\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 27の `.prominent` は、この位置を検索以外のタブにも開放します。例:「作成」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 27의 `.prominent` 는 이 자리를 검색이 아닌 탭에도 열어줍니다, 예: \"만들기\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 27 的 `.prominent` 把这个位置也开放给了非搜索的标签，例如“创建”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 27 的 `.prominent` 把這個位置也開放給了非搜尋的標籤，例如「建立」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В iOS 27 роль `.prominent` открывает это место и для вкладок, не связанных с поиском, например «Создать»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iOS 27, `.prominent` abre este sitio también a pestañas que no son de búsqueda, por ejemplo «Crear»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS 27 öffnet `.prominent` diesen Platz auch für andere Tabs als die Suche, zum Beispiel „Erstellen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans iOS 27, `.prominent` ouvre cet emplacement aussi aux onglets autres que la recherche, par exemple « Créer »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS 27, `.prominent` apre questo posto anche a schede diverse dalla ricerca, per esempio «Crea»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iOS 27, `.prominent` abre este lugar também para abas que não são de busca, por exemplo «Criar»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน iOS 27 `.prominent` เปิดตำแหน่งนี้ให้แท็บอื่นนอกจากการค้นหาด้วย เช่น \"สร้าง\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong iOS 27, `.prominent` mở vị trí này cho cả các tab khác ngoài tìm kiếm, ví dụ \"Tạo\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V iOS 27 `.prominent` otevírá toto místo i jiným kartám než hledání, například „Vytvořit“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I iOS 27 åbner `.prominent` denne plads for andre faner end søgning, for eksempel »Opret«."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στο iOS 27, το `.prominent` ανοίγει αυτή τη θέση και σε καρτέλες εκτός από την αναζήτηση, για παράδειγμα «Δημιουργία»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 27:ssä `.prominent` avaa tämän paikan muillekin kuin hakuvälilehdille, esimerkiksi ”Luo”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iOS 27, `.prominent` membuka tempat ini juga untuk tab selain pencarian, misalnya \"Buat\"."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I iOS 27 åpner `.prominent` denne plassen for andre faner enn søk også, for eksempel «Opprett»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In iOS 27 opent `.prominent` deze plek ook voor andere tabbladen dan zoeken, bijvoorbeeld \"Maak\"."
          }
        }
      }
    },
    "iPhone 폭에서 6개는 터치 타깃과 라벨이 모두 압박됩니다. 3~5개로 추리고 **덜 중요한 건 탭 안의 화면으로** 내리세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At iPhone width, 6 tabs squeeze both touch targets and labels. Narrow it to 3 to 5 and move **less important things into screens inside the tabs**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "At iPhone width, 6 tabs squeeze both touch targets and labels. Narrow it to 3 to 5 and move **less important things into screens inside the tabs**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの幅で6個あると、タッチターゲットもラベルも窮屈になります。3〜5個に絞り、**重要度の低いものはタブ内の画面に**下げましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 폭에서 6개는 터치 타깃과 라벨이 모두 압박됩니다. 3~5개로 추리고 **덜 중요한 건 탭 안의 화면으로** 내리세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 的宽度上放 6 个，触控目标和标签都会吃紧。精简到 3 到 5 个，并把**次要的下沉到标签内的界面**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 的寬度上放 6 個，觸控目標和標籤都會吃緊。精簡到 3 到 5 個，並把**次要的下沉到標籤內的介面**。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ширине iPhone 6 вкладок давят и на области касания, и на подписи. Сократите до 3-5 и перенесите **менее важное на экраны внутри вкладок**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con el ancho de un iPhone, 6 pestañas aprietan tanto los objetivos táctiles como las etiquetas. Redúcelo a entre 3 y 5 y pasa **lo menos importante a pantallas dentro de las pestañas**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei iPhone-Breite quetschen 6 Tabs sowohl Touch-Ziele als auch Beschriftungen. Reduziere auf 3 bis 5 und verschiebe **Weniger Wichtiges in Bildschirme innerhalb der Tabs**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la largeur d'un iPhone, 6 onglets compriment à la fois les cibles tactiles et les libellés. Réduisez à 3 à 5 et déplacez **le moins important dans des écrans à l'intérieur des onglets**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla larghezza di un iPhone, 6 schede comprimono sia i bersagli tattili sia le etichette. Riducile a 3-5 e sposta **le cose meno importanti in schermate all'interno delle schede**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na largura do iPhone, 6 abas espremem tanto os alvos de toque quanto os rótulos. Reduza para 3 a 5 e mova o **que é menos importante para telas dentro das abas**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่ความกว้างของ iPhone 6 แท็บบีบทั้งเป้าสัมผัสและป้ายชื่อ ลดเหลือ 3 ถึง 5 แล้วย้าย**สิ่งที่สำคัญน้อยกว่าไปไว้ในหน้าจอภายในแท็บ**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở độ rộng iPhone, 6 tab ép cả vùng chạm lẫn nhãn. Thu về 3 đến 5 và chuyển **những thứ ít quan trọng hơn vào các màn hình bên trong tab**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při šířce iPhonu 6 karet svírá dotykové plochy i popisky. Zúžte na 3 až 5 a **méně důležité věci přesuňte na obrazovky uvnitř karet**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved iPhone-bredde presser 6 faner både berøringsmål og etiketter. Indsnævr til 3 til 5 og flyt **mindre vigtige ting ind på skærme i fanerne**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σε πλάτος iPhone, 6 καρτέλες στριμώχνουν και τους στόχους αφής και τις ετικέτες. Περιόρισέ το σε 3 έως 5 και μετακίνησε **τα λιγότερο σημαντικά σε οθόνες μέσα στις καρτέλες**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhonen leveydellä 6 välilehteä ahdistaa sekä kosketuskohteita että nimikkeitä. Supista 3-5:een ja siirrä **vähemmän tärkeät asiat välilehtien sisällä oleviin näkymiin**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pada lebar iPhone, 6 tab menghimpit target sentuh sekaligus label. Persempit menjadi 3 sampai 5 dan pindahkan **hal yang kurang penting ke layar di dalam tab**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved iPhone-bredde klemmer 6 faner både berøringsmål og etiketter. Begrens til 3 til 5 og flytt **det mindre viktige inn i skjermer inne i fanene**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij iPhone-breedte persen 6 tabbladen zowel aanraakdoelen als labels samen. Beperk tot 3 tot 5 en verplaats **minder belangrijke dingen naar schermen binnen de tabbladen**."
          }
        }
      }
    },
    "inline이 시각적으로 더 아름다우므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because inline looks better visually"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because inline looks better visually"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "inlineのほうが見た目が美しいから"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "inline이 시각적으로 더 아름다우므로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为 inline 在视觉上更美观"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為 inline 在視覺上更美觀"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что inline выглядит красивее"
