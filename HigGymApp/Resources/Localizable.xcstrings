          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상세"
          }
        }
      }
    },
    "상세 화면 쪽": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detail screen side"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面側"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상세 화면 쪽"
          }
        }
      }
    },
    "상세 화면에 툴바가 있을 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the detail screen has a toolbar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面にツールバーがあるとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상세 화면에 툴바가 있을 때"
          }
        }
      }
    },
    "상세 화면에서 탭바 숨기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the tab bar on detail screens"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面でタブバーを隠す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상세 화면에서 탭바 숨기기"
          }
        }
      }
    },
    "상세 화면으로 들어가 보세요, 탭바가 **사라집니다**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go into the detail screen: the tab bar **disappears**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面に入ってみてください。タブバーが**消えます**。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상세 화면으로 들어가 보세요, 탭바가 **사라집니다**."
          }
        }
      }
    },
    "상세 화면으로 들어가기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to detail screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面へ進む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상세 화면으로 들어가기"
          }
        }
      }
    },
    "상세 화면이 스크롤이 길 때": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the detail screen scrolls a long way"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面のスクロールが長いとき"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상세 화면이 스크롤이 길 때"
          }
        }
      }
    },
    "상세 화면입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the detail screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상세 화면입니다."
          }
        }
      }
    },
    "상세에서 탭바를 숨기는 건 **몰입이 주 작업일 때**만 맞습니다(사진 전체화면·영상·작성 중). 얕은 계층이라면 탭바는 “지금 어디에 있는지”를 알려주는 상시 지도이므로 유지가 기본값입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding the tab bar in a detail view is right only **when immersion is the main task** (full-screen photos, video, composing). In a shallow hierarchy the tab bar is an always-on map that tells you “where you are now,” so keeping it is the default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細画面でタブバーを隠すのは、**没入が主な作業のとき**だけが正解です（写真の全画面表示、動画、作成中）。階層が浅いなら、タブバーは「いまどこにいるか」を伝える常設の地図なので、残すのが基本です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상세에서 탭바를 숨기는 건 **몰입이 주 작업일 때**만 맞습니다(사진 전체화면·영상·작성 중). 얕은 계층이라면 탭바는 “지금 어디에 있는지”를 알려주는 상시 지도이므로 유지가 기본값입니다."
          }
        }
      }
    },
    "상황 → 컴포넌트": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Situation → Component"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場面 → コンポーネント"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상황 → 컴포넌트"
          }
        }
      }
    },
    "새 API라서가 아니라, 이 액션의 대상이 제목이기 때문입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not because it's a new API, but because the target of this action is the title."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいAPIだからではなく、このアクションの対象がタイトルだからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 API라서가 아니라, 이 액션의 대상이 제목이기 때문입니다."
          }
        }
      }
    },
