    "버전 2.4.0 이 App Store 에 게시되었습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version 2.4.0 is now live on the App Store."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Version 2.4.0 is now live on the App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン 2.4.0 が App Store で公開されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 2.4.0 이 App Store 에 게시되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2.4.0 版已在 App Store 上架。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
