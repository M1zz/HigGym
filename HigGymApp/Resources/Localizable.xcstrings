        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar delante, Destacar e Imprimir plegados. Guardados: %lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern vorn, Markieren und Drucken weggefaltet. Gesichert: %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer en tête, Favori et Imprimer repliés. Enregistrements : %lld"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva in primo piano, Preferiti e Stampa ripiegati. Salvataggi: %lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar na frente, Favorito e Imprimir dobrados. Salvamentos: %lld"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกอยู่หน้า ติดดาวและพิมพ์ถูกพับ จำนวนครั้งที่บันทึก: %lld"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu ở đầu, Gắn sao và In gập đi. Số lần lưu: %lld"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložit vpředu, Hvězdička a Tisk sbaleny. Uloženo: %lld"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem forrest, Stjerne og Udskriv foldet væk. Gem: %lld"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Αποθήκευση μπροστά, το Αστέρι και η Εκτύπωση διπλωμένα. Αποθηκεύσεις: %lld"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna edessä, Tähti ja Tulosta taitettu. Tallennuksia: %lld"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan di depan, Bintang dan Cetak dilipat. Simpanan: %lld"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre foran, Stjerne og Skriv ut foldet. Lagringer: %lld"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar vooraan, Ster en Print weggeklapt. Bewaard: %lld"
          }
        }
      }
    },
    "저장하는 순간 굳습니다, 하루 뒤에도, 영어 사용자에게도 \"3일 전\"입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It freezes the moment it's saved. A day later, and for English speakers too, it still says \"3 days ago.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It freezes the moment it's saved. A day later, and for English speakers too, it still says \"3 days ago.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した瞬間に固まります。1日後も、英語のユーザーにも「3日前」のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하는 순간 굳습니다, 하루 뒤에도, 영어 사용자에게도 \"3일 전\"입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一存储就固化了：一天后、对英语用户来说，依然是“3 天前”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一儲存就固化了：一天後、對英語使用者來說，依然是「3 天前」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно застывает в момент сохранения. Через сутки и для англоязычных пользователей там всё равно «3 дня назад»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se congela en el momento en que se guarda. Un día después, y también para los angloparlantes, sigue diciendo «hace 3 días»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es friert in dem Moment ein, in dem es gesichert wird. Einen Tag später, auch für Englischsprachige, steht dort immer noch „vor 3 Tagen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se fige à l'instant de l'enregistrement. Un jour plus tard, et pour les anglophones aussi, il affiche toujours « il y a 3 jours »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si congela nel momento in cui viene salvato. Un giorno dopo, e anche per chi parla inglese, dice ancora «3 giorni fa»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Congela no momento em que é salvo. Um dia depois, e até para quem fala inglês, continua dizendo «há 3 dias»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มันค้างทันทีที่บันทึก ผ่านไปหนึ่งวัน และสำหรับผู้ใช้ภาษาอังกฤษด้วย ก็ยังเขียนว่า \"3 วันที่แล้ว\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó đóng băng ngay khi được lưu. Một ngày sau, và cả với người dùng tiếng Anh, nó vẫn ghi \"3 ngày trước.\""
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamrzne to ve chvíli uložení. O den později, i pro anglicky mluvící, to pořád říká „před 3 dny“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fryser i det øjeblik, den gemmes. En dag senere, også for engelsktalende, står der stadig »for 3 dage siden.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παγώνει τη στιγμή που αποθηκεύεται. Μια μέρα αργότερα, και για αγγλόφωνους επίσης, λέει ακόμα «πριν από 3 ημέρες»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se jäätyy tallennushetkellä. Päivää myöhemmin, myös englanninkielisille, siinä lukee yhä ”3 päivää sitten”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia membeku saat disimpan. Sehari kemudian, dan untuk penutur bahasa Inggris juga, tetap tertulis \"3 hari lalu.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fryser i det øyeblikket den lagres. En dag senere, også for engelsktalende, står det fortsatt «3 dager siden»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bevriest op het moment dat het wordt bewaard. Een dag later, en ook voor Engelstaligen, staat er nog steeds \"3 dagen geleden\"."
          }
        }
      }
    },
    "저장하지 않고 나가는 경로를 만들기 위한 선택 사항이다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's optional, a way to leave without saving"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's optional, a way to leave without saving"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存せずに抜ける経路をつくるための任意の項目だ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하지 않고 나가는 경로를 만들기 위한 선택 사항이다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是为了做出不存储就离开的路径而设的可选项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是為了做出不儲存就離開的路徑而設的可選項"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это необязательно, способ выйти без сохранения"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es opcional, una forma de salir sin guardar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist optional, ein Weg, ohne Sichern zu gehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est facultatif, un moyen de partir sans enregistrer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È facoltativo, un modo per uscire senza salvare"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É opcional, um jeito de sair sem salvar"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป็นทางเลือก เป็นวิธีออกโดยไม่บันทึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó là tùy chọn, một cách để rời đi mà không lưu"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to volitelné, způsob, jak odejít bez uložení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er valgfri, en måde at forlade siden uden at gemme"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι προαιρετικό, ένας τρόπος να φύγεις χωρίς αποθήκευση"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on valinnainen, tapa poistua tallentamatta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini opsional, cara untuk pergi tanpa menyimpan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er valgfritt, en måte å forlate uten å lagre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is optioneel, een manier om weg te gaan zonder te bewaren"
          }
        }
      }
    },
