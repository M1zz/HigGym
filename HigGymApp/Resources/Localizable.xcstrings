        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例：在下面看得很清楚，到了雪地上白色文字就融進了背景。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
