            "state": "translated",
            "value": "หน้าจอด้านหลัง · ลองแตะการ์ด (%lld ครั้ง)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình phía sau · Hãy chạm vào thẻ (%lld lần)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazovka vzadu · Klepněte na karty (%lld×)"
          }
        },
        "da": {
