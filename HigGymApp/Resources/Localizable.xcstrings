          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 아래로 쓸어내려도 안 닫혔다. 버튼이 없었으면 앱이 멈춘 줄 알고 껐을 것 같다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
