        }
      }
    },
    "실수 %lld편은 Pro에서 열립니다. 무엇을 했고, 왜 그게 맞아 보였고, 어떻게 고치는지까지 전부 봅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistake %lld is part of Pro. See what was done, why it seemed right, and how to fix it, for every one."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistake %lld is part of Pro. See what was done, why it seemed right, and how to fix it, for every one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミス%lldはProで開きます。何をしたか、なぜ正しく見えたか、どう直すかまで、すべて読めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 篇失误在 Pro 中开放。做了什么、当时为什么觉得对、怎样修正，全部能看到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 篇失誤在 Pro 中開放。做了什麼、當時為什麼覺得對、怎樣修正，全部能看到。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка %lld открывается в Pro. Вы увидите, что сделали, почему это казалось верным и как исправить, для каждой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El error %lld es parte de Pro. Descubre qué se hizo, por qué parecía correcto y cómo arreglarlo, en cada uno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler %lld gehört zu Pro. Sieh bei jedem, was getan wurde, warum es richtig aussah und wie man es behebt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'erreur %lld est réservée à Pro. Voyez ce qui a été fait, pourquoi cela semblait juste et comment la corriger, pour chacune."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'errore %lld fa parte di Pro. Scopri che cosa è stato fatto, perché sembrava giusto e come correggerlo, per ognuno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O erro %lld faz parte do Pro. Veja o que foi feito, por que parecia certo e como corrigir, em cada um."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อผิดพลาด %lld เป็นส่วนของ Pro ดูสิ่งที่ทำ เหตุผลที่ดูถูกต้อง และวิธีแก้ ทุกข้อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi %lld là một phần của Pro. Xem đã làm gì, vì sao nó có vẻ đúng, và cách sửa, cho từng lỗi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chyba %lld je součástí Pro. Podívejte se u každé, co se udělalo, proč se to zdálo správné a jak to opravit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejl %lld er en del af Pro. Se hvad der blev gjort, hvorfor det virkede rigtigt, og hvordan det rettes, for hver eneste."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το λάθος %lld αποτελεί μέρος του Pro. Δες τι έγινε, γιατί φαινόταν σωστό και πώς διορθώνεται, για κάθε ένα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virhe %lld kuuluu Pro-versioon. Katso, mitä tehtiin, miksi se tuntui oikealta ja miten se korjataan, jokaisen kohdalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesalahan %lld adalah bagian dari Pro. Lihat apa yang dilakukan, mengapa tampak benar, dan cara memperbaikinya, untuk setiap kesalahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Feil %lld er en del av Pro. Se hva som ble gjort, hvorfor det virket riktig og hvordan det fikses, for hver eneste en."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fout %lld is onderdeel van Pro. Zie bij elke fout wat er gedaan is, waarom het goed leek en hoe je het repareert."
          }
        }
      }
    },
    "%@ 실습실은 Pro에서 열립니다. 설정을 바꿀 때마다 그 자리에서 판정을 받습니다.": {
      "localizations": {
        "en": {
