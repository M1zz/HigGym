            "value": "// fullScreenCover ne se ferme pas par un balayage vers le bas. Vous devez construire la sortie vous-même.\n.fullScreenCover(isPresented: $editing) {\n    EditorView()\n        .toolbar {\n            ToolbarItem(placement: .topBarLeading) { Button(\"Annuler\") { editing = false } }\n            ToolbarItem(placement: .topBarTrailing) { Button(\"OK\") { save() } }\n        }\n}"
          }
        },
        "it": {
