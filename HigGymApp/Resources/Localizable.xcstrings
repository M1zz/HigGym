          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một công cụ và chạm"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte nástroj a klepněte na něj"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
