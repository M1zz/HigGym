    "제목 메뉴가 iOS 26의 새 기능이라 써본 것이다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was tried because the title menu is new in iOS 26"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It was tried because the title menu is new in iOS 26"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルメニューがiOS 26の新機能なので使ってみた"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 메뉴가 iOS 26의 새 기능이라 써본 것이다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题菜单是 iOS 26 的新功能，所以拿来试了"
