    "탭이 가리키는 목적지가 없습니다. \"어디로 가는가\"에 답을 못 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab doesn't point to any destination. It can't answer \"where am I going?\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The tab doesn't point to any destination. It can't answer \"where am I going?\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブが指す行き先がありません。「どこへ行くのか」に答えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭이 가리키는 목적지가 없습니다. \"어디로 가는가\"에 답을 못 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签没有指向的目的地，回答不了“要去哪里”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標籤沒有指向的目的地，回答不了「要去哪裡」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка не указывает ни на какое место назначения. Она не отвечает на вопрос «куда я иду?»"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña no apunta a ningún destino. No puede responder a «¿adónde voy?»."
          }
        }
      }
    },
    "탭이 넘칠 때 의심할 것": {
