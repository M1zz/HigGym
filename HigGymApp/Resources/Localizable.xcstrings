    "다크 모드 색을 알아서 맞춰주므로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because it adapts colors for Dark Mode automatically"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Because it adapts colours for Dark Mode automatically"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダークモードの色を自動で合わせてくれるから"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다크 모드 색을 알아서 맞춰주므로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为会自动适配深色模式的颜色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為會自動適配深色模式的顏色"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потому что цвета сами адаптируются к тёмной теме"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque adapta los colores al modo oscuro automáticamente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil es die Farben automatisch für den Dunkelmodus anpasst"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce qu'il adapte automatiquement les couleurs au mode sombre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché adatta automaticamente i colori alla modalità scura"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porque adapta as cores para o Modo Escuro automaticamente"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพราะปรับสีสำหรับโหมดมืดให้อัตโนมัติ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì nó tự điều chỉnh màu cho chế độ tối"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Protože přizpůsobuje barvy tmavému režimu automaticky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi den automatisk tilpasser farver til mørk tilstand"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επειδή προσαρμόζει αυτόματα τα χρώματα για τη Σκοτεινή εμφάνιση"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koska se mukauttaa värit automaattisesti tummaan tilaan"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karena ia menyesuaikan warna untuk Mode Gelap secara otomatis"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordi den tilpasser farger for mørk modus automatisk"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat het kleuren automatisch aanpast voor Donkere modus"
          }
        }
      }
    },
    "다크 모드에서 잘 보이는지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether it's easy to see in Dark Mode"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether it's easy to see in Dark Mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダークモードでよく見えるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다크 모드에서 잘 보이는지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色模式下看得清吗"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色模式下看得清嗎"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошо ли это видно в тёмной теме"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se ve bien en modo oscuro"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob es im Dunkelmodus gut zu sehen ist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'il est facile à voir en mode sombre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se si vede bene in modalità scura"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se é fácil de ver no Modo Escuro"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มองเห็นง่ายในโหมดมืดหรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có dễ nhìn trong chế độ tối không"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zda je dobře vidět v tmavém režimu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Om det er nemt at se i mørk tilstand"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν φαίνεται εύκολα στη Σκοτεινή εμφάνιση"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Onko se helppo nähdä tummassa tilassa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah mudah dilihat di Mode Gelap"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Om det er lett å se i mørk modus"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of het goed te zien is in Donkere modus"
          }
        }
      }
    },
    "다크 모드일수록 두껍게": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thicker in Dark Mode"
          }
        },
        "en-GB": {
