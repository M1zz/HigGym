          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**«Написать»**, самое частое действие, стоит в самом верху экрана. Нажмите его 5 раз одной рукой."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Redactar**, la acción más usada, está en lo más alto de la pantalla. Tócala 5 veces con una sola mano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Verfassen**, die am häufigsten genutzte Aktion, sitzt ganz oben auf dem Bildschirm. Tippe sie mit einer Hand 5-mal an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
