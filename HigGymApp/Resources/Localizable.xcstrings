            "state": "translated",
            "value": "고빈도는 하단"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高频操作放底部"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高頻操作放底部"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частые действия - внизу"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones frecuentes van abajo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufige Aktionen gehören nach unten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions fréquentes vont en bas"
          }
        },
        "it": {
