    "무엇을 접고 무엇을 남길지, 시스템이 이미 정해둔 우선순위를 확인하는 항목입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This topic checks the priorities the system has already set for what to fold away and what to keep."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This topic checks the priorities the system has already set for what to fold away and what to keep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何をしまって何を残すか、システムがすでに決めている優先順位を確かめるトピックです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 접고 무엇을 남길지, 시스템이 이미 정해둔 우선순위를 확인하는 항목입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来确认哪些该折叠、哪些该保留，这是系统已经定好的优先级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來確認哪些該摺疊、哪些該保留，這是系統已經定好的優先順序。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта тема проверяет приоритеты, которые система уже определила: что сворачивать, а что оставлять."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tema comprueba las prioridades que el sistema ya ha fijado sobre qué plegar y qué conservar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Thema prüft die Prioritäten, die das System bereits festgelegt hat, was weggefaltet und was behalten wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sujet vérifie les priorités que le système a déjà fixées pour ce qu'il faut replier et ce qu'il faut garder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo argomento verifica le priorità che il sistema ha già fissato su cosa ripiegare e cosa tenere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tópico confere as prioridades que o sistema já definiu sobre o que dobrar e o que manter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หัวข้อนี้ตรวจลำดับความสำคัญที่ระบบกำหนดไว้แล้วว่าจะพับอะไรและเก็บอะไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề này kiểm tra các thứ tự ưu tiên mà hệ thống đã đặt sẵn về cái gì gập đi và cái gì giữ lại."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto téma ověřuje priority, které systém už nastavil pro to, co sbalit a co ponechat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette emne tjekker de prioriteter, systemet allerede har sat for, hvad der foldes væk, og hvad der beholdes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το θέμα ελέγχει τις προτεραιότητες που έχει ήδη ορίσει το σύστημα για το τι διπλώνεται και τι μένει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä aihe tarkistaa prioriteetit, jotka järjestelmä on jo asettanut sille, mikä taitetaan pois ja mikä säilytetään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Topik ini memeriksa prioritas yang sudah ditetapkan sistem tentang apa yang dilipat dan apa yang dipertahankan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette emnet sjekker prioriteringene systemet allerede har satt for hva som foldes bort og hva som beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit onderwerp controleert de prioriteiten die het systeem al heeft vastgesteld voor wat wordt weggeklapt en wat blijft."
          }
        }
      }
    },
    "무엇을 지우는지가 분명해지고, 미는 동작 자체가 오탭을 막습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's clear what you're deleting, and the swipe itself prevents accidental taps."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's clear what you're deleting, and the swipe itself prevents accidental taps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を削除するのかがはっきりし、スワイプという動作そのものが誤タップを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 지우는지가 분명해지고, 미는 동작 자체가 오탭을 막습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除什么变得一目了然，滑动这个动作本身就能防止误点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除什麼變得一目瞭然，滑動這個動作本身就能防止誤點。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понятно, что именно вы удаляете, а само смахивание защищает от случайных нажатий."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está claro lo que eliminas, y el propio deslizamiento evita los toques accidentales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist klar, was du löschst, und das Wischen selbst verhindert versehentliches Antippen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On voit clairement ce que vous supprimez, et le balayage lui-même évite les touchers accidentels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È chiaro che cosa stai eliminando, e lo scorrimento stesso previene i tocchi accidentali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica claro o que você está excluindo, e o próprio deslize evita toques acidentais."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชัดเจนว่าคุณกำลังลบอะไร และการปัดเองก็ป้องกันการแตะพลาด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rõ ràng bạn đang xóa gì, và bản thân cú vuốt ngăn việc chạm nhầm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je jasné, co mažete, a samotné přejetí brání omylem klepnutým akcím."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er tydeligt, hvad du sletter, og selve strygningen forhindrer utilsigtede tryk."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι σαφές τι διαγράφεις, και το ίδιο το σύρσιμο εμποδίζει τα κατά λάθος πατήματα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "On selvää, mitä poistat, ja pyyhkäisy itsessään estää vahingossa napautukset."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelas apa yang kamu hapus, dan usapan itu sendiri mencegah ketukan tidak sengaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er tydelig hva du sletter, og selve sveipet hindrer utilsiktede trykk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is duidelijk wat je verwijdert, en het vegen zelf voorkomt onbedoelde tikken."
          }
        }
      }
    },
