    "폴더 전환을 잘 안 쓰니까 눈에 안 띄게 감췄다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder switching is rarely used, so I tucked it out of sight"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder switching is rarely used, so I tucked it out of sight"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ切り替えはあまり使わないので、目立たないように隠した"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 전환을 잘 안 쓰니까 눈에 안 띄게 감췄다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为不太用切换文件夹，所以藏得不显眼"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為不太用切換資料夾，所以藏得不顯眼"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключением папок пользуются редко, поэтому убрали с глаз"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de carpeta se usa poco, así que lo escondí"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordnerwechsel wird selten genutzt, daher habe ich ihn aus dem Blick geräumt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement de dossier est rarement utilisé, donc je l'ai rangé hors de vue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cambio di cartella si usa di rado, quindi l'ho nascosto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A troca de pasta é pouco usada, então a escondi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสลับโฟลเดอร์ใช้น้อย ฉันจึงซ่อนไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển thư mục hiếm khi dùng, nên tôi cất nó khuất tầm mắt"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínání složek se používá zřídka, tak jsem ho schoval z očí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappeskift bruges sjældent, så jeg gemte det af vejen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εναλλαγή φακέλων χρησιμοποιείται σπάνια, γι' αυτό την έκρυψα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansion vaihtoa käytetään harvoin, joten piilotin sen näkyvistä"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergantian folder jarang dipakai, jadi aku menyembunyikannya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappebytte brukes sjelden, så jeg gjemte det unna"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van map wisselen wordt zelden gebruikt, dus ik heb het uit het zicht gestopt"
          }
        }
      }
    },
    "폴더 전환을 제목 자체에 붙였다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attached folder switching to the title itself."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Attached folder switching to the title itself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ切り替えをタイトルそのものに付けた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 전환을 제목 자체에 붙였다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把切换文件夹附在标题本身上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把切換資料夾附在標題本身上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привязали переключение папок к самому заголовку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se unió el cambio de carpeta al propio título."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Ordnerwechsel an den Titel selbst gebunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement de dossier a été rattaché au titre lui-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho agganciato il cambio di cartella al titolo stesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendeu a troca de pasta ao próprio título."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผูกการสลับโฟลเดอร์เข้ากับชื่อเรื่องเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gắn việc chuyển thư mục vào chính tiêu đề."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínání složek připojeno k samotnému nadpisu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Knyttede mappeskift til selve titlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνέδεσε την εναλλαγή φακέλων με τον ίδιο τον τίτλο."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitti kansion vaihdon itse otsikkoon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menempelkan pergantian folder pada judul itu sendiri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Festet mappebyttet til selve tittelen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wisselen van map aan de titel zelf gekoppeld."
          }
        }
      }
    },
    "폴더 전환이 제목 메뉴 ↔ 왼쪽 위 별도 버튼으로 옮겨졌습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder switching: in the title menu ↔ moved to a separate button at the top left."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder switching: in the title menu ↔ moved to a separate button at the top left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ切り替えが、タイトルのメニュー ↔ 左上の別ボタンへ移されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 전환이 제목 메뉴 ↔ 왼쪽 위 별도 버튼으로 옮겨졌습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换文件夹：标题菜单 ↔ 挪到了左上角的单独按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換資料夾：標題選單 ↔ 挪到了左上角的單獨按鈕。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключение папок: в меню заголовка ↔ перенесено в отдельную кнопку слева вверху."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio de carpeta: en el menú del título ↔ movido a un botón aparte arriba a la izquierda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnerwechsel: im Titelmenü ↔ in einen separaten Button oben links verlegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changement de dossier : dans le menu du titre ↔ déplacé vers un bouton séparé en haut à gauche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio di cartella: nel menu del titolo ↔ spostato in un pulsante separato in alto a sinistra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca de pasta: no menu do título ↔ movida para um botão separado no canto superior esquerdo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสลับโฟลเดอร์: ในเมนูชื่อเรื่อง ↔ ย้ายไปเป็นปุ่มแยกที่ซ้ายบน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển thư mục: trong menu tiêu đề ↔ chuyển sang một nút riêng ở trên cùng bên trái."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepínání složek: v nabídce nadpisu ↔ přesunuto na samostatné tlačítko vlevo nahoře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappeskift: i titelmenuen ↔ flyttet til en separat knap øverst til venstre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εναλλαγή φακέλων: στο μενού τίτλου ↔ μεταφέρθηκε σε ξεχωριστό κουμπί πάνω αριστερά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansion vaihto: otsikkovalikossa ↔ siirretty erilliseen painikkeeseen vasempaan yläkulmaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergantian folder: di menu judul ↔ dipindah ke tombol terpisah di kiri atas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappebytte: i tittelmenyen ↔ flyttet til en separat knapp øverst til venstre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van map wisselen: in het titelmenu ↔ verplaatst naar een aparte knop linksboven."
          }
        }
      }
    },
    "폴더를 **업무 → 개인**으로 바꿔보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the folder from **Work → Personal**."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch the folder from **Work → Personal**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを**仕事 → 個人**に切り替えてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 **업무 → 개인**으로 바꿔보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把文件夹从**工作 → 个人**切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把資料夾從**工作 → 個人**切換。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключите папку с **«Работа» на «Личное»**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la carpeta de **Trabajo → Personal**."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle den Ordner von **Arbeit → Privat**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez de dossier de **Travail → Personnel**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa dalla cartella **Lavoro → Personale**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troque a pasta de **Trabalho → Pessoal**."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลับโฟลเดอร์จาก**งาน → ส่วนตัว**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển thư mục từ **Công việc → Cá nhân**."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepněte složku z **Práce → Osobní**."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift mappe fra **Arbejde → Privat**."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άλλαξε φάκελο από **Εργασία → Προσωπικά**."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda kansio **Työ → Henkilökohtainen**."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti folder dari **Kerja → Pribadi**."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt mappe fra **Jobb → Privat**."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel de map van **Werk → Privé**."
          }
        }
      }
    },
    "폴더를 고르면 제목과 목록이 함께 바뀝니다. 제목이 \"지금 무엇을 보고 있는가\"를 말하고 있기 때문입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a folder and the title and list change together, because the title is saying \"what you're looking at right now.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a folder and the title and list change together, because the title is saying \"what you're looking at right now.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選ぶとタイトルとリストが一緒に変わります。タイトルが「今何を見ているか」を伝えているからです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 고르면 제목과 목록이 함께 바뀝니다. 제목이 \"지금 무엇을 보고 있는가\"를 말하고 있기 때문입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件夹，标题和列表一起变化。因为标题在说“现在在看什么”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇資料夾，標題和列表一起變化。因為標題在說「現在在看什麼」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку, и заголовок и список изменятся вместе, потому что заголовок говорит, «что вы сейчас смотрите»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta y el título y la lista cambian juntos, porque el título dice «lo que estás viendo ahora mismo»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner, und Titel und Liste ändern sich gemeinsam, weil der Titel sagt: „was du gerade ansiehst“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier et le titre et la liste changent ensemble, parce que le titre dit « ce que vous regardez en ce moment »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella e titolo ed elenco cambiano insieme, perché il titolo dice «che cosa stai guardando adesso»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta e o título e a lista mudam juntos, porque o título está dizendo «o que você está vendo agora»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกโฟลเดอร์แล้วชื่อเรื่องและรายการเปลี่ยนไปด้วยกัน เพราะชื่อเรื่องบอกว่า \"สิ่งที่คุณกำลังดูอยู่ตอนนี้\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thư mục và tiêu đề cùng danh sách đổi theo, vì tiêu đề nói \"thứ bạn đang xem lúc này\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte složku a nadpis i seznam se změní společně, protože nadpis říká „na co se právě díváte“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en mappe, og titel og liste ændres sammen, fordi titlen siger »hvad du ser på lige nu.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διάλεξε έναν φάκελο και ο τίτλος και η λίστα αλλάζουν μαζί, επειδή ο τίτλος λέει «αυτό που κοιτάς αυτή τη στιγμή»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kansio, niin otsikko ja luettelo muuttuvat yhdessä, koska otsikko kertoo ”mitä katsot juuri nyt”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder dan judul serta daftar berubah bersama, karena judul berkata \"apa yang sedang kamu lihat sekarang.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en mappe, og tittelen og listen endres sammen, fordi tittelen sier «det du ser på akkurat nå»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map en de titel en de lijst veranderen samen, omdat de titel zegt \"waar je nu naar kijkt\"."
          }
        }
      }
    },
    "폴더를 바꾸는 곳을 어디서 찾았나요? 제목과 그 버튼이 서로 이어져 있다고 느꼈나요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did you find the way to switch folders? Did the title and that button feel connected?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did you find the way to switch folders? Did the title and that button feel connected?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを切り替える場所はどこで見つけましたか？タイトルとそのボタンがつながっていると感じましたか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 바꾸는 곳을 어디서 찾았나요? 제목과 그 버튼이 서로 이어져 있다고 느꼈나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是在哪里找到更换文件夹的？你觉得标题和那个按钮是连在一起的吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你是在哪裡找到更換資料夾的？你覺得標題和那個按鈕是連在一起的嗎？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где вы нашли способ сменить папку? Казалось ли, что заголовок и эта кнопка связаны?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde encontraste la forma de cambiar de carpeta? ¿Sentiste el título y ese botón conectados?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo hast du den Weg gefunden, Ordner zu wechseln? Fühlten sich der Titel und dieser Button verbunden an?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où avez-vous trouvé le moyen de changer de dossier ? Le titre et ce bouton vous ont-ils paru liés ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove hai trovato il modo di cambiare cartella? Titolo e pulsante ti sono sembrati collegati?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde você achou o jeito de trocar de pasta? O título e aquele botão pareceram ligados?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเจอวิธีสลับโฟลเดอร์ที่ไหน ชื่อเรื่องกับปุ่มนั้นรู้สึกเชื่อมกันไหม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn tìm thấy cách chuyển thư mục ở đâu? Tiêu đề và nút đó có cảm giác liên kết không?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kde jste našli způsob přepnutí složek? Působily nadpis a to tlačítko jako propojené?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor fandt du vejen til at skifte mappe? Føltes titlen og den knap forbundet?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πού βρήκες τον τρόπο να αλλάξεις φάκελο; Ένιωσες συνδεδεμένο τον τίτλο με εκείνο το κουμπί;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistä löysit tavan vaihtaa kansiota? Tuntuiko otsikko ja se painike yhteen kuuluvilta?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di mana kamu menemukan cara mengganti folder? Apakah judul dan tombol itu terasa terhubung?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor fant du måten å bytte mappe på? Føltes tittelen og den knappen sammenkoblet?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar vond je de manier om van map te wisselen? Voelden de titel en die knop als verbonden?"
          }
        }
      }
    },
    "폴더를 바꾸는 방법이 **제목을 누르는 것**입니다. 왜 별도 버튼을 두지 않았을까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You switch folders by **tapping the title**. Why isn't there a separate button?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You switch folders by **tapping the title**. Why isn't there a separate button?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを切り替える方法は**タイトルを押すこと**です。なぜ別のボタンを置かなかったのでしょう？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 바꾸는 방법이 **제목을 누르는 것**입니다. 왜 별도 버튼을 두지 않았을까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换文件夹的方式是**点按标题**。为什么不另设按钮？"
