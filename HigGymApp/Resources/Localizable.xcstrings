    "%lld편": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld lesson"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld lessons"
                }
              }
