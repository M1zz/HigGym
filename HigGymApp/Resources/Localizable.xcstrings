    },
    "본문 선택·복사가 열린 쪽 ↔ 막힌 쪽입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body text selection and copy: open ↔ blocked."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Body text selection and copy: open ↔ blocked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の選択・コピーが開いている側 ↔ ふさがれている側です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문 선택·복사가 열린 쪽 ↔ 막힌 쪽입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正文可以选择、复制的一边 ↔ 被封住的一边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
