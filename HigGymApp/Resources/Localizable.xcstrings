    "커스텀 하단 컨트롤 바를 만들 때 safeAreaBar를 쓰는 이유는?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why use safeAreaBar when building a custom bottom control bar?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Why use safeAreaBar when building a custom bottom control bar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムの下部コントロールバーを作るとき、safeAreaBarを使う理由は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커스텀 하단 컨트롤 바를 만들 때 safeAreaBar를 쓰는 이유는?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做自定义底部控制栏时，为什么用 safeAreaBar？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做自定義底部控制列時，為什麼用 safeAreaBar？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачем использовать safeAreaBar при создании пользовательской нижней панели управления?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué usar safeAreaBar al construir una barra de control inferior personalizada?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum safeAreaBar verwenden, wenn man eine eigene untere Steuerleiste baut?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
