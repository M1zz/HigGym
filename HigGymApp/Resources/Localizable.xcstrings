    "작성 버튼을 오른쪽 아래로 옮기기로 결정했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We decided to move the Compose button to the bottom right."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We decided to move the Compose button to the bottom right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成ボタンを右下に移すことに決めました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성 버튼을 오른쪽 아래로 옮기기로 결정했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决定把撰写按钮移到右下角。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "決定把撰寫按鈕移到右下角。"
          }
        },
        "ru": {
