            "value": "Add"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가"
          }
        }
      }
    },
    "추억 추천": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Featured memories"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめのメモリー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추억 추천"
          }
        }
      }
    },
    "추천": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천"
          }
        }
      }
    },
    "축소 한계를 0.3까지 낮추면 어디까지 읽히는지 확인해 보세요. 읽히지 않으면 축소는 실패입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower the scale limit to 0.3 and see how far it stays readable. If it can't be read, scaling has failed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小の下限を0.3まで下げて、どこまで読めるか確認してみてください。読めなければ縮小は失敗です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축소 한계를 0.3까지 낮추면 어디까지 읽히는지 확인해 보세요. 읽히지 않으면 축소는 실패입니다."
          }
        }
      }
    },
    "축소·분리·자리 확보를 조합해 한 툴바 안에서 공존시키는 게 이 항목의 요지입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The point of this topic is combining scaling, separation, and reserved space so everything coexists in one toolbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小・分離・スペース確保を組み合わせて、ひとつのツールバーの中で共存させることがこのトピックの要点です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축소·분리·자리 확보를 조합해 한 툴바 안에서 공존시키는 게 이 항목의 요지입니다."
          }
        }
      }
    },
    "축소가 아니라 설계 문제, 폭을 늘리거나 표기를 줄인다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a design problem, not a scaling one: make it wider or shorten the text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小ではなく設計の問題。幅を広げるか表記を短くする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축소가 아니라 설계 문제, 폭을 늘리거나 표기를 줄인다"
          }
        }
      }
    },
    "출구가 뒤로가기 하나뿐입니다. 몰입은 얻고 이동성은 잃습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only way out is Back. You gain immersion and lose mobility."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出口が「戻る」ひとつだけです。没入感は得られますが、移動のしやすさを失います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출구가 뒤로가기 하나뿐입니다. 몰입은 얻고 이동성은 잃습니다."
          }
        }
      }
    },
