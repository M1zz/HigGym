    "제한을 넘는 내용은 사라집니다. **몇 줄이면 뜻이 통하는가**가 이 값을 정하는 기준입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content past the limit disappears. **How many lines it takes to make sense** is the criterion for setting this value."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Content past the limit disappears. **How many lines it takes to make sense** is the criterion for setting this value."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限を超えた内容は消えます。**何行あれば意味が通じるか**が、この値を決める基準です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한을 넘는 내용은 사라집니다. **몇 줄이면 뜻이 통하는가**가 이 값을 정하는 기준입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出限制的内容会消失。**几行才能表达意思**，是决定这个值的标准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超出限制的內容會消失。**幾行才能表達意思**，是決定這個值的標準。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое сверх предела исчезает. **Сколько строк нужно, чтобы смысл был понятен** - критерий для задания этого значения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido más allá del límite desaparece. **Cuántas líneas hacen falta para tener sentido** es el criterio para fijar este valor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalt über dem Limit verschwindet. **Wie viele Zeilen es braucht, damit es Sinn ergibt,** ist das Kriterium für diesen Wert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu au-delà de la limite disparaît. **Le nombre de lignes qu'il faut pour que cela ait du sens** est le critère pour fixer cette valeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto oltre il limite sparisce. **Quante righe servono perché abbia senso** è il criterio per impostare questo valore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo além do limite desaparece. **Quantas linhas são necessárias para fazer sentido** é o critério para definir este valor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาที่เกินขีดจำกัดจะหายไป **ต้องใช้กี่บรรทัดจึงจะมีความหมาย** คือเกณฑ์ในการตั้งค่านี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung vượt giới hạn sẽ biến mất. **Cần bao nhiêu dòng để hiểu được** là tiêu chí để đặt giá trị này."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsah za limitem zmizí. **Kolik řádků je třeba, aby to dávalo smysl**, je kritérium pro nastavení této hodnoty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indhold ud over grænsen forsvinder. **Hvor mange linjer der skal til for at give mening** er kriteriet for at sætte denne værdi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το περιεχόμενο πέρα από το όριο εξαφανίζεται. **Πόσες γραμμές χρειάζονται για να βγάζει νόημα** είναι το κριτήριο για να ορίσεις αυτή την τιμή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rajan ylittävä sisältö katoaa. **Kuinka monta riviä tarvitaan, jotta sillä on järkeä**, on kriteeri tämän arvon asettamiselle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten melewati batas hilang. **Berapa baris yang dibutuhkan agar masuk akal** adalah kriteria untuk menetapkan nilai ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innhold utover grensen forsvinner. **Hvor mange linjer det trengs for å gi mening** er kriteriet for å sette denne verdien."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhoud voorbij de limiet verdwijnt. **Hoeveel regels nodig zijn om het te begrijpen** is het criterium voor het instellen van deze waarde."
          }
        }
      }
    },
    "좌우 버튼과 한 줄을 나눠 씁니다. 제목이 길어지면 어떻게 될지 1.2.4에서 확인해 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It shares one line with the buttons on either side. Check what happens when the title gets long in 1.2.4."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It shares one line with the buttons on either side. Check what happens when the title gets long in 1.2.4."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右のボタンと1行を分け合います。タイトルが長くなったらどうなるか、1.2.4で確かめてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌우 버튼과 한 줄을 나눠 씁니다. 제목이 길어지면 어떻게 될지 1.2.4에서 확인해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与左右按钮共用一行。标题变长会怎样，请到 1.2.4 里确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與左右按鈕共用一行。標題變長會怎樣，請到 1.2.4 裡確認。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делит одну строку с кнопками по обе стороны. Проверьте в 1.2.4, что произойдёт, когда заголовок станет длинным."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte una línea con los botones de ambos lados. Mira qué pasa cuando el título se alarga en 1.2.4."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er teilt sich eine Zeile mit den Buttons auf beiden Seiten. Prüfe in 1.2.4, was passiert, wenn der Titel lang wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il partage une ligne avec les boutons de chaque côté. Voyez ce qui se passe quand le titre s'allonge en 1.2.4."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condivide una riga con i pulsanti ai due lati. Controlla che cosa succede quando il titolo si allunga in 1.2.4."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide uma linha com os botões dos dois lados. Confira o que acontece quando o título fica longo em 1.2.4."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้บรรทัดเดียวร่วมกับปุ่มทั้งสองข้าง ตรวจดูว่าเกิดอะไรขึ้นเมื่อชื่อเรื่องยาวใน 1.2.4"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó dùng chung một dòng với các nút hai bên. Kiểm tra điều gì xảy ra khi tiêu đề dài ở 1.2.4."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílí jeden řádek s tlačítky na obou stranách. Zkontrolujte v 1.2.4, co se stane, když je nadpis dlouhý."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den deler én linje med knapperne på begge sider. Tjek, hvad der sker, når titlen bliver lang, i 1.2.4."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μοιράζεται μία γραμμή με τα κουμπιά και στις δύο πλευρές. Έλεγξε τι συμβαίνει όταν ο τίτλος μακραίνει στο 1.2.4."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se jakaa yhden rivin kummallakin puolella olevien painikkeiden kanssa. Katso kohdasta 1.2.4, mitä tapahtuu otsikon pidentyessä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia berbagi satu baris dengan tombol di kedua sisi. Periksa apa yang terjadi saat judul menjadi panjang di 1.2.4."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den deler én linje med knappene på begge sider. Sjekk hva som skjer når tittelen blir lang i 1.2.4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij deelt één regel met de knoppen aan weerszijden. Kijk wat er gebeurt als de titel lang wordt in 1.2.4."
          }
        }
      }
    },
    "주 사용 방식이면 늘 손에 닿아야 한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it's the main way people use it, it must always be within reach"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If it's the main way people use it, it must always be within reach"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主な使い方なら、いつも手が届くべきだ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 사용 방식이면 늘 손에 닿아야 한다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是主要使用方式，就必须随时触手可及"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果是主要使用方式，就必須隨時觸手可及"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если это основной способ использования, оно должно быть всегда под рукой"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si es la forma principal de usarlo, tiene que estar siempre al alcance"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es die Hauptnutzung ist, muss es immer in Reichweite sein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si c'est la façon principale de l'utiliser, il doit toujours être à portée de main"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se è il modo principale in cui le persone lo usano, deve essere sempre a portata di mano"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se é o principal modo de uso, tem de estar sempre ao alcance"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ้าเป็นวิธีหลักที่คนใช้ ก็ต้องอยู่ในระยะเอื้อมเสมอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu đó là cách chính người ta dùng nó, nó phải luôn trong tầm với"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je to hlavní způsob, jak lidé aplikaci používají, musí být vždy na dosah"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det er den vigtigste måde, folk bruger det på, skal det altid være inden for rækkevidde"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν είναι ο κύριος τρόπος που το χρησιμοποιούν οι άνθρωποι, πρέπει να είναι πάντα εντός εμβέλειας"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos se on pääasiallinen käyttötapa, sen täytyy olla aina ulottuvilla"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ini cara utama orang memakainya, ia harus selalu dalam jangkauan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis det er hovedmåten folk bruker det på, må det alltid være innen rekkevidde"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als het de hoofdmanier is waarop mensen het gebruiken, moet het altijd binnen bereik zijn"
          }
        }
      }
    },
