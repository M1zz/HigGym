        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда читаемость и эстетика конфликтуют, побеждает читаемость"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando legibilidad y estética chocan, gana la legibilidad"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Lesbarkeit und Ästhetik kollidieren, gewinnt die Lesbarkeit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand lisibilité et esthétique s'opposent, la lisibilité l'emporte"
