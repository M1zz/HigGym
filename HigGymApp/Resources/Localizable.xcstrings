    "편의를 준 게 아니라 불일치를 허용한 것이 된다. 사용자는 시트에 적힌 금액을 보고 결제했는데 청구는 다른 금액으로 된다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't convenience; it's allowing a mismatch. The user paid after seeing the amount on the sheet, but gets charged a different amount."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It isn't convenience; it's allowing a mismatch. The user paid after seeing the amount on the sheet, but gets charged a different amount."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "便利にしたのではなく、不一致を許したことになる。ユーザーはシートに書かれた金額を見て支払ったのに、請求は別の金額になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편의를 준 게 아니라 불일치를 허용한 것이 된다. 사용자는 시트에 적힌 금액을 보고 결제했는데 청구는 다른 금액으로 된다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这并非提供了方便，而是放任了不一致：用户看着弹层里的金额付款，而扣款却是另一个金额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這並非提供了方便，而是放任了不一致：使用者看著工作表裡的金額付款，而扣款卻是另一個金額。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не удобство, а допущение расхождения. Пользователь платил, видя сумму в шторке, а списывают другую."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es comodidad; es permitir una discrepancia. El usuario pagó tras ver el importe en la hoja, pero se le cobra otro importe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist keine Bequemlichkeit, sondern lässt eine Abweichung zu. Der Nutzer hat bezahlt, nachdem er den Betrag im Sheet gesehen hat, bekommt aber einen anderen Betrag abgebucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas de la commodité ; c'est permettre une discordance. L'utilisateur a payé après avoir vu le montant sur la feuille, mais on lui débite un autre montant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è comodità; è consentire una discordanza. L'utente ha pagato dopo aver visto l'importo sul foglio, ma gli viene addebitato un importo diverso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é comodidade; é permitir uma divergência. O usuário pagou depois de ver o valor na folha, mas é cobrado um valor diferente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ใช่ความสะดวก แต่คือการยอมให้ไม่ตรงกัน ผู้ใช้จ่ายเงินหลังเห็นจำนวนบนชีต แต่ถูกเรียกเก็บจำนวนอื่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đó không phải sự tiện lợi; đó là cho phép sự lệch pha. Người dùng đã trả tiền sau khi thấy số tiền trên sheet, nhưng bị tính một số tiền khác."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není to pohodlí; je to připuštění nesouladu. Uživatel zaplatil poté, co viděl částku na sheetu, ale bude mu naúčtována jiná."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke bekvemmelighed; det er at tillade en uoverensstemmelse. Brugeren betalte, efter at have set beløbet på arket, men bliver opkrævet et andet beløb."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι ευκολία· είναι επιτρέπεται μια αναντιστοιχία. Ο χρήστης πλήρωσε αφού είδε το ποσό στο φύλλο, αλλά χρεώνεται διαφορετικό ποσό."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyse ei ole mukavuudesta; se sallii epäsuhdan. Käyttäjä maksoi nähtyään arkissa olevan summan, mutta häneltä veloitetaan eri summa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini bukan kenyamanan; ini membiarkan ketidakcocokan. Pengguna membayar setelah melihat jumlah di lembar, tetapi ditagih jumlah yang berbeda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ikke bekvemmelighet; det er å tillate et avvik. Brukeren betalte etter å ha sett beløpet på arket, men blir belastet et annet beløp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is geen gemak; het staat een mismatch toe. De gebruiker betaalde nadat hij het bedrag op de sheet zag, maar krijgt een ander bedrag afgeschreven."
          }
        }
      }
    },
