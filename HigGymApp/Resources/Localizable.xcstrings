    "커스텀 하단 컨트롤 바를 만들 때 safeAreaBar를 쓰는 이유는?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why use safeAreaBar when building a custom bottom control bar?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Why use safeAreaBar when building a custom bottom control bar?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムの下部コントロールバーを作るとき、safeAreaBarを使う理由は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커스텀 하단 컨트롤 바를 만들 때 safeAreaBar를 쓰는 이유는?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
