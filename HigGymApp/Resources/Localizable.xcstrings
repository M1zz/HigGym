    "써 보고, 적고, 이유를 보고, 고친 화면과 비교합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it, write it down, see why, and compare with the fix"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Try it, write it down, see why, and compare with the fix"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使って、書いて、理由を確かめ、直した画面と比べます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亲手试、写下来、看原因，再与改后的界面比较"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "親手試、寫下來、看原因，再與改後的介面比較"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте, запишите, узнайте причину и сравните с исправлением"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruébalo, anótalo, entiende por qué y compara con la solución"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausprobieren, aufschreiben, verstehen warum und mit der Lösung vergleichen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez, écrivez, comprenez pourquoi et comparez avec la correction"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova, scrivi, scopri perché e confronta con la correzione"
          }
        }
      }
    },
    "실수 %lld편과 회고": {
