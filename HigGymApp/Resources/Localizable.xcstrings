    "증상에서 기준까지, 어쩌다 이 실수를 하게 됐는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From symptom to criterion: how this mistake happened"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "From symptom to criterion: how this mistake happened"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "症状から基準まで、なぜこのミスをしてしまったのか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "증상에서 기준까지, 어쩌다 이 실수를 하게 됐는가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从症状到标准：怎么就犯了这个失误"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從症狀到標準：怎麼就犯了這個失誤"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От симптома к критерию: как возникла эта ошибка"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Del síntoma al criterio: cómo ocurrió este error"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Symptom zum Kriterium: wie dieser Fehler entstand"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du symptôme au critère : comment cette erreur est arrivée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal sintomo al criterio: come è nato questo errore"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Do sintoma ao critério: como este erro aconteceu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากอาการสู่เกณฑ์: ข้อผิดพลาดนี้เกิดขึ้นได้อย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ triệu chứng đến tiêu chí: lỗi này đã xảy ra thế nào"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od příznaku ke kritériu: jak k této chybě došlo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra symptom til kriterium: hvordan denne fejl skete"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από το σύμπτωμα στο κριτήριο: πώς συνέβη αυτό το λάθος"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oireesta kriteeriin: miten tämä virhe syntyi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari gejala ke kriteria: bagaimana kesalahan ini terjadi"
          }
        },
