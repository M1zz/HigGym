    "상단에는 제목이 있어서 검색을 넣을 자리가 없었다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title was at the top, so there was no room for search"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The title was at the top, so there was no room for search"
          }
        },
        "ja": {
