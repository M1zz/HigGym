    "되돌릴 수 없는 액션은 빈도와 상관없이 한 단계 멀리 둔다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irreversible actions go one step away, no matter how often they're used."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Irreversible actions go one step away, no matter how often they're used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せないアクションは、頻度に関係なく一段遠くに置く。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없는 액션은 빈도와 상관없이 한 단계 멀리 둔다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法撤销的操作，无论频率高低，都要再远一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法撤銷的操作，無論頻率高低，都要再遠一步。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необратимые действия ставят на шаг дальше независимо от частоты."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones irreversibles van a un paso de distancia, por muy a menudo que se usen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht umkehrbare Aktionen liegen einen Schritt entfernt, egal wie oft sie genutzt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions irréversibles vont un cran plus loin, quelle que soit leur fréquence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni irreversibili vanno a un passo di distanza, a prescindere da quanto vengono usate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações irreversíveis ficam a um passo de distância, não importa com que frequência sejam usadas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำที่ย้อนกลับไม่ได้อยู่ห่างหนึ่งขั้น ไม่ว่าจะใช้บ่อยแค่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động không thể hoàn tác để cách một bước, dù được dùng thường xuyên đến đâu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevratné akce jdou o krok dál, bez ohledu na to, jak často se používají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uigenkaldelige handlinger flyttes ét skridt væk, uanset hvor ofte de bruges."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι μη αναστρέψιμες ενέργειες πηγαίνουν ένα βήμα μακριά, ανεξάρτητα από το πόσο συχνά χρησιμοποιούνται."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruuttamattomat toiminnot sijoitetaan askeleen päähän riippumatta siitä, kuinka usein niitä käytetään."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksi yang tidak bisa dibatalkan ditaruh berjarak satu langkah, seberapa sering pun dipakai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlinger som ikke kan angres holdes ett steg unna, uansett hvor ofte de brukes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onomkeerbare acties gaan één stap weg, hoe vaak ze ook worden gebruikt."
          }
        }
      }
    },
    "되돌릴 수 없는 액션은 한 단계 멀리, 그리고 대상 위에, 어느 쪽입니까?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irreversible actions go one step away, and on their target. Which one does that?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Irreversible actions go one step away, and on their target. Which one does that?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せないアクションは一段遠くに、しかも対象の上に。どちらがそうなっていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없는 액션은 한 단계 멀리, 그리고 대상 위에, 어느 쪽입니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法撤销的操作要再远一步，并放在对象上：在哪一边？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法撤銷的操作要再遠一步，並放在物件上：在哪一邊？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необратимое действие ставят на шаг дальше и прямо на объект. Какой вариант так делает?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones irreversibles van a un paso de distancia, y sobre su objetivo. ¿Cuál lo hace?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht umkehrbare Aktionen liegen einen Schritt entfernt und am Ziel. Welche tut das?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions irréversibles vont un cran plus loin, et sur leur cible. Laquelle le fait ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni irreversibili vanno a un passo di distanza, e sul loro bersaglio. Quale lo fa?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações irreversíveis ficam a um passo de distância, e no próprio alvo. Qual delas faz isso?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกระทำที่ย้อนกลับไม่ได้อยู่ห่างหนึ่งขั้นและอยู่บนเป้าหมายของมัน อันไหนเป็นเช่นนั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động không thể hoàn tác để cách một bước, và nằm trên đối tượng của nó. Cái nào làm vậy?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevratné akce jdou o krok dál a na svůj cíl. Která to splňuje?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uigenkaldelige handlinger flyttes ét skridt væk og på deres mål. Hvilken gør det?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι μη αναστρέψιμες ενέργειες πηγαίνουν ένα βήμα μακριά, και πάνω στον στόχο τους. Ποιο το κάνει αυτό;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruuttamattomat toiminnot sijoitetaan askeleen päähän ja kohteeseensa. Kumpi tekee niin?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksi yang tidak bisa dibatalkan ditaruh berjarak satu langkah, dan pada targetnya. Mana yang melakukannya?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlinger som ikke kan angres holdes ett steg unna, og på målet. Hvilken gjør det?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onomkeerbare acties gaan één stap weg, en op hun doel. Welke doet dat?"
          }
        }
      }
    },
    "되돌릴 수 없는 액션이라, 대상 위에 두고 한 단계 거치게 했다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's irreversible, so it sits on its target and takes one extra step"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "It's irreversible, so it sits on its target and takes one extra step"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せないアクションなので、対象の上に置き、一段階を挟むようにした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없는 액션이라, 대상 위에 두고 한 단계 거치게 했다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为是无法撤销的操作，所以放在对象上，并多加一步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因為是無法撤銷的操作，所以放在物件上，並多加一步"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно необратимо, поэтому стоит на объекте и требует одного лишнего шага"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es irreversible, así que está sobre su objetivo y exige un paso extra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht umkehrbar, daher sitzt es am Ziel und kostet einen zusätzlichen Schritt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est irréversible, donc c'est placé sur sa cible et demande un geste de plus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È irreversibile, quindi sta sul suo bersaglio e richiede un passo in più"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É irreversível, então fica no próprio alvo e exige um passo a mais"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้อนกลับไม่ได้ จึงอยู่บนเป้าหมายและต้องเพิ่มอีกหนึ่งขั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó không thể hoàn tác, nên nằm trên đối tượng của nó và thêm một bước"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nevratná, proto leží na svém cíli a vyžaduje krok navíc"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er uigenkaldelig, så den sidder på sit mål og kræver et ekstra skridt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι μη αναστρέψιμη, οπότε βρίσκεται πάνω στον στόχο της και απαιτεί ένα επιπλέον βήμα"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on peruuttamaton, joten se on kohteessaan ja vaatii yhden ylimääräisen askeleen"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia tidak bisa dibatalkan, jadi ia berada pada targetnya dan butuh satu langkah ekstra"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan ikke angres, så den ligger på målet og tar ett ekstra steg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is onomkeerbaar, dus het zit op zijn doel en kost één extra stap"
          }
        }
      }
    },
    "되돌릴 수 없는 일은 어떻게 시키는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you ask for something irreversible?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you ask for something irreversible?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消せない操作をどう実行させるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 수 없는 일은 어떻게 시키는가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "怎样让人执行无法撤销的事"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "怎樣讓人執行無法撤銷的事"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как предлагать то, что нельзя отменить?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo se pide algo irreversible?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie bittest du um etwas Unumkehrbares?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment demande-t-on quelque chose d'irréversible ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come si chiede qualcosa di irreversibile?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como se pede algo irreversível?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณขอสิ่งที่ย้อนกลับไม่ได้อย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn yêu cầu điều không thể hoàn tác như thế nào?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak se žádá o něco nevratného?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan beder man om noget uigenkaldeligt?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πώς ζητάς κάτι μη αναστρέψιμο;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miten pyydät jotain peruuttamatonta?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana kamu meminta sesuatu yang tidak bisa dibatalkan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvordan ber du om noe som ikke kan angres?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe vraag je om iets onomkeerbaars?"
          }
        }
      }
    },
    "두 버튼은 한 캡슐에 묶여 있습니다. \"같은 세트\"라는 신호입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two buttons share one capsule. That signals \"they belong together.\""
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The two buttons share one capsule. That signals \"they belong together.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのボタンは1つのカプセルにまとめられています。「同じセット」だという合図です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 버튼은 한 캡슐에 묶여 있습니다. \"같은 세트\"라는 신호입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个按钮被放进了同一个胶囊，这是“同一组”的信号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個按鈕被放進了同一個膠囊，這是「同一組」的訊號。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обе кнопки лежат в одной капсуле. Это сигнал «они относятся друг к другу»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dos botones comparten una cápsula. Eso indica que «van juntos»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden Buttons teilen sich eine Kapsel. Das signalisiert: „Sie gehören zusammen.“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux boutons partagent une capsule. Cela signale qu'« ils vont ensemble »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I due pulsanti condividono una capsula. Questo segnala che «stanno insieme»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois botões dividem uma cápsula. Isso sinaliza que «eles andam juntos»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สองปุ่มใช้แคปซูลเดียวกัน นั่นส่งสัญญาณว่า \"สองอย่างนี้อยู่ด้วยกัน\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai nút dùng chung một capsule. Điều đó báo hiệu \"chúng thuộc về nhau\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obě tlačítka sdílejí jednu kapsli. To signalizuje „patří k sobě“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De to knapper deler én kapsel. Det signalerer »de hører sammen.«"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δύο κουμπιά μοιράζονται μία κάψουλα. Αυτό σηματοδοτεί ότι «ανήκουν μαζί»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi painiketta jakaa yhden kapselin. Se viestii, että ”ne kuuluvat yhteen”."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua tombol berbagi satu kapsul. Itu menandakan \"mereka satu kesatuan.\""
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De to knappene deler én kapsel. Det signaliserer «de hører sammen»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De twee knoppen delen één capsule. Dat signaleert \"ze horen bij elkaar\"."
          }
        }
      }
    },
    "두 장치를 겹치면 서로를 가립니다. **잘려도 뜻이 통하는가**로 도구를 고릅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stack the two techniques and they cancel each other out. Pick the tool by asking **does it still make sense when cut off?**"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Stack the two techniques and they cancel each other out. Pick the tool by asking **does it still make sense when cut off?**"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの手法を重ねると、互いを打ち消します。**切り詰められても意味が通じるか**で手法を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 장치를 겹치면 서로를 가립니다. **잘려도 뜻이 통하는가**로 도구를 고릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种机制叠在一起会互相遮蔽。按**被截断后意思还通不通**来选工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種機制疊在一起會互相遮蔽。按**被截斷後意思還通不通**來選工具。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если наложить две техники, они сводят друг друга на нет. Выбирайте инструмент, спрашивая: **остаётся ли смысл при обрезке?**"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apilas las dos técnicas, se anulan entre sí. Elige la herramienta preguntándote **¿sigue teniendo sentido al cortarlo?**"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapelt man beide Techniken, heben sie sich gegenseitig auf. Wähle das Werkzeug mit der Frage: **Ergibt es auch abgeschnitten noch Sinn?**"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empilez les deux techniques et elles s'annulent. Choisissez l'outil en demandant **est-ce que cela garde un sens une fois coupé ?**"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovrapponi le due tecniche e si annullano a vicenda. Scegli lo strumento chiedendoti **ha ancora senso una volta tagliato?**"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empilhe as duas técnicas e uma anula a outra. Escolha a ferramenta perguntando **ainda faz sentido quando cortado?**"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซ้อนสองเทคนิคแล้วมันหักล้างกัน เลือกเครื่องมือโดยถามว่า**ถูกตัดแล้วยังมีความหมายไหม**"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chồng hai kỹ thuật lên nhau thì chúng triệt tiêu nhau. Chọn công cụ bằng cách hỏi **bị cắt đi rồi có còn hiểu được không?**"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naskládejte obě techniky na sebe a navzájem se vyruší. Nástroj vybírejte otázkou **dává to smysl i po oříznutí?**"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabler du de to teknikker, ophæver de hinanden. Vælg værktøjet ved at spørge **giver det stadig mening, når det skæres af?**"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στοίβαξε τις δύο τεχνικές και αναιρούν η μία την άλλη. Διάλεξε το εργαλείο ρωτώντας **βγάζει ακόμα νόημα όταν κοπεί;**"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinoa nämä kaksi tekniikkaa, niin ne kumoavat toisensa. Valitse työkalu kysymällä **onko sillä vielä järkeä, kun se leikataan?**"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumpuk kedua teknik dan keduanya saling meniadakan. Pilih alat dengan bertanya **apakah masih masuk akal saat dipotong?**"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable de to teknikkene, og de opphever hverandre. Velg verktøyet ved å spørre **gir det fortsatt mening når det kuttes?**"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stapel de twee technieken en ze heffen elkaar op. Kies het gereedschap door te vragen **is het nog logisch als het wordt afgekapt?**"
          }
        }
      }
    },
    "두 카드 비교 강조": {
      "localizations": {
