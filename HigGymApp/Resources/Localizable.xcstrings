    "삭제, 가장 누르기 쉬운 자리에 두면 위험합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete: dangerous in the easiest spot to tap"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete: dangerous in the easiest spot to tap"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除。いちばん押しやすい場所に置くと危険です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제, 가장 누르기 쉬운 자리에 두면 위험합니다"
          }
        },
        "zh-Hans": {
