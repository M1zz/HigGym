    "무엇이 접혀도 되는가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What can be folded away?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What can be folded away?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何をしまってもいいのか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇이 접혀도 되는가"
          }
        },
        "zh-Hans": {
