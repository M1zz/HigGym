    "레슨, 항목, 실수 100편, 퀴즈까지 앱 전체가 기기 언어를 따라갑니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lessons, topics, 100 mistakes, even the quizzes: the whole app follows your device language."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lessons, topics, 100 mistakes, even the quizzes: the whole app follows your device language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レッスン、トピック、ミス100本、クイズまで、アプリ全体がデバイスの言語に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레슨, 항목, 실수 100편, 퀴즈까지 앱 전체가 기기 언어를 따라갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "课程、条目、100 篇失误、测验，整个应用都跟随设备语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "課程、條目、100 篇失誤、測驗，整個應用程式都跟隨裝置語言。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уроки, темы, 100 ошибок и даже викторины: всё приложение следует языку устройства."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecciones, temas, 100 errores, incluso los cuestionarios: toda la app sigue el idioma de tu dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lektionen, Themen, 100 Fehler, sogar die Quizze: Die ganze App folgt der Sprache deines Geräts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leçons, sujets, 100 erreurs, même les quiz : toute l'app suit la langue de votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lezioni, argomenti, 100 errori, perfino i quiz: tutta l'app segue la lingua del tuo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lições, tópicos, 100 erros, até os quizzes: o app inteiro segue o idioma do seu dispositivo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บทเรียน หัวข้อ ข้อผิดพลาด 100 ข้อ ไปจนถึงแบบทดสอบ: ทั้งแอปทำตามภาษาของอุปกรณ์คุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài học, chủ đề, 100 lỗi, cả bài kiểm tra: toàn bộ app theo ngôn ngữ thiết bị của bạn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lekce, témata, 100 chyb, dokonce i kvízy: celá aplikace se řídí jazykem vašeho zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lektioner, emner, 100 fejl, selv quizzerne: hele appen følger din enheds sprog."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μαθήματα, θέματα, 100 λάθη, ακόμα και τα κουίζ: ολόκληρη η εφαρμογή ακολουθεί τη γλώσσα της συσκευής σου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppitunnit, aiheet, 100 virhettä, jopa tietovisat: koko sovellus seuraa laitteesi kieltä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelajaran, topik, 100 kesalahan, bahkan kuis: seluruh aplikasi mengikuti bahasa perangkatmu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leksjoner, emner, 100 feil, til og med quizene: hele appen følger enhetens språk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lessen, onderwerpen, 100 fouten, zelfs de quizzen: de hele app volgt de taal van je apparaat."
          }
        }
      }
    },
    "레슨에서 직접 쓴 글을 모아 둔 노트를 엽니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the notes that collect everything you wrote in lessons."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the notes that collect everything you wrote in lessons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レッスンで自分が書いた文章を集めたノートを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레슨에서 직접 쓴 글을 모아 둔 노트를 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开收集了你在课程中亲手写下的文字的笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟收集了你在課程中親手寫下的文字的筆記。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает заметки, в которых собрано всё, что вы написали на уроках."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre las notas donde se recoge todo lo que escribiste en las lecciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Notizen, in denen alles gesammelt ist, was du in den Lektionen geschrieben hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les notes qui rassemblent tout ce que vous avez écrit pendant les leçons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre le note che raccolgono tutto ciò che hai scritto nelle lezioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre as notas que reúnem tudo o que você escreveu nas lições."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดโน้ตที่รวมทุกสิ่งที่คุณเขียนในบทเรียน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở các ghi chú gom mọi thứ bạn đã viết trong bài học."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře poznámky, které sbírají všechno, co jste napsali v lekcích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner de noter, der samler alt, hvad du skrev i lektioner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει τις σημειώσεις που συγκεντρώνουν ό,τι έγραψες στα μαθήματα."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa muistiinpanot, joihin kerääntyy kaikki, mitä kirjoitit oppitunneilla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka catatan yang menghimpun semua yang kamu tulis di pelajaran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner notatene som samler alt du skrev i leksjonene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de notities die alles verzamelen wat je in lessen schreef."
          }
        }
      }
    },
    "레슨을 마쳤습니다. 쓴 글은 노트 탭에 모였습니다.": {
