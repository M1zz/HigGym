    "작성은 하단 툴바 버튼. 탭은 목적지만.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose is a bottom toolbar button. Tabs are only for destinations."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose is a bottom toolbar button. Tabs are only for destinations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成は下部ツールバーのボタン。タブは行き先だけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성은 하단 툴바 버튼. 탭은 목적지만."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写是底部工具栏按钮，标签只放目的地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫是底部工具列按鈕，標籤只放目的地。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Написать» - кнопка нижней панели инструментов. Вкладки - только для мест назначения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactar es un botón de la barra de herramientas inferior. Las pestañas son solo para destinos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfassen ist ein Button der unteren Symbolleiste. Tabs sind nur für Ziele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédiger est un bouton de la barre d'outils du bas. Les onglets sont réservés aux destinations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi è un pulsante della barra degli strumenti in basso. Le schede servono solo per le destinazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrever é um botão da barra de ferramentas inferior. Abas são só para destinos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนเป็นปุ่มแถบเครื่องมือด้านล่าง แท็บมีไว้สำหรับจุดหมายปลายทางเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soạn là một nút trên thanh công cụ dưới. Tab chỉ dành cho các điểm đến."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsat je tlačítko spodního panelu nástrojů. Karty jsou jen pro cíle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv er en knap i den nederste værktøjslinje. Faner er kun til destinationer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Σύνταξη είναι κουμπί της κάτω γραμμής εργαλείων. Οι καρτέλες είναι μόνο για προορισμούς."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita on alatyökalupalkin painike. Välilehdet ovat vain määränpäitä varten."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis adalah tombol bilah alat bawah. Tab hanya untuk tujuan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv er en bunnverktøylinjeknapp. Faner er bare for destinasjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf is een knop in de onderste werkbalk. Tabbladen zijn er alleen voor bestemmingen."
          }
        }
      }
    },
    "작성을 탭이 아니라 하단 툴바 버튼으로 두고, 탭에는 목적지만 남겼다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made Compose a bottom toolbar button instead of a tab, and left only destinations in the tabs."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Made Compose a bottom toolbar button instead of a tab, and left only destinations in the tabs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成をタブではなく下部ツールバーのボタンにし、タブには行き先だけを残した。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성을 탭이 아니라 하단 툴바 버튼으로 두고, 탭에는 목적지만 남겼다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把撰写做成底部工具栏按钮，而不是标签，标签里只留目的地。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把撰寫做成底部工具列按鈕，而不是標籤，標籤裡只留目的地。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Написать» сделали кнопкой нижней панели инструментов вместо вкладки, а во вкладках оставили только места назначения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hizo de Redactar un botón de la barra de herramientas inferior en lugar de una pestaña, y en las pestañas solo se dejaron destinos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfassen zu einem Button der unteren Symbolleiste statt zu einem Tab gemacht und in den Tabs nur Ziele gelassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédiger est devenu un bouton de la barre d'outils du bas au lieu d'un onglet, et il ne reste que des destinations dans les onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha reso Scrivi un pulsante della barra degli strumenti in basso invece di una scheda, lasciando nelle schede solo le destinazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fez de Escrever um botão da barra de ferramentas inferior em vez de uma aba, e deixou só destinos nas abas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำให้เขียนเป็นปุ่มแถบเครื่องมือด้านล่างแทนแท็บ และเหลือเฉพาะจุดหมายปลายทางไว้ในแท็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã biến Soạn thành nút trên thanh công cụ dưới thay vì một tab, và chỉ để lại các điểm đến trong tab."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z Napsat udělalo tlačítko spodního panelu nástrojů místo karty a v kartách nechalo jen cíle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjorde Skriv til en knap i den nederste værktøjslinje i stedet for en fane og lod kun destinationer blive tilbage i fanerne."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έκανε τη Σύνταξη κουμπί της κάτω γραμμής εργαλείων αντί για καρτέλα και άφησε στις καρτέλες μόνο προορισμούς."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Teki Kirjoita-toiminnosta alatyökalupalkin painikkeen välilehden sijaan ja jätti välilehtiin vain määränpäät."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menjadikan Tulis tombol bilah alat bawah alih-alih tab, dan hanya menyisakan tujuan di tab."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjorde Skriv til en bunnverktøylinjeknapp i stedet for en fane, og lot bare destinasjoner stå igjen i fanene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van Schrijf een knop in de onderste werkbalk gemaakt in plaats van een tabblad, en alleen bestemmingen in de tabbladen gelaten."
          }
        }
      }
    },
    "작성이 하단 툴바 버튼 ↔ 가짜 탭. 탭 개수도 함께 달라집니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose as a bottom toolbar button ↔ a fake tab. The number of tabs changes too."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose as a bottom toolbar button ↔ a fake tab. The number of tabs changes too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成が下部ツールバーのボタン ↔ 偽のタブ。タブの数も一緒に変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성이 하단 툴바 버튼 ↔ 가짜 탭. 탭 개수도 함께 달라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写是底部工具栏按钮 ↔ 假标签。标签的数量也随之不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫是底部工具列按鈕 ↔ 假標籤。標籤的數量也隨之不同。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Написать» как кнопка нижней панели ↔ фальшивая вкладка. Число вкладок тоже меняется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactar como botón de la barra de herramientas inferior ↔ una pestaña falsa. El número de pestañas también cambia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfassen als Button der unteren Symbolleiste ↔ ein Schein-Tab. Auch die Zahl der Tabs ändert sich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédiger en bouton de la barre d'outils du bas ↔ un faux onglet. Le nombre d'onglets change aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi come pulsante della barra degli strumenti in basso ↔ una scheda finta. Cambia anche il numero di schede."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrever como botão da barra de ferramentas inferior ↔ uma aba falsa. O número de abas também muda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนเป็นปุ่มแถบเครื่องมือด้านล่าง ↔ แท็บปลอม จำนวนแท็บก็เปลี่ยนด้วย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soạn như một nút thanh công cụ dưới ↔ một tab giả. Số tab cũng thay đổi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsat jako tlačítko spodního panelu nástrojů ↔ falešná karta. Mění se i počet karet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv som knap i den nederste værktøjslinje ↔ en falsk fane. Antallet af faner ændres også."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύνταξη ως κουμπί κάτω γραμμής εργαλείων ↔ ψεύτικη καρτέλα. Αλλάζει και ο αριθμός των καρτελών."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita alatyökalupalkin painikkeena ↔ väärä välilehti. Välilehtien määräkin muuttuu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis sebagai tombol bilah alat bawah ↔ tab palsu. Jumlah tab juga berubah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv som en bunnverktøylinjeknapp ↔ en falsk fane. Antall faner endres også."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf als knop in de onderste werkbalk ↔ een nep-tabblad. Het aantal tabbladen verandert ook."
          }
        }
      }
    },
    "작성이 하단으로 내려왔습니다. 같은 과제를 다시 해보고 엄지의 이동 거리를 비교하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose moved to the bottom. Do the same task again and compare how far your thumb travels."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Compose moved to the bottom. Do the same task again and compare how far your thumb travels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成が下に降りてきました。同じ課題をもう一度やって、親指の移動距離を比べてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성이 하단으로 내려왔습니다. 같은 과제를 다시 해보고 엄지의 이동 거리를 비교하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撰写移到了底部。请重做同一个任务，比较拇指的移动距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撰寫移到了底部。請重做同一個任務，比較拇指的移動距離。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Написать» переехало вниз. Выполните то же задание ещё раз и сравните, как далеко движется большой палец."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactar pasó abajo. Repite la misma tarea y compara cuánto recorre tu pulgar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfassen nach unten verlegt. Führe dieselbe Aufgabe noch einmal aus und vergleiche, wie weit dein Daumen wandert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédiger est passé en bas. Refaites la même tâche et comparez la distance parcourue par votre pouce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi spostato in basso. Rifai lo stesso compito e confronta quanta strada fa il tuo pollice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escrever foi para baixo. Refaça a mesma tarefa e compare quanto seu polegar percorre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียนย้ายลงด้านล่าง ทำงานเดิมอีกครั้งและเปรียบเทียบว่านิ้วโป้งเคลื่อนไปไกลแค่ไหน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Soạn đã chuyển xuống dưới. Làm lại cùng tác vụ và so sánh ngón cái bạn di chuyển bao xa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsat přesunuto dolů. Udělejte stejný úkol znovu a porovnejte, jak daleko putuje váš palec."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv er flyttet til bunden. Gør den samme opgave igen, og sammenlign, hvor langt din tommelfinger bevæger sig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Σύνταξη μετακινήθηκε κάτω. Κάν' το ίδιο έργο ξανά και σύγκρινε πόσο ταξιδεύει ο αντίχειράς σου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita siirtyi alas. Tee sama tehtävä uudelleen ja vertaa, kuinka pitkän matkan peukalosi kulkee."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis pindah ke bawah. Lakukan tugas yang sama lagi dan bandingkan seberapa jauh ibu jarimu bergerak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv flyttet til bunnen. Gjør den samme oppgaven igjen og sammenlign hvor langt tommelen din beveger seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf is naar beneden verplaatst. Doe dezelfde taak opnieuw en vergelijk hoe ver je duim reist."
          }
        }
      }
    },
