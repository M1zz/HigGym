    "최악의 배경에서 컨트롤이 읽히는지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether controls are readable on the worst background"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether controls are readable on the worst background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最悪の背景でもコントロールが読めるか"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최악의 배경에서 컨트롤이 읽히는지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最糟糕的背景上，控件还读得清吗"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在最糟糕的背景上，控制元件還讀得清嗎"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читаются ли элементы управления на худшем фоне"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los controles se pueden leer sobre el peor fondo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob Steuerelemente auf dem schlechtesten Hintergrund lesbar sind"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les contrôles sont lisibles sur le pire arrière-plan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se i controlli sono leggibili sullo sfondo peggiore"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os controles ficam legíveis sobre o pior fundo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวควบคุมอ่านออกบนพื้นหลังที่แย่ที่สุดหรือไม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các điều khiển có đọc được trên nền tệ nhất không"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zda jsou ovladače čitelné na nejhorším pozadí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Om kontroller kan læses på den værste baggrund"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν οι έλεγχοι διαβάζονται στο χειρότερο φόντο"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovatko säätimet luettavissa pahimmalla taustalla"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah kontrol terbaca pada latar terburuk"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Om kontrollene er lesbare på den verste bakgrunnen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of bedieningselementen leesbaar zijn op de slechtste achtergrond"
          }
        }
      }
    },
