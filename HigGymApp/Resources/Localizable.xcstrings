    "쓴 글은 노트에 쌓입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you write collects in Notes"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What you write collects in Notes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書いたものはノートにたまります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓴 글은 노트에 쌓입니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你写的文字会累积在笔记里"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你寫的文字會累積在筆記裡"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
