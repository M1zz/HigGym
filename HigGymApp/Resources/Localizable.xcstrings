    "격자 크기가 실제로 바뀝니다. 조작 대상(사진)을 보면서 조작합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grid size actually changes. You adjust it while looking at what you're adjusting (the photos)."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The grid size actually changes. You adjust it while looking at what you're adjusting (the photos)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリッドのサイズが実際に変わります。操作対象（写真）を見ながら操作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "격자 크기가 실제로 바뀝니다. 조작 대상(사진)을 보면서 조작합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格大小真的会变化。你是一边看着操作对象（照片）一边操作的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網格大小真的會變化。你是一邊看著操作物件（照片）一邊操作的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер сетки действительно меняется. Вы настраиваете, глядя на то, что настраиваете (фотографии)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño de la cuadrícula cambia de verdad. Lo ajustas mientras miras lo que ajustas (las fotos)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rastergröße ändert sich tatsächlich. Du stellst sie ein, während du ansiehst, was du einstellst (die Fotos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille de la grille change réellement. Vous l'ajustez en regardant ce que vous ajustez (les photos)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dimensione della griglia cambia davvero. La regoli mentre guardi ciò che stai regolando (le foto)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho da grade realmente muda. Você ajusta olhando para o que está ajustando (as fotos)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดกริดเปลี่ยนจริง คุณปรับพลางดูสิ่งที่กำลังปรับ (รูปถ่าย)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích thước lưới thật sự thay đổi. Bạn điều chỉnh trong khi nhìn thứ đang điều chỉnh (các bức ảnh)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velikost mřížky se skutečně mění. Upravujete ji, zatímco se díváte na to, co upravujete (fotky)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gitterstørrelsen ændrer sig faktisk. Du justerer den, mens du ser på det, du justerer (fotos)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μέγεθος του πλέγματος αλλάζει πραγματικά. Το ρυθμίζεις ενώ κοιτάς αυτό που ρυθμίζεις (τις φωτογραφίες)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruudukon koko todella muuttuu. Säädät sitä katsoessasi sitä, mitä säädät (valokuvia)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran kisi benar-benar berubah. Kamu menyesuaikannya sambil melihat apa yang kamu sesuaikan (foto)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutenettstørrelsen endres faktisk. Du justerer den mens du ser på det du justerer (bildene)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De rastergrootte verandert echt. Je past hem aan terwijl je kijkt naar wat je aanpast (de foto's)."
          }
        }
      }
    },
    "겪어본 것으로 표시한 실수": {
      "localizations": {
