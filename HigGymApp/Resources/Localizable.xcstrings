          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piti työkalupalkissa vain toiminnon, jota tämä näkymä todella käyttää (Valmis), ja siirsi loput kohteen kontekstivalikkoon."
