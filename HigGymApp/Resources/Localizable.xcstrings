    "실제 미확인 수 ↔ 고정된 1. 읽어도 줄지 않는 쪽이 어긴 화면입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actual unread count ↔ a fixed 1. The one that doesn't go down after you read is the broken version."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Actual unread count ↔ a fixed 1. The one that doesn't go down after you read is the broken version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の未読数 ↔ 固定された1。読んでも減らないほうが、ルールを破った画面です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 미확인 수 ↔ 고정된 1. 읽어도 줄지 않는 쪽이 어긴 화면입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际未读数 ↔ 固定的 1。读了也不减少的一边是违反规则的界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實際未讀數 ↔ 固定的 1。讀了也不減少的一邊是違反規則的介面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реальное число непрочитанного ↔ фиксированная 1. Нарушает тот вариант, где число не уменьшается после прочтения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuento real de no leídos ↔ un 1 fijo. El que no baja después de leer es la versión rota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tatsächliche Zahl der Ungelesenen ↔ eine feste 1. Die, die nach dem Lesen nicht sinkt, ist die fehlerhafte Version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre réel de non lus ↔ un 1 fixe. Celui qui ne diminue pas après lecture est la version fautive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteggio reale dei non letti ↔ un 1 fisso. Quello che non scende dopo la lettura è la versione sbagliata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagem real de não lidos ↔ um 1 fixo. O que não diminui depois que você lê é a versão quebrada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนที่ยังไม่อ่านจริง ↔ 1 ตายตัว อันที่ไม่ลดลงหลังอ่านคือเวอร์ชันที่พัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số chưa đọc thực tế ↔ số 1 cố định. Cái không giảm sau khi bạn đọc là phiên bản hỏng."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skutečný počet nepřečtených ↔ pevná 1. Ta, která po přečtení neklesá, je rozbitá verze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Faktisk antal ulæste ↔ en fast 1. Den, der ikke falder efter læsning, er den ødelagte version."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πραγματικό πλήθος μη αναγνωσμένων ↔ σταθερό 1. Αυτό που δεν μειώνεται αφού διαβάσεις είναι η κατεστραμμένη έκδοση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Todellinen lukemattomien määrä ↔ kiinteä 1. Se, joka ei laske lukemisen jälkeen, on rikkinäinen versio."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah belum dibaca sebenarnya ↔ 1 tetap. Yang tidak turun setelah dibaca adalah versi yang rusak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Faktisk antall uleste ↔ et fast 1. Det som ikke går ned etter at du har lest er den ødelagte versjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkelijk aantal ongelezen ↔ een vaste 1. Degene die niet omlaag gaat nadat je hebt gelezen is de kapotte versie."
          }
        }
      }
    },
