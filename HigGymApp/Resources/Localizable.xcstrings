    "완성된 노트 앱을 직접 써보고, 결정 8개의 이유를 짚어봅니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the finished notes app yourself and walk through the reasons behind 8 decisions"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the finished notes app yourself and walk through the reasons behind 8 decisions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完成したメモアプリを実際に使い、8つの決定の理由をたどります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완성된 노트 앱을 직접 써보고, 결정 8개의 이유를 짚어봅니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亲自使用做好的笔记应用，逐一梳理 8 个决定的理由"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "親自使用做好的筆記應用程式，逐一梳理 8 個決定的理由"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попользуйтесь готовым приложением для заметок сами и разберите причины 8 решений"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tú mismo la app de notas terminada y recorre las razones de 8 decisiones"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze die fertige Notizen-App selbst und gehe die Gründe hinter 8 Entscheidungen durch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez vous-même l'app de notes terminée et parcourez les raisons de 8 décisions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu stesso l'app di note finita e ripercorri le ragioni di 8 decisioni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use você mesmo o app de notas pronto e percorra as razões por trás de 8 decisões"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้แอปโน้ตที่สร้างเสร็จด้วยตัวเอง และไล่ดูเหตุผลเบื้องหลังการตัดสินใจ 8 ข้อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự dùng app ghi chú đã hoàn chỉnh và đi qua lý do của 8 quyết định"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte hotovou aplikaci poznámek sami a projděte důvody 8 rozhodnutí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug den færdige notes-app selv, og gennemgå begrundelserne bag 8 beslutninger"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε μόνος σου την ολοκληρωμένη εφαρμογή σημειώσεων και πέρασε από τους λόγους πίσω από 8 αποφάσεις"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä valmista muistiinpanosovellusta itse ja käy läpi 8 päätöksen perusteet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai sendiri aplikasi catatan yang sudah jadi dan telusuri alasan di balik 8 keputusan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk den ferdige notatappen selv og gå gjennom grunnene bak 8 beslutninger"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik zelf de afgewerkte notitie-app en loop de redenen achter 8 beslissingen door"
          }
        }
      }
