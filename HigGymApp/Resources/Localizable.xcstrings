    "Large 타이틀 + 상시 검색 드로어는 진입 시점의 세로 점유가 큽니다. 스크롤하면 제목은 접히지만 검색바는 남습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A large title plus an always-visible search drawer takes up a lot of vertical space on entry. Scroll and the title collapses, but the search bar stays."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A large title plus an always-visible search drawer takes up a lot of vertical space on entry. Scroll and the title collapses, but the search bar stays."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Large タイトルと常時表示の検索ドロワーは、表示直後に縦方向を大きく占有します。スクロールするとタイトルは折りたたまれますが、検索バーは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 타이틀 + 상시 검색 드로어는 진입 시점의 세로 점유가 큽니다. 스크롤하면 제목은 접히지만 검색바는 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 标题加常驻搜索抽屉，进入时占用的纵向空间很大。滚动后标题会折叠，但搜索栏还在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 標題加常駐搜尋抽屜，進入時佔用的縱向空間很大。滾動後標題會摺疊，但搜尋列還在。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Large-заголовок + постоянная панель поиска занимают много вертикального места при входе. При прокрутке заголовок сворачивается, а строка поиска остаётся."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un título grande más un cajón de búsqueda siempre visible ocupan mucho espacio vertical al entrar. Al desplazar, el título se contrae, pero la barra de búsqueda se queda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein großer Titel plus eine immer sichtbare Suchschublade belegen beim Einstieg viel vertikalen Platz. Beim Scrollen klappt der Titel zusammen, aber die Suchleiste bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un grand titre plus un tiroir de recherche toujours visible occupent beaucoup d'espace vertical à l'arrivée. Faites défiler et le titre se replie, mais la barre de recherche reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un titolo grande più un cassetto di ricerca sempre visibile occupano molto spazio verticale all'ingresso. Scorri e il titolo si comprime, ma la barra di ricerca resta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um título grande mais uma gaveta de busca sempre visível ocupa muito espaço vertical na entrada. Role e o título recolhe, mas a barra de busca fica."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องขนาดใหญ่ร่วมกับลิ้นชักค้นหาที่แสดงตลอดจะกินพื้นที่แนวตั้งมากตอนเข้ามา เลื่อนแล้วชื่อเรื่องจะยุบ แต่แถบค้นหายังอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiêu đề lớn cộng với ngăn tìm kiếm luôn hiển thị chiếm nhiều không gian dọc khi vào màn hình. Cuộn thì tiêu đề thu gọn, nhưng thanh tìm kiếm vẫn còn."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Velký nadpis plus vždy viditelná zásuvka hledání zabere při vstupu hodně svislého místa. Posuňte a nadpis se sbalí, ale vyhledávací pole zůstane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En stor titel plus en altid synlig søgeskuffe fylder meget lodret plads ved indgangen. Scroll, og titlen klapper sammen, men søgefeltet bliver."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένας μεγάλος τίτλος μαζί με ένα πάντα ορατό συρτάρι αναζήτησης καταλαμβάνει πολύ κάθετο χώρο κατά την είσοδο. Κύλισε και ο τίτλος συμπτύσσεται, αλλά η γραμμή αναζήτησης μένει."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuri otsikko ja aina näkyvä hakulaatikko vievät paljon pystytilaa sisääntulossa. Vieritä, niin otsikko tiivistyy, mutta hakupalkki pysyy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul besar ditambah laci pencarian yang selalu terlihat memakan banyak ruang vertikal saat masuk. Gulir dan judul menciut, tetapi bilah pencarian tetap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En stor tittel pluss en alltid synlig søkeskuff tar mye vertikal plass ved åpning. Rull, og tittelen kollapser, men søkefeltet blir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een grote titel plus een altijd zichtbare zoeklade neemt bij binnenkomst veel verticale ruimte in. Scroll en de titel klapt in, maar de zoekbalk blijft."
          }
        }
      }
    },
    "Large 타이틀이 스크롤하면 inline으로 접히는 이유는?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why does a large title collapse to inline when you scroll?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Why does a large title collapse to inline when you scroll?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Large タイトルがスクロールでinlineに折りたたまれる理由は？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 타이틀이 스크롤하면 inline으로 접히는 이유는?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 标题滚动后为什么会折叠成 inline？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Large 標題滾動後為什麼會摺疊成 inline？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему Large-заголовок сворачивается в inline при прокрутке?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué un título grande se contrae a inline al desplazar?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum klappt ein großer Titel beim Scrollen zu inline zusammen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi un grand titre se replie-t-il en inline quand on fait défiler ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché un titolo grande si comprime in inline quando scorri?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por que um título grande recolhe para inline quando você rola?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไมชื่อเรื่องขนาดใหญ่จึงยุบเป็นแบบ inline เมื่อเลื่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao tiêu đề lớn thu về dạng inline khi bạn cuộn?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proč se velký nadpis při posouvání sbalí na inline?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor klapper en stor titel sammen til inline, når du scroller?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γιατί ένας μεγάλος τίτλος συμπτύσσεται σε inline όταν κυλάς;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miksi suuri otsikko tiivistyy inline-muotoon vieritettäessä?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengapa judul besar menciut menjadi inline saat kamu menggulir?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor kollapser en stor tittel til inline når du ruller?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarom klapt een grote titel in tot inline als je scrolt?"
          }
        }
      }
    },
