    "읽힘과 미학이 충돌하면 읽힘이 이긴다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When legibility and aesthetics clash, legibility wins"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When legibility and aesthetics clash, legibility wins"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読みやすさと美しさがぶつかったら、読みやすさが勝つ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽힘과 미학이 충돌하면 읽힘이 이긴다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
