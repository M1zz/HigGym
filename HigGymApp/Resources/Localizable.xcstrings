            "value": "Background conditions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景の条件"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경 조건"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景条件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
