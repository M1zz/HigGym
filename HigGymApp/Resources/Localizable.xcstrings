    "화면을 보고 왜 그렇게 만들었는지 고릅니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the screen and pick why it was made that way"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the screen and pick why it was made that way"
          }
        },
        "ja": {
