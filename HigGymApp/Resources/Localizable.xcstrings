            "state": "translated",
            "value": "Porque inline queda mejor visualmente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil inline optisch besser aussieht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parce que l'inline est plus joli visuellement"
          }
        },
        "it": {
